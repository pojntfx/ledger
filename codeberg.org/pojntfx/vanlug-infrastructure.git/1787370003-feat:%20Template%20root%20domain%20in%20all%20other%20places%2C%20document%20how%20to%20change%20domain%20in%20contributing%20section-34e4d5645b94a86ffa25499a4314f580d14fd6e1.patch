     - name: Create DOCKER_USERNAME variable for forgejo-runner-meta repo in Forgejo
       ansible.builtin.uri:
-        url: "https://git.vanlug.p8.lu/api/v1/repos/pojntfx/forgejo-runner-meta/actions/variables/DOCKER_USERNAME"
