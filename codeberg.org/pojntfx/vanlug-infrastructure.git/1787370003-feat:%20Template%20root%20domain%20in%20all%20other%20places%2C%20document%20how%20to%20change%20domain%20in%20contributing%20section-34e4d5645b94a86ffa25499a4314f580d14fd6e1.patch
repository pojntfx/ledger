--- a/units/forgejo.container
+++ b/units/forgejo.container
@@ -20,9 +20,9 @@ Environment=FORGEJO__server__SSH_PORT=220
 # Else Forgejo will try to start via HTTPS without having a cert (we use Caddy for that)
 Environment=FORGEJO__server__PROTOCOL=http
 # Forgejo runs rootless, we use Caddy, but we still need to tell Forgejo where it is accessible from
-Environment=FORGEJO__server__DOMAIN=git.vanlug.p8.lu
-Environment=FORGEJO__server__SSH_DOMAIN=git.vanlug.p8.lu
-Environment=FORGEJO__server__ROOT_URL=https://git.vanlug.p8.lu/
+Environment=FORGEJO__server__DOMAIN=git.{{ vanlug_domain }}
+Environment=FORGEJO__server__SSH_DOMAIN=git.{{ vanlug_domain }}
+Environment=FORGEJO__server__ROOT_URL=https://git.{{ vanlug_domain }}/
 # We're not open for registration, and do not need email support
 Environment=FORGEJO__service__DISABLE_REGISTRATION=true
 Environment=FORGEJO__mailer__ENABLED=false
diff --git a/units/git-pages.container b/units/git-pages.container
index 096ac211c390c9288c1c508c21d2ee8dd051d3a7..9e702515acbc6d724f441ff270f3d92e207af07e 100644
--- a/units/git-pages.container
+++ b/units/git-pages.container
@@ -9,12 +9,12 @@ # We use systemd-socket-proxyd on 3003/3005, so we listen on 3004/3006 instead
 PublishPort=3004:3000
 PublishPort=3006:3001
 Volume=git_pages_data:/app/data
-AddHost=git.vanlug.p8.lu:host-gateway
+AddHost=git.{{ vanlug_domain }}:host-gateway
 # See https://git-pages.org/running-a-server/#wildcard-domains
-# We're not supposed to re-use the same second-level domain (vanlug.p8.lu)
+# We're not supposed to re-use the same second-level domain ({{ vanlug_domain }})
 # for user-generated pages, but since we only allow board members to public
 # sites, this is fine for us
-Environment="PAGES_WILDCARD=[{\"Domain\":\"pages.vanlug.p8.lu\",\"CloneURL\":\"https://git.vanlug.p8.lu/<user>/<project>.git\",\"IndexRepo\":\"<user>.pages.vanlug.p8.lu\",\"IndexRepoBranch\":\"main\",\"Authorization\":\"forgejo\"}]"
+Environment="PAGES_WILDCARD=[{\"Domain\":\"pages.{{ vanlug_domain }}\",\"CloneURL\":\"https://git.{{ vanlug_domain }}/<user>/<project>.git\",\"IndexRepo\":\"<user>.pages.{{ vanlug_domain }}\",\"IndexRepoBranch\":\"main\",\"Authorization\":\"forgejo\"}]"
 LogDriver=journald
 ReadOnly=true
 
diff --git a/units/vanlug-api.container b/units/vanlug-api.container
index 4221ef63b092c71dc54553275a4d4feb05808bef..1ff2d0eab893a76649234a2a89d3f7926d96709d 100644
--- a/units/vanlug-api.container
+++ b/units/vanlug-api.container
@@ -3,7 +3,7 @@ ContainerName=vanlug-api
 # Since we use enforcing SELinux we disable NoNewPrivileges here and
 # use our own custom SELinux domain instead
 SecurityLabelType=vanlug_api.process
-Image=git.vanlug.p8.lu/pojntfx/vanlug-api:main
+Image=git.{{ vanlug_domain }}/pojntfx/vanlug-api:main
 Label=io.containers.autoupdate=registry
 # We use systemd-socket-proxyd on 3009, so we listen on 3010 instead
 PublishPort=3010:8080

