         state: directory
     - name: Clone forgejo-runner-meta git repo
       ansible.builtin.git:
-        repo: "https://pojntfx:{{ forgejo_api_key.stdout }}@git.vanlug.p8.lu/pojntfx/forgejo-runner-meta.git"
+        repo: "https://pojntfx:{{ forgejo_api_key.stdout }}@git.{{ vanlug_domain }}/pojntfx/forgejo-runner-meta.git"
         dest: "{{ forgejo_runner_meta_git_repo.path }}"
         version: main
       no_log: true # The repo URL contains the API token
@@ -144,6 +144,21 @@         dest: "{{ forgejo_runner_meta_git_repo.path }}"
         delete: true
         rsync_opts:
           - "--exclude=.git" # We don't want to delete the git metadata
+          # The OCI workflow uses ${{ }} expressions, so we template it
+          # with [[ ]] separately below instead of syncing it raw
+          - "--exclude=.forgejo/workflows/oci.yaml"
+      # This will only run on changes to the file; see https://docs.ansible.com/projects/ansible/latest/playbook_guide/playbooks_handlers.html#id1
+      notify: Sync forgejo-runner-meta git repo changes to Forgejo
+    - name: Create workflows directory in checked out repo dir
+      ansible.builtin.file:
+        path: "{{ forgejo_runner_meta_git_repo.path }}/.forgejo/workflows"
+        state: directory
+    - name: Write templated OCI workflow to checked out repo dir
+      ansible.builtin.template:
+        src: ../config/forgejo-runner-meta/.forgejo/workflows/oci.yaml
+        dest: "{{ forgejo_runner_meta_git_repo.path }}/.forgejo/workflows/oci.yaml"
+        variable_start_string: "[["
+        variable_end_string: "]]"
       # This will only run on changes to the file; see https://docs.ansible.com/projects/ansible/latest/playbook_guide/playbooks_handlers.html#id1
       notify: Sync forgejo-runner-meta git repo changes to Forgejo
   handlers:
@@ -156,7 +171,7 @@           set -e
           git add -A
           git \
             -c user.name='{{ lookup("ansible.builtin.env", "FORGEJO_ADMIN_USERNAME") }}' \
-            -c user.email='{{ lookup("ansible.builtin.env", "FORGEJO_ADMIN_USERNAME") }}@git.vanlug.p8.lu' \
+            -c user.email='{{ lookup("ansible.builtin.env", "FORGEJO_ADMIN_USERNAME") }}@git.{{ vanlug_domain }}' \
             commit -m 'Sync forgejo-runner-meta'
           git push origin HEAD:main
         chdir: "{{ forgejo_runner_meta_git_repo.path }}"
