diff --git a/playbooks/forgejo.yaml b/playbooks/forgejo.yaml
index 0ce7ddec2e9ed3d816e1431d35de93951a863f18..bc177b426bcc1b7b43f72f8dbd89a59ccd5729ae 100644
--- a/playbooks/forgejo.yaml
+++ b/playbooks/forgejo.yaml
@@ -143,7 +143,7 @@         group: forgejo
         mode: "0755"
     - name: Write container file for Forgejo
       become: true
-      ansible.builtin.copy:
+      ansible.builtin.template:
         src: ../units/forgejo.container
         dest: /home/forgejo/.config/containers/systemd/forgejo.container
         owner: forgejo
@@ -166,7 +166,36 @@         src: ../config/custom/ # Trailing slash: sync the contents, not the directory itself
         dest: /home/forgejo/.config/forgejo/custom
         rsync_opts:
           - "--chown=forgejo:forgejo"
+          # The custom templates use Go templating ({{ }}), so we template them
+          # with [[ ]] separately below instead of syncing them raw
+          - "--exclude=templates/custom/"
         delete: true
+      # This will only run on changes to the file; see https://docs.ansible.com/projects/ansible/latest/playbook_guide/playbooks_handlers.html#id1
+      notify: Restart Forgejo user service
+    - name: Create custom templates directory for Forgejo
+      become: true
+      ansible.builtin.file:
+        path: /home/forgejo/.config/forgejo/custom/templates/custom
+        state: directory
+        owner: forgejo
+        group: forgejo
+        mode: "0755"
+    - name: Write custom templates for Forgejo
+      become: true
+      # These are Go templates which use {{ }}, so we use [[ ]] for templating instead
+      ansible.builtin.template:
+        src: "../config/custom/templates/custom/{{ item }}"
+        dest: "/home/forgejo/.config/forgejo/custom/templates/custom/{{ item }}"
+        owner: forgejo
+        group: forgejo
+        mode: "0644"
+        variable_start_string: "[["
+        variable_end_string: "]]"
+      loop:
+        - extra_links.tmpl
+        - extra_links_footer.tmpl
+        - signin_mid.tmpl
+        - signup_top.tmpl
       # This will only run on changes to the file; see https://docs.ansible.com/projects/ansible/latest/playbook_guide/playbooks_handlers.html#id1
       notify: Restart Forgejo user service
     - name: Enable Forgejo user service
