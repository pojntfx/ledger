           Authorization: "token {{ forgejo_api_key.stdout }}"
@@ -78,7 +78,7 @@           has_actions: true
         status_code: 200
     - name: Set DOCKER_USERNAME variable for forgejo-runner-meta repo in Forgejo
       ansible.builtin.uri:
