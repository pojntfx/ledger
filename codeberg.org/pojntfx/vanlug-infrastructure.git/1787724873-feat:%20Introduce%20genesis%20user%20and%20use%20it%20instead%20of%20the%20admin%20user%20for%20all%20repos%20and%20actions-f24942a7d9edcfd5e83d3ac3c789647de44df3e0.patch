diff --git a/units/vanlug-api.container b/units/vanlug-api.container
index 0254c94a985376eaba647739390ef808ed2ba9d4..f2591a636ca6a5f23ed40492b821e5248e46bb0a 100644
--- a/units/vanlug-api.container
+++ b/units/vanlug-api.container
@@ -3,7 +3,7 @@ ContainerName=vanlug-api
 # Since we use enforcing SELinux we disable NoNewPrivileges here and
 # use our own custom SELinux domain instead
 SecurityLabelType=vanlug_api.process
-Image=git.{{ vanlug_domain }}/{{ forgejo_admin_username }}/vanlug-api:main
+Image=git.{{ vanlug_domain }}/{{ forgejo_genesis_username }}/vanlug-api:main
 Label=io.containers.autoupdate=registry
 # We use systemd-socket-proxyd on 3009, so we listen on 3010 instead
 PublishPort=3010:8080

