diff --git a/git-pages.container b/git-pages.container
new file mode 100644
index 0000000000000000000000000000000000000000..d8122aef21aa238af55f0d58c16925e9549bb9de
--- /dev/null
+++ b/git-pages.container
@@ -0,0 +1,14 @@
+[Container]
+ContainerName=git-pages
+Image=codeberg.org/git-pages/git-pages:latest
+Label=io.containers.autoupdate=registry
+# We use systemd-socket-proxyd on 3003/3005, so we listen on 3004/3006 instead
+PublishPort=3004:3000
+PublishPort=3006:3001
+Volume=git_pages_data:/app/data
+LogDriver=journald
+NoNewPrivileges=true
+ReadOnly=true
+
+[Install]
+WantedBy=default.target
diff --git a/git-pages.yaml b/git-pages.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..b15809c26522af528612927443d9e21654be5acc
--- /dev/null
+++ b/git-pages.yaml
@@ -0,0 +1,124 @@
+- name: Configure git-pages # See https://git-pages.org/running-a-server/#via-docker
+  hosts:
+    - vanlug_mains
+  gather_facts: false
+  tasks:
+    - name: Create user for git-pages
+      become: true
+      register: git_pages_user
+      ansible.builtin.user:
+        name: git-pages
+    - name: Enable linger for git-pages user # See https://old.reddit.com/r/systemd/comments/suaa5x/proper_way_to_enable_lingering_ansible/
+      become: true
+      ansible.builtin.command: loginctl enable-linger git-pages
+      args:
+        creates: /var/lib/systemd/linger/git-pages
+    - name: Create socket directory for git-pages
+      become: true
+      ansible.builtin.file:
+        path: /home/git-pages/.config/systemd/user
+        state: directory
+        owner: git-pages
+        group: git-pages
+        mode: "0755"
+    - name: Write socket activation service files for git-pages
+      become: true
+      ansible.builtin.copy:
+        src: "{{ item }}"
+        dest: "/home/git-pages/.config/systemd/user/{{ item }}"
+        owner: git-pages
+        group: git-pages
+        mode: "0644"
+      loop:
+        - git-pages-pages.service
+        - git-pages-caddy.service
+    - name: Write socket files for git-pages
+      become: true
+      ansible.builtin.copy:
+        src: "{{ item }}"
+        dest: "/home/git-pages/.config/systemd/user/{{ item }}"
+        owner: git-pages
+        group: git-pages
+        mode: "0644"
+      # This will only run on changes to the file; see https://docs.ansible.com/projects/ansible/latest/playbook_guide/playbooks_handlers.html#id1
+      notify: Restart git-pages user sockets
+      loop:
+        - git-pages-pages.socket
+        - git-pages-caddy.socket
+    - name: Enable git-pages user sockets
+      become: true
+      become_user: git-pages
+      ansible.builtin.systemd_service:
+        name: "{{ item }}"
+        state: started
+        enabled: true
+        daemon_reload: true
+        scope: user
+      environment:
+        XDG_RUNTIME_DIR: "/run/user/{{ git_pages_user.uid }}"
+      loop:
+        - git-pages-pages.socket
+        - git-pages-caddy.socket
+    - name: Create container directory for git-pages
+      become: true
+      ansible.builtin.file:
+        path: /home/git-pages/.config/containers/systemd
+        state: directory
+        owner: git-pages
+        group: git-pages
+        mode: "0755"
+    - name: Write container file for git-pages
+      become: true
+      ansible.builtin.copy:
+        src: git-pages.container
+        dest: /home/git-pages/.config/containers/systemd/git-pages.container
+        owner: git-pages
+        group: git-pages
+        mode: "0644"
+      # This will only run on changes to the file; see https://docs.ansible.com/projects/ansible/latest/playbook_guide/playbooks_handlers.html#id1
+      notify: Restart git-pages user service
+    - name: Enable git-pages user service
+      become: true
+      become_user: git-pages
+      ansible.builtin.systemd_service:
+        name: git-pages.service
+        state: started
+        enabled: true
+        daemon_reload: true
+        scope: user
+      environment:
+        XDG_RUNTIME_DIR: "/run/user/{{ git_pages_user.uid }}"
+    - name: Enable Podman auto-update user service
+      become: true
+      become_user: git-pages
+      ansible.builtin.systemd_service:
+        name: podman-auto-update.timer
+        state: started
+        enabled: true
+        scope: user
+      environment:
+        XDG_RUNTIME_DIR: "/run/user/{{ git_pages_user.uid }}"
+  handlers:
+    - name: Restart git-pages user service
+      become: true
+      become_user: git-pages
+      ansible.builtin.systemd_service:
+        name: git-pages.service
+        state: restarted
+        daemon_reload: true
+        scope: user
+      environment:
+        XDG_RUNTIME_DIR: "/run/user/{{ git_pages_user.uid }}"
+    - name: Restart git-pages user sockets
+      become: true
+      become_user: git-pages
+      ansible.builtin.systemd_service:
+        name: "{{ item }}"
+        state: restarted
+        daemon_reload: true
+        scope: user
+      environment:
+        XDG_RUNTIME_DIR: "/run/user/{{ git_pages_user.uid }}"
+      loop:
+        - git-pages-pages.socket
+        - git-pages-caddy.socket
