From a25ce5d6bf094866c867f45e8654295f915eeccf Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Wed, 29 Jul 2026 22:19:50 -0700
Subject: [PATCH] feat: Add basic git-pages deployment and point Caddy at it

Signed-off-by: Felicitas Pojtinger <felicitas@pojtinger.com>
---
diff --git a/Caddyfile b/Caddyfile
index b5b62a11d1c9d01cc463c9c8cc3f1235e6c56549..19e3bc759fed784e2c6f515006a93511ecfa7c55 100644
--- a/Caddyfile
+++ b/Caddyfile
@@ -7,6 +7,11 @@ 	auto_https disable_redirects
 
 	# We have a read-only file system
 	persist_config off
+
+	on_demand_tls {
+		# We ask git-pages for whether we should request a TLS cert for this site
+		permission http http://host.containers.internal:3005
+	}
 }
 
 # These are supposed to be default_bind in the global block, but due to caddy#7525
@@ -38,14 +43,19 @@
 	redir https://{host}{uri}
 }
 
-vanlug.p8.lu {
+git.vanlug.p8.lu {
 	import workarounds
 
-	respond "Hello, world from the VanLUG test root domain!"
+	reverse_proxy host.containers.internal:3000
 }
 
-git.vanlug.p8.lu {
+# git-pages
+https:// {
+	tls {
+		on_demand
+	}
+
 	import workarounds
 
-	reverse_proxy host.containers.internal:3000
+	reverse_proxy host.containers.internal:3003
 }
diff --git a/README.md b/README.md
index 1a550d1d809a0d3708aee483564d867ee8511d5c..59941ba9d497a8c68758835140ae261960ea8de7 100644
--- a/README.md
