diff --git a/git-pages-caddy.service b/git-pages-caddy.service
new file mode 100644
index 0000000000000000000000000000000000000000..056f0eb33f9ced75d6e4f23d795b9d88cec2e327
--- /dev/null
+++ b/git-pages-caddy.service
@@ -0,0 +1,11 @@
+[Unit]
+Requires=git-pages-caddy.socket
+After=git-pages-caddy.socket
+Requires=git-pages.service
+After=git-pages.service
+
+[Service]
+ExecStart=/usr/lib/systemd/systemd-socket-proxyd localhost:3006
+
+[Install]
+WantedBy=default.target
diff --git a/git-pages-caddy.socket b/git-pages-caddy.socket
new file mode 100644
index 0000000000000000000000000000000000000000..fbf7e7809f39739225ecf7d4910549acec472cd7
--- /dev/null
+++ b/git-pages-caddy.socket
@@ -0,0 +1,6 @@
+[Socket]
+ListenStream=3005
+# No HTTP/3 here, git-pages listens on a raw TCP socket
+
+[Install]
+WantedBy=sockets.target
diff --git a/git-pages-pages.service b/git-pages-pages.service
new file mode 100644
index 0000000000000000000000000000000000000000..f3c17f68adaaf40224464cea9780f455e8ccde58
--- /dev/null
+++ b/git-pages-pages.service
@@ -0,0 +1,11 @@
+[Unit]
