diff --git a/git-pages-pages.socket b/git-pages-pages.socket
new file mode 100644
index 0000000000000000000000000000000000000000..94b2f42a6b00ad77f27a8a38c9acd479152e9429
--- /dev/null
+++ b/git-pages-pages.socket
@@ -0,0 +1,6 @@
+[Socket]
+ListenStream=3003
+# No HTTP/3 here, git-pages listens on a raw TCP socket
