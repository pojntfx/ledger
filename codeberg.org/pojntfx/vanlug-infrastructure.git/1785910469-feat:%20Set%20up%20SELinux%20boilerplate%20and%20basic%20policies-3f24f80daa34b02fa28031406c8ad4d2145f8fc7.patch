From 3f24f80daa34b02fa28031406c8ad4d2145f8fc7 Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Tue, 04 Aug 2026 23:14:29 -0700
Subject: [PATCH] feat: Set up SELinux boilerplate and basic policies

Signed-off-by: Felicitas Pojtinger <felicitas@pojtinger.com>
---
diff --git a/selinux.yaml b/selinux.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..53d2cc0b1f5315f883e0041e03caace37dcad5a2
--- /dev/null
+++ b/selinux.yaml
@@ -0,0 +1,37 @@
+- name: Configure SELinux # See https://docs.ansible.com/projects/ansible/latest/collections/ansible/posix/selinux_module.html#examples
+  hosts:
+    - vanlug_mains
+    - vanlug_forgejo_runners
+  gather_facts: false
+  tasks:
+    - name: Install SELinux tooling
+      become: true
+      ansible.builtin.package:
+        name:
+          - policycoreutils-python-utils
+          - checkpolicy
+          - container-selinux
+          - udica
+        state: present
+    - name: Check with SELinux modules are loaded
+      become: true
+      register: selinux_modules
+      changed_when: false
+      ansible.builtin.command: semodule -l
+    - name: Install policies from container-selinux
+      become: true
+      when: "'container' not in selinux_modules.stdout_lines"
+      changed_when: true
+      ansible.builtin.command: semodule -i /usr/share/selinux/packages/container.pp.bz2
+    # TODO: Install udica's base policy templates
+    # See /usr/share/udica/templates/ section in https://github.com/containers/udica#creating-selinux-policy-for-container
+    - name: Enable SELinux
+      become: true
+      ansible.posix.selinux:
+        policy: targeted
+        state: enforcing
+      register: selinux_status
+    - name: Reboot if SELinux requires it
+      become: true
+      ansible.builtin.reboot:
+      when: selinux_status.reboot_required
diff --git a/site.yaml b/site.yaml
index 9224878e53dd3732ecdd2bee6e3121c3860705a4..7606d815e39f2bc84a7fb2dc6c6a357981e2bc33 100644
--- a/site.yaml
+++ b/site.yaml
@@ -1,3 +1,5 @@
+- name: Configure SELinux
+  ansible.builtin.import_playbook: selinux.yaml
 - name: Configure firewall
   ansible.builtin.import_playbook: firewall.yaml
 - name: Configure automatic updates

