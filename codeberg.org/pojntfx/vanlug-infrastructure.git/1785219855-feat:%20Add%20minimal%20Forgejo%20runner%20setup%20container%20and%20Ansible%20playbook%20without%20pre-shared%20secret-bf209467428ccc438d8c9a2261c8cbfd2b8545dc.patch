From bf209467428ccc438d8c9a2261c8cbfd2b8545dc Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Mon, 27 Jul 2026 23:24:15 -0700
Subject: [PATCH] feat: Add minimal Forgejo runner setup container and Ansible playbook without pre-shared secret

Signed-off-by: Felicitas Pojtinger <felicitas@pojtinger.com>
---
diff --git a/README.md b/README.md
index 430e82c648d40ecfa91332f14bb92bab40921cd0..1a550d1d809a0d3708aee483564d867ee8511d5c 100644
--- a/README.md
+++ b/README.md
@@ -20,10 +20,13 @@ $ tofu init
 $ tofu apply
 $ ansible-galaxy collection install cloud.terraform ansible.posix
 $ ansible-playbook site.yaml # You might want to change `binary_path` in `inventory.yaml` first
-# To get logs for quadlets
+# To get logs for quadlets on main server
 $ ssh setup@vanlug.p8.lu
 [setup@vanlug-main ~]$ sudo journalctl _SYSTEMD_USER_UNIT=caddy.service -f
 [setup@vanlug-main ~]$ sudo journalctl _SYSTEMD_USER_UNIT=forgejo.service -f
+# To get logs for quadlets on Forgejo runner server
+$ ssh setup@2a01:4f8:c015:706c::1
+[setup@vanlug-forgejo-runner ~]$ sudo journalctl _SYSTEMD_USER_UNIT=forgejo-runner.service -f
 ```
 
 ## License
diff --git a/forgejo-runner.container b/forgejo-runner.container
new file mode 100644
index 0000000000000000000000000000000000000000..1416b829061c6bf319da6243a2606ff559cb4889
--- /dev/null
+++ b/forgejo-runner.container
@@ -0,0 +1,12 @@
+[Container]
+ContainerName=forgejo-runner
+Exec=/usr/bin/forgejo-runner --config config.yml daemon
+Image=code.forgejo.org/forgejo/runner:12
+Label=io.containers.autoupdate=registry
+Volume=forgejo_runner_data:/data
+LogDriver=journald
+NoNewPrivileges=true
+ReadOnly=true
+
+[Install]
+WantedBy=default.target
diff --git a/forgejo-runner.yaml b/forgejo-runner.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..fe7d8f191e0f8a1c92e90468f8f4827e92f3a978
--- /dev/null
+++ b/forgejo-runner.yaml
@@ -0,0 +1,71 @@
+- name: Configure Forgejo runner # See https://code.forgejo.org/forgejo/runner/src/branch/main/examples/docker-compose
+  hosts:
+    - vanlug_forgejo_runners
+  gather_facts: false
+  tasks:
+    - name: Create user for Forgejo runner
+      become: true
+      register: forgejo_runner_user
+      ansible.builtin.user:
+        name: forgejo-runner
+    - name: Enable linger for Forgejo runner user # See https://old.reddit.com/r/systemd/comments/suaa5x/proper_way_to_enable_lingering_ansible/
+      become: true
+      ansible.builtin.command: loginctl enable-linger forgejo-runner
+      args:
+        creates: /var/lib/systemd/linger/forgejo-runner
+    - name: Create container directory for Forgejo runner
+      become: true
+      ansible.builtin.file:
+        path: /home/forgejo-runner/.config/containers/systemd
+        state: directory
+        owner: forgejo-runner
+        group: forgejo-runner
+        mode: "0755"
+    - name: Write container file for Forgejo runner
+      become: true
+      ansible.builtin.copy:
+        src: forgejo-runner.container
+        dest: /home/forgejo-runner/.config/containers/systemd/forgejo-runner.container
+        owner: forgejo-runner
+        group: forgejo-runner
+        mode: "0644"
+      # This will only run on changes to the file; see https://docs.ansible.com/projects/ansible/latest/playbook_guide/playbooks_handlers.html#id1
+      notify: Restart Forgejo runner user service
+    - name: Enable Forgejo runner user service
+      become: true
+      become_user: forgejo-runner
+      ansible.builtin.systemd_service:
+        name: forgejo-runner.service
+        state: started
+        enabled: true
+        daemon_reload: true
+        scope: user
+      environment:
+        XDG_RUNTIME_DIR: "/run/user/{{ forgejo_runner_user.uid }}"
+    - name: Enable Podman auto-update user service
+      become: true
+      become_user: forgejo-runner
+      ansible.builtin.systemd_service:
+        name: podman-auto-update.timer
+        state: started
+        enabled: true
+        scope: user
+      environment:
+        XDG_RUNTIME_DIR: "/run/user/{{ forgejo_runner_user.uid }}"
+    # TODO: Configure the Forgejo runner as described in
+    # https://code.forgejo.org/forgejo/runner/src/branch/main/examples/docker-compose/compose-forgejo-and-runner.yml
+    # by first registering the runner with a pre-shared key in .env.local (documented in the README)
+    # in the forgejo.yaml file and then, in here, execing into the forgejo-runner container like we're execing
+    # into the Forgejo container using that same secret here to 1) generate the config file for the runner and
+    # 2) writing the secret into the Forgejo runner config file after it's been generated
+  handlers:
+    - name: Restart Forgejo runner user service
+      become: true
+      become_user: forgejo-runner
+      ansible.builtin.systemd_service:
+        name: forgejo-runner.service
+        state: restarted
+        daemon_reload: true
+        scope: user
+      environment:
+        XDG_RUNTIME_DIR: "/run/user/{{ forgejo_runner_user.uid }}"
diff --git a/site.yaml b/site.yaml
index 920402e10e04ecc0e3e8d5ee48310ce532a84707..f5209c9d051730a3fc16a65c35d7a048cca36e2e 100644
--- a/site.yaml
+++ b/site.yaml
@@ -8,3 +8,5 @@ - name: Configure Caddy
   ansible.builtin.import_playbook: caddy.yaml
 - name: Configure Forgejo
   ansible.builtin.import_playbook: forgejo.yaml
+- name: Configure Forgejo runner
+  ansible.builtin.import_playbook: forgejo-runner.yaml

