diff --git a/forgejo.container b/forgejo.container
new file mode 100644
index 0000000000000000000000000000000000000000..c6bf80123fd1ff429d20640a64c342d2e2518fa1
--- /dev/null
+++ b/forgejo.container
@@ -0,0 +1,15 @@
+[Container]
+ContainerName=forgejo
+Image=codeberg.org/forgejo/forgejo:16-rootless
+Label=io.containers.autoupdate=registry
+PublishPort=3000:3000
+PublishPort=2022:22
+Volume=forgejo_data:/data
+# Forgejo runs rootless, we use DNAT on the host to redirect 220 to 2022
+Environment=FORGEJO__server__SSH_PORT=220
+LogDriver=journald
+NoNewPrivileges=true
+ReadOnly=true
+
+[Install]
+WantedBy=default.target
diff --git a/forgejo.yaml b/forgejo.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..a4832d611fd8e7e55d1b981ad3932f5163077bfe
--- /dev/null
+++ b/forgejo.yaml
@@ -0,0 +1,75 @@
+- name: Configure Forgejo # See https://forgejo.org/docs/latest/admin/installation/docker/#using-rootless-image
+  hosts: all
+  gather_facts: false
+  tasks:
+    - name: Create user for Forgejo
+      become: true
+      register: forgejo_user
+      ansible.builtin.user:
+        name: forgejo
+    - name: Enable linger for Forgejo user # See https://old.reddit.com/r/systemd/comments/suaa5x/proper_way_to_enable_lingering_ansible/
+      become: true
+      ansible.builtin.command: loginctl enable-linger forgejo
+      args:
+        creates: /var/lib/systemd/linger/forgejo
+    - name: Create container directory for Forgejo
+      become: true
+      ansible.builtin.file:
+        path: /home/forgejo/.config/containers/systemd
+        state: directory
+        owner: forgejo
+        group: forgejo
+        mode: "0755"
+    - name: Write container file for Forgejo
+      become: true
+      ansible.builtin.copy:
+        src: forgejo.container
+        dest: /home/forgejo/.config/containers/systemd/forgejo.container
+        owner: forgejo
+        group: forgejo
+        mode: "0644"
+      # This will only run on changes to the file; see https://docs.ansible.com/projects/ansible/latest/playbook_guide/playbooks_handlers.html#id1
+      notify: Restart Forgejo user service
+    - name: Enable Forgejo user service
+      become: true
+      become_user: forgejo
+      ansible.builtin.systemd_service:
+        name: forgejo.service
+        state: started
+        enabled: true
+        daemon_reload: true
+        scope: user
+      environment:
+        XDG_RUNTIME_DIR: "/run/user/{{ forgejo_user.uid }}"
+    - name: Enable Podman auto-update user service
+      become: true
+      become_user: forgejo
+      ansible.builtin.systemd_service:
+        name: podman-auto-update.timer
+        state: started
+        enabled: true
+        scope: user
+      environment:
+        XDG_RUNTIME_DIR: "/run/user/{{ forgejo_user.uid }}"
+    - name: Create port forwarding rules
+      become: true
+      ansible.posix.firewalld:
+        rich_rule: "{{ item }}"
+        permanent: true
+        immediate: true
+        state: enabled
+      loop:
+        # Caddy can't route SSH, so we bypass it
+        - rule family=ipv6 forward-port port=220 protocol=tcp to-port=2022
+        - rule family=ipv4 forward-port port=220 protocol=tcp to-port=2022
+  handlers:
+    - name: Restart Forgejo user service
+      become: true
+      become_user: forgejo
+      ansible.builtin.systemd_service:
+        name: forgejo.service
+        state: restarted
+        daemon_reload: true
+        scope: user
+      environment:
+        XDG_RUNTIME_DIR: "/run/user/{{ forgejo_user.uid }}"
