From 6b33da7077d29a1834343e965db79d94169a4adb Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Fri, 21 Aug 2026 21:37:48 -0700
Subject: [PATCH] feat: Add configurable prefixes to all OpenTofu resources and document how to use them with OpenTofu workspaces

Signed-off-by: Felicitas Pojtinger <felicitas@pojtinger.com>
---
diff --git a/README.md b/README.md
index 9505ca7cb9c08921bf1fccbb7573754831c74494..1be29a5b82b3b8b97aa4cebe77c607348c89f177 100644
--- a/README.md
+++ b/README.md
@@ -22,13 +22,30 @@ Contributions to this repository are restricted to the VanLUG technical comittee at this time.
 
 To contribute, please use the [Codeberg flow](https://docs.codeberg.org/collaborating/) and follow our [Code of Conduct](https://vanlug.ca/conduct/).
 
-To deploy the infrastructure locally, first use [OpenTofu](https://opentofu.org/) to create the physical infrastructure by running the following:
+In order to get started, first clone the repository and set up all secrets by running the following:
 
 ```shell
 $ git clone https://codeberg.org/pojntfx/vanlug-infrastructure
 $ cd vanlug-infrastructure
 $ source .env.local # See `.env` for required secrets; ask `@pojntfx:beeper.com` for access
+```
+
+The `default` [OpenTofu](https://opentofu.org/) workspace is the production one, so first create one for you to develop on by running this:
+
+```shell
 $ tofu init
+$ tofu workspace new pojntfx # Change `pojntfx` to a unique string for your development namespace, e.g. your username
+```
+
+If you'd like to switch back to the default (production) workspace, run:
+
+```shell
+$ tofu workspace select
+```
+
+You can then deploy the physical infrastructure by running:
+
+```shell
 $ tofu apply
 ```
 
diff --git a/locals.tofu b/locals.tofu
new file mode 100644
index 0000000000000000000000000000000000000000..9ee4b204f98f5dbaaa69f41dbc5adf024cc47c3a
--- /dev/null
+++ b/locals.tofu
@@ -0,0 +1,3 @@
+locals {
+  name_prefix = terraform.workspace == "default" ? "" : "${terraform.workspace}-"
+}
diff --git a/main.tofu b/main.tofu
index a6dd4c16ba9e8213ede293deb9f59f20d3469c17..3a9d33ef430d70c8b86ba2a4d9e3c1176d303f37 100644
--- a/main.tofu
+++ b/main.tofu
@@ -1,5 +1,5 @@
 resource "hcloud_firewall" "vanlug_main" {
-  name = "vanlug-main"
+  name = "${local.name_prefix}vanlug-main"
 
   rule {
     direction  = "in"
@@ -40,7 +40,7 @@   }
 }
 
 resource "hcloud_firewall" "vanlug_forgejo_runner" {
-  name = "vanlug-forgejo-runner"
+  name = "${local.name_prefix}vanlug-forgejo-runner"
 
   rule {
     direction  = "in"
@@ -51,13 +51,13 @@   }
 }
 
 resource "hcloud_ssh_key" "pojntfx" {
-  name = "pojntfx"
+  name = "${local.name_prefix}pojntfx"
 
   public_key = var.ssh_public_key
 }
 
 resource "hcloud_server" "vanlug_main" {
-  name     = "vanlug-main"
+  name     = "${local.name_prefix}vanlug-main"
   location = "fsn1"
 
   image       = "alma-10"
@@ -68,9 +68,10 @@   firewall_ids = [hcloud_firewall.vanlug_main.id]
 
   backups = true
 
-  # # Data is stored on the server's volume directly; we should not destroy it
-  delete_protection  = true
-  rebuild_protection = true
+  # Data is stored on the server's volume directly; we should not destroy it
+  # in the production workspace, only during development
+  delete_protection  = terraform.workspace == "default"
+  rebuild_protection = terraform.workspace == "default"
 
   user_data = templatefile("config/cloud-init.yaml", {
     ssh_setup_user = var.ssh_setup_user
@@ -78,8 +79,6 @@     ssh_public_key = var.ssh_public_key
   })
 
   lifecycle {
-    prevent_destroy = true # Data is stored on the server's volume directly; we should not destroy it
-
     ignore_changes = [
       ssh_keys, # We can't update SSH keys without destroying the server and recreating it
       user_data # We can't update cloud-init user data without destroying the server and recreating it
@@ -88,7 +87,7 @@   }
 }
 
 resource "hcloud_server" "vanlug_forgejo_runner" {
-  name     = "vanlug-forgejo-runner"
+  name     = "${local.name_prefix}vanlug-forgejo-runner"
   location = "fsn1"
 
   image       = "alma-10"

