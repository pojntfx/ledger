   ansible.builtin.import_playbook: playbooks/git-pages.yaml
 - name: Configure Anubis
   ansible.builtin.import_playbook: playbooks/anubis.yaml
-# We don't run vanlug-api by default here since we need to manually import the VanLUG website repo
+- name: Configure vanlug-website
+  ansible.builtin.import_playbook: playbooks/vanlug-website.yaml
+# vanlug-api depends on vanlug-website since the latter builds and publishes the former's OCI image
+- name: Configure vanlug-api
+  ansible.builtin.import_playbook: playbooks/vanlug-api.yaml

