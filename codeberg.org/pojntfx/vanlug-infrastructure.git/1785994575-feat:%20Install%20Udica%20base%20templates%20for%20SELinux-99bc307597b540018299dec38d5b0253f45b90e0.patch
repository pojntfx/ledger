From 99bc307597b540018299dec38d5b0253f45b90e0 Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Wed, 05 Aug 2026 22:36:15 -0700
Subject: [PATCH] feat: Install Udica base templates for SELinux

Signed-off-by: Felicitas Pojtinger <felicitas@pojtinger.com>
---
diff --git a/selinux.yaml b/selinux.yaml
index 53d2cc0b1f5315f883e0041e03caace37dcad5a2..96a3cf670fa9fc0f9968c8430374d64ef76110ec 100644
--- a/selinux.yaml
+++ b/selinux.yaml
@@ -23,8 +23,17 @@       become: true
       when: "'container' not in selinux_modules.stdout_lines"
       changed_when: true
       ansible.builtin.command: semodule -i /usr/share/selinux/packages/container.pp.bz2
-    # TODO: Install udica's base policy templates
     # See /usr/share/udica/templates/ section in https://github.com/containers/udica#creating-selinux-policy-for-container
+    - name: Install udica's base container policy template
+      become: true
+      when: "'base_container' not in selinux_modules.stdout_lines"
+      changed_when: true
+      ansible.builtin.command: semodule -i /usr/share/udica/templates/base_container.cil
+    - name: Install udica's net container policy template
+      become: true
+      when: "'net_container' not in selinux_modules.stdout_lines"
+      changed_when: true
+      ansible.builtin.command: semodule -i /usr/share/udica/templates/net_container.cil
     - name: Enable SELinux
       become: true
       ansible.posix.selinux:

