From 77600eb6247a1991d6fd8759166796de8589a08b Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Tue, 28 Jul 2026 23:17:22 -0700
Subject: [PATCH] feat: Create pre-shared secrets and UUIDs for Forgejo runner, template container file and write config for it

Signed-off-by: Felicitas Pojtinger <felicitas@pojtinger.com>
---
diff --git a/.env b/.env
index eec5cc215addfba2eb8213ef67804762839b326f..d45b9ab9c2e05a356aaa66dc0198f324651420a5 100644
--- a/.env
+++ b/.env
@@ -5,3 +5,5 @@ export TF_VAR_ssh_public_key="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEwIx/dRJkK0xPD15TRAPOEsklWV/JguGpf+p9h4dQUj pojntfx@fels-asus-proart-px13"
 export FORGEJO_ADMIN_USERNAME="pojntfx"
 export FORGEJO_ADMIN_EMAIL="felicitas@pojtinger.com"
 export FORGEJO_ADMIN_INITIAL_PASSWORD=""
+export FORGEJO_RUNNER_SHARED_SECRET="" # openssl rand -hex 20
+export FORGEJO_RUNNER_UUID="" # echo -n "$FORGEJO_RUNNER_SHARED_SECRET" | python3 -c 'import sys; import uuid;input=sys.stdin.read();print(str(uuid.UUID(bytes=input[:16].encode("utf-8"))))'
diff --git a/forgejo-runner.container b/forgejo-runner.container
index 1416b829061c6bf319da6243a2606ff559cb4889..a634853c4b92a3baac335c8932bc31e241750bdd 100644
--- a/forgejo-runner.container
+++ b/forgejo-runner.container
@@ -1,12 +1,16 @@
 [Container]
 ContainerName=forgejo-runner
-Exec=/usr/bin/forgejo-runner --config config.yml daemon
+Exec=/bin/forgejo-runner --config config.yml daemon
 Image=code.forgejo.org/forgejo/runner:12
 Label=io.containers.autoupdate=registry
 Volume=forgejo_runner_data:/data
 LogDriver=journald
 NoNewPrivileges=true
 ReadOnly=true
+
+[Service]
+# See https://code.forgejo.org/forgejo/runner/src/branch/main/examples/docker-compose/compose-forgejo-and-runner.yml#L69-L81
+ExecStartPre=/usr/bin/podman run --rm -v forgejo_runner_data:/data -w /data code.forgejo.org/forgejo/runner:12 bash -c 'forgejo-runner generate-config > config.yml && sed -i -e "s|  connections:|  connections:\\n    default:\\n      url: https://git.vanlug.p8.lu\\n      uuid: {{ forgejo_runner_uuid | replace("\\", "\\\\") | replace("|", "\\|") | replace("&", "\\&") }}\\n      token: {{ forgejo_runner_shared_secret | replace("\\", "\\\\") | replace("|", "\\|") | replace("&", "\\&") }}|" config.yml'
 
 [Install]
 WantedBy=default.target
diff --git a/forgejo-runner.yaml b/forgejo-runner.yaml
index fe7d8f191e0f8a1c92e90468f8f4827e92f3a978..e88259c9f8f0f1572132a8a52b19e22dfdc4eabe 100644
--- a/forgejo-runner.yaml
+++ b/forgejo-runner.yaml
@@ -23,12 +23,16 @@         group: forgejo-runner
         mode: "0755"
     - name: Write container file for Forgejo runner
       become: true
-      ansible.builtin.copy:
+      ansible.builtin.template:
         src: forgejo-runner.container
         dest: /home/forgejo-runner/.config/containers/systemd/forgejo-runner.container
         owner: forgejo-runner
         group: forgejo-runner
         mode: "0644"
+      vars:
+        forgejo_runner_shared_secret: '{{ lookup("ansible.builtin.env", "FORGEJO_RUNNER_SHARED_SECRET") }}'
+        forgejo_runner_uuid: '{{ lookup("ansible.builtin.env", "FORGEJO_RUNNER_UUID") }}'
+      no_log: true # The file includes the shared secret and UUID
       # This will only run on changes to the file; see https://docs.ansible.com/projects/ansible/latest/playbook_guide/playbooks_handlers.html#id1
       notify: Restart Forgejo runner user service
     - name: Enable Forgejo runner user service
@@ -52,12 +56,6 @@         enabled: true
         scope: user
       environment:
         XDG_RUNTIME_DIR: "/run/user/{{ forgejo_runner_user.uid }}"
-    # TODO: Configure the Forgejo runner as described in
-    # https://code.forgejo.org/forgejo/runner/src/branch/main/examples/docker-compose/compose-forgejo-and-runner.yml
-    # by first registering the runner with a pre-shared key in .env.local (documented in the README)
-    # in the forgejo.yaml file and then, in here, execing into the forgejo-runner container like we're execing
-    # into the Forgejo container using that same secret here to 1) generate the config file for the runner and
-    # 2) writing the secret into the Forgejo runner config file after it's been generated
   handlers:
     - name: Restart Forgejo runner user service
       become: true
diff --git a/forgejo.yaml b/forgejo.yaml
index 79da494fe1fe639c444de081e1c095f3673ac895..cddc1311a649c6d8a98e4ed4d5091dea41989c64 100644
--- a/forgejo.yaml
+++ b/forgejo.yaml
@@ -132,6 +132,17 @@           --password '{{ lookup("ansible.builtin.env", "FORGEJO_ADMIN_INITIAL_PASSWORD") }}' \
           --must-change-password
       environment:
         XDG_RUNTIME_DIR: "/run/user/{{ forgejo_user.uid }}"
+    - name: Set up Forgejo runner secret
+      become: true
+      become_user: forgejo
+      when: true # This command is idempotent
+      changed_when: true
+      ansible.builtin.command: |
+        podman exec forgejo forgejo forgejo-cli actions register \
+          --keep-labels \
+          --secret '{{ lookup("ansible.builtin.env", "FORGEJO_RUNNER_SHARED_SECRET") }}'
+      environment:
+        XDG_RUNTIME_DIR: "/run/user/{{ forgejo_user.uid }}"
   handlers:
     - name: Restart Forgejo user service
       become: true

