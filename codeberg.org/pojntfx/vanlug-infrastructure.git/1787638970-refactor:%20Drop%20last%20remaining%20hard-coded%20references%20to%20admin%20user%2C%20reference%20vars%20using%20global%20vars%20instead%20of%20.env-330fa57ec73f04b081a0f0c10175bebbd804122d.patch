From 330fa57ec73f04b081a0f0c10175bebbd804122d Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Mon, 24 Aug 2026 23:22:50 -0700
Subject: [PATCH] refactor: Drop last remaining hard-coded references to admin user, reference vars using global vars instead of .env

Signed-off-by: Felicitas Pojtinger <felicitas@pojtinger.com>
---
diff --git a/.env b/.env
index a16d73e469647dbb8cae7da1723d0f454babed9b..75976ccf5a6d57c537226db35a25ee48c30fcea9 100644
--- a/.env
+++ b/.env
@@ -2,8 +2,6 @@ export AWS_ACCESS_KEY_ID=
 export AWS_SECRET_ACCESS_KEY=
 export TF_VAR_hetzner_api_key=
 export TF_VAR_ssh_public_key="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEwIx/dRJkK0xPD15TRAPOEsklWV/JguGpf+p9h4dQUj pojntfx@fels-asus-proart-px13"
-export FORGEJO_ADMIN_USERNAME="pojntfx"
-export FORGEJO_ADMIN_EMAIL="felicitas@pojtinger.com"
 export FORGEJO_ADMIN_INITIAL_PASSWORD=""
 export FORGEJO_RUNNER_SHARED_SECRET="" # openssl rand -hex 20
 export FORGEJO_RUNNER_UUID="" # echo -n "$FORGEJO_RUNNER_SHARED_SECRET" | python3 -c 'import sys; import uuid;input=sys.stdin.read();print(str(uuid.UUID(bytes=input[:16].encode("utf-8"))))'
diff --git a/README.md b/README.md
index fe5401c7e36b4f1eebadbb53f8734da579fa0eca..00db649bd767bcf837cccd27472729dfdc869138 100644
--- a/README.md
+++ b/README.md
@@ -49,7 +49,7 @@ ```shell
 $ tofu apply
 ```
 
-Then, configure the domain you'd like to use in [`group_vars/all.yaml`](group_vars/all.yaml) (e.g. `vanlug.p8.lu` during development or `vanlug.ca` in production, as we'll be using in the following), and use [Ansible](https://docs.ansible.com/projects/ansible/latest/index.html) to provision the hosts by running:
+Then, configure the domain and other variables you'd like to change in [`group_vars/all.yaml`](group_vars/all.yaml) (e.g. `vanlug.p8.lu` for the domain during development or `vanlug.ca` in production, as we'll be using in the following), and use [Ansible](https://docs.ansible.com/projects/ansible/latest/index.html) to provision the hosts by running:
 
 ```shell
 $ ansible-galaxy collection install cloud.terraform ansible.posix community.general community.docker
diff --git a/config/forgejo-runner-generate-config.sh b/config/forgejo-runner-generate-config.sh
index 28a5efb1e31c32e0fc6b9b3a140f70e54a6dd73d..12b89ddc66c916aaad28fe8d9d8c17488d1184c8 100644
--- a/config/forgejo-runner-generate-config.sh
+++ b/config/forgejo-runner-generate-config.sh
@@ -5,7 +5,7 @@
 forgejo-runner generate-config >config.yml
 
 sed -i \
-	-e "s|  labels: \[\]|  labels:\n    - ubuntu-latest:docker://git.{{ vanlug_domain }}/pojntfx/forgejo-runner-meta:latest|" \
+	-e "s|  labels: \[\]|  labels:\n    - ubuntu-latest:docker://git.{{ vanlug_domain }}/{{ forgejo_admin_username }}/forgejo-runner-meta:latest|" \
 	-e "s|  enable_ipv6: false|  enable_ipv6: true|" \
 	-e "s|  options:.*|  options: --security-opt label=disable --cap-add=all --volume /etc/resolv.conf:/etc/resolv.conf:ro --runtime=runsc|" \
 	-e "s|  valid_volumes: \[\]|  valid_volumes:\n    - /etc/resolv.conf|" \
diff --git a/group_vars/all.yaml b/group_vars/all.yaml
index 828155ac80466458d59a2929eb17647b3c209256..e80ee8c579ec625fdc906d2f60b7ad3a47e644fe 100644
--- a/group_vars/all.yaml
+++ b/group_vars/all.yaml
@@ -1,2 +1,6 @@
-# The primary domain all services are served under
+# Primary domain all services are served under
 vanlug_domain: vanlug.p8.lu
+# Forgejo admin user used for API access and as owner of the internal repos
+forgejo_admin_username: pojntfx
+# Email for Forgejo admin user
+forgejo_admin_email: felicitas@pojtinger.com
diff --git a/playbooks/forgejo-runner-meta.yaml b/playbooks/forgejo-runner-meta.yaml
index aed036b1ce975f79e5e35b88d630b88d02ec3ff3..c27281d99399282be3f992140eb740a2756648aa 100644
--- a/playbooks/forgejo-runner-meta.yaml
+++ b/playbooks/forgejo-runner-meta.yaml
@@ -5,7 +5,7 @@   gather_facts: false
   tasks:
     - name: Build Forgejo runner OCI image with Docker preinstalled
       community.docker.docker_image_build:
-        name: git.{{ vanlug_domain }}/pojntfx/forgejo-runner-meta:latest
+        name: git.{{ vanlug_domain }}/{{ forgejo_admin_username }}/forgejo-runner-meta:latest
         path: forgejo-runner-meta
         dockerfile: Containerfile
     - name: Fetch user for Forgejo
@@ -25,7 +25,7 @@       # For the UUID, see https://docs.ansible.com/projects/ansible/latest/collections/ansible/builtin/to_uuid_filter.html#examples.
       # This isn't a secret so we don't need true randomness here.
       ansible.builtin.command: |
         podman exec forgejo forgejo admin user generate-access-token \
-          --username '{{ lookup("ansible.builtin.env", "FORGEJO_ADMIN_USERNAME") }}' \
+          --username '{{ forgejo_admin_username }}' \
           --token-name 'forgejo-runner-meta-initial-setup-{{ 999999999999 | random | to_uuid }}' \
           --scopes 'write:package,write:repository,write:user' \
           --raw
@@ -45,7 +45,7 @@       # For the UUID, see https://docs.ansible.com/projects/ansible/latest/collections/ansible/builtin/to_uuid_filter.html#examples.
       # This isn't a secret so we don't need true randomness here.
       ansible.builtin.command: |
         podman exec forgejo forgejo admin user generate-access-token \
-          --username '{{ lookup("ansible.builtin.env", "FORGEJO_ADMIN_USERNAME") }}' \
+          --username '{{ forgejo_admin_username }}' \
           --token-name 'forgejo-runner-meta-actions-{{ 999999999999 | random | to_uuid }}' \
           --scopes 'write:package' \
           --raw
@@ -68,7 +68,7 @@           - 201
           - 409 # Repo already exists, which is fine since this is idempotent
     - name: Enable actions for forgejo-runner-meta repo in Forgejo
       ansible.builtin.uri:
-        url: https://git.{{ vanlug_domain }}/api/v1/repos/pojntfx/forgejo-runner-meta
+        url: https://git.{{ vanlug_domain }}/api/v1/repos/{{ forgejo_admin_username }}/forgejo-runner-meta
         method: PATCH
         headers:
           Authorization: "token {{ forgejo_api_key.stdout }}"
@@ -78,27 +78,27 @@           has_actions: true
         status_code: 200
     - name: Set DOCKER_USERNAME variable for forgejo-runner-meta repo in Forgejo
       ansible.builtin.uri:
-        url: "https://git.{{ vanlug_domain }}/api/v1/repos/pojntfx/forgejo-runner-meta/actions/variables/DOCKER_USERNAME"
+        url: "https://git.{{ vanlug_domain }}/api/v1/repos/{{ forgejo_admin_username }}/forgejo-runner-meta/actions/variables/DOCKER_USERNAME"
         method: PUT
         headers:
           Authorization: "token {{ forgejo_api_key.stdout }}"
         body_format: json
         body:
           name: DOCKER_USERNAME
-          value: '{{ lookup("ansible.builtin.env", "FORGEJO_ADMIN_USERNAME") }}'
+          value: '{{ forgejo_admin_username }}'
         status_code:
           - 204
           - 404 # Variable doesn't exist yet, create it below
       register: forgejo_docker_username_variable
     - name: Create DOCKER_USERNAME variable for forgejo-runner-meta repo in Forgejo
       ansible.builtin.uri:
-        url: "https://git.{{ vanlug_domain }}/api/v1/repos/pojntfx/forgejo-runner-meta/actions/variables/DOCKER_USERNAME"
+        url: "https://git.{{ vanlug_domain }}/api/v1/repos/{{ forgejo_admin_username }}/forgejo-runner-meta/actions/variables/DOCKER_USERNAME"
         method: POST
         headers:
           Authorization: "token {{ forgejo_api_key.stdout }}"
         body_format: json
         body:
-          value: '{{ lookup("ansible.builtin.env", "FORGEJO_ADMIN_USERNAME") }}'
+          value: '{{ forgejo_admin_username }}'
         status_code:
           - 201
           - 204
@@ -106,7 +106,7 @@       when: forgejo_docker_username_variable.status == 404
     # Secrets are idempotent, unlike variables
     - name: Set DOCKER_PASSWORD secret for forgejo-runner-meta repo in Forgejo
       ansible.builtin.uri:
-        url: "https://git.{{ vanlug_domain }}/api/v1/repos/pojntfx/forgejo-runner-meta/actions/secrets/DOCKER_PASSWORD"
+        url: "https://git.{{ vanlug_domain }}/api/v1/repos/{{ forgejo_admin_username }}/forgejo-runner-meta/actions/secrets/DOCKER_PASSWORD"
         method: PUT
         headers:
           Authorization: "token {{ forgejo_api_key.stdout }}"
@@ -119,11 +119,11 @@           - 204 # Secret updated
     - name: Log into Forgejo registry
       community.docker.docker_login:
         registry_url: git.{{ vanlug_domain }}
-        username: '{{ lookup("ansible.builtin.env", "FORGEJO_ADMIN_USERNAME") }}'
+        username: '{{ forgejo_admin_username }}'
         password: "{{ forgejo_api_key.stdout }}"
     - name: Push Forgejo runner OCI image
       community.docker.docker_image_push:
-        name: git.{{ vanlug_domain }}/pojntfx/forgejo-runner-meta
+        name: git.{{ vanlug_domain }}/{{ forgejo_admin_username }}/forgejo-runner-meta
         tag: latest
     - name: Create temporary directory for forgejo-runner-meta git repo
       register: forgejo_runner_meta_git_repo
@@ -132,7 +132,7 @@         suffix: git_repo
         state: directory
     - name: Clone forgejo-runner-meta git repo
       ansible.builtin.git:
-        repo: "https://pojntfx:{{ forgejo_api_key.stdout }}@git.{{ vanlug_domain }}/pojntfx/forgejo-runner-meta.git"
+        repo: "https://{{ forgejo_admin_username }}:{{ forgejo_api_key.stdout }}@git.{{ vanlug_domain }}/{{ forgejo_admin_username }}/forgejo-runner-meta.git"
         dest: "{{ forgejo_runner_meta_git_repo.path }}"
         version: main
       no_log: true # The repo URL contains the API token
@@ -170,8 +170,8 @@         cmd: |
           set -e
           git add -A
           git \
-            -c user.name='{{ lookup("ansible.builtin.env", "FORGEJO_ADMIN_USERNAME") }}' \
-            -c user.email='{{ lookup("ansible.builtin.env", "FORGEJO_ADMIN_USERNAME") }}@git.{{ vanlug_domain }}' \
+            -c user.name='{{ forgejo_admin_username }}' \
+            -c user.email='{{ forgejo_admin_username }}@git.{{ vanlug_domain }}' \
             commit -m 'Sync forgejo-runner-meta'
           git push origin HEAD:main
         chdir: "{{ forgejo_runner_meta_git_repo.path }}"
diff --git a/playbooks/forgejo.yaml b/playbooks/forgejo.yaml
index bc177b426bcc1b7b43f72f8dbd89a59ccd5729ae..a75e9dbf35c101ee7480b9bfe49f5d8885e0d60e 100644
--- a/playbooks/forgejo.yaml
+++ b/playbooks/forgejo.yaml
@@ -232,13 +232,13 @@     - name: Set up Forgejo admin user
       become: true
       become_user: forgejo
       # This is a bit brittle since we could also match a column, but that's fine for a one-time setup task
-      when: lookup('ansible.builtin.env', 'FORGEJO_ADMIN_USERNAME') not in forgejo_users.stdout
+      when: forgejo_admin_username not in forgejo_users.stdout
       changed_when: true
       ansible.builtin.command: |
         podman exec forgejo forgejo admin user create \
           --admin \
-          --username '{{ lookup("ansible.builtin.env", "FORGEJO_ADMIN_USERNAME") }}' \
-          --email '{{ lookup("ansible.builtin.env", "FORGEJO_ADMIN_EMAIL") }}' \
+          --username '{{ forgejo_admin_username }}' \
+          --email '{{ forgejo_admin_email }}' \
           --password '{{ lookup("ansible.builtin.env", "FORGEJO_ADMIN_INITIAL_PASSWORD") }}' \
           --must-change-password
       environment:
