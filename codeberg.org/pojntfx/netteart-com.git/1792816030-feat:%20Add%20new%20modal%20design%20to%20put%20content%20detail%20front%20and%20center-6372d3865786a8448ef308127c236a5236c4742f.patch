diff --git a/assets/scss/main.scss b/assets/scss/main.scss
index 1c3e3c25803114a896cd37865f7c532872dcf022..87b1801218da4e2152a91150786bd1876d7816b1 100644
--- a/assets/scss/main.scss
+++ b/assets/scss/main.scss
@@ -908,24 +908,213 @@   // We made the whole home page scroll, so we can't use the regular back to top button positioning anymore
   position: fixed;
 }
 
-.na-modal__footer {
+.na-modal {
   display: flex;
-  align-items: center;
-  justify-content: center;
+  flex-direction: column;
+  width: min(96rem, calc(100vw - 2rem));
+  height: calc(100vh - 2rem);
+  max-height: calc(100vh - 2rem);
+  padding: 0;
+  overflow: hidden;
 }
 
-.na-modal__body {
+.na-modal .pf-v6-c-modal-box__close {
+  z-index: 2;
+}
+
+.na-modal .pf-v6-c-modal-box__body {
   display: flex;
-  align-content: center;
-  justify-content: center;
+  flex: 1 1 auto;
+  min-height: 0;
+  padding: 0;
+  overflow: hidden;
+}
 
-  > img {
-    width: auto;
-  }
+.na-modal__stage {
+  position: relative;
+  display: flex;
+  flex: 1 1 auto;
+  flex-direction: column;
+  min-width: 0;
+  min-height: 0;
+  background: var(--pf-t--global--background--color--secondary--default);
+}
+
+.na-modal__canvas {
+  position: relative;
+  flex: 1 1 auto;
+  min-height: 0;
+  overflow: auto;
+  overscroll-behavior: contain;
+}
+
+.na-modal__img {
+  position: absolute;
+  inset: 0;
+  display: block;
+  width: 100%;
+  height: 100%;
+  max-width: none;
+  max-height: none;
+  object-fit: contain;
+}
+
+.na-modal__prev,
+.na-modal__next {
+  position: absolute;
+  z-index: 1;
+  top: 50%;
+  transform: translateY(-50%);
+  background: var(--pf-t--global--background--color--primary--default);
+  box-shadow: var(--pf-t--global--box-shadow--sm);
+}
+
+.na-modal__prev {
+  left: var(--pf-t--global--spacer--md);
+}
+
+.na-modal__next {
+  right: var(--pf-t--global--spacer--md);
 }
 
 .na-modal__pagination {
+  position: absolute;
+  z-index: 1;
+  bottom: var(--pf-t--global--spacer--sm);
+  left: 50%;
+  transform: translateX(-50%);
+  padding: var(--pf-t--global--spacer--xs) var(--pf-t--global--spacer--sm);
+  border-radius: var(--pf-t--global--border--radius--pill);
+  background: var(--pf-t--global--background--color--primary--default);
+  box-shadow: var(--pf-t--global--box-shadow--sm);
+  color: var(--pf-t--global--text--color--subtle);
+  font-size: var(--pf-t--global--font--size--body--sm);
   font-variant-numeric: tabular-nums;
+}
+
+.na-modal__sidebar {
+  display: flex;
+  flex: 0 0 22rem;
+  flex-direction: column;
+  gap: var(--pf-t--global--spacer--sm);
+  max-width: 22rem;
+  padding: var(--pf-t--global--spacer--lg);
+  border-inline-start: 1px solid var(--pf-t--global--border--color--default);
+  overflow: auto;
+}
+
+.na-modal__title {
+  margin: 0;
+  padding-inline-end: var(--pf-t--global--spacer--xl);
+  font-size: var(--pf-t--global--font--size--heading--sm);
+  line-height: 1.25;
+}
+
+.na-modal__page-title {
+  margin: 0;
+  color: var(--pf-t--global--text--color--subtle);
+  font-size: var(--pf-t--global--font--size--body--sm);
+}
+
+.na-modal__description {
+  margin: 0;
+}
+
+.na-modal__facts {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--pf-t--global--spacer--xs) var(--pf-t--global--spacer--md);
+  margin: 0;
+}
+
+.na-modal__fact[hidden],
+.na-modal__description[hidden],
+.na-modal__page-title[hidden] {
+  display: none;
+}
+
+.na-modal__fact {
+  display: flex;
+  gap: var(--pf-t--global--spacer--xs);
+
+  dt {
+    font-weight: 600;
+  }
+
+  dd {
+    margin: 0;
+  }
+}
+
+.na-modal__open {
+  align-self: flex-start;
+  margin-block-start: auto;
+}
+
+body.na-modal-open {
+  overflow: hidden;
+}
+
+@media (max-width: 48rem) {
+  .na-modal__bullseye {
+    padding: 0;
+  }
+
+  .na-modal {
+    position: fixed;
+    inset: 0;
+    width: 100vw;
+    max-width: none;
+    height: 100dvh;
+    max-height: none;
+    margin: 0;
+    border-radius: 0;
+  }
+
+  .na-modal .pf-v6-c-modal-box__body {
+    flex-direction: column;
+  }
+
+  .na-modal .pf-v6-c-modal-box__body {
+    width: 100vw;
+    max-width: 100vw;
+  }
+
+  .na-modal__stage {
+    flex: 1 1 66.667%;
+    width: 100%;
+    min-width: 0;
+    min-height: 0;
+  }
+
+  .na-modal__sidebar {
+    flex: 0 1 33.333%;
+    max-width: none;
+    max-height: 33.333%;
+    padding: var(--pf-t--global--spacer--sm) var(--pf-t--global--spacer--md);
+    padding-block-end: calc(
+      var(--pf-t--global--spacer--sm) + env(safe-area-inset-bottom, 0px)
+    );
+    border-block-start: 1px solid var(--pf-t--global--border--color--default);
+    border-inline-start: 0;
+  }
+
+  .na-modal .pf-v6-c-modal-box__close {
+    top: calc(var(--pf-t--global--spacer--sm) + env(safe-area-inset-top, 0px));
+    right: var(--pf-t--global--spacer--sm);
+  }
+
+  .na-modal__title {
+    font-size: var(--pf-t--global--font--size--heading--xs);
+  }
+
+  .na-modal__prev {
+    left: var(--pf-t--global--spacer--xs);
+  }
+
+  .na-modal__next {
+    right: var(--pf-t--global--spacer--xs);
+  }
 }
 
 .na-portfolio__header.pf-m-sticky-top {

