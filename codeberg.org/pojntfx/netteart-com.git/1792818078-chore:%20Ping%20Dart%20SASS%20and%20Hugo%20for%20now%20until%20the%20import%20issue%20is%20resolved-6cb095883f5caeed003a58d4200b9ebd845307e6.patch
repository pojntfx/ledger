From 6cb095883f5caeed003a58d4200b9ebd845307e6 Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Fri, 23 Oct 2026 22:01:18 -0700
Subject: [PATCH] chore: Ping Dart SASS and Hugo for now until the import issue is resolved
---
diff --git a/.forgejo/workflows/hugo.yaml b/.forgejo/workflows/hugo.yaml
index 1ab600783400841029681c8f0ae1ba369ecb46cd..96e557f7f2d1c8ee8a272d38523732e66df5e46b 100644
--- a/.forgejo/workflows/hugo.yaml
+++ b/.forgejo/workflows/hugo.yaml
@@ -15,8 +15,8 @@ jobs:
   build:
     runs-on: codeberg-small
     env:
-      DART_SASS_VERSION: 1.106.1
-      HUGO_VERSION: 0.168.0
+      DART_SASS_VERSION: 1.105.0 # TODO: Bump this version once SCSS import resolution is fixed in Hugo/Dart Sass
+      HUGO_VERSION: 0.166.0 # TODO: Bump this version once SCSS import resolution is fixed in Hugo/Dart Sass
       NODE_VERSION: 26.12.1
     steps:
       - name: Checkout
diff --git a/assets/scss/main.scss b/assets/scss/main.scss
index a0489384d4647c19b0cceb7f45d0d7d0ec6bf13b..87b1801218da4e2152a91150786bd1876d7816b1 100644
--- a/assets/scss/main.scss
+++ b/assets/scss/main.scss
@@ -1,10 +1,10 @@
 // See https://discourse.gohugo.io/t/initialize-sass-variables-from-hugo-templates/42053#p-137235-the-new-way-2
 @use "hugo:vars" as h;
 
-@use "../../node_modules/@fontsource-utils/scss/src/mixins" as fontsource with (
+@use "@fontsource-utils/scss/src/mixins" as fontsource with (
   $directory: "../fonts/ubuntu"
 );
-@use "../../node_modules/@fontsource/ubuntu/scss/metadata" as ubuntu;
+@use "@fontsource/ubuntu/scss/metadata" as ubuntu;
 
 // 300 and 400 are for the hero subtitle
 @include fontsource.faces(

