index 641522defbab9e0c968ab9a7bf8382085e33ae28..b0effe3c7a573de0db8ebb3694366b35c69c657c 100644
--- a/assets/js/body.js
+++ b/assets/js/body.js
@@ -146,7 +146,7 @@     const body = document.body;
 
     document.querySelectorAll(".na-modal__source").forEach((el) =>
       el.addEventListener("click", (e) => {
-        const item = JSON.parse(e.target.dataset.item);
+        const item = JSON.parse(e.currentTarget.dataset.item);
 
         const modal = Document.parseHTMLUnsafe(`<div class="pf-v6-c-backdrop">
       <div class="pf-v6-l-bullseye">
@@ -159,7 +159,7 @@           <div class="pf-v6-c-modal-box__close">
             <button
               class="pf-v6-c-button pf-m-plain"
               type="button"
-              aria-label="Close"
+              aria-label="Schließen"
             >
               <span class="pf-v6-c-button__icon">
                 <svg
@@ -190,12 +190,31 @@           </header>
           <div
             class="pf-v6-c-modal-box__body na-modal__body"
           >
-          <img loading="lazy" class="na-modal__img" />
+            <div class="na-modal__meta">
+              <p class="na-modal__description" hidden></p>
+              <dl class="na-modal__facts">
+                <div class="na-modal__fact na-modal__fact--pages" hidden>
+                  <dt>Umfang</dt>
+                  <dd class="na-modal__pages"></dd>
+                </div>
+                <div class="na-modal__fact na-modal__fact--format" hidden>
+                  <dt>Format</dt>
+                  <dd class="na-modal__format"></dd>
+                </div>
+                <div class="na-modal__fact na-modal__fact--year" hidden>
+                  <dt>Jahr</dt>
+                  <dd class="na-modal__year"></dd>
+                </div>
+              </dl>
+            </div>
+            <div class="na-modal__stage">
+              <img loading="lazy" class="na-modal__img" />
+            </div>
           </div>
           <footer class="pf-v6-c-modal-box__footer na-modal__footer">
             <button
               type="button"
-              aria-label="Previous"
+              aria-label="Vorherige Seite"
               class="pf-v6-c-button pf-m-control na-modal__prev"
               disabled
               aria-disabled="true"
@@ -207,7 +226,7 @@             <span class="pf-v6-u-text-color-subtle pf-v6-u-mb-xs na-modal__pagination"
               ></span
             ><button
               type="button"
-              aria-label="Next"
+              aria-label="Nächste Seite"
               class="pf-v6-c-button pf-m-control pf-v6-u-ml-sm na-modal__next"
               disabled
               aria-disabled="true"
@@ -226,7 +245,34 @@         const modalBox = modal.querySelector(".pf-v6-c-modal-box");
         modalBox.ariaLabelledByElements = [title];
         modalBox.ariaDescribedByElements = [description];
 
-        title.textContent = `${item.title} (${item.year})`;
+        title.textContent = item.title;
+
+        const descriptionText = modal.querySelector(".na-modal__description");
+        if (item.description) {
+          descriptionText.textContent = item.description;
+          descriptionText.hidden = false;
+        }
+
+        const setFact = (selector, value) => {
+          const fact = modal.querySelector(selector);
+
+          if (!value) {
+            fact.hidden = true;
+            return;
+          }
+
+          fact.querySelector("dd").textContent = value;
+          fact.hidden = false;
+        };
+
+        setFact(
+          ".na-modal__fact--pages",
+          item.pages
+            ? `${item.pages} ${item.pages === 1 ? "Seite" : "Seiten"}`
+            : "",
+        );
+        setFact(".na-modal__fact--format", item.format);
+        setFact(".na-modal__fact--year", item.year ? String(item.year) : "");
 
         const lastFocus = e.currentTarget;
 
@@ -269,7 +315,7 @@
           img.src = image.src;
           img.width = image.width;
           img.height = image.height;
-          img.alt = image.title;
+          img.alt = image.alt || image.title;
 
           pagination.textContent = `${index + 1}/${item.images.length}`;
 
diff --git a/assets/scss/main.scss b/assets/scss/main.scss
index e819ab055b286014f3857671604ce82afdeaabe0..ef4d0243a319de2d80e5ba2722364c80db981660 100644
--- a/assets/scss/main.scss
+++ b/assets/scss/main.scss
@@ -561,6 +561,57 @@     width: 100%;
   }
 }
 
+.na-portfolio__masonry--tiles {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: flex-end;
+  justify-content: center;
+  gap: var(--pf-t--global--spacer--xl);
+  width: 100%;
+  columns: auto;
+}
+
+.na-tile {
+  display: flex;
+  flex: 0 0 auto;
+  width: auto;
+  height: clamp(8rem, 11vw, 11rem);
+  padding: 0;
+  border: 0;
+  border-radius: 0;
+  background: transparent;
+  cursor: pointer;
+
+  &:focus-visible {
+    outline: 2px solid var(--pf-t--global--focus-ring--color--default);
+    outline-offset: 2px;
+  }
+
+  &__img {
+    display: block;
+    width: auto;
+    height: 100%;
+    max-width: none;
+    object-fit: contain;
+    transition: opacity 120ms ease-in-out;
+  }
+}
+
+.na-tile__img--shadow {
+  filter: drop-shadow(
+    var(--pf-t--global--box-shadow--X--md--default)
+      var(--pf-t--global--box-shadow--Y--md--default)
+      var(--pf-t--global--box-shadow--blur--md)
+      var(--pf-t--global--box-shadow--color--md--default)
+  );
+}
+
+@media (hover: hover) {
+  .na-tile:hover .na-tile__img {
+    opacity: 0.85;
+  }
+}
+
 .na-portfolio__card {
   position: relative;
   overflow: hidden;
@@ -653,11 +704,54 @@ }
 
 .na-modal__body {
   display: flex;
-  align-content: center;
+  flex-direction: column;
+  gap: var(--pf-t--global--spacer--md);
+}
+
+.na-modal__meta {
+  display: flex;
+  flex-direction: column;
+  gap: var(--pf-t--global--spacer--sm);
+}
+
+.na-modal__description {
+  margin: 0;
+}
+
+.na-modal__facts {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--pf-t--global--spacer--sm) var(--pf-t--global--spacer--md);
+  margin: 0;
+}
+
+.na-modal__fact[hidden],
+.na-modal__description[hidden] {
+  display: none;
+}
+
+.na-modal__fact {
+  display: flex;
+  gap: var(--pf-t--global--spacer--xs);
+
+  dt {
+    font-weight: 600;
+  }
+
+  dd {
+    margin: 0;
+  }
+}
+
+.na-modal__stage {
+  display: flex;
   justify-content: center;
+  align-items: center;
 
   > img {
     width: auto;
+    max-width: 100%;
+    height: auto;
   }
 }
 
