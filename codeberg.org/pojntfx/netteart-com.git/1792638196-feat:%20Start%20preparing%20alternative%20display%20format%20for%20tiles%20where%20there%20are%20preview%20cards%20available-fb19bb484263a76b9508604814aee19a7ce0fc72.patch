diff --git a/layouts/_partials/alt.html b/layouts/_partials/alt.html
new file mode 100644
index 0000000000000000000000000000000000000000..d01984278652597a568f36516698e17709a27c50
--- /dev/null
+++ b/layouts/_partials/alt.html
@@ -0,0 +1,14 @@
+{{- $alt := .alt | default "" -}}
+{{- if not $alt -}}
+  {{- $parts := slice -}}
+  {{- $type := .type | default "Abbildung" -}}
+  {{- $parts = $parts | append (printf "%s %s" $type .title) -}}
+  {{- with .side -}}
+    {{- $parts = $parts | append . -}}
+  {{- end -}}
+  {{- with .year -}}
+    {{- $parts = $parts | append (printf "%v" .) -}}
+  {{- end -}}
+  {{- $alt = delimit $parts ", " -}}
+{{- end -}}
+{{- return $alt -}}
diff --git a/layouts/_partials/portfolio-card-tile.html b/layouts/_partials/portfolio-card-tile.html
new file mode 100644
index 0000000000000000000000000000000000000000..cf28b85edb759d8c17797071015d1403ae7eeda5
--- /dev/null
+++ b/layouts/_partials/portfolio-card-tile.html
@@ -0,0 +1,34 @@
+{{- $item := .item -}}
+{{- $type := .type | default "Flyer" -}}
+{{- $tile := "" -}}
+{{- with $item.tile -}}
+  {{- $tile = resources.Get . -}}
+{{- else -}}
+  {{- $tile = resources.Get (index $item.items 0).src -}}
+{{- end -}}
+{{- $tile = $tile.Process "fit 500x500 webp q80" -}}
+{{- $tileAlt := partial "alt" (dict "alt" $item.tileAlt "type" $type "title" $item.title "side" "Titelseite" "year" $item.year) -}}
+{{- $images := slice -}}
+{{- range $item.items -}}
+  {{- $image := resources.Get .src -}}
+  {{- $image = $image.Process "webp q80" -}}
+  {{- $imageAlt := partial "alt" (dict "alt" .alt "type" $type "title" $item.title "side" .title "year" .year) -}}
+  {{- $images = $images | append (dict "title" .title "alt" $imageAlt "src" $image.RelPermalink "width" $image.Width "height" $image.Height) -}}
+{{- end -}}
+{{- $data := dict "title" $item.title "year" $item.year "description" $item.description "pages" $item.pages "format" $item.format "images" $images -}}
+<button
+  type="button"
+  class="na-tile na-modal__source"
+  id="{{ $item.id }}"
+  aria-haspopup="dialog"
+  data-item="{{ $data | jsonify }}"
+>
+  <img
+    class="na-tile__img na-tile__img--shadow"
+    src="{{ $tile.RelPermalink }}"
+    width="{{ $tile.Width }}"
+    height="{{ $tile.Height }}"
+    alt="{{ $tileAlt }}"
+    loading="lazy"
+  />
+</button>
