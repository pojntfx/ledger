From 891ac6f68f230f0123b5dc0015fde1a7cc319ab6 Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Fri, 23 Oct 2026 21:31:52 -0700
Subject: [PATCH] chore: Bump workflow conventions
---
diff --git a/.forgejo/workflows/hugo.yaml b/.forgejo/workflows/hugo.yaml
index 0c324607be106ff00085b149bd59f8b71c7ebdf1..19523eb9e31d7ed05cc580974d44f8a50cb610f9 100644
--- a/.forgejo/workflows/hugo.yaml
+++ b/.forgejo/workflows/hugo.yaml
@@ -1,25 +1,30 @@
 # Based on https://codeberg.org/steiger/hugo-on-codeberg-pages-documentation#4-set-up-forgejo-action
-# and https://github.com/vanlug/vanlug.github.io/blob/main/.github/workflows/hugo.yaml
+# and https://github.com/vanlug/vanlug.github.io/blob/main/.github/workflows/hugo.yaml.
+# Also see https://git.vanlug.ca/vanlug/vanlug.ca/src/branch/main/.forgejo/workflows/hugo.yaml.
 
 name: Hugo CI
+
 on:
   push:
     branches:
       - main
+  # We allow manually triggering the workflow, e.g. to quickly patch a known CVE not tracked in code (e.g. in Debian's repos) or to run actions after an initial mirror
+  workflow_dispatch:
+
 jobs:
   build:
     runs-on: codeberg-small
     env:
-      DART_SASS_VERSION: 1.100.0
-      HUGO_VERSION: 0.162.1
-      NODE_VERSION: 26.3.0
+      DART_SASS_VERSION: 1.102.0
+      HUGO_VERSION: 0.165.0
+      NODE_VERSION: 26.7.0
     steps:
       - name: Checkout
-        uses: actions/checkout@v6
+        uses: https://code.forgejo.org/actions/checkout@v7
         with:
           fetch-depth: 0
       - name: Setup Node.js
-        uses: actions/setup-node@v6
+        uses: https://code.forgejo.org/actions/setup-node@v7
         with:
           node-version: ${{ env.NODE_VERSION }}
       - name: Install Dart Sass
@@ -46,7 +51,7 @@             --gc \
             --minify \
             --baseURL "https://netteart.com/"
       - name: Deploy to Forgejo Pages at netteart.com
-        uses: actions/git-pages@v2
+        uses: https://code.forgejo.org/actions/git-pages@v2
         with:
           site: https://netteart.com/
           server: codeberg.page
@@ -54,7 +59,7 @@           token: ${{ forge.token }}
           source: public/
       # See https://docs.codeberg.org/codeberg-pages/using-custom-domain/#deploying-to-versions-of-your-domain-both-with-and-without-www.
       - name: Deploy to Forgejo Pages at www.netteart.com
-        uses: actions/git-pages@v2
+        uses: https://code.forgejo.org/actions/git-pages@v2
         with:
           site: https://www.netteart.com/
           server: codeberg.page

