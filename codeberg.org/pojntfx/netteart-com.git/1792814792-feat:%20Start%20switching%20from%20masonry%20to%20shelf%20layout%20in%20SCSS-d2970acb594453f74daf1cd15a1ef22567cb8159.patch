diff --git a/assets/js/body.js b/assets/js/body.js
index 0e153e3492805b2715e2ba14e9d76cebddc155cf..5480f79d66448ef6942d9614826e5f10ea943ccb 100644
--- a/assets/js/body.js
+++ b/assets/js/body.js
@@ -109,35 +109,25 @@     );
 
     const SHRINK_DISTANCE = 120;
 
-    const sectionTops = new Map();
-
-    const measure = () =>
-      stickySections.forEach((section) => {
-        section.classList.remove("pf-m-stuck");
-        section.style.removeProperty("--stuck-progress");
-
-        sectionTops.set(section, section.getBoundingClientRect().top + scrollY);
-      });
-
     const syncStuck = () =>
       stickySections.forEach((section) => {
         const stickyTop = parseFloat(getComputedStyle(section).top) || 0;
         const rect = section.getBoundingClientRect();
+        const wrapperTop = section.parentElement.getBoundingClientRect().top;
 
-        const overshoot = scrollY + stickyTop - sectionTops.get(section);
-        const progress = Math.min(Math.max(overshoot / SHRINK_DISTANCE, 0), 1);
+        const stuck = rect.top <= stickyTop + 1;
+        const overshoot = stickyTop - wrapperTop;
+        const progress = stuck
+          ? Math.min(Math.max(overshoot / SHRINK_DISTANCE, 0), 1)
+          : 0;
 
         section.style.setProperty("--stuck-progress", progress);
-        section.classList.toggle("pf-m-stuck", progress > 0);
+        section.classList.toggle("pf-m-stuck", stuck);
       });
 
-    measure();
     syncStuck();
     addEventListener("scroll", syncStuck);
-    addEventListener("resize", () => {
-      measure();
-      syncStuck();
-    });
+    addEventListener("resize", syncStuck);
   })();
 
   // Collection rails
@@ -160,6 +150,11 @@         const max = maxScroll();
 
         previousButton.hidden = position <= 1;
         nextButton.hidden = position >= max - 1;
+        rail.classList.toggle("na-collection--overflow-start", position > 1);
+        rail.classList.toggle(
+          "na-collection--overflow-end",
+          position < max - 1,
+        );
       };
 
       const scrollByPage = (direction) => {
