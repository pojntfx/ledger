diff --git a/assets/js/body.js b/assets/js/body.js
index 641522defbab9e0c968ab9a7bf8382085e33ae28..8f0a64211195a2e8b2bc0cc861875706db5b3b68 100644
--- a/assets/js/body.js
+++ b/assets/js/body.js
@@ -140,13 +140,51 @@       syncStuck();
     });
   })();
 
+  // Collection rails
+  (() => {
+    document.querySelectorAll(".na-collection--rail").forEach((rail) => {
+      const track = rail.querySelector(".na-portfolio__shelf");
+      const previous = rail.querySelector(".na-rail__prev");
+      const next = rail.querySelector(".na-rail__next");
+
+      if (!track || !previous || !next) {
+        return;
+      }
+
+      const update = () => {
+        const maxScroll = track.scrollWidth - track.clientWidth;
+
+        previous.hidden = track.scrollLeft <= 1;
+        next.hidden = track.scrollLeft >= maxScroll - 1;
+      };
+
+      const scroll = (direction) => {
+        track.scrollBy({
+          left: direction * track.clientWidth * 0.8,
+          behavior: "smooth",
+        });
+      };
+
+      previous.addEventListener("click", () => scroll(-1));
+      next.addEventListener("click", () => scroll(1));
+      track.addEventListener("scroll", update, { passive: true });
+
+      if ("ResizeObserver" in window) {
+        new ResizeObserver(update).observe(track);
+      }
+
+      addEventListener("resize", update);
+      update();
+    });
+  })();
+
   // Modals
   (() => {
     const body = document.body;
 
     document.querySelectorAll(".na-modal__source").forEach((el) =>
       el.addEventListener("click", (e) => {
-        const item = JSON.parse(e.target.dataset.item);
+        const item = JSON.parse(e.currentTarget.dataset.item);
 
         const modal = Document.parseHTMLUnsafe(`<div class="pf-v6-c-backdrop">
       <div class="pf-v6-l-bullseye">
@@ -159,7 +197,7 @@           <div class="pf-v6-c-modal-box__close">
             <button
               class="pf-v6-c-button pf-m-plain"
               type="button"
-              aria-label="Close"
+              aria-label="Schließen"
             >
               <span class="pf-v6-c-button__icon">
                 <svg
@@ -190,12 +228,31 @@           </header>
           <div
             class="pf-v6-c-modal-box__body na-modal__body"
           >
-          <img loading="lazy" class="na-modal__img" />
+            <div class="na-modal__meta">
+              <p class="na-modal__description" hidden></p>
+              <dl class="na-modal__facts">
+                <div class="na-modal__fact na-modal__fact--year" hidden>
+                  <dt>Jahr</dt>
+                  <dd class="na-modal__year"></dd>
+                </div>
+                <div class="na-modal__fact na-modal__fact--pages" hidden>
+                  <dt>Umfang</dt>
+                  <dd class="na-modal__pages"></dd>
+                </div>
+                <div class="na-modal__fact na-modal__fact--format" hidden>
+                  <dt>Format</dt>
+                  <dd class="na-modal__format"></dd>
+                </div>
+              </dl>
+            </div>
+            <div class="na-modal__stage">
+              <img loading="lazy" class="na-modal__img" />
+            </div>
           </div>
           <footer class="pf-v6-c-modal-box__footer na-modal__footer">
             <button
               type="button"
-              aria-label="Previous"
+              aria-label="Vorherige Seite"
               class="pf-v6-c-button pf-m-control na-modal__prev"
               disabled
               aria-disabled="true"
@@ -207,7 +264,7 @@             <span class="pf-v6-u-text-color-subtle pf-v6-u-mb-xs na-modal__pagination"
               ></span
             ><button
               type="button"
-              aria-label="Next"
+              aria-label="Nächste Seite"
               class="pf-v6-c-button pf-m-control pf-v6-u-ml-sm na-modal__next"
               disabled
               aria-disabled="true"
@@ -226,7 +283,34 @@         const modalBox = modal.querySelector(".pf-v6-c-modal-box");
         modalBox.ariaLabelledByElements = [title];
         modalBox.ariaDescribedByElements = [description];
 
-        title.textContent = `${item.title} (${item.year})`;
+        title.textContent = item.title;
+
+        const descriptionText = modal.querySelector(".na-modal__description");
+        if (item.description) {
+          descriptionText.textContent = item.description;
+          descriptionText.hidden = false;
+        }
+
+        const setFact = (selector, value) => {
+          const fact = modal.querySelector(selector);
+
+          if (!value) {
+            fact.hidden = true;
+            return;
+          }
+
+          fact.querySelector("dd").textContent = value;
+          fact.hidden = false;
+        };
+
+        setFact(
+          ".na-modal__fact--pages",
+          item.pages
+            ? `${item.pages} ${item.pages === 1 ? "Seite" : "Seiten"}`
+            : "",
+        );
+        setFact(".na-modal__fact--format", item.format);
+        setFact(".na-modal__fact--year", item.year ? String(item.year) : "");
 
         const lastFocus = e.currentTarget;
 
@@ -256,6 +340,14 @@           ".pf-v6-c-modal-box__close > button",
         );
         closeButton.addEventListener("click", closeModal);
 
+        modal.addEventListener("click", (event) => {
+          if (event.target.closest(".pf-v6-c-modal-box")) {
+            return;
+          }
+
+          closeModal();
+        });
+
         const img = modal.querySelector(".na-modal__img");
         const pagination = modal.querySelector(".na-modal__pagination");
         const previousButton = modal.querySelector(".na-modal__prev");
@@ -269,7 +361,7 @@
           img.src = image.src;
           img.width = image.width;
           img.height = image.height;
-          img.alt = image.title;
+          img.alt = image.alt || image.title;
 
           pagination.textContent = `${index + 1}/${item.images.length}`;
 
