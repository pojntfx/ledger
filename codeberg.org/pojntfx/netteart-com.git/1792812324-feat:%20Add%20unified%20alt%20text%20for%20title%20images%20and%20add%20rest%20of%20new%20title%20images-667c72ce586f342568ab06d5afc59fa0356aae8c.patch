diff --git a/layouts/_partials/portfolio-card-tile.html b/layouts/_partials/portfolio-card-tile.html
new file mode 100644
index 0000000000000000000000000000000000000000..da17e542e50987ad0df1737d00ab0debfe943b48
--- /dev/null
+++ b/layouts/_partials/portfolio-card-tile.html
@@ -0,0 +1,38 @@
+{{- $item := .item -}}
+{{- $cover := $item.tile | default $item.src -}}
+{{- if not $cover -}}
+  {{- $cover = (index $item.items 0).src -}}
+{{- end -}}
+{{- $tile := resources.Get $cover -}}
+{{- $tile = $tile.Process "fit 500x500 webp q80" -}}
+{{- $tileAlt := $item.tileAlt | default $item.alt -}}
+{{- $images := slice -}}
+{{- with $item.src -}}
+  {{- $image := resources.Get . -}}
+  {{- $image = $image.Process "webp q80" -}}
+  {{- $imageAlt := $item.alt -}}
+  {{- $images = $images | append (dict "title" "Titelseite" "alt" $imageAlt "src" $image.RelPermalink "width" $image.Width "height" $image.Height) -}}
+{{- end -}}
+{{- range $item.items -}}
+  {{- $image := resources.Get .src -}}
+  {{- $image = $image.Process "webp q80" -}}
+  {{- $imageAlt := .alt -}}
+  {{- $images = $images | append (dict "title" .title "alt" $imageAlt "src" $image.RelPermalink "width" $image.Width "height" $image.Height) -}}
+{{- end -}}
+{{- $data := dict "title" $item.title "year" $item.year "description" $item.description "pages" $item.pages "format" $item.format "images" $images -}}
+<button
+  type="button"
+  class="na-tile na-modal__source"
+  id="{{ $item.id }}"
+  aria-haspopup="dialog"
+  data-item="{{ $data | jsonify }}"
+>
+  <img
+    class="na-tile__img na-tile__img--shadow"
+    src="{{ $tile.RelPermalink }}"
+    width="{{ $tile.Width }}"
+    height="{{ $tile.Height }}"
+    alt="{{ $tileAlt }}"
+    loading="lazy"
+  />
+</button>
