From 5dc739cc42cc5be0f8e50afd285e38786bd38bbf Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Fri, 23 Oct 2026 21:49:06 -0700
Subject: [PATCH] fix: Use manual imports to work around Hugo lacking `NodePackageImporter` support
---
diff --git a/assets/scss/main.scss b/assets/scss/main.scss
index 87b1801218da4e2152a91150786bd1876d7816b1..a0489384d4647c19b0cceb7f45d0d7d0ec6bf13b 100644
--- a/assets/scss/main.scss
+++ b/assets/scss/main.scss
@@ -1,10 +1,10 @@
 // See https://discourse.gohugo.io/t/initialize-sass-variables-from-hugo-templates/42053#p-137235-the-new-way-2
 @use "hugo:vars" as h;
 
-@use "@fontsource-utils/scss/src/mixins" as fontsource with (
+@use "../../node_modules/@fontsource-utils/scss/src/mixins" as fontsource with (
   $directory: "../fonts/ubuntu"
 );
-@use "@fontsource/ubuntu/scss/metadata" as ubuntu;
+@use "../../node_modules/@fontsource/ubuntu/scss/metadata" as ubuntu;
 
 // 300 and 400 are for the hero subtitle
 @include fontsource.faces(

