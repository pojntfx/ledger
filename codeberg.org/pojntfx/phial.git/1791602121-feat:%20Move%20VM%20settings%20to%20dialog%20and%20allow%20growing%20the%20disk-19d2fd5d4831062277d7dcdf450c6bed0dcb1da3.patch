+func (a *App) showEditDialog(def virt.Definition) {
+	dialog := adw.NewDialog()
+	dialog.SetTitle(i18n.L("Edit Machine"))
+	dialog.SetContentWidth(440)
+	dialog.SetContentHeight(640)
+
+	toolbar := adw.NewToolbarView()
+	header := adw.NewHeaderBar()
+	header.SetShowStartTitleButtons(false)
+
+	title := adw.NewWindowTitle(i18n.L("Edit Machine"), def.Name)
+	header.SetTitleWidget(&title.Widget)
+	toolbar.AddTopBar(&header.Widget)
+
+	page := adw.NewPreferencesPage()
+
+	identityGroup := adw.NewPreferencesGroup()
+	identityGroup.SetTitle(i18n.L("Identity"))
+
+	nameRow := adw.NewEntryRow()
+	nameRow.SetTitle(i18n.L("Name"))
+	nameRow.SetText(def.Name)
+	nameRow.SetShowApplyButton(false)
+	identityGroup.Add(&nameRow.Widget)
+
+	page.Add(identityGroup)
+
+	hardwareGroup := adw.NewPreferencesGroup()
+	hardwareGroup.SetTitle(i18n.L("Hardware"))
+
+	vcpus := def.VCPUs
+	if vcpus < 1 {
+		vcpus = 1
+	}
+
+	cpuAdjustment := gtk.NewAdjustment(float64(vcpus), 1, 64, 1, 4, 0)
+	cpuRow := adw.NewSpinRow(cpuAdjustment, 1, 0)
+	cpuRow.SetTitle(i18n.L("CPU Count"))
+	hardwareGroup.Add(&cpuRow.Widget)
+
+	memoryGiB, err := strconv.Atoi(sizeDigits(def.Memory))
+	if err != nil || memoryGiB < 1 {
+		memoryGiB = 8
+	}
+
+	memoryRow := adw.NewSpinRow(gtk.NewAdjustment(float64(memoryGiB), 1, 256, 1, 8, 0), 1, 0)
+	memoryRow.SetTitle(i18n.L("Memory"))
+	memoryRow.SetNumeric(true)
+
+	memoryUnit := gtk.NewLabel(i18n.L("GiB"))
+	memoryUnit.AddCssClass("dim-label")
+	memoryUnit.SetMarginEnd(8)
+	memoryRow.AddSuffix(&memoryUnit.Widget)
+	hardwareGroup.Add(&memoryRow.Widget)
+
+	diskGiB, err := strconv.Atoi(sizeDigits(def.DiskSize))
+	if err != nil || diskGiB < 8 {
+		diskGiB = 40
+	}
+
+	diskRow := adw.NewSpinRow(gtk.NewAdjustment(float64(diskGiB), 8, 2048, 1, 16, 0), 1, 0)
+	diskRow.SetTitle(i18n.L("Disk Size"))
+	diskRow.SetNumeric(true)
+
+	diskUnit := gtk.NewLabel(i18n.L("GiB"))
+	diskUnit.AddCssClass("dim-label")
+	diskUnit.SetMarginEnd(8)
+	diskRow.AddSuffix(&diskUnit.Widget)
+	hardwareGroup.Add(&diskRow.Widget)
+
+	page.Add(hardwareGroup)
+
+	displayGroup := adw.NewPreferencesGroup()
+	displayGroup.SetTitle(i18n.L("Display"))
+
+	display := def.Display
+	gpu := def.GPU
+	secureBoot := def.SecureBoot
+
+	displayGroup.Add(&a.comboRow(i18n.L("Display"),
+		[]string{i18n.L("Headless"), i18n.L("Window"), i18n.L("Off")},
+		[]string{"egl-headless", "gtk", "none"},
+		def.Display, func(value string) {
+			display = value
+		}).Widget)
+
+	displayGroup.Add(&a.comboRow(i18n.L("GPU"),
+		[]string{"Venus", "VirGL", i18n.L("Off")},
+		[]string{"venus", "virgl", "none"},
+		def.GPU, func(value string) {
+			gpu = value
+		}).Widget)
+
+	displayGroup.Add(&a.switchRow(i18n.L("Secure Boot"), def.SecureBoot, func(value bool) {
+		secureBoot = value
+	}).Widget)
+
+	page.Add(displayGroup)
+
+	actionGroup := adw.NewPreferencesGroup()
+
+	actionGroup.Add(&a.buttonRow(i18n.L("Save the changes"), "document-save-symbolic", func() {
+		vcpuCount := int(cpuRow.GetValue())
+
+		memory := strconv.Itoa(int(memoryRow.GetValue())) + "G"
+		diskSize := strconv.Itoa(int(diskRow.GetValue())) + "G"
+		newName := strings.TrimSpace(nameRow.GetText())
+
+		input := mcp.VmUpdateInput{
+			Name:       def.Name,
+			Display:    display,
+			GPU:        gpu,
+			VCPUs:      &vcpuCount,
+			SecureBoot: &secureBoot,
+		}
+
+		input.Memory = memory
+		input.DiskSize = diskSize
+
+		if newName != "" && newName != def.Name {
+			input.NewName = newName
+		}
+
+		a.goAsync(func() (string, error) {
+			if _, _, err := a.Service.VmUpdate(a.Ctx, nil, input); err != nil {
+				return "", err
+			}
+
+			target := def.Name
+
+			if input.NewName != "" {
+				target = input.NewName
+			}
+
+			a.idle(func() { a.refreshVMDetail(target) })
+
+			return i18n.L("Machine updated"), nil
+		})
+
+		dialog.Close()
+	}).Widget)
+
+	page.Add(actionGroup)
+
+	toolbar.SetContent(&page.Widget)
+	dialog.SetChild(&toolbar.Widget)
+	dialog.Present(&a.window.Widget)
+}
+
+func sizeDigits(size string) string {
+	value := strings.TrimSpace(size)
+
+	for _, unit := range []string{"K", "k", "M", "m", "G", "g", "T", "t"} {
+		value = strings.TrimSuffix(value, unit)
+	}
+
+	return strings.TrimSpace(value)
+}
+
+func sizeValue(digits string) string {
+	value := strings.TrimSpace(digits)
+	if value == "" {
+		return ""
+	}
+
+	if _, err := strconv.Atoi(value); err != nil {
+		return ""
+	}
+
+	return value + "G"
+}
