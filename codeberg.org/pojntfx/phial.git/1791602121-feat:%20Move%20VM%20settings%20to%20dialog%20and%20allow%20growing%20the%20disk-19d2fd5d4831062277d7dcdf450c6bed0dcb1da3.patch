diff --git a/internal/virt/vm.go b/internal/virt/vm.go
index 6c07ad0208ef7c324866419646ee606722a15477..1cfa799fee339a2df1a0b163e72e3be19e0beb73 100644
--- a/internal/virt/vm.go
+++ b/internal/virt/vm.go
@@ -233,3 +233,52 @@
 func (d Definition) Delete() error {
 	return os.Remove(filepath.Join(configDir(), "vms", d.Name+".json"))
 }
+
+func (d Definition) GrowDisk(size string) error {
+	target, err := parseSize(size)
+	if err != nil {
+		return err
+	}
+
+	image := d.DiskPathValue()
+
+	info, err := os.Stat(image)
+	if err != nil {
+		return err
+	}
+
+	if target <= info.Size() {
+		return nil
+	}
+
+	return os.Truncate(image, target)
+}
+
+func (d Definition) Rename(newName string) error {
+	configDirValue, err := os.UserConfigDir()
+	if err != nil {
+		return err
+	}
+
+	renamed := d
+	renamed.Name = newName
+
+	oldDisk := d.DiskPathValue()
+	newDisk := renamed.DiskPathValue()
+
+	if oldDisk != newDisk {
+		if _, err := os.Stat(oldDisk); err == nil {
+			if err := os.Rename(oldDisk, newDisk); err != nil {
+				return err
+			}
+		}
+	}
+
+	oldConfig := filepath.Join(configDirValue, "phial", "vms", d.Name+".json")
+
+	if err := os.Remove(oldConfig); err != nil && !os.IsNotExist(err) {
+		return err
+	}
+
+	return renamed.Save()
+}

