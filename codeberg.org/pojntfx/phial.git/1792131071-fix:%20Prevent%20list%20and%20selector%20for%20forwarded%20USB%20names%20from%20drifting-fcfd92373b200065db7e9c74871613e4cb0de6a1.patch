+++ b/internal/ui/devices.go
@@ -299,11 +299,21 @@ 			names[id] = name
 		}
 	}
 
+	attached := map[string]bool{}
+	if _, output, err := a.Service.UsbLs(a.Ctx, nil, mcp.NameInput{Name: page.def.Name}); err == nil && output != nil {
+		for _, device := range output.Devices {
+			id := fmt.Sprintf("%s:%s", device.Vendor, device.Product)
+			attached[id] = true
+
+			if name := shortUSBName(device.Name); name != "" {
+				names[id] = name
+			}
+		}
+	}
+
 	if sameStrings(page.deviceNames, page.def.USBDevices) {
 		for index, row := range page.deviceRows {
-			title, subtitle := deviceText(page.def.USBDevices[index], names)
-			row.SetTitle(title)
-			row.SetSubtitle(subtitle)
+			styleDeviceRow(row, page.def.USBDevices[index], names, attached)
 		}
 		return
 	}
@@ -318,9 +328,7 @@ 	for _, device := range page.def.USBDevices {
 		device := device
 
 		row := adw.NewActionRow()
-		title, subtitle := deviceText(device, names)
-		row.SetTitle(title)
-		row.SetSubtitle(subtitle)
+		styleDeviceRow(row, device, names, attached)
 		row.SetSubtitleSelectable(true)
 
 		remove := a.iconButton("user-trash-symbolic", i18n.L("Remove Device"), func() {
@@ -357,19 +365,41 @@ 	}
 	return device, ""
 }
 
+// styleDeviceRow writes the name, the state, and the dimmed look of one device
+// row. The row stays sensitive, so the user can still remove the device.
+func styleDeviceRow(row *adw.ActionRow, device string, names map[string]string, attached map[string]bool) {
+	title, subtitle := deviceText(device, names)
+
+	if attached[device] {
+		row.RemoveCssClass("dimmed")
+	} else {
+		if subtitle == "" {
+			subtitle = i18n.L("Disconnected")
+		} else {
+			subtitle = subtitle + " · " + i18n.L("Disconnected")
+		}
+
+		row.AddCssClass("dimmed")
+	}
+
+	row.SetTitle(title)
+	row.SetSubtitle(subtitle)
+}
