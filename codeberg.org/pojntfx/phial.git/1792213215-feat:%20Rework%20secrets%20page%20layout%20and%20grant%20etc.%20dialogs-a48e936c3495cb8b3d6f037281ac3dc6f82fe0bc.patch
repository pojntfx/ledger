+// showAddGPGKeyDialog imports one key file into the keyring of the host. The
+// file may carry a public key, a secret key, or both.
+func (a *App) showAddGPGKeyDialog() {
+	dialog := gtk.NewFileDialog()
+	dialog.SetTitle(i18n.L("Select the key file"))
+
+	home := glib.GetHomeDir()
+	startDir := filepath.Join(home, ".gnupg")
+	if _, err := os.Stat(startDir); err != nil {
+		startDir = home
+	}
+	dialog.SetInitialFolder(gio.FileNewForPath(startDir))
+
+	var cb gio.AsyncReadyCallback
+	cb = func(_ uintptr, resultPtr uintptr, _ uintptr) {
+		result := gio.AsyncResultBase{Ptr: resultPtr}
+		file, err := dialog.OpenFinish(&result)
+		if err != nil || file == nil {
+			return
+		}
+
+		a.goAsync(func() (string, error) {
+			if err := a.State.AddGPGKey(file.GetPath()); err != nil {
+				return "", err
+			}
+
+			a.idle(func() {
+				a.secretsSignature = ""
+				a.refreshSecretsPage()
+			})
+
+			return i18n.L("The key was imported"), nil
+		})
+	}
+	a.hold(&cb)
+
+	dialog.Open(&a.win.Window, nil, &cb, 0)
+}
