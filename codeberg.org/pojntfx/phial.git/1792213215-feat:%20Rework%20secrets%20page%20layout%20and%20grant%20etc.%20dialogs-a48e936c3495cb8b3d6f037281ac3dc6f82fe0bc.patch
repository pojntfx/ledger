+// AddGPGKey imports one key file into the keyring of the host. The file may
+// carry a public key, a secret key, or both.
+func (c *Client) AddGPGKey(path string) error {
+	if strings.TrimSpace(path) == "" {
+		return fmt.Errorf("a key file is required")
+	}
+
+	if output, err := hostcmd.Command("gpg", "--batch", "--import", path).CombinedOutput(); err != nil {
+		return fmt.Errorf("gpg: %s: %w", strings.TrimSpace(string(output)), err)
+	}
+
+	return nil
+}
