 }
 
 var (
@@ -61,24 +62,35 @@ 		subtitle := L("Environment file")
 		if token.Mode == state.SecretModeProxy {
 			subtitle = fmt.Sprintf(L("Proxy, %v"), token.Upstream)
 		}
-		appendSecretsRow(tokenModel, newSecretsRowItem(secretsRowToken, token.Name, subtitle, "dialog-password-symbolic"))
+		// TODO: Remove this mock once grants reference secrets.
+		if len(token.GrantedTo) > 0 {
+			subtitle += ", " + fmt.Sprintf(L("granted to %v"), strings.Join(token.GrantedTo, ", "))
+		}
+
+		appendSecretsRow(tokenModel, newSecretsRowItem(secretsRowToken, token.Name, subtitle, "dialog-password-symbolic", false))
 	}
 	if len(tokens) == 0 {
-		appendSecretsRow(tokenModel, newSecretsRowItem(secretsRowEmpty, L("No Tokens"), "", "dialog-password-symbolic"))
+		appendSecretsRow(tokenModel, newSecretsRowItem(secretsRowEmpty, L("No Tokens"), "", "dialog-password-symbolic", false))
 	}
-	appendSecretsRow(tokenModel, newSecretsRowItem(secretsRowAction, L("_Add Token..."), "", "list-add-symbolic"))
+	appendSecretsRow(tokenModel, newSecretsRowItem(secretsRowAction, L("_Add Token..."), "", "list-add-symbolic", false))
 	w.secretsTokensGroup.BindModel(tokenModel, &createSecretsRow, 0, &destroySecretsModel)
 	tokenModel.Unref()
 
 	sshKeys := w.store.SSHKeys()
 	sshKeyModel := gio.NewListStore(gTypeSecretsRowItem)
 	for _, key := range sshKeys {
+		// TODO: Remove this mock once grants reference SSH keys.
+		linked := len(key.LinkedTo) > 0
+
 		subtitle := shortFingerprint(key.Fingerprint) + ", " + strings.TrimPrefix(key.Type, "ssh-")
+		if linked {
+			subtitle += ", " + fmt.Sprintf(L("linked to %v"), strings.Join(key.LinkedTo, ", "))
+		}
 
-		appendSecretsRow(sshKeyModel, newSecretsRowItem(secretsRowSSHKey, key.Comment, subtitle, "channel-secure-symbolic"))
+		appendSecretsRow(sshKeyModel, newSecretsRowItem(secretsRowSSHKey, key.Comment, subtitle, "channel-secure-symbolic", linked))
 	}
 	if len(sshKeys) == 0 {
-		appendSecretsRow(sshKeyModel, newSecretsRowItem(secretsRowEmpty, L("No SSH Keys"), "", "channel-secure-symbolic"))
+		appendSecretsRow(sshKeyModel, newSecretsRowItem(secretsRowEmpty, L("No SSH Keys"), "", "channel-secure-symbolic", false))
 	}
 	w.secretsSSHKeysGroup.BindModel(sshKeyModel, &createSecretsRow, 0, &destroySecretsModel)
 	sshKeyModel.Unref()
@@ -86,12 +98,18 @@
 	gpgKeys := w.store.GPGKeys()
 	gpgKeyModel := gio.NewListStore(gTypeSecretsRowItem)
 	for _, key := range gpgKeys {
+		// TODO: Remove this mock once grants reference PGP keys.
+		linked := len(key.LinkedTo) > 0
+
 		subtitle := shortFingerprint(key.Fingerprint)
+		if linked {
+			subtitle += ", " + fmt.Sprintf(L("linked to %v"), strings.Join(key.LinkedTo, ", "))
+		}
 
-		appendSecretsRow(gpgKeyModel, newSecretsRowItem(secretsRowGPGKey, key.UID, subtitle, "security-high-symbolic"))
+		appendSecretsRow(gpgKeyModel, newSecretsRowItem(secretsRowGPGKey, key.UID, subtitle, "security-high-symbolic", linked))
 	}
 	if len(gpgKeys) == 0 {
-		appendSecretsRow(gpgKeyModel, newSecretsRowItem(secretsRowEmpty, L("No PGP Keys"), "", "security-high-symbolic"))
+		appendSecretsRow(gpgKeyModel, newSecretsRowItem(secretsRowEmpty, L("No PGP Keys"), "", "security-high-symbolic", false))
 	}
 	w.secretsGPGKeysGroup.BindModel(gpgKeyModel, &createSecretsRow, 0, &destroySecretsModel)
 	gpgKeyModel.Unref()
@@ -101,7 +119,7 @@ 		L("Manage SSH and PGP keys, and optionally tokens, in") + " " + seahorseHelpLink(L("Passwords and Keys")),
 	)
 }
 
-func newSecretsRowItem(kind secretsRowKind, title string, subtitle string, icon string) secretsRowItem {
+func newSecretsRowItem(kind secretsRowKind, title string, subtitle string, icon string, linked bool) secretsRowItem {
 	obj := gobject.NewObjectWithProperties(gTypeSecretsRowItem, 0, nil, nil)
 
 	var v secretsRowItem
@@ -112,6 +130,7 @@ 	item.kind = kind
 	item.title = title
 	item.subtitle = subtitle
 	item.icon = icon
+	item.linked = linked
 
 	return v
 }
@@ -158,6 +177,9 @@ 		row.AddSuffix(&newRowIconButton("insert-link-symbolic", L("Grant Access")).Widget)
 		row.AddSuffix(&newRowMenuButton(L("Token Menu")).Widget)
 	} else {
 		row.AddSuffix(&newRowIconButton("insert-link-symbolic", L("Link a Key")).Widget)
+		if item.linked {
+			row.AddSuffix(&newRowIconButton("window-close-symbolic", L("Unlink the Key")).Widget)
+		}
 	}
 
 	return row.GoPointer()
