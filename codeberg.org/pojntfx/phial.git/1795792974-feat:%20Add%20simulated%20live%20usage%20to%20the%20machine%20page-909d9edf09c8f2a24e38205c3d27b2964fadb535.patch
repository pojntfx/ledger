+func (p *MachinePage) refreshUsage(info state.MachineInfo) {
+	active := machineActive(info)
+
+	p.noUsageRow.SetVisible(!active)
+	p.usageCPURow.SetVisible(active)
+	p.usageMemoryRow.SetVisible(active)
+	p.usageDiskRow.SetVisible(active)
+	p.usageNetworkRow.SetVisible(active)
+
+	p.usageCPURow.SetSubtitle(fmt.Sprintf(L("%.1f of %d cores"), info.Usage.CPUPercent/100, info.Usage.VCPUs))
+	p.usageMemoryRow.SetSubtitle(fmt.Sprintf(
+		L("%s of %s"),
+		formatBytes(info.Usage.MemoryUsed),
+		formatBytes(info.Usage.MemoryTotal),
+	))
+
+	diskText := fmt.Sprintf(
+		L("%s of %s on this host"),
+		formatBytes(info.Usage.DiskAllocated),
+		formatBytes(info.Usage.DiskTotal),
+	)
+	if info.Usage.DiskReadRate > 0 || info.Usage.DiskWriteRate > 0 {
+		diskText = fmt.Sprintf(
+			L("%s, %s/s read, %s/s written"),
+			diskText,
+			formatBytes(uint64(info.Usage.DiskReadRate)),
+			formatBytes(uint64(info.Usage.DiskWriteRate)),
+		)
+	}
+	p.usageDiskRow.SetSubtitle(diskText)
+
+	networkText := L("No traffic")
+	if !info.Usage.NetworkReady {
+		networkText = L("The guest agent does not answer")
+	} else if info.Usage.NetworkRxRate > 0 || info.Usage.NetworkTxRate > 0 {
+		networkText = fmt.Sprintf(
+			L("%s/s received, %s/s sent"),
+			formatBytes(uint64(info.Usage.NetworkRxRate)),
+			formatBytes(uint64(info.Usage.NetworkTxRate)),
+		)
+	}
+	p.usageNetworkRow.SetSubtitle(networkText)
+
+	graphics := active && info.Usage.GPU != "" && info.Usage.GPU != "none"
+	p.usageGraphicsRow.SetVisible(graphics)
+	if graphics {
+		graphicsText := machineGraphicsText(info.Usage.GPU)
+		if info.Usage.GPUBusyReady {
+			graphicsText = fmt.Sprintf(L("%s, %.0f%% busy"), graphicsText, info.Usage.GPUBusy)
+		}
+
+		p.usageGraphicsRow.SetSubtitle(graphicsText)
+	}
+}
+
+func machineActive(info state.MachineInfo) bool {
+	switch info.Status {
+	case state.MachineStatusStarting, state.MachineStatusRunning, state.MachineStatusRestarting, state.MachineStatusUpdatingAgent:
+		return true
+	default:
+		return false
+	}
+}
+
+func machineGraphicsText(value string) string {
+	switch value {
+	case "virgl":
+		return "VirGL"
+	case "none", "":
+		return L("Off")
+	default:
+		return L("Venus")
+	}
+}
+
