diff --git a/assets/resources/shortcuts-dialog.blp b/assets/resources/shortcuts-dialog.blp
index 527d5d60d53230d23cc4299f1a909d931ff17ba9..fcd2585359717fabf7a175e11d12e76b09009850 100644
--- a/assets/resources/shortcuts-dialog.blp
+++ b/assets/resources/shortcuts-dialog.blp
@@ -11,11 +11,6 @@       accelerator: "F10";
     }
 
     Adw.ShortcutsItem {
-      title: _("New machine");
-      action-name: "win.newMachine";
-    }
-
-    Adw.ShortcutsItem {
       title: _("Show keyboard shortcuts");
       action-name: "app.shortcuts";
     }
@@ -28,6 +23,15 @@
     Adw.ShortcutsItem {
       title: _("Quit");
       action-name: "app.quit";
+    }
+  }
+
+  Adw.ShortcutsSection {
+    title: _("Machines");
+
+    Adw.ShortcutsItem {
+      title: _("New machine");
+      action-name: "win.newMachine";
     }
   }
 }
