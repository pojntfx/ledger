+// pageContentWithBanner wraps boxed lists like pageContent and puts a banner
+// above them, full width, as the HIG shows it. A hidden banner collapses, so
+// no spacer stays behind.
+func (a *App) pageContentWithBanner(banner *adw.Banner, groups ...*adw.PreferencesGroup) *gtk.Widget {
+	box := gtk.NewBox(gtk.OrientationVerticalValue, 24)
+	box.SetMarginTop(24)
+	box.SetMarginBottom(24)
+	box.SetMarginStart(12)
+	box.SetMarginEnd(12)
+
+	for _, group := range groups {
+		box.Append(&group.Widget)
+	}
+
+	clamp := a.clamped(&box.Widget)
+
+	content := gtk.NewBox(gtk.OrientationVerticalValue, 0)
+	content.Append(&banner.Widget)
+	content.Append(&clamp.Widget)
+
+	scrolled := a.scrolled(&content.Widget)
+
+	return &scrolled.Widget
+}
+
 func (a *App) scrolled(child *gtk.Widget) *gtk.ScrolledWindow {
 	scrolled := gtk.NewScrolledWindow()
 	scrolled.SetHexpand(true)
