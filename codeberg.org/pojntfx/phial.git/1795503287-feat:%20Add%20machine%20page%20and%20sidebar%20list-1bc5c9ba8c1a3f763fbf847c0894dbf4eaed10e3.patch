+          icon-name: "view-more-symbolic";
+          tooltip-text: _("Machine Menu");
+          menu-model: machine_menu;
+          styles [
+            "flat",
+          ]
+
+          accessibility {
+            label: _("Machine Menu");
+          }
+        }
+      }
+    }
+
