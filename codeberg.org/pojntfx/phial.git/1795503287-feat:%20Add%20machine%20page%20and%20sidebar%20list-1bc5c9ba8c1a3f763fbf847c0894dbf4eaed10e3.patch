+        condition ("max-width: 500sp")
+
+        setters {
+          machine_edit_button.visible: false;
+          machine_menu_button.visible: false;
+        }
+      }
+
+      Adw.HeaderBar {
+        title-widget: Adw.WindowTitle machine_title {};
+
