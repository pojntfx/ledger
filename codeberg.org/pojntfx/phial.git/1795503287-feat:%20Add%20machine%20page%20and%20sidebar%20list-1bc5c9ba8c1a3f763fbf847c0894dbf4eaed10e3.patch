+              ]
+            }
+
+            Adw.ActionRow {
+              title: _("No Live Usage");
+              subtitle: _("Start the machine to see live usage");
+              sensitive: false;
+            }
+          }
+
+          Adw.PreferencesGroup {
+            title: _("Access");
+
+            Adw.ActionRow {
+              title: _("Guest Applications");
+              sensitive: false;
+
+              [suffix]
+              Image {
+                icon-name: "go-next-symbolic";
+              }
+            }
+
+            Adw.ActionRow {
+              title: _("Remote Desktop");
+              sensitive: false;
+
+              [suffix]
+              Image {
+                icon-name: "go-next-symbolic";
+              }
+            }
+
+            Adw.ActionRow {
+              title: _("Serial Console");
+              sensitive: false;
+
+              [suffix]
+              Image {
+                icon-name: "go-next-symbolic";
+              }
+            }
+
+            Adw.ActionRow {
+              title: _("SSH");
+              sensitive: false;
+
+              [suffix]
+              Image {
+                icon-name: "go-next-symbolic";
+              }
+            }
+          }
+
+          Adw.PreferencesGroup {
+            title: _("Shared Folders");
+
+            Adw.ActionRow {
+              title: _("No Shared Folders");
+              sensitive: false;
+            }
+
+            Adw.ButtonRow {
+              title: _("_Share a Folder...");
+              use-underline: true;
+              start-icon-name: "folder-new-symbolic";
+              sensitive: false;
+            }
+          }
+
+          Adw.PreferencesGroup {
+            title: _("USB Devices");
+
+            Adw.ActionRow {
+              title: _("No USB Devices");
+              sensitive: false;
+            }
+
+            Adw.ButtonRow {
+              title: _("_Add USB Device...");
+              use-underline: true;
+              start-icon-name: "list-add-symbolic";
+              sensitive: false;
+            }
+          }
+
+          Adw.PreferencesGroup {
+            title: _("USB Hubs");
+
+            Adw.ActionRow {
+              title: _("No USB Hubs");
+              sensitive: false;
+            }
+
+            Adw.ButtonRow {
+              title: _("_Add USB Hub...");
+              use-underline: true;
+              start-icon-name: "list-add-symbolic";
+              sensitive: false;
+            }
+          }
+
+          Adw.PreferencesGroup {
+            title: _("Storage");
+
+            Adw.ActionRow storage_disk_row {
+              title: _("Disk Image");
+              subtitle-selectable: true;
