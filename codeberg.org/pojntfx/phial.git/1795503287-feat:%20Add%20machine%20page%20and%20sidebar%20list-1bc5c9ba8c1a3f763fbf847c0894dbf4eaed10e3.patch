+          orientation: vertical;
+          spacing: 18;
+          margin-top: 24;
+          margin-bottom: 24;
+          margin-start: 12;
+          margin-end: 12;
+
+          Adw.PreferencesGroup {
+            title: _("Overview");
+
+            Adw.ActionRow overview_state_row {
+              title: _("State");
+              subtitle-selectable: true;
+              styles [
