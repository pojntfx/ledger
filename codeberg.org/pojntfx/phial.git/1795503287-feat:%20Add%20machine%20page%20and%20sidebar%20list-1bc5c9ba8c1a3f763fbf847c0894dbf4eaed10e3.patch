diff --git a/internal/components/machine_page.go b/internal/components/machine_page.go
new file mode 100644
index 0000000000000000000000000000000000000000..8997383c69b358c03354faa46169f887022b4a19
--- /dev/null
+++ b/internal/components/machine_page.go
@@ -0,0 +1,163 @@
+package components
+
+import (
+	"log/slog"
+	"os"
+	"path/filepath"
+	"runtime"
+	"unsafe"
+
+	"codeberg.org/pojntfx/phial/assets/resources"
+	"codeberg.org/pojntfx/phial/pkg/state"
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gio"
+	"codeberg.org/puregotk/puregotk/v4/glib"
+	"codeberg.org/puregotk/puregotk/v4/gobject"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	. "github.com/pojntfx/go-gettext/pkg/i18n"
+)
+
+var (
+	gTypeMachinePage gobject.Type
+)
+
+type MachinePage struct {
+	adw.NavigationPage
+
+	window *gtk.Window
+	log    *slog.Logger
+
+	machinesFolder string
+
+	machineTitle      *adw.WindowTitle
+	overviewStateRow  *adw.ActionRow
+	storageDiskRow    *adw.ActionRow
+	storageOpenButton *gtk.Button
+
+	callbacks []interface{}
+}
+
+func NewMachinePage(info state.MachineInfo, machinesFolder string, window *gtk.Window, log *slog.Logger) MachinePage {
+	obj := gobject.NewObject(gTypeMachinePage, "css-name")
+
+	var v MachinePage
+	obj.Cast(&v)
+
+	page := (*MachinePage)(unsafe.Pointer(obj.GetData(dataKeyGoInstance)))
+	page.window = window
+	page.log = log
+	page.machinesFolder = machinesFolder
+
+	onOpenFolder := func(gtk.Button) {
+		folder := filepath.Dir(page.storageDiskRow.GetSubtitle())
+		if _, err := os.Stat(folder); err != nil {
+			folder = page.machinesFolder
+		}
+
+		gtk.ShowUri(page.window, gio.FileNewForPath(folder).GetUri(), 0)
+	}
+	page.callbacks = append(page.callbacks, &onOpenFolder)
+	page.storageOpenButton.ConnectClicked(&onOpenFolder)
+
+	page.Refresh(info)
+
+	v.NavigationPage.SetTitle(info.Name)
+	v.NavigationPage.SetTag(machinePageTag(info.Name))
+
+	return v
+}
+
+func (p *MachinePage) Refresh(info state.MachineInfo) {
+	p.machineTitle.SetTitle(info.Name)
+	p.machineTitle.SetSubtitle(L("Not installed"))
+
+	p.overviewStateRow.SetSubtitle(L("Not installed"))
+	p.storageDiskRow.SetSubtitle(filepath.Join(p.machinesFolder, info.Name, "disk.qcow2"))
+}
+
+func init() {
+	var classInit gobject.ClassInitFunc = func(tc *gobject.TypeClass, u uintptr) {
+		typeClass := (*gtk.WidgetClass)(unsafe.Pointer(tc))
+		typeClass.SetTemplateFromResource(resources.ResourceMachinePageUIPath)
+		typeClass.BindTemplateChildFull("machine_title", false, 0)
+		typeClass.BindTemplateChildFull("overview_state_row", false, 0)
+		typeClass.BindTemplateChildFull("storage_disk_row", false, 0)
+		typeClass.BindTemplateChildFull("storage_open_button", false, 0)
+
+		objClass := (*gobject.ObjectClass)(unsafe.Pointer(tc))
+
+		objClass.OverrideConstructed(func(o *gobject.Object) {
+			parentObjClass := (*gobject.ObjectClass)(unsafe.Pointer(tc.PeekParent()))
+			parentObjClass.GetConstructed()(o)
+
+			var parent adw.NavigationPage
+			o.Cast(&parent)
+
+			parent.InitTemplate()
+
+			var (
+				machineTitle      adw.WindowTitle
+				overviewStateRow  adw.ActionRow
+				storageDiskRow    adw.ActionRow
+				storageOpenButton gtk.Button
+			)
+
+			parent.Widget.GetTemplateChild(
+				gTypeMachinePage,
+				"machine_title",
+			).Cast(&machineTitle)
+			parent.Widget.GetTemplateChild(
+				gTypeMachinePage,
+				"overview_state_row",
+			).Cast(&overviewStateRow)
+			parent.Widget.GetTemplateChild(
+				gTypeMachinePage,
+				"storage_disk_row",
+			).Cast(&storageDiskRow)
+			parent.Widget.GetTemplateChild(
+				gTypeMachinePage,
+				"storage_open_button",
+			).Cast(&storageOpenButton)
+
+			p := &MachinePage{
+				NavigationPage: parent,
+
+				machineTitle:      &machineTitle,
+				overviewStateRow:  &overviewStateRow,
+				storageDiskRow:    &storageDiskRow,
+				storageOpenButton: &storageOpenButton,
+
+				callbacks: []interface{}{},
+			}
+
+			var pinner runtime.Pinner
+			pinner.Pin(p)
+
+			var cleanupCallback glib.DestroyNotify = func(data uintptr) {
+				for _, callback := range p.callbacks {
+					if err := glib.UnrefCallback(callback); err != nil {
+						p.log.Error("Could not unref callback", "err", err)
+					}
+				}
+
+				pinner.Unpin()
+			}
+			o.SetDataFull(dataKeyGoInstance, uintptr(unsafe.Pointer(p)), &cleanupCallback)
+		})
+	}
+
+	var instanceInit gobject.InstanceInitFunc = func(ti *gobject.TypeInstance, tc *gobject.TypeClass) {}
+
+	var parentQuery gobject.TypeQuery
+	gobject.NewTypeQuery(adw.NavigationPageGLibType(), &parentQuery)
+
+	gTypeMachinePage = gobject.TypeRegisterStaticSimple(
+		parentQuery.Type,
+		"PhialMachinePage",
+		parentQuery.ClassSize,
+		&classInit,
+		parentQuery.InstanceSize,
+		&instanceInit,
+		0,
+	)
+}
