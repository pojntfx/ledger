+    item {
+      label: _("_Logs");
+      action: "win.machineLogs";
+    }
+
+    item {
+      label: _("_Reprovision Guest Agent");
+      action: "win.reprovisionMachine";
+    }
+
+    item {
+      label: _("_Restart");
+      action: "win.restartMachine";
+    }
+
+    item {
+      label: _("_Delete Machine...");
+      action: "win.deleteMachine";
+    }
+  }
+}
