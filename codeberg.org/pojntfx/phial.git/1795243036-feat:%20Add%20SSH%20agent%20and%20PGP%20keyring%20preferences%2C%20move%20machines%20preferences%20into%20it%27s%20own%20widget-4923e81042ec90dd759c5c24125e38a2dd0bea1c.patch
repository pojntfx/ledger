new file mode 100644
index 0000000000000000000000000000000000000000..97ea820dd28895440a144c26fd8d216bcf8940f7
--- /dev/null
+++ b/internal/components/machines_preferences.go
@@ -0,0 +1,140 @@
+package components
+
+import (
+	"log/slog"
+	"os"
+	"path/filepath"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gio"
+	"codeberg.org/puregotk/puregotk/v4/glib"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	. "github.com/pojntfx/go-gettext/pkg/i18n"
+)
+
+type MachinesPreferences struct {
+	parent *gtk.Widget
+	log    *slog.Logger
+
+	machinesFolder  string
+	suggestedFolder string
+
+	onChanged func(path string)
+
+	group  *adw.PreferencesGroup
+	row    *adw.ActionRow
+	button *gtk.Button
+
+	callbacks []interface{}
+}
+
+func NewMachinesPreferences(parent *gtk.Widget, log *slog.Logger, machinesFolder string, suggestedFolder string, onChanged func(path string)) *MachinesPreferences {
+	m := &MachinesPreferences{
+		parent:          parent,
+		log:             log,
+		machinesFolder:  machinesFolder,
+		suggestedFolder: suggestedFolder,
+		onChanged:       onChanged,
+
+		callbacks: []interface{}{},
+	}
+
+	m.group = adw.NewPreferencesGroup()
+	m.group.SetDescription(L("Phial keeps its machines and their configurations in this folder"))
+
+	m.row = adw.NewActionRow()
+	m.row.SetTitle(L("Machines Folder"))
+
+	machinesFolderIcon := gtk.NewImageFromIconName("folder-symbolic")
+	machinesFolderIcon.SetValign(gtk.AlignCenterValue)
+	m.row.AddPrefix(&machinesFolderIcon.Widget)
+
+	m.button = gtk.NewButtonWithLabel(L("_Choose..."))
+	m.button.SetUseUnderline(true)
+	m.button.SetValign(gtk.AlignCenterValue)
+	m.row.AddSuffix(&m.button.Widget)
+
+	onChooseFolder := func(gtk.Button) {
+		m.chooseFolder()
+	}
+	m.callbacks = append(m.callbacks, &onChooseFolder)
+	m.button.ConnectClicked(&onChooseFolder)
+
+	m.group.Add(&m.row.Widget)
+
+	m.SetMachinesFolder(machinesFolder)
+
+	return m
+}
+
+func (m *MachinesPreferences) AddTo(page *adw.PreferencesPage) {
+	page.Add(m.group)
+}
+
+func (m *MachinesPreferences) SetMachinesFolder(path string) {
+	m.machinesFolder = path
+
+	if path == "" {
+		m.row.SetSubtitle(L("Not selected"))
+
+		return
+	}
+
+	m.row.SetSubtitle(path)
+}
+
+func (m *MachinesPreferences) Close() {
+	for _, callback := range m.callbacks {
+		if err := glib.UnrefCallback(callback); err != nil {
+			m.log.Error("Could not unref callback", "err", err)
+		}
+	}
+	m.callbacks = nil
+}
+
+func (m *MachinesPreferences) chooseFolder() {
+	fileDialog := gtk.NewFileDialog()
+	fileDialog.SetTitle(L("Choose the Machines Folder"))
+
+	initial := m.machinesFolder
+	if initial == "" {
+		initial = m.suggestedFolder
+	}
+
+	if _, err := os.Stat(initial); err != nil {
+		initial = filepath.Dir(initial)
+	}
+
+	if _, err := os.Stat(initial); err == nil {
+		fileDialog.SetInitialFolder(gio.FileNewForPath(initial))
+	}
+
+	var onFolderChosen gio.AsyncReadyCallback
+	onFolderChosen = gio.AsyncReadyCallback(func(_ uintptr, resultPtr uintptr, _ uintptr) {
+		result := gio.AsyncResultBase{Ptr: resultPtr}
+
+		file, err := fileDialog.SelectFolderFinish(&result)
+		if err != nil {
+			m.log.Error("Could not choose machines folder", "err", err)
+
+			return
+		}
+
+		if file == nil {
+			return
+		}
+
+		m.SetMachinesFolder(file.GetPath())
+		m.notifyChanged()
+	})
+	m.callbacks = append(m.callbacks, &onFolderChosen)
+
+	var parentWindow gtk.Window
+	m.parent.Cast(&parentWindow)
+
+	fileDialog.SelectFolder(&parentWindow, nil, &onFolderChosen, 0)
+}
+
+func (m *MachinesPreferences) notifyChanged() {
+	m.onChanged(m.machinesFolder)
+}
