diff --git a/internal/components/secrets_preferences.go b/internal/components/secrets_preferences.go
new file mode 100644
index 0000000000000000000000000000000000000000..198dbeed72dc6d4eebb214dfd89787110b33b2c2
--- /dev/null
+++ b/internal/components/secrets_preferences.go
@@ -0,0 +1,398 @@
+package components
+
+import (
+	"log/slog"
+	"os"
+	"path/filepath"
+	"runtime"
+	"slices"
+	"strings"
+	"unsafe"
+
+	"codeberg.org/pojntfx/phial/pkg/state"
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gio"
+	"codeberg.org/puregotk/puregotk/v4/glib"
+	"codeberg.org/puregotk/puregotk/v4/gobject"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	. "github.com/pojntfx/go-gettext/pkg/i18n"
+)
+
+type agentSocketRowKind uint8
+
+const (
+	agentSocketRowSocket agentSocketRowKind = iota
+	agentSocketRowAction
+	agentSocketRowEmpty
+)
+
+type agentSocketRowItem struct {
+	gobject.Object
+
+	kind     agentSocketRowKind
+	title    string
+	subtitle string
+	path     string
+}
+
+var (
+	gTypeAgentSocketRowItem gobject.Type
+
+	destroyAgentSocketModel glib.DestroyNotify = func(uintptr) {}
+)
+
+type SecretsPreferences struct {
+	parent *gtk.Widget
+	log    *slog.Logger
+
+	sshAgentSockets []string
+	gpgHome         string
+
+	onChanged func(sockets []string, gpgHome string)
+
+	sshAgentGroup *adw.PreferencesGroup
+	gpgGroup      *adw.PreferencesGroup
+	gpgHomeRow    *adw.ActionRow
+
+	callbacks       []interface{}
+	socketCallbacks []interface{}
+
+	createAgentSocketRow gtk.ListBoxCreateWidgetFunc
+
+	closed bool
+}
+
+func NewSecretsPreferences(parent *gtk.Widget, log *slog.Logger, sshAgentSockets []string, gpgHome string, onChanged func(sockets []string, gpgHome string)) *SecretsPreferences {
+	a := &SecretsPreferences{
+		parent:    parent,
+		log:       log,
+		onChanged: onChanged,
+
+		callbacks:       []interface{}{},
+		socketCallbacks: []interface{}{},
+	}
+
+	a.sshAgentGroup = adw.NewPreferencesGroup()
+	a.sshAgentGroup.SetTitle(L("SSH Agents"))
+	a.sshAgentGroup.SetDescription(L("Sockets of the SSH agents that machines can use"))
+
+	a.gpgGroup = adw.NewPreferencesGroup()
+	a.gpgGroup.SetTitle(L("PGP Keyring"))
+	a.gpgGroup.SetDescription(L("Home folder of the PGP keyring"))
+
+	a.gpgHomeRow = adw.NewActionRow()
+	a.gpgHomeRow.SetTitle(L("Keyring Folder"))
+	a.gpgHomeRow.SetSubtitle(L("Not selected"))
+
+	gpgHomeIcon := gtk.NewImageFromIconName("folder-symbolic")
+	gpgHomeIcon.SetValign(gtk.AlignCenterValue)
+	a.gpgHomeRow.AddPrefix(&gpgHomeIcon.Widget)
+
+	gpgHomeButton := gtk.NewButtonWithLabel(L("_Choose..."))
+	gpgHomeButton.SetUseUnderline(true)
+	gpgHomeButton.SetValign(gtk.AlignCenterValue)
+	a.gpgHomeRow.AddSuffix(&gpgHomeButton.Widget)
+
+	onChooseGPGHome := func(gtk.Button) {
+		a.chooseGPGHome()
+	}
+	a.callbacks = append(a.callbacks, &onChooseGPGHome)
+	gpgHomeButton.ConnectClicked(&onChooseGPGHome)
+
+	a.gpgGroup.Add(&a.gpgHomeRow.Widget)
+
+	a.sshAgentSockets = append([]string(nil), sshAgentSockets...)
+	a.rebuildSSHAgentSockets()
+	a.SetGPGHome(gpgHome)
+
+	return a
+}
+
+func (a *SecretsPreferences) AddTo(page *adw.PreferencesPage) {
+	page.Add(a.sshAgentGroup)
+	page.Add(a.gpgGroup)
+}
+
+func (a *SecretsPreferences) SetSSHAgentSockets(sockets []string) {
+	if slices.Equal(a.sshAgentSockets, sockets) {
+		return
+	}
+
+	a.sshAgentSockets = append([]string(nil), sockets...)
+
+	a.rebuildSSHAgentSockets()
+}
+
+func (a *SecretsPreferences) SetGPGHome(home string) {
+	a.gpgHome = home
+
+	if home == "" {
+		a.gpgHomeRow.SetSubtitle(L("Not selected"))
+
+		return
+	}
+
+	a.gpgHomeRow.SetSubtitle(home)
+}
+
+func (a *SecretsPreferences) Close() {
+	if a.closed {
+		return
+	}
+	a.closed = true
+
+	for _, callback := range a.callbacks {
+		if err := glib.UnrefCallback(callback); err != nil {
+			a.log.Error("Could not unref callback", "err", err)
+		}
+	}
+	a.callbacks = nil
+
+	for _, callback := range a.socketCallbacks {
+		if err := glib.UnrefCallback(callback); err != nil {
+			a.log.Error("Could not unref callback", "err", err)
+		}
+	}
+	a.socketCallbacks = nil
+}
+
+func (a *SecretsPreferences) rebuildSSHAgentSockets() {
+	for _, callback := range a.socketCallbacks {
+		if err := glib.UnrefCallback(callback); err != nil {
+			a.log.Error("Could not unref callback", "err", err)
+		}
+	}
+	a.socketCallbacks = nil
+
+	model := gio.NewListStore(gTypeAgentSocketRowItem)
+
+	for _, socket := range a.sshAgentSockets {
+		appendAgentSocketRow(model, newAgentSocketRowItem(agentSocketRowSocket, filepath.Base(socket), socket, socket))
+	}
+	if len(a.sshAgentSockets) == 0 {
+		appendAgentSocketRow(model, newAgentSocketRowItem(agentSocketRowEmpty, L("No SSH Agent Sockets"), "", ""))
+	}
+	appendAgentSocketRow(model, newAgentSocketRowItem(agentSocketRowAction, L("_Add Socket..."), "", ""))
+
+	a.createAgentSocketRow = func(itemPtr uintptr, _ uintptr) uintptr {
+		return a.createAgentSocketRowWidget(itemPtr)
+	}
+	a.sshAgentGroup.BindModel(model, &a.createAgentSocketRow, 0, &destroyAgentSocketModel)
+	model.Unref()
+}
+
+func newAgentSocketRowItem(kind agentSocketRowKind, title string, subtitle string, path string) agentSocketRowItem {
+	obj := gobject.NewObjectWithProperties(gTypeAgentSocketRowItem, 0, nil, nil)
+
+	var v agentSocketRowItem
+	obj.Cast(&v)
+
+	item := (*agentSocketRowItem)(unsafe.Pointer(obj.GetData(dataKeyGoInstance)))
+	item.kind = kind
+	item.title = title
+	item.subtitle = subtitle
+	item.path = path
+
+	return v
+}
+
+func appendAgentSocketRow(model *gio.ListStore, item agentSocketRowItem) {
+	model.Append(&item.Object)
+	item.Unref()
+}
+
+func (a *SecretsPreferences) createAgentSocketRowWidget(itemPtr uintptr) uintptr {
+	obj := gobject.ObjectNewFromInternalPtr(itemPtr)
+	item := (*agentSocketRowItem)(unsafe.Pointer(obj.GetData(dataKeyGoInstance)))
+
+	switch item.kind {
+	case agentSocketRowAction:
+		row := adw.NewButtonRow()
+		row.SetTitle(item.title)
+		row.SetUseUnderline(true)
+		row.SetStartIconName("list-add-symbolic")
+
+		onAddSocket := func(adw.ButtonRow) {
+			a.chooseSSHAgentSocket()
+		}
+		a.socketCallbacks = append(a.socketCallbacks, &onAddSocket)
+		row.ConnectActivated(&onAddSocket)
+
+		return row.GoPointer()
+
+	case agentSocketRowEmpty:
+		label := gtk.NewLabel(item.title)
+		label.AddCssClass("dim-label")
+		label.SetHalign(gtk.AlignCenterValue)
+		label.SetMarginTop(12)
+		label.SetMarginBottom(12)
+		label.SetMarginStart(12)
+		label.SetMarginEnd(12)
+
+		return label.GoPointer()
+	}
+
+	row := adw.NewActionRow()
+	row.SetIconName("channel-secure-symbolic")
+	row.SetUseMarkup(false)
+	row.SetTitle(item.title)
+	row.SetSubtitle(item.subtitle)
+
+	remove := gtk.NewButton()
+	remove.SetIconName("user-trash-symbolic")
+	remove.SetTooltipText(L("Remove Socket"))
+	remove.SetValign(gtk.AlignCenterValue)
+	remove.SetHasFrame(false)
+
+	onRemove := func(gtk.Button) {
+		a.removeSSHAgentSocket(item.path)
+	}
+	a.socketCallbacks = append(a.socketCallbacks, &onRemove)
+	remove.ConnectClicked(&onRemove)
+
+	row.AddSuffix(&remove.Widget)
+
+	return row.GoPointer()
+}
+
+func (a *SecretsPreferences) addSSHAgentSocket(socket string) {
+	socket = strings.TrimSpace(socket)
+	if socket == "" || slices.Contains(a.sshAgentSockets, socket) {
+		return
+	}
+
+	a.sshAgentSockets = append(a.sshAgentSockets, socket)
+	a.rebuildSSHAgentSockets()
+	a.notifyChanged()
+}
+
+func (a *SecretsPreferences) removeSSHAgentSocket(socket string) {
+	a.sshAgentSockets = slices.DeleteFunc(a.sshAgentSockets, func(current string) bool {
+		return current == socket
+	})
+	a.rebuildSSHAgentSockets()
+	a.notifyChanged()
+}
+
+func (a *SecretsPreferences) setGPGHome(home string) {
+	a.SetGPGHome(home)
+	a.notifyChanged()
+}
+
+func (a *SecretsPreferences) notifyChanged() {
+	a.onChanged(append([]string(nil), a.sshAgentSockets...), a.gpgHome)
+}
+
+func (a *SecretsPreferences) chooseSSHAgentSocket() {
+	fileDialog := gtk.NewFileDialog()
+	fileDialog.SetTitle(L("Choose an SSH Agent Socket"))
+
+	if folder := state.MockSSHAgentSocketFolder(); folder != "" {
+		if _, err := os.Stat(folder); err == nil {
+			fileDialog.SetInitialFolder(gio.FileNewForPath(folder))
+		}
+	}
+
+	var onSocketChosen gio.AsyncReadyCallback
+	onSocketChosen = gio.AsyncReadyCallback(func(_ uintptr, resultPtr uintptr, _ uintptr) {
+		result := gio.AsyncResultBase{Ptr: resultPtr}
+
+		file, err := fileDialog.OpenFinish(&result)
+		if err != nil {
+			a.log.Error("Could not choose SSH agent socket", "err", err)
+
+			return
+		}
+
+		if file == nil {
+			return
+		}
+
+		a.addSSHAgentSocket(file.GetPath())
+	})
+	a.callbacks = append(a.callbacks, &onSocketChosen)
+
+	var parentWindow gtk.Window
+	a.parent.Cast(&parentWindow)
+
+	fileDialog.Open(&parentWindow, nil, &onSocketChosen, 0)
+}
+
+func (a *SecretsPreferences) chooseGPGHome() {
+	fileDialog := gtk.NewFileDialog()
+	fileDialog.SetTitle(L("Choose the PGP Keyring Folder"))
+
+	initial := state.MockGPGHome()
+	if _, err := os.Stat(initial); err != nil {
+		initial = filepath.Dir(initial)
+	}
+
+	if _, err := os.Stat(initial); err == nil {
+		fileDialog.SetInitialFolder(gio.FileNewForPath(initial))
+	}
+
+	var onGPGHomeChosen gio.AsyncReadyCallback
+	onGPGHomeChosen = gio.AsyncReadyCallback(func(_ uintptr, resultPtr uintptr, _ uintptr) {
+		result := gio.AsyncResultBase{Ptr: resultPtr}
+
+		file, err := fileDialog.SelectFolderFinish(&result)
+		if err != nil {
+			a.log.Error("Could not choose PGP keyring folder", "err", err)
+
+			return
+		}
+
+		if file == nil {
+			return
+		}
+
+		a.setGPGHome(file.GetPath())
+	})
+	a.callbacks = append(a.callbacks, &onGPGHomeChosen)
+
+	var parentWindow gtk.Window
+	a.parent.Cast(&parentWindow)
+
+	fileDialog.SelectFolder(&parentWindow, nil, &onGPGHomeChosen, 0)
+}
+
+func init() {
+	var classInit gobject.ClassInitFunc = func(tc *gobject.TypeClass, u uintptr) {
+		objClass := (*gobject.ObjectClass)(unsafe.Pointer(tc))
+
+		objClass.OverrideConstructed(func(o *gobject.Object) {
+			parentObjClass := (*gobject.ObjectClass)(unsafe.Pointer(tc.PeekParent()))
+			parentObjClass.GetConstructed()(o)
+
+			var parent gobject.Object
+			o.Cast(&parent)
+
+			item := &agentSocketRowItem{
+				Object: parent,
+			}
+
+			var pinner runtime.Pinner
+			pinner.Pin(item)
+
+			var cleanupCallback glib.DestroyNotify = func(data uintptr) {
+				pinner.Unpin()
+			}
+			o.SetDataFull(dataKeyGoInstance, uintptr(unsafe.Pointer(item)), &cleanupCallback)
+		})
+	}
+
+	var instanceInit gobject.InstanceInitFunc = func(ti *gobject.TypeInstance, tc *gobject.TypeClass) {}
+
+	var parentQuery gobject.TypeQuery
+	gobject.NewTypeQuery(gobject.TypeObjectVal, &parentQuery)
+
+	gTypeAgentSocketRowItem = gobject.TypeRegisterStaticSimple(
+		parentQuery.Type,
+		"PhialAgentSocketRowItem",
+		parentQuery.ClassSize,
+		&classInit,
+		parentQuery.InstanceSize,
+		&instanceInit,
+		0,
+	)
+}
