index 0000000000000000000000000000000000000000..e6b661267f117c745e6534f1824fff626c82a274
--- /dev/null
+++ b/assets/resources/preferences-dialog.blp
@@ -0,0 +1,75 @@
+using Gtk 4.0;
+using Adw 1;
+
+template $PhialPreferencesDialog: Adw.PreferencesDialog {
+  title: _("Preferences");
+  search-enabled: true;
+
+  Adw.PreferencesPage {
+    title: _("General");
+
+    banner: Adw.Banner host_service_banner {
+      title: _("Host service needs reconfiguration");
+      revealed: false;
+    };
+
+    Adw.PreferencesGroup {
+      description: _("Phial keeps its machines and their configurations in this folder");
+
+      Adw.ActionRow machines_folder_row {
+        title: _("Machines Folder");
+        subtitle: _("Not selected");
+
+        [prefix]
+        Image {
+          icon-name: "folder-symbolic";
+        }
+
+        [suffix]
+        Button machines_folder_button {
+          label: _("_Choose...");
+          use-underline: true;
+          valign: center;
+        }
+      }
+    }
+
+    Adw.PreferencesGroup host_service_group {
+      title: _("Host Service");
+      description: _("Run this command in a terminal to reconfigure the host service for the new machines folder");
+
+      Gtk.ListBoxRow host_command_row {
+        activatable: false;
+        selectable: false;
+
+        Box {
+          margin-top: 12;
+          margin-bottom: 12;
+          margin-start: 12;
+          margin-end: 12;
+
+          Label host_command_label {
+            selectable: true;
+            wrap: true;
+            xalign: 0;
+            styles [
+              "monospace",
+            ]
+          }
+        }
+      }
+
+      Adw.ButtonRow host_copy_row {
+        title: _("_Copy Command");
+        use-underline: true;
+        start-icon-name: "edit-copy-symbolic";
+      }
+
+      Adw.ButtonRow host_verify_row {
+        title: _("_Verify Connection");
+        use-underline: true;
+        start-icon-name: "view-refresh-symbolic";
+      }
+    }
+  }
+}
