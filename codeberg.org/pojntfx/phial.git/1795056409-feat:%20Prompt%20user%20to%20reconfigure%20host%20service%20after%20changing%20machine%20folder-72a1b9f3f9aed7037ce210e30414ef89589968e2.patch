diff --git a/internal/components/preferences_dialog.go b/internal/components/preferences_dialog.go
new file mode 100644
index 0000000000000000000000000000000000000000..55d266211c25fdd838bdbf5acd64c41d1a7360be
--- /dev/null
+++ b/internal/components/preferences_dialog.go
@@ -0,0 +1,346 @@
+package components
+
+import (
+	"context"
+	"log/slog"
+	"os"
+	"path/filepath"
+	"runtime"
+	"unsafe"
+
+	"codeberg.org/pojntfx/phial/assets/resources"
+	"codeberg.org/pojntfx/phial/pkg/state"
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gio"
+	"codeberg.org/puregotk/puregotk/v4/glib"
+	"codeberg.org/puregotk/puregotk/v4/gobject"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	. "github.com/pojntfx/go-gettext/pkg/i18n"
+)
+
+var (
+	gTypePreferencesDialog gobject.Type
+)
+
+type PreferencesDialog struct {
+	adw.PreferencesDialog
+
+	ctx      context.Context
+	settings *gio.Settings
+	log      *slog.Logger
+
+	store *state.Store
+
+	parent   *gtk.Widget
+	onChange func()
+
+	machinesFolderRow    adw.ActionRow
+	machinesFolderButton gtk.Button
+	hostServiceBanner    adw.Banner
+	hostServiceGroup     adw.PreferencesGroup
+	hostCommandLabel     gtk.Label
+	hostCopyRow          adw.ButtonRow
+	hostVerifyRow        adw.ButtonRow
+
+	open bool
+
+	copied    bool
+	verifying bool
+
+	callbacks []interface{}
+}
+
+func NewPreferencesDialog(ctx context.Context, store *state.Store, settings *gio.Settings, log *slog.Logger, parent *gtk.Widget, onChange func()) PreferencesDialog {
+	obj := gobject.NewObject(gTypePreferencesDialog, "css-name")
+	gobject.IncreaseRef(obj.GoPointer())
+
+	var v PreferencesDialog
+	obj.Cast(&v)
+
+	dialog := (*PreferencesDialog)(unsafe.Pointer(obj.GetData(dataKeyGoInstance)))
+	dialog.ctx = ctx
+	dialog.settings = settings
+	dialog.log = log
+	dialog.store = store
+	dialog.parent = parent
+	dialog.onChange = onChange
+
+	onChooseFolder := func(gtk.Button) {
+		fileDialog := gtk.NewFileDialog()
+		fileDialog.SetTitle(L("Choose the Machines Folder"))
+
+		initial := dialog.store.MachinesFolder()
+		if initial == "" {
+			initial = dialog.store.SuggestedMachinesFolder()
+		}
+
+		if _, err := os.Stat(initial); err != nil {
+			initial = filepath.Dir(initial)
+		}
+
+		if _, err := os.Stat(initial); err == nil {
+			fileDialog.SetInitialFolder(gio.FileNewForPath(initial))
+		}
+
+		var onFolderChosen gio.AsyncReadyCallback
+		onFolderChosen = gio.AsyncReadyCallback(func(_ uintptr, resultPtr uintptr, _ uintptr) {
+			result := gio.AsyncResultBase{Ptr: resultPtr}
+
+			file, err := fileDialog.SelectFolderFinish(&result)
+			if err != nil {
+				dialog.log.Error("Could not choose folder", "err", err)
+
+				return
+			}
+
+			if file == nil {
+				return
+			}
+
+			dialog.setMachinesFolder(file.GetPath())
+		})
+		dialog.callbacks = append(dialog.callbacks, &onFolderChosen)
+
+		var parentWindow gtk.Window
+		dialog.parent.Cast(&parentWindow)
+
+		fileDialog.SelectFolder(&parentWindow, nil, &onFolderChosen, 0)
+	}
+	dialog.callbacks = append(dialog.callbacks, &onChooseFolder)
+	dialog.machinesFolderButton.ConnectClicked(&onChooseFolder)
+
+	onCopy := func(adw.ButtonRow) {
+		dialog.parent.GetClipboard().SetText(dialog.store.HostCommand())
+
+		dialog.copied = true
+
+		dialog.Refresh()
+	}
+	dialog.callbacks = append(dialog.callbacks, &onCopy)
+	dialog.hostCopyRow.ConnectActivated(&onCopy)
+
+	onVerifyConnection := func(adw.ButtonRow) {
+		if !dialog.copied || dialog.verifying {
+			return
+		}
+
+		dialog.verifying = true
+
+		dialog.Refresh()
+
+		go func() {
+			verifyErr := dialog.store.RetryHost(dialog.ctx)
+			if verifyErr != nil {
+				dialog.log.Error("Could not verify host connection", "err", verifyErr)
+			}
+
+			var fn glib.SourceFunc
+			fn = glib.SourceFunc(func(uintptr) bool {
+				defer glib.UnrefCallback(&fn)
+
+				if verifyErr == nil && dialog.store.HostStatus() == state.HostStatusOnline {
+					if !dialog.settings.SetString(resources.SchemaHostMachinesFolderKey, dialog.store.MachinesFolder()) {
+						dialog.log.Error("Could not write host machines folder setting")
+					}
+				}
+
+				dialog.verifying = false
+				dialog.copied = false
+
+				dialog.Refresh()
+
+				if dialog.onChange != nil {
+					dialog.onChange()
+				}
+
+				return false
+			})
+			glib.IdleAdd(&fn, 0)
+		}()
+	}
+	dialog.callbacks = append(dialog.callbacks, &onVerifyConnection)
+	dialog.hostVerifyRow.ConnectActivated(&onVerifyConnection)
+
+	onClosed := func(adw.Dialog) {
+		dialog.open = false
+
+		if dialog.onChange != nil {
+			dialog.onChange()
+		}
+	}
+	dialog.callbacks = append(dialog.callbacks, &onClosed)
+	dialog.ConnectClosed(&onClosed)
+
+	dialog.Refresh()
+
+	return v
+}
+
+func (w *PreferencesDialog) Present(parent *gtk.Widget) {
+	w.open = true
+
+	w.PreferencesDialog.Present(parent)
+
+	if w.onChange != nil {
+		w.onChange()
+	}
+}
+
+func (w *PreferencesDialog) Visible() bool {
+	return w.open
+}
+
+func (w *PreferencesDialog) setMachinesFolder(path string) {
+	if err := w.store.SetMachinesFolder(w.ctx, path); err != nil {
+		w.log.Error("Could not set machines folder", "err", err)
+
+		return
+	}
+
+	if !w.settings.SetString(resources.SchemaMachinesFolderKey, path) {
+		w.log.Error("Could not write machines folder setting")
+
+		return
+	}
+
+	w.copied = false
+
+	w.Refresh()
+
+	if w.onChange != nil {
+		w.onChange()
+	}
+}
+
+func (w *PreferencesDialog) Refresh() {
+	if w.store == nil {
+		return
+	}
+
+	if folder := w.store.MachinesFolder(); folder == "" {
+		w.machinesFolderRow.SetSubtitle(L("Not selected"))
+	} else {
+		w.machinesFolderRow.SetSubtitle(folder)
+	}
+
+	w.hostCommandLabel.SetText(w.store.HostCommand())
+
+	w.hostServiceBanner.SetRevealed(hostReconfigurationPending(w.settings))
+	w.hostServiceGroup.SetVisible(hostReconfigurationPending(w.settings))
+
+	w.hostCopyRow.SetSensitive(!w.verifying)
+	w.hostVerifyRow.SetSensitive(w.copied && !w.verifying)
+}
+
+func hostReconfigurationPending(settings *gio.Settings) bool {
+	machinesFolder := settings.GetString(resources.SchemaMachinesFolderKey)
+	hostMachinesFolder := settings.GetString(resources.SchemaHostMachinesFolderKey)
+
+	return machinesFolder != "" && machinesFolder != hostMachinesFolder
+}
+
+func init() {
+	var classInit gobject.ClassInitFunc = func(tc *gobject.TypeClass, u uintptr) {
+		typeClass := (*gtk.WidgetClass)(unsafe.Pointer(tc))
+		typeClass.SetTemplateFromResource(resources.ResourcePreferencesDialogUIPath)
+		typeClass.BindTemplateChildFull("machines_folder_row", false, 0)
+		typeClass.BindTemplateChildFull("machines_folder_button", false, 0)
+		typeClass.BindTemplateChildFull("host_service_banner", false, 0)
+		typeClass.BindTemplateChildFull("host_service_group", false, 0)
+		typeClass.BindTemplateChildFull("host_command_label", false, 0)
+		typeClass.BindTemplateChildFull("host_copy_row", false, 0)
+		typeClass.BindTemplateChildFull("host_verify_row", false, 0)
+
+		objClass := (*gobject.ObjectClass)(unsafe.Pointer(tc))
+
+		objClass.OverrideConstructed(func(o *gobject.Object) {
+			parentObjClass := (*gobject.ObjectClass)(unsafe.Pointer(tc.PeekParent()))
+			parentObjClass.GetConstructed()(o)
+
+			var parent adw.PreferencesDialog
+			o.Cast(&parent)
+
+			parent.InitTemplate()
+
+			var (
+				machinesFolderRow    adw.ActionRow
+				machinesFolderButton gtk.Button
+				hostServiceBanner    adw.Banner
+				hostServiceGroup     adw.PreferencesGroup
+				hostCommandLabel     gtk.Label
+				hostCopyRow          adw.ButtonRow
+				hostVerifyRow        adw.ButtonRow
+			)
+
+			parent.Widget.GetTemplateChild(
+				gTypePreferencesDialog,
+				"machines_folder_row",
+			).Cast(&machinesFolderRow)
+			parent.Widget.GetTemplateChild(
+				gTypePreferencesDialog,
+				"machines_folder_button",
+			).Cast(&machinesFolderButton)
+			parent.Widget.GetTemplateChild(
+				gTypePreferencesDialog,
+				"host_service_banner",
+			).Cast(&hostServiceBanner)
+			parent.Widget.GetTemplateChild(
+				gTypePreferencesDialog,
+				"host_service_group",
+			).Cast(&hostServiceGroup)
+			parent.Widget.GetTemplateChild(
+				gTypePreferencesDialog,
+				"host_command_label",
+			).Cast(&hostCommandLabel)
+			parent.Widget.GetTemplateChild(
+				gTypePreferencesDialog,
+				"host_copy_row",
+			).Cast(&hostCopyRow)
+			parent.Widget.GetTemplateChild(
+				gTypePreferencesDialog,
+				"host_verify_row",
+			).Cast(&hostVerifyRow)
+
+			w := &PreferencesDialog{
+				PreferencesDialog:    parent,
+				machinesFolderRow:    machinesFolderRow,
+				machinesFolderButton: machinesFolderButton,
+				hostServiceBanner:    hostServiceBanner,
+				hostServiceGroup:     hostServiceGroup,
+				hostCommandLabel:     hostCommandLabel,
+				hostCopyRow:          hostCopyRow,
+				hostVerifyRow:        hostVerifyRow,
+				callbacks:            []interface{}{},
+			}
+
+			var pinner runtime.Pinner
+			pinner.Pin(w)
+
+			var cleanupCallback glib.DestroyNotify = func(data uintptr) {
+				for _, callback := range w.callbacks {
+					if err := glib.UnrefCallback(callback); err != nil {
+						w.log.Error("Could not unref callback", "err", err)
+					}
+				}
+
+				pinner.Unpin()
+			}
+			o.SetDataFull(dataKeyGoInstance, uintptr(unsafe.Pointer(w)), &cleanupCallback)
+		})
+	}
+
+	var instanceInit gobject.InstanceInitFunc = func(ti *gobject.TypeInstance, tc *gobject.TypeClass) {}
+
+	var parentQuery gobject.TypeQuery
+	gobject.NewTypeQuery(adw.PreferencesDialogGLibType(), &parentQuery)
+
+	gTypePreferencesDialog = gobject.TypeRegisterStaticSimple(
+		parentQuery.Type,
+		"PhialPreferencesDialog",
+		parentQuery.ClassSize,
+		&classInit,
+		parentQuery.InstanceSize,
+		&instanceInit,
+		0,
+	)
+}
