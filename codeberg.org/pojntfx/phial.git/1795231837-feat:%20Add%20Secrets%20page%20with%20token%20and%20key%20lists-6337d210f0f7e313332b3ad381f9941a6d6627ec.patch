diff --git a/internal/components/secrets.go b/internal/components/secrets.go
new file mode 100644
index 0000000000000000000000000000000000000000..74d53b55f28dc53f66e91360bc5bb3cd97e8c291
--- /dev/null
+++ b/internal/components/secrets.go
@@ -0,0 +1,246 @@
+package components
+
+import (
+	"fmt"
+	"html/template"
+	"runtime"
+	"strings"
+	"unsafe"
+
+	"codeberg.org/pojntfx/phial/pkg/state"
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gio"
+	"codeberg.org/puregotk/puregotk/v4/glib"
+	"codeberg.org/puregotk/puregotk/v4/gobject"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	. "github.com/pojntfx/go-gettext/pkg/i18n"
+)
+
+const seahorseHelp = "https://help.gnome.org/seahorse/"
+
+var seahorseLinkTemplate = template.Must(template.New("seahorse-link").Parse(
+	`<a href="{{.URL}}">{{.Label}}</a>`,
+))
+
+type seahorseLinkData struct {
+	URL   string
+	Label string
+}
+
+type secretsRowKind uint8
+
+const (
+	secretsRowToken secretsRowKind = iota
+	secretsRowSSHKey
+	secretsRowGPGKey
+	secretsRowAction
+	secretsRowEmpty
+)
+
+type secretsRowItem struct {
+	gobject.Object
+
+	kind     secretsRowKind
+	title    string
+	subtitle string
+	icon     string
+}
+
+var (
+	gTypeSecretsRowItem gobject.Type
+
+	createSecretsRow                       = gtk.ListBoxCreateWidgetFunc(onCreateSecretsRow)
+	destroySecretsModel glib.DestroyNotify = func(uintptr) {}
+)
+
+func (w *MainWindow) populateSecrets() {
+	tokens := w.store.Secrets()
+	tokenModel := gio.NewListStore(gTypeSecretsRowItem)
+	for _, token := range tokens {
+		subtitle := L("Environment file")
+		if token.Mode == state.SecretModeProxy {
+			subtitle = fmt.Sprintf(L("Proxy, %v"), token.Upstream)
+		}
+		appendSecretsRow(tokenModel, newSecretsRowItem(secretsRowToken, token.Name, subtitle, "dialog-password-symbolic"))
+	}
+	if len(tokens) == 0 {
+		appendSecretsRow(tokenModel, newSecretsRowItem(secretsRowEmpty, L("No Tokens"), "", "dialog-password-symbolic"))
+	}
+	appendSecretsRow(tokenModel, newSecretsRowItem(secretsRowAction, L("_Add Token..."), "", "list-add-symbolic"))
+	w.secretsTokensGroup.BindModel(tokenModel, &createSecretsRow, 0, &destroySecretsModel)
+	tokenModel.Unref()
+
+	sshKeys := w.store.SSHKeys()
+	sshKeyModel := gio.NewListStore(gTypeSecretsRowItem)
+	for _, key := range sshKeys {
+		subtitle := shortFingerprint(key.Fingerprint) + ", " + strings.TrimPrefix(key.Type, "ssh-")
+
+		appendSecretsRow(sshKeyModel, newSecretsRowItem(secretsRowSSHKey, key.Comment, subtitle, "channel-secure-symbolic"))
+	}
+	if len(sshKeys) == 0 {
+		appendSecretsRow(sshKeyModel, newSecretsRowItem(secretsRowEmpty, L("No SSH Keys"), "", "channel-secure-symbolic"))
+	}
+	w.secretsSSHKeysGroup.BindModel(sshKeyModel, &createSecretsRow, 0, &destroySecretsModel)
+	sshKeyModel.Unref()
+
+	gpgKeys := w.store.GPGKeys()
+	gpgKeyModel := gio.NewListStore(gTypeSecretsRowItem)
+	for _, key := range gpgKeys {
+		subtitle := shortFingerprint(key.Fingerprint)
+
+		appendSecretsRow(gpgKeyModel, newSecretsRowItem(secretsRowGPGKey, key.UID, subtitle, "security-high-symbolic"))
+	}
+	if len(gpgKeys) == 0 {
+		appendSecretsRow(gpgKeyModel, newSecretsRowItem(secretsRowEmpty, L("No PGP Keys"), "", "security-high-symbolic"))
+	}
+	w.secretsGPGKeysGroup.BindModel(gpgKeyModel, &createSecretsRow, 0, &destroySecretsModel)
+	gpgKeyModel.Unref()
+
+	w.secretsFooterLabel.SetMarkup(
+		L("Manage SSH and PGP keys, and optionally tokens, in") + " " + seahorseHelpLink(L("Passwords and Keys")),
+	)
+}
+
+func newSecretsRowItem(kind secretsRowKind, title string, subtitle string, icon string) secretsRowItem {
+	obj := gobject.NewObjectWithProperties(gTypeSecretsRowItem, 0, nil, nil)
+
+	var v secretsRowItem
+	obj.Cast(&v)
+
+	item := (*secretsRowItem)(unsafe.Pointer(obj.GetData(dataKeyGoInstance)))
+	item.kind = kind
+	item.title = title
+	item.subtitle = subtitle
+	item.icon = icon
+
+	return v
+}
+
+func appendSecretsRow(model *gio.ListStore, item secretsRowItem) {
+	model.Append(&item.Object)
+	item.Unref()
+}
+
+func onCreateSecretsRow(itemPtr uintptr, _ uintptr) uintptr {
+	obj := gobject.ObjectNewFromInternalPtr(itemPtr)
+	item := (*secretsRowItem)(unsafe.Pointer(obj.GetData(dataKeyGoInstance)))
+
+	switch item.kind {
+	case secretsRowAction:
+		row := adw.NewButtonRow()
+		row.SetTitle(item.title)
+		row.SetUseUnderline(true)
+		row.SetStartIconName(item.icon)
+		row.SetSensitive(false)
+
+		return row.GoPointer()
+
+	case secretsRowEmpty:
+		label := gtk.NewLabel(item.title)
+		label.AddCssClass("dim-label")
+		label.SetHalign(gtk.AlignCenterValue)
+		label.SetMarginTop(12)
+		label.SetMarginBottom(12)
+		label.SetMarginStart(12)
+		label.SetMarginEnd(12)
+
+		return label.GoPointer()
+	}
+
+	row := adw.NewActionRow()
+	row.SetIconName(item.icon)
+	row.SetUseMarkup(false)
+	row.SetTitle(item.title)
+	row.SetSubtitle(item.subtitle)
+
+	if item.kind == secretsRowToken {
+		row.AddSuffix(&newRowIconButton("insert-link-symbolic", L("Grant Access")).Widget)
+		row.AddSuffix(&newRowMenuButton(L("Token Menu")).Widget)
+	} else {
+		row.AddSuffix(&newRowIconButton("insert-link-symbolic", L("Link a Key")).Widget)
+	}
+
+	return row.GoPointer()
+}
+
+func newRowIconButton(icon string, tooltip string) *gtk.Button {
+	button := gtk.NewButton()
+	button.SetIconName(icon)
+	button.SetTooltipText(tooltip)
+	button.SetValign(gtk.AlignCenterValue)
+	button.SetHasFrame(false)
+	button.SetSensitive(false)
+
+	return button
+}
+
+func newRowMenuButton(tooltip string) *gtk.MenuButton {
+	button := gtk.NewMenuButton()
+	button.SetIconName("view-more-symbolic")
+	button.SetTooltipText(tooltip)
+	button.SetValign(gtk.AlignCenterValue)
+	button.SetHasFrame(false)
+	button.SetSensitive(false)
+
+	return button
+}
+
+func shortFingerprint(fingerprint string) string {
+	if len(fingerprint) > 16 {
+		return fingerprint[len(fingerprint)-16:]
+	}
+
+	return fingerprint
+}
+
+func seahorseHelpLink(label string) string {
+	var b strings.Builder
+
+	seahorseLinkTemplate.Execute(&b, seahorseLinkData{
+		URL:   seahorseHelp,
+		Label: label,
+	})
+
+	return b.String()
+}
+
+func init() {
+	var classInit gobject.ClassInitFunc = func(tc *gobject.TypeClass, u uintptr) {
+		objClass := (*gobject.ObjectClass)(unsafe.Pointer(tc))
+
+		objClass.OverrideConstructed(func(o *gobject.Object) {
+			parentObjClass := (*gobject.ObjectClass)(unsafe.Pointer(tc.PeekParent()))
+			parentObjClass.GetConstructed()(o)
+
+			var parent gobject.Object
+			o.Cast(&parent)
+
+			item := &secretsRowItem{
+				Object: parent,
+			}
+
+			var pinner runtime.Pinner
+			pinner.Pin(item)
+
+			var cleanupCallback glib.DestroyNotify = func(data uintptr) {
+				pinner.Unpin()
+			}
+			o.SetDataFull(dataKeyGoInstance, uintptr(unsafe.Pointer(item)), &cleanupCallback)
+		})
+	}
+
+	var instanceInit gobject.InstanceInitFunc = func(ti *gobject.TypeInstance, tc *gobject.TypeClass) {}
+
+	var parentQuery gobject.TypeQuery
+	gobject.NewTypeQuery(gobject.TypeObjectVal, &parentQuery)
+
+	gTypeSecretsRowItem = gobject.TypeRegisterStaticSimple(
+		parentQuery.Type,
+		"PhialSecretsRowItem",
+		parentQuery.ClassSize,
+		&classInit,
+		parentQuery.InstanceSize,
+		&instanceInit,
+		0,
+	)
+}
