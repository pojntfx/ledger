From 3c874fd46c45ec6e7db0be89c85c59030c96b905 Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Tue, 20 Oct 2026 22:29:13 -0700
Subject: [PATCH] refactor: Clarify role of Passwords and Keys
---
diff --git a/assets/meta/screenshot-secrets.png b/assets/meta/screenshot-secrets.png
index c5889373f06a14c918e39a39d5b3577cb5d6d57d..47228459f8b191d1debea3fa223940a6a28bfac4 100644
Binary files a/assets/meta/screenshot-secrets.png and b/assets/meta/screenshot-secrets.png differ
diff --git a/internal/components/pages.go b/internal/components/pages.go
index 58cb87c49d7768af2d4f8a802d5cca55baf063c2..7e81fbe06d6057694370e17a229005dfb7c3d9e9 100644
--- a/internal/components/pages.go
+++ b/internal/components/pages.go
@@ -14,15 +14,15 @@
 func (a *App) buildSecretsPage(snapshot domain.Snapshot) *adw.NavigationPage {
 	tokens := adw.NewPreferencesGroup()
 	tokens.SetTitle("Tokens")
-	tokens.SetDescription("Tokens are stored in the keyring of this host")
+	tokens.SetDescription("Stored in the keyring of this host")
 
 	sshKeys := adw.NewPreferencesGroup()
 	sshKeys.SetTitle("SSH Keys")
-	sshKeys.SetDescription("SSH keys come from the SSH agent. Manage them in " + seahorseHelpLink("Passwords and Keys") + ".")
+	sshKeys.SetDescription("From the SSH agent")
 
 	gpgKeys := adw.NewPreferencesGroup()
 	gpgKeys.SetTitle("PGP Keys")
-	gpgKeys.SetDescription("PGP keys come from the PGP keyring. Manage them in " + seahorseHelpLink("Passwords and Keys") + ".")
+	gpgKeys.SetDescription("From the PGP keyring")
 
 	canLink := false
 	for _, machine := range snapshot.Machines {
@@ -109,7 +109,15 @@ 	}
 
 	tokens.Add(&a.buttonRow("_Add Token…", "list-add-symbolic", func() { a.showSecretDialog("") }).Widget)
 
-	content := a.pageContent(tokens, sshKeys, gpgKeys)
+	footerLabel := gtk.NewLabel("Manage SSH and PGP keys, and optionally tokens, in " + seahorseHelpLink("Passwords and Keys"))
+	footerLabel.SetUseMarkup(true)
+	footerLabel.SetWrap(true)
+	footerLabel.SetJustify(gtk.JustifyCenterValue)
+	footerLabel.SetXalign(0.5)
+	footerLabel.AddCssClass("caption")
+	footerLabel.AddCssClass("dim-label")
+
+	content := a.pageContentWithFooter(&footerLabel.Widget, tokens, sshKeys, gpgKeys)
 	page, _, _ := a.pageToolbar("Secrets", "No token or key is visible to a machine without a grant", content)
 	page.SetTag(secretsTag)
 	return page
diff --git a/internal/components/widgets.go b/internal/components/widgets.go
index a975e3a9ae8388e256727e77e75a5faf419cf663..49bad2ed30d881b4d7bc57e4633f51235d99dc9b 100644
--- a/internal/components/widgets.go
+++ b/internal/components/widgets.go
@@ -229,11 +229,23 @@ 	return row
 }
 
 func (a *App) pageContent(groups ...*adw.PreferencesGroup) *gtk.Widget {
-	return a.pageContentWithBanner(nil, groups...)
+	return a.pageContentWithParts(nil, nil, groups...)
 }
 
 func (a *App) pageContentWithBanner(banner *adw.Banner, groups ...*adw.PreferencesGroup) *gtk.Widget {
-	box := gtk.NewBox(gtk.OrientationVerticalValue, 24)
+	return a.pageContentWithParts(banner, nil, groups...)
+}
+
+func (a *App) pageContentWithFooter(footer *gtk.Widget, groups ...*adw.PreferencesGroup) *gtk.Widget {
+	return a.pageContentWithPartsAndSpacing(18, nil, footer, groups...)
+}
+
+func (a *App) pageContentWithParts(banner *adw.Banner, footer *gtk.Widget, groups ...*adw.PreferencesGroup) *gtk.Widget {
+	return a.pageContentWithPartsAndSpacing(24, banner, footer, groups...)
+}
+
+func (a *App) pageContentWithPartsAndSpacing(spacing int32, banner *adw.Banner, footer *gtk.Widget, groups ...*adw.PreferencesGroup) *gtk.Widget {
+	box := gtk.NewBox(gtk.OrientationVerticalValue, spacing)
 	box.SetMarginTop(24)
 	box.SetMarginBottom(24)
 	box.SetMarginStart(12)
@@ -241,6 +253,9 @@ 	box.SetMarginEnd(12)
 
 	for _, group := range groups {
 		box.Append(&group.Widget)
+	}
+	if footer != nil {
+		box.Append(footer)
 	}
 
 	clamp := a.clamped(&box.Widget)
