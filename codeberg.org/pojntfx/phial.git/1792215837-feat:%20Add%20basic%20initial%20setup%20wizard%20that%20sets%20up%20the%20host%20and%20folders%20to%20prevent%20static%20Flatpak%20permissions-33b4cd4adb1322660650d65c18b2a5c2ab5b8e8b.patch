+// locationForm holds the rows that choose one folder. The first run embeds it
+// in a page, and the preferences embed it in a preferences page.
+type locationForm struct {
+	app *App
+	set paths.Set
+
+	banner *adw.Banner
+
+	foldersGroup *adw.PreferencesGroup
+	runtimeGroup *adw.PreferencesGroup
+
+	configRow  *adw.ActionRow
+	dataRow    *adw.ActionRow
+	sshRow     *adw.ActionRow
+	runtimeRow *adw.ActionRow
+
+	onChanged func()
+}
+
+func (a *App) newLocationForm(set paths.Set) *locationForm {
+	form := &locationForm{app: a, set: set}
+
+	form.foldersGroup = adw.NewPreferencesGroup()
+	form.foldersGroup.SetTitle(i18n.L("Locations"))
+	form.foldersGroup.SetDescription(i18n.L("Keep these folders or choose your own"))
+
+	form.configRow = form.row("Configuration Folder", "Machines, tokens, and the SSH configuration", set.Config, func() {
+		form.choose("config")
+	})
+	form.dataRow = form.row("Data Folder", "Disks, install images, and shared files", set.Data, func() {
+		form.choose("data")
+	})
+	form.sshRow = form.row("SSH Keys Folder", "Key pairs that Phial generates and loads", set.SSH, func() {
+		form.choose("ssh")
+	})
+
+	form.foldersGroup.Add(&form.configRow.Widget)
+	form.foldersGroup.Add(&form.dataRow.Widget)
+	form.foldersGroup.Add(&form.sshRow.Widget)
+
+	defaults := a.buttonRow("_Use Default Folders", "folder-symbolic", func() {
+		form.useDefaults()
+	})
+	form.foldersGroup.Add(&defaults.Widget)
+
+	form.runtimeGroup = adw.NewPreferencesGroup()
+	form.runtimeGroup.SetTitle(i18n.L("Runtime"))
+	form.runtimeGroup.SetDescription(i18n.L("A temporary folder for running machines, provided by the system"))
+
+	form.runtimeRow = a.propertyRow("Folder", set.Runtime.HostPath())
+	form.runtimeGroup.Add(&form.runtimeRow.Widget)
+
+	form.refresh()
+
+	return form
+}
+
+// row builds one folder row with a choose control.
+func (f *locationForm) row(title string, description string, location paths.Location, choose func()) *adw.ActionRow {
+	row := adw.NewActionRow()
+	row.SetTitle(i18n.L(title))
+	row.SetSubtitle(locationText(location))
+	row.SetSubtitleSelectable(true)
+	row.SetTooltipText(i18n.L(description))
+
+	button := f.app.labelButton("_Choose", choose)
+	button.SetValign(gtk.AlignCenterValue)
+	row.AddSuffix(&button.Widget)
+
+	return row
+}
+
+// locationText names the folder that the user chose. A folder that the process
+// cannot reach states itself, so the row never looks ready when it is not.
+func locationText(location paths.Location) string {
+	if !location.IsSet() {
+		return i18n.L("Not selected")
+	}
+
+	if !location.Exists() {
+		return i18n.L("Not accessible")
+	}
+
+	if host := location.HostPath(); strings.TrimSpace(host) != "" {
+		return host
+	}
+
+	return location.AccessPath()
+}
+
+func (f *locationForm) refresh() {
+	f.configRow.SetSubtitle(locationText(f.set.Config))
+	f.dataRow.SetSubtitle(locationText(f.set.Data))
+	f.sshRow.SetSubtitle(locationText(f.set.SSH))
+	f.runtimeRow.SetSubtitle(locationText(f.set.Runtime))
+
+	if f.onChanged != nil {
+		f.onChanged()
+	}
+}
+
+func (f *locationForm) valid() bool {
+	return paths.Valid(f.set)
+}
+
+// fail states one problem in the banner of the first run, or in a toast when
+// the form sits in the preferences.
+func (f *locationForm) fail(message string) {
+	if f.banner != nil {
+		f.banner.SetTitle(message)
+		f.banner.SetRevealed(true)
+
+		return
+	}
+
+	f.app.toast(message)
+}
+
+func (f *locationForm) clearFailure() {
+	if f.banner != nil {
+		f.banner.SetRevealed(false)
+	}
+}
+
+func (f *locationForm) location(kind string) paths.Location {
+	switch kind {
+	case "config":
+		return f.set.Config
+	case "data":
+		return f.set.Data
+	default:
+		return f.set.SSH
+	}
+}
+
+func (f *locationForm) setLocation(kind string, location paths.Location) {
+	switch kind {
+	case "config":
+		f.set.Config = location
+	case "data":
+		f.set.Data = location
+	default:
+		f.set.SSH = location
+	}
+}
+
+func (f *locationForm) title(kind string) string {
+	switch kind {
+	case "config":
+		return i18n.L("Choose the Configuration Folder")
+	case "data":
+		return i18n.L("Choose the Data Folder")
+	default:
+		return i18n.L("Choose the SSH Keys Folder")
+	}
+}
+
+// choose asks the file chooser portal for one folder.
+func (f *locationForm) choose(kind string) {
+	current := f.location(kind).HostPath()
+
+	go func() {
+		folder, err := portals.ChooseFolder(f.title(kind), i18n.L("_Choose"), current)
+
+		f.app.idle(func() {
+			if err != nil {
+				f.fail(fmt.Sprintf(i18n.L("Could not choose the folder: %s"), err))
+
+				return
+			}
+
+			if !folder.IsSet() {
+				return
+			}
+
+			f.setLocation(kind, paths.Location{Host: folder.Host, Access: folder.Access})
+			f.refresh()
+			f.apply()
+		})
+	}()
+}
+
+// useDefaults asks the portal for the folder of every default, one after the
+// other, so that the defaults are one flow rather than three separate choices.
+func (f *locationForm) useDefaults() {
+	defaults := paths.Defaults()
+
+	go func() {
+		for _, kind := range []string{"config", "data", "ssh"} {
+			location := defaults.Config
+			if kind == "data" {
+				location = defaults.Data
+			} else if kind == "ssh" {
+				location = defaults.SSH
+			}
+
+			if err := ensureHostDir(location.HostPath()); err != nil {
+				message := fmt.Sprintf(i18n.L("Could not create the folder: %s"), err)
+				f.app.idle(func() { f.fail(message) })
+
+				return
+			}
+
+			folder, err := portals.ChooseFolder(f.title(kind), i18n.L("_Choose"), location.HostPath())
+			if err != nil {
+				message := fmt.Sprintf(i18n.L("Could not choose the folder: %s"), err)
+				f.app.idle(func() { f.fail(message) })
+
+				return
+			}
+
+			if !folder.IsSet() {
+				return
+			}
+
+			kind := kind
+			f.app.idle(func() {
+				f.setLocation(kind, paths.Location{Host: folder.Host, Access: folder.Access})
+				f.refresh()
+			})
+		}
+
+		f.app.idle(func() {
+			f.refresh()
+			f.apply()
+		})
+	}()
+}
+
+// ensureHostDir creates one folder on the host. A sandboxed process runs the
+// creation through flatpak-spawn, because the folder is outside the sandbox.
+func ensureHostDir(host string) error {
+	if strings.TrimSpace(host) == "" {
+		return fmt.Errorf("the folder is empty")
+	}
+
+	if !paths.Sandboxed() {
+		return os.MkdirAll(host, 0o700)
+	}
+
+	if output, err := hostcmd.Command("mkdir", "-p", host).CombinedOutput(); err != nil {
+		return fmt.Errorf("%s: %w", strings.TrimSpace(string(output)), err)
+	}
+
+	return nil
+}
+
+// apply creates the folders, writes the settings, and reports whether the
+// folders are ready.
+func (f *locationForm) apply() bool {
+	for _, location := range []paths.Location{f.set.Config, f.set.Data, f.set.SSH, f.set.Runtime} {
+		if paths.Sandboxed() && location.AccessPath() == location.HostPath() && location != f.set.Runtime {
+			continue
+		}
+
+		if err := os.MkdirAll(location.AccessPath(), 0o700); err != nil {
+			f.fail(fmt.Sprintf(i18n.L("Could not create the folder: %s"), err))
+
+			return false
+		}
+	}
+
+	if !f.valid() {
+		f.fail(i18n.L("Choose every folder first"))
+
+		return false
+	}
+
+	if err := f.app.saveLocations(f.set); err != nil {
+		f.fail(fmt.Sprintf(i18n.L("Could not save the folders: %s"), err))
+
+		return false
+	}
+
+	f.clearFailure()
+	f.refresh()
+
+	return true
+}
+
+// showSetupDialog presents the setup wizard over the window. The first run
+// opens it, and the preferences can open it again.
+func (a *App) showSetupDialog(firstRun bool) {
+	if a.win == nil {
+		return
+	}
+
+	a.win.Present()
+
+	if a.setupDialog != nil {
+		a.setupDialog.Present(&a.win.Widget)
+
+		return
+	}
+
+	set := a.loadLocations()
+
+	// A native run reaches the default folders directly, so the defaults are
+	// ready to continue. A sandboxed run must ask the portal for each one.
+	if !paths.Sandboxed() && !a.Settings.GetBoolean(resources.SettingLocationsSetKey) {
+		for _, location := range []paths.Location{set.Config, set.Data, set.SSH, set.Runtime} {
+			_ = os.MkdirAll(location.AccessPath(), 0o700)
+		}
+	}
+
+	form := a.newLocationForm(set)
+	form.banner = adw.NewBanner("")
+	form.banner.SetRevealed(false)
+
+	a.locationForm = form
+
+	navigation := adw.NewNavigationView()
+	navigation.SetPopOnEscape(true)
+	a.setupNavigation = navigation
+
+	navigation.Add(a.buildWelcomePage(navigation))
+	navigation.Add(a.buildHostSetupPage(navigation))
+	navigation.Add(a.buildFoldersPage(navigation, form))
+	navigation.Add(a.buildFinishPage(navigation, form))
+
+	width := a.win.GetWidth()
+	if width <= 0 {
+		width = a.Settings.GetInt(resources.SettingWindowWidthKey)
+	}
+
+	height := a.win.GetHeight()
+	if height <= 0 {
+		height = a.Settings.GetInt(resources.SettingWindowHeightKey)
+	}
+
+	contentWidth := int32(720)
+	if width > 0 && int32(width-96) < contentWidth {
+		contentWidth = int32(width - 96)
+	}
+	if contentWidth < 280 {
+		contentWidth = 280
+	}
+
+	contentHeight := int32(640)
+	if height > 0 && int32(height-96) < contentHeight {
+		contentHeight = int32(height - 96)
+	}
+	if contentHeight < 360 {
+		contentHeight = 360
+	}
+
+	dialog := adw.NewDialog()
+	dialog.SetTitle(i18n.L("Set Up Phial"))
+	dialog.SetContentWidth(contentWidth)
+	dialog.SetContentHeight(contentHeight)
+	dialog.SetCanClose(!firstRun)
+	dialog.SetChild(&navigation.Widget)
+
+	var onClosed func(adw.Dialog)
+	onClosed = func(adw.Dialog) {
+		a.setupDialog = nil
+		a.setupNavigation = nil
+	}
+	dialog.ConnectClosed(&onClosed)
+	a.hold(&onClosed)
+
+	a.setupDialog = dialog
+
+	dialog.Present(&a.win.Widget)
+}
+
+// wizardPage builds one step of the setup wizard.
+func (a *App) wizardPage(tag string, title string, subtitle string, content *gtk.Widget) (*adw.NavigationPage, *adw.HeaderBar) {
+	header := adw.NewHeaderBar()
+	header.SetShowEndTitleButtons(false)
+	windowTitle := adw.NewWindowTitle(i18n.L(title), i18n.L(subtitle))
+	header.SetTitleWidget(&windowTitle.Widget)
+
+	toolbar := adw.NewToolbarView()
+	toolbar.AddTopBar(&header.Widget)
+	toolbar.SetContent(content)
+
+	page := adw.NewNavigationPage(&toolbar.Widget, i18n.L(title))
+	page.SetTag(tag)
+
+	return page, header
+}
