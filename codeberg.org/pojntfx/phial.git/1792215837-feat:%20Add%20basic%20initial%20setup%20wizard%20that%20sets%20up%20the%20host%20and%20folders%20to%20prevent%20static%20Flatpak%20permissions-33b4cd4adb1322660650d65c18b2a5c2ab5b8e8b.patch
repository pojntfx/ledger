new file mode 100644
index 0000000000000000000000000000000000000000..2124fc5a281efd20e281aadf11d8a7b4a82abd62
--- /dev/null
+++ b/internal/ui/selfinstall.go
@@ -0,0 +1,45 @@
+package ui
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"strings"
+
+	"codeberg.org/pojntfx/phial-neo/internal/hostcmd"
+	"codeberg.org/pojntfx/phial-neo/internal/paths"
+	"codeberg.org/pojntfx/phial-neo/internal/setup"
+)
+
+// hostBinaryPath states the host build inside the bundle. The window copies
+// this binary to the host, so the installer needs no source tree.
+const hostBinaryPath = "/app/share/phial/phial-host"
+
+// installHost installs the host service and the tools.
+func (a *App) installHost() error {
+	if paths.Sandboxed() {
+		data, err := os.ReadFile(hostBinaryPath)
+		if err != nil {
+			return fmt.Errorf("read the host installer: %w", err)
+		}
+
+		copy := hostcmd.Command("sh", "-c", "cat > /tmp/phial-install && chmod 755 /tmp/phial-install")
+		copy.Stdin = bytes.NewReader(data)
+
+		if output, err := copy.CombinedOutput(); err != nil {
+			return fmt.Errorf("copy the host installer: %s: %w", strings.TrimSpace(string(output)), err)
+		}
+
+		defer func() {
+			_ = hostcmd.Command("rm", "-f", "/tmp/phial-install").Run()
+		}()
+
+		if output, err := hostcmd.Command("/tmp/phial-install", "install", "--embedded").CombinedOutput(); err != nil {
+			return fmt.Errorf("install the host service: %s: %w", strings.TrimSpace(string(output)), err)
+		}
+
+		return nil
+	}
+
+	return setup.Install(setup.InstallOptions{Embedded: true})
+}
