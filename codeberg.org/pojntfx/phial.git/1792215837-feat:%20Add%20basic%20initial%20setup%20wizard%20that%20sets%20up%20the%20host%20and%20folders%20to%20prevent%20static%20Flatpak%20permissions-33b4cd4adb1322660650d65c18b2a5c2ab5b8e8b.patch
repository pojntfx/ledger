+// buildHostSetupPage builds the step that sets up the host.
+func (a *App) buildHostSetupPage(navigation *adw.NavigationView) *adw.NavigationPage {
+	banner := adw.NewBanner("")
+	banner.SetRevealed(false)
+
+	hostRow := a.setupActionRow(
+		"Service",
+		"Adds the command-line tools",
+		"_Install",
+		func() error { return a.installHost() },
+		banner,
+	)
+
+	hostGroup := adw.NewPreferencesGroup()
+	hostGroup.SetTitle(i18n.L("Host Services"))
+	hostGroup.SetDescription(i18n.L("Runs your machines in the background"))
+	hostGroup.Add(&hostRow.Widget)
+
+	systemRow := a.setupActionRow(
+		"Prepare This Computer",
+		"Needs your password",
+		"_Apply",
+		func() error {
+			_, _, err := a.Service.SystemRootSetup(a.Ctx, nil, mcp.RootSetupInput{})
+
+			return err
+		},
+		banner,
+	)
+
+	systemGroup := adw.NewPreferencesGroup()
+	systemGroup.SetTitle(i18n.L("System Setup"))
+	systemGroup.SetDescription(i18n.L("For virtual machines and USB devices"))
+	systemGroup.Add(&systemRow.Widget)
+
+	preferences := adw.NewPreferencesPage()
+	preferences.SetBanner(banner)
+	preferences.Add(hostGroup)
+	preferences.Add(systemGroup)
+
+	page, header := a.wizardPage("host", "Host Setup", "", &preferences.Widget)
+
+	next := a.labelButton("_Continue", func() {
+		navigation.PushByTag("folders")
+	})
+	next.AddCssClass("suggested-action")
+	header.PackEnd(&next.Widget)
+
+	return page
+}
+
+// setupActionRow builds a row with one action and its progress.
+func (a *App) setupActionRow(title string, subtitle string, label string, action func() error, banner *adw.Banner) *adw.ActionRow {
+	row := adw.NewActionRow()
+	row.SetTitle(i18n.L(title))
+	row.SetSubtitle(i18n.L(subtitle))
+
+	box := gtk.NewBox(gtk.OrientationHorizontalValue, 6)
+	box.SetValign(gtk.AlignCenterValue)
+
+	spinner := adw.NewSpinner()
+	spinner.SetVisible(false)
+
+	var button *gtk.Button
+	button = a.labelButton(label, func() {
+		button.SetSensitive(false)
+		spinner.SetVisible(true)
+
+		go func() {
+			err := action()
+
+			a.idle(func() {
+				spinner.SetVisible(false)
+
+				if err != nil {
+					banner.SetTitle(i18n.L("Could not set up this host"))
+					banner.SetRevealed(true)
+					button.SetSensitive(true)
+					a.Log.Error("the host setup failed", "err", err)
+
+					return
+				}
+
+				button.SetLabel(i18n.L("Done"))
+				button.SetSensitive(false)
+				row.SetSubtitle(i18n.L("Ready"))
+				banner.SetRevealed(false)
+			})
+		}()
+	})
+
+	box.Append(&spinner.Widget)
+	box.Append(&button.Widget)
+	row.AddSuffix(&box.Widget)
+
+	return row
+}
+
+// buildFoldersPage builds the step that chooses the folders.
+func (a *App) buildFoldersPage(navigation *adw.NavigationView, form *locationForm) *adw.NavigationPage {
+	content := a.pageContentWithBanner(form.banner, form.foldersGroup, form.runtimeGroup)
+
+	page, header := a.wizardPage("folders", "Folders", "Where Phial keeps its files", content)
+
+	next := a.labelButton("_Continue", func() {
+		if !form.apply() {
+			return
+		}
+
+		navigation.PushByTag("finish")
+	})
+	next.AddCssClass("suggested-action")
+	next.SetSensitive(form.valid())
+	header.PackEnd(&next.Widget)
+
+	form.onChanged = func() {
+		next.SetSensitive(form.valid())
+	}
+	form.refresh()
+
+	return page
+}
+
+// buildFinishPage builds the last step.
+func (a *App) buildFinishPage(navigation *adw.NavigationView, form *locationForm) *adw.NavigationPage {
+	status := adw.NewStatusPage()
+	status.SetIconName("object-select-symbolic")
+	status.SetTitle(i18n.L("You're Ready"))
+	status.SetDescription(i18n.L("Phial is set up for your first machine"))
+
