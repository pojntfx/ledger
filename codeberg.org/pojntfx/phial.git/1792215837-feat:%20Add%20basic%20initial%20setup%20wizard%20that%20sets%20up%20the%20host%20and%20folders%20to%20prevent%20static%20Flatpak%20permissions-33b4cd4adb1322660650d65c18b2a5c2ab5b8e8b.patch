+export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"
+export GSETTINGS_SCHEMA_DIR="$PWD/assets/resources"
+export GSETTINGS_BACKEND="${GSETTINGS_BACKEND:-keyfile}"
+GSETTINGS="${GSETTINGS:-/usr/bin/gsettings}"
+
+OUT="${OUT:-/tmp/phial-wizard}"
+LOG="${LOG:-/tmp/phial-wizard.log}"
+APP_ID="com.pojtinger.felicitas.Phial"
+APP_PATH="/com/pojtinger/felicitas/Phial"
+
+export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-/tmp/phial-wizard-config}"
+export XDG_DATA_HOME="${XDG_DATA_HOME:-/tmp/phial-wizard-data}"
+export PHIAL_RUNTIME_DIR="${PHIAL_RUNTIME_DIR:-/tmp/phial-wizard-runtime/phial}"
+
+rm -rf "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$PHIAL_RUNTIME_DIR" "$OUT"
+mkdir -p "$PHIAL_RUNTIME_DIR" "$OUT"
+
+pkill -x phial-wizard-app 2>/dev/null || true
+
+go build -o /tmp/phial-wizard-app -ldflags="-X 'main.LocaleDir=$PWD/po'" . || exit 1
+
+pid=""
+
+start() {
+  /tmp/phial-wizard-app >"$LOG" 2>&1 &
+  pid=$!
+
+  for _ in $(seq 1 30); do
+    if gdbus call --session --dest "$APP_ID" --object-path "$APP_PATH" --method org.gtk.Actions.List >/dev/null 2>&1; then
+      sleep 3
+      return 0
+    fi
+    sleep 1
+  done
+
+  echo "the application did not start" >&2
+  exit 1
+}
+
+stop() {
+  kill "$pid" 2>/dev/null
+  sleep 1
+  kill -9 "$pid" 2>/dev/null
+  wait "$pid" 2>/dev/null
+  pid=""
+}
+
+act() {
+  gdbus call --session --dest "$APP_ID" --object-path "$APP_PATH" --method org.gtk.Actions.Activate "$1" "[]" "[]" >/dev/null 2>&1
+}
+
+act_string() {
+  gdbus call --session --dest "$APP_ID" --object-path "$APP_PATH" --method org.gtk.Actions.Activate "$1" "[<@s '$2'>]" "[]" >/dev/null 2>&1
+}
+
+capture() {
+  sleep 1
+  act_string capture "$OUT/$1.png"
+  sleep 1
+  act_string capture "$OUT/$1.png"
+  sleep 1
+}
+
+set_size() {
+  "$GSETTINGS" set "$APP_ID" window-width "$1"
+  "$GSETTINGS" set "$APP_ID" window-height "$2"
+}
+
+set_size 1020 720
+start
+capture 01-welcome
+act_string wizard-step host
+sleep 2
+capture 02-host-setup
+act_string wizard-step folders
+sleep 2
+capture 03-folders
+act_string wizard-step finish
+sleep 2
+capture 04-finish
+act wizard-finish
+sleep 3
+capture 05-main
+stop
+
+rm -rf "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$PHIAL_RUNTIME_DIR"
+mkdir -p "$PHIAL_RUNTIME_DIR"
+
+set_size 430 800
+start
+capture 10-welcome-mobile
+act_string wizard-step host
+sleep 2
+capture 11-host-setup-mobile
+act_string wizard-step folders
+sleep 2
+capture 12-folders-mobile
+act_string wizard-step finish
+sleep 2
+capture 13-finish-mobile
+stop
+
+ls -la "$OUT"
+echo "the wizard test finished"

