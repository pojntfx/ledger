diff --git a/internal/paths/paths.go b/internal/paths/paths.go
new file mode 100644
index 0000000000000000000000000000000000000000..171fb8b5eddbbbc2cca8989427cf41bda1384f2c
--- /dev/null
+++ b/internal/paths/paths.go
@@ -0,0 +1,278 @@
+package paths
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+
+	"github.com/adrg/xdg"
+
+	"codeberg.org/pojntfx/phial-neo/internal/hostcmd"
+)
+
+// Location states one folder twice. Host is the path that a host process uses,
+// and Access is the path that this process uses. A native run sees the same path
+// in both fields. A sandboxed run sees the path of the document portal in
+// Access, and the real path of the host in Host.
+type Location struct {
+	Host   string `json:"host"`
+	Access string `json:"access"`
+}
+
+// Path states the path that this process reads and writes.
+func (l Location) Path() string {
+	if strings.TrimSpace(l.Access) != "" {
+		return l.Access
+	}
+
+	return l.Host
+}
+
+// HostPath states the path that a host process reads and writes.
+func (l Location) HostPath() string {
+	return l.Host
+}
+
+// AccessPath states the path that this process reads and writes.
+func (l Location) AccessPath() string {
+	return l.Path()
+}
+
+// IsSet reports whether the location names a host path and an access path.
+func (l Location) IsSet() bool {
+	return strings.TrimSpace(l.Host) != "" && strings.TrimSpace(l.AccessPath()) != ""
+}
+
+// Exists reports whether the access path is a directory right now.
+func (l Location) Exists() bool {
+	info, err := os.Stat(l.AccessPath())
+
+	return err == nil && info.IsDir()
+}
+
+// Set holds every folder that Phial reads or writes.
+type Set struct {
+	Config  Location `json:"config"`
+	Data    Location `json:"data"`
+	SSH     Location `json:"ssh"`
+	Runtime Location `json:"runtime"`
+}
+
+var (
+	lock    sync.RWMutex
+	current = Defaults()
+)
+
+// Sandboxed reports whether this process runs inside a Flatpak sandbox.
+func Sandboxed() bool {
+	return os.Getenv("FLATPAK_ID") != ""
+}
+
+// hostConfigHome states the configuration home of the host. A sandboxed run
+// reads the home variable of the host, because its own XDG directories point
+// into the sandbox.
+func hostConfigHome() string {
+	if Sandboxed() {
+		if home, err := os.UserHomeDir(); err == nil {
+			return filepath.Join(home, ".config")
+		}
+	}
+
+	return xdg.ConfigHome
+}
+
+// hostDataHome states the data home of the host.
+func hostDataHome() string {
+	if Sandboxed() {
+		if home, err := os.UserHomeDir(); err == nil {
+			return filepath.Join(home, ".local", "share")
+		}
+	}
+
+	return xdg.DataHome
+}
+
+// Defaults states the folders that Phial uses when the user selects nothing.
+func Defaults() Set {
+	home := xdg.Home
+	if home == "" {
+		home, _ = os.UserHomeDir()
+	}
+
+	runtimeBase := xdg.RuntimeDir
+	if runtimeBase == "" {
+		runtimeBase = fmt.Sprintf("/run/user/%d", os.Getuid())
+	}
+
+	config := filepath.Join(hostConfigHome(), "phial")
+	data := filepath.Join(hostDataHome(), "phial")
+	ssh := filepath.Join(home, ".ssh")
+	runtime := filepath.Join(runtimeBase, "phial")
+
+	return Set{
+		Config:  Location{Host: config, Access: config},
+		Data:    Location{Host: data, Access: data},
+		SSH:     Location{Host: ssh, Access: ssh},
+		Runtime: Location{Host: runtime, Access: runtime},
+	}
+}
+
+// Current states the folders of this process.
+func Current() Set {
+	lock.RLock()
+	defer lock.RUnlock()
+
+	return current
+}
+
+// SetCurrent replaces the folders of this process.
+func SetCurrent(next Set) {
+	lock.Lock()
+	defer lock.Unlock()
+
+	current = next
+}
+
+// Config states the configuration folder.
+func Config() Location {
+	return Current().Config
+}
+
+// Data states the data folder.
+func Data() Location {
+	return Current().Data
+}
+
+// SSH states the SSH folder.
+func SSH() Location {
+	return Current().SSH
+}
+
+// Runtime states the runtime folder.
+func Runtime() Location {
+	return Current().Runtime
+}
+
+// Valid reports whether every folder names a path and every access path exists.
+func Valid(set Set) bool {
+	for _, location := range []Location{set.Config, set.Data, set.SSH, set.Runtime} {
+		if !location.IsSet() || !location.Exists() {
+			return false
+		}
+	}
+
+	return true
+}
+
+// defaultConfigDir states the configuration folder of the host install, which
+// carries the locations file that a host process reads before it knows the
+// folders of the user.
+func defaultConfigDir() string {
+	return filepath.Join(hostConfigHome(), "phial")
+}
+
+func defaultLocationsFile() string {
+	return filepath.Join(defaultConfigDir(), "locations.json")
+}
+
+// hostFile states the folders in the form that a host process reads.
+type hostFile struct {
+	Config  string `json:"config"`
+	Data    string `json:"data"`
+	SSH     string `json:"ssh"`
+	Runtime string `json:"runtime"`
+}
+
+// LoadHostFile reads the locations file of the host install. A process that
+// runs outside the sandbox calls it before it reads a machine or a secret.
+func LoadHostFile() error {
+	data, err := os.ReadFile(defaultLocationsFile())
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+
+	var file hostFile
+	if err := json.Unmarshal(data, &file); err != nil {
+		return fmt.Errorf("read %s: %w", defaultLocationsFile(), err)
+	}
+
+	next := Defaults()
+
+	if file.Config != "" {
+		next.Config = Location{Host: file.Config, Access: file.Config}
+	}
+	if file.Data != "" {
+		next.Data = Location{Host: file.Data, Access: file.Data}
+	}
+	if file.SSH != "" {
+		next.SSH = Location{Host: file.SSH, Access: file.SSH}
+	}
+	if file.Runtime != "" {
+		next.Runtime = Location{Host: file.Runtime, Access: file.Runtime}
+	}
+
+	SetCurrent(next)
+
+	return nil
+}
+
+// SaveHostFile writes the locations file that a host process reads. The file
+// always lands in the default configuration folder, so that a host process can
+// find the folders of the user before it reads them.
+func SaveHostFile(set Set) error {
+	file := hostFile{
+		Config:  set.Config.HostPath(),
+		Data:    set.Data.HostPath(),
+		SSH:     set.SSH.HostPath(),
+		Runtime: set.Runtime.HostPath(),
+	}
+
+	data, err := json.MarshalIndent(file, "", "  ")
+	if err != nil {
+		return err
+	}
+
+	data = append(data, '\n')
+
+	if err := writeHostFile(defaultLocationsFile(), data); err != nil {
+		return err
+	}
+
+	local := filepath.Join(set.Config.AccessPath(), "locations.json")
+	if local == defaultLocationsFile() {
+		return nil
+	}
+
+	if err := os.MkdirAll(filepath.Dir(local), 0o700); err != nil {
+		return err
+	}
+
+	return os.WriteFile(local, data, 0o600)
+}
+
+// writeHostFile writes one file in the default configuration folder. A
+// sandboxed process cannot reach that folder, so the write runs on the host.
+func writeHostFile(path string, data []byte) error {
+	if !Sandboxed() {
+		if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+			return err
+		}
+
+		return os.WriteFile(path, data, 0o600)
+	}
+
+	command := hostcmd.Command("sh", "-c", "umask 077; mkdir -p \"$1\" && cat > \"$2\"", "sh", filepath.Dir(path), path)
+	command.Stdin = strings.NewReader(string(data))
+
+	if output, err := command.CombinedOutput(); err != nil {
+		return fmt.Errorf("write %s on the host: %s: %w", path, strings.TrimSpace(string(output)), err)
+	}
+
+	return nil
+}
diff --git a/internal/portals/portals.go b/internal/portals/portals.go
new file mode 100644
index 0000000000000000000000000000000000000000..852aacecabec54d476b2413c03357ee1b6740801
--- /dev/null
+++ b/internal/portals/portals.go
@@ -0,0 +1,123 @@
+package portals
+
+import (
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/godbus/dbus/v5"
+	"github.com/rymdport/portal/filechooser"
+)
+
+const (
+	documentsService   = "org.freedesktop.portal.Documents"
+	documentsPath      = dbus.ObjectPath("/org/freedesktop/portal/documents")
+	documentsInterface = "org.freedesktop.portal.Documents"
+)
+
+// Folder states the folder that the user chose. Host is the path that a host
+// process uses, and Access is the path that this process uses. The two paths
+// differ only inside a sandbox, where the file chooser answers with a path of
+// the document portal.
+type Folder struct {
+	Host   string
+	Access string
+}
+
+// IsSet reports whether the user chose a folder.
+func (f Folder) IsSet() bool {
+	return strings.TrimSpace(f.Access) != ""
+}
+
+// FilePathFromURI turns one file URI into a path. A value that carries no
+// scheme is already a path.
+func FilePathFromURI(uri string) (string, error) {
+	if !strings.HasPrefix(uri, "file://") {
+		return uri, nil
+	}
+
+	parsed, err := url.Parse(uri)
+	if err != nil {
+		return "", err
+	}
+
+	path, err := url.PathUnescape(parsed.Path)
+	if err != nil {
+		return "", err
+	}
+
+	return path, nil
+}
+
+// ChooseFolder opens the file chooser portal for one folder.
+func ChooseFolder(title string, acceptLabel string, currentFolder string) (Folder, error) {
+	uris, err := filechooser.OpenFile("", title, &filechooser.OpenFileOptions{
+		Directory:     true,
+		AcceptLabel:   acceptLabel,
+		CurrentFolder: currentFolder,
+	})
+	if err != nil {
+		return Folder{}, err
+	}
+
+	if len(uris) == 0 {
+		return Folder{}, nil
+	}
+
+	access, err := FilePathFromURI(uris[0])
+	if err != nil {
+		return Folder{}, err
+	}
+
+	host, err := HostPath(access)
+	if err != nil {
+		return Folder{}, err
+	}
+
+	return Folder{Host: host, Access: access}, nil
+}
+
+// HostPath states the path that a host process uses for one path of this
+// process. A path outside the document portal is already a host path.
+func HostPath(path string) (string, error) {
+	id, ok := documentID(path)
+	if !ok {
+		return path, nil
+	}
+
+	connection, err := dbus.SessionBus()
+	if err != nil {
+		return "", fmt.Errorf("reach the document portal: %w", err)
+	}
+
+	var paths map[string][]byte
+	if err := connection.Object(documentsService, documentsPath).Call(
+		documentsInterface+".GetHostPaths",
+		0,
+		[]string{id},
+	).Store(&paths); err != nil {
+		return "", fmt.Errorf("ask the document portal for %s: %w", path, err)
+	}
+
+	host, ok := paths[id]
+	if !ok {
+		return "", fmt.Errorf("the document portal holds no path for %s", path)
+	}
+
+	return string(host), nil
+}
+
+// documentID states the identifier of one document portal path.
+func documentID(path string) (string, bool) {
+	prefix := filepath.Join(os.Getenv("XDG_RUNTIME_DIR"), "doc") + string(filepath.Separator)
+	if !strings.HasPrefix(path, prefix) {
+		return "", false
+	}
+
+	rest := strings.TrimPrefix(path, prefix)
+	id := strings.SplitN(rest, string(filepath.Separator), 2)[0]
+
+	return id, id != ""
+}
