+// locationsFromSettings states the folders that the settings name. A setting
+// that names nothing keeps the folder that the process already uses, so that a
+// native run without settings follows the host install.
+func locationsFromSettings(settings *gio.Settings) paths.Set {
+	set := paths.Current()
+
+	if !settings.GetBoolean(resources.SettingLocationsSetKey) {
+		return set
+	}
+
+	set.Config = settingLocation(settings, resources.SettingConfigDirKey, resources.SettingConfigPathKey, set.Config)
+	set.Data = settingLocation(settings, resources.SettingDataDirKey, resources.SettingDataPathKey, set.Data)
+	set.SSH = settingLocation(settings, resources.SettingSSHDirKey, resources.SettingSSHPathKey, set.SSH)
+
+	return set
+}
+
+func settingLocation(settings *gio.Settings, hostKey, accessKey string, fallback paths.Location) paths.Location {
+	host := settings.GetString(hostKey)
+	access := settings.GetString(accessKey)
+
+	if strings.TrimSpace(host) == "" && strings.TrimSpace(access) == "" {
+		return fallback
+	}
+
+	if strings.TrimSpace(host) == "" {
+		host = access
+	}
+	if strings.TrimSpace(access) == "" {
+		access = host
+	}
+
+	return paths.Location{Host: host, Access: access}
+}
+
+// applySettingsLocations points the process at the folders of the settings. It
+// runs before the state client is built, so that every later read follows the
+// same folders.
+func applySettingsLocations(settings *gio.Settings) {
+	paths.SetCurrent(locationsFromSettings(settings))
+}
+
+// existingState reports whether a configuration folder already carries the
+// state of an earlier run, so that a native install keeps its folders.
+func existingState(dir string) bool {
+	for _, name := range []string{"mapping", "vms"} {
+		if _, err := os.Stat(filepath.Join(dir, name)); err == nil {
+			return true
+		}
+	}
+
+	return false
+}
+
+// prepareLocations applies the folders and reports whether the window must
+// show the setup page.
+func (a *App) prepareLocations() bool {
+	set := a.loadLocations()
+
+	paths.SetCurrent(set)
+
+	configured := a.Settings.GetBoolean(resources.SettingLocationsSetKey)
+	existing := !paths.Sandboxed() && existingState(set.Config.AccessPath())
+	required := !configured && !existing || configured && !paths.Valid(set)
+
+	a.Log.Info(
+		"preparing the folders",
+		"configured", configured,
+		"sandboxed", paths.Sandboxed(),
+		"existing", existing,
+		"valid", paths.Valid(set),
+		"config", set.Config.AccessPath(),
+		"required", required,
+	)
+
+	if configured {
+		return !paths.Valid(set)
+	}
+
+	if existing {
+		if err := a.saveLocations(set); err != nil {
+			a.Log.Warn("could not write the locations of an existing install", "err", err)
+		}
+
+		return false
+	}
+
+	return true
+}
+
+// loadLocations states the folders of the settings.
+func (a *App) loadLocations() paths.Set {
+	return locationsFromSettings(a.Settings)
+}
+
+// saveLocations writes the folders into the settings, the process, and the
+// host file. The host file lands first, so a failure keeps the setup page.
+func (a *App) saveLocations(set paths.Set) error {
+	paths.SetCurrent(set)
+
+	if a.State != nil {
+		a.State.Reload()
+	}
+
+	if err := paths.SaveHostFile(set); err != nil {
+		return err
+	}
+
+	a.Settings.SetBoolean(resources.SettingLocationsSetKey, true)
+	a.Settings.SetString(resources.SettingConfigDirKey, set.Config.HostPath())
+	a.Settings.SetString(resources.SettingConfigPathKey, set.Config.AccessPath())
+	a.Settings.SetString(resources.SettingDataDirKey, set.Data.HostPath())
+	a.Settings.SetString(resources.SettingDataPathKey, set.Data.AccessPath())
+	a.Settings.SetString(resources.SettingSSHDirKey, set.SSH.HostPath())
+	a.Settings.SetString(resources.SettingSSHPathKey, set.SSH.AccessPath())
+	a.Settings.Apply()
+
+	return nil
+}
