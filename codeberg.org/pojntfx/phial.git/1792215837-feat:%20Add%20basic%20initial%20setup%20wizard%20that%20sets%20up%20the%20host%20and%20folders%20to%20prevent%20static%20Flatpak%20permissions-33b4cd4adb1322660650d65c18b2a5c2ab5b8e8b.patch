+package setup
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// Asset states one file of the host install.
+type Asset struct {
+	Name string
+	Data []byte
+}
+
+// Assets holds the host units, the host tools, the desktop file, and the
+// settings schema. A source tree reads them from the repository, and a bundle
+// carries them inside the binary.
+type Assets struct {
+	Units        []Asset
+	Binaries     []Asset
+	DesktopFiles []Asset
+	Icons        []Asset
+	Schema       []byte
+}
+
+var embeddedAssets *Assets
+
+// SetEmbeddedAssets carries the host install into the binary, so that the
+// window can install the host without a source tree.
+func SetEmbeddedAssets(assets *Assets) {
+	embeddedAssets = assets
+}
+
+func loadAssets(options InstallOptions) (*Assets, error) {
+	if options.Embedded {
+		if embeddedAssets == nil {
+			return nil, fmt.Errorf("the embedded install assets are missing")
+		}
+
+		return embeddedAssets, nil
+	}
+
+	if options.RepoDir == "" {
+		return nil, fmt.Errorf("no repository directory given")
+	}
+
+	return readAssets(options.RepoDir)
+}
+
+func readAssets(repoDir string) (*Assets, error) {
+	assets := &Assets{}
+
+	units, err := readAssetsDir(filepath.Join(repoDir, "host", "systemd"), ".service")
+	if err != nil {
+		return nil, err
+	}
+	assets.Units = units
+
+	binaries, err := readAssetsDir(filepath.Join(repoDir, "host", "bin"), "")
+	if err != nil && !os.IsNotExist(err) {
+		return nil, err
+	}
+	assets.Binaries = binaries
+
+	desktopFiles, err := readAssetsDir(filepath.Join(repoDir, "assets", "meta"), ".desktop")
+	if err != nil {
+		return nil, err
+	}
+	assets.DesktopFiles = desktopFiles
+
+	icons, err := readAssetsDir(filepath.Join(repoDir, "assets", "meta"), ".svg")
+	if err != nil {
+		return nil, err
+	}
+	assets.Icons = icons
+
+	schema, err := os.ReadFile(filepath.Join(repoDir, "assets", "resources", "index.gschema.xml"))
+	if err != nil {
+		return nil, err
+	}
+	assets.Schema = schema
+
+	return assets, nil
+}
+
+func readAssetsDir(dir string, suffix string) ([]Asset, error) {
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return nil, err
+	}
+
+	assets := []Asset{}
+
+	for _, entry := range entries {
+		if entry.IsDir() || (suffix != "" && !strings.HasSuffix(entry.Name(), suffix)) {
+			continue
+		}
+
+		data, err := os.ReadFile(filepath.Join(dir, entry.Name()))
+		if err != nil {
+			return nil, err
+		}
+
+		assets = append(assets, Asset{Name: entry.Name(), Data: data})
+	}
+
+	return assets, nil
+}
