+// buildWelcomePage builds the splash step with the call to action.
+func (a *App) buildWelcomePage(navigation *adw.NavigationView) *adw.NavigationPage {
+	status := adw.NewStatusPage()
+	status.SetTitle(i18n.L("Phial"))
