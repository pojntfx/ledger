+++ b/internal/machine/accessors_test.go
@@ -0,0 +1,160 @@
+package machine
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"codeberg.org/pojntfx/phial-neo/internal/paths"
+)
+
+func TestRdpEndpoint(t *testing.T) {
+	def := Defaults("phial")
+
+	if got, want := def.RdpAddress(), "localhost:3392"; got != want {
+		t.Fatalf("RdpAddress() = %q, want %q", got, want)
+	}
+
+	if got, want := def.RdpURI(), "rdp://phial@localhost:3392"; got != want {
+		t.Fatalf("RdpURI() = %q, want %q", got, want)
+	}
+}
+
+func TestEnsureSSHIncludeUpdatesTheBlock(t *testing.T) {
+	folders := useFolders(t)
+
+	userConfig := filepath.Join(folders.ssh, "config")
+	if err := os.WriteFile(userConfig, []byte("Host example\n    HostName example.test\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := EnsureSSHInclude(); err != nil {
+		t.Fatal(err)
+	}
+
+	assertInclude(t, userConfig, filepath.Join(folders.config, "ssh_config"))
+
+	if err := EnsureSSHInclude(); err != nil {
+		t.Fatal(err)
+	}
+
+	data, err := os.ReadFile(userConfig)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if got, want := strings.Count(string(data), sshIncludeStart), 1; got != want {
+		t.Fatalf("the SSH configuration carries %d include blocks, want %d", got, want)
+	}
+
+	if !strings.Contains(string(data), "Host example") {
+		t.Fatalf("EnsureSSHInclude() removed the user entries: %q", string(data))
+	}
+
+	next := filepath.Join(t.TempDir(), "config")
+	if err := os.MkdirAll(next, 0o700); err != nil {
+		t.Fatal(err)
+	}
+
+	paths.SetCurrent(paths.Set{
+		Config: paths.Location{Host: next, Access: next},
+		Data:   paths.Location{Host: folders.data, Access: folders.data},
+		SSH:    paths.Location{Host: folders.ssh, Access: folders.ssh},
+	})
+
+	if err := EnsureSSHInclude(); err != nil {
+		t.Fatal(err)
+	}
+
+	assertInclude(t, userConfig, filepath.Join(next, "ssh_config"))
+
+	data, err = os.ReadFile(userConfig)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if strings.Contains(string(data), filepath.Join(folders.config, "ssh_config")) {
+		t.Fatalf("EnsureSSHInclude() kept the old include: %q", string(data))
+	}
+}
+
+func TestRemoveSSHIncludeKeepsTheRest(t *testing.T) {
+	folders := useFolders(t)
+
+	userConfig := filepath.Join(folders.ssh, "config")
+	if err := os.WriteFile(userConfig, []byte("Host example\n    HostName example.test\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := EnsureSSHInclude(); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := RemoveSSHInclude(userConfig); err != nil {
+		t.Fatal(err)
+	}
+
+	data, err := os.ReadFile(userConfig)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if strings.Contains(string(data), sshIncludeStart) {
+		t.Fatalf("RemoveSSHInclude() kept the include: %q", string(data))
+	}
+
+	if !strings.Contains(string(data), "Host example") {
+		t.Fatalf("RemoveSSHInclude() removed the user entries: %q", string(data))
+	}
+}
+
+type testFolders struct {
+	config string
+	data   string
+	ssh    string
+}
+
+func useFolders(t *testing.T) testFolders {
+	t.Helper()
+
+	previous := paths.Current()
+	t.Cleanup(func() {
+		paths.SetCurrent(previous)
+	})
+
+	root := t.TempDir()
+
+	folders := testFolders{
+		config: filepath.Join(root, "config"),
+		data:   filepath.Join(root, "data"),
+		ssh:    filepath.Join(root, "ssh"),
+	}
+
+	for _, folder := range []string{folders.config, folders.data, folders.ssh} {
+		if err := os.MkdirAll(folder, 0o700); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	paths.SetCurrent(paths.Set{
+		Config: paths.Location{Host: folders.config, Access: folders.config},
+		Data:   paths.Location{Host: folders.data, Access: folders.data},
+		SSH:    paths.Location{Host: folders.ssh, Access: folders.ssh},
+	})
+
+	return folders
+}
+
+func assertInclude(t *testing.T, path, include string) {
+	t.Helper()
+
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if !strings.Contains(string(data), "Include "+include) {
+		t.Fatalf("the SSH configuration does not include %q: %q", include, string(data))
+	}
+}
