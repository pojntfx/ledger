-	CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o $(HOST_BINARY) .
+	CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o $(PHIALD_BINARY) ./cmd/phiald
 
 guest-agent:
 	CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o $(GUEST_AGENT) .
@@ -20,10 +22,10 @@ 	cd assets/resources && glib-compile-schemas .
 	cd assets/resources && glib-compile-resources index.gresource.xml
 
 install: build
-	./bin/phial install .
+	./bin/phial host-install --config "$(HOME)/.config/phial" --data "$(HOME)/.local/share/phial" --ssh "$(HOME)/.ssh"
 
 test:
-	go test ./internal/...
+	go test ./...
 
 acceptance: build
 	./bin/phial acceptance
@@ -45,4 +47,4 @@ 	flatpak-builder --disable-rofiles-fuse --force-clean --repo=flatpak/repo flatpak/build flatpak/com.pojtinger.felicitas.Phial.json
 	flatpak build-bundle flatpak/repo flatpak/phial.flatpak com.pojtinger.felicitas.Phial
 
 clean:
-	rm -rf bin/phial $(HOST_BINARY) $(GUEST_AGENT) flatpak/build flatpak/repo flatpak/phial.flatpak
+	rm -rf bin/phial $(PHIALD_BINARY) $(GUEST_AGENT) $(PHIALD) flatpak/build flatpak/repo flatpak/phial.flatpak
diff --git a/cmd/phiald/checked.go b/cmd/phiald/checked.go
new file mode 100644
index 0000000000000000000000000000000000000000..92c44906f0d7ec62d331c8a203b31743f6f5a67e
--- /dev/null
+++ b/cmd/phiald/checked.go
@@ -0,0 +1,28 @@
+package main
+
+import (
+	"fmt"
+
+	"codeberg.org/pojntfx/phial-neo/internal/machine"
+	"codeberg.org/pojntfx/phial-neo/internal/paths"
+)
+
+// loadChecked accepts only machine names that match the pattern and that
+// exist in the configuration.
+func loadChecked(name string) (machine.Definition, error) {
+	if err := checkMachineName(name); err != nil {
+		return machine.Definition{}, err
+	}
+
+	def, err := machine.Load(name)
+	if err != nil {
+		return machine.Definition{}, fmt.Errorf("no machine named %q in the configuration", name)
+	}
+
+	return def, nil
+}
+
+// SSHHostDir states the SSH folder of the host install.
+func SSHHostDir() string {
+	return paths.SSH().HostPath()
+}
diff --git a/cmd/phiald/display.go b/cmd/phiald/display.go
new file mode 100644
index 0000000000000000000000000000000000000000..851deccc340555f6049ae6d7c63ef36fdd7782b4
--- /dev/null
+++ b/cmd/phiald/display.go
@@ -0,0 +1,154 @@
+package main
+
+import (
+	"fmt"
+	"path/filepath"
+	"strings"
+
+	"codeberg.org/pojntfx/phial-neo/cmd/phiald/virt"
+	"codeberg.org/pojntfx/phial-neo/internal/host"
+	"codeberg.org/pojntfx/phial-neo/internal/machine"
+	"codeberg.org/pojntfx/phial-neo/internal/varlink"
+)
+
+// display answers the VMDisplay call. It states the display socket, the
+// desktop link, and the RDP password, and with ListApps or Run it operates
+// the fixed display workflow of one machine.
+func (s *service) display(in host.DisplayRequest) (*host.DisplayResponse, *varlink.Error) {
+	def, err := machine.Load(in.Name)
+	if err != nil {
+		return nil, invalidRequest(err)
+	}
+
+	response := &host.DisplayResponse{
+		Socket:      filepath.Join(machine.RuntimeDir(), "display", in.Name+".sock"),
+		RdpAddress:  def.RdpAddress(),
+		RdpURI:      def.RdpURI(),
+		RdpPassword: rdpPassword(),
+	}
+
+	if in.ListApps {
+		apps, err := listGuestApps(def)
+		if err != nil {
+			return nil, internalError(err)
+		}
+
+		response.Apps = apps
+
+		return response, nil
+	}
+
+	if in.Run != "" {
+		if err := s.runGuestApp(def, in.Run, in.Mode); err != nil {
+			return nil, internalError(err)
+		}
+
+		return response, nil
+	}
+
+	return response, nil
+}
+
+// guestAppsScript is the fixed script that reads the desktop files of the
+// guest. It runs over the guest agent channel, never through a shell of the
+// host.
+const guestAppsScript = "for dir in /usr/share/applications \"$HOME/.local/share/applications\"; do\n" +
+	"  [ -d \"$dir\" ] || continue\n" +
+	"  for file in \"$dir\"/*.desktop; do\n" +
+	"    [ -f \"$file\" ] || continue\n" +
+	"    grep -q '^Type=Application' \"$file\" 2>/dev/null || continue\n" +
+	"    grep -q '^NoDisplay=true' \"$file\" 2>/dev/null && continue\n" +
+	"    name=$(grep -m1 '^Name=' \"$file\" 2>/dev/null | cut -d= -f2-)\n" +
+	"    [ -n \"$name\" ] || continue\n" +
+	"    exec=$(grep -m1 '^Exec=' \"$file\" 2>/dev/null | cut -d= -f2-)\n" +
+	"    exec=$(printf '%s' \"$exec\" | sed 's/%[a-zA-Z]//g')\n" +
+	"    set -- $exec\n" +
+	"    if [ \"${1:-}\" = \"env\" ]; then\n" +
+	"      shift\n" +
+	"      while [ $# -gt 0 ] && printf '%s' \"$1\" | grep -q '='; do shift; done\n" +
+	"    fi\n" +
+	"    exec=\"${1:-}\"\n" +
+	"    [ -n \"$exec\" ] || continue\n" +
+	"    printf '%s\\t%s\\t%s\\n' \"$(basename \"$file\" .desktop)\" \"$name\" \"$exec\"\n" +
+	"  done\n" +
+	"done | sort -u -k2 | head -200"
+
+// listGuestApps reads the application list of the guest.
+func listGuestApps(def machine.Definition) ([]host.GuestApp, error) {
+	output, err := virt.SSHRun(nil, def.Name, guestAppsScript)
+	if err != nil {
+		return nil, fmt.Errorf("could not list guest apps: %w", err)
+	}
+
+	apps := []host.GuestApp{}
+
+	for _, line := range strings.Split(strings.TrimSpace(string(output)), "\n") {
+		parts := strings.Split(line, "\t")
+		if len(parts) != 3 {
+			continue
+		}
+
+		apps = append(apps, host.GuestApp{ID: parts[0], Name: parts[1], Exec: parts[2]})
+	}
+
+	return apps, nil
+}
+
+// runGuestApp starts one application in the guest. The display mode names the
+// destination: waypipe shows the window on the host, and session shows it in
+// the remote desktop of the guest.
+func (s *service) runGuestApp(def machine.Definition, command string, mode string) error {
+	if s.sup.stateOf(def.Name) != stateActive {
+		return fmt.Errorf("the machine %s does not run", def.Name)
+	}
+
+	// The guest agent starts the guest waypipe server, and the application
+	// runs its bundled waypipe client against the display socket.
+	if err := virt.SSHCommand(def.Name, "systemctl", "--user", "start", "phial-waypipe.service").Run(); err != nil {
+		return fmt.Errorf("could not start the guest waypipe server: %w", err)
+	}
+
+	if mode != "session" {
+		if err := s.sup.startWaypipe(def.Name); err != nil {
+			return fmt.Errorf("could not start the waypipe client: %w", err)
+		}
+	}
+
+	display := "waypipe"
+	if mode == "session" {
+		display = "wayland-0"
+	}
+
+	server := virt.SSHCommand(def.Name,
+		"G_APPLICATION_NON_UNIQUE=1",
+		"GDK_BACKEND=wayland",
+		"WAYLAND_DISPLAY="+display,
+		"XDG_SESSION_TYPE=wayland",
+		"XDG_RUNTIME_DIR=/run/user/1000",
+		command,
+	)
+
+	if err := server.Start(); err != nil {
+		return err
+	}
+
+	go func() {
+		_ = server.Wait()
+	}()
+
+	return nil
+}
+
+// rdpPassword reads the RDP password from the secret service of the host.
+// The service returns it to the application for display and copy.
+func rdpPassword() string {
+	lookup := toolCommand("secret-tool", "lookup", "service", "phial", "kind", "rdp-password")
+
+	if output, err := lookup.Output(); err == nil {
+		if password := strings.TrimSpace(string(output)); password != "" {
+			return password
+		}
+	}
+
+	return ""
+}
diff --git a/cmd/phiald/errors.go b/cmd/phiald/errors.go
new file mode 100644
index 0000000000000000000000000000000000000000..dc47c9372393e3f30180e86556dea745f8e3ff3d
--- /dev/null
+++ b/cmd/phiald/errors.go
@@ -0,0 +1,15 @@
+package main
+
+import (
+	"codeberg.org/pojntfx/phial-neo/internal/varlink"
+)
+
+// invalidRequest reports one input that the service rejects.
+func invalidRequest(err error) *varlink.Error {
+	return varlink.NewError("InvalidRequest", map[string]any{"error": err.Error()})
+}
+
+// internalError reports one failure of the service.
+func internalError(err error) *varlink.Error {
+	return varlink.NewError("InternalError", map[string]any{"error": err.Error()})
+}
diff --git a/cmd/phiald/guest/phial.ks b/cmd/phiald/guest/phial.ks
new file mode 100644
index 0000000000000000000000000000000000000000..e96753fd2e0069ccd9735f243ff368c23d35941a
--- /dev/null
+++ b/cmd/phiald/guest/phial.ks
@@ -0,0 +1,79 @@
+#version=F45
+text
+lang en_US.UTF-8
+keyboard us
+timezone Etc/UTC --utc
+network --hostname=phial --bootproto=dhcp --device=link --activate
+rootpw --lock
+user --name=phial --groups=wheel --lock --uid=1000 --gid=1000
+bootloader --append="console=tty0 console=ttyS0,115200n8"
+zerombr
+clearpart --all --initlabel
+part /boot/efi --fstype=efi --size=512 --ondisk=vda
+part /boot --fstype=ext4 --size=1024 --ondisk=vda
+part / --fstype=ext4 --size=10240 --grow --ondisk=vda
+firewall --enabled --ssh
+selinux --enforcing
+services --enabled=sshd,qemu-guest-agent
+firstboot --disabled
+reboot
+
+%packages
+@^workstation-product-environment
+qemu-guest-agent
+socat
+mokutil
+%end
+
+%post --log=/root/phial-post.log
+install -d -m 0700 -o phial -g phial /home/phial/.ssh
+cat > /home/phial/.ssh/authorized_keys <<'PHIALKEYS'
+@PHIAL_SSH_KEYS@
+PHIALKEYS
+curl -fsSL https://github.com/pojntfx.keys >> /home/phial/.ssh/authorized_keys || true
+chmod 0600 /home/phial/.ssh/authorized_keys
+chown phial:phial /home/phial/.ssh/authorized_keys
+restorecon -R /home/phial
+systemctl set-default graphical.target
+grubby --update-kernel=ALL --args="plymouth.enable=0"
+ln -sf /dev/null /etc/systemd/system/NetworkManager-wait-online.service
+ln -sf /dev/null /etc/systemd/system/plymouth-quit-wait.service
+printf '%%wheel ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/90-phial
+chmod 0440 /etc/sudoers.d/90-phial
+cat > /etc/systemd/system/phial-ssh-vsock.service <<'UNIT'
+[Unit]
+Description=phial SSH over vsock
+After=sshd.service
+Wants=sshd.service
+
+[Service]
+Type=simple
+ExecStart=/usr/bin/socat VSOCK-LISTEN:2222,fork,reuseaddr TCP:[::1]:22
+Restart=on-failure
+
+[Install]
+WantedBy=multi-user.target
+UNIT
+systemctl enable phial-ssh-vsock.service
+cat > /etc/systemd/system/phial-provision.path <<'UNIT'
+[Unit]
+Description=phial guest provisioning trigger
+
+[Path]
+PathExists=/run/phial/trigger
+Unit=phial-provision.service
+
+[Install]
+WantedBy=multi-user.target
+UNIT
+cat > /etc/systemd/system/phial-provision.service <<'UNIT'
+[Unit]
+Description=phial guest provisioning
+
+[Service]
+Type=oneshot
+ExecStart=/bin/bash /run/phial/provision.sh
+UNIT
+systemctl enable phial-provision.path
+loginctl enable-linger phial
+%end
diff --git a/cmd/phiald/inputs.go b/cmd/phiald/inputs.go
new file mode 100644
index 0000000000000000000000000000000000000000..a47fdfeead7821138b2a74c44aabbaf9b9c308d6
--- /dev/null
+++ b/cmd/phiald/inputs.go
@@ -0,0 +1,163 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+
+	"codeberg.org/pojntfx/phial-neo/internal/machine"
+)
+
+// The input rules of the service. Every value that arrives over the socket is
+// checked before the service uses it.
+const (
+	maxNameLength    = 128
+	maxCommentLength = 256
+	maxEmailLength   = 256
+	maxSecretLength  = 64 * 1024
+	maxSSHKeySize    = 256 * 1024
+	maxGPGKeySize    = 1024 * 1024
+)
+
+// pciPattern matches one PCI address such as 0000:00:14.0.
+var pciPattern = regexp.MustCompile(`^[0-9a-fA-F]{4}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}\.[0-7]$`)
+
+// devicePattern matches one USB vendor:product pair in hex.
+var devicePattern = regexp.MustCompile(`^[0-9a-fA-F]{4}:[0-9a-fA-F]{4}$`)
+
+// sysRoot states the sysfs root, so a test can point at a fixture.
+var sysRoot = "/sys"
+
+func sysPath(parts ...string) string {
+	return filepath.Join(append([]string{sysRoot}, parts...)...)
+}
+
+// checkMachineName accepts only machine names that match the pattern and that
+// exist in the configuration.
+func checkMachineName(name string) error {
+	if !machine.NamePattern.MatchString(name) {
+		return fmt.Errorf("the machine name %q must match %s", name, machine.NamePattern.String())
+	}
+
+	if _, err := machine.Load(name); err != nil {
+		return fmt.Errorf("no machine named %q in the configuration", name)
+	}
+
+	return nil
+}
+
+// checkFolder accepts only absolute existing folder paths. It resolves the
+// path and rejects the root directory.
+func checkFolder(path string) (string, error) {
+	if !filepath.IsAbs(path) {
+		return "", fmt.Errorf("the folder %q is not an absolute path", path)
+	}
+
+	resolved, err := filepath.EvalSymlinks(path)
+	if err != nil {
+		return "", fmt.Errorf("the folder %q does not resolve: %w", path, err)
+	}
+
+	if resolved == "/" {
+		return "", fmt.Errorf("the root directory is not a valid folder")
+	}
+
+	info, err := os.Stat(resolved)
+	if err != nil {
+		return "", fmt.Errorf("the folder %q does not exist: %w", resolved, err)
+	}
+
+	if !info.IsDir() {
+		return "", fmt.Errorf("%q is not a folder", resolved)
+	}
+
+	return resolved, nil
+}
+
+// checkUSBDevice makes sure that the USB vendor and product values exist in
+// /sys.
+func checkUSBDevice(device string) error {
+	if !devicePattern.MatchString(device) {
+		return fmt.Errorf("the USB device %q must be vendor:product in hex", device)
+	}
+
+	vendor, product, _ := strings.Cut(device, ":")
+
+	if !usbDevicePresent(vendor, product) {
+		return fmt.Errorf("the USB device %s is not present on the host", device)
+	}
+
+	return nil
+}
+
+// usbDevicePresent makes sure that one vendor and product pair exists in
+// /sys.
+func usbDevicePresent(vendor, product string) bool {
+	matches, _ := filepath.Glob(sysPath("bus", "usb", "devices", "*", "idVendor"))
+
+	for _, vendorFile := range matches {
+		data, err := os.ReadFile(vendorFile)
+		if err != nil || strings.TrimSpace(string(data)) != vendor {
+			continue
+		}
+
+		productFile := filepath.Join(filepath.Dir(vendorFile), "idProduct")
+		if data, err := os.ReadFile(productFile); err == nil && strings.TrimSpace(string(data)) == product {
+			return true
+		}
+	}
+
+	return false
+}
+
+// checkPCIAddress makes sure that the address matches the PCI pattern and
+// that the address is an xHCI controller.
+func checkPCIAddress(address string) error {
+	if !pciPattern.MatchString(address) {
+		return fmt.Errorf("the PCI address %q does not match the PCI pattern", address)
+	}
+
+	class, err := os.ReadFile(sysPath("bus", "pci", "devices", address, "class"))
+	if err != nil {
+		return fmt.Errorf("no PCI device %s on this host", address)
+	}
+
+	if strings.TrimSpace(string(class)) != "0x0c0330" {
+		return fmt.Errorf("the PCI device %s is not an xHCI controller", address)
+	}
+
+	return nil
+}
+
+// checkComment limits the length of a comment, a name, or an email.
+func checkComment(value string) error {
+	if len(value) > maxCommentLength {
+		return fmt.Errorf("the value is longer than %d characters", maxCommentLength)
+	}
+
+	return nil
+}
+
+// checkSecretValue limits the size of a secret value.
+func checkSecretValue(value string) error {
+	if len(value) > maxSecretLength {
+		return fmt.Errorf("the secret value is larger than %d bytes", maxSecretLength)
+	}
+
+	return nil
+}
+
+// checkKeySize limits the size of a key file.
+func checkKeySize(size int, limit int) error {
+	if size == 0 {
+		return fmt.Errorf("the key content is empty")
+	}
+
+	if size > limit {
+		return fmt.Errorf("the key content is larger than %d bytes", limit)
+	}
+
+	return nil
+}
diff --git a/cmd/phiald/inputs_test.go b/cmd/phiald/inputs_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..eaa0d3fda51cc253d457e7e52a0ac6a58cd83094
--- /dev/null
+++ b/cmd/phiald/inputs_test.go
@@ -0,0 +1,176 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"codeberg.org/pojntfx/phial-neo/internal/machine"
+)
+
+func TestCheckFolderRejectsBadPaths(t *testing.T) {
+	if _, err := checkFolder("relative/path"); err == nil {
+		t.Fatal("a relative path passed")
+	}
+
+	if _, err := checkFolder("/"); err == nil {
+		t.Fatal("the root directory passed")
+	}
+
+	if _, err := checkFolder("/nonexistent-phial-folder"); err == nil {
+		t.Fatal("a nonexistent path passed")
+	}
+
+	dir := t.TempDir()
+	file := filepath.Join(dir, "file")
+	if err := os.WriteFile(file, []byte("x"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	if _, err := checkFolder(file); err == nil {
+		t.Fatal("a file passed as a folder")
+	}
+
+	resolved, err := checkFolder(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if resolved != dir {
+		t.Fatalf("checkFolder() = %q, want %q", resolved, dir)
+	}
+}
+
+func TestCheckFolderRejectsTheRootSymlink(t *testing.T) {
+	dir := t.TempDir()
+	link := filepath.Join(dir, "root")
+	if err := os.Symlink("/", link); err != nil {
+		t.Skip("cannot make a symlink")
+	}
+
+	if _, err := checkFolder(link); err == nil {
+		t.Fatal("a symlink to root passed")
+	}
+}
+
+func TestCheckUSBDeviceRejectsMalformed(t *testing.T) {
+	for _, device := range []string{"", "nope", "123", "12345:6789", "1234:6789:extra", "zzzz:zzzz", "1234:67890"} {
+		if err := checkUSBDevice(device); err == nil {
+			t.Fatalf("the malformed USB device %q passed", device)
+		}
+	}
+}
+
+func TestCheckUSBDeviceRequiresPresence(t *testing.T) {
+	fixture := t.TempDir()
+	old := sysRoot
+	sysRoot = fixture
+	defer func() { sysRoot = old }()
+
+	if err := checkUSBDevice("0403:6001"); err == nil {
+		t.Fatal("an absent USB device passed")
+	}
+
+	dev := filepath.Join(fixture, "bus", "usb", "devices", "1-1")
+	if err := os.MkdirAll(dev, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dev, "idVendor"), []byte("0403"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dev, "idProduct"), []byte("6001"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := checkUSBDevice("0403:6001"); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestCheckPCIAddressRejectsMalformed(t *testing.T) {
+	for _, address := range []string{"", "not-a-pci", "0000:00:14", "0000:00:14.9", "00000:00:14.0", "gggg:gg:gg.g", "0000:00:14.0/extra"} {
+		if err := checkPCIAddress(address); err == nil {
+			t.Fatalf("the malformed PCI address %q passed", address)
+		}
+	}
+}
+
+func TestCheckPCIAddressRequiresXhci(t *testing.T) {
+	fixture := t.TempDir()
+	old := sysRoot
+	sysRoot = fixture
+	defer func() { sysRoot = old }()
+
+	dev := filepath.Join(fixture, "bus", "pci", "devices", "0000:00:14.0")
+	if err := os.MkdirAll(dev, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dev, "class"), []byte("0x060000"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := checkPCIAddress("0000:00:14.0"); err == nil {
+		t.Fatal("a non-xHCI controller passed")
+	}
+
+	if err := os.WriteFile(filepath.Join(dev, "class"), []byte("0x0c0330"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := checkPCIAddress("0000:00:14.0"); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := checkPCIAddress("0000:00:15.0"); err == nil {
+		t.Fatal("an absent PCI device passed")
+	}
+}
+
+func TestCheckCommentLimitsLength(t *testing.T) {
+	if err := checkComment(strings.Repeat("a", maxCommentLength)); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := checkComment(strings.Repeat("a", maxCommentLength+1)); err == nil {
+		t.Fatal("an over-long comment passed")
+	}
+}
+
+func TestCheckSecretValueLimitsSize(t *testing.T) {
+	if err := checkSecretValue(strings.Repeat("a", maxSecretLength)); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := checkSecretValue(strings.Repeat("a", maxSecretLength+1)); err == nil {
+		t.Fatal("an over-large secret passed")
+	}
+}
+
+func TestCheckKeySizeLimitsSize(t *testing.T) {
+	if err := checkKeySize(1, maxSSHKey); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := checkKeySize(0, maxSSHKey); err == nil {
+		t.Fatal("an empty key passed")
+	}
+
+	if err := checkKeySize(maxSSHKey+1, maxSSHKey); err == nil {
+		t.Fatal("an over-large key passed")
+	}
+}
+
+func TestNamePatternRejectsMaliciousNames(t *testing.T) {
+	for _, name := range []string{"", "../etc/passwd", "machine name", "machine;rm", "UPPER", "machine/slash", "..", "machine\\back"} {
+		if !machine.NamePattern.MatchString(name) {
+			continue
+		}
+
+		t.Fatalf("the malicious name %q passed the pattern", name)
+	}
+
+	if !machine.NamePattern.MatchString("valid-name") {
+		t.Fatal("a valid name failed the pattern")
+	}
+}
diff --git a/cmd/phiald/main.go b/cmd/phiald/main.go
new file mode 100644
index 0000000000000000000000000000000000000000..f84f612723738ccc8912bd04c1fe83ca4a6f3b38
--- /dev/null
+++ b/cmd/phiald/main.go
@@ -0,0 +1,115 @@
+// phiald is the host service of Phial. It runs the machines and the host
+// operations, and the application talks to it over a private varlink socket.
+package main
+
+import (
+	"fmt"
+	"log/slog"
+	"os"
+
+	"codeberg.org/pojntfx/phial-neo/cmd/phiald/virt"
+	"codeberg.org/pojntfx/phial-neo/internal/machine"
+	"codeberg.org/pojntfx/phial-neo/internal/paths"
+	"codeberg.org/pojntfx/phial-neo/internal/version"
+)
+
+const usage = `phiald: the host service of Phial
+
+Usage:
+  phiald                  serve the varlink socket (socket activated by systemd)
+  phiald root-setup       apply the fixed one-time host setup, as root via run0
+  phiald vfio-bind <pci>  bind one xHCI controller to vfio-pci, as root via run0
+  phiald vfio-restore <pci>  restore one xHCI controller, as root via run0
+  phiald --version        print the version
+`
+
+func main() {
+	log := slog.New(slog.NewTextHandler(os.Stderr, &slog.HandlerOptions{Level: slog.LevelInfo}))
+
+	args := os.Args[1:]
+
+	if len(args) == 0 {
+		fail(serve(log))
+
+		return
+	}
+
+	switch args[0] {
+	case "--help", "-help", "-h", "help":
+		fmt.Print(usage)
+	case "--version", "-version", "version":
+		fmt.Println(version.App)
+	case "root-setup":
+		fail(rootSetup(args[1:]))
+	case "vfio-bind":
+		fail(vfioBind(args[1:]))
+	case "vfio-restore":
+		fail(vfioRestore(args[1:]))
+	default:
+		fmt.Fprintln(os.Stderr, "unknown command: "+args[0])
+		fmt.Fprint(os.Stderr, usage)
+		os.Exit(1)
+	}
+}
+
+func fail(err error) {
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+// rootSetup applies the fixed one-time host setup. The service runs this
+// subcommand through run0, and the user approves the call with polkit.
+func rootSetup(args []string) error {
+	devices := []string{}
+	seen := map[string]bool{}
+
+	if defs, err := machine.List(); err == nil {
+		for _, def := range defs {
+			for _, device := range def.USBDevices {
+				if seen[device] {
+					continue
+				}
+
+				seen[device] = true
+				devices = append(devices, device)
+			}
+		}
+	}
+
+	if len(devices) == 0 {
+		devices = machine.Defaults("phial").USBDevices
+	}
+
+	return RootSetup(RootSetupOptions{
+		Ethernet:   FirstEthernet(),
+		USBDevices: devices,
+	})
+}
+
+// vfioBind binds one xHCI controller to vfio-pci. The PCI address is the only
+// argument, and the service checks it before the run0 call.
+func vfioBind(args []string) error {
+	if len(args) != 1 {
+		return fmt.Errorf("usage: phiald vfio-bind <pci address>")
+	}
+
+	return virt.VfioBind(args[0])
+}
+
+// vfioRestore gives one xHCI controller back to its host driver.
+func vfioRestore(args []string) error {
+	if len(args) != 1 {
+		return fmt.Errorf("usage: phiald vfio-restore <pci address>")
+	}
+
+	return virt.VfioRestore(args[0])
+}
+
+// loadFolders points the service at the folders that the install recorded.
+// The locations file names the chosen configuration folder, and the service
+// reads the machine definitions from there.
+func loadFolders() error {
+	return paths.LoadHostFile()
+}
diff --git a/cmd/phiald/main_test.go b/cmd/phiald/main_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..24dc0a43076ad705aee0c774b7112c9ad1d2289e
--- /dev/null
+++ b/cmd/phiald/main_test.go
@@ -0,0 +1,70 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// TestRun0ForwardsOnlyFixedSubcommands makes sure that run0 forwards only the
+// fixed subcommand and its single argument. The service never passes an
+// application string to run0.
+func TestRun0ForwardsOnlyFixedSubcommands(t *testing.T) {
+	dir := t.TempDir()
+	log := filepath.Join(dir, "run0.log")
+
+	// A stub run0 records the arguments it receives.
+	stub := filepath.Join(dir, "run0")
+	script := "#!/bin/sh\nprintf '%s\\n' \"$@\" > " + log + "\n"
+	if err := os.WriteFile(stub, []byte(script), 0o755); err != nil {
+		t.Fatal(err)
+	}
+
+	oldPath := os.Getenv("PATH")
+	os.Setenv("PATH", dir+":"+oldPath)
+	defer os.Setenv("PATH", oldPath)
+
+	if _, err := run0("vfio-bind", "0000:00:14.0"); err != nil {
+		t.Fatal(err)
+	}
+
+	data, err := os.ReadFile(log)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	got := string(data)
+	if !contains(got, "vfio-bind") || !contains(got, "0000:00:14.0") {
+		t.Fatalf("run0 received %q, want the fixed subcommand and its address", got)
+	}
+}
+
+// TestVfioSubcommandsAcceptOneAddress makes sure that the vfio subcommands
+// take exactly one PCI address.
+func TestVfioSubcommandsAcceptOneAddress(t *testing.T) {
+	if err := vfioBind(nil); err == nil {
+		t.Fatal("vfio-bind with no address passed")
+	}
+
+	if err := vfioBind([]string{"a", "b"}); err == nil {
+		t.Fatal("vfio-bind with two addresses passed")
+	}
+
+	if err := vfioRestore(nil); err == nil {
+		t.Fatal("vfio-restore with no address passed")
+	}
+
+	if err := vfioRestore([]string{"a", "b"}); err == nil {
+		t.Fatal("vfio-restore with two addresses passed")
+	}
+}
+
+func contains(haystack, needle string) bool {
+	for i := 0; i+len(needle) <= len(haystack); i++ {
+		if haystack[i:i+len(needle)] == needle {
+			return true
+		}
+	}
+
+	return false
+}
diff --git a/cmd/phiald/secrets.go b/cmd/phiald/secrets.go
new file mode 100644
index 0000000000000000000000000000000000000000..e051fe1c46c69198dc6d97a11d67475e6fdfd2ba
--- /dev/null
+++ b/cmd/phiald/secrets.go
@@ -0,0 +1,222 @@
+package main
+
+import (
+	"encoding/base64"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"codeberg.org/pojntfx/phial-neo/internal/host"
+	"codeberg.org/pojntfx/phial-neo/internal/state"
+	"codeberg.org/pojntfx/phial-neo/internal/varlink"
+)
+
+// The input limits of the service: the application never sends a file path
+// for a key, and the service limits the size of every value it receives.
+const (
+	maxSecretValue = 64 * 1024
+	maxSSHKey      = 256 * 1024
+	maxGPGKey      = 1024 * 1024
+	maxComment     = 256
+	maxEmail       = 256
+)
+
+// secretList answers the SecretList call: the rows of the mapping, and
+// whether the Secret Service holds a value for each one.
+func (s *service) secretList() (*host.SecretListResponse, *varlink.Error) {
+	rows, err := s.state.Rows()
+	if err != nil {
+		return nil, internalError(err)
+	}
+
+	response := &host.SecretListResponse{}
+
+	for _, row := range rows {
+		response.Secrets = append(response.Secrets, host.SecretInfo{
+			Name:     row.Name,
+			Mode:     row.Mode,
+			Upstream: row.Upstream,
+			Stored:   s.state.HasSecret(row),
+		})
+	}
+
+	return response, nil
+}
+
+// secretSet stores one secret. The service accepts only names that match the
+// variable name pattern, and the value never leaves the host.
+func (s *service) secretSet(in host.SecretSetRequest) error {
+	if len(in.Value) > maxSecretValue {
+		return fmt.Errorf("the secret value is larger than %d bytes", maxSecretValue)
+	}
+
+	row := state.Row{
+		Name:     in.Name,
+		Mode:     in.Mode,
+		Source:   "secret://" + in.Name,
+		Upstream: in.Upstream,
+	}
+
+	if err := s.state.SetSecret(row, in.Value); err != nil {
+		return err
+	}
+
+	return nil
+}
+
+// secretRemove removes one secret and every grant on it.
+func (s *service) secretRemove(name string) error {
+	return s.state.RemoveSecret(name)
+}
+
+// sshKeyList answers the SSHKeyList call with the keys of the session agent.
+func (s *service) sshKeyList() (*host.SSHKeyListResponse, *varlink.Error) {
+	keys, err := s.state.ListSSHKeys()
+	if err != nil {
+		return nil, internalError(err)
+	}
+
+	response := &host.SSHKeyListResponse{}
+
+	for _, key := range keys {
+		response.Keys = append(response.Keys, host.SSHKey{
+			Comment:     key.Comment,
+			Fingerprint: key.Fingerprint,
+			Type:        key.Type,
+		})
+	}
+
+	return response, nil
+}
+
+// sshKeyImport loads the content of one private key into the agent of the
+// session. The service writes the key into the managed SSH folder and loads
+// it from there.
+func (s *service) sshKeyImport(in host.SSHKeyImportRequest) error {
+	content, err := base64.StdEncoding.DecodeString(in.ContentBase64)
+	if err != nil {
+		return err
+	}
+
+	if len(content) == 0 || len(content) > maxSSHKey {
+		return fmt.Errorf("the key file must carry between 1 and %d bytes", maxSSHKey)
+	}
+
+	name := in.Name
+	if name == "" {
+		name = "imported-key"
+	}
+
+	safe := strings.Map(func(r rune) rune {
+		if r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r >= '0' && r <= '9' || r == '-' || r == '_' || r == '.' {
+			return r
+		}
+
+		return '_'
+	}, name)
+
+	sshDir := SSHHostDir()
+	if sshDir == "" {
+		return fmt.Errorf("the SSH folder is not configured")
+	}
+
+	path := filepath.Join(sshDir, "phial_"+safe)
+
+	if err := os.WriteFile(path, content, 0o600); err != nil {
+		return err
+	}
+
+	return s.state.AddSSHKey(path)
+}
+
+// sshKeyGenerate makes a new key pair in the managed SSH folder and loads it
+// into the agent.
+func (s *service) sshKeyGenerate(comment string) error {
+	if len(comment) > maxComment {
+		return fmt.Errorf("the comment is longer than %d characters", maxComment)
+	}
+
+	return s.state.GenerateSSHKey(comment)
+}
+
+// sshKeyRemove drops one key from the agent of the session.
+func (s *service) sshKeyRemove(comment string) error {
+	return s.state.RemoveSSHKey(comment)
+}
+
+// gpgKeyList answers the GPGKeyList call with the secret keys of the host.
+func (s *service) gpgKeyList() (*host.GPGKeyListResponse, *varlink.Error) {
+	keys, err := s.state.ListGPGKeys()
+	if err != nil {
+		return nil, internalError(err)
+	}
+
+	response := &host.GPGKeyListResponse{}
+
+	for _, key := range keys {
+		response.Keys = append(response.Keys, host.GPGKey{
+			Fingerprint: key.Fingerprint,
+			Keygrip:     key.Keygrip,
+			UID:         key.UID,
+			Expires:     key.Expires,
+		})
+	}
+
+	return response, nil
+}
+
+// gpgKeyImport writes the content of one key file to a private temporary
+// file, imports it with a fixed gpg --import call, and removes the file after
+// the import.
+func (s *service) gpgKeyImport(contentBase64 string) error {
+	content, err := base64.StdEncoding.DecodeString(contentBase64)
+	if err != nil {
+		return err
+	}
+
+	if len(content) == 0 || len(content) > maxGPGKey {
+		return fmt.Errorf("the key file must carry between 1 and %d bytes", maxGPGKey)
+	}
+
+	file, err := os.CreateTemp("", "phial-gpg-import-")
+	if err != nil {
+		return err
+	}
+
+	path := file.Name()
+
+	defer os.Remove(path)
+
+	if err := file.Chmod(0o600); err != nil {
+		file.Close()
+
+		return err
+	}
+
+	if _, err := file.Write(content); err != nil {
+		file.Close()
+
+		return err
+	}
+
+	if err := file.Close(); err != nil {
+		return err
+	}
+
+	return s.state.AddGPGKey(path)
+}
+
+// gpgKeyGenerate makes a new secret key on the host.
+func (s *service) gpgKeyGenerate(name, email string) error {
+	if len(name) > maxComment || len(email) > maxEmail {
+		return fmt.Errorf("the name or the email is too long")
+	}
+
+	return s.state.GenerateGPGKey(name, email)
+}
+
+// gpgKeyRemove deletes the secret part of one key.
+func (s *service) gpgKeyRemove(fingerprint string) error {
+	return s.state.RemoveGPGKey(fingerprint)
+}
diff --git a/cmd/phiald/service.go b/cmd/phiald/service.go
new file mode 100644
index 0000000000000000000000000000000000000000..716a8b5174e614d21e1449e6c53949dc61ec6c68
--- /dev/null
+++ b/cmd/phiald/service.go
@@ -0,0 +1,476 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"log/slog"
+	"net"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"codeberg.org/pojntfx/phial-neo/cmd/phiald/virt"
+	"codeberg.org/pojntfx/phial-neo/internal/host"
+	"codeberg.org/pojntfx/phial-neo/internal/machine"
+	"codeberg.org/pojntfx/phial-neo/internal/paths"
+	"codeberg.org/pojntfx/phial-neo/internal/state"
+	"codeberg.org/pojntfx/phial-neo/internal/varlink"
+	"codeberg.org/pojntfx/phial-neo/internal/version"
+)
+
+// service answers the varlink calls of the application. The interface is
+// private, and any other client receives an error and the connection closes.
+type service struct {
+	log   *slog.Logger
+	sup   *supervisor
+	state *state.Client
+}
+
+func newService(log *slog.Logger, state *state.Client, sup *supervisor) *service {
+	return &service{log: log, sup: sup, state: state}
+}
+
+// serve starts the host service: the gate, the grant sweeper, the varlink
+// socket, and the machines that the configuration marks.
+func serve(log *slog.Logger) error {
+	if err := loadFolders(); err != nil {
+		log.Warn("could not read the locations file", "err", err)
+	}
+
+	if err := refreshSSHConfig(); err != nil {
+		log.Warn("could not write the SSH configuration", "err", err)
+	}
+
+	stateClient := state.NewClient(log)
+	sup := newSupervisor(log)
+	svc := newService(log, stateClient, sup)
+
+	// The gate serves the SSH agent, the GnuPG channel, and the secret proxy
+	// of the guests. The host service owns it.
+	go func() {
+		if err := stateClient.ServeGate(); err != nil {
+			log.Error("the gate stopped", "err", err)
+		}
+	}()
+
+	// The sweeper closes the grants whose time ran out and writes the env
+	// files of the open secret grants. The expiry timer runs on the host, so
+	// a grant ends after Phial closes.
+	go func() {
+		for {
+			stateClient.SweepGrants()
+
+			time.Sleep(5 * time.Second)
+		}
+	}()
+
+	listener, ok, err := varlink.ActivationListener()
+	if err != nil {
+		return err
+	}
+
+	if !ok {
+		listener, err = varlink.ListenUnix(host.SocketPath())
+		if err != nil {
+			return err
+		}
+	}
+
+	server := varlink.NewServer(log, svc.handle, func(conn *net.UnixConn) error {
+		return varlink.CheckPeer(conn, varlink.PeerPolicy{AppID: version.AppID})
+	})
+
+	// The machine autostart configuration is per machine.
+	go sup.startMarked(context.Background())
+
+	log.Info("serving the control socket", "socket", host.SocketPath())
+
+	return server.Serve(listener)
+}
+
+// handle answers one call by name.
+func (s *service) handle(ctx context.Context, method string, parameters json.RawMessage) (any, *varlink.Error) {
+	decode := func(out any) *varlink.Error {
+		if len(parameters) == 0 {
+			return nil
+		}
+
+		if err := json.Unmarshal(parameters, out); err != nil {
+			return varlink.NewError("InvalidRequest", map[string]any{"error": err.Error()})
+		}
+
+		return nil
+	}
+
+	invalid := func(err error) *varlink.Error {
+		return varlink.NewError("InvalidRequest", map[string]any{"error": err.Error()})
+	}
+
+	failure := func(err error) *varlink.Error {
+		return varlink.NewError("InternalError", map[string]any{"error": err.Error()})
+	}
+
+	switch method {
+	case "Info":
+		return &host.InfoResponse{
+			Version:  version.App,
+			Protocol: varlink.ProtocolVersion,
+			Features: []string{"machines", "secrets", "keys", "usb", "display", "root-setup"},
+		}, nil
+
+	case "Status":
+		return s.status()
+
+	case "Acceptance":
+		return s.acceptance()
+
+	case "Folders":
+		var in host.FoldersRequest
+		if err := decode(&in); err != nil {
+			return nil, err
+		}
+
+		if err := s.setFolders(in.Config, in.Data, in.SSH); err != nil {
+			return nil, invalid(err)
+		}
+
+		return &host.StateResponse{State: "set"}, nil
+
+	case "VMList":
+		return s.vmList()
+
+	case "VMStart":
+		var in host.NameRequest
+		if err := decode(&in); err != nil {
+			return nil, err
+		}
+
+		if err := checkMachineName(in.Name); err != nil {
+			return nil, invalid(err)
+		}
+
+		if err := s.sup.start(ctx, in.Name); err != nil {
+			return nil, failure(err)
+		}
+
+		return &host.StateResponse{State: "active"}, nil
+
+	case "VMStop":
+		var in host.NameRequest
+		if err := decode(&in); err != nil {
+			return nil, err
+		}
+
+		if err := checkMachineName(in.Name); err != nil {
+			return nil, invalid(err)
+		}
+
+		// A machine that still installs cancels the install.
+		if s.sup.installing(in.Name) {
+			virt.CancelInstall(in.Name)
+
+			return &host.StateResponse{State: "cancelling"}, nil
+		}
+
+		if err := s.sup.stop(in.Name); err != nil {
+			return nil, failure(err)
+		}
+
+		return &host.StateResponse{State: "inactive"}, nil
+
+	case "VMRestart":
+		var in host.NameRequest
+		if err := decode(&in); err != nil {
+			return nil, err
+		}
+
+		if err := checkMachineName(in.Name); err != nil {
+			return nil, invalid(err)
+		}
+
+		if err := s.sup.restart(ctx, in.Name); err != nil {
+			return nil, failure(err)
+		}
+
+		return &host.StateResponse{State: "active"}, nil
+
+	case "VMProvision":
+		var in host.NameRequest
+		if err := decode(&in); err != nil {
+			return nil, err
+		}
+
+		if err := checkMachineName(in.Name); err != nil {
+			return nil, invalid(err)
+		}
+
+		return s.provision(ctx, in.Name)
+
+	case "VMLog":
+		var in host.NameRequest
+		if err := decode(&in); err != nil {
+			return nil, err
+		}
+
+		if err := checkMachineName(in.Name); err != nil {
+			return nil, invalid(err)
+		}
+
+		return &host.LogResponse{Log: machineLog(in.Name)}, nil
+
+	case "VMMetrics":
+		var in host.NameRequest
+		if err := decode(&in); err != nil {
+			return nil, err
+		}
+
+		if err := checkMachineName(in.Name); err != nil {
+			return nil, invalid(err)
+		}
+
+		return s.metrics(in.Name)
+
+	case "VMDisplay":
+		var in host.DisplayRequest
+		if err := decode(&in); err != nil {
+			return nil, err
+		}
+
+		if err := checkMachineName(in.Name); err != nil {
+			return nil, invalid(err)
+		}
+
+		return s.display(in)
+
+	case "SSHKeyList":
+		return s.sshKeyList()
+
+	case "SSHKeyImport":
+		var in host.SSHKeyImportRequest
+		if err := decode(&in); err != nil {
+			return nil, err
+		}
+
+		if err := s.sshKeyImport(in); err != nil {
+			return nil, invalid(err)
+		}
+
+		return &host.StateResponse{State: "imported"}, nil
+
+	case "SSHKeyGenerate":
+		var in host.SSHKeyGenerateRequest
+		if err := decode(&in); err != nil {
+			return nil, err
+		}
+
+		if err := s.sshKeyGenerate(in.Comment); err != nil {
+			return nil, invalid(err)
+		}
+
+		return &host.StateResponse{State: "generated"}, nil
+
+	case "SSHKeyRemove":
+		var in host.NameRequest
+		if err := decode(&in); err != nil {
+			return nil, err
+		}
+
+		if err := s.sshKeyRemove(in.Name); err != nil {
+			return nil, invalid(err)
+		}
+
+		return &host.StateResponse{State: "removed"}, nil
+
+	case "GPGKeyList":
+		return s.gpgKeyList()
+
+	case "GPGKeyImport":
+		var in host.GPGKeyImportRequest
+		if err := decode(&in); err != nil {
+			return nil, err
+		}
+
+		if err := s.gpgKeyImport(in.ContentBase64); err != nil {
+			return nil, invalid(err)
+		}
+
+		return &host.StateResponse{State: "imported"}, nil
+
+	case "GPGKeyGenerate":
+		var in host.GPGKeyGenerateRequest
+		if err := decode(&in); err != nil {
+			return nil, err
+		}
+
+		if err := s.gpgKeyGenerate(in.Name, in.Email); err != nil {
+			return nil, invalid(err)
+		}
+
+		return &host.StateResponse{State: "generated"}, nil
+
+	case "GPGKeyRemove":
+		var in host.FingerprintRequest
+		if err := decode(&in); err != nil {
+			return nil, err
+		}
+
+		if err := s.gpgKeyRemove(in.Fingerprint); err != nil {
+			return nil, invalid(err)
+		}
+
+		return &host.StateResponse{State: "removed"}, nil
+
+	case "SecretList":
+		return s.secretList()
+
+	case "SecretSet":
+		var in host.SecretSetRequest
+		if err := decode(&in); err != nil {
+			return nil, err
+		}
+
+		if err := s.secretSet(in); err != nil {
+			return nil, invalid(err)
+		}
+
+		return &host.StateResponse{State: "stored"}, nil
+
+	case "SecretRemove":
+		var in host.NameRequest
+		if err := decode(&in); err != nil {
+			return nil, err
+		}
+
+		if err := s.secretRemove(in.Name); err != nil {
+			return nil, invalid(err)
+		}
+
+		return &host.StateResponse{State: "removed"}, nil
+
+	case "USBList":
+		return s.usbList()
+
+	case "USBAttach":
+		var in host.USBDeviceRequest
+		if err := decode(&in); err != nil {
+			return nil, err
+		}
+
+		if err := s.usbAttach(in.Machine, in.Device); err != nil {
+			return nil, invalid(err)
+		}
+
+		return &host.StateResponse{State: "attached"}, nil
+
+	case "USBDetach":
+		var in host.USBDeviceRequest
+		if err := decode(&in); err != nil {
+			return nil, err
+		}
+
+		if err := s.usbDetach(in.Machine, in.Device); err != nil {
+			return nil, invalid(err)
+		}
+
+		return &host.StateResponse{State: "detached"}, nil
+
+	case "USBVfioBind":
+		var in host.VfioRequest
+		if err := decode(&in); err != nil {
+			return nil, err
+		}
+
+		if err := s.vfioBind(in.Address); err != nil {
+			return nil, invalid(err)
+		}
+
+		return &host.StateResponse{State: "bound"}, nil
+
+	case "USBVfioRestore":
+		var in host.VfioRequest
+		if err := decode(&in); err != nil {
+			return nil, err
+		}
+
+		if err := s.vfioRestore(in.Address); err != nil {
+			return nil, invalid(err)
+		}
+
+		return &host.StateResponse{State: "restored"}, nil
+
+	case "RootSetup":
+		output, err := run0("root-setup")
+		if err != nil {
+			return nil, failure(fmt.Errorf("root setup: %s: %w", output, err))
+		}
+
+		return &host.StateResponse{State: "applied"}, nil
+	}
+
+	return nil, varlink.NewError("UnknownMethod", map[string]any{"method": method})
+}
+
+// setFolders writes the chosen folders to the locations file, so that the
+// service reads the same folders on its next start.
+func (s *service) setFolders(config, data, ssh string) error {
+	resolved := map[string]string{}
+
+	for name, value := range map[string]string{"config": config, "data": data, "ssh": ssh} {
+		path, err := checkFolder(value)
+		if err != nil {
+			return fmt.Errorf("%s folder: %w", name, err)
+		}
+
+		resolved[name] = path
+	}
+
+	previous := paths.Current()
+
+	set := paths.Current()
+	set.Config = paths.Location{Host: resolved["config"], Access: resolved["config"]}
+	set.Data = paths.Location{Host: resolved["data"], Access: resolved["data"]}
+	set.SSH = paths.Location{Host: resolved["ssh"], Access: resolved["ssh"]}
+
+	paths.SetCurrent(set)
+	s.state.Reload()
+
+	if previous.SSH.HostPath() != "" && previous.SSH.HostPath() != resolved["ssh"] {
+		_ = machine.RemoveSSHInclude(filepath.Join(previous.SSH.HostPath(), "config"))
+	}
+
+	if err := paths.SaveHostFile(set); err != nil {
+		return err
+	}
+
+	return refreshSSHConfig()
+}
+
+func refreshSSHConfig() error {
+	if err := machine.WriteSSHConfig(); err != nil {
+		return err
+	}
+
+	return machine.EnsureSSHInclude()
+}
+
+// run0 runs one fixed subcommand of the service with polkit approval. The
+// service never passes an application string to run0, and the only arguments
+// it forwards are the fixed subcommand and its single argument.
+func run0(args ...string) (string, error) {
+	self, err := os.Executable()
+	if err != nil {
+		return "", err
+	}
+
+	// run0 starts the command from the system manager, which an SELinux host
+	// denies the execute permission on a binary in the home folder, so a
+	// shell starts the binary.
+	command := exec.Command("run0", append([]string{"/bin/sh", "-c", `exec "$0" "$@"`, self}, args...)...)
+
+	output, err := command.CombinedOutput()
+
+	return strings.TrimSpace(string(output)), err
+}
diff --git a/cmd/phiald/status.go b/cmd/phiald/status.go
new file mode 100644
index 0000000000000000000000000000000000000000..ef2251e928ca2b97209afbbc317767d75c46f0b6
--- /dev/null
+++ b/cmd/phiald/status.go
@@ -0,0 +1,372 @@
+package main
+
+import (
+	"context"
+	_ "embed"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"codeberg.org/pojntfx/phial-neo/cmd/phiald/guest"
+	"codeberg.org/pojntfx/phial-neo/cmd/phiald/virt"
+	"codeberg.org/pojntfx/phial-neo/internal/host"
+	"codeberg.org/pojntfx/phial-neo/internal/machine"
+	"codeberg.org/pojntfx/phial-neo/internal/setup"
+	"codeberg.org/pojntfx/phial-neo/internal/varlink"
+)
+
+// status answers the Status call: the machine states, the root setup state,
+// and the tool state. The install and Status report the host QEMU and the
+// Flatpak tools separately.
+func (s *service) status() (*host.StatusResponse, *varlink.Error) {
+	defs, err := machine.List()
+	if err != nil {
+		return nil, internalError(err)
+	}
+
+	response := &host.StatusResponse{RootSetup: rootSetupState(), Tools: toolStates()}
+
+	free, total, err := virt.HugePages()
+	if err == nil {
+		response.HugePagesFree = free
+		response.HugePagesTotal = total
+	}
+
+	for _, def := range defs {
+		response.Machines = append(response.Machines, s.machineState(def))
+	}
+
+	return response, nil
+}
+
+// vmList answers the VMList call with the machine states.
+func (s *service) vmList() (*host.StatusResponse, *varlink.Error) {
+	defs, err := machine.List()
+	if err != nil {
+		return nil, internalError(err)
+	}
+
+	response := &host.StatusResponse{}
+
+	for _, def := range defs {
+		response.Machines = append(response.Machines, s.machineState(def))
+	}
+
+	return response, nil
+}
+
+// machineState states what the supervisor and the install know about one
+// machine.
+func (s *service) machineState(def machine.Definition) host.MachineState {
+	state := s.sup.stateOf(def.Name)
+
+	installed := false
+	if info, err := os.Stat(def.DiskPathValue()); err == nil {
+		// The installer writes far more than a gigabyte, and a fresh disk is
+		// allocated but empty.
+		installed = info.Size() > 1024*1024*1024
+	}
+
+	machineState := host.MachineState{
+		Name:       def.Name,
+		State:      state,
+		Ready:      state == stateActive && virt.Ready(def),
+		Installed:  installed,
+		Installing: s.sup.installing(def.Name),
+	}
+
+	if status := virt.InstallStatusFor(def.Name); status != nil && machineState.Installing {
+		machineState.Install = &host.InstallState{
+			Steps:         status.Steps,
+			Current:       status.Current,
+			Done:          status.Done,
+			Failed:        status.Failed,
+			Detail:        status.Detail,
+			Downloaded:    status.Downloaded,
+			Total:         status.Total,
+			Packages:      status.Packages,
+			PackagesTotal: status.PackagesTotal,
+			PackageName:   status.PackageName,
+		}
+	}
+
+	if machineState.Ready {
+		if outdated, err := virt.GuestOutdated(def); err == nil {
+			machineState.AgentOutdated = outdated
+		}
+	}
+
+	return machineState
+}
+
+// acceptance answers the Acceptance call with the fixed acceptance tests.
+func (s *service) acceptance() (*host.AcceptanceResponse, *varlink.Error) {
+	checks := setup.Acceptance()
+
+	response := &host.AcceptanceResponse{}
+
+	for _, check := range checks {
+		response.Checks = append(response.Checks, host.AcceptanceCheck{
+			Name: check.Name,
+			OK:   check.OK,
+			Note: check.Note,
+		})
+	}
+
+	return response, nil
+}
+
+// rootSetupState reads the host state that the root setup writes, so the
+// wizard can report it.
+func rootSetupState() []host.StatusItem {
+	items := []host.StatusItem{}
+
+	add := func(name string, value string) {
+		items = append(items, host.StatusItem{Name: name, Value: value})
+	}
+
+	hugepages := "unknown"
+	if data, err := os.ReadFile("/proc/sys/vm/nr_hugepages"); err == nil {
+		hugepages = strings.TrimSpace(string(data))
+	}
+
+	add("hugepages", hugepages)
+	add("bridge phialbr0", interfaceState("phialbr0"))
+	add("tap phialtap0", interfaceState("phialtap0"))
+	add("udev usb rules", fileState("/etc/udev/rules.d/70-phial-usb.rules"))
+	add("udev vfio rules", fileState("/etc/udev/rules.d/70-phial-vfio.rules"))
+	add("memlock dropin", fileState("/etc/systemd/system/user@.service.d/99-phial-memlock.conf"))
+
+	return items
+}
+
+func interfaceState(name string) string {
+	if _, err := os.Stat(filepath.Join("/sys/class/net", name)); err != nil {
+		return "missing"
+	}
+
+	data, err := os.ReadFile(filepath.Join("/sys/class/net", name, "operstate"))
+	if err != nil {
+		return "present"
+	}
+
+	return strings.TrimSpace(string(data))
+}
+
+func fileState(path string) string {
+	if _, err := os.Stat(path); err != nil {
+		return "missing"
+	}
+
+	return "present"
+}
+
+// metrics answers the VMMetrics call with the live usage of one machine.
+func (s *service) metrics(name string) (*host.MetricsResponse, *varlink.Error) {
+	def, err := loadChecked(name)
+	if err != nil {
+		return nil, invalidRequest(err)
+	}
+
+	collected, err := virt.CollectMetrics(def)
+	if err != nil {
+		return nil, internalError(err)
+	}
+
+	response := &host.MetricsResponse{
+		VCPUs:          collected.VCPUs,
+		CPUPercent:     collected.CPUPercent,
+		MemoryUsed:     collected.MemoryUsed,
+		MemoryTotal:    collected.MemoryTotal,
+		DiskAllocated:  collected.DiskAllocated,
+		DiskTotal:      collected.DiskTotal,
+		DiskReadRate:   collected.DiskReadRate,
+		DiskWriteRate:  collected.DiskWriteRate,
+		NetworkReady:   collected.NetworkReady,
+		NetworkRxRate:  collected.NetworkRxRate,
+		NetworkTxRate:  collected.NetworkTxRate,
+		GPU:            collected.GPU,
+		GPUBusyReady:   collected.GPUBusyReady,
+		GPUBusyPercent: collected.GPUBusyPercent,
+	}
+
+	if s.sup.stateOf(name) == stateActive && virt.Ready(def) {
+		if outdated, err := virt.GuestOutdated(def); err == nil {
+			response.AgentOutdated = outdated
+		}
+	}
+
+	return response, nil
+}
+
+// machineLog states the console log of one machine, and falls back to the
+// log of the service.
+func machineLog(name string) string {
+	console := machine.ConsoleLogPath(name)
+
+	if info, err := os.Stat(console); err == nil && info.Size() > 0 {
+		return tailFile(console, 400)
+	}
+
+	service := filepath.Join(machine.Definition{Name: name}.RuntimePathValue(), "service.log")
+
+	if info, err := os.Stat(service); err == nil && info.Size() > 0 {
+		return tailFile(service, 400)
+	}
+
+	return "this machine has no log yet"
+}
+
+// tailFile reads the last lines of one file.
+func tailFile(path string, lines int) string {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return "this machine has no log yet"
+	}
+
+	all := strings.Split(strings.TrimRight(string(data), "\n"), "\n")
+
+	if len(all) > lines {
+		all = all[len(all)-lines:]
+	}
+
+	return strings.Join(all, "\n")
+}
+
+// provision answers the VMProvision call. A machine that is not installed
+// installs first, so this call also runs the install. A machine that is
+// installed receives the guest agent again, which keeps the provisioning
+// idempotent.
+func (s *service) provision(ctx context.Context, name string) (any, *varlink.Error) {
+	def, err := machine.Load(name)
+	if err != nil {
+		return nil, invalidRequest(err)
+	}
+
+	installed := false
+	if info, err := os.Stat(def.DiskPathValue()); err == nil {
+		installed = info.Size() > 1024*1024*1024
+	}
+
+	if !installed {
+		if s.sup.installing(name) {
+			return nil, invalidRequest(fmt.Errorf("an install already runs for %s", name))
+		}
+
+		// The installer VM runs outside the supervisor, so the install starts
+		// the tools that QEMU expects and stops them again when it returns.
+		tools, err := s.sup.startToolsForInstall(def)
+		if err != nil {
+			return nil, internalError(err)
+		}
+
+		s.sup.installMu.Lock()
+		s.sup.installs[name] = true
+		s.sup.installMu.Unlock()
+
+		go func() {
+			defer func() {
+				s.sup.stopTools(tools)
+
+				s.sup.installMu.Lock()
+				delete(s.sup.installs, name)
+				s.sup.installMu.Unlock()
+			}()
+
+			result, err := virt.Install(def, loadKickstart(), "")
+
+			summary := "phial install finished"
+			body := ""
+
+			if err != nil {
+				summary = "phial install failed"
+				body = err.Error()
+			} else {
+				body = result.Message
+
+				if err := s.provisionAfterInstall(def); err != nil {
+					s.log.Warn("could not provision the machine after the install", "name", name, "err", err)
+				}
+			}
+
+			s.log.Info(summary, "body", body, "err", err)
+		}()
+
+		return &host.StateResponse{State: "installing"}, nil
+	}
+
+	// The provisioning runs over the channel of the QEMU guest agent, so the
+	// machine must run.
+	if s.sup.stateOf(name) != stateActive {
+		return nil, invalidRequest(fmt.Errorf("start the machine %s first", name))
+	}
+
+	password := rdpPassword()
+
+	if err := guest.Provision(def, "host.internal", "/mnt/hostshare", "/mnt/phial-secrets", "52:54:00:5e:a1:02", password); err != nil {
+		return nil, internalError(err)
+	}
+
+	return &host.StateResponse{State: "provisioned"}, nil
+}
+
+// provisionAfterInstall boots an installed machine, waits for its guest to
+// answer, and copies the units of the guest into it.
+func (s *service) provisionAfterInstall(def machine.Definition) error {
+	if err := s.sup.start(context.Background(), def.Name); err != nil {
+		return err
+	}
+
+	defer func() {
+		if err := s.sup.stop(def.Name); err != nil {
+			s.log.Warn("could not stop the machine after the provisioning", "name", def.Name, "err", err)
+		}
+	}()
+
+	password := rdpPassword()
+
+	deadline := time.Now().Add(10 * time.Minute)
+	for time.Now().Before(deadline) {
+		if err := virt.WaitForAgent(def); err != nil {
+			time.Sleep(5 * time.Second)
+
+			continue
+		}
+
+		return guest.Provision(def, "host.internal", "/mnt/hostshare", "/mnt/phial-secrets", "52:54:00:5e:a1:02", password)
+	}
+
+	return fmt.Errorf("the guest of %s did not answer in time", def.Name)
+}
+
+//go:embed guest/phial.ks
+var embeddedKickstart []byte
+
+// loadKickstart reads the kickstart file of the installer. The binary carries
+// the file of this build, so a host install without a share folder still
+// installs with the same kickstart as the application.
+func loadKickstart() []byte {
+	candidates := []string{}
+
+	if value := os.Getenv("PHIAL_KICKSTART"); value != "" {
+		candidates = append(candidates, value)
+	}
+
+	candidates = append(candidates,
+		"/app/share/phial/phial.ks",
+		"/usr/share/phial/phial.ks",
+		"guest/phial.ks",
+		"cmd/phiald/guest/phial.ks",
+	)
+
+	for _, candidate := range candidates {
+		data, err := os.ReadFile(candidate)
+		if err == nil {
+			return data
+		}
+	}
+
+	return embeddedKickstart
+}
diff --git a/cmd/phiald/supervisor.go b/cmd/phiald/supervisor.go
new file mode 100644
index 0000000000000000000000000000000000000000..ecb7f0c0c11fce9ee6681d2851c87c66542214ed
--- /dev/null
+++ b/cmd/phiald/supervisor.go
@@ -0,0 +1,574 @@
+package main
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+
+	"log/slog"
+
+	"codeberg.org/pojntfx/phial-neo/cmd/phiald/virt"
+	"codeberg.org/pojntfx/phial-neo/internal/machine"
+	"github.com/mdlayher/vsock"
+)
+
+// The machine states that the supervisor reports.
+const (
+	stateInactive     = "inactive"
+	stateActivating   = "activating"
+	stateActive       = "active"
+	stateDeactivating = "deactivating"
+	stateFailed       = "failed"
+)
+
+// machineProcess is one machine that the host service supervises.
+type machineProcess struct {
+	def    virt.Definition
+	cancel context.CancelFunc
+
+	procs []*exec.Cmd
+
+	displayCancel context.CancelFunc
+	waypipe       *exec.Cmd
+	waypipePGID   int
+
+	lock  sync.Mutex
+	state string
+	err   error
+	done  chan struct{}
+}
+
+// supervisor owns the machine processes and the host tools. The host service
+// supervises the machines itself, so the machine units are gone.
+type supervisor struct {
+	log *slog.Logger
+
+	lock      sync.Mutex
+	machines  map[string]*machineProcess
+	installs  map[string]bool
+	installMu sync.Mutex
+}
+
+func newSupervisor(log *slog.Logger) *supervisor {
+	return &supervisor{
+		log:      log,
+		machines: map[string]*machineProcess{},
+		installs: map[string]bool{},
+	}
+}
+
+// stateOf states what the supervisor knows about one machine.
+func (s *supervisor) stateOf(name string) string {
+	s.lock.Lock()
+	defer s.lock.Unlock()
+
+	if proc, ok := s.machines[name]; ok {
+		proc.lock.Lock()
+		defer proc.lock.Unlock()
+
+		return proc.state
+	}
+
+	return stateInactive
+}
+
+// running states the machine process of one machine, or nil.
+func (s *supervisor) running(name string) *machineProcess {
+	s.lock.Lock()
+	defer s.lock.Unlock()
+
+	return s.machines[name]
+}
+
+// start runs one machine: its tools first, then QEMU. The call returns once
+// the machine runs or fails to start.
+func (s *supervisor) start(ctx context.Context, name string) error {
+	def, err := loadChecked(name)
+	if err != nil {
+		return err
+	}
+
+	s.lock.Lock()
+
+	if proc, ok := s.machines[name]; ok {
+		s.lock.Unlock()
+
+		proc.lock.Lock()
+		defer proc.lock.Unlock()
+
+		if proc.state == stateActive || proc.state == stateActivating {
+			return nil
+		}
+
+		return fmt.Errorf("the machine %s is %s", name, proc.state)
+	}
+
+	proc := &machineProcess{
+		def:   def,
+		state: stateActivating,
+		done:  make(chan struct{}),
+	}
+	s.machines[name] = proc
+
+	s.lock.Unlock()
+
+	procCtx, cancel := context.WithCancel(ctx)
+	proc.cancel = cancel
+
+	if err := s.startTools(procCtx, proc); err != nil {
+		cancel()
+		s.remove(name)
+
+		return err
+	}
+
+	proc.lock.Lock()
+	proc.state = stateActive
+	proc.lock.Unlock()
+
+	go s.wait(procCtx, proc)
+
+	// The display socket of the machine proxies to the guest vsock, so that
+	// the application runs its waypipe client without a network share.
+	displayCancel := s.serveDisplay(procCtx, def)
+
+	proc.lock.Lock()
+	proc.displayCancel = displayCancel
+	proc.lock.Unlock()
+
+	return nil
+}
+
+// wait watches the machine process and ends the state when QEMU exits.
+func (s *supervisor) wait(ctx context.Context, proc *machineProcess) {
+	err := virt.RunExecContext(proc.def, ctx, virt.BootConfig{})
+
+	proc.lock.Lock()
+	if err != nil {
+		proc.err = err
+		proc.state = stateFailed
+	} else {
+		proc.state = stateInactive
+	}
+	proc.lock.Unlock()
+
+	s.log.Info("the machine exited", "name", proc.def.Name, "err", err)
+
+	s.stopTools(proc)
+
+	close(proc.done)
+
+	s.remove(proc.def.Name)
+}
+
+// stop asks the guest to shut down and switches the machine off when the
+// guest ignores the shutdown, so a stop flushes the writes of the guest.
+func (s *supervisor) stop(name string) error {
+	proc := s.running(name)
+	if proc == nil {
+		return nil
+	}
+
+	proc.lock.Lock()
+	if proc.state != stateActive && proc.state != stateActivating {
+		proc.lock.Unlock()
+
+		return nil
+	}
+	proc.state = stateDeactivating
+	proc.lock.Unlock()
+
+	go func() {
+		virt.GracefulStop(proc.def)
+
+		select {
+		case <-proc.done:
+		case <-time.After(90 * time.Second):
+			proc.cancel()
+		}
+	}()
+
+	return nil
+}
+
+// restart stops and starts one machine.
+func (s *supervisor) restart(ctx context.Context, name string) error {
+	proc := s.running(name)
+	if proc == nil {
+		return s.start(ctx, name)
+	}
+
+	s.stop(name)
+
+	select {
+	case <-proc.done:
+	case <-time.After(120 * time.Second):
+		proc.cancel()
+		<-proc.done
+	}
+
+	return s.start(ctx, name)
+}
+
+// remove drops the machine process from the table.
+func (s *supervisor) remove(name string) {
+	s.lock.Lock()
+	defer s.lock.Unlock()
+
+	delete(s.machines, name)
+}
+
+// installing reports whether an install runs for one machine.
+func (s *supervisor) installing(name string) bool {
+	s.installMu.Lock()
+	defer s.installMu.Unlock()
+
+	return s.installs[name]
+}
+
+// startTools runs the tools of one machine: the TPM emulator, the folder
+// shares, the network fallback, and the desktop forward.
+func (s *supervisor) startTools(ctx context.Context, proc *machineProcess) error {
+	def := proc.def
+	run := def.RuntimePathValue()
+
+	if err := os.MkdirAll(run, 0o700); err != nil {
+		return err
+	}
+
+	spawn := func(command *exec.Cmd) error {
+		command.Stdout = os.Stdout
+		command.Stderr = os.Stderr
+
+		if err := command.Start(); err != nil {
+			return err
+		}
+
+		proc.procs = append(proc.procs, command)
+
+		go func() {
+			_ = command.Wait()
+		}()
+
+		return nil
+	}
+
+	// The TPM emulator carries the TPM state of the machine.
+	_ = os.MkdirAll(filepath.Join(run, "swtpm"), 0o700)
+	_ = os.Remove(filepath.Join(run, "swtpm.sock"))
+
+	if err := spawn(toolCommand("swtpm",
+		"socket",
+		"--tpmstate", "dir="+filepath.Join(run, "swtpm"),
+		"--ctrl", "type=unixio,path="+filepath.Join(run, "swtpm.sock"),
+		"--tpm2",
+		"--log", "file="+filepath.Join(run, "swtpm.log")+",level=5",
+		"--flags", "not-need-init",
+	)); err != nil {
+		return fmt.Errorf("start swtpm: %w", err)
+	}
+
+	// Every machine mounts only its own secrets directory.
+	secretsShare := filepath.Join(machine.RuntimeDir(), "secrets", def.Name)
+	if err := os.MkdirAll(secretsShare, 0o700); err != nil {
+		return err
+	}
+
+	shares := append([]string{
+		filepath.Join(machine.DataDir(), "hostshare"),
+		secretsShare,
+	}, def.Shares...)
+
+	for _, share := range shares {
+		tag := machine.ShareTag(share)
+		if share == secretsShare {
+			tag = "phial-secrets-" + def.Name
+		}
+
+		if err := os.MkdirAll(share, 0o700); err != nil {
+			return err
+		}
+
+		socket := filepath.Join(machine.RuntimeDir(), "vm", "virtiofsd-"+tag+".sock")
+
+		if err := os.MkdirAll(filepath.Dir(socket), 0o700); err != nil {
+			return err
+		}
+		_ = os.Remove(socket)
+
+		if err := spawn(toolCommand("virtiofsd",
+			"--socket-path="+socket,
+			"--shared-dir="+share,
+			"--xattr",
+			"--announce-submounts",
+			"--uid-map=:1000:1000:1:",
+			"--gid-map=:1000:1000:1:",
+		)); err != nil {
+			return fmt.Errorf("start virtiofsd for %s: %w", share, err)
+		}
+	}
+
+	// The fallback network path serves DHCP and the traffic of the guest.
+	if def.NetFallback != "off" {
+		_ = os.Remove(filepath.Join(run, "passt.sock"))
+
+		if err := spawn(passtCommand(filepath.Join(run, "passt.sock"))); err != nil {
+			return fmt.Errorf("start passt: %w", err)
+		}
+	}
+
+	for _, listen := range desktopForwardListens(def.RdpPortValue()) {
+		if err := spawn(toolCommand("socat",
+			listen,
+			fmt.Sprintf("VSOCK-CONNECT:%d:3389", def.GuestCIDValue()),
+		)); err != nil {
+			s.log.Warn("could not start the desktop forward", "name", def.Name, "listen", listen, "err", err)
+		}
+	}
+
+	return nil
+}
+
+func (s *supervisor) startWaypipe(name string) error {
+	proc := s.running(name)
+	if proc == nil {
+		return fmt.Errorf("the machine %s does not run", name)
+	}
+
+	proc.lock.Lock()
+	defer proc.lock.Unlock()
+
+	if proc.waypipe != nil {
+		return nil
+	}
+
+	if proc.waypipePGID > 0 {
+		_ = syscall.Kill(-proc.waypipePGID, syscall.SIGKILL)
+		proc.waypipePGID = 0
+	}
+
+	command := waypipeClientCommand(proc.def.GuestCIDValue())
+	command.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	command.Stdout = os.Stdout
+	command.Stderr = os.Stderr
+
+	if err := command.Start(); err != nil {
+		return fmt.Errorf("start the waypipe client: %w", err)
+	}
+
+	proc.waypipe = command
+	proc.waypipePGID = command.Process.Pid
+
+	go func() {
+		err := command.Wait()
+		s.log.Info("the waypipe client exited", "name", name, "err", err)
+
+		proc.lock.Lock()
+		if proc.waypipe == command {
+			proc.waypipe = nil
+		}
+		proc.lock.Unlock()
+	}()
+
+	return nil
+}
+
+func waypipeClientCommand(cid uint32) *exec.Cmd {
+	return toolCommand("waypipe", "--compress", "none", "--vsock", "-s", fmt.Sprintf("%d:5000", cid), "client")
+}
+
+func desktopForwardListens(port int) []string {
+	return []string{
+		fmt.Sprintf("TCP-LISTEN:%d,bind=127.0.0.1,fork,reuseaddr", port),
+		fmt.Sprintf("TCP6-LISTEN:%d,bind=[::1],fork,reuseaddr", port),
+	}
+}
+
+// startToolsForInstall starts the tools of one machine for an install. The
+// install runs outside the supervisor, so the caller stops the tools when it
+// returns.
+func (s *supervisor) startToolsForInstall(def virt.Definition) (*machineProcess, error) {
+	proc := &machineProcess{
+		def:   def,
+		state: stateActivating,
+		done:  make(chan struct{}),
+	}
+
+	if err := s.startTools(context.Background(), proc); err != nil {
+		s.stopTools(proc)
+
+		return nil, err
+	}
+
+	return proc, nil
+}
+
+// stopTools ends the tools of one machine.
+func (s *supervisor) stopTools(proc *machineProcess) {
+	if proc.displayCancel != nil {
+		proc.displayCancel()
+	}
+
+	proc.lock.Lock()
+	if proc.waypipePGID > 0 {
+		_ = syscall.Kill(-proc.waypipePGID, syscall.SIGKILL)
+		proc.waypipePGID = 0
+	}
+	proc.waypipe = nil
+	proc.lock.Unlock()
+
+	for _, command := range proc.procs {
+		if command.Process != nil {
+			_ = command.Process.Kill()
+		}
+	}
+}
+
+// passtCommand builds the passt call of one machine. passt forwards the
+// queries of the guest to the resolver of the host, and it reaches the stub
+// resolver of systemd-resolved when it exists.
+func passtCommand(socket string) *exec.Cmd {
+	args := []string{
+		"--foreground",
+		"--socket", socket,
+		"--address", "192.168.100.2",
+		"--netmask", "24",
+		"--gateway", "192.168.100.1",
+		"--dns", "192.168.100.1",
+		"--dns-forward", "192.168.100.1",
+		"--mtu", "1472",
+		"--quiet",
+	}
+
+	resolver := ""
+
+	if _, err := os.Stat("/run/systemd/resolve/stub-resolv.conf"); err == nil {
+		resolver = "127.0.0.53"
+	} else if data, err := os.ReadFile("/etc/resolv.conf"); err == nil {
+		for _, line := range strings.Split(string(data), "\n") {
+			fields := strings.Fields(line)
+			if len(fields) == 2 && fields[0] == "nameserver" && !strings.HasPrefix(fields[1], "127.") && fields[1] != "::1" {
+				resolver = fields[1]
+
+				break
+			}
+		}
+	}
+
+	if resolver != "" {
+		args = append(args, "--dns-host", resolver)
+	}
+
+	return toolCommand("passt", args...)
+}
+
+// serveDisplay exposes the display socket of one machine and proxies it to
+// the guest vsock. The guest agent starts the guest waypipe server.
+func (s *supervisor) serveDisplay(ctx context.Context, def virt.Definition) context.CancelFunc {
+	proxyCtx, cancel := context.WithCancel(ctx)
+
+	dir := filepath.Join(machine.RuntimeDir(), "display")
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		s.log.Warn("could not create the display folder", "err", err)
+		cancel()
+
+		return cancel
+	}
+
+	socket := filepath.Join(dir, def.Name+".sock")
+	_ = os.Remove(socket)
+
+	listener, err := net.Listen("unix", socket)
+	if err != nil {
+		s.log.Warn("could not listen on the display socket", "socket", socket, "err", err)
+		cancel()
+
+		return cancel
+	}
+
+	if err := os.Chmod(socket, 0o600); err != nil {
+		s.log.Warn("could not protect the display socket", "socket", socket, "err", err)
+	}
+
+	go func() {
+		<-proxyCtx.Done()
+		listener.Close()
+	}()
+
+	go func() {
+		for {
+			conn, err := listener.Accept()
+			if err != nil {
+				return
+			}
+
+			go func() {
+				defer conn.Close()
+
+				guest, err := vsock.Dial(def.GuestCIDValue(), 5000, &vsock.Config{})
+				if err != nil {
+					s.log.Info("could not reach the guest display server", "name", def.Name, "err", err)
+
+					return
+				}
+				defer guest.Close()
+
+				proxyConnections(guest, conn)
+			}()
+		}
+	}()
+
+	return cancel
+}
+
+// proxyConnections carries bytes both ways between two connections and closes
+// both when either side ends. The display socket of one machine proxies to the
+// guest vsock, so that the application runs its waypipe client against the
+// socket without a network share.
+func proxyConnections(a net.Conn, b net.Conn) {
+	done := make(chan struct{}, 2)
+
+	copyEnd := func(dst net.Conn, src net.Conn) {
+		_, _ = io.Copy(dst, src)
+		_ = dst.Close()
+		_ = src.Close()
+
+		done <- struct{}{}
+	}
+
+	go copyEnd(a, b)
+	go copyEnd(b, a)
+
+	<-done
+}
+
+// startMarked starts the machines whose configuration marks them. The machine
+// autostart configuration is per machine.
+func (s *supervisor) startMarked(ctx context.Context) {
+	defs, err := machine.List()
+	if err != nil {
+		s.log.Warn("could not list the machines for autostart", "err", err)
+
+		return
+	}
+
+	for _, def := range defs {
+		if !def.Autostart {
+			continue
+		}
+
+		s.log.Info("starting the marked machine", "name", def.Name)
+
+		if err := s.start(ctx, def.Name); err != nil {
+			s.log.Warn("could not start the marked machine", "name", def.Name, "err", err)
+		}
+	}
+}
diff --git a/cmd/phiald/supervisor_test.go b/cmd/phiald/supervisor_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..bcb9fd3d7688d1b718d670db309b82d4f8a97f2b
--- /dev/null
+++ b/cmd/phiald/supervisor_test.go
@@ -0,0 +1,87 @@
+package main
+
+import (
+	"io"
+	"net"
+	"strings"
+	"testing"
+	"time"
+)
+
+// TestProxyConnectionsCarriesBytesBothWays covers the waypipe Unix socket
+// proxy. The service exposes one socket per machine and proxies it to the
+// guest, so the application runs its waypipe client against the socket.
+func TestProxyConnectionsCarriesBytesBothWays(t *testing.T) {
+	client, server := net.Pipe()
+	defer client.Close()
+	defer server.Close()
+
+	target, peer := net.Pipe()
+	defer target.Close()
+	defer peer.Close()
+
+	go proxyConnections(server, target)
+
+	// The client sends to the proxy and reads the echo that the peer returns.
+	go func() {
+		buf := make([]byte, 4)
+		_, _ = io.ReadFull(peer, buf)
+		_, _ = peer.Write(buf)
+	}()
+
+	if _, err := client.Write([]byte("ping")); err != nil {
+		t.Fatal(err)
+	}
+
+	buf := make([]byte, 4)
+	client.SetReadDeadline(time.Now().Add(2 * time.Second))
+	if _, err := io.ReadFull(client, buf); err != nil {
+		t.Fatal(err)
+	}
+
+	if string(buf) != "ping" {
+		t.Fatalf("proxy carried %q, want %q", string(buf), "ping")
+	}
+}
+
+// TestProxyConnectionsClosesBothEnds makes sure that the proxy closes both
+// connections when one side ends.
+func TestProxyConnectionsClosesBothEnds(t *testing.T) {
+	client, server := net.Pipe()
+	target, peer := net.Pipe()
+
+	go proxyConnections(server, target)
+
+	// Close the client side, which ends the proxy and closes the peer.
+	client.Close()
+
+	peer.SetReadDeadline(time.Now().Add(2 * time.Second))
+	buf := make([]byte, 1)
+	if _, err := peer.Read(buf); err == nil {
+		t.Fatal("the peer still reads after the proxy closed")
+	}
+}
+
+func TestWaypipeClientUsesNoCompression(t *testing.T) {
+	command := waypipeClientCommand(197)
+
+	if !strings.Contains(strings.Join(command.Args, " "), "--compress none") {
+		t.Fatalf("waypipeClientCommand() = %q, want no compression", command.Args)
+	}
+}
+
+func TestDesktopForwardListensOnBothLoopbacks(t *testing.T) {
+	listens := desktopForwardListens(3586)
+
+	if len(listens) != 2 {
+		t.Fatalf("desktopForwardListens() = %v, want 2 listeners", listens)
+	}
+
+	if !strings.Contains(listens[0], "bind=127.0.0.1") {
+		t.Fatalf("desktopForwardListens() = %v, want an IPv4 loopback listener", listens)
+	}
+
+	if !strings.Contains(listens[1], "bind=[::1]") {
+		t.Fatalf("desktopForwardListens() = %v, want an IPv6 loopback listener", listens)
+	}
+}
diff --git a/cmd/phiald/tools.go b/cmd/phiald/tools.go
new file mode 100644
index 0000000000000000000000000000000000000000..67acf1467aec8d371b77f4f3f10df668f4e790d4
--- /dev/null
+++ b/cmd/phiald/tools.go
@@ -0,0 +1,117 @@
+package main
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+
+	"codeberg.org/pojntfx/phial-neo/internal/host"
+	"codeberg.org/pojntfx/phial-neo/internal/version"
+)
+
+// The Flatpak ships the host tools under the deployment files/bin, and the
+// service runs them from there. QEMU is the exception: it comes from the host
+// PATH for now.
+var bundledTools = []string{"virtiofsd", "swtpm", "passt", "socat", "gpg", "ssh", "ssh-add", "ssh-keygen", "ssh-agent", "waypipe"}
+
+var (
+	deploymentOnce sync.Once
+	deploymentDir  string
+)
+
+// deploymentPath resolves the Flatpak deployment of Phial, so that the
+// service runs the shipped tools from its files/bin.
+func deploymentPath() string {
+	deploymentOnce.Do(func() {
+		if override := os.Getenv("PHIAL_DEPLOYMENT"); override != "" {
+			deploymentDir = override
+
+			return
+		}
+
+		output, err := exec.Command("flatpak", "info", "--show-location", version.AppID).Output()
+		if err != nil {
+			return
+		}
+
+		dir := strings.TrimSpace(string(output))
+		if dir == "" {
+			return
+		}
+
+		if _, err := os.Stat(filepath.Join(dir, "files", "bin")); err != nil {
+			return
+		}
+
+		deploymentDir = dir
+	})
+
+	return deploymentDir
+}
+
+// toolCommand runs one host tool with a fixed argument list. The tools of the
+// Flatpak deployment run with the library path of the Flatpak runtime, and a
+// development run finds them on the PATH.
+func toolCommand(name string, args ...string) *exec.Cmd {
+	dir := deploymentPath()
+
+	if dir != "" {
+		binary := filepath.Join(dir, "files", "bin", name)
+
+		if _, err := os.Stat(binary); err == nil {
+			command := exec.Command(binary, args...)
+			command.Env = append(os.Environ(), "LD_LIBRARY_PATH="+filepath.Join(dir, "files", "lib"))
+
+			return command
+		}
+	}
+
+	return exec.Command(name, args...)
+}
+
+// toolState states where one tool comes from and whether it exists.
+func toolState(name string) host.ToolState {
+	dir := deploymentPath()
+
+	if dir != "" {
+		binary := filepath.Join(dir, "files", "bin", name)
+
+		if _, err := os.Stat(binary); err == nil {
+			return host.ToolState{Name: name, Path: binary, Present: true}
+		}
+	}
+
+	path, err := exec.LookPath(name)
+
+	return host.ToolState{Name: name, Path: path, Present: err == nil}
+}
+
+// qemuState states the host QEMU. QEMU comes from the host PATH for now, and
+// a missing host QEMU does not block the install.
+func qemuState() host.ToolState {
+	path, err := exec.LookPath("qemu-system-x86_64")
+
+	state := host.ToolState{Name: "qemu-system-x86_64", Path: path, Present: err == nil}
+
+	if state.Present {
+		if output, err := exec.Command(path, "--version").Output(); err == nil {
+			state.Version = strings.TrimSpace(strings.SplitN(string(output), "\n", 2)[0])
+		}
+	}
+
+	return state
+}
+
+// toolStates reports the Flatpak tools and the host QEMU separately, so the
+// wizard can report a missing tool.
+func toolStates() []host.ToolState {
+	states := []host.ToolState{}
+
+	for _, name := range bundledTools {
+		states = append(states, toolState(name))
+	}
+
+	return append(states, qemuState())
+}
diff --git a/cmd/phiald/tools_test.go b/cmd/phiald/tools_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..f39461249bd03e40fa74ad96d212788a76d720b9
--- /dev/null
+++ b/cmd/phiald/tools_test.go
@@ -0,0 +1,88 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+)
+
+// TestToolCommandPrefersTheDeployment makes sure that the service runs the
+// tools of the Flatpak deployment from its files/bin with the runtime library
+// path.
+func TestToolCommandPrefersTheDeployment(t *testing.T) {
+	fixture := t.TempDir()
+	bin := filepath.Join(fixture, "files", "bin")
+	if err := os.MkdirAll(bin, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	tool := filepath.Join(bin, "swtpm")
+	if err := os.WriteFile(tool, []byte("#!/bin/sh\n"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+
+	old := os.Getenv("PHIAL_DEPLOYMENT")
+	os.Setenv("PHIAL_DEPLOYMENT", fixture)
+	defer os.Setenv("PHIAL_DEPLOYMENT", old)
+	resetDeployment()
+	defer resetDeployment()
+
+	command := toolCommand("swtpm", "--version")
+	if command.Path != tool {
+		t.Fatalf("toolCommand() = %q, want the deployment tool %q", command.Path, tool)
+	}
+
+	wantLib := filepath.Join(fixture, "files", "lib")
+	found := false
+	for _, env := range command.Env {
+		if env == "LD_LIBRARY_PATH="+wantLib {
+			found = true
+		}
+	}
+
+	if !found {
+		t.Fatal("the deployment tool does not carry the runtime library path")
+	}
+}
+
+// TestToolStateSeparatesTheHostQEMU makes sure that the install and Status
+// report the host QEMU and the Flatpak tools separately. A missing host QEMU
+// does not block the install.
+func TestToolStateSeparatesTheHostQEMU(t *testing.T) {
+	fixture := t.TempDir()
+	bin := filepath.Join(fixture, "files", "bin")
+	if err := os.MkdirAll(bin, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	tool := filepath.Join(bin, "virtiofsd")
+	if err := os.WriteFile(tool, []byte("#!/bin/sh\n"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+
+	old := os.Getenv("PHIAL_DEPLOYMENT")
+	os.Setenv("PHIAL_DEPLOYMENT", fixture)
+	defer os.Setenv("PHIAL_DEPLOYMENT", old)
+	resetDeployment()
+	defer resetDeployment()
+
+	states := toolStates()
+	if len(states) != len(bundledTools)+1 {
+		t.Fatalf("toolStates() returned %d tools, want %d", len(states), len(bundledTools)+1)
+	}
+
+	qemu := states[len(states)-1]
+	if qemu.Name != "qemu-system-x86_64" {
+		t.Fatalf("the last tool is %q, want the host QEMU", qemu.Name)
+	}
+
+	for _, state := range states[:len(states)-1] {
+		if state.Name == "qemu-system-x86_64" {
+			t.Fatal("the host QEMU is mixed with the Flatpak tools")
+		}
+	}
+}
+
+func resetDeployment() {
+	deploymentOnce = sync.Once{}
+	deploymentDir = ""
+}
diff --git a/cmd/phiald/usb.go b/cmd/phiald/usb.go
new file mode 100644
index 0000000000000000000000000000000000000000..ea7f0394967aea4ffeee2f8dfe358008a694c070
--- /dev/null
+++ b/cmd/phiald/usb.go
@@ -0,0 +1,190 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"codeberg.org/pojntfx/phial-neo/cmd/phiald/virt"
+	"codeberg.org/pojntfx/phial-neo/internal/host"
+	"codeberg.org/pojntfx/phial-neo/internal/machine"
+	"codeberg.org/pojntfx/phial-neo/internal/varlink"
+)
+
+// usbList answers the USBList call: the USB devices of the host and the
+// xHCI controllers, with what any machine already forwards.
+func (s *service) usbList() (*host.USBListResponse, *varlink.Error) {
+	response := &host.USBListResponse{}
+
+	attached := map[string]string{}
+	usedHubs := map[string]bool{}
+
+	defs, _ := machine.List()
+	for _, def := range defs {
+		for _, device := range def.USBDevices {
+			attached[device] = def.Name
+		}
+		for _, hub := range def.USBXHCIs {
+			usedHubs[hub] = true
+		}
+	}
+
+	vendors, _ := filepath.Glob("/sys/bus/usb/devices/*/idVendor")
+	for _, vendorFile := range vendors {
+		vendor := strings.TrimSpace(readSysfs(vendorFile))
+		product := strings.TrimSpace(readSysfs(filepath.Join(filepath.Dir(vendorFile), "idProduct")))
+
+		if vendor == "" || product == "" || vendor == "1d6b" {
+			continue
+		}
+
+		id := vendor + ":" + product
+		name := strings.TrimSpace(readSysfs(filepath.Join(filepath.Dir(vendorFile), "manufacturer")) + " " + readSysfs(filepath.Join(filepath.Dir(vendorFile), "product")))
+		if name == "" {
+			name = virt.USBName(vendor, product)
+		}
+
+		entry := host.USBDevice{ID: id, Name: name}
+		if machineName, ok := attached[id]; ok {
+			entry.Attached = true
+			entry.AttachedTo = machineName
+		}
+
+		response.Devices = append(response.Devices, entry)
+	}
+
+	controllers, _ := filepath.Glob("/sys/bus/pci/devices/*/class")
+	for _, classFile := range controllers {
+		if strings.TrimSpace(readSysfs(classFile)) != "0x0c0330" {
+			continue
+		}
+
+		dir := filepath.Dir(classFile)
+		address := filepath.Base(dir)
+		vendor := strings.TrimSpace(readSysfs(filepath.Join(dir, "vendor")))
+		device := strings.TrimSpace(readSysfs(filepath.Join(dir, "device")))
+
+		name := virt.PCIName(vendor, device)
+		if name == "" {
+			name = vendor + " " + device
+		}
+
+		response.Hubs = append(response.Hubs, host.USBHub{
+			Address: address,
+			Name:    name,
+			InUse:   usedHubs[address],
+		})
+	}
+
+	return response, nil
+}
+
+func readSysfs(path string) string {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return ""
+	}
+
+	return string(data)
+}
+
+// usbAttach passes one USB device to one machine. The service checks that
+// the vendor, product, and serial values exist in /sys before it changes the
+// definition.
+func (s *service) usbAttach(machineName string, device string) error {
+	if err := checkMachineName(machineName); err != nil {
+		return err
+	}
+
+	if err := checkUSBDevice(device); err != nil {
+		return err
+	}
+
+	def, err := machine.Load(machineName)
+	if err != nil {
+		return err
+	}
+
+	for _, existing := range def.USBDevices {
+		if existing == device {
+			return fmt.Errorf("the device %s is already in the list", device)
+		}
+	}
+
+	def.USBDevices = append(def.USBDevices, device)
+
+	if err := def.Save(); err != nil {
+		return err
+	}
+
+	if s.sup.stateOf(machineName) == stateActive {
+		if err := virt.HotplugUSB(def, device); err != nil {
+			s.log.Info("the device attaches on the next start", "machine", machineName, "device", device, "err", err)
+		}
+	}
+
+	return nil
+}
+
+// usbDetach removes one USB device from one machine.
+func (s *service) usbDetach(machineName string, device string) error {
+	if err := checkMachineName(machineName); err != nil {
+		return err
+	}
+
+	def, err := machine.Load(machineName)
+	if err != nil {
+		return err
+	}
+
+	kept := []string{}
+	for _, existing := range def.USBDevices {
+		if existing != device {
+			kept = append(kept, existing)
+		}
+	}
+
+	def.USBDevices = kept
+
+	if err := def.Save(); err != nil {
+		return err
+	}
+
+	if s.sup.stateOf(machineName) == stateActive {
+		if err := virt.UnplugUSB(def, device); err != nil {
+			s.log.Info("could not detach the usb device", "machine", machineName, "device", device, "err", err)
+		}
+	}
+
+	return nil
+}
+
+// vfioBind binds one xHCI controller to vfio-pci. The service checks the PCI
+// address and the controller class before the run0 call.
+func (s *service) vfioBind(address string) error {
+	if err := checkPCIAddress(address); err != nil {
+		return err
+	}
+
+	output, err := run0("vfio-bind", address)
+	if err != nil {
+		return fmt.Errorf("vfio bind: %s: %w", output, err)
+	}
+
+	return nil
+}
+
+// vfioRestore gives one xHCI controller back to its host driver.
+func (s *service) vfioRestore(address string) error {
+	if err := checkPCIAddress(address); err != nil {
+		return err
+	}
+
+	output, err := run0("vfio-restore", address)
+	if err != nil {
+		return fmt.Errorf("vfio restore: %s: %w", output, err)
+	}
+
+	return nil
+}
diff --git a/cmd/phiald/virt/hooks.go b/cmd/phiald/virt/hooks.go
new file mode 100644
index 0000000000000000000000000000000000000000..bab41a787e9b9957b08ea8fc2254891b52ce6ccb
--- /dev/null
+++ b/cmd/phiald/virt/hooks.go
@@ -0,0 +1,54 @@
+package virt
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+)
+
+// DependencyStarter starts the tools of one machine before QEMU runs. The
+// host service sets it, and the tools live under the Flatpak deployment.
+var DependencyStarter = func(ctx context.Context, d Definition) error {
+	return nil
+}
+
+// StopMachineTools ends the tools of one machine. The host service sets it.
+var StopMachineTools = func(d Definition) error {
+	return nil
+}
+
+// StartShareTool runs the virtiofsd of one share tag for a hotplug. The host
+// service sets it.
+var StartShareTool = func(tag string) error {
+	return fmt.Errorf("the host service does not run the share tool")
+}
+
+// StopShareTool ends the virtiofsd of one share tag after an unplug. The host
+// service sets it.
+var StopShareTool = func(tag string) error {
+	return fmt.Errorf("the host service does not run the share tool")
+}
+
+// MachineRuns states whether the QEMU process of one machine is still alive.
+func MachineRuns(d Definition) (bool, error) {
+	data, err := os.ReadFile(filepath.Join(d.RuntimePathValue(), "qemu.pid"))
+	if err != nil {
+		return false, err
+	}
+
+	pid, err := strconv.Atoi(strings.TrimSpace(string(data)))
+	if err != nil {
+		return false, err
+	}
+
+	process, err := os.FindProcess(pid)
+	if err != nil {
+		return false, err
+	}
+
+	return process.Signal(syscall.Signal(0)) == nil, nil
+}
diff --git a/cmd/phiald/virt/types.go b/cmd/phiald/virt/types.go
new file mode 100644
index 0000000000000000000000000000000000000000..d2fd61a6a2a70c357989ec8d4ef07d75952ed954
--- /dev/null
+++ b/cmd/phiald/virt/types.go
@@ -0,0 +1,36 @@
+package virt
+
+import (
+	"os"
+
+	"codeberg.org/pojntfx/phial-neo/internal/machine"
+	"github.com/mdlayher/vsock"
+)
+
+// Definition is the configuration of one machine. The type lives in the
+// shared machine package, so the application and the host service read the
+// same definitions.
+type Definition = machine.Definition
+
+// OVMFDirValue states the directory that carries the firmware pair.
+func OVMFDirValue() string {
+	for _, dir := range []string{"/app/share/edk2", "/usr/share/edk2/ovmf"} {
+		if _, err := os.Stat(dir); err == nil {
+			return dir
+		}
+	}
+
+	return "/usr/share/edk2/ovmf"
+}
+
+// Ready reports whether the guest of the machine answers on its vsock.
+func Ready(d Definition) bool {
+	conn, err := vsock.Dial(d.GuestCIDValue(), 2222, &vsock.Config{})
+	if err != nil {
+		return false
+	}
+
+	_ = conn.Close()
+
+	return true
+}
diff --git a/cmd/startcheck/main.go b/cmd/startcheck/main.go
new file mode 100644
index 0000000000000000000000000000000000000000..348fe559e0cd679334e35ffd4067a28cec928487
--- /dev/null
+++ b/cmd/startcheck/main.go
@@ -0,0 +1,65 @@
+package main
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"net/http"
+	"time"
+
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+func main() {
+	ctx := context.Background()
+
+	httpClient := &http.Client{Transport: &http.Transport{
+		DialContext: func(ctx context.Context, network, addr string) (net.Conn, error) {
+			return (&net.Dialer{}).DialContext(ctx, "unix", "/run/user/1000/phial/mcp.sock")
+		},
+	}}
+
+	client := mcp.NewClient(&mcp.Implementation{Name: "phial-check", Version: "0.0.0"}, nil)
+
+	session, err := client.Connect(ctx, &mcp.StreamableClientTransport{
+		Endpoint:   "http://unix/mcp",
+		HTTPClient: httpClient,
+	}, nil)
+	if err != nil {
+		fmt.Println("connect:", err)
+
+		return
+	}
+	defer session.Close()
+
+	res, err := session.CallTool(ctx, &mcp.CallToolParams{Name: "vm.start", Arguments: map[string]any{"name": "fels-testing-vm"}})
+	fmt.Printf("start err=%v isError=%v\n", err, res.IsError)
+
+	for _, item := range res.Content {
+		if text, ok := item.(*mcp.TextContent); ok {
+			fmt.Println("start content:", text.Text)
+		}
+	}
+
+	for i := 0; i < 15; i++ {
+		time.Sleep(3 * time.Second)
+
+		res, err := session.CallTool(ctx, &mcp.CallToolParams{Name: "vm.ls"})
+		if err != nil {
+			fmt.Println("ls:", err)
+
+			break
+		}
+
+		fmt.Printf("t=%ds %+v\n", i*3, res.StructuredContent)
+	}
+
+	res, err = session.CallTool(ctx, &mcp.CallToolParams{Name: "vm.provision", Arguments: map[string]any{"name": "fels-testing-vm"}})
+	fmt.Printf("provision err=%v isError=%v\n", err, res.IsError)
+
+	for _, item := range res.Content {
+		if text, ok := item.(*mcp.TextContent); ok {
+			fmt.Println("provision content:", text.Text)
+		}
+	}
+}
