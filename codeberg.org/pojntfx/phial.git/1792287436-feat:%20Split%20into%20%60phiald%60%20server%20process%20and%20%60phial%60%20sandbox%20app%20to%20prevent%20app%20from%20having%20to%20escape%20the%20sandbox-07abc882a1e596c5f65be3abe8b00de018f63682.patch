+++ b/internal/varlink/server.go
@@ -0,0 +1,177 @@
+package varlink
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"log/slog"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+)
+
+// Handler answers one call. The peer is the verified identity of the client.
+type Handler func(ctx context.Context, method string, parameters json.RawMessage) (any, *Error)
+
+// PeerCheck accepts or rejects one client connection.
+type PeerCheck func(conn *net.UnixConn) error
+
+// Server serves the varlink interface on one listener.
+type Server struct {
+	log       *slog.Logger
+	handler   Handler
+	peerCheck PeerCheck
+
+	lock    sync.Mutex
+	clients map[net.Conn]bool
+}
+
+// NewServer builds a server. The peer check runs on every new connection, and
+// a rejected client receives an error before its connection closes.
+func NewServer(log *slog.Logger, handler Handler, peerCheck PeerCheck) *Server {
+	return &Server{
+		log:       log,
+		handler:   handler,
+		peerCheck: peerCheck,
+		clients:   map[net.Conn]bool{},
+	}
+}
+
+// ListenUnix creates the socket of the host service. The directory mode is
+// 0700 and the socket mode is 0600, so only this user can reach it.
+func ListenUnix(path string) (net.Listener, error) {
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return nil, err
+	}
+
+	if err := os.Chmod(filepath.Dir(path), 0o700); err != nil {
+		return nil, err
+	}
+
+	if err := os.Remove(path); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return nil, err
+	}
+
+	listener, err := net.Listen("unix", path)
+	if err != nil {
+		return nil, err
+	}
+
+	if err := os.Chmod(path, 0o600); err != nil {
+		listener.Close()
+
+		return nil, err
+	}
+
+	return listener, nil
+}
+
+// Serve accepts connections until the listener closes.
+func (s *Server) Serve(listener net.Listener) error {
+	for {
+		conn, err := listener.Accept()
+		if err != nil {
+			return err
+		}
+
+		go s.serveConn(conn)
+	}
+}
+
+// Close ends every open client connection.
+func (s *Server) Close() {
+	s.lock.Lock()
+	defer s.lock.Unlock()
+
+	for conn := range s.clients {
+		conn.Close()
+	}
+}
+
+func (s *Server) serveConn(conn net.Conn) {
+	s.lock.Lock()
+	s.clients[conn] = true
+	s.lock.Unlock()
+
+	defer func() {
+		s.lock.Lock()
+		delete(s.clients, conn)
+		s.lock.Unlock()
+
+		conn.Close()
+	}()
+
+	if s.peerCheck != nil {
+		unixConn, ok := conn.(*net.UnixConn)
+		if !ok {
+			return
+		}
+
+		if err := s.peerCheck(unixConn); err != nil {
+			s.log.Warn("rejected a client", "err", err)
+
+			writeReply(conn, reply{Error: Interface + ".AccessDenied"})
+
+			return
+		}
+	}
+
+	reader := bufio.NewReader(conn)
+
+	for {
+		message, err := reader.ReadBytes(0)
+		if err != nil {
+			return
+		}
+
+		var call request
+		if err := json.Unmarshal(message[:len(message)-1], &call); err != nil {
+			if err := writeReply(conn, reply{Error: Interface + ".InvalidRequest"}); err != nil {
+				return
+			}
+
+			continue
+		}
+
+		method := strings.TrimPrefix(call.Method, Interface+".")
+
+		answer, callErr := s.handler(context.Background(), method, call.Parameters)
+
+		out := reply{}
+		if callErr != nil {
+			out.Error = callErr.Name
+			if len(callErr.Parameters) > 0 {
+				encoded, err := json.Marshal(callErr.Parameters)
+				if err == nil {
+					out.Parameters = encoded
+				}
+			}
+		} else if answer != nil {
+			encoded, err := json.Marshal(answer)
+			if err != nil {
+				out.Error = Interface + ".InternalError"
+			} else {
+				out.Parameters = encoded
+			}
+		}
+
+		if err := writeReply(conn, out); err != nil {
+			return
+		}
+	}
+}
+
+func writeReply(conn net.Conn, out reply) error {
+	encoded, err := json.Marshal(out)
+	if err != nil {
+		return fmt.Errorf("could not encode a reply: %w", err)
+	}
+
+	_, err = conn.Write(append(encoded, 0))
+
+	return err
+}
diff --git a/internal/varlink/varlink.go b/internal/varlink/varlink.go
