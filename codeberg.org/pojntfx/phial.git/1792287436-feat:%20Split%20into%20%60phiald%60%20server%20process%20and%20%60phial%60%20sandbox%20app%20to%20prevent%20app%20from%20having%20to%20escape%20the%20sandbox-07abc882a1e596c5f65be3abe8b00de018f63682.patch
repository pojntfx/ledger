diff --git a/internal/host/client.go b/internal/host/client.go
new file mode 100644
index 0000000000000000000000000000000000000000..f741b486c634435bd387c6d0d6584940109adf45
--- /dev/null
+++ b/internal/host/client.go
@@ -0,0 +1,316 @@
+package host
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"time"
+
+	"codeberg.org/pojntfx/phial-neo/internal/varlink"
+)
+
+// ErrNotConnected states that the client has no connection to the host
+// service. The window opens before the application connects, so a call
+// reports the missing service instead of a panic.
+var ErrNotConnected = errors.New("the host service is not connected")
+
+// Client is the typed varlink client of the application.
+type Client struct {
+	conn *varlink.Client
+}
+
+// SocketPath states the socket of the host service. A test or a development
+// run points PHIAL_CONTROL_SOCK somewhere else.
+func SocketPath() string {
+	if override := os.Getenv("PHIAL_CONTROL_SOCK"); override != "" {
+		return override
+	}
+
+	dir := os.Getenv("XDG_RUNTIME_DIR")
+	if dir == "" {
+		dir = fmt.Sprintf("/run/user/%d", os.Getuid())
+	}
+
+	return filepath.Join(dir, "phial", "control.sock")
+}
+
+// Dial connects to the host service once.
+func Dial() (*Client, error) {
+	conn, err := varlink.Dial(SocketPath())
+	if err != nil {
+		return nil, err
+	}
+
+	return &Client{conn: conn}, nil
+}
+
+// DialRetry connects to the host service and retries once, because the first
+// connection starts the service through socket activation.
+func DialRetry() (*Client, error) {
+	client, err := Dial()
+	if err == nil {
+		return client, nil
+	}
+
+	time.Sleep(time.Second)
+
+	return Dial()
+}
+
+// Close ends the connection.
+func (c *Client) Close() error {
+	if c == nil || c.conn == nil {
+		return nil
+	}
+
+	return c.conn.Close()
+}
+
+// call sends one request to the host service. A nil client, or a client
+// without a connection, reports ErrNotConnected.
+func (c *Client) call(ctx context.Context, method string, in any, out any) error {
+	if c == nil || c.conn == nil {
+		return ErrNotConnected
+	}
+
+	return c.conn.Call(ctx, method, in, out)
+}
+
+// Info reads the service version, the protocol version, and the feature
+// flags.
+func (c *Client) Info(ctx context.Context) (*InfoResponse, error) {
+	var out InfoResponse
+
+	if err := c.call(ctx, "Info", nil, &out); err != nil {
+		return nil, err
+	}
+
+	return &out, nil
+}
+
+// Status reads the machine states, the root setup state, and the tool state.
+func (c *Client) Status(ctx context.Context) (*StatusResponse, error) {
+	var out StatusResponse
+
+	if err := c.call(ctx, "Status", nil, &out); err != nil {
+		return nil, err
+	}
+
+	return &out, nil
+}
+
+// Acceptance runs the fixed acceptance tests.
+func (c *Client) Acceptance(ctx context.Context) (*AcceptanceResponse, error) {
+	var out AcceptanceResponse
+
+	if err := c.call(ctx, "Acceptance", nil, &out); err != nil {
+		return nil, err
+	}
+
+	return &out, nil
+}
+
+// Folders sets the configuration, data, and SSH host paths.
+func (c *Client) Folders(ctx context.Context, config, data, ssh string) error {
+	return c.call(ctx, "Folders", FoldersRequest{Config: config, Data: data, SSH: ssh}, nil)
+}
+
+// VMList lists the machines.
+func (c *Client) VMList(ctx context.Context) (*StatusResponse, error) {
+	var out StatusResponse
+
+	if err := c.call(ctx, "VMList", nil, &out); err != nil {
+		return nil, err
+	}
+
+	return &out, nil
+}
+
+// VMStart starts one machine.
+func (c *Client) VMStart(ctx context.Context, name string) error {
+	return c.call(ctx, "VMStart", NameRequest{Name: name}, nil)
+}
+
+// VMStop stops one machine. A machine that still installs cancels the
+// install.
+func (c *Client) VMStop(ctx context.Context, name string) error {
+	return c.call(ctx, "VMStop", NameRequest{Name: name}, nil)
+}
+
+// VMRestart restarts one machine.
+func (c *Client) VMRestart(ctx context.Context, name string) error {
+	return c.call(ctx, "VMRestart", NameRequest{Name: name}, nil)
+}
+
+// VMProvision provisions one machine. A machine that is not installed
+// installs first, so this call also runs the install.
+func (c *Client) VMProvision(ctx context.Context, name string) (*StateResponse, error) {
+	var out StateResponse
+
+	if err := c.call(ctx, "VMProvision", NameRequest{Name: name}, &out); err != nil {
+		return nil, err
+	}
+
+	return &out, nil
+}
+
+// VMLog reads the log of one machine.
+func (c *Client) VMLog(ctx context.Context, name string) (*LogResponse, error) {
+	var out LogResponse
+
+	if err := c.call(ctx, "VMLog", NameRequest{Name: name}, &out); err != nil {
+		return nil, err
+	}
+
+	return &out, nil
+}
+
+// VMMetrics reads the live usage of one machine.
+func (c *Client) VMMetrics(ctx context.Context, name string) (*MetricsResponse, error) {
+	var out MetricsResponse
+
+	if err := c.call(ctx, "VMMetrics", NameRequest{Name: name}, &out); err != nil {
+		return nil, err
+	}
+
+	return &out, nil
+}
+
+// VMDisplay reads the display channel of one machine.
+func (c *Client) VMDisplay(ctx context.Context, name string) (*DisplayResponse, error) {
+	var out DisplayResponse
+
+	if err := c.call(ctx, "VMDisplay", DisplayRequest{Name: name}, &out); err != nil {
+		return nil, err
+	}
+
+	return &out, nil
+}
+
+// VMDisplayApps lists the applications of the guest of one machine.
+func (c *Client) VMDisplayApps(ctx context.Context, name string) (*DisplayResponse, error) {
+	var out DisplayResponse
+
+	if err := c.call(ctx, "VMDisplay", DisplayRequest{Name: name, ListApps: true}, &out); err != nil {
+		return nil, err
+	}
+
+	return &out, nil
+}
+
+// VMDisplayRun starts one application in the guest of one machine.
+func (c *Client) VMDisplayRun(ctx context.Context, name, command, mode string) error {
+	return c.call(ctx, "VMDisplay", DisplayRequest{Name: name, Run: command, Mode: mode}, nil)
+}
+
+// SSHKeyList lists the keys of the session agent.
+func (c *Client) SSHKeyList(ctx context.Context) (*SSHKeyListResponse, error) {
+	var out SSHKeyListResponse
+
+	if err := c.call(ctx, "SSHKeyList", nil, &out); err != nil {
+		return nil, err
+	}
+
+	return &out, nil
+}
+
+// SSHKeyImport loads the content of one private key into the session agent.
+func (c *Client) SSHKeyImport(ctx context.Context, name, contentBase64 string) error {
+	return c.call(ctx, "SSHKeyImport", SSHKeyImportRequest{Name: name, ContentBase64: contentBase64}, nil)
+}
+
+// SSHKeyGenerate makes a new key pair in the managed SSH folder and loads it.
+func (c *Client) SSHKeyGenerate(ctx context.Context, comment string) error {
+	return c.call(ctx, "SSHKeyGenerate", SSHKeyGenerateRequest{Comment: comment}, nil)
+}
+
+// SSHKeyRemove drops one key from the session agent.
+func (c *Client) SSHKeyRemove(ctx context.Context, comment string) error {
+	return c.call(ctx, "SSHKeyRemove", NameRequest{Name: comment}, nil)
+}
+
+// GPGKeyList lists the secret keys of the host agent.
+func (c *Client) GPGKeyList(ctx context.Context) (*GPGKeyListResponse, error) {
+	var out GPGKeyListResponse
+
+	if err := c.call(ctx, "GPGKeyList", nil, &out); err != nil {
+		return nil, err
+	}
+
+	return &out, nil
+}
+
+// GPGKeyImport imports the content of one key file into the host keyring.
+func (c *Client) GPGKeyImport(ctx context.Context, contentBase64 string) error {
+	return c.call(ctx, "GPGKeyImport", GPGKeyImportRequest{ContentBase64: contentBase64}, nil)
+}
+
+// GPGKeyGenerate makes a new key in the host keyring.
+func (c *Client) GPGKeyGenerate(ctx context.Context, name, email string) error {
+	return c.call(ctx, "GPGKeyGenerate", GPGKeyGenerateRequest{Name: name, Email: email}, nil)
+}
+
+// GPGKeyRemove deletes the secret part of one key.
+func (c *Client) GPGKeyRemove(ctx context.Context, fingerprint string) error {
+	return c.call(ctx, "GPGKeyRemove", FingerprintRequest{Fingerprint: fingerprint}, nil)
+}
+
+// SecretList lists the secrets of the host secret service.
+func (c *Client) SecretList(ctx context.Context) (*SecretListResponse, error) {
+	var out SecretListResponse
+
+	if err := c.call(ctx, "SecretList", nil, &out); err != nil {
+		return nil, err
+	}
+
+	return &out, nil
+}
+
+// SecretSet stores one secret. An empty value keeps the stored one.
+func (c *Client) SecretSet(ctx context.Context, name, mode, upstream, value string) error {
+	return c.call(ctx, "SecretSet", SecretSetRequest{Name: name, Mode: mode, Upstream: upstream, Value: value}, nil)
+}
+
+// SecretRemove removes one secret.
+func (c *Client) SecretRemove(ctx context.Context, name string) error {
+	return c.call(ctx, "SecretRemove", NameRequest{Name: name}, nil)
+}
+
+// USBList lists the USB devices and the xHCI controllers of the host.
+func (c *Client) USBList(ctx context.Context) (*USBListResponse, error) {
+	var out USBListResponse
+
+	if err := c.call(ctx, "USBList", nil, &out); err != nil {
+		return nil, err
+	}
+
+	return &out, nil
+}
+
+// USBAttach passes one USB device to one machine.
+func (c *Client) USBAttach(ctx context.Context, machine, device string) error {
+	return c.call(ctx, "USBAttach", USBDeviceRequest{Machine: machine, Device: device}, nil)
+}
+
+// USBDetach removes one USB device from one machine.
+func (c *Client) USBDetach(ctx context.Context, machine, device string) error {
+	return c.call(ctx, "USBDetach", USBDeviceRequest{Machine: machine, Device: device}, nil)
+}
+
+// USBVfioBind binds one xHCI controller to vfio-pci through run0.
+func (c *Client) USBVfioBind(ctx context.Context, address string) error {
+	return c.call(ctx, "USBVfioBind", VfioRequest{Address: address}, nil)
+}
+
+// USBVfioRestore restores one xHCI controller to its host driver through
+// run0.
+func (c *Client) USBVfioRestore(ctx context.Context, address string) error {
+	return c.call(ctx, "USBVfioRestore", VfioRequest{Address: address}, nil)
+}
+
+// RootSetup runs the fixed one-time host setup through run0.
+func (c *Client) RootSetup(ctx context.Context) error {
+	return c.call(ctx, "RootSetup", nil, nil)
+}
diff --git a/internal/host/types.go b/internal/host/types.go
new file mode 100644
index 0000000000000000000000000000000000000000..fa2c8c8f88c7ae406fd5f1d6d8a327c1585311e6
--- /dev/null
+++ b/internal/host/types.go
@@ -0,0 +1,265 @@
+// Package host is the varlink client of the host service. The application
+// uses it for every host resource that the sandbox cannot reach, and the
+// host service uses the same types on its side of the socket.
+package host
+
+// InfoResponse answers the Info call.
+type InfoResponse struct {
+	Version  string   `json:"version"`
+	Protocol int      `json:"protocol"`
+	Features []string `json:"features"`
+}
+
+// InstallState states the progress of one running install.
+type InstallState struct {
+	Steps         []string `json:"steps"`
+	Current       int      `json:"current"`
+	Done          bool     `json:"done"`
+	Failed        string   `json:"failed,omitempty"`
+	Detail        string   `json:"detail,omitempty"`
+	Downloaded    int64    `json:"downloaded,omitempty"`
+	Total         int64    `json:"total,omitempty"`
+	Packages      int      `json:"packages,omitempty"`
+	PackagesTotal int      `json:"packages_total,omitempty"`
+	PackageName   string   `json:"package_name,omitempty"`
+}
+
+// MachineState states one machine.
+type MachineState struct {
+	Name          string        `json:"name"`
+	State         string        `json:"state"`
+	Ready         bool          `json:"ready"`
+	Installed     bool          `json:"installed"`
+	Installing    bool          `json:"installing"`
+	Install       *InstallState `json:"install,omitempty"`
+	AgentOutdated bool          `json:"agent_outdated"`
+}
+
+// StatusItem is one line of the root setup state.
+type StatusItem struct {
+	Name  string `json:"name"`
+	Value string `json:"value"`
+}
+
+// ToolState states one host tool.
+type ToolState struct {
+	Name    string `json:"name"`
+	Path    string `json:"path"`
+	Present bool   `json:"present"`
+	Version string `json:"version,omitempty"`
+}
+
+// StatusResponse answers the Status call: the machine states, the root setup
+// state, and the tool state.
+type StatusResponse struct {
+	Machines  []MachineState `json:"machines"`
+	RootSetup []StatusItem   `json:"root_setup"`
+	Tools     []ToolState    `json:"tools"`
+
+	// HugePages states the bytes that the host can still back with huge pages
+	// and the bytes that it has reserved in total.
+	HugePagesFree  int64 `json:"hugepages_free"`
+	HugePagesTotal int64 `json:"hugepages_total"`
+}
+
+// InstallSteps is the fixed step list of the installer.
+func InstallSteps() []string {
+	return []string{
+		"Downloading the installer",
+		"Starting the installer",
+		"Running pre-installation scripts",
+		"Installing packages",
+		"Running post-installation scripts",
+		"Configuring the system",
+		"Finishing the installation",
+	}
+}
+
+// AcceptanceCheck is one result of the fixed acceptance tests.
+type AcceptanceCheck struct {
+	Name string `json:"name"`
+	OK   bool   `json:"ok"`
+	Note string `json:"note,omitempty"`
+}
+
+// AcceptanceResponse answers the Acceptance call.
+type AcceptanceResponse struct {
+	Checks []AcceptanceCheck `json:"checks"`
+}
+
+// FoldersRequest sets the configuration, data, and SSH host paths.
+type FoldersRequest struct {
+	Config string `json:"config"`
+	Data   string `json:"data"`
+	SSH    string `json:"ssh"`
+}
+
+// NameRequest names one machine or one entry.
+type NameRequest struct {
+	Name string `json:"name"`
+}
+
+// StateResponse answers a state change call.
+type StateResponse struct {
+	State string `json:"state"`
+}
+
+// LogResponse answers the VMLog call.
+type LogResponse struct {
+	Log string `json:"log"`
+}
+
+// MetricsResponse answers the VMMetrics call.
+type MetricsResponse struct {
+	VCPUs          int     `json:"vcpus"`
+	CPUPercent     float64 `json:"cpu_percent"`
+	MemoryUsed     int64   `json:"memory_used"`
+	MemoryTotal    int64   `json:"memory_total"`
+	DiskAllocated  int64   `json:"disk_allocated"`
+	DiskTotal      int64   `json:"disk_total"`
+	DiskReadRate   float64 `json:"disk_read_rate"`
+	DiskWriteRate  float64 `json:"disk_write_rate"`
+	NetworkReady   bool    `json:"network_ready"`
+	NetworkRxRate  float64 `json:"network_rx_rate"`
+	NetworkTxRate  float64 `json:"network_tx_rate"`
+	GPU            string  `json:"gpu"`
+	GPUBusyReady   bool    `json:"gpu_busy_ready"`
+	GPUBusyPercent float64 `json:"gpu_busy_percent"`
+	AgentOutdated  bool    `json:"agent_outdated"`
+}
+
+// DisplayRequest operates the display channel of one machine. With ListApps
+// it lists the guest applications, and with Run it starts one guest
+// application through the fixed display workflow.
+type DisplayRequest struct {
+	Name     string `json:"name"`
+	ListApps bool   `json:"list_apps,omitempty"`
+	Run      string `json:"run,omitempty"`
+	Mode     string `json:"mode,omitempty"`
+}
+
+// GuestApp is one application that the guest lists.
+type GuestApp struct {
+	ID   string `json:"id"`
+	Name string `json:"name"`
+	Exec string `json:"exec"`
+}
+
+// DisplayResponse answers the VMDisplay call.
+type DisplayResponse struct {
+	Socket      string     `json:"socket"`
+	RdpAddress  string     `json:"rdp_address"`
+	RdpURI      string     `json:"rdp_uri"`
+	RdpPassword string     `json:"rdp_password"`
+	Apps        []GuestApp `json:"apps,omitempty"`
+}
+
+// SSHKey is one key of the session agent.
+type SSHKey struct {
+	Comment     string `json:"comment"`
+	Fingerprint string `json:"fingerprint"`
+	Type        string `json:"type"`
+}
+
+// SSHKeyListResponse answers the SSHKeyList call.
+type SSHKeyListResponse struct {
+	Keys []SSHKey `json:"keys"`
+}
+
+// SSHKeyImportRequest carries the content of one private key. The application
+// never sends a file path, and the service writes the key into the managed
+// SSH folder.
+type SSHKeyImportRequest struct {
+	Name          string `json:"name"`
+	ContentBase64 string `json:"content_base64"`
+}
+
+// SSHKeyGenerateRequest names one new key pair.
+type SSHKeyGenerateRequest struct {
+	Comment string `json:"comment"`
+}
+
+// GPGKey is one secret key of the host agent.
+type GPGKey struct {
+	Fingerprint string `json:"fingerprint"`
+	Keygrip     string `json:"keygrip"`
+	UID         string `json:"uid"`
+	Expires     string `json:"expires"`
+}
+
+// GPGKeyListResponse answers the GPGKeyList call.
+type GPGKeyListResponse struct {
+	Keys []GPGKey `json:"keys"`
+}
+
+// GPGKeyImportRequest carries the content of one key file. The service writes
+// it to a private temporary file, imports it with a fixed gpg call, and
+// removes the file after the import.
+type GPGKeyImportRequest struct {
+	ContentBase64 string `json:"content_base64"`
+}
+
+// GPGKeyGenerateRequest names one new key.
+type GPGKeyGenerateRequest struct {
+	Name  string `json:"name"`
+	Email string `json:"email"`
+}
+
+// FingerprintRequest names one GPG key.
+type FingerprintRequest struct {
+	Fingerprint string `json:"fingerprint"`
+}
+
+// SecretInfo is one secret of the host secret service.
+type SecretInfo struct {
+	Name     string `json:"name"`
+	Mode     string `json:"mode"`
+	Upstream string `json:"upstream"`
+	Stored   bool   `json:"stored"`
+}
+
+// SecretListResponse answers the SecretList call.
+type SecretListResponse struct {
+	Secrets []SecretInfo `json:"secrets"`
+}
+
+// SecretSetRequest stores one secret. An empty value keeps the stored one.
+type SecretSetRequest struct {
+	Name     string `json:"name"`
+	Mode     string `json:"mode"`
+	Upstream string `json:"upstream"`
+	Value    string `json:"value,omitempty"`
+}
+
+// USBDevice is one USB device of the host.
+type USBDevice struct {
+	ID         string `json:"id"`
+	Name       string `json:"name"`
+	Attached   bool   `json:"attached"`
+	AttachedTo string `json:"attached_to,omitempty"`
+}
+
+// USBHub is one xHCI controller of the host.
+type USBHub struct {
+	Address string `json:"address"`
+	Name    string `json:"name"`
+	InUse   bool   `json:"in_use"`
+}
+
+// USBListResponse answers the USBList call.
+type USBListResponse struct {
+	Devices []USBDevice `json:"devices"`
+	Hubs    []USBHub    `json:"hubs"`
+}
+
+// USBDeviceRequest attaches or detaches one USB device of one machine.
+type USBDeviceRequest struct {
+	Machine string `json:"machine"`
+	Device  string `json:"device"`
+}
+
+// VfioRequest names one PCI address for the vfio-bind and vfio-restore
+// subcommands.
+type VfioRequest struct {
+	Address string `json:"address"`
+}
diff --git a/internal/host/update.go b/internal/host/update.go
new file mode 100644
index 0000000000000000000000000000000000000000..382d2ebd434fc4dc0799b6237e7aae5c5b28f38e
--- /dev/null
+++ b/internal/host/update.go
@@ -0,0 +1,107 @@
+package host
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+
+	"codeberg.org/pojntfx/phial-neo/internal/hostsvc"
+	"codeberg.org/pojntfx/phial-neo/internal/varlink"
+	"codeberg.org/pojntfx/phial-neo/internal/version"
+)
+
+// EmbeddedVersion states the version of the embedded phiald. The application
+// embeds the service at build time, so both carry the version of the tree.
+func EmbeddedVersion() string {
+	return version.App
+}
+
+// Embedded reports whether the application carries a service binary.
+func Embedded() bool {
+	return len(hostsvc.Binary) > 0
+}
+
+// NeedsUpdate reports whether the running service is older than the embedded
+// one, so that the application shows the update toast.
+func NeedsUpdate(info *InfoResponse) bool {
+	if info == nil || info.Version == "" {
+		return false
+	}
+
+	return info.Version != EmbeddedVersion() || info.Protocol != varlink.ProtocolVersion
+}
+
+// UpdateCommand states the host command that re-installs the embedded service
+// and restarts it. The update command is the install command without the
+// folder arguments, and the application never runs it; the toast carries a
+// Copy Command action.
+func UpdateCommand() string {
+	return InstallCommand("", "", "")
+}
+
+// InstallCommand states the host install command. With folders it is the
+// install command, without them it is the update command.
+func InstallCommand(config, data, ssh string) string {
+	binary := "phial"
+
+	if os.Getenv("FLATPAK_ID") != "" {
+		binary = "$(flatpak info --show-location com.pojtinger.felicitas.Phial)/files/bin/phial"
+	} else if self, err := os.Executable(); err == nil {
+		binary = shellQuote(self)
+	}
+
+	command := binary + " host-install"
+
+	if config != "" {
+		command += " --config " + shellQuote(config)
+	}
+	if data != "" {
+		command += " --data " + shellQuote(data)
+	}
+	if ssh != "" {
+		command += " --ssh " + shellQuote(ssh)
+	}
+
+	return command
+}
+
+// ServicePath states where the install command extracts the embedded phiald.
+func ServicePath() string {
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return filepath.Join("~", ".local", "bin", "phiald")
+	}
+
+	return filepath.Join(home, ".local", "bin", "phiald")
+}
+
+// RootSetupCommand states the fixed root setup call. The service runs it
+// through run0, and the user approves the call with polkit. run0 starts the
+// command from the system manager, which an SELinux host denies the execute
+// permission on a binary in the home folder, so a shell starts the binary.
+func RootSetupCommand() string {
+	return "run0 /bin/sh -c 'exec \"$0\" root-setup' " + shellQuote(ServicePath())
+}
+
+// shellQuote wraps a value so that a shell reads it as one word.
+func shellQuote(value string) string {
+	if value == "" {
+		return "''"
+	}
+
+	needs := false
+	for _, r := range value {
+		switch {
+		case r >= 'a' && r <= 'z', r >= 'A' && r <= 'Z', r >= '0' && r <= '9':
+		case r == '/', r == '.', r == '-', r == '_', r == ':', r == ',', r == '=', r == '@', r == '%', r == '+':
+		default:
+			needs = true
+		}
+	}
+
+	if !needs {
+		return value
+	}
+
+	return "'" + strings.ReplaceAll(value, "'", `'\''`) + "'"
+}
diff --git a/internal/host/update_test.go b/internal/host/update_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..ab4062c2981bfde2d72b213b7a31dddb74a04192
--- /dev/null
+++ b/internal/host/update_test.go
@@ -0,0 +1,67 @@
+package host
+
+import (
+	"strings"
+	"testing"
+
+	"codeberg.org/pojntfx/phial-neo/internal/varlink"
+)
+
+func TestNeedsUpdateComparesVersions(t *testing.T) {
+	// A matching version and protocol needs no update.
+	info := &InfoResponse{Version: EmbeddedVersion(), Protocol: varlink.ProtocolVersion}
+	if NeedsUpdate(info) {
+		t.Fatal("a matching version asked for an update")
+	}
+
+	// A different version needs an update.
+	info = &InfoResponse{Version: "0.0.1", Protocol: varlink.ProtocolVersion}
+	if !NeedsUpdate(info) {
+		t.Fatal("an old version did not ask for an update")
+	}
+
+	// A different protocol needs an update.
+	info = &InfoResponse{Version: EmbeddedVersion(), Protocol: varlink.ProtocolVersion + 1}
+	if !NeedsUpdate(info) {
+		t.Fatal("an old protocol did not ask for an update")
+	}
+
+	// No service means no update.
+	if NeedsUpdate(nil) {
+		t.Fatal("no service asked for an update")
+	}
+}
+
+func TestUpdateCommandHasNoFolders(t *testing.T) {
+	command := UpdateCommand()
+
+	if strings.Contains(command, "--config") || strings.Contains(command, "--data") || strings.Contains(command, "--ssh") {
+		t.Fatalf("the update command %q carries folders", command)
+	}
+
+	if !strings.Contains(command, "host-install") {
+		t.Fatalf("the update command %q does not run host-install", command)
+	}
+}
+
+func TestInstallCommandCarriesFolders(t *testing.T) {
+	command := InstallCommand("/a", "/b", "/c")
+
+	for _, want := range []string{"--config /a", "--data /b", "--ssh /c"} {
+		if !strings.Contains(command, want) {
+			t.Fatalf("the install command %q does not carry %q", command, want)
+		}
+	}
+}
+
+func TestShellQuoteWrapsSpaces(t *testing.T) {
+	got := shellQuote("a b")
+	if got != "'a b'" {
+		t.Fatalf("shellQuote() = %q, want %q", got, "'a b'")
+	}
+
+	got = shellQuote("plain")
+	if got != "plain" {
+		t.Fatalf("shellQuote() = %q, want %q", got, "plain")
+	}
+}
