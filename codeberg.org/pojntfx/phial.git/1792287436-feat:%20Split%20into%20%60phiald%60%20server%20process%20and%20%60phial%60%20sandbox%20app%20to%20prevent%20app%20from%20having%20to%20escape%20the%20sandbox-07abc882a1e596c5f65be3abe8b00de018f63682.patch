From 07abc882a1e596c5f65be3abe8b00de018f63682 Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Sat, 17 Oct 2026 18:37:16 -0700
Subject: [PATCH] feat: Split into `phiald` server process and `phial` sandbox app to prevent app from having to escape the sandbox
---
diff --git a/Makefile b/Makefile
index b4444d852f1456fffe6b801b7a71502bd802a1e6..14e6243ccc5441b566aae4a7c5025096bdcbd25c 100644
--- a/Makefile
+++ b/Makefile
@@ -2,14 +2,16 @@ export PATH := /home/linuxbrew/.linuxbrew/bin:$(PATH)
 
 .PHONY: build generate install test acceptance ui-test wizard-test pot flatpak flatpak-lint clean
 
-GUEST_AGENT := internal/guest/agent/phial
-HOST_BINARY := bin/phial-host
+GUEST_AGENT := cmd/phiald/guest/agent/phial
+PHIALD := internal/hostsvc/phiald
+PHIALD_BINARY := bin/phiald
 
 build:
 	: > $(GUEST_AGENT)
 	CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o $(GUEST_AGENT) .
+	CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o $(PHIALD) ./cmd/phiald
