new file mode 100644
index 0000000000000000000000000000000000000000..b0d6a767d361a955b203d9aec909468745d7fca8
--- /dev/null
+++ b/internal/state/remote.go
@@ -0,0 +1,168 @@
+package state
+
+import (
+	"context"
+	"encoding/base64"
+	"log/slog"
+	"os"
+
+	"codeberg.org/pojntfx/phial-neo/internal/host"
+	"codeberg.org/pojntfx/phial-neo/internal/paths"
+)
+
+// NewRemoteClient builds a state client that reaches the host operations over
+// the varlink socket of the host service. The application runs in a Flatpak
+// sandbox with one static permission, so the host service runs the keys, the
+// secrets, and the tools on its behalf. The grant store stays local, because
+// the grant files live in the shared runtime folder.
+func NewRemoteClient(log *slog.Logger, remote *host.Client) *Client {
+	client := &Client{log: log, remote: remote}
+	client.Reload()
+
+	return client
+}
+
+// Remote reports whether the client reaches the host service instead of the
+// host operations directly.
+func (c *Client) Remote() bool {
+	return c.remote != nil
+}
+
+// Host returns the varlink client of the host service, so that the MCP server
+// and the window can call the same host actions.
+func (c *Client) Host() *host.Client {
+	return c.remote
+}
+
+// SSHHostDir states the SSH folder of the host install. The application reads
+// the key file through the folder that the user chose.
+func (c *Client) SSHHostDir() string {
+	if override := os.Getenv("PHIAL_SSH_DIR"); override != "" {
+		return override
+	}
+
+	return paths.SSH().HostPath()
+}
+
+// EnsureRemote connects the client to the host service when it is not
+// already connected. The application calls it once at startup.
+func (c *Client) EnsureRemote(log *slog.Logger) error {
+	if c.remote != nil {
+		return nil
+	}
+
+	remote, err := host.DialRetry()
+	if err != nil {
+		return err
+	}
+
+	c.remote = remote
+
+	return nil
+}
+
+// The secret operations delegate to the host service. The application never
+// reaches the secret service of the session itself.
+func (c *Client) ListSSHKeysRemote() ([]SSHKey, error) {
+	response, err := c.remote.SSHKeyList(context.Background())
+	if err != nil {
+		return nil, err
+	}
+
+	keys := []SSHKey{}
+	for _, key := range response.Keys {
+		keys = append(keys, SSHKey{
+			Comment:     key.Comment,
+			Fingerprint: key.Fingerprint,
+			Type:        key.Type,
+		})
+	}
+
+	return keys, nil
+}
+
+func (c *Client) addSSHKeyRemote(name string, content []byte) error {
+	return c.remote.SSHKeyImport(context.Background(), name, base64.StdEncoding.EncodeToString(content))
+}
+
+func (c *Client) generateSSHKeyRemote(comment string) error {
+	return c.remote.SSHKeyGenerate(context.Background(), comment)
+}
+
+func (c *Client) removeSSHKeyRemote(comment string) error {
+	return c.remote.SSHKeyRemove(context.Background(), comment)
+}
+
+func (c *Client) listGPGKeysRemote() ([]GPGKey, error) {
+	response, err := c.remote.GPGKeyList(context.Background())
+	if err != nil {
+		return nil, err
+	}
+
+	keys := []GPGKey{}
+	for _, key := range response.Keys {
+		keys = append(keys, GPGKey{
+			Fingerprint: key.Fingerprint,
+			Keygrip:     key.Keygrip,
+			UID:         key.UID,
+			Expires:     key.Expires,
+		})
+	}
+
+	return keys, nil
+}
+
+func (c *Client) addGPGKeyRemote(content []byte) error {
+	return c.remote.GPGKeyImport(context.Background(), base64.StdEncoding.EncodeToString(content))
+}
+
+func (c *Client) generateGPGKeyRemote(name, email string) error {
+	return c.remote.GPGKeyGenerate(context.Background(), name, email)
+}
+
+func (c *Client) removeGPGKeyRemote(fingerprint string) error {
+	return c.remote.GPGKeyRemove(context.Background(), fingerprint)
+}
+
+func (c *Client) storedSecretsRemote() ([]string, error) {
+	response, err := c.remote.SecretList(context.Background())
+	if err != nil {
+		return nil, err
+	}
+
+	names := []string{}
+	for _, secret := range response.Secrets {
+		names = append(names, secret.Name)
+	}
+
+	return names, nil
+}
+
+func (c *Client) hasSecretRemote(r Row) bool {
+	response, err := c.remote.SecretList(context.Background())
+	if err != nil {
+		return false
+	}
+
+	for _, secret := range response.Secrets {
+		if secret.Name == r.Name {
+			return secret.Stored
+		}
+	}
+
+	return false
+}
+
+func (c *Client) storeSecretRemote(r Row, value string) error {
+	return c.remote.SecretSet(context.Background(), r.Name, r.Mode, r.Upstream, value)
+}
+
+func (c *Client) deleteSecretRemote(name string) error {
+	return c.remote.SecretRemove(context.Background(), name)
+}
+
+// remoteSSHFolder states the SSH folder of the host install. The application
+// reads the key file through the folder that the user chose.
+func remoteSSHFolder() string {
+	return os.Getenv("PHIAL_SSH_DIR")
+}
