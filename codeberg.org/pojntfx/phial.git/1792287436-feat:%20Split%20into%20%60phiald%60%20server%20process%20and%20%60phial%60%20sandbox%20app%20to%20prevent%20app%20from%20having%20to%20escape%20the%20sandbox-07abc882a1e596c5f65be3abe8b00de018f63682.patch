-[Install]
-WantedBy=default.target
diff --git a/host/systemd/phiald.service b/host/systemd/phiald.service
new file mode 100644
index 0000000000000000000000000000000000000000..b465461b47670457c9f323a00a14a90190c6d997
--- /dev/null
+++ b/host/systemd/phiald.service
@@ -0,0 +1,15 @@
+[Unit]
+Description=Phial host service
+Documentation=https://codeberg.org/pojntfx/phial-neo
+Requires=phiald.socket
+After=phiald.socket
+
+[Service]
+Type=simple
+ExecStart=%h/.local/bin/phiald
+Environment=SSH_ASKPASS=/usr/bin/pinentry-gnome3
+Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
+Restart=on-failure
+
+[Install]
+WantedBy=default.target
