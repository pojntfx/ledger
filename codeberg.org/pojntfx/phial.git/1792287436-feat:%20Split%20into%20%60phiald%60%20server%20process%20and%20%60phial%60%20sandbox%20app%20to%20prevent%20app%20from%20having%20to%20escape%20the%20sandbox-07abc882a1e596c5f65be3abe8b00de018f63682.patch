new file mode 100644
index 0000000000000000000000000000000000000000..c897739a29c98d0092c23ff9c95c31d077736cb7
--- /dev/null
+++ b/internal/portals/portals_test.go
@@ -0,0 +1,23 @@
+package portals
+
+import (
+	"testing"
+)
+
+// TestBackgroundAvailableNeverPanics covers the exit fallback. The
+// application exits when the Background portal is missing, so the availability
+// check must answer false without panicking when the portal is absent.
+func TestBackgroundAvailableNeverPanics(t *testing.T) {
+	_ = BackgroundAvailable()
+}
+
+// TestEnableAutostartReportsTheMissingPortal covers the autostart call. The
+// application registers autostart through the Background portal, and a missing
+// portal reports an error instead of a panic.
+func TestEnableAutostartReportsTheMissingPortal(t *testing.T) {
+	if !BackgroundAvailable() {
+		if err := EnableAutostart("com.pojtinger.felicitas.Phial", []string{"phial", "--background"}); err == nil {
+			t.Fatal("autostart succeeded without the Background portal")
+		}
+	}
+}
