--- a/internal/portals/portals.go
+++ b/internal/portals/portals.go
@@ -9,7 +9,66 @@ 	"strings"
 
 	"github.com/godbus/dbus/v5"
 	"github.com/rymdport/portal/filechooser"
+	"github.com/rymdport/portal/openuri"
 )
+
+// OpenURI opens one URI with the default handler of the desktop through the
+// OpenURI portal. The file manager and the RDP client use it.
+func OpenURI(uri string) error {
+	return openuri.OpenURI("", uri, nil)
+}
+
+const (
+	portalService       = "org.freedesktop.portal.Desktop"
+	backgroundPath      = dbus.ObjectPath("/org/freedesktop/portal/desktop")
+	backgroundInterface = "org.freedesktop.portal.Background"
+)
+
+// BackgroundAvailable reports whether the Background portal is present. The
+// application exits when the portal is missing, because it autostarts at login
+// through the portal. The desktop portal owns the bus name, and the Background
+// interface is one of its interfaces.
+func BackgroundAvailable() bool {
+	connection, err := dbus.SessionBus()
+	if err != nil {
+		return false
+	}
+	defer connection.Close()
+
+	var owner string
+	if err := connection.BusObject().Call("org.freedesktop.DBus.GetNameOwner", 0, portalService).Store(&owner); err != nil {
+		return false
+	}
+
+	return owner != ""
+}
+
+// EnableAutostart registers the application to start at login through the
+// Background portal. The command line names the binary that starts the
+// application in the background.
+func EnableAutostart(appID string, commandline []string) error {
+	connection, err := dbus.SessionBus()
+	if err != nil {
+		return fmt.Errorf("reach the Background portal: %w", err)
+	}
+	defer connection.Close()
+
+	options := map[string]dbus.Variant{}
+
+	var handle dbus.ObjectPath
+	if err := connection.Object(portalService, backgroundPath).Call(
+		backgroundInterface+".EnableAutostart",
+		0,
+		"",
+		appID,
+		commandline,
+		options,
+	).Store(&handle); err != nil {
+		return fmt.Errorf("ask the Background portal for autostart: %w", err)
+	}
+
+	return nil
+}
 
