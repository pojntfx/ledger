diff --git a/internal/machine/accessors.go b/internal/machine/accessors.go
new file mode 100644
index 0000000000000000000000000000000000000000..1d3d78c0969731ad01c77dbfc8d1d1b6cfc4a30a
--- /dev/null
+++ b/internal/machine/accessors.go
@@ -0,0 +1,201 @@
+package machine
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+
+	"codeberg.org/pojntfx/phial-neo/internal/paths"
+)
+
+// sshKeyName states the key that the machine aliases use.
+const sshKeyName = "id_ed25519"
+
+// RdpPortValue states the forwarded desktop port of the machine.
+func (d Definition) RdpPortValue() int {
+	return 3389 + int(d.GuestCIDValue())
+}
+
+// RdpAddress states the loopback address of the forwarded desktop.
+func (d Definition) RdpAddress() string {
+	return fmt.Sprintf("localhost:%d", d.RdpPortValue())
+}
+
+// RdpURI states the desktop link of the machine.
+func (d Definition) RdpURI() string {
+	return "rdp://phial@" + d.RdpAddress()
+}
+
+// ShareTag names the mount tag of one shared folder.
+func ShareTag(path string) string {
+	tag := filepath.Base(filepath.Clean(path))
+
+	var builder strings.Builder
+
+	for _, r := range tag {
+		switch {
+		case r >= 'a' && r <= 'z', r >= '0' && r <= '9', r == '-', r == '_':
+			builder.WriteRune(r)
+		case r >= 'A' && r <= 'Z':
+			builder.WriteRune(r + 32)
+		default:
+			builder.WriteRune('-')
+		}
+	}
+
+	result := strings.Trim(builder.String(), "-")
+
+	if result == "" {
+		return "share"
+	}
+
+	return result
+}
+
+// ShareTarget states where the machine mounts one shared folder.
+func (d Definition) ShareTarget(share string) string {
+	if target := d.ShareTargets[share]; target != "" {
+		return target
+	}
+
+	return "/mnt/" + ShareTag(share)
+}
+
+// ShareReadOnly reports whether the machine mounts the shared folder for
+// reading only.
+func (d Definition) ShareReadOnly(share string) bool {
+	return slices.Contains(d.ReadOnlyShares, share)
+}
+
+// SSHConfigPath states the configuration that carries one host alias per
+// machine.
+func SSHConfigPath() string {
+	return filepath.Join(ConfigDir(), "ssh_config")
+}
+
+// SSHConfigText states the configuration of every machine, which points ssh
+// at the agent of the session.
+func SSHConfigText(defs []Definition) string {
+	var builder strings.Builder
+	builder.WriteString("# Generated by phial. Do not edit.\n\n")
+
+	for _, def := range defs {
+		// The configuration names no agent, so ssh uses the agent of the
+		// session, which is the agent of the user, and that agent asks for the
+		// passphrase of the key on the first signature.
+		fmt.Fprintf(&builder,
+			"Host %s\n    User phial\n    ProxyCommand socat - VSOCK-CONNECT:%d:2222\n    IdentityFile %s\n    IdentitiesOnly yes\n    StrictHostKeyChecking accept-new\n    ServerAliveInterval 5\n    ServerAliveCountMax 3\n\n",
+			def.Name, def.GuestCIDValue(), filepath.Join(paths.SSH().HostPath(), sshKeyName))
+	}
+
+	return builder.String()
+}
+
+// WriteSSHConfig writes the host alias configuration of every machine.
+func WriteSSHConfig() error {
+	defs, err := List()
+	if err != nil {
+		return err
+	}
+
+	path := SSHConfigPath()
+
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return err
+	}
+
+	return os.WriteFile(path, []byte(SSHConfigText(defs)), 0o600)
+}
+
+const (
+	sshIncludeStart = "# >>> phial >>>"
+	sshIncludeEnd   = "# <<< phial <<<"
+)
+
+func SSHIncludeText() string {
+	return "\n" + sshIncludeStart + "\nInclude " + filepath.Join(paths.Config().HostPath(), "ssh_config") + "\n" + sshIncludeEnd + "\n"
+}
+
+func EnsureSSHInclude() error {
+	if strings.TrimSpace(paths.Config().HostPath()) == "" {
+		return fmt.Errorf("the configuration folder is not set")
+	}
+
+	if strings.TrimSpace(paths.SSH().HostPath()) == "" {
+		return fmt.Errorf("the SSH folder is not set")
+	}
+
+	return writeInclude(filepath.Join(paths.SSH().HostPath(), "config"), SSHIncludeText())
+}
+
+func RemoveSSHInclude(path string) error {
+	data, err := os.ReadFile(path)
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+
+	content := string(data)
+	next := removeIncludeBlock(content)
+	if next == content {
+		return nil
+	}
+
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return err
+	}
+
+	return os.WriteFile(path, []byte(next), 0o600)
+}
+
+func writeInclude(path, block string) error {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		if !os.IsNotExist(err) {
+			return err
+		}
+
+		if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+			return err
+		}
+
+		return os.WriteFile(path, []byte(strings.TrimSpace(block)+"\n"), 0o600)
+	}
+
+	content := removeIncludeBlock(string(data))
+
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return err
+	}
+
+	return os.WriteFile(path, []byte(strings.TrimSpace(block)+"\n\n"+content), 0o600)
+}
+
+func removeIncludeBlock(content string) string {
+	changed := false
+
+	for {
+		start := strings.Index(content, sshIncludeStart)
+		if start < 0 {
+			break
+		}
+
+		end := strings.Index(content[start:], sshIncludeEnd)
+		if end < 0 {
+			break
+		}
+
+		content = content[:start] + content[start+end+len(sshIncludeEnd):]
+		changed = true
+	}
+
+	if !changed {
+		return content
+	}
+
+	return strings.TrimLeft(content, "\n")
+}
diff --git a/internal/machine/accessors_test.go b/internal/machine/accessors_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..ea41ae368e0d945d0a95a45bfcbd0a9b7257d2f9
