diff --git a/internal/ui/hostops.go b/internal/ui/hostops.go
new file mode 100644
index 0000000000000000000000000000000000000000..4a33bbfad82b85ccb4dac10642f72421696bb361
--- /dev/null
+++ b/internal/ui/hostops.go
@@ -0,0 +1,126 @@
+package ui
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+
+	"codeberg.org/pojntfx/phial-neo/internal/host"
+)
+
+// hostClient returns the varlink client of the host service. The window runs
+// in the Flatpak sandbox, so every host resource comes through the service.
+func (a *App) hostClient() *host.Client {
+	return a.State.Host()
+}
+
+// machineActive reports whether one machine runs right now.
+func (a *App) machineActive(name string) bool {
+	states, err := a.hostClient().Status(a.Ctx)
+	if err != nil {
+		a.Log.Info("could not read the machine states", "err", err)
+
+		return false
+	}
+
+	for _, m := range states.Machines {
+		if m.Name == name {
+			return m.State == "active"
+		}
+	}
+
+	return false
+}
+
+// runningMachines lists the machines that run right now.
+func (a *App) runningMachines() []string {
+	states, err := a.hostClient().Status(a.Ctx)
+	if err != nil {
+		return nil
+	}
+
+	names := []string{}
+
+	for _, m := range states.Machines {
+		if m.State == "active" || m.State == "deactivating" {
+			names = append(names, m.Name)
+		}
+	}
+
+	return names
+}
+
+// stopMachine stops one machine through the host service.
+func (a *App) stopMachine(ctx context.Context, name string) error {
+	return a.hostClient().VMStop(ctx, name)
+}
+
+// startMachine starts one machine through the host service.
+func (a *App) startMachine(ctx context.Context, name string) error {
+	return a.hostClient().VMStart(ctx, name)
+}
+
+// machineStates returns the full machine state list from the host service.
+func (a *App) machineStates() (*host.StatusResponse, error) {
+	return a.hostClient().Status(a.Ctx)
+}
+
+// installStatus returns the install progress of one machine, or nil when no
+// install runs for it.
+func (a *App) installStatus(name string) *host.InstallState {
+	states, err := a.hostClient().Status(a.Ctx)
+	if err != nil {
+		return nil
+	}
+
+	for _, m := range states.Machines {
+		if m.Name == name && m.Install != nil {
+			return m.Install
+		}
+	}
+
+	return nil
+}
+
+// hugePages reports the bytes that the host can still back with huge pages
+// and the bytes that it has reserved in total.
+func (a *App) hugePages() (int64, int64, bool) {
+	states, err := a.hostClient().Status(a.Ctx)
+	if err != nil {
+		return 0, 0, false
+	}
+
+	return states.HugePagesFree, states.HugePagesTotal, true
+}
+
+// rdpPassword reads the RDP password from the host service, for display and
+// copy.
+func (a *App) rdpPassword(name string) string {
+	display, err := a.hostClient().VMDisplay(a.Ctx, name)
+	if err != nil {
+		a.Log.Info("could not read the display details", "err", err)
+
+		return ""
+	}
+
+	return display.RdpPassword
+}
+
+// unlockAgent loads the key of the user into the agent of the session. The
+// host service reads the key file and loads it, so the application sends no
+// file path.
+func (a *App) unlockAgent() error {
+	sshDir := a.State.SSHHostDir()
+	if sshDir == "" {
+		return errors.New("the SSH folder is not configured")
+	}
+
+	key := filepath.Join(sshDir, "id_ed25519")
+
+	if _, err := os.Stat(key); err != nil {
+		return err
+	}
+
+	return a.State.AddSSHKey(key)
+}
