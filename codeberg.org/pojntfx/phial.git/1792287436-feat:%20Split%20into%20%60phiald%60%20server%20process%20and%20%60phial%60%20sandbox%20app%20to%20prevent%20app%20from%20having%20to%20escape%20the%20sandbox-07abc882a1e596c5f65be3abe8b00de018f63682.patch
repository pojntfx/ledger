+
+// ParseSize reads a size such as 128G as bytes.
+func ParseSize(value string) (int64, error) {
+	value = strings.TrimSpace(value)
+	if value == "" {
+		return 0, errors.New("empty size")
+	}
+
+	last := value[len(value)-1]
+	factor := int64(1)
+	digits := value
+
+	switch last {
+	case 'G', 'g':
+		factor = 1024 * 1024 * 1024
+		digits = value[:len(value)-1]
+	case 'M', 'm':
+		factor = 1024 * 1024
+		digits = value[:len(value)-1]
+	case 'K', 'k':
+		factor = 1024
+		digits = value[:len(value)-1]
+	}
+
+	number, err := strconv.ParseInt(digits, 10, 64)
+	if err != nil {
+		return 0, fmt.Errorf("invalid size %q", value)
+	}
+
+	return number * factor, nil
+}
+
+// MemoryMiB reads a memory size such as 16G as mebibytes.
+func MemoryMiB(memory string) (int, error) {
+	memory = strings.TrimSpace(memory)
+	if memory == "" {
+		return 0, errors.New("empty memory size")
+	}
+
+	last := memory[len(memory)-1]
+	factor := 1
+	digits := memory
+
+	switch last {
+	case 'G', 'g':
+		factor = 1024
+		digits = memory[:len(memory)-1]
+	case 'M', 'm':
+		digits = memory[:len(memory)-1]
+	case 'K', 'k':
+		digits = memory[:len(memory)-1]
+		factor = 0
+	}
+
+	value, err := strconv.Atoi(digits)
+	if err != nil {
+		return 0, fmt.Errorf("invalid memory size %q", memory)
+	}
+
+	if factor == 0 {
+		return value / 1024, nil
+	}
+
+	return value * factor, nil
+}
