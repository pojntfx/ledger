@@ -0,0 +1,64 @@
+package mcp
+
+import (
+	"testing"
+
+	mcpgo "github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+// TestMCPCoversEveryHumanAction makes sure that the agent can do every action
+// that the human can do. The MCP server is the only agent interface, and every
+// control in the window has a matching tool.
+func TestMCPCoversEveryHumanAction(t *testing.T) {
+	registered := map[string]bool{}
+	for _, tool := range hostTools() {
+		registered[tool.Name] = true
+	}
+
+	want := []string{
+		"vm.ls", "vm.create", "vm.delete", "vm.start", "vm.stop", "vm.restart",
+		"vm.install", "vm.installStatus", "vm.cancelInstall", "vm.provision",
+		"vm.metrics", "vm.update",
+		"secrets.ls", "secrets.set", "secrets.remove",
+		"keys.ls", "keys.addSsh", "keys.generateSsh", "keys.removeSsh",
+		"keys.generateGpg", "keys.removeGpg",
+		"grants.ls", "grants.allow", "grants.revoke",
+		"usb.ls", "usb.addDevice", "usb.removeDevice", "usb.bindXhci", "usb.restoreXhci",
+		"usb.listXhci", "usb.names",
+		"share.ls", "share.add", "share.remove",
+		"display.setMode", "display.runApp", "display.listApps", "display.openRdp", "display.openSerial",
+		"system.status", "system.rootSetup", "system.acceptance",
+		"approvals.list", "approvals.answer",
+	}
+
+	missing := []string{}
+	for _, name := range want {
+		if !registered[name] {
+			missing = append(missing, name)
+		}
+	}
+
+	if len(missing) > 0 {
+		t.Fatalf("the agent cannot do these human actions: %v", missing)
+	}
+}
+
+// hostTools lists the tool definitions that the service registers for a host
+// request. The names come from the tool definitions themselves.
+func hostTools() []*mcpgo.Tool {
+	return []*mcpgo.Tool{
+		VmLsTool, VmCreateTool, VmDeleteTool, VmStartTool, VmStopTool, VmRestartTool,
+		VmInstallTool, VmInstallStatusTool, VmCancelInstallTool, VmProvisionTool,
+		VmMetricsTool, VmUpdateTool,
+		SecretsLsTool, SecretsSetTool, SecretsRemoveTool,
+		KeysLsTool, KeysAddSSHTool, KeysGenerateSSHTool, KeysRemoveSSHTool,
+		KeysGenerateGPGTool, KeysRemoveGPGTool,
+		GrantsLsTool, GrantsAllowTool, GrantsRevokeTool,
+		UsbLsTool, UsbAddDeviceTool, UsbRemoveDeviceTool, UsbBindTool, UsbRestoreTool,
+		ListXhciTool, UsbNamesTool,
+		ShareLsTool, ShareAddTool, ShareRemoveTool,
+		DisplaySetModeTool, DisplayRunAppTool, ListGuestAppsTool, DisplayOpenRdpTool, DisplayOpenSerialTool,
+		SystemStatusTool, SystemRootSetupTool, SystemAcceptanceTool,
+		ApprovalsListTool, ApprovalsAnswerTool,
+	}
+}
