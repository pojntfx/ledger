new file mode 100644
index 0000000000000000000000000000000000000000..94312213b0b9013f9cbf3a79b62676ee95372cc0
--- /dev/null
+++ b/internal/state/sweep.go
@@ -0,0 +1,59 @@
+package state
+
+import (
+	"os"
+	"path/filepath"
+)
+
+// SweepGrants closes every grant whose time ran out and writes the env
+// files of the open secret grants. The host service runs this loop, so the
+// expiry of a grant runs on the host and a grant ends after Phial closes.
+func (c *Client) SweepGrants() {
+	for _, grant := range c.Grants() {
+		if grant.Active() {
+			if grant.Kind == KindSecret {
+				if err := c.materializeSecret(grant); err != nil {
+					c.log.Info("could not materialize the secret of a grant", "id", grant.ID, "err", err)
+				}
+			}
+
+			continue
+		}
+
+		if err := c.revokeGrant(grant.ID); err != nil {
+			c.log.Error("could not close an expired grant", "id", grant.ID, "err", err)
+		}
+	}
+}
+
+// materializeSecret writes the value of one secret into the share of its
+// machine. A proxied secret carries the placeholder, and the proxy of the
+// host replaces it with the real value at request time.
+func (c *Client) materializeSecret(grant Grant) error {
+	row, err := c.findRow(grant.Name)
+	if err != nil {
+		return err
+	}
+
+	dir := c.secretsDirFor(grant.VM)
+	if err := mkdirPrivate(dir); err != nil {
+		return err
+	}
+
+	content := Placeholder
+	if row.Mode != "proxy" {
+		value, err := resolveSource(row.Source)
+		if err != nil {
+			return err
+		}
+
+		content = value
+	}
+
+	return writeSecretFile(filepath.Join(dir, grant.Name), content+"\n")
+}
+
+// removeSecretShare removes the file of one secret from one machine share.
+func (c *Client) removeSecretShare(vm string, name string) {
+	_ = os.Remove(filepath.Join(c.secretsDirFor(vm), name))
+}
