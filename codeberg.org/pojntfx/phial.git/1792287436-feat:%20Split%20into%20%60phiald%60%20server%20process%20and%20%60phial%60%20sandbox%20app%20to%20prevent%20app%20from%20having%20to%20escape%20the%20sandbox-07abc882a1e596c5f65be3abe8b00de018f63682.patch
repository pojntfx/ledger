diff --git a/internal/varlink/activation.go b/internal/varlink/activation.go
new file mode 100644
index 0000000000000000000000000000000000000000..36da78e95af8087a0cf91eb3bcf888864a7c05de
--- /dev/null
+++ b/internal/varlink/activation.go
@@ -0,0 +1,48 @@
+package varlink
+
+import (
+	"fmt"
+	"net"
+	"os"
+	"strconv"
+	"strings"
+)
+
+// ActivationListener returns the socket that systemd passed to the service.
+// The host service starts on the first socket connection, so the socket unit
+// creates the socket and hands it over through the activation environment.
+func ActivationListener() (net.Listener, bool, error) {
+	pid, err := strconv.Atoi(os.Getenv("LISTEN_PID"))
+	if err != nil || pid != os.Getpid() {
+		return nil, false, nil
+	}
+
+	count, err := strconv.Atoi(os.Getenv("LISTEN_FDS"))
+	if err != nil || count < 1 {
+		return nil, false, fmt.Errorf("LISTEN_PID is set but LISTEN_FDS is %q", os.Getenv("LISTEN_FDS"))
+	}
+
+	names := strings.Split(os.Getenv("LISTEN_FDNAMES"), ":")
+
+	for index := 0; index < count; index++ {
+		if index < len(names) && names[index] != "" && !strings.HasSuffix(names[index], ".socket") {
+			continue
+		}
+
+		file := os.NewFile(uintptr(3+index), "phiald.socket")
+		if file == nil {
+			continue
+		}
+
+		listener, err := net.FileListener(file)
+		if err != nil {
+			file.Close()
+
+			return nil, false, fmt.Errorf("could not adopt the activation socket: %w", err)
+		}
+
+		return listener, true, nil
+	}
+
+	return nil, false, fmt.Errorf("the activation passed %d descriptors but no socket", count)
+}
diff --git a/internal/varlink/client.go b/internal/varlink/client.go
new file mode 100644
index 0000000000000000000000000000000000000000..66e8de17c235bc3ea0e743ff970a87c250151220
--- /dev/null
+++ b/internal/varlink/client.go
@@ -0,0 +1,108 @@
+package varlink
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"fmt"
+	"net"
+	"strings"
+	"sync"
+)
+
+// Client is one connection to the host service.
+type Client struct {
+	conn   net.Conn
+	reader *bufio.Reader
+	lock   sync.Mutex
+}
+
+// Dial connects to the socket of the host service.
+func Dial(path string) (*Client, error) {
+	conn, err := net.Dial("unix", path)
+	if err != nil {
+		return nil, err
+	}
+
+	return NewClient(conn), nil
+}
+
+// NewClient wraps one connection as a client.
+func NewClient(conn net.Conn) *Client {
+	return &Client{conn: conn, reader: bufio.NewReader(conn)}
+}
+
+// Close ends the connection.
+func (c *Client) Close() error {
+	return c.conn.Close()
+}
+
+// Call runs one method and decodes its reply into out.
+func (c *Client) Call(ctx context.Context, method string, parameters any, out any) error {
+	c.lock.Lock()
+	defer c.lock.Unlock()
+
+	full := method
+	if !strings.HasPrefix(full, Interface+".") {
+		full = Interface + "." + method
+	}
+
+	var raw json.RawMessage
+	if parameters != nil {
+		encoded, err := json.Marshal(parameters)
+		if err != nil {
+			return err
+		}
+
+		raw = encoded
+	}
+
+	message, err := json.Marshal(request{Method: full, Parameters: raw})
+	if err != nil {
+		return err
+	}
+
+	deadline, ok := ctx.Deadline()
+	if ok {
+		if err := c.conn.SetDeadline(deadline); err != nil {
+			return err
+		}
+	}
+
+	if _, err := c.conn.Write(append(message, 0)); err != nil {
+		return err
+	}
+
+	if ok {
+		if err := c.conn.SetDeadline(deadline); err != nil {
+			return err
+		}
+	}
+
+	answer, err := c.reader.ReadBytes(0)
+	if err != nil {
+		return err
+	}
+
+	var decoded reply
+	if err := json.Unmarshal(answer[:len(answer)-1], &decoded); err != nil {
+		return fmt.Errorf("invalid reply from the host service: %w", err)
+	}
+
+	if decoded.Error != "" {
+		var parameters map[string]any
+		if len(decoded.Parameters) > 0 {
+			_ = json.Unmarshal(decoded.Parameters, &parameters)
+		}
+
+		return &Error{Name: decoded.Error, Parameters: parameters}
+	}
+
+	if out != nil && len(decoded.Parameters) > 0 {
+		if err := json.Unmarshal(decoded.Parameters, out); err != nil {
+			return fmt.Errorf("invalid reply parameters from the host service: %w", err)
+		}
+	}
+
+	return nil
+}
diff --git a/internal/varlink/peer.go b/internal/varlink/peer.go
new file mode 100644
index 0000000000000000000000000000000000000000..077511f90bae20e749e4bb6b19b8c8b934fb207a
--- /dev/null
+++ b/internal/varlink/peer.go
@@ -0,0 +1,136 @@
+package varlink
+
+import (
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"golang.org/x/sys/unix"
+)
+
+// PeerPolicy states which client may connect: a process of the same user that
+// runs as the Phial application in its Flatpak scope.
+type PeerPolicy struct {
+	// AppID is the Flatpak application identifier of the application.
+	AppID string
+
+	// ProcRoot names the proc filesystem root, so a test can point at a
+	// fixture.
+	ProcRoot string
+
+	// UID is the user that the peer must have. Zero means the user of this
+	// process.
+	UID uint32
+}
+
+// CheckPeer accepts a connection only from the application. It reads the peer
+// credentials of the kernel, makes sure that the user ID matches, reads the
+// flatpak-info of the peer, and requires the Phial app ID and the Flatpak
+// application scope. Any other client receives an error and the connection
+// closes.
+func CheckPeer(conn *net.UnixConn, policy PeerPolicy) error {
+	raw, err := conn.SyscallConn()
+	if err != nil {
+		return fmt.Errorf("could not read the peer credentials: %w", err)
+	}
+
+	var credentials *unix.Ucred
+	var controlErr error
+
+	if err := raw.Control(func(fd uintptr) {
+		credentials, controlErr = unix.GetsockoptUcred(int(fd), unix.SOL_SOCKET, unix.SO_PEERCRED)
+	}); err != nil {
+		return fmt.Errorf("could not read the peer credentials: %w", err)
+	}
+
+	if controlErr != nil {
+		return fmt.Errorf("could not read the peer credentials: %w", controlErr)
+	}
+
+	return CheckPeerID(policy, credentials.Uid, credentials.Pid)
+}
+
+// CheckPeerID verifies one user ID and process ID against the policy. It is
+// separate from the socket so that a test can exercise it with fixtures.
+func CheckPeerID(policy PeerPolicy, peerUID uint32, pid int32) error {
+	serviceUID := policy.UID
+	if serviceUID == 0 {
+		serviceUID = uint32(os.Getuid())
+	}
+
+	if peerUID != serviceUID {
+		return fmt.Errorf("the peer user %d is not the service user %d", peerUID, serviceUID)
+	}
+
+	procRoot := policy.ProcRoot
+	if procRoot == "" {
+		procRoot = "/proc"
+	}
+
+	info, err := os.ReadFile(filepath.Join(procRoot, fmt.Sprint(pid), "root", ".flatpak-info"))
+	if err != nil {
+		return fmt.Errorf("the peer is not a Flatpak application: %w", err)
+	}
+
+	if !flatpakInfoNamesApp(info, policy.AppID) {
+		return fmt.Errorf("the peer is not the %s application", policy.AppID)
+	}
+
+	cgroup, err := os.ReadFile(filepath.Join(procRoot, fmt.Sprint(pid), "cgroup"))
+	if err != nil {
+		return fmt.Errorf("could not read the peer cgroup: %w", err)
+	}
+
+	if !cgroupIsAppScope(cgroup, policy.AppID) {
+		return fmt.Errorf("the peer does not run in the Flatpak application scope")
+	}
+
+	return nil
+}
+
+// flatpakInfoNamesApp reports whether one flatpak-info names the
+// application.
+func flatpakInfoNamesApp(info []byte, appID string) bool {
+	for _, line := range strings.Split(string(info), "\n") {
+		key, value, ok := strings.Cut(line, "=")
+		if !ok {
+			continue
+		}
+
+		if strings.TrimSpace(key) == "name" && strings.TrimSpace(value) == appID {
+			return true
+		}
+	}
+
+	return false
+}
+
+// cgroupIsAppScope reports whether one cgroup list places the process in the
+// Flatpak application scope of the application. The scope name carries the app
+// ID in raw form or in systemd escaped form, where a dash replaces a dot.
+func cgroupIsAppScope(cgroup []byte, appID string) bool {
+	escaped := strings.ReplaceAll(appID, ".", "-")
+
+	for _, line := range strings.Split(string(cgroup), "\n") {
+		line = strings.TrimSpace(line)
+		if line == "" {
+			continue
+		}
+
+		if !strings.Contains(line, "app-flatpak-") {
+			continue
+		}
+
+		for _, id := range []string{appID, escaped} {
+			for _, suffix := range []string{"-", "@", ".scope"} {
+				if strings.Contains(line, id+suffix) {
+					return true
+				}
+			}
+		}
+	}
+
+	return false
+}
