+++ b/internal/varlink/varlink_test.go
@@ -0,0 +1,315 @@
+package varlink
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"log/slog"
+	"net"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func echoHandler(_ context.Context, method string, parameters json.RawMessage) (any, *Error) {
+	if method == "Fail" {
+		return nil, NewError("TestFailure", map[string]any{"why": "asked"})
+	}
+
+	var in map[string]any
+	if len(parameters) > 0 {
+		_ = json.Unmarshal(parameters, &in)
+	}
+
+	return map[string]any{"method": method, "in": in}, nil
+}
+
+func TestCallRoundTrip(t *testing.T) {
+	dir := t.TempDir()
+	socket := filepath.Join(dir, "phial", "control.sock")
+
+	listener, err := ListenUnix(socket)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	server := NewServer(slog.Default(), echoHandler, nil)
+	defer server.Close()
+
+	go server.Serve(listener)
+
+	client, err := Dial(socket)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+
+	var out struct {
+		Method string         `json:"method"`
+		In     map[string]any `json:"in"`
+	}
+
+	if err := client.Call(context.Background(), "Echo", map[string]string{"hello": "world"}, &out); err != nil {
+		t.Fatal(err)
+	}
+
+	if out.Method != "Echo" || out.In["hello"] != "world" {
+		t.Fatalf("unexpected reply: %+v", out)
+	}
+
+	if err := client.Call(context.Background(), "Fail", nil, nil); err == nil {
+		t.Fatal("the failing call did not fail")
+	} else {
+		var callErr *Error
+		if !errorAs(err, &callErr) {
+			t.Fatalf("the error is not a varlink error: %v", err)
+		}
+
+		if !strings.HasSuffix(callErr.Name, ".TestFailure") {
+			t.Fatalf("unexpected error name: %s", callErr.Name)
+		}
+	}
+}
+
+func errorAs(err error, target **Error) bool {
+	for err != nil {
+		if cast, ok := err.(*Error); ok {
+			*target = cast
+
+			return true
+		}
+
+		type unwrapper interface{ Unwrap() error }
+		next, ok := err.(unwrapper)
+		if !ok {
+			return false
+		}
+
+		err = next.Unwrap()
+	}
+
+	return false
+}
+
+func TestPeerRejectsNonApplication(t *testing.T) {
+	unixServer, unixClient := unixPair(t)
+	defer unixServer.Close()
+	defer unixClient.Close()
+
+	policy := PeerPolicy{AppID: "com.pojtinger.felicitas.Phial"}
+
+	// The test process is not the application, so its credentials fail the
+	// check.
+	if err := CheckPeer(unixServer, policy); err == nil {
+		t.Fatal("a non-application process passed the peer check")
+	}
+}
+
+func unixPair(t *testing.T) (*net.UnixConn, *net.UnixConn) {
+	t.Helper()
+
+	dir := t.TempDir()
+	socket := filepath.Join(dir, "pair.sock")
+
+	listener, err := net.Listen("unix", socket)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+
+	type result struct {
+		conn net.Conn
+		err  error
+	}
+
+	accepted := make(chan result, 1)
+	go func() {
+		conn, err := listener.Accept()
+		accepted <- result{conn, err}
+	}()
+
+	client, err := net.Dial("unix", socket)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	res := <-accepted
+	if res.err != nil {
+		t.Fatal(res.err)
+	}
+
+	serverConn, ok := res.conn.(*net.UnixConn)
+	if !ok {
+		t.Fatal("the server side is not a Unix connection")
+	}
+
+	clientConn, ok := client.(*net.UnixConn)
+	if !ok {
+		t.Fatal("the client side is not a Unix connection")
+	}
+
+	return serverConn, clientConn
+}
+
+func TestPeerCheckID(t *testing.T) {
+	dir := t.TempDir()
+
+	writeProc := func(pid int32, info string, cgroup string) {
+		root := filepath.Join(dir, fmt.Sprint(pid), "root")
+		if err := os.MkdirAll(root, 0o755); err != nil {
+			t.Fatal(err)
+		}
+
+		if info != "" {
+			if err := os.WriteFile(filepath.Join(root, ".flatpak-info"), []byte(info), 0o644); err != nil {
+				t.Fatal(err)
+			}
+		}
+
+		if err := os.WriteFile(filepath.Join(dir, fmt.Sprint(pid), "cgroup"), []byte(cgroup), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	uid := uint32(os.Getuid())
+	policy := PeerPolicy{AppID: "com.pojtinger.felicitas.Phial", ProcRoot: dir, UID: uid}
+
+	const scope = "0::/user.slice/user-1000.slice/user@1000.service/app.slice/app-flatpak-com.pojtinger.felicitas.Phial-12345.scope"
+	const escapedScope = "0::/user.slice/user-1000.slice/user@1000.service/app.slice/app-flatpak-com-pojtinger-felicitas-Phial-12345.scope"
+	const info = "[Application]\nname=com.pojtinger.felicitas.Phial\n"
+
+	writeProc(1001, info, scope)
+	if err := CheckPeerID(policy, uid, 1001); err != nil {
+		t.Fatalf("the application was rejected: %v", err)
+	}
+
+	writeProc(1002, info, escapedScope)
+	if err := CheckPeerID(policy, uid, 1002); err != nil {
+		t.Fatalf("the application in the escaped scope was rejected: %v", err)
+	}
+
+	writeProc(1003, info, scope)
+	if err := CheckPeerID(policy, uid+1, 1003); err == nil {
+		t.Fatal("a peer of another user passed the check")
+	}
+
+	writeProc(1004, "", scope)
+	if err := CheckPeerID(policy, uid, 1004); err == nil {
+		t.Fatal("a non-Flatpak process passed the check")
+	}
+
+	writeProc(1005, "[Application]\nname=org.example.Other\n", "0::/user.slice/user-1000.slice/user@1000.service/app.slice/app-flatpak-org.example.Other-12345.scope")
+	if err := CheckPeerID(policy, uid, 1005); err == nil {
+		t.Fatal("another application passed the check")
+	}
+
+	writeProc(1006, info, "0::/user.slice/user-1000.slice/session-1.scope")
+	if err := CheckPeerID(policy, uid, 1006); err == nil {
+		t.Fatal("the application outside the Flatpak scope passed the check")
+	}
+}
+
+// TestActivation runs the activation handshake with a helper process that
+// adopts the socket that this test created, the way systemd hands it over.
+func TestActivation(t *testing.T) {
+	if os.Getenv("PHIAL_TEST_HELPER") == "1" {
+		os.Setenv("LISTEN_PID", fmt.Sprint(os.Getpid()))
+		os.Setenv("LISTEN_FDS", "1")
+		os.Setenv("LISTEN_FDNAMES", "phiald.socket")
+
+		listener, ok, err := ActivationListener()
+		if err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(1)
+		}
+
+		if !ok {
+			fmt.Fprintln(os.Stderr, "no activation socket")
+			os.Exit(1)
+		}
+
+		server := NewServer(slog.Default(), echoHandler, nil)
+		defer server.Close()
+
+		conn, err := listener.Accept()
+		if err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(1)
+		}
+
+		server.serveConn(conn)
+
+		return
+	}
+
+	dir := t.TempDir()
+	socket := filepath.Join(dir, "control.sock")
+
+	listener, err := ListenUnix(socket)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+
+	file, err := listener.(*net.UnixListener).File()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	helper := exec.Command(os.Args[0], "-test.run", "TestActivation")
+	helper.Env = append(os.Environ(), "PHIAL_TEST_HELPER=1")
+	helper.ExtraFiles = []*os.File{file}
+
+	if err := helper.Start(); err != nil {
+		t.Fatal(err)
+	}
+
+	// The helper adopted the socket, so this client connects to it through the
+	// same path, the way the application reaches the activated service.
+	client, err := Dial(socket)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var out struct {
+		Method string `json:"method"`
+	}
+
+	if err := client.Call(context.Background(), "Echo", nil, &out); err != nil {
+		t.Fatal(err)
+	}
+	client.Close()
+
+	if out.Method != "Echo" {
+		t.Fatalf("unexpected reply: %+v", out)
+	}
+
+	if err := helper.Wait(); err != nil {
+		t.Fatalf("the helper failed: %v", err)
+	}
+}
+
+func TestActivationEnvironment(t *testing.T) {
+	t.Setenv("LISTEN_PID", "")
+	t.Setenv("LISTEN_FDS", "")
+	t.Setenv("LISTEN_FDNAMES", "")
+
+	if _, ok, err := ActivationListener(); err != nil || ok {
+		t.Fatal("activation without the environment must report no socket")
+	}
+
+	t.Setenv("LISTEN_PID", fmt.Sprint(os.Getpid()))
+	t.Setenv("LISTEN_FDS", "abc")
+
+	if _, _, err := ActivationListener(); err == nil {
+		t.Fatal("a malformed descriptor count must fail")
+	}
+
+	t.Setenv("LISTEN_FDS", "0")
+
+	if _, _, err := ActivationListener(); err == nil {
+		t.Fatal("zero descriptors must fail")
+	}
+}
