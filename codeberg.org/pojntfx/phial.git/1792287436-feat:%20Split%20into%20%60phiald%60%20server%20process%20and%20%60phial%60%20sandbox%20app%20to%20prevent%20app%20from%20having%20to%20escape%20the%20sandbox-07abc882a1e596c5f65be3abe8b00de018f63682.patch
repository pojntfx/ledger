+package setup
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// TestInstallFileIsIdempotent makes sure that the install command does not
+// overwrite a file that is already there unless it asks to.
+func TestInstallFileIsIdempotent(t *testing.T) {
+	dir := t.TempDir()
+	target := filepath.Join(dir, "sub", "file")
+
+	if err := installFile([]byte("first"), target, 0o600, true); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := installFile([]byte("second"), target, 0o600, true); err != nil {
+		t.Fatal(err)
+	}
+
+	data, err := os.ReadFile(target)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if string(data) != "second" {
+		t.Fatalf("installFile wrote %q, want %q", string(data), "second")
+	}
+
+	// Without overwrite, the existing file stays.
+	if err := installFile([]byte("third"), target, 0o600, false); err != nil {
+		t.Fatal(err)
+	}
+
+	data, _ = os.ReadFile(target)
+	if string(data) != "second" {
+		t.Fatalf("installFile without overwrite wrote %q, want %q", string(data), "second")
+	}
+}
+
+// TestInstallFileCreatesTheDirectory makes sure that the install writes the
+// units and the service into the right directory.
+func TestInstallFileCreatesTheDirectory(t *testing.T) {
+	dir := t.TempDir()
+	target := filepath.Join(dir, "deep", "nested", "phiald.socket")
+
+	if err := installFile([]byte(socketFixture()), target, 0o644, true); err != nil {
+		t.Fatal(err)
+	}
+
+	if _, err := os.Stat(target); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func socketFixture() string {
+	return "[Unit]\\nDescription=Phial host service control socket\\n"
+}
