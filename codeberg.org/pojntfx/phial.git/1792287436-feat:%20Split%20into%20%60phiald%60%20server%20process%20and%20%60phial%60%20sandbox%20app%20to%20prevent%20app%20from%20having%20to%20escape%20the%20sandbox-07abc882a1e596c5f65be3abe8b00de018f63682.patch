index 0000000000000000000000000000000000000000..4df96caa06d275c17aa7b2c7de2d13c437054cd2
--- /dev/null
+++ b/internal/varlink/varlink.go
@@ -0,0 +1,57 @@
+// Package varlink implements the varlink wire protocol over a Unix socket.
+// A message is one JSON value that ends with a NUL byte. A request carries a
+// method and its parameters, and a reply carries parameters or an error.
+package varlink
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+)
+
+// Interface names the private varlink interface of the host service. It is
+// not a public API.
+const Interface = "com.pojtinger.felicitas.Phial"
+
+// ProtocolVersion is the version of the wire contract between the
+// application and the host service. It changes when the contract changes.
+const ProtocolVersion = 1
+
+// Error is the failure of one call.
+type Error struct {
+	Name       string         `json:"error"`
+	Parameters map[string]any `json:"parameters,omitempty"`
+}
+
+func (e *Error) Error() string {
+	if detail, ok := e.Parameters["error"].(string); ok && detail != "" {
+		return fmt.Sprintf("%s: %s", e.Name, detail)
+	}
+
+	if len(e.Parameters) == 0 {
+		return e.Name
+	}
+
+	return fmt.Sprintf("%s: %v", e.Name, e.Parameters)
+}
+
+// NewError builds one named error.
+func NewError(name string, parameters map[string]any) *Error {
+	if !strings.HasPrefix(name, Interface+".") {
+		name = Interface + "." + name
+	}
+
+	return &Error{Name: name, Parameters: parameters}
+}
+
+// request is the wire form of one call.
+type request struct {
+	Method     string          `json:"method"`
+	Parameters json.RawMessage `json:"parameters,omitempty"`
+}
+
+// reply is the wire form of one answer.
+type reply struct {
+	Parameters json.RawMessage `json:"parameters,omitempty"`
+	Error      string          `json:"error,omitempty"`
+}
