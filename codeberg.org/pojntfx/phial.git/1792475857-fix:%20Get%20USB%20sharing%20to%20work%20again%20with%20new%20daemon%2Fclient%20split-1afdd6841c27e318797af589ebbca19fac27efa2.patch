diff --git a/internal/mcp/tools_usb_test.go b/internal/mcp/tools_usb_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..94e0f6bee143dbcd9462459c724efdfdb3c8c839
--- /dev/null
+++ b/internal/mcp/tools_usb_test.go
@@ -0,0 +1,63 @@
+package mcp
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+
+	mcpgo "github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+func TestUsbLsNameIsOptional(t *testing.T) {
+	ctx := context.Background()
+	server := mcpgo.NewServer(&mcpgo.Implementation{Name: "phial", Version: "test"}, nil)
+	mcpgo.AddTool(server, UsbLsTool, (&Service{}).UsbLs)
+
+	client := mcpgo.NewClient(&mcpgo.Implementation{Name: "test", Version: "test"}, nil)
+	serverTransport, clientTransport := mcpgo.NewInMemoryTransports()
+
+	serverSession, err := server.Connect(ctx, serverTransport, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer serverSession.Close()
+
+	clientSession, err := client.Connect(ctx, clientTransport, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer clientSession.Close()
+
+	result, err := clientSession.ListTools(ctx, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	for _, tool := range result.Tools {
+		if tool.Name != UsbLsTool.Name {
+			continue
+		}
+
+		data, err := json.Marshal(tool.InputSchema)
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		var schema struct {
+			Required []string `json:"required"`
+		}
+		if err := json.Unmarshal(data, &schema); err != nil {
+			t.Fatal(err)
+		}
+
+		for _, name := range schema.Required {
+			if name == "name" {
+				t.Fatalf("usb.ls still requires a name: %s", data)
+			}
+		}
+
+		return
+	}
+
+	t.Fatal("usb.ls is not registered")
+}
