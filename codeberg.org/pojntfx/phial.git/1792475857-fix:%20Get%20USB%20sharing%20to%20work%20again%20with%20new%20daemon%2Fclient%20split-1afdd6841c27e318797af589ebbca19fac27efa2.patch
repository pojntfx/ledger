@@ -109,21 +119,85 @@ }
 
 type AddressInput struct {
 	Address string `json:"address" jsonschema:"the PCI address of the controller, for example 0000:00:14.0"`
+	VM      string `json:"vm,omitempty" jsonschema:"the VM that receives the controller, optional"`
 }
 
 func (s *Service) UsbBind(ctx context.Context, req *mcpgo.CallToolRequest, input AddressInput) (*mcpgo.CallToolResult, any, error) {
+	var def *machine.Definition
+
+	if input.VM != "" {
+		loaded, err := machine.Load(input.VM)
+		if err != nil {
+			return nil, nil, err
+		}
+
+		defs, err := machine.List()
+		if err != nil {
+			return nil, nil, err
+		}
+
+		for _, other := range defs {
+			if other.Name != input.VM && slices.Contains(other.USBXHCIs, input.Address) {
+				return nil, nil, fmt.Errorf("the xHCI controller %s already belongs to the machine %s", input.Address, other.Name)
+			}
+		}
+
+		def = &loaded
+	}
+
 	if err := s.host().USBVfioBind(ctx, input.Address); err != nil {
 		return nil, nil, err
 	}
 
+	if def != nil && !slices.Contains(def.USBXHCIs, input.Address) {
+		def.USBXHCIs = append(def.USBXHCIs, input.Address)
+
+		if err := def.Save(); err != nil {
+			return nil, nil, err
+		}
+	}
+
 	return nil, map[string]string{"state": "bound"}, nil
 }
 
 func (s *Service) UsbRestore(ctx context.Context, req *mcpgo.CallToolRequest, input AddressInput) (*mcpgo.CallToolResult, any, error) {
+	defs := []machine.Definition{}
+	if input.VM != "" {
+		def, err := machine.Load(input.VM)
+		if err != nil {
+			return nil, nil, err
+		}
+
+		defs = append(defs, def)
+	} else {
+		listed, err := machine.List()
+		if err != nil {
+			return nil, nil, err
+		}
+
+		defs = listed
+	}
+
 	if err := s.host().USBVfioRestore(ctx, input.Address); err != nil {
 		return nil, nil, err
 	}
 
+	for _, def := range defs {
+		kept := slices.DeleteFunc(append([]string{}, def.USBXHCIs...), func(existing string) bool {
+			return existing == input.Address
+		})
+
+		if len(kept) == len(def.USBXHCIs) {
+			continue
+		}
+
+		def.USBXHCIs = kept
+
+		if err := def.Save(); err != nil {
+			return nil, nil, err
+		}
+	}
+
 	return nil, map[string]string{"state": "restored"}, nil
 }
 
