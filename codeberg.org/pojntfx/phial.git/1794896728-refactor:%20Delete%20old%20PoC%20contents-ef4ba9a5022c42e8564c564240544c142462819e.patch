-// openLogs opens the log of one machine in the text editor: the console of the
-// machine when it keeps one, else its service log written out for reading. The
-// log comes from the host service, so the application never reads the journal.
-// The read runs on a worker goroutine, because the window never waits for the
-// socket.
-func (a *App) openLogs(name string) {
-	go func() {
-		path := machine.ConsoleLogPath(name)
-
-		if info, err := os.Stat(path); err != nil || info.Size() == 0 {
-			log, err := a.hostClient().VMLog(a.Ctx, name)
-			if err != nil {
-				a.idle(func() { a.toast(err.Error()) })
-
-				return
-			}
-
-			path = filepath.Join(filepath.Dir(path), "unit.log")
-
-			if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
-				a.idle(func() { a.toast(err.Error()) })
-
-				return
-			}
-
-			content := log.Log
-			if content == "" {
-				content = i18n.L("This machine has no log yet")
-			}
-
-			if err := os.WriteFile(path, []byte(content), 0o600); err != nil {
-				a.idle(func() { a.toast(err.Error()) })
-
-				return
-			}
-		}
-
-		a.idle(func() {
-			if _, err := gio.AppInfoLaunchDefaultForUri("file://"+filepath.Clean(path), nil); err != nil {
-				a.toast(err.Error())
-			}
-		})
-	}()
-}
