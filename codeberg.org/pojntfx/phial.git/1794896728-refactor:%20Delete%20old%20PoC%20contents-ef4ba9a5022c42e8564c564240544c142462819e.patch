-// ShareTag names the mount tag of one shared folder.
-func ShareTag(path string) string {
-	tag := filepath.Base(filepath.Clean(path))
-
-	var builder strings.Builder
-
-	for _, r := range tag {
-		switch {
-		case r >= 'a' && r <= 'z', r >= '0' && r <= '9', r == '-', r == '_':
-			builder.WriteRune(r)
-		case r >= 'A' && r <= 'Z':
-			builder.WriteRune(r + 32)
-		default:
-			builder.WriteRune('-')
-		}
-	}
-
-	result := strings.Trim(builder.String(), "-")
-
-	if result == "" {
-		return "share"
-	}
-
-	if len(result) > 36 {
-		sum := sha256.Sum256([]byte(filepath.Clean(path)))
-		suffix := hex.EncodeToString(sum[:4])
-		prefix := strings.TrimRight(result[:27], "-")
-
-		return prefix + "-" + suffix
-	}
-
-	return result
-}
