-const (
-	HostSocketName  = "mcp.sock"
-	GuestSocketName = "mcp-guest.sock"
-
-	// GuestVsockPort is the address of the agent channel for machines. The
-	// machine name of a request comes from the vsock address of its
-	// connection, so the address is never spoofed by the guest.
-	GuestVsockPort = 8080
-)
-
-type Service struct {
-	ctx       context.Context
-	log       *slog.Logger
-	state     *state.Client
-	approvals *Approvals
-	installs  map[string]bool
-	kickstart []byte
-	notify    func(summary, body string)
-}
-
-// host returns the varlink client of the host service. The MCP server is the
-// only agent interface, and it calls the varlink client for every host
-// operation, so the agent reaches the same host actions as the human.
-func (s *Service) host() *host.Client {
-	return s.state.Host()
-}
-
-func NewService(ctx context.Context, log *slog.Logger, client *state.Client, kickstart []byte, notify func(summary, body string)) *Service {
-	return &Service{
-		ctx:       ctx,
-		log:       log,
-		state:     client,
-		approvals: NewApprovals(notify),
-		installs:  map[string]bool{},
-		kickstart: kickstart,
-		notify:    notify,
-	}
-}
-
-// vmContextKey carries the machine of one guest request.
-type vmContextKey struct{}
-
-// VMFromContext states the machine that sent one guest request, or false for
-// a request that arrived without a vsock address.
-func VMFromContext(ctx context.Context) (string, bool) {
-	vm, ok := ctx.Value(vmContextKey{}).(string)
-
-	return vm, ok && vm != ""
-}
-
-func vmForCID(cid uint32) (string, bool) {
-	definitions, err := machine.List()
-	if err != nil {
-		return "", false
-	}
-
-	for _, def := range definitions {
-		if def.GuestCIDValue() == cid {
-			return def.Name, true
-		}
-	}
-
-	return "", false
-}
-
-func (s *Service) serve(listener net.Listener, guest bool, stampVM bool) error {
-	server := mcpgo.NewServer(
-		&mcpgo.Implementation{
-			Name:        "phial",
-			Title:       "Phial",
-			Description: "Virtual machines, secrets, and agents under host control.",
-			Version:     "1.0.0",
-			WebsiteURL:  "https://codeberg.org/pojntfx/phial-neo",
-		},
-		&mcpgo.ServerOptions{
-			Logger: s.log,
-		},
-	)
-
-	s.registerTools(server, guest)
-
-	handler := mcpgo.NewStreamableHTTPHandler(
-		func(r *http.Request) *mcpgo.Server {
-			return server
-		},
-		nil,
-	)
-
-	s.log.Info("serving MCP", "listener", listener.Addr().String(), "guest", guest)
-
-	daemon := &http.Server{Handler: handler}
-
-	if stampVM {
-		daemon.ConnContext = func(ctx context.Context, conn net.Conn) context.Context {
-			addr, ok := conn.RemoteAddr().(*vsock.Addr)
-			if !ok || addr == nil {
-				return ctx
-			}
-
-			vm, ok := vmForCID(addr.ContextID)
-			if !ok {
-				return ctx
-			}
-
-			return context.WithValue(ctx, vmContextKey{}, vm)
-		}
-	}
-
-	return daemon.Serve(listener)
-}
-
-func (s *Service) Serve(socketPath string, guest bool) error {
-	if err := os.MkdirAll(filepath.Dir(socketPath), 0o700); err != nil {
-		return err
-	}
-
-	if err := os.Remove(socketPath); err != nil && !errors.Is(err, os.ErrNotExist) {
-		return err
-	}
-
-	listener, err := net.Listen("unix", socketPath)
-	if err != nil {
-		return err
-	}
-
-	return s.serve(listener, guest, false)
-}
-
-func (s *Service) Run(runtimeDir string) error {
-	errChan := make(chan error, 3)
-
-	go func() {
-		errChan <- s.Serve(filepath.Join(runtimeDir, "phial", HostSocketName), false)
-	}()
-
-	go func() {
-		errChan <- s.Serve(filepath.Join(runtimeDir, "phial", GuestSocketName), true)
-	}()
-
-	go func() {
-		listener, err := vsock.Listen(GuestVsockPort, nil)
-		if err != nil {
-			errChan <- err
-
-			return
-		}
-
-		errChan <- s.serve(listener, true, true)
-	}()
-
-	select {
-	case err := <-errChan:
-		return err
-	case <-s.ctx.Done():
-		return nil
-	}
-}
-
-func (s *Service) Pending() []Approval {
-	return s.approvals.List()
-}
-
-func (s *Service) Answer(id string, approve bool) error {
-	return s.approvals.Answer(id, approve)
-}
-
-func (s *Service) Installing(name string) bool {
-	return s.installs[name]
-}
