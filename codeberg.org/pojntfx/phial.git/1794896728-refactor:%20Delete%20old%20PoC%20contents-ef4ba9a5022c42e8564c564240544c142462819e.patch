-func (a *App) machineActionFor(name string, action string) {
-	if page := a.machinePages[name]; page != nil {
-		page.setPending(action)
-	}
-
-	go func() {
-		var err error
-
-		switch action {
-		case "start":
-			err = a.startMachine(a.Ctx, name)
-		case "stop":
-			err = a.stopMachine(a.Ctx, name)
-		case "restart":
-			err = a.hostClient().VMRestart(a.Ctx, name)
-		}
-
-		a.requestHostRefresh()
-
-		a.idle(func() {
-			if err != nil {
-				if page := a.machinePages[name]; page != nil {
-					page.pending = ""
-				}
-
-				a.showError(err)
-			}
-
-			a.refreshSidebar()
-			a.refreshMachinePage(name)
-		})
-	}()
-}
