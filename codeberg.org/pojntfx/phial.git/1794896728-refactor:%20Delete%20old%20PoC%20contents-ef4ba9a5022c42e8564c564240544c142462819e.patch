-// refresh brings the page in step with the definition and the run state.
-func (p *machinePage) refresh() {
-	if def, err := machine.Load(p.def.Name); err == nil {
-		p.def = def
-	}
-
-	runState := "inactive"
-	ready := false
-	installing := false
-
-	if states, err := p.app.machineStates(); err == nil {
-		for _, m := range states.Machines {
-			if m.Name == p.def.Name {
-				runState = m.State
-				ready = m.Ready
-				installing = m.Installing
-			}
-		}
-	}
-
-	p.setState(runState, ready, installing, vmInstalled(p.def))
-	p.refreshAgent()
-}
-
-// refreshAgent states whether the guest carries an agent that is as new as the
-// binary of the host. It reads the snapshot, so the render never waits.
-func (p *machinePage) refreshAgent() {
-	if p.pending == "provision" {
-		p.banner.SetTitle(i18n.L("Updating the Guest Agent…"))
-		p.banner.SetButtonLabel(i18n.L("_Updating"))
-		p.banner.SetRevealed(true)
-
-		return
-	}
-
-	p.banner.SetTitle(i18n.L("The guest agent is out of date"))
-	p.banner.SetButtonLabel(i18n.L("_Reprovision"))
-
-	if !p.active() || !p.ready {
-		p.banner.SetRevealed(false)
-
-		return
-	}
-
-	outdated := false
-
-	if states, err := p.app.machineStates(); err == nil {
-		for _, m := range states.Machines {
-			if m.Name == p.def.Name {
-				outdated = m.AgentOutdated
-			}
-		}
-	}
-
-	p.banner.SetRevealed(outdated)
-}
-
-// refreshAccess turns the controls on that need a reachable guest.
-func (p *machinePage) refreshAccess() {
-	ready := p.active() && p.ready
-
-	for _, row := range []*adw.ActionRow{p.appRow, p.rdpRow, p.sshRow} {
-		row.SetSensitive(ready)
-	}
-
-	p.serialRow.SetSensitive(p.active())
-}
-
-// refreshStorage writes the facts that no dialog changes.
-func (p *machinePage) refreshStorage() {
-	p.diskPathRow.SetSubtitle(p.def.DiskPathValue())
-}
