-	if err != nil {
-		return 0, 0
-	}
-
-	var read, written int64
-
-	for _, line := range strings.Split(string(data), "\n") {
-		fields := strings.Fields(line)
-		if len(fields) != 2 {
-			continue
-		}
-
-		value, err := strconv.ParseInt(fields[1], 10, 64)
-		if err != nil {
-			continue
-		}
-
-		switch fields[0] {
-		case "read_bytes:":
-			read = value
-		case "write_bytes:":
-			written = value
-		}
-	}
-
-	return read, written
-}
