-// dialog builds a modal dialog with a cancel control and one affirmative
-// control. The widgets of headerEnd sit in the header bar, before the affirmative
-// control or the close button.
-func (a *App) dialog(scope *callbackScope, title string, subtitle string, actionLabel string, content *gtk.Widget, action func() bool, headerEnd ...*gtk.Widget) *adw.Dialog {
-	dialog := adw.NewDialog()
