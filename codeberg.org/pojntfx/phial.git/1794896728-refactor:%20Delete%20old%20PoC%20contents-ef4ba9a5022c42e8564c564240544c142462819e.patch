-		binary, _ = filepath.Abs(os.Args[0])
-	}
-
-	conn.ResetFailedUnitContext(context.Background(), "phial-expire-"+id+".timer")
-	_, _ = conn.StopUnitContext(context.Background(), "phial-expire-"+id+".timer", "replace", nil)
