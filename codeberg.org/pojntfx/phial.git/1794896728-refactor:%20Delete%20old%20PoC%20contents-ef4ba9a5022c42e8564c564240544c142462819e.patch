-	a.locationForm = nil
-	a.setupNavigation = nil
-	a.setupSteps = nil
-	a.setupToasts = nil
-
-	if a.setupDialog != nil {
-		a.setupDialog.ForceClose()
-		a.setupDialog = nil
-	}
