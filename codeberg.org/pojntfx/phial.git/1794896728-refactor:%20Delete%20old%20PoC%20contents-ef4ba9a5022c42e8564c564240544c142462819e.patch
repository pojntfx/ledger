-// installCommand states the command that installs the host service. The
-// command names the host-install subcommand of the application, and carries
-// the chosen folders, because the host process cannot read the settings of the
-// sandbox.
-func (a *App) installCommand() string {
-	set := paths.Current()
-
-	// The command runs the deployment binary of the Flatpak, because the host
-	// does not reach the binary inside the sandbox and the old host install
-	// may carry an incompatible copy.
-	return host.InstallCommand(set.Config.HostPath(), set.Data.HostPath(), set.SSH.HostPath())
-}
-
-// rootSetupCommand states the command that prepares the host. It names the
-// installed command, because the host does not reach the folder of the user.
-// run0 starts the command from the system manager, which an SELinux host
-// denies the execute permission on a binary in the home folder, so a shell
-// starts the binary.
-func (a *App) rootSetupCommand() string {
-	binary := setup.HostCLI()
-	if binary == "" {
-		binary = "phial"
-	}
-
-	return "run0 /bin/sh -c 'exec \"$0\" root-setup' " + shellQuote(binary)
-}
-
-// copyCommand copies the command and marks the step as read. The window cannot
-// read the host state from the sandbox, so the step trusts the copy.
-func (s *setupStep) copyCommand() {
-	if s.command == "" {
-		return
-	}
-
-	s.app.copyText(s.command, "")
-
-	if s.app.setupToasts != nil {
-		toast := adw.NewToast(i18n.L("Command copied"))
-		toast.SetTimeout(4)
-		s.app.setupToasts.AddToast(toast)
-	}
-
-	s.copied = true
-
-	if s.copyRow != nil {
-		s.copyRow.SetTitle(i18n.L("Command Copied"))
-		s.copyRow.SetStartIconName("object-select-symbolic")
-	}
-
-	s.update()
-}
