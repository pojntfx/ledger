-
-	// The runtime folder belongs to this process, so the window can create it
-	// before it asks whether the folders are ready.
-	if err := os.MkdirAll(set.Runtime.AccessPath(), 0o700); err != nil {
-		a.Log.Warn("could not create the runtime folder", "err", err)
-	}
-
-	configured := a.Settings.GetBoolean(resources.SettingLocationsSetKey)
-	required := !configured || !paths.Valid(set)
-
-	a.Log.Info(
-		"preparing the folders",
-		"configured", configured,
-		"valid", paths.Valid(set),
-		"config", set.Config.AccessPath(),
-		"required", required,
-	)
