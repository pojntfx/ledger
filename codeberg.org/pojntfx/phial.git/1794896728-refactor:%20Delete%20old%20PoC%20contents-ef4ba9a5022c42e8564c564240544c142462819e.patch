-// prepareGuestScript states the script for the agent of the machine, which
-// runs as root, so it states the user of the guest and the runtime directory
-// of that user for every step that belongs to a session of that user.
-func prepareGuestScript(script string) string {
-	script = strings.ReplaceAll(script, "~/", guestHome+"/")
-	script = strings.ReplaceAll(script, "$HOME", guestHome)
-	script = strings.ReplaceAll(script, "\nsystemctl --user", "\n"+guestAsUser+" systemctl --user")
-	script = strings.ReplaceAll(script, "\ngsettings", "\n"+guestAsUser+" gsettings")
-	script = strings.ReplaceAll(script, "\nloginctl", "\n"+guestAsUser+" loginctl")
-
-	return script + "\nchown -R phial:phial " + guestHome + "/.config " + guestHome + "/.local " + guestHome + "/.agents 2>/dev/null || true"
-}
