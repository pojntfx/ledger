-package mcp
-
-import (
-	"errors"
-	"fmt"
-	"sync"
-	"time"
-)
-
-const approvalTTL = 5 * time.Minute
-
-// The categories of a request: a grant opens access for a time, a change
-// edits the store or the keys of the host.
-const (
-	CategoryGrant  = "grant"
-	CategoryChange = "change"
-)
-
-type Approval struct {
-	ID       string    `json:"id"`
-	Action   string    `json:"action"`
-	Detail   string    `json:"detail"`
-	Category string    `json:"category"`
-	VM       string    `json:"vm"`
-	Created  time.Time `json:"created"`
-
-	execute func() error
-}
-
-type Approvals struct {
-	mu      sync.Mutex
-	pending map[string]Approval
-	nextID  int
-	notify  func(summary, body string)
-}
-
-func NewApprovals(notify func(summary, body string)) *Approvals {
-	return &Approvals{
-		pending: map[string]Approval{},
-		notify:  notify,
-	}
-}
-
-func (a *Approvals) Create(category, action, detail, vm string, execute func() error) (string, error) {
-	a.mu.Lock()
-	defer a.mu.Unlock()
-
-	a.nextID++
-	id := fmt.Sprintf("req-%d", a.nextID)
-
-	a.pending[id] = Approval{
-		ID:       id,
-		Action:   action,
-		Detail:   detail,
-		Category: category,
-		VM:       vm,
-		Created:  time.Now(),
-		execute:  execute,
-	}
-
-	if a.notify != nil {
-		summary := "phial agent request"
-		if category == CategoryGrant {
-			summary = "phial grant request"
-		}
-
-		a.notify(summary, fmt.Sprintf("%s: %s", action, detail))
-	}
-
-	return id, nil
-}
-
-func (a *Approvals) List() []Approval {
-	a.mu.Lock()
-	defer a.mu.Unlock()
-
-	var out []Approval
-
-	for id, approval := range a.pending {
-		if time.Since(approval.Created) > approvalTTL {
-			delete(a.pending, id)
-
-			continue
-		}
-
-		out = append(out, approval)
-	}
-
-	return out
-}
-
-func (a *Approvals) Answer(id string, approve bool) error {
-	a.mu.Lock()
-
-	approval, ok := a.pending[id]
-	if !ok {
-		a.mu.Unlock()
-
-		return errors.New("no pending request with that id")
-	}
-
-	delete(a.pending, id)
-	a.mu.Unlock()
-
-	if !approve {
-		return nil
-	}
-
-	return approval.execute()
-}
