-
-	page.hubNames = append(page.hubNames[:0], page.def.USBXHCIs...)
-	page.hubEmpty.SetVisible(len(page.def.USBXHCIs) == 0)
-	page.hubGroup.Add(&page.addHubRow.Widget)
