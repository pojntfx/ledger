-// ErrNotConnected states that the client has no connection to the host
-// service. The window opens before the application connects, so a call
-// reports the missing service instead of a panic.
-var ErrNotConnected = errors.New("the host service is not connected")
-
-// Client is the typed varlink client of the application. It keeps the socket
-// path instead of one connection, so every call opens its own connection: a
-// long call, such as a restart, never holds up a status read.
-type Client struct {
-	path string
-}
-
-// SocketPath states the socket of the host service. A test or a development
-// run points PHIAL_CONTROL_SOCK somewhere else.
-func SocketPath() string {
-	if override := os.Getenv("PHIAL_CONTROL_SOCK"); override != "" {
-		return override
-	}
-
-	dir := os.Getenv("XDG_RUNTIME_DIR")
-	if dir == "" {
-		dir = fmt.Sprintf("/run/user/%d", os.Getuid())
-	}
-
-	return filepath.Join(dir, "phial", "control.sock")
-}
-
-// Dial checks that the host service answers. The first connection starts the
-// service through socket activation.
-func Dial() (*Client, error) {
-	path := SocketPath()
-
-	conn, err := net.Dial("unix", path)
-	if err != nil {
-		return nil, err
-	}
-	conn.Close()
-
-	return &Client{path: path}, nil
-}
-
-// DialRetry connects to the host service and retries once, because the first
-// connection starts the service through socket activation.
-func DialRetry() (*Client, error) {
-	client, err := Dial()
-	if err == nil {
-		return client, nil
-	}
-
-	time.Sleep(time.Second)
-
-	return Dial()
-}
-
-// Close ends the client. Every call closes its own connection, so there is
-// nothing left to close.
-func (c *Client) Close() error {
-	return nil
-}
-
-// call sends one request to the host service over a fresh connection. A nil
-// client, or a client without a path, reports ErrNotConnected.
-func (c *Client) call(ctx context.Context, method string, in any, out any) error {
-	if c == nil || c.path == "" {
-		return ErrNotConnected
-	}
-
-	conn, err := net.Dial("unix", c.path)
-	if err != nil {
-		return err
-	}
-	defer conn.Close()
-
-	return varlink.NewClient(conn).Call(ctx, method, in, out)
-}
