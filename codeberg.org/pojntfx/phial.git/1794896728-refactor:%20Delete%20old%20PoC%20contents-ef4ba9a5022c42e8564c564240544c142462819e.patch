-// qgaSend states whether the agent of the machine received one request.
-func qgaSend(conn net.Conn, payload qgaRequest) error {
-	data, err := json.Marshal(payload)
-	if err != nil {
-		return err
-	}
-
-	_, err = conn.Write(append(data, '\n'))
-
-	return err
-}
-
-// qgaRead states one envelope of the agent of the machine, including its
-// error, so that the caller can skip the leftover replies of a connection that
-// ended early instead of failing on them.
-func qgaRead(decoder *json.Decoder) (qgaEnvelope, error) {
-	var envelope qgaEnvelope
-	if err := decoder.Decode(&envelope); err != nil {
-		return qgaEnvelope{}, err
-	}
-
-	return envelope, nil
-}
-
-// QgaCall states the reply of the agent of the machine for one request. The
-// agent states one client at a time, so every call holds the lock of the agent.
-func QgaCall(def Definition, execute string, arguments interface{}) (json.RawMessage, error) {
-	qgaLock.Lock()
-	defer qgaLock.Unlock()
-
-	conn, err := net.DialTimeout("unix", filepath.Join(def.RuntimePathValue(), "qga.sock"), 5*time.Second)
-	if err != nil {
-		return nil, err
-	}
-	defer conn.Close()
-
-	_ = conn.SetDeadline(time.Now().Add(30 * time.Second))
-
-	decoder := json.NewDecoder(conn)
-
-	// The agent can carry the reply of a connection that ended early, so the
-	// call states a unique value first and reads until the agent states that
-	// value; every reply before it belongs to the connection that ended early.
-	sync := time.Now().UnixNano()
-
-	if err := qgaSend(conn, qgaRequest{Execute: "guest-sync", Arguments: map[string]interface{}{"id": sync}}); err != nil {
-		return nil, err
-	}
-
-	for {
-		envelope, err := qgaRead(decoder)
-		if err != nil {
-			return nil, err
-		}
-
-		if envelope.Error != nil {
-			continue
-		}
-
-		var value int64
-		if err := json.Unmarshal(envelope.Return, &value); err != nil {
-			continue
-		}
-
-		if value == sync {
-			break
-		}
-	}
-
-	if err := qgaSend(conn, qgaRequest{Execute: execute, Arguments: arguments}); err != nil {
-		return nil, err
-	}
-
-	// The synchronization flushed every leftover reply, so the next envelope is
-	// the reply of this request, even when it carries a number, like the handle
-	// of guest-file-open.
-	envelope, err := qgaRead(decoder)
-	if err != nil {
-		return nil, err
-	}
-
-	if envelope.Error != nil {
-		return nil, fmt.Errorf("%s", envelope.Error.Desc)
-	}
-
-	return envelope.Return, nil
-}
-
-func QgaNetworkBytes(def Definition) (int64, int64, error) {
-	raw, err := QgaCall(def, "guest-network-get-interfaces", nil)
-	if err != nil {
-		return 0, 0, err
-	}
-
-	var interfaces []qgaInterface
-	if err := json.Unmarshal(raw, &interfaces); err != nil {
-		return 0, 0, err
-	}
-
-	var rx, tx int64
-
-	for _, iface := range interfaces {
-		if iface.Name == "lo" {
-			continue
-		}
-
-		rx += iface.Statistics.RxBytes
-		tx += iface.Statistics.TxBytes
-	}
-
-	return rx, tx, nil
-}
