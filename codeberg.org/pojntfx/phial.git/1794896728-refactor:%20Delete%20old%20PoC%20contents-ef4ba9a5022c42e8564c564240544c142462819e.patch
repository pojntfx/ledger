-
-	for _, line := range strings.Split(string(data), "\n") {
-		fields := strings.Fields(line)
-		if len(fields) < 2 {
-			continue
-		}
-
-		value, err := strconv.ParseInt(fields[1], 10, 64)
-		if err != nil {
-			continue
-		}
-
-		switch fields[0] {
-		case "HugePages_Free:":
-			freePages = value
-		case "HugePages_Total:":
-			totalPages = value
-		case "Hugepagesize:":
-			pageSize = value * 1024
-		}
-	}
