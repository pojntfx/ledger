-		return err
-	}
-
-	dir := filepath.Join(ConfigDir(), "vms")
-	if err := os.MkdirAll(dir, 0o700); err != nil {
-		return err
-	}
-
-	data, err := json.MarshalIndent(d, "", "  ")
-	if err != nil {
-		return err
-	}
-
-	return renameio.WriteFile(filepath.Join(dir, d.Name+".json"), append(data, '\n'), 0o600, renameio.WithStaticPermissions(0o600))
-}
-
-// List reads every definition.
-func List() ([]Definition, error) {
-	dir := filepath.Join(ConfigDir(), "vms")
-
-	var out []Definition
-
-	err := filepath.WalkDir(dir, func(path string, entry fs.DirEntry, err error) error {
-		if err != nil {
-			return err
-		}
-
-		if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".json") {
-			return nil
-		}
-
-		def, err := Load(strings.TrimSuffix(entry.Name(), ".json"))
-		if err != nil {
-			return nil
-		}
-
-		out = append(out, def)
-
-		return nil
-	})
-	if errors.Is(err, fs.ErrNotExist) {
-		return nil, nil
-	}
-
-	return out, err
-}
-
-// Delete removes the definition of the machine.
-func (d Definition) Delete() error {
-	return os.Remove(filepath.Join(ConfigDir(), "vms", d.Name+".json"))
-}
-
-// GrowDisk grows the disk image of the machine.
-func (d Definition) GrowDisk(size string) error {
-	target, err := ParseSize(size)
-	if err != nil {
-		return err
-	}
-
-	image := d.DiskPathValue()
-
-	info, err := os.Stat(image)
-	if err != nil {
-		return err
-	}
-
-	if target <= info.Size() {
-		return nil
-	}
-
-	return os.Truncate(image, target)
-}
-
-// Rename renames the machine and moves its disk image along.
-func (d Definition) Rename(newName string) error {
-	renamed := d
-	renamed.Name = newName
-
-	oldDisk := d.DiskPathValue()
-	newDisk := renamed.DiskPathValue()
-
-	if oldDisk != newDisk {
-		if _, err := os.Stat(oldDisk); err == nil {
-			if err := os.Rename(oldDisk, newDisk); err != nil {
-				return err
-			}
-		}
-	}
-
-	oldConfig := filepath.Join(ConfigDir(), "vms", d.Name+".json")
-
-	if err := os.Remove(oldConfig); err != nil && !os.IsNotExist(err) {
-		return err
-	}
-
-	return renamed.Save()
-}
-
-// ParseSize reads a size such as 128G as bytes.
-func ParseSize(value string) (int64, error) {
-	value = strings.TrimSpace(value)
-	if value == "" {
-		return 0, errors.New("empty size")
-	}
-
-	last := value[len(value)-1]
-	factor := int64(1)
-	digits := value
-
-	switch last {
-	case 'G', 'g':
-		factor = 1024 * 1024 * 1024
-		digits = value[:len(value)-1]
-	case 'M', 'm':
-		factor = 1024 * 1024
-		digits = value[:len(value)-1]
-	case 'K', 'k':
-		factor = 1024
-		digits = value[:len(value)-1]
-	}
-
-	number, err := strconv.ParseInt(digits, 10, 64)
-	if err != nil {
-		return 0, fmt.Errorf("invalid size %q", value)
-	}
-
-	return number * factor, nil
-}
-
-// MemoryMiB reads a memory size such as 16G as mebibytes.
-func MemoryMiB(memory string) (int, error) {
-	memory = strings.TrimSpace(memory)
-	if memory == "" {
-		return 0, errors.New("empty memory size")
-	}
-
-	last := memory[len(memory)-1]
-	factor := 1
-	digits := memory
-
-	switch last {
-	case 'G', 'g':
-		factor = 1024
-		digits = memory[:len(memory)-1]
-	case 'M', 'm':
-		digits = memory[:len(memory)-1]
-	case 'K', 'k':
-		digits = memory[:len(memory)-1]
-		factor = 0
-	}
-
-	value, err := strconv.Atoi(digits)
-	if err != nil {
-		return 0, fmt.Errorf("invalid memory size %q", memory)
-	}
-
-	if factor == 0 {
-		return value / 1024, nil
-	}
-
-	return value * factor, nil
-}
