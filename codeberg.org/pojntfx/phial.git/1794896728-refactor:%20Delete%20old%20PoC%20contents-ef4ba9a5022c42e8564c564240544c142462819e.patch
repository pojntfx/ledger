-// runHostInstall runs the install command that the wizard shows. It extracts
-// the embedded phiald to ~/.local/bin/phiald, writes phiald.socket and
-// phiald.service, calls run0 phiald root-setup once, and enables and starts
-// phiald.socket. The command is idempotent, and the update command is the same
-// command without the folder arguments.
-func runHostInstall(args []string) error {
-	configPath := ""
-	dataPath := ""
-	sshPath := ""
-	skipRootSetup := false
-
-	for index := 0; index < len(args); index++ {
-		arg := args[index]
-
-		value := func() string {
-			if index+1 < len(args) {
-				index++
-
-				return args[index]
-			}
-
-			return ""
-		}
-
-		switch {
-		case arg == "--config":
-			configPath = value()
-		case strings.HasPrefix(arg, "--config="):
-			configPath = strings.TrimPrefix(arg, "--config=")
-		case arg == "--data":
-			dataPath = value()
-		case strings.HasPrefix(arg, "--data="):
-			dataPath = strings.TrimPrefix(arg, "--data=")
-		case arg == "--ssh":
-			sshPath = value()
-		case strings.HasPrefix(arg, "--ssh="):
-			sshPath = strings.TrimPrefix(arg, "--ssh=")
-		case arg == "--skip-root-setup":
-			skipRootSetup = true
-		}
-	}
-
-	if configPath != "" || dataPath != "" || sshPath != "" {
-		set := paths.Current()
-
-		if configPath != "" {
-			set.Config = paths.Location{Host: configPath, Access: configPath}
-		}
-		if dataPath != "" {
-			set.Data = paths.Location{Host: dataPath, Access: dataPath}
-		}
-		if sshPath != "" {
-			set.SSH = paths.Location{Host: sshPath, Access: sshPath}
-		}
-
-		paths.SetCurrent(set)
-	}
-
-	return setup.HostInstall(setup.InstallOptions{
-		Config:        configPath,
-		Data:          dataPath,
-		SSH:           sshPath,
-		SkipRootSetup: skipRootSetup,
-	})
-}
-
-// runtimeDir states the runtime directory of the session, which holds the
-// sockets that a service and its client share.
-func runtimeDir() string {
-	dir := os.Getenv("XDG_RUNTIME_DIR")
-	if dir == "" {
-		dir = fmt.Sprintf("/run/user/%d", os.Getuid())
-	}
-
-	return dir
-}
-
-func runForwardGuest(args []string) error {
-	if len(args) < 1 {
-		return fmt.Errorf("usage: phial forward-guest <name>")
-	}
-
-	name := args[0]
-	kind := os.Getenv("PHIAL_KIND")
-	port := os.Getenv("PHIAL_PORT")
-
-	binary, err := exec.LookPath("socat")
-	if err != nil {
-		return err
-	}
-
-	vsock := "VSOCK:2:" + port
-
-	var command *exec.Cmd
-
-	switch kind {
-	case "tcp":
-		command = exec.Command(binary, "TCP6-LISTEN:"+port+",fork,bind=[::1],reuseaddr", vsock)
-	case "unix":
-		target := os.Getenv("PHIAL_SOCKET")
-
-		// %t is the runtime directory, where the sockets of a session live.
-		target = strings.ReplaceAll(target, "%t", runtimeDir())
-
-		if strings.HasPrefix(target, "~/") {
-			home, err := os.UserHomeDir()
-			if err != nil {
-				return err
-			}
-
-			target = filepath.Join(home, target[2:])
-		} else if !strings.HasPrefix(target, "/") {
-			target = filepath.Join(runtimeDir(), "phial", target)
-		}
-
-		// A session starts without the directory of its sockets, so make it here.
-		if err := os.MkdirAll(filepath.Dir(target), 0o700); err != nil {
-			return err
-		}
-
-		command = exec.Command(binary, "UNIX-LISTEN:"+target+",fork,unlink-early", vsock)
-	default:
-		return fmt.Errorf("unknown PHIAL_KIND %q for %s", kind, name)
-	}
-
-	command.Stdout = os.Stdout
-	command.Stderr = os.Stderr
-
-	return command.Run()
-}
