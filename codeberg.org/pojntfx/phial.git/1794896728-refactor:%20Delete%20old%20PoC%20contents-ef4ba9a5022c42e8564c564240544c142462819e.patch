-func (a *App) addHubController(page *machinePage, address string) {
-	a.goAsync(func() (string, error) {
-		if _, _, err := a.Service.UsbBind(a.Ctx, nil, mcp.AddressInput{Address: address}); err != nil {
-			return "", err
-		}
-
-		def, err := machine.Load(page.def.Name)
-		if err != nil {
-			return "", err
-		}
-
-		def.USBXHCIs = append(def.USBXHCIs, address)
-		if err := def.Save(); err != nil {
-			return "", err
-		}
-
-		a.idle(func() {
-			if a.machinePages[def.Name] != page {
-				return
