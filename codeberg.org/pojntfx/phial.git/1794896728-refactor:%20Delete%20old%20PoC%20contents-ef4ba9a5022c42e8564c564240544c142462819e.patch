-// capture renders the window into a PNG file. It exists for the automated
-// screenshot runs in tests/.
-func (a *App) capture(path string) string {
-	window := a.win
-	if window == nil {
-		return "no window"
-	}
-
-	// A window that just gained or lost an in-window dialog can sit without an
-	// allocation for a moment. Asking for one makes the next frame whole.
-	window.Widget.QueueAllocate()
-	window.Widget.QueueDraw()
-
-	children := []*gtk.Widget{}
-	for child := window.Widget.GetFirstChild(); child != nil; child = child.GetNextSibling() {
-		children = append(children, child)
-	}
-
-	if len(children) == 0 {
-		return "no child"
-	}
-
-	// An AdwApplicationWindow holds the content and the host that draws an
-	// in-window dialog. The host has no size of its own once a dialog closed, so
-	// the size comes from the window and every child is drawn in order.
-	width := window.Widget.GetWidth()
-	height := window.Widget.GetHeight()
-	if width <= 0 || height <= 0 {
-		width = children[0].GetWidth()
-		height = children[0].GetHeight()
-	}
-
-	if width <= 0 || height <= 0 {
-		return "the window has no size yet"
-	}
-
-	// Render the full allocation, because the ink of the widget tree alone can
-	// be smaller than the window.
-	bounds := &graphene.Rect{}
-	bounds.Init(0, 0, float32(width), float32(height))
-
-	var background gdk.RGBA
-	window.Widget.GetStyleContext().LookupColor("window_bg_color", &background)
-
-	native := window.Widget.GetNative()
-	if native == nil {
-		return "no native surface"
-	}
-
-	render := func() *gdk.Texture {
-		snapshot := gtk.NewSnapshot()
-		snapshot.AppendColor(&background, bounds)
-
-		for _, child := range children {
-			snapshot.Save()
-
-			// A dialog host can lose its allocation while its page changes. Its
-			// child still carries the content, so the capture draws that child
-			// in the middle of the window instead.
-			if child.GetWidth() > 0 && child.GetHeight() > 0 {
-				window.Widget.SnapshotChild(child, snapshot)
-			} else if content := child.GetFirstChild(); content != nil && content.GetWidth() > 0 && content.GetHeight() > 0 {
-				point := graphene.Point{
-					X: float32((width - content.GetWidth()) / 2),
-					Y: float32((height - content.GetHeight()) / 2),
-				}
-				snapshot.Translate(&point)
-				child.SnapshotChild(content, snapshot)
-			} else if child.GetFirstChild() != nil {
-				window.Widget.SnapshotChild(child, snapshot)
-			}
-
-			snapshot.Restore()
-		}
-
-		node := snapshot.ToNode()
-		if node == nil {
-			return nil
-		}
-
-		return native.GetRenderer().RenderTexture(node, bounds)
-	}
-
-	// The first frame of a freshly mapped window is empty, so one render warms
-	// the renderer up and the second one carries the content.
-	if render() == nil {
-		return "no texture"
-	}
-
-	texture := render()
-	if texture == nil {
-		return "no texture"
-	}
-
-	if !texture.SaveToPng(path) {
-		return "could not save " + path
-	}
-
-	message := "captured " + path + fmt.Sprintf(" (%dx%d)", texture.GetWidth(), texture.GetHeight())
-	fields := []any{"window_width", window.Widget.GetWidth(), "window_height", window.Widget.GetHeight()}
-	if a.split != nil {
-		fields = append(fields, "collapsed", a.split.GetCollapsed())
-	}
-	a.Log.Info(message, fields...)
-
-	return message
-}
