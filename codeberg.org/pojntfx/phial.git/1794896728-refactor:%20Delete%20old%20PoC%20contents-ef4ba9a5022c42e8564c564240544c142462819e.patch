-func DiscoverMPVExecutable() (string, error) {
-	if _, err := os.Stat("/.flatpak-info"); err == nil {
-		if err := exec.Command("flatpak-spawn", "--host", "mpv", "--version").Run(); err == nil {
-			return "flatpak-spawn --host mpv", nil
-		}
