-// renderHubControllers writes the controller rows with the names that the
-// caller knows. An empty name list leaves the generic label in place until the
-// worker answers.
-func (a *App) renderHubControllers(page *machinePage, names map[string]string) {
-	if sameStrings(page.hubNames, page.def.USBXHCIs) {
-		for index, row := range page.hubRows {
-			address := page.def.USBXHCIs[index]
-			row.SetTitle(hubText(address, names))
-			row.SetSubtitle(address)
-		}
-		return
-	}
-
-	page.hubGroup.Remove(&page.addHubRow.Widget)
-	for _, row := range page.hubRows {
-		page.hubGroup.Remove(&row.Widget)
-	}
-	page.hubRows = nil
-
-	for _, address := range page.def.USBXHCIs {
-		address := address
-
-		row := adw.NewActionRow()
-		row.SetTitle(hubText(address, names))
-		row.SetSubtitle(address)
-		row.SetSubtitleSelectable(true)
-
-		remove := a.iconButton("user-trash-symbolic", i18n.L("Remove Hub"), func() {
-			a.removeHubController(page, address)
-		})
-		row.AddSuffix(&remove.Widget)
-		page.hubGroup.Add(&row.Widget)
-		page.hubRows = append(page.hubRows, row)
