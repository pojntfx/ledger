-// NamePattern is the name that the host service accepts: lower case letters,
-// digits, and dashes.
-var NamePattern = regexp.MustCompile(`^[a-z0-9-]+$`)
-
-// namePattern is the wider name form that existing definitions carry.
-var namePattern = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_-]*$`)
