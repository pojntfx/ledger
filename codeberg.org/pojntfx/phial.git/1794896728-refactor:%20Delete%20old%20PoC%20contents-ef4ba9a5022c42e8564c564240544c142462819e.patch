-			"PHIAL_RUNTIME_DIR=" + c.RuntimeHostDir(),
-			"PATH=" + os.Getenv("PATH"),
-		})},
-		{Name: "CollectMode", Value: dbus.MakeVariant("inactive-or-failed")},
-	}
-
-	aux := []systemdDbus.PropertyCollection{
-		{Name: "phial-expire-" + id + ".service", Properties: service},
-	}
-
-	_, err = conn.StartTransientUnitAux(context.Background(), "phial-expire-"+id+".timer", "replace", timer, aux, nil)
-
-	return err
