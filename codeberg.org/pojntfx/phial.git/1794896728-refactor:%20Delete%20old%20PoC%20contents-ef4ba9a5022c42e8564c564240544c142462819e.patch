-const usage = `phial: virtual machines, secrets, and agents under host control
-
-Usage:
-  phial                       open the window (also serves the agent channel)
-  phial --background          start in the background, for autostart
-  phial --version             print the version and the build identity
-  phial host-install [--config <path>] [--data <path>] [--ssh <path>]
-                              [--skip-root-setup]
-                              install the embedded host service, the install
-                              command that the wizard shows
-  phial acceptance            run the host acceptance checks
-  phial forward-guest <name>  forward one socket to the host, guest side
-  phial run <command...>      run a command with the granted secrets, guest side
-  phial set <name> [--mode env|proxy] [--upstream <url>]   store a secret, value from stdin
-  phial allow (--for <duration> | --once | --until-revoked) [--vm <machine>] <target>
-                              grant a secret, agent://<comment>, or gpg-agent:// to a machine
-  phial revoke [--vm <machine>] <id or target>
-  phial status               show the grants
-  phial ls                   list the secret and key names, never the values
-`
-
