-// requestBackground keeps the application in the background and registers it
-// to start at login through the Background portal. The application stays in
-// the background to keep the MCP server reachable. When the Background portal
-// is missing the application exits, because autostart needs the portal and the
-// host service already runs after the first start.
-func (a *App) requestBackground() {
-	defer func() {
-		if recovered := recover(); recovered != nil {
-			a.Log.Info("the background request panicked", "err", recovered)
-		}
-	}()
-
-	if !portals.BackgroundAvailable() {
-		a.Log.Info("the Background portal is missing, exiting")
-
-		a.idle(func() {
-			a.quit()
-		})
-
-		return
-	}
-
-	result, err := background.RequestBackground("", &background.RequestOptions{
-		Reason: i18n.L("Machines can ask for access while Phial runs."),
-	})
-	if err != nil {
-		a.Log.Info("the background request failed", "err", err)
-		return
-	}
-
-	if !result.Background {
-		a.Log.Info("the background request was denied")
-		return
-	}
-
-	// The application autostarts at login through the Background portal.
-	commandline := []string{}
-	if self, err := os.Executable(); err == nil {
-		commandline = append(commandline, self, "--background")
-	}
-
-	if err := portals.EnableAutostart(resources.AppID, commandline); err != nil {
-		a.Log.Info("could not register autostart", "err", err)
-	}
-
-	a.idle(func() {
-		a.background = true
-		if a.win != nil {
-			a.win.Window.SetHideOnClose(true)
-		}
-	})
-}
-
-func (a *App) setBackgroundMessage(message string) {
