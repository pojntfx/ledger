-		12: "toggle button",
-		16: "list",
-		23: "frame",
-		24: "window",
-		25: "dialog",
-		34: "text",
-		40: "page tab",
-		43: "label",
-		62: "table",
-		67: "list item",
-	}
-
-	if name, ok := names[role]; ok {
-		return name
-	}
-
-	return fmt.Sprintf("role-%d", role)
