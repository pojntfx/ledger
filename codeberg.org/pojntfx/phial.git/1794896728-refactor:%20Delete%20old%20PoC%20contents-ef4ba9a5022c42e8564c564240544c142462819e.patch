-func CollectMetrics(def Definition) (Metrics, error) {
-	metrics := Metrics{GPU: def.GPU, VCPUs: def.VCPUs}
-
-	active, _ := MachineRuns(def)
-
-	image := def.DiskPathValue()
-	if info, err := os.Stat(image); err == nil {
-		metrics.DiskAllocated = allocatedBytes(info)
-		metrics.DiskTotal = info.Size()
-	}
-
-	if size, err := parseSize(def.DiskSize); err == nil {
-		metrics.DiskTotal = size
-	}
-
-	metrics.MemoryTotal, _ = parseSize(def.Memory)
-
-	if !active {
-		return metrics, nil
-	}
-
-	pid := qemuPID(def)
-	if pid == 0 {
-		return metrics, nil
-	}
-
-	first, err := processCPUTicks(pid)
-	if err != nil {
-		return metrics, nil
-	}
-
-	engineFirst, engineOK := gpuEngineNs(pid)
-	diskReadFirst, diskWriteFirst := processDiskIO(pid)
-
-	start := time.Now()
-
-	rx, tx, rxErr := QgaNetworkBytes(def)
-	metrics.NetworkReady = rxErr == nil
-
-	time.Sleep(time.Second)
-
-	second, err := processCPUTicks(pid)
-	if err != nil {
-		return metrics, nil
-	}
-
-	engineSecond, _ := gpuEngineNs(pid)
-	diskReadSecond, diskWriteSecond := processDiskIO(pid)
-
-	// The counters count clock ticks of the whole process tree, so the rate
-	// divides by the interval that was measured.
-	elapsed := time.Since(start).Seconds()
-	if elapsed <= 0 {
-		elapsed = 1
-	}
-
-	metrics.CPUPercent = float64(second-first) * 100 / 100 / elapsed
-
-	metrics.MemoryUsed = processRSS(pid)
-
-	if engineOK && engineSecond >= engineFirst {
-		metrics.GPUBusyReady = true
-		metrics.GPUBusyPercent = float64(engineSecond-engineFirst) / (elapsed * 1e9) * 100
-	}
-
-	if diskReadSecond >= diskReadFirst {
-		metrics.DiskReadRate = float64(diskReadSecond-diskReadFirst) / elapsed
-	}
-
-	if diskWriteSecond >= diskWriteFirst {
-		metrics.DiskWriteRate = float64(diskWriteSecond-diskWriteFirst) / elapsed
-	}
-
-	if metrics.NetworkReady {
-		metrics.NetworkRxBytes = rx
-		metrics.NetworkTxBytes = tx
-
-		nextRx, nextTx, err := QgaNetworkBytes(def)
-		if err == nil && nextRx >= rx && nextTx >= tx {
-			metrics.NetworkRxRate = float64(nextRx-rx) / elapsed
-			metrics.NetworkTxRate = float64(nextTx-tx) / elapsed
-		}
-	}
-
-	return metrics, nil
-}
