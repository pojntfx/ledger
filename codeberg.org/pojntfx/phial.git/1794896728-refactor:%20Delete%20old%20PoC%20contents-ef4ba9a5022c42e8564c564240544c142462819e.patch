-func (s *Service) RequestsGrant(ctx context.Context, req *mcpgo.CallToolRequest, input requestGrantInput) (*mcpgo.CallToolResult, any, error) {
-	// The vsock address of the connection names the machine. A connection
-	// without an address, such as the local socket, falls back to the field.
-	vm, ok := VMFromContext(ctx)
-	if !ok {
-		vm = input.VM
-	}
-
-	kind, name := state.TargetKind(input.Target)
-
-	detail := fmt.Sprintf("%s (%s) for %s", name, kind, input.Duration)
-	if boolOf(input.Once) {
-		detail = fmt.Sprintf("%s (%s) for one use", name, kind)
-	}
-
-	id, err := s.approvals.Create(CategoryGrant, "grant", detail, vm, func() error {
-		_, err := s.state.Grant(state.AllowOptions{
-			Target:   input.Target,
-			VM:       vm,
-			Duration: input.Duration,
-			Once:     boolOf(input.Once),
-		})
-
-		return err
-	})
-	if err != nil {
-		return nil, nil, err
-	}
-
-	return nil, map[string]string{"approval": id, "state": "pending"}, nil
-}
