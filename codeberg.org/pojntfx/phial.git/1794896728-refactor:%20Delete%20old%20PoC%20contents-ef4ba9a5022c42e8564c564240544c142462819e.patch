-		panic(err)
-	}
-	app := components.NewApplication(
-		ctx,
-		cancel,
-		log,
-		level,
-		settings,
-		"application_id", resources.AppID,
-		"flags", gio.GApplicationHandlesOpenValue,
-	)
-	os.Exit(int(app.Run(int32(len(os.Args)), os.Args)))
-}
