-// refreshHubControllers reconciles the controller rows of the hub group with
-// the definition and asks a worker goroutine for the controller names. The
-// rows appear at once, so the page never waits for the host.
-func (a *App) refreshHubControllers(page *machinePage) {
-	a.renderHubControllers(page, map[string]string{})
-
-	addresses := append([]string{}, page.def.USBXHCIs...)
-	if len(addresses) == 0 {
-		return
-	}
-
-	name := page.def.Name
-
-	go func() {
-		names := map[string]string{}
-
-		if _, output, err := a.Service.ListXhci(a.Ctx, nil, struct{}{}); err == nil && output != nil {
-			for _, controller := range output.Controllers {
-				if label := shortUSBName(controller.Name); label != "" {
-					names[controller.Address] = label
-				}
-			}
-		}
-
-		a.idle(func() {
-			if a.machinePages[name] != page || !sameStrings(page.def.USBXHCIs, addresses) {
-				return
-			}
-
-			a.renderHubControllers(page, names)
-		})
-	}()
-}
