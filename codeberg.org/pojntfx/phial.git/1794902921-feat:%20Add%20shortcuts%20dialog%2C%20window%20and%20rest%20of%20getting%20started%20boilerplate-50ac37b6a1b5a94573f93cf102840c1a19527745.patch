Subject: [PATCH] feat: Add shortcuts dialog, window and rest of getting started boilerplate
---
diff --git a/assets/resources/shortcuts-dialog.blp b/assets/resources/shortcuts-dialog.blp
new file mode 100644
index 0000000000000000000000000000000000000000..d27b73d2f879e4facc227c331f9dadfee2eb51f7
--- /dev/null
+++ b/assets/resources/shortcuts-dialog.blp
@@ -0,0 +1,28 @@
+using Gtk 4.0;
+using Adw 1;
+
+Adw.ShortcutsDialog shortcuts_dialog {
+  Adw.ShortcutsSection {
+    title: _("General");
+
+    Adw.ShortcutsItem {
+      title: _("Open menu");
+      accelerator: "F10";
+    }
+
+    Adw.ShortcutsItem {
+      title: _("Show keyboard shortcuts");
+      action-name: "app.shortcuts";
+    }
+
+    Adw.ShortcutsItem {
+      title: _("Close window");
+      action-name: "win.closeWindow";
+    }
+
+    Adw.ShortcutsItem {
+      title: _("Quit");
+      action-name: "app.quit";
+    }
+  }
+}
diff --git a/assets/resources/window.blp b/assets/resources/window.blp
new file mode 100644
index 0000000000000000000000000000000000000000..64a7a782ca0aa3ffcde8093a81711b26f66e7b27
--- /dev/null
+++ b/assets/resources/window.blp
@@ -0,0 +1,52 @@
+using Gtk 4.0;
+using Adw 1;
+
+template $PhialMainWindow: Adw.ApplicationWindow {
+  default-width: 360;
+  default-height: 380;
+  title: _("Phial");
+
+  content: Adw.ToolbarView {
+    [top]
+    Adw.HeaderBar {
+      title-widget: Adw.WindowTitle {
+        title: _("Phial");
+      };
+
+      [end]
+      MenuButton menu_button {
+        icon-name: "open-menu-symbolic";
+        tooltip-text: _("Main Menu");
+        primary: true;
+        menu-model: main_menu;
+      }
+    }
+
+    content: Box {
+      orientation: vertical;
+      halign: center;
+      valign: center;
+
+      Label {
+        label: _("Hello, World!");
+        styles [
+          "title-1",
+        ]
+      }
+    };
+  };
+}
+
+menu main_menu {
+  section {
+    item {
+      label: _("_Keyboard Shortcuts");
+      action: "app.shortcuts";
+    }
+
+    item {
+      label: _("_About Phial");
+      action: "app.openAbout";
+    }
+  }
+}
diff --git a/internal/components/application.go b/internal/components/application.go
new file mode 100644
index 0000000000000000000000000000000000000000..f78bf91f18076139c9fba1f63ac8247d3ba4937a
--- /dev/null
+++ b/internal/components/application.go
@@ -0,0 +1,133 @@
+package components
+
+import (
+	"context"
+	"log/slog"
+	"runtime"
+	"unsafe"
+
+	"codeberg.org/pojntfx/phial/assets/resources"
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gio"
+	"codeberg.org/puregotk/puregotk/v4/glib"
+	"codeberg.org/puregotk/puregotk/v4/gobject"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	. "github.com/pojntfx/go-gettext/pkg/i18n"
+)
+
+var (
+	gTypeApplication gobject.Type
+)
+
+type Application struct {
+	adw.Application
+
+	ctx      context.Context
+	settings *gio.Settings
+	log      *slog.Logger
+
+	window      *MainWindow
+	aboutDialog *adw.AboutDialog
+}
+
+func NewApplication(ctx context.Context, settings *gio.Settings, log *slog.Logger, FirstPropertyNameVar string, varArgs ...interface{}) Application {
+	obj := gobject.NewObject(gTypeApplication, FirstPropertyNameVar, varArgs...)
+
+	var v Application
+	obj.Cast(&v)
+
+	app := (*Application)(unsafe.Pointer(obj.GetData(dataKeyGoInstance)))
+
+	app.ctx = ctx
+	app.settings = settings
+	app.log = log
+
+	return v
+}
+
+func init() {
+	var appClassInit gobject.ClassInitFunc = func(tc *gobject.TypeClass, u uintptr) {
+		objClass := (*gobject.ObjectClass)(unsafe.Pointer(tc))
+
+		objClass.OverrideConstructed(func(o *gobject.Object) {
+			parentObjClass := (*gobject.ObjectClass)(unsafe.Pointer(tc.PeekParent()))
+
+			parentObjClass.GetConstructed()(o)
+
+			var parent adw.Application
+			o.Cast(&parent)
+
+			app := &Application{
+				Application: parent,
+			}
+
+			var pinner runtime.Pinner
+			pinner.Pin(app)
+
+			var cleanupCallback glib.DestroyNotify = func(data uintptr) {
+				pinner.Unpin()
+			}
+			o.SetDataFull(dataKeyGoInstance, uintptr(unsafe.Pointer(app)), &cleanupCallback)
+		})
+
+		applicationClass := (*gio.ApplicationClass)(unsafe.Pointer(tc))
+
+		applicationClass.OverrideActivate(func(a *gio.Application) {
+			phialApp := (*Application)(unsafe.Pointer(a.GetData(dataKeyGoInstance)))
+
+			if phialApp.window != nil {
+				phialApp.window.ApplicationWindow.Present()
+				return
+			}
+
+			phialApp.aboutDialog = adw.NewAboutDialogFromAppdata(resources.ResourceMetainfoPath, resources.AppVersion)
+			phialApp.aboutDialog.SetDevelopers(resources.AppDevelopers)
+			phialApp.aboutDialog.SetArtists(resources.AppArtists)
+			phialApp.aboutDialog.SetCopyright(resources.AppCopyright)
+			// TRANSLATORS: Replace "translator-credits" with your name/username, and optionally an email or URL.
+			phialApp.aboutDialog.SetTranslatorCredits(L("translator-credits"))
+
+			var app gtk.Application
+			a.Cast(&app)
+
+			obj := NewMainWindow(phialApp.ctx, &phialApp.Application, phialApp.log, phialApp.settings, "application", app)
+
+			phialApp.window = (*MainWindow)(unsafe.Pointer(obj.GetData(dataKeyGoInstance)))
+
+			openAboutAction := gio.NewSimpleAction("openAbout", nil)
+			onOpenAbout := func(gio.SimpleAction, uintptr) {
+				phialApp.aboutDialog.Present(&phialApp.window.ApplicationWindow.Widget)
+			}
+			openAboutAction.ConnectActivate(&onOpenAbout)
+			phialApp.Application.AddAction(openAboutAction)
+
+			quitAction := gio.NewSimpleAction("quit", nil)
+			onQuit := func(gio.SimpleAction, uintptr) {
+				phialApp.Application.Quit()
+			}
+			quitAction.ConnectActivate(&onQuit)
+			phialApp.Application.AddAction(quitAction)
+
+			phialApp.Application.SetAccelsForAction("app.shortcuts", []string{`<Primary>question`})
+			phialApp.Application.SetAccelsForAction("app.quit", []string{`<Primary>q`})
+
+			phialApp.Application.AddWindow(&phialApp.window.ApplicationWindow.Window)
+			phialApp.window.ApplicationWindow.Present()
+		})
+	}
+
+	var appInstanceInit gobject.InstanceInitFunc = func(ti *gobject.TypeInstance, tc *gobject.TypeClass) {}
+
+	var appParentQuery gobject.TypeQuery
+	gobject.NewTypeQuery(adw.ApplicationGLibType(), &appParentQuery)
+
+	gTypeApplication = gobject.TypeRegisterStaticSimple(
+		appParentQuery.Type,
+		"PhialApplication",
+		appParentQuery.ClassSize,
+		&appClassInit,
+		appParentQuery.InstanceSize,
+		&appInstanceInit,
+		0,
+	)
+}
