+func TestStoreMachineReady(t *testing.T) {
+	s := newTestingStore(t, func(_ context.Context) (bool, error) { return false, nil })
+
+	require.NoError(t, s.AddMachine(t.Context(), MachineConfig{Name: "m1"}))
+	require.NoError(t, s.Install(t.Context(), "m1"))
+
+	for range InstallSteps {
+		require.NoError(t, s.InstallNext(t.Context(), "m1"))
+	}
+
+	require.False(t, s.Machines()[0].Ready)
+
+	require.NoError(t, s.Start(t.Context(), "m1"))
+
+	for range machineTransitionTicks {
+		require.NoError(t, s.advance(t.Context()))
+	}
+
+	require.False(t, s.Machines()[0].Ready)
+
+	require.NoError(t, s.advance(t.Context()))
+	require.False(t, s.Machines()[0].Ready)
+
+	require.NoError(t, s.advance(t.Context()))
+	require.True(t, s.Machines()[0].Ready)
+
+	require.NoError(t, s.Stop(t.Context(), "m1"))
+
+	for range machineTransitionTicks {
+		require.NoError(t, s.advance(t.Context()))
+	}
+
+	require.False(t, s.Machines()[0].Ready)
+}
