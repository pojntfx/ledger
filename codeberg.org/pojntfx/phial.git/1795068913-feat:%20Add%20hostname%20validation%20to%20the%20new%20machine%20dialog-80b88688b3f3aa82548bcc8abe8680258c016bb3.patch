diff --git a/internal/components/create_machine_dialog.go b/internal/components/create_machine_dialog.go
index 92b66bc34111050a628ad0fd3e4491a2fbd8e5db..d812883ee18c62fc16d5687ff817988cf413da93 100644
--- a/internal/components/create_machine_dialog.go
+++ b/internal/components/create_machine_dialog.go
@@ -1,6 +1,7 @@
 package components
 
 import (
+	"log/slog"
 	"runtime"
 	"unsafe"
 
@@ -9,14 +10,22 @@ 	"codeberg.org/puregotk/puregotk/v4/adw"
 	"codeberg.org/puregotk/puregotk/v4/glib"
 	"codeberg.org/puregotk/puregotk/v4/gobject"
 	"codeberg.org/puregotk/puregotk/v4/gtk"
+	"github.com/go-playground/validator/v10"
+	. "github.com/pojntfx/go-gettext/pkg/i18n"
 )
 
 var (
 	gTypeCreateMachineDialog gobject.Type
+	hostnameValidator        = validator.New()
 )
 
 type CreateMachineDialog struct {
 	adw.Dialog
+
+	nameRow         *adw.EntryRow
+	nameErrorButton *gtk.MenuButton
+
+	callbacks []interface{}
 }
 
 func NewCreateMachineDialog() CreateMachineDialog {
@@ -26,13 +35,38 @@
 	var v CreateMachineDialog
 	obj.Cast(&v)
 
+	dialog := (*CreateMachineDialog)(unsafe.Pointer(obj.GetData(dataKeyGoInstance)))
+
+	onAliasChanged := func() {
+		dialog.validateAlias()
+	}
+	dialog.callbacks = append(dialog.callbacks, &onAliasChanged)
+	dialog.nameRow.PreferencesRow.ListBoxRow.Widget.InitiallyUnowned.Object.ConnectSignal("changed", &onAliasChanged)
+
 	return v
 }
 
+func (w *CreateMachineDialog) validateAlias() {
+	name := w.nameRow.GetText()
+	if name == "" || hostnameValidator.Var(name, "hostname_rfc1123,max=253") == nil {
+		w.nameRow.RemoveCssClass("error")
+		w.nameRow.SetTooltipText("")
+		w.nameErrorButton.SetVisible(false)
+
+		return
+	}
+
+	w.nameRow.AddCssClass("error")
+	w.nameRow.SetTooltipText(L("Use a hostname like dev-vm or dev.example"))
+	w.nameErrorButton.SetVisible(true)
+}
+
 func init() {
 	var dialogClassInit gobject.ClassInitFunc = func(tc *gobject.TypeClass, u uintptr) {
 		typeClass := (*gtk.WidgetClass)(unsafe.Pointer(tc))
 		typeClass.SetTemplateFromResource(resources.ResourceCreateMachineDialogUIPath)
+		typeClass.BindTemplateChildFull("name_row", false, 0)
+		typeClass.BindTemplateChildFull("name_error_button", false, 0)
 
 		objClass := (*gobject.ObjectClass)(unsafe.Pointer(tc))
 
@@ -45,14 +79,39 @@ 			o.Cast(&parent)
 
 			parent.InitTemplate()
 
+			var (
+				nameRow         adw.EntryRow
+				nameErrorButton gtk.MenuButton
+			)
+
+			parent.Widget.GetTemplateChild(
+				gTypeCreateMachineDialog,
+				"name_row",
+			).Cast(&nameRow)
+			parent.Widget.GetTemplateChild(
+				gTypeCreateMachineDialog,
+				"name_error_button",
+			).Cast(&nameErrorButton)
+
 			d := &CreateMachineDialog{
 				Dialog: parent,
+
+				nameRow:         &nameRow,
+				nameErrorButton: &nameErrorButton,
+
+				callbacks: []interface{}{},
 			}
 
 			var pinner runtime.Pinner
 			pinner.Pin(d)
 
 			var cleanupCallback glib.DestroyNotify = func(data uintptr) {
+				for _, callback := range d.callbacks {
+					if err := glib.UnrefCallback(callback); err != nil {
+						slog.Default().Error("Could not unref callback", "err", err)
+					}
+				}
+
 				pinner.Unpin()
 			}
 			o.SetDataFull(dataKeyGoInstance, uintptr(unsafe.Pointer(d)), &cleanupCallback)
