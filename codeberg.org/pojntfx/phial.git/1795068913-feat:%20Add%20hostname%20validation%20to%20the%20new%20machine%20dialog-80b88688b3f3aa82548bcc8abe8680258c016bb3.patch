From 80b88688b3f3aa82548bcc8abe8680258c016bb3 Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Wed, 18 Nov 2026 23:15:13 -0700
Subject: [PATCH] feat: Add hostname validation to the new machine dialog
---
diff --git a/assets/resources/create-machine-dialog.blp b/assets/resources/create-machine-dialog.blp
index 61bc596fc6beca51ae7778ca3c5e7bb0ce07e083..a483369de90ddeb78d0d9f0fd2563e5812fd3631 100644
--- a/assets/resources/create-machine-dialog.blp
+++ b/assets/resources/create-machine-dialog.blp
@@ -39,10 +39,23 @@       Adw.PreferencesGroup {
         title: _("Identity");
         description: _("The name becomes the SSH host alias");
 
-        Adw.EntryRow {
+        Adw.EntryRow name_row {
           title: _("_Name");
           use-underline: true;
           activates-default: true;
+
+          [suffix]
+          MenuButton name_error_button {
+            visible: false;
+            icon-name: "dialog-warning-symbolic";
+            tooltip-text: _("Show Error");
+            valign: center;
+            popover: name_error_popover;
+            styles [
+              "flat",
+              "circular",
+            ]
+          }
         }
       }
 
@@ -97,3 +110,14 @@       }
     };
   };
 }
+
+Popover name_error_popover {
+  Label {
+    label: _("Use a hostname like dev-vm or dev.example");
+    wrap: true;
+    max-width-chars: 40;
+    xalign: 0;
+    selectable: true;
+    accessible-role: alert;
+  }
+}
