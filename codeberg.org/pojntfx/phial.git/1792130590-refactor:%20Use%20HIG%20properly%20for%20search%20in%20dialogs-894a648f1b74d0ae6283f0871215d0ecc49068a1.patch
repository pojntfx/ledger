+
+// dialogSearch builds a modal list dialog with a search button at the start
+// of the header bar and a search bar that slides out below it. Typing into the
+// dialog opens the search bar too, as the HIG asks for searchable lists. The
+// widgets of headerEnd sit in the header bar, to the left of the native close
+// button.
+func (a *App) dialogSearch(scope *callbackScope, title string, subtitle string, content *gtk.Widget, placeholder string, headerEnd ...*gtk.Widget) (*adw.Dialog, *gtk.SearchEntry) {
+	dialog := adw.NewDialog()
+	dialog.SetTitle(i18n.L(title))
+	dialog.SetContentWidth(460)
+	dialog.SetContentHeight(560)
+
+	toolbar := adw.NewToolbarView()
+	header := adw.NewHeaderBar()
+
+	windowTitle := adw.NewWindowTitle(i18n.L(title), i18n.L(subtitle))
+	header.SetTitleWidget(&windowTitle.Widget)
+
+	searchButton := gtk.NewToggleButton()
+	searchButton.SetIconName("system-search-symbolic")
+	searchButton.SetTooltipText(i18n.L("Search"))
+	searchButton.SetValign(gtk.AlignCenterValue)
+	header.PackStart(&searchButton.Widget)
+
+	searchEntry := gtk.NewSearchEntry()
+	searchEntry.SetPlaceholderText(i18n.L(placeholder))
+	searchEntry.SetHexpand(true)
+
+	searchBar := gtk.NewSearchBar()
+	searchBar.SetChild(&searchEntry.Widget)
+	searchBar.SetKeyCaptureWidget(&dialog.Widget)
+	searchButton.BindProperty("active", &searchBar.Widget.Object, "search-mode-enabled", gobject.GBindingBidirectionalValue|gobject.GBindingSyncCreateValue)
+
+	keyController := gtk.NewEventControllerKey()
+
+	var onKey func(gtk.EventControllerKey, uint32, uint32, gdk.ModifierType) bool
+	onKey = func(_ gtk.EventControllerKey, keyval uint32, _ uint32, state gdk.ModifierType) bool {
+		if keyval == uint32(gdk.KEY_f) && state&gdk.ControlMaskValue != 0 {
+			searchButton.SetActive(!searchButton.GetActive())
+
+			return true
+		}
+
+		return false
+	}
+	keyController.ConnectKeyPressed(&onKey)
+	scope.hold(&onKey)
+	dialog.AddController(&keyController.EventController)
+
+	for _, widget := range headerEnd {
+		header.PackEnd(widget)
+	}
+
+	a.searchToggle = searchButton
+	a.searchEntry = searchEntry
+
+	var onClosed func(adw.Dialog)
+	onClosed = func(adw.Dialog) {
+		if a.searchToggle == searchButton {
+			a.searchToggle = nil
+			a.searchEntry = nil
+		}
+	}
+	dialog.ConnectClosed(&onClosed)
+	scope.hold(&onClosed)
+
+	toolbar.AddTopBar(&header.Widget)
+	toolbar.AddTopBar(&searchBar.Widget)
+	toolbar.SetContent(content)
+	dialog.SetChild(&toolbar.Widget)
+
+	return dialog, searchEntry
 }
 
