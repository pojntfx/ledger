From 4e5bc16335d69c75d7d0d593f003fae25cbfe1b3 Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Tue, 17 Nov 2026 13:14:25 -0700
Subject: [PATCH] feat: Add tool to extract graphs from state machines during development
---
diff --git a/.gitignore b/.gitignore
index 672f66f9f6d076333cab41df991b5b268161d233..aff58eda9cceab9fb1f09a43f75f4fb3352007a3 100644
--- a/.gitignore
+++ b/.gitignore
@@ -10,3 +10,4 @@ builddir
 repo
 .foundry
 vendor
+graphs/
diff --git a/README.md b/README.md
index f05d2b541ec06993e7e51def7c0c127b2f0de494..778f0d669e83d8c15383d930bc909564ba54e87d 100644
--- a/README.md
+++ b/README.md
@@ -67,6 +67,12 @@ $ go generate ./...
 $ go run -ldflags="-X 'main.LocaleDir=${PWD}/po' -X 'main.SchemaDir=${PWD}/assets/resources'" .
 ```
 
+To dump the state machine graphs to `graphs/`, run:
+
+```shell
+$ go run ./cmd/phial-graphs
+```
+
 You can also open the project in [GNOME Builder](https://flathub.org/apps/org.gnome.Builder) and run it by clicking the play button in the header bar, or use [Foundry](https://gitlab.gnome.org/GNOME/foundry) directly:
 
 ```shell
diff --git a/cmd/phial-graphs/main.go b/cmd/phial-graphs/main.go
new file mode 100644
index 0000000000000000000000000000000000000000..ce61cbaef403e4e4e4beca92861c77917ee46bf4
--- /dev/null
+++ b/cmd/phial-graphs/main.go
@@ -0,0 +1,26 @@
+package main
+
+import (
+	"context"
+	"log/slog"
+	"os"
+	"path/filepath"
+
+	"codeberg.org/pojntfx/phial/pkg/state"
+)
+
+const (
+	dir = "graphs"
+)
+
+func main() {
+	if err := os.MkdirAll(dir, os.ModePerm); err != nil {
+		panic(err)
+	}
+
+	session := state.NewSession(context.Background(), slog.Default(), &state.SessionHooks{})
+
+	if err := os.WriteFile(filepath.Join(dir, "session.dot"), []byte(session.ToGraph()), os.ModePerm); err != nil {
+		panic(err)
+	}
+}

