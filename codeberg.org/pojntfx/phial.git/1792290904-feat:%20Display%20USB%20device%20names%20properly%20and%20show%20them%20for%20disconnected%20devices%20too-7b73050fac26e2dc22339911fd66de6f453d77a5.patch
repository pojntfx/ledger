+// USBNames resolves the human names of USB devices from the host database,
+// including devices that are not attached right now.
+func (c *Client) USBNames(ctx context.Context, ids []string) (*USBNamesResponse, error) {
+	var out USBNamesResponse
+
+	if err := c.call(ctx, "USBNames", USBNamesRequest{IDs: ids}, &out); err != nil {
+		return nil, err
+	}
+
+	return &out, nil
+}
