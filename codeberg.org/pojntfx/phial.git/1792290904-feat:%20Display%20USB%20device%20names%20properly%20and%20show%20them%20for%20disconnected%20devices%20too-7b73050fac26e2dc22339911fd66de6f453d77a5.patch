 func shortUSBName(name string) string {
+	name = strings.Join(strings.Fields(name), " ")
+
 	for _, suffix := range []string{" Corporation", " Inc.", " Ltd", " GmbH", " Corp.", " Co., Ltd."} {
 		name = strings.TrimSuffix(name, suffix)
 	}
+
 	return name
 }

