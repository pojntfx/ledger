diff --git a/cmd/phiald/usb_test.go b/cmd/phiald/usb_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..58dcc6959f0df9e8dc0792aa0860150f7c1d955f
--- /dev/null
+++ b/cmd/phiald/usb_test.go
@@ -0,0 +1,24 @@
+package main
+
+import "testing"
+
+// TestUSBDeviceNameCollapsesWhitespace keeps the sysfs newlines out of the
+// device names that the window and the agent show.
+func TestUSBDeviceNameCollapsesWhitespace(t *testing.T) {
+	tests := []struct {
+		manufacturer string
+		product      string
+		want         string
+	}{
+		{"Intel Corporation\n", "USB3 HUB\n", "Intel Corporation USB3 HUB"},
+		{"Realtek\n", "\n", "Realtek"},
+		{"", "", ""},
+		{"  Foo  \n Bar  ", " Baz ", "Foo Bar Baz"},
+	}
+
+	for _, tt := range tests {
+		if got := usbDeviceName(tt.manufacturer, tt.product); got != tt.want {
+			t.Fatalf("usbDeviceName(%q, %q) = %q, want %q", tt.manufacturer, tt.product, got, tt.want)
+		}
+	}
+}
