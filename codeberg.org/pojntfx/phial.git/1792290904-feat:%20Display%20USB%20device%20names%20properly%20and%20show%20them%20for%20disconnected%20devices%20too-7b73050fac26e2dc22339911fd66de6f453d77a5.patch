+// usbNameLookup resolves an ID from the USB ID database. A test replaces it.
+var usbNameLookup = virt.USBName
+
 // usbList answers the USBList call: the USB devices of the host and the
 // xHCI controllers, with what any machine already forwards.
 func (s *service) usbList() (*host.USBListResponse, *varlink.Error) {
@@ -40,9 +43,12 @@ 			continue
 		}
 
 		id := vendor + ":" + product
-		name := strings.TrimSpace(readSysfs(filepath.Join(filepath.Dir(vendorFile), "manufacturer")) + " " + readSysfs(filepath.Join(filepath.Dir(vendorFile), "product")))
+		name := usbDeviceName(
+			readSysfs(filepath.Join(filepath.Dir(vendorFile), "manufacturer")),
+			readSysfs(filepath.Join(filepath.Dir(vendorFile), "product")),
+		)
 		if name == "" {
-			name = virt.USBName(vendor, product)
+			name = usbNameLookup(vendor, product)
 		}
 
 		entry := host.USBDevice{ID: id, Name: name}
@@ -87,6 +93,32 @@ 		return ""
 	}
 
 	return string(data)
+}
+
+// usbDeviceName joins the manufacturer and product strings of one device. The
+// sysfs files end in a newline, so the result collapses every whitespace run
+// into one space.
+func usbDeviceName(manufacturer, product string) string {
+	return strings.Join(strings.Fields(manufacturer+" "+product), " ")
+}
+
+// usbNames resolves the human names of the given IDs from the USB ID database,
+// so a configured device keeps its name while it is unplugged.
+func (s *service) usbNames(ids []string) (*host.USBNamesResponse, *varlink.Error) {
+	names := map[string]string{}
+
+	for _, id := range ids {
+		vendor, product, ok := strings.Cut(id, ":")
+		if !ok {
+			continue
+		}
+
+		if name := usbNameLookup(vendor, product); name != "" {
+			names[id] = name
+		}
+	}
+
+	return &host.USBNamesResponse{Names: names}, nil
 }
 
