--- /dev/null
+++ b/cmd/phiald/usbnames_test.go
@@ -0,0 +1,37 @@
+package main
+
+import "testing"
+
+// TestUSBNamesResolvesDetachedIDs verifies that the host answers the names of
+// devices that are not attached, so the window can keep them.
+func TestUSBNamesResolvesDetachedIDs(t *testing.T) {
+	old := usbNameLookup
+	defer func() { usbNameLookup = old }()
+
+	usbNameLookup = func(vendor, product string) string {
+		if vendor == "0403" && product == "6001" {
+			return "FT232 Serial (UART) IC"
+		}
+
+		return ""
+	}
+
+	s := &service{}
+
+	response, callErr := s.usbNames([]string{"0403:6001", "1a86:55d3", "invalid"})
+	if callErr != nil {
+		t.Fatalf("usbNames() failed: %v", callErr)
+	}
+
+	if got := response.Names["0403:6001"]; got != "FT232 Serial (UART) IC" {
+		t.Fatalf("the known ID resolved to %q", got)
+	}
+
+	if _, ok := response.Names["1a86:55d3"]; ok {
+		t.Fatal("the unknown ID received a name")
+	}
+
+	if len(response.Names) != 1 {
+		t.Fatalf("usbNames() returned %d names, want 1", len(response.Names))
+	}
+}
