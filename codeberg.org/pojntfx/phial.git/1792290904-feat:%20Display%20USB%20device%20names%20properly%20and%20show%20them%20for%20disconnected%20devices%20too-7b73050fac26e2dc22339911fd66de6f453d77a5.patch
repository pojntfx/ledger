diff --git a/internal/ui/usb_test.go b/internal/ui/usb_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..48b3caac8cecb5e571c6f915bcba7c9bb43d49c0
--- /dev/null
+++ b/internal/ui/usb_test.go
@@ -0,0 +1,34 @@
+package ui
+
+import "testing"
+
+// TestShortUSBNameCollapsesWhitespace keeps a sysfs newline out of a device
+// row, including rows that an older host service sends.
+func TestShortUSBNameCollapsesWhitespace(t *testing.T) {
+	tests := []struct {
+		name string
+		want string
+	}{
+		{"Intel Corporation\nUSB3 HUB\n", "Intel Corporation USB3 HUB"},
+		{"  Foo  Bar  ", "Foo Bar"},
+		{"Foo Corporation", "Foo"},
+		{"", ""},
+	}
+
+	for _, tt := range tests {
+		if got := shortUSBName(tt.name); got != tt.want {
+			t.Fatalf("shortUSBName(%q) = %q, want %q", tt.name, got, tt.want)
+		}
+	}
+}
+
+// TestDimMarkupEscapesText keeps a device name from injecting markup into the
+// dimmed label.
+func TestDimMarkupEscapesText(t *testing.T) {
+	got := dimMarkup("A & B")
+	want := `<span alpha="55%">A &amp; B</span>`
+
+	if got != want {
+		t.Fatalf("dimMarkup() = %q, want %q", got, want)
+	}
+}
