-func (a *SecretsPreferences) chooseGPGHome() {
-	initial := a.gpgHome
+func (a *SecretsPreferences) choosePGPAgentSocket() {
+	initial := a.pgpAgentSocket
 	if initial == "" {
-		initial = state.MockGPGHome()
+		initial = state.MockPGPAgentSocket()
+	}
+
+	fileDialog := gtk.NewFileDialog()
+	fileDialog.SetTitle(L("Choose a PGP Agent Socket"))
+
+	if initial != "" {
+		if folder := initialFolder(filepath.Dir(initial)); folder != "" {
+			fileDialog.SetInitialFolder(gio.FileNewForPath(folder))
+		}
 	}
 
-	onGPGHomeChosen := chooseFolder(a.parent, a.log, L("Choose the PGP Keyring Folder"), initial, func(path string) {
-		a.setGPGHome(path)
+	var onSocketChosen gio.AsyncReadyCallback
+	onSocketChosen = gio.AsyncReadyCallback(func(_ uintptr, resultPtr uintptr, _ uintptr) {
+		result := gio.AsyncResultBase{Ptr: resultPtr}
+
+		file, err := fileDialog.OpenFinish(&result)
+		if err != nil {
+			a.log.Error("Could not choose PGP agent socket", "err", err)
+
+			return
+		}
+
+		if file == nil {
+			return
+		}
+
+		a.setPGPAgentSocket(file.GetPath())
 	})
-	a.callbacks = append(a.callbacks, &onGPGHomeChosen)
+	a.callbacks = append(a.callbacks, &onSocketChosen)
+
+	var parentWindow gtk.Window
+	a.parent.Cast(&parentWindow)
+
+	fileDialog.Open(&parentWindow, nil, &onSocketChosen, 0)
 }
 
