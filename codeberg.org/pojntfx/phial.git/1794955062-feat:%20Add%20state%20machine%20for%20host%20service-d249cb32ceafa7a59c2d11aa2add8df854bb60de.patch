index 3482b0c118c4e72d30b3354f7db8ca1ea22d95a2..3d282db194b84bd393ef3c7f742d43491bdcba74 100644
--- a/pkg/state/constants.go
+++ b/pkg/state/constants.go
@@ -24,6 +24,36 @@ 	triggerSetupBack sessionTrigger = "setupBack"
 	triggerFinish    sessionTrigger = "finish"
 )
 
+type hostState string
+
+const (
+	hostConnecting hostState = "connecting"
+	hostOnline     hostState = "online"
+	hostOutdated   hostState = "outdated"
+	hostUpdating   hostState = "updating"
+	hostError      hostState = "error"
+)
+
+type hostTrigger string
+
+const (
+	triggerHostConnect  hostTrigger = "connect"
+	triggerHostOutdated hostTrigger = "markOutdated"
+	triggerHostUpdate   hostTrigger = "startUpdate"
+	triggerHostFinish   hostTrigger = "finishUpdate"
+	triggerHostFail     hostTrigger = "fail"
+)
+
+type HostStatus string
+
+const (
+	HostStatusConnecting HostStatus = "connecting"
+	HostStatusOnline     HostStatus = "online"
+	HostStatusOutdated   HostStatus = "outdated"
+	HostStatusUpdating   HostStatus = "updating"
+	HostStatusError      HostStatus = "error"
+)
+
