@@ -14,13 +14,21 @@ 	dir = "graphs"
 )
 
 func main() {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
 	if err := os.MkdirAll(dir, os.ModePerm); err != nil {
 		panic(err)
 	}
 
-	session := state.NewSession(context.Background(), slog.Default(), &state.SessionHooks{})
