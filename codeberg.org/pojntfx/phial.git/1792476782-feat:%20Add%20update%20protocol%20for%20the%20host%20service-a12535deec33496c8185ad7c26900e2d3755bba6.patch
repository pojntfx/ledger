diff --git a/cmd/phiald/update.go b/cmd/phiald/update.go
new file mode 100644
index 0000000000000000000000000000000000000000..a98f0b81e6722a7037d0a5b384f9aa1987293db0
--- /dev/null
+++ b/cmd/phiald/update.go
@@ -0,0 +1,129 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"codeberg.org/pojntfx/phial-neo/internal/host"
+	"codeberg.org/pojntfx/phial-neo/internal/setup"
+	"codeberg.org/pojntfx/phial-neo/internal/version"
+)
+
+func hostUpdate() (*host.StateResponse, error) {
+	source, err := installedFlatpakService()
+	if err != nil {
+		return nil, err
+	}
+
+	build, err := binaryBuild(source)
+	if err != nil {
+		return nil, err
+	}
+
+	if build == version.Build() {
+		return &host.StateResponse{State: "current"}, nil
+	}
+
+	if err := installService(source); err != nil {
+		return nil, err
+	}
+
+	if err := scheduleServiceRestart(); err != nil {
+		return nil, err
+	}
+
+	return &host.StateResponse{State: "updating"}, nil
+}
+
+func installedFlatpakService() (string, error) {
+	attempts := [][]string{
+		{"info", "--user", "--show-location", version.AppID},
+		{"info", "--show-location", version.AppID},
+	}
+
+	for _, args := range attempts {
+		output, err := exec.Command("flatpak", args...).Output()
+		if err != nil {
+			continue
+		}
+
+		candidate := filepath.Join(strings.TrimSpace(string(output)), "files", "bin", "phiald")
+
+		info, err := os.Lstat(candidate)
+		if err == nil && info.Mode().IsRegular() {
+			return candidate, nil
+		}
+	}
+
+	return "", fmt.Errorf("could not find the installed Phial host service")
+}
+
+func binaryBuild(path string) (string, error) {
+	output, err := exec.Command(path, "--version").Output()
+	if err != nil {
+		return "", fmt.Errorf("read the build of %s: %w", path, err)
+	}
+
+	value := strings.TrimSpace(string(output))
+
+	open := strings.LastIndex(value, "(")
+	close := strings.LastIndex(value, ")")
+	if open < 0 || close <= open {
+		return "", fmt.Errorf("the build of %s is missing", path)
+	}
+
+	return value[open+1 : close], nil
+}
+
+func installService(source string) error {
+	data, err := os.ReadFile(source)
+	if err != nil {
+		return err
+	}
+
+	target := setup.HostCLI()
+	if target == "" {
+		return fmt.Errorf("could not resolve the host service path")
+	}
+
+	if err := os.MkdirAll(filepath.Dir(target), 0o700); err != nil {
+		return err
+	}
+
+	temporary := target + ".new"
+
+	if err := os.WriteFile(temporary, data, 0o755); err != nil {
+		return err
+	}
+
+	if err := os.Chmod(temporary, 0o755); err != nil {
+		return err
+	}
+
+	return os.Rename(temporary, target)
+}
+
+func scheduleServiceRestart() error {
+	unit := fmt.Sprintf("phiald-update-%d", time.Now().UnixNano())
+
+	output, err := exec.Command(
+		"systemd-run",
+		"--user",
+		"--collect",
+		"--on-active=2",
+		"--unit="+unit,
+		"systemctl",
+		"--user",
+		"restart",
+		"phiald.service",
+	).CombinedOutput()
+	if err != nil {
+		return fmt.Errorf("schedule the host service restart: %w: %s", err, strings.TrimSpace(string(output)))
+	}
+
+	return nil
+}
