diff --git a/internal/ui/hostupdate.go b/internal/ui/hostupdate.go
new file mode 100644
index 0000000000000000000000000000000000000000..8c84d3c0be54da26eb4a318bb33f6e12e9feb96d
--- /dev/null
+++ b/internal/ui/hostupdate.go
@@ -0,0 +1,105 @@
+package ui
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+
+	"codeberg.org/pojntfx/phial-neo/internal/host"
+)
+
+func (a *App) updateHostService() {
+	if a.hostUpdating {
+		return
+	}
+
+	if !host.Embedded() {
+		a.toast(i18n.L("This build carries no host service"))
+		return
+	}
+
+	running := a.runningMachines()
+	if len(running) == 0 {
+		a.runHostUpdate()
+		return
+	}
+
+	dialog := adw.NewAlertDialog(
+		i18n.L("Update the Host Service?"),
+		fmt.Sprintf(i18n.L("The update restarts the host service and stops %s."), strings.Join(running, ", ")),
+	)
+	dialog.AddResponse("cancel", i18n.L("_Cancel"))
+	dialog.AddResponse("update", i18n.L("_Update"))
+	dialog.SetResponseAppearance("update", adw.ResponseSuggestedValue)
+	dialog.SetCloseResponse("cancel")
+
+	var cb func(adw.AlertDialog, string)
+	cb = func(_ adw.AlertDialog, response string) {
+		if response == "update" {
+			a.runHostUpdate()
+		}
+	}
+	dialog.ConnectResponse(&cb)
+	a.hold(&cb)
+
+	dialog.Present(&a.win.Widget)
+}
+
+func (a *App) runHostUpdate() {
+	client := a.hostClient()
+	if client == nil {
+		a.toast(i18n.L("The host service is not connected"))
+		return
+	}
+
+	a.hostUpdating = true
+	a.hostUpdateError = ""
+	a.refreshHostBanner()
+
+	go func() {
+		if _, err := client.HostUpdate(a.Ctx); err != nil {
+			a.Log.Info("could not update the host service", "err", err)
+
+			a.idle(func() {
+				a.hostUpdating = false
+				a.hostUpdateError = err.Error()
+				a.refreshHostBanner()
+				a.toast(i18n.L("The host service update failed"))
+			})
+
+			return
+		}
+
+		deadline := time.Now().Add(45 * time.Second)
+
+		for time.Now().Before(deadline) {
+			ctx, cancel := context.WithTimeout(a.Ctx, 5*time.Second)
+			info, infoErr := client.Info(ctx)
+			cancel()
+
+			if infoErr == nil && !host.NeedsUpdate(info) {
+				a.idle(func() {
+					a.hostUpdating = false
+					a.hostUpdateError = ""
+					a.requestHostRefresh()
+					a.refreshHostBanner()
+					a.toast(i18n.L("The host service is up to date"))
+				})
+
+				return
+			}
+
+			time.Sleep(500 * time.Millisecond)
+		}
+
+		a.idle(func() {
+			a.hostUpdating = false
+			a.hostUpdateError = i18n.L("The host service did not answer after the update")
+			a.refreshHostBanner()
+		})
+	}()
+}
