@@ -0,0 +1,46 @@
+package guest
+
+import (
+	"strings"
+	"testing"
+
+	"codeberg.org/pojntfx/phial-neo/cmd/phiald/virt"
+)
+
+func TestShareMountScriptQuotesPaths(t *testing.T) {
+	def := virt.Definition{
+		Name: "test",
+		Shares: []string{
+			"/home/phial/My Documents",
+		},
+		ShareTargets: map[string]string{
+			"/home/phial/My Documents": "/mnt/My Documents",
+		},
+	}
+
+	script := shareMountScript(def)
+
+	for _, want := range []string{
+		"sudo install -d -m 0755 '/mnt/My Documents'",
+		"sudo mount '/mnt/My Documents'",
+		"my-documents /mnt/My\\040Documents virtiofs",
+	} {
+		if !strings.Contains(script, want) {
+			t.Fatalf("shareMountScript() = %q, want it to contain %q", script, want)
+		}
+	}
+}
+
+func TestShellQuoteHandlesQuotes(t *testing.T) {
+	got := shellQuote("/mnt/it's here")
+
+	if got != `'/mnt/it'\''s here'` {
+		t.Fatalf("shellQuote() = %q", got)
+	}
+}
+
+func TestFstabFieldEscapesSpaces(t *testing.T) {
+	if got := fstabField("/mnt/My Documents"); got != `/mnt/My\040Documents` {
+		t.Fatalf("fstabField() = %q", got)
+	}
+}
