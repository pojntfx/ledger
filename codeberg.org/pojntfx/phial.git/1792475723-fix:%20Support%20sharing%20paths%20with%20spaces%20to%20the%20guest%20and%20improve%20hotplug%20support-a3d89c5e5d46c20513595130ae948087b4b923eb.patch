@@ -91,12 +91,12 @@ 		// The installer creates parts of the home directory as root, so the
 		// labels are repaired before the session of the user writes units.
 		"sudo restorecon -R $HOME > /dev/null 2>&1 || true",
 		// The secrets mount is read-only, so an existing directory stays as it is.
-		"[ -d "+hostshareMount+" ] || sudo install -d -m 0755 "+hostshareMount,
-		"[ -d "+secretsMount+" ] || sudo install -d -m 0755 "+secretsMount,
-		"grep -q ' "+hostshareMount+" ' /etc/fstab || echo 'hostshare "+hostshareMount+" virtiofs defaults,nofail 0 0' | sudo tee -a /etc/fstab > /dev/null",
-		"grep -q ' "+secretsMount+" ' /etc/fstab || echo 'phial-secrets "+secretsMount+" virtiofs ro,nosuid,nodev,noexec,nofail 0 0' | sudo tee -a /etc/fstab > /dev/null",
-		"sudo mountpoint -q "+hostshareMount+" || sudo mount "+hostshareMount+" || true",
-		"sudo mountpoint -q "+secretsMount+" || sudo mount "+secretsMount+" || true",
+		"[ -d "+shellQuote(hostshareMount)+" ] || sudo install -d -m 0755 "+shellQuote(hostshareMount),
+		"[ -d "+shellQuote(secretsMount)+" ] || sudo install -d -m 0755 "+shellQuote(secretsMount),
+		"grep -q "+shellQuote(" "+fstabField(hostshareMount)+" ")+" /etc/fstab || printf '%s\n' "+shellQuote("hostshare "+fstabField(hostshareMount)+" virtiofs defaults,nofail 0 0")+" | sudo tee -a /etc/fstab > /dev/null",
+		"grep -q "+shellQuote(" "+fstabField(secretsMount)+" ")+" /etc/fstab || printf '%s\n' "+shellQuote("phial-secrets "+fstabField(secretsMount)+" virtiofs ro,nosuid,nodev,noexec,nofail 0 0")+" | sudo tee -a /etc/fstab > /dev/null",
+		"sudo mountpoint -q "+shellQuote(hostshareMount)+" || sudo mount "+shellQuote(hostshareMount)+" || true",
+		"sudo mountpoint -q "+shellQuote(secretsMount)+" || sudo mount "+shellQuote(secretsMount)+" || true",
 		shareMountScript(def),
 		"printf 'export SSH_AUTH_SOCK=$XDG_RUNTIME_DIR/phial/ssh-agent.sock\n' | sudo tee /etc/profile.d/phial-agent.sh > /dev/null",
 		"sudo sed -i '/# BEGIN phial/,/# END phial/d' /etc/hosts",
@@ -223,13 +223,53 @@ 		if def.ShareReadOnly(share) {
 			options = "ro,nosuid,nodev,nofail"
 		}
 
-		fmt.Fprintf(&builder, "sudo install -d -m 0755 %s\n", target)
-		fmt.Fprintf(&builder, "sudo sed -i '\\| %s |d' /etc/fstab\n", target)
-		fmt.Fprintf(&builder, "echo '%s %s virtiofs %s 0 0' | sudo tee -a /etc/fstab > /dev/null\n", tag, target, options)
-		fmt.Fprintf(&builder, "sudo mountpoint -q %s || sudo mount %s || true\n", target, target)
+		quoted := shellQuote(target)
+
+		fmt.Fprintf(&builder, "sudo install -d -m 0755 %s\n", quoted)
+		fmt.Fprintf(&builder, "sudo sed -i %s /etc/fstab\n", shellQuote("\\| "+fstabField(target)+" |d"))
+		fmt.Fprintf(&builder, "printf '%%s\\n' %s | sudo tee -a /etc/fstab > /dev/null\n", shellQuote(tag+" "+fstabField(target)+" virtiofs "+options+" 0 0"))
+		fmt.Fprintf(&builder, "sudo mountpoint -q %s || sudo mount %s || true\n", quoted, quoted)
 	}
 
 	return builder.String()
+}
+
+func MountShare(def virt.Definition, share string) error {
+	single := def
+	single.Shares = []string{share}
+
+	_, err := virt.QgaExec(def, shareMountScript(single))
+
+	return err
+}
+
+func RemoveShare(def virt.Definition, share, target string) error {
+	quoted := shellQuote(target)
+
+	script := fmt.Sprintf(
+		"sudo umount %s 2>/dev/null || true\nsudo sed -i %s /etc/fstab\nsudo rmdir %s 2>/dev/null || true\n",
+		quoted,
+		shellQuote("\\| "+fstabField(target)+" |d"),
+		quoted,
+	)
+
+	_, err := virt.QgaExec(def, script)
+
+	return err
+}
+
+func shellQuote(value string) string {
+	return "'" + strings.ReplaceAll(value, "'", "'\\''") + "'"
+}
+
+func fstabField(value string) string {
+	replacer := strings.NewReplacer(
+		"\\", "\\\\",
+		" ", "\\040",
+		"\t", "\\011",
+	)
+
+	return replacer.Replace(value)
 }
 
 func installNetworkScript(mac string) string {
