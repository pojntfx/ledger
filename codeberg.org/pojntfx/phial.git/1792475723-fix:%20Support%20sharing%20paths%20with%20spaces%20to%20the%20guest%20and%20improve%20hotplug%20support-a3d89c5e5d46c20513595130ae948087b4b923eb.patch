diff --git a/cmd/phiald/guest/provision.go b/cmd/phiald/guest/provision.go
index 9c26d256d270e27ff424f0c5b72d822f0e1700ab..11aea5b966a9f20ef68a10b3a3be064ff716c076 100644
--- a/cmd/phiald/guest/provision.go
