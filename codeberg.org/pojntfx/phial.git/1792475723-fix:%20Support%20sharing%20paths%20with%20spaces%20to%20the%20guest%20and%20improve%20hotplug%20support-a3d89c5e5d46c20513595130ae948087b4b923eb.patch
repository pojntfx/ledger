diff --git a/cmd/phiald/share_service_test.go b/cmd/phiald/share_service_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..f11fe25e102256586dd7812c41c737becb8fd375
--- /dev/null
+++ b/cmd/phiald/share_service_test.go
@@ -0,0 +1,101 @@
+package main
+
+import (
+	"context"
+	"io"
+	"log/slog"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"codeberg.org/pojntfx/phial-neo/internal/host"
+	"codeberg.org/pojntfx/phial-neo/internal/machine"
+	"codeberg.org/pojntfx/phial-neo/internal/paths"
+)
+
+func TestShareAddAndRemoveKeepPathsWithSpaces(t *testing.T) {
+	root := t.TempDir()
+
+	previous := paths.Current()
+	paths.SetCurrent(paths.Set{
+		Config:  paths.Location{Host: filepath.Join(root, "config"), Access: filepath.Join(root, "config")},
+		Data:    paths.Location{Host: filepath.Join(root, "data"), Access: filepath.Join(root, "data")},
+		SSH:     paths.Location{Host: filepath.Join(root, "ssh"), Access: filepath.Join(root, "ssh")},
+		Runtime: paths.Location{Host: filepath.Join(root, "runtime"), Access: filepath.Join(root, "runtime")},
+	})
+	t.Cleanup(func() { paths.SetCurrent(previous) })
+
+	for _, dir := range []string{paths.Config().Path(), paths.Data().Path(), paths.SSH().Path(), paths.Runtime().Path()} {
+		if err := os.MkdirAll(dir, 0o700); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	def := machine.Defaults("test")
+	if err := def.Save(); err != nil {
+		t.Fatal(err)
+	}
+
+	share := filepath.Join(root, "My Documents")
+	if err := os.MkdirAll(share, 0o700); err != nil {
+		t.Fatal(err)
+	}
+
+	service := &service{
+		log: slog.New(slog.NewTextHandler(io.Discard, nil)),
+		sup: newSupervisor(slog.New(slog.NewTextHandler(io.Discard, nil))),
+	}
+
+	response, err := service.shareAdd(context.Background(), host.ShareRequest{
+		Machine:  "test",
+		Path:     share,
+		Target:   "/mnt/My Documents",
+		ReadOnly: true,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if response.Path != share || response.Target != "/mnt/My Documents" || !response.ReadOnly {
+		t.Fatalf("shareAdd returned %#v", response)
+	}
+
+	loaded, err := machine.Load("test")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if len(loaded.Shares) != 1 || loaded.Shares[0] != share {
+		t.Fatalf("the definition carries %#v", loaded.Shares)
+	}
+
+	if loaded.ShareTarget(share) != "/mnt/My Documents" {
+		t.Fatalf("the definition carries the target %q", loaded.ShareTarget(share))
+	}
+
+	if !loaded.ShareReadOnly(share) {
+		t.Fatal("the definition does not mark the share read-only")
+	}
+
+	if err := os.RemoveAll(share); err != nil {
+		t.Fatal(err)
+	}
+
+	removed, err := service.shareRemove(context.Background(), host.ShareRequest{Machine: "test", Path: share})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if removed.State != "removed" || removed.Target != "/mnt/My Documents" {
+		t.Fatalf("shareRemove returned %#v", removed)
+	}
+
+	loaded, err = machine.Load("test")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if len(loaded.Shares) != 0 {
+		t.Fatalf("the definition still carries %#v", loaded.Shares)
+	}
+}
diff --git a/cmd/phiald/shares.go b/cmd/phiald/shares.go
new file mode 100644
index 0000000000000000000000000000000000000000..6641d29d5991226ece3fb99864a1f4b9795aff1b
--- /dev/null
+++ b/cmd/phiald/shares.go
@@ -0,0 +1,300 @@
+package main
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"strings"
+	"sync"
+
+	"codeberg.org/pojntfx/phial-neo/cmd/phiald/guest"
+	"codeberg.org/pojntfx/phial-neo/cmd/phiald/virt"
+	"codeberg.org/pojntfx/phial-neo/internal/host"
+	"codeberg.org/pojntfx/phial-neo/internal/machine"
+)
+
+var shareProcesses = struct {
+	sync.Mutex
+	byTag map[string]*os.Process
+}{byTag: map[string]*os.Process{}}
+
+func sharePIDPath(tag string) string {
+	return filepath.Join(machine.RuntimeDir(), "vm", "virtiofsd-"+tag+".pid")
+}
+
+func cleanSharePath(value string) (string, error) {
+	value = strings.TrimRight(strings.TrimSpace(value), "\x00")
+
+	if value == "" {
+		return "", fmt.Errorf("give a host directory to share")
+	}
+
+	if !filepath.IsAbs(value) {
+		return "", fmt.Errorf("the folder %q is not an absolute path", value)
+	}
+
+	return checkFolder(filepath.Clean(value))
+}
+
+func cleanSharePathValue(value string) (string, error) {
+	value = strings.TrimRight(strings.TrimSpace(value), "\x00")
+
+	if value == "" {
+		return "", fmt.Errorf("give a host directory to share")
+	}
+
+	if !filepath.IsAbs(value) {
+		return "", fmt.Errorf("the folder %q is not an absolute path", value)
+	}
+
+	return filepath.Clean(value), nil
+}
+
+func cleanShareTarget(value string) (string, error) {
+	value = strings.TrimSpace(value)
+
+	if value == "" {
+		return "", nil
+	}
+
+	if !strings.HasPrefix(value, "/") {
+		return "", fmt.Errorf("the mount point %q must be absolute", value)
+	}
+
+	if strings.ContainsAny(value, "\x00\n\r") {
+		return "", fmt.Errorf("the mount point must not contain a newline or a NUL byte")
+	}
+
+	return path.Clean(value), nil
+}
+
+func (s *service) shareAdd(ctx context.Context, in host.ShareRequest) (*host.ShareResponse, error) {
+	if err := checkMachineName(in.Machine); err != nil {
+		return nil, err
+	}
+
+	share, err := cleanSharePath(in.Path)
+	if err != nil {
+		return nil, err
+	}
+
+	target, err := cleanShareTarget(in.Target)
+	if err != nil {
+		return nil, err
+	}
+
+	def, err := machine.Load(in.Machine)
+	if err != nil {
+		return nil, err
+	}
+
+	if target == "" {
+		target = def.ShareTarget(share)
+	}
+
+	alreadyShared := slices.Contains(def.Shares, share)
+	previousTarget := def.ShareTarget(share)
+	previousReadOnly := def.ShareReadOnly(share)
+
+	if !alreadyShared {
+		def.Shares = append(def.Shares, share)
+	}
+
+	if def.ShareTargets == nil {
+		def.ShareTargets = map[string]string{}
+	}
+	def.ShareTargets[share] = target
+
+	if in.ReadOnly {
+		if !slices.Contains(def.ReadOnlyShares, share) {
+			def.ReadOnlyShares = append(def.ReadOnlyShares, share)
+		}
+	} else {
+		def.ReadOnlyShares = slices.DeleteFunc(def.ReadOnlyShares, func(existing string) bool {
+			return existing == share
+		})
+	}
+
+	if err := def.Save(); err != nil {
+		return nil, err
+	}
+
+	response := &host.ShareResponse{
+		State:    "shared",
+		Path:     share,
+		Target:   target,
+		ReadOnly: in.ReadOnly,
+	}
+
+	if s.sup.stateOf(def.Name) != stateActive {
+		return response, nil
+	}
+
+	if alreadyShared && (previousTarget != target || previousReadOnly != in.ReadOnly) {
+		if err := guest.RemoveShare(def, share, previousTarget); err != nil {
+			s.log.Warn("could not unmount the changed share in the guest", "machine", def.Name, "share", share, "err", err)
+		}
+	}
+
+	if err := virt.HotplugShare(def, share); err != nil {
+		return nil, fmt.Errorf("attach %s: %w", share, err)
+	}
+
+	if err := guest.MountShare(def, share); err != nil {
+		s.log.Warn("could not mount the new share in the guest", "machine", def.Name, "share", share, "err", err)
+	}
+
+	response.Applied = true
+
+	return response, nil
+}
+
+func (s *service) shareRemove(ctx context.Context, in host.ShareRequest) (*host.ShareResponse, error) {
+	if err := checkMachineName(in.Machine); err != nil {
+		return nil, err
+	}
+
+	share, err := cleanSharePathValue(in.Path)
+	if err != nil {
+		return nil, err
+	}
+
+	if resolved, err := cleanSharePath(in.Path); err == nil {
+		share = resolved
+	}
+
+	def, err := machine.Load(in.Machine)
+	if err != nil {
+		return nil, err
+	}
+
+	previous := def
+	target := def.ShareTarget(share)
+
+	def.Shares = slices.DeleteFunc(def.Shares, func(existing string) bool {
+		return existing == share
+	})
+
+	for existing := range def.ShareTargets {
+		if existing == share {
+			delete(def.ShareTargets, existing)
+		}
+	}
+
+	def.ReadOnlyShares = slices.DeleteFunc(def.ReadOnlyShares, func(existing string) bool {
+		return existing == share
+	})
+
+	if err := def.Save(); err != nil {
+		return nil, err
+	}
+
+	response := &host.ShareResponse{State: "removed", Path: share, Target: target}
+
+	if s.sup.stateOf(def.Name) != stateActive {
+		return response, nil
+	}
+
+	if err := guest.RemoveShare(previous, share, target); err != nil {
+		s.log.Warn("could not unmount the share in the guest", "machine", def.Name, "share", share, "err", err)
+	}
+
+	if err := virt.UnplugShare(previous, share); err != nil {
+		return nil, fmt.Errorf("detach %s: %w", share, err)
+	}
+
+	response.Applied = true
+
+	return response, nil
+}
+
+func startShareTool(tag, share string) error {
+	if err := stopShareTool(tag); err != nil {
+		return err
+	}
+
+	socket := virt.ShareSocket(tag)
+
+	if err := os.MkdirAll(filepath.Dir(socket), 0o700); err != nil {
+		return err
+	}
+
+	_ = os.Remove(socket)
+
+	command := toolCommand("virtiofsd",
+		"--socket-path="+socket,
+		"--shared-dir="+share,
+		"--xattr",
+		"--announce-submounts",
+		"--uid-map=:1000:1000:1:",
+		"--gid-map=:1000:1000:1:",
+	)
+	command.Stdout = os.Stdout
+	command.Stderr = os.Stderr
+
+	if err := command.Start(); err != nil {
+		return err
+	}
+
+	if err := os.WriteFile(sharePIDPath(tag), []byte(strconv.Itoa(command.Process.Pid)), 0o600); err != nil {
+		_ = command.Process.Kill()
+
+		return err
+	}
+
+	shareProcesses.Lock()
+	shareProcesses.byTag[tag] = command.Process
+	shareProcesses.Unlock()
+
+	go func() {
+		_ = command.Wait()
+
+		shareProcesses.Lock()
+		if shareProcesses.byTag[tag] == command.Process {
+			delete(shareProcesses.byTag, tag)
+		}
+		shareProcesses.Unlock()
+	}()
+
+	return nil
+}
+
+func stopShareTool(tag string) error {
+	shareProcesses.Lock()
+	process := shareProcesses.byTag[tag]
+	delete(shareProcesses.byTag, tag)
+	shareProcesses.Unlock()
+
+	if process == nil {
+		data, err := os.ReadFile(sharePIDPath(tag))
+		if err != nil {
+			if os.IsNotExist(err) {
+				return nil
+			}
+
+			return err
+		}
+
+		pid, err := strconv.Atoi(strings.TrimSpace(string(data)))
+		if err != nil {
+			_ = os.Remove(sharePIDPath(tag))
+
+			return nil
+		}
+
+		process, err = os.FindProcess(pid)
+		if err != nil {
+			return err
+		}
+	}
+
+	_ = process.Kill()
+	_ = os.Remove(sharePIDPath(tag))
+	_ = os.Remove(virt.ShareSocket(tag))
+
+	return nil
+}
diff --git a/cmd/phiald/shares_test.go b/cmd/phiald/shares_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..cfad63ec236c7071052623e0e7af4cd414b49571
--- /dev/null
+++ b/cmd/phiald/shares_test.go
@@ -0,0 +1,43 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestCleanShareTargetAcceptsSpaces(t *testing.T) {
+	target, err := cleanShareTarget("/mnt/My Documents/")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if target != "/mnt/My Documents" {
+		t.Fatalf("cleanShareTarget returned %q", target)
+	}
+
+	if _, err := cleanShareTarget("relative"); err == nil {
+		t.Fatal("a relative mount point passed")
+	}
+
+	bad := "/mnt/bad" + string(rune(10)) + "name"
+	if _, err := cleanShareTarget(bad); err == nil {
+		t.Fatal("a mount point with a newline passed")
+	}
+}
+
+func TestCleanSharePathAcceptsSpaces(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "My Documents")
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+
+	path, err := cleanSharePath(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
