diff --git a/guest/install-guest.sh b/guest/install-guest.sh
new file mode 100755
index 0000000000000000000000000000000000000000..0665d1b10af79daa28a338d0ce4b376951886a8c
--- /dev/null
+++ b/guest/install-guest.sh
@@ -0,0 +1,87 @@
+#!/usr/bin/env bash
+set -euo pipefail
+export LC_ALL=C.UTF-8
+
+repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+state="${XDG_DATA_HOME:-$HOME/.local/share}/phial"
+runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/phial"
+assets="$state/install"
+launcher="${XDG_CONFIG_HOME:-$HOME/.config}/phial/phial-vm.sh"
+[[ -f "$launcher" ]] || launcher="$repo/host/phial-vm.sh"
+fedora_base="${PHIAL_FEDORA_URL:-https://download.fedoraproject.org/pub/fedora/linux/development/45/Everything/x86_64}"
+timeout_minutes="${PHIAL_INSTALL_TIMEOUT:-45}"
+
+mkdir -p "$assets" "$runtime/vm"
+
+fetch() {
+    local target="$1" url="$2"
+    if [[ ! -s "$target" ]]; then
+        printf 'fetching %s\n' "$url"
+        curl -fSL --retry 3 -o "$target" "$url"
+    fi
+}
+
+fetch "$assets/vmlinuz" "$fedora_base/os/images/pxeboot/vmlinuz"
+fetch "$assets/initrd.img" "$fedora_base/os/images/pxeboot/initrd.img"
+
+iso_name="$(curl -fsSL --max-time 30 "$fedora_base/iso/" | grep -oE 'Fedora-Everything-netinst-x86_64-45[^"]*\.iso' | sort -u | head -1)"
+[[ -n "$iso_name" ]] || { printf 'no netinst ISO found under %s\n' "$fedora_base/iso/" >&2; exit 1; }
+iso="$assets/$iso_name"
+fetch "$iso" "$fedora_base/iso/$iso_name"
+
+label="$(isoinfo -d -i "$iso" | awk -F': ' '/Volume id/{print $2}')"
+printf 'ISO label: %s\n' "$label"
+
+ks_img="$assets/phial-ks.img"
+rm -f "$ks_img"
+truncate -s 8M "$ks_img"
+mkfs.vfat -n PHIALKS "$ks_img" >/dev/null
+mcopy -i "$ks_img" -o "$repo/guest/phial.ks" ::phial.ks
+printf 'kickstart image: %s\n' "$ks_img"
+
+systemctl --user start phial-swtpm.service phial-virtiofsd@hostshare.service phial-virtiofsd@phial-secrets.service
+systemctl --user stop phial-vm.service 2>/dev/null || true
+systemctl --user stop phial-install.service 2>/dev/null || true
+
+rm -f "$runtime/vm/console.log"
+serial_mode="${PHIAL_INSTALL_SERIAL:-socket}"
+
+systemd-run --user --unit=phial-install --collect     -p "Environment=PHIAL_KERNEL=$assets/vmlinuz"     -p "Environment=PHIAL_INITRD=$assets/initrd.img"     -p "Environment=PHIAL_SHIM=$assets/shim.efi"     -p "Environment=PHIAL_GPU=none"     -p "Environment=\"PHIAL_APPEND=inst.ks=hd:LABEL=$label inst.ks=hd:vdb:/phial.ks inst.repo=$fedora_base/os/ console=tty0 console=ttyS0,115200n8\""     -p "Environment=PHIAL_ISO=$iso"     -p "Environment=PHIAL_KS_IMG=$ks_img"     -p "Environment=PHIAL_SERIAL=$serial_mode"     -p "LimitMEMLOCK=infinity"     -- "$launcher"
+
+if [[ "$serial_mode" == "socket" ]]; then
+    (
+        for _ in $(seq 1 100); do
+            [[ -S "$runtime/vm/console.sock" ]] && break
+            sleep 0.2
+        done
+        socat "UNIX-CONNECT:$runtime/vm/console.sock" - >> "$runtime/vm/console.log" 2>/dev/null
+    ) &
+fi
+
+printf 'installer running as phial-install.service, watching %s\n' "$runtime/vm/console.log"
+
+deadline=$(( $(date +%s) + timeout_minutes * 60 ))
+while [[ "$(date +%s)" -lt "$deadline" ]]; do
+    if [[ -f "$runtime/vm/console.log" ]]; then
+        if grep -q "Restarting system" "$runtime/vm/console.log"; then
+            printf 'install complete, stopping the installer run\n'
+            systemctl --user stop phial-install.service 2>/dev/null || true
+            printf 'start the guest with: systemctl --user start phial-vm.service\n'
+            exit 0
+        fi
+        if grep -qE "An unknown error has occurred|anaconda died|Pane is dead" "$runtime/vm/console.log"; then
+            printf 'installer failed, see %s\n' "$runtime/vm/console.log" >&2
+            systemctl --user stop phial-install.service 2>/dev/null || true
+            exit 1
+        fi
+    fi
+    if ! systemctl --user is-active --quiet phial-install.service; then
+        printf 'phial-install.service ended, see %s\n' "$runtime/vm/console.log" >&2
+        exit 1
+    fi
+    sleep 15
+done
+
+printf 'timeout after %s minutes\n' "$timeout_minutes" >&2
+systemctl --user stop phial-install.service 2>/dev/null || true
+exit 1
