diff --git a/cli/main.go b/cli/main.go
new file mode 100644
index 0000000000000000000000000000000000000000..3b94d6633692c69c38d459163fc414b621a44e4c
--- /dev/null
+++ b/cli/main.go
@@ -0,0 +1,44 @@
+package main
+
+import (
+	"fmt"
+	"log/slog"
+	"os"
+
+	"codeberg.org/pojntfx/phial/pkg/phial"
+)
+
+func main() {
+	log := slog.New(slog.NewTextHandler(os.Stderr, nil))
+
+	client := phial.NewClient(log)
+
+	if len(os.Args) < 2 {
+		fmt.Fprintln(os.Stderr, "usage: phial <sync|allow|revoke|status|ls|run> [arguments]")
+		os.Exit(2)
+	}
+
+	var err error
+	switch os.Args[1] {
+	case "sync":
+		err = client.Sync()
+	case "allow":
+		err = client.Allow(os.Args[2:])
+	case "revoke":
+		err = client.Revoke(os.Args[2:])
+	case "status":
+		err = client.Status()
+	case "ls":
+		err = client.Ls()
+	case "run":
+		err = client.Run(os.Args[2:])
+	default:
+		fmt.Fprintln(os.Stderr, "usage: phial <sync|allow|revoke|status|ls|run> [arguments]")
+		os.Exit(2)
+	}
+
+	if err != nil {
+		log.Error("command failed", "err", err)
+		os.Exit(1)
+	}
+}
