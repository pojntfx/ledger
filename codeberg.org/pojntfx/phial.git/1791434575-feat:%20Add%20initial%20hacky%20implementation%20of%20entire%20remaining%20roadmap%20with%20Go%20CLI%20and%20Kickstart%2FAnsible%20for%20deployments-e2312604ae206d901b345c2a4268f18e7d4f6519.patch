diff --git a/guest/phial.ks b/guest/phial.ks
new file mode 100644
index 0000000000000000000000000000000000000000..3978d96d5f8585ebf9940bde6653e0c64bf93ad9
--- /dev/null
+++ b/guest/phial.ks
@@ -0,0 +1,50 @@
+#version=F45
+text
+lang en_US.UTF-8
+keyboard us
+timezone Etc/UTC --utc
+network --hostname=phial --bootproto=dhcp --device=link --activate
+rootpw --lock
+user --name=phial --groups=wheel --lock --uid=1000 --gid=1000
+bootloader --append="console=tty0 console=ttyS0,115200n8"
+zerombr
+clearpart --all --initlabel
+autopart
+firewall --enabled --ssh
+selinux --enforcing
+services --enabled=sshd,qemu-guest-agent
+firstboot --disabled
+reboot
+
+%packages
+@^workstation-product-environment
+qemu-guest-agent
+socat
+mokutil
+%end
+
+%post --log=/root/phial-post.log
+install -d -m 0700 -o phial -g phial /home/phial/.ssh
+curl -fsSL https://github.com/pojntfx.keys -o /home/phial/.ssh/authorized_keys
+chmod 0600 /home/phial/.ssh/authorized_keys
+chown phial:phial /home/phial/.ssh/authorized_keys
+restorecon -R /home/phial/.ssh
+systemctl set-default graphical.target
+printf '%%wheel ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/90-phial
+chmod 0440 /etc/sudoers.d/90-phial
+install -d -m 0700 -o phial -g phial /home/phial/.config/systemd/user/default.target.wants
+cat > /home/phial/.config/systemd/user/phial-ssh-vsock.service <<'UNIT'
+[Unit]
+Description=phial SSH over vsock
+
+[Service]
+Type=simple
+ExecStart=/usr/bin/socat VSOCK-LISTEN:2222,fork,reuseaddr TCP:[::1]:22
+Restart=on-failure
+
+[Install]
+WantedBy=default.target
+UNIT
+ln -sf ../phial-ssh-vsock.service /home/phial/.config/systemd/user/default.target.wants/phial-ssh-vsock.service
+chown -R phial:phial /home/phial/.config
+%end
