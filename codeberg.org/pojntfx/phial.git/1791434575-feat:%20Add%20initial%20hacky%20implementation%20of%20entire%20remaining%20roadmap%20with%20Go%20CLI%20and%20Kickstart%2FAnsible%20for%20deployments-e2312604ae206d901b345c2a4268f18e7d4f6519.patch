index 0000000000000000000000000000000000000000..7c34230fa6aec9e0b6d7b3ffc273d4aa4d17970b
--- /dev/null
+++ b/tests/serial-shell.py
@@ -0,0 +1,58 @@
+import socket
+import sys
+import threading
+import time
+
+
+class SerialShell:
+    def __init__(self, path, logfile):
+        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        self.sock.connect(path)
+        self.sock.settimeout(0.2)
+        self.buffer = bytearray()
+        self.log = open(logfile, "ab", buffering=0)
+        self.lock = threading.Lock()
+        self.alive = True
+        self.reader = threading.Thread(target=self._read, daemon=True)
+        self.reader.start()
+
+    def _read(self):
+        while self.alive:
+            try:
+                data = self.sock.recv(4096)
+            except socket.timeout:
+                continue
+            except OSError:
+                return
+            if not data:
+                return
+            with self.lock:
+                self.buffer.extend(data)
+            self.log.write(data)
+
+    def send(self, text):
+        self.sock.sendall(text.encode())
+
+    def wait_for(self, patterns, timeout=60):
+        deadline = time.time() + timeout
+        with self.lock:
+            start_len = len(self.buffer)
+        while time.time() < deadline:
+            with self.lock:
+                haystack = bytes(self.buffer[start_len:])
+            for pattern in patterns:
+                if pattern.encode() in haystack:
+                    return pattern, haystack
+            time.sleep(0.3)
+        return None, bytes(self.buffer[start_len:])
+
+
+if __name__ == "__main__":
+    sock_path, logfile = sys.argv[1], sys.argv[2]
+    shell = SerialShell(sock_path, logfile)
+    shell.send("\n")
+    which, _ = shell.wait_for(["login:", "# ", "~]#"], timeout=90)
+    if which == "login:":
+        shell.send("root\n")
+        shell.wait_for(["#"], timeout=30)
+    print("shell ready", flush=True)
