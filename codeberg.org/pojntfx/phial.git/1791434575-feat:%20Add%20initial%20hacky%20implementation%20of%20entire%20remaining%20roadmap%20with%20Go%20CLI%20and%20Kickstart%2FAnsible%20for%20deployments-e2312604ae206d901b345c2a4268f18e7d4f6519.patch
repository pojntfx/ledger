diff --git a/install.sh b/install.sh
new file mode 100755
index 0000000000000000000000000000000000000000..57388763a554153095ace44130324531afc388e0
--- /dev/null
+++ b/install.sh
@@ -0,0 +1,107 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+repo="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
+runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
+data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
+unit_dir="$config_home/systemd/user"
+brew_prefix="$(brew --prefix 2>/dev/null || echo /home/linuxbrew/.linuxbrew)"
+
+install -d -m 0755 "$HOME/.local/bin" "$HOME/.local/share/applications"
+install -d -m 0700 "$config_home/phial" "$config_home/phial/keys" "$unit_dir"
+install -d -m 0755 "$data_home/phial/hostshare"
+
+if command -v go >/dev/null 2>&1; then
+    (cd "$repo/cli" && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o "$repo/bin/phial" .)
+fi
+if [[ ! -x "$repo/bin/phial" ]]; then
+    printf 'phial binary missing and no go toolchain found; run: make build\n' >&2
+    exit 1
+fi
+
+install -m 0755 "$repo/bin/phial" "$repo/bin/phial-acceptance" "$repo/bin/phial-configurator" "$repo/bin/phial-waypipe" "$repo/bin/phial-rdp" "$HOME/.local/bin/"
+install -m 0755 "$repo/host/phial-askpass.sh" "$config_home/phial/phial-askpass.sh"
+
+if [[ ! -f "$config_home/phial/phial-vm.sh" ]]; then
+    install -m 0755 "$repo/host/phial-vm.sh" "$config_home/phial/phial-vm.sh"
+else
+    printf 'keeping your existing %s\n' "$config_home/phial/phial-vm.sh"
+fi
+if [[ ! -f "$config_home/phial/mapping" ]]; then
+    install -m 0600 "$repo/host/mapping" "$config_home/phial/mapping"
+else
+    printf 'keeping your existing %s\n' "$config_home/phial/mapping"
+fi
+if [[ ! -f "$config_home/phial/Caddyfile" ]]; then
+    install -m 0600 "$repo/host/phial-caddy.caddy" "$config_home/phial/Caddyfile"
+fi
+
+tool_path() {
+    command -v "$1" 2>/dev/null || { printf 'phial install: %s not found in PATH\n' "$1" >&2; exit 1; }
+}
+
+caddy_bin="$(tool_path caddy)"
+virtiofsd_bin="$(tool_path virtiofsd)"
+swtpm_bin="$(tool_path swtpm)"
+socat_bin="$(tool_path socat)"
+ssh_agent_bin="$(tool_path ssh-agent)"
+
+for unit in "$repo"/host/systemd/*.service; do
+    sed -e "s|@BREW_PREFIX@|$brew_prefix|g" \
+        -e "s|@CADDY@|$caddy_bin|g" \
+        -e "s|@VIRTIOFSD@|$virtiofsd_bin|g" \
+        -e "s|@SWTPM@|$swtpm_bin|g" \
+        -e "s|@SOCAT@|$socat_bin|g" \
+        -e "s|@SSH_AGENT@|$ssh_agent_bin|g" \
+        "$unit" > "$unit_dir/$(basename "$unit")"
+done
+
+install -m 0644 "$repo/host/share-hostshare.conf" "$config_home/phial/share-hostshare.conf"
+sed -i "s|@DATA_HOME@|$data_home|g" "$config_home/phial/share-hostshare.conf"
+install -m 0644 "$repo/host/share-phial-secrets.conf" "$config_home/phial/share-phial-secrets.conf"
+sed -i "s|@RUNTIME_DIR@|$runtime_dir|g" "$config_home/phial/share-phial-secrets.conf"
+for conf in forward-proxy forward-ssh-agent forward-gpg-extra; do
+    install -m 0644 "$repo/host/$conf.conf" "$config_home/phial/$conf.conf"
+    sed -i "s|@RUNTIME_DIR@|$runtime_dir|g" "$config_home/phial/$conf.conf"
+done
+
+sed "s|@UNIT_DIR@|$unit_dir|g" "$repo/host/desktop/phial-vm-unit.desktop" > "$HOME/.local/share/applications/phial-vm-unit.desktop"
+sed "s|@CFG_DIR@|$config_home/phial|g" "$repo/host/desktop/phial-vm-script.desktop" > "$HOME/.local/share/applications/phial-vm-script.desktop"
+sed "s|@CFG_DIR@|$config_home/phial|g" "$repo/host/desktop/phial-mapping.desktop" > "$HOME/.local/share/applications/phial-mapping.desktop"
+install -m 0644 "$repo/host/desktop/phial-display.desktop" "$HOME/.local/share/applications/phial-display.desktop"
+update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true
+
+ssh_config="$HOME/.ssh/config"
+touch "$ssh_config"
+chmod 0600 "$ssh_config"
+if ! grep -q '# >>> phial >>>' "$ssh_config"; then
+    cat >> "$ssh_config" <<'EOF'
+
+# >>> phial >>>
+Host phial
+    User phial
+    ProxyCommand socat - VSOCK-CONNECT:3:2222
+    IdentityFile ~/.ssh/id_ed25519
+    IdentitiesOnly yes
+    StrictHostKeyChecking accept-new
+# <<< phial <<<
+EOF
+fi
+
+gnupg_conf="$HOME/.gnupg/gpg-agent.conf"
+install -d -m 0700 "$HOME/.gnupg"
+touch "$gnupg_conf"
+chmod 0600 "$gnupg_conf"
+if ! grep -q '# phial' "$gnupg_conf"; then
+    printf '\n# phial\npinentry-program /usr/bin/pinentry-gnome3\n' >> "$gnupg_conf"
+fi
+
+systemctl --user daemon-reload
+systemctl --user enable --now phial-forward@proxy.service
+
+printf 'phial installed. next steps:\n'
+printf '  1. run0 %s\n' "$repo/host/phial-host-root-setup.sh"
+printf '  2. open KeePassXC and unlock the database\n'
+printf '  3. xdg-open %s to adjust the launcher variables\n' "$config_home/phial/phial-vm.sh"
+printf '  4. systemctl --user start phial-vm.service\n'
diff --git a/tests/echo-upstream.py b/tests/echo-upstream.py
new file mode 100644
index 0000000000000000000000000000000000000000..33044d6f32fb28735d0d29f4ce66591298cb9e5a
--- /dev/null
+++ b/tests/echo-upstream.py
@@ -0,0 +1,21 @@
+import socket
+from http.server import BaseHTTPRequestHandler, HTTPServer
+
+
+class Server(HTTPServer):
+    address_family = socket.AF_INET6
+
+
+class Handler(BaseHTTPRequestHandler):
+    def do_GET(self):
+        body = ('auth=' + str(self.headers.get('Authorization')) + ' path=' + self.path).encode()
+        self.send_response(200)
+        self.send_header('Content-Length', str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+    def log_message(self, *args):
+        pass
+
+
+Server(('::1', 18099), Handler).serve_forever()
