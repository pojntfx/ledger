index 0000000000000000000000000000000000000000..962b8af4499be3bba922fd9f4b3e32f5ab4e9501
--- /dev/null
+++ b/guest/config/bin/phial-answer-prompts.sh
@@ -0,0 +1,11 @@
+#!/usr/bin/env bash
+set -u
+"$@" &
+command_pid=$!
+while kill -0 "$command_pid" 2>/dev/null; do
+    for prompt in $(busctl --user tree org.freedesktop.secrets 2>/dev/null | grep -oE "/org/freedesktop/secrets/prompt/[A-Za-z0-9_/-]+"); do
+        busctl --user call org.freedesktop.secrets "$prompt" org.freedesktop.Secret.Prompt Prompt s "" >/dev/null 2>&1 || true
+    done
+    sleep 0.4
+done
+wait "$command_pid"
diff --git a/guest/config/bin/phial-forward-guest b/guest/config/bin/phial-forward-guest
new file mode 100755
index 0000000000000000000000000000000000000000..4f937e9d879090fe690e6586e563f1c9e8e57d09
--- /dev/null
+++ b/guest/config/bin/phial-forward-guest
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+set -euo pipefail
+name="${1:?usage: phial-forward-guest <name>}"
+conf="${XDG_CONFIG_HOME:-$HOME/.config}/phial/forward-$name.conf"
+if [[ ! -f "$conf" ]]; then
+    printf 'phial-forward-guest: no configuration file %s\n' "$conf" >&2
+    exit 1
+fi
+source "$conf"
+listen_family="TCP6-LISTEN"
+loopback="[::1]"
+if [[ ! -f /proc/net/if_inet6 ]]; then
+    listen_family="TCP-LISTEN"
+    loopback="127.0.0.1"
+fi
+case "${PHIAL_KIND:-}" in
+    tcp)
+        exec socat "$listen_family:$PHIAL_PORT,bind=$loopback,fork,reuseaddr" "VSOCK-CONNECT:2:$PHIAL_PORT"
+        ;;
+    unix)
+        case "$PHIAL_SOCKET" in
+            "~/"*) target="$HOME/${PHIAL_SOCKET#\~/}" ;;
+            /*) target="$PHIAL_SOCKET" ;;
+            *) target="$XDG_RUNTIME_DIR/$PHIAL_SOCKET" ;;
+        esac
+        mkdir -p "$(dirname "$target")"
+        exec socat "UNIX-LISTEN:$target,fork,reuseaddr,unlink-early" "VSOCK-CONNECT:2:$PHIAL_PORT"
+        ;;
+    *)
+        printf 'phial-forward-guest: unknown PHIAL_KIND %s\n' "${PHIAL_KIND}" >&2
+        exit 1
+        ;;
+esac
