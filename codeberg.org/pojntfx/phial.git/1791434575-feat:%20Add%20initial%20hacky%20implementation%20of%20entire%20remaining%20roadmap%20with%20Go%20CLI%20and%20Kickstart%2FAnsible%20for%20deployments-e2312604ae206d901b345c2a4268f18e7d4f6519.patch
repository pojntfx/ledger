new file mode 100644
index 0000000000000000000000000000000000000000..d05c9c0c3d9a7fd31b2ca0ef4d5b3f13cffee5f6
--- /dev/null
+++ b/tests/serial-cmd.py
@@ -0,0 +1,49 @@
+import socket
+import sys
+import time
+
+
+def run(sock_path, commands, settle=1.0):
+    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    sock.connect(sock_path)
+    sock.settimeout(0.2)
+    buffer = bytearray()
+
+    def pump(duration):
+        end = time.time() + duration
+        while time.time() < end:
+            try:
+                data = sock.recv(4096)
+                if data:
+                    buffer.extend(data)
+            except socket.timeout:
+                pass
+
+    pump(settle)
+    sock.sendall(b"\n")
+    pump(1.0)
+    del buffer[:]
+
+    for command in commands:
+        sock.sendall(command.encode() + b"; echo PHIAL-RC-$?\n")
+        deadline = time.time() + 60
+        import re as _re
+        while time.time() < deadline:
+            pump(0.4)
+            if _re.search(rb"PHIAL-RC-[0-9]+\n", bytes(buffer)):
+                break
+        text = bytes(buffer)
+        match = _re.search(rb"PHIAL-RC-[0-9]+", text)
+        end = match.start() if match else len(text)
+        rc = text[end:].split(b"\n")[0].decode(errors="ignore")
+        body = text[:end].decode(errors="ignore")
+        lines = [line for line in body.splitlines() if line.strip() and not line.strip().startswith(command[:30])]
+        print("$ " + command)
+        print("\n".join(lines))
+        print(rc)
+        print("---")
+        del buffer[:]
+
+
+if __name__ == "__main__":
+    run(sys.argv[1], sys.argv[2:])
