diff --git a/host/phial-host-root-setup.sh b/host/phial-host-root-setup.sh
new file mode 100755
index 0000000000000000000000000000000000000000..01954b55144ae784ea6006afeadcdef053c154ff
--- /dev/null
+++ b/host/phial-host-root-setup.sh
@@ -0,0 +1,107 @@
+#!/usr/bin/env bash
+set -euo pipefail
+export LC_ALL=C.UTF-8
+
+if [[ "$(id -u)" -ne 0 ]]; then
+    printf 'run this with: run0 bash -s < %s\n' "$0" >&2
+    exit 1
+fi
+
+caller="${SUDO_USER:-${PKEXEC_UID:+}}"
+if [[ -z "${SUDO_USER:-}" && -n "${PKEXEC_UID:-}" ]]; then
+    caller="$(getent passwd "$PKEXEC_UID" | cut -d: -f1)"
+fi
+[[ -z "$caller" ]] && caller="${PHIAL_USER:-}"
+[[ -z "$caller" ]] && { printf 'PHIAL_USER is not set\n' >&2; exit 1; }
+caller_uid="$(id -u "$caller")"
+caller_gid="$(id -g "$caller")"
+caller_home="$(getent passwd "$caller" | cut -d: -f6)"
+runtime_dir="/run/user/$caller_uid"
+config_home="$caller_home/.config"
+repo="${PHIAL_REPO:-$caller_home/Projets/phial}"
+
+PHIAL_MEMORY="${PHIAL_MEMORY:-16G}"
+PHIAL_USB_DEVICES="${PHIAL_USB_DEVICES:-}"
+
+printf 'caller: %s (uid %s)\n' "$caller" "$caller_uid"
+
+install -d -m 0755 /etc/systemd/system/user@.service.d
+printf '[Service]\nLimitMEMLOCK=infinity\n' > /etc/systemd/system/user@.service.d/99-phial-memlock.conf
+systemctl daemon-reload
+manager_pid="$(systemctl show -p MainPID --value "user@$caller_uid.service")"
+if [[ -n "$manager_pid" && "$manager_pid" != "0" ]]; then
+    prlimit --pid "$manager_pid" --memlock=unlimited
+fi
+printf 'memlock limit for the user manager: %s\n' "$(grep Memlock "/proc/$manager_pid/limits" 2>/dev/null || echo unknown)"
+
+memory_mib=$(( $(numfmt --from=iec "${PHIAL_MEMORY:-16G}") / 1024 / 1024 ))
+pages=$(( memory_mib / 2 + 256 ))
+printf 'vm.nr_hugepages=%d\n' "$pages" > /etc/sysctl.d/99-phial-hugepages.conf
+sysctl -w "vm.nr_hugepages=$pages"
+printf 'huge pages: %s\n' "$(cat /proc/sys/vm/nr_hugepages)"
+
+printf 'options kvm-intel nested=1\noptions kvm-amd nested=1\n' > /etc/modprobe.d/99-phial-nested.conf
+nested="$(cat /sys/module/kvm_intel/parameters/nested 2>/dev/null || cat /sys/module/kvm_amd/parameters/nested 2>/dev/null || echo N)"
+if [[ "$nested" != "Y" && "$nested" != "1" ]]; then
+    modprobe -r kvm_intel 2>/dev/null || modprobe -r kvm_amd 2>/dev/null || true
+    modprobe kvm_intel nested=1 2>/dev/null || modprobe kvm-amd nested=1 2>/dev/null || true
+fi
+printf 'nested virtualization: %s\n' "$(cat /sys/module/kvm_intel/parameters/nested 2>/dev/null || cat /sys/module/kvm_amd/parameters/nested 2>/dev/null)"
+
+{
+    for device in $PHIAL_USB_DEVICES; do
+        vendor=${device%%:*}
+        product=${device##*:}
+        printf 'SUBSYSTEM=="usb", ATTR{idVendor}=="%s", ATTR{idProduct}=="%s", TAG+="uaccess"\n' "$vendor" "$product"
+    done
+} > /etc/udev/rules.d/70-phial-usb.rules
+rm -f /etc/udev/rules.d/99-phial-usb.rules
+printf 'SUBSYSTEM=="vfio", KERNEL=="*", TAG+="uaccess"\n' > /etc/udev/rules.d/70-phial-vfio.rules
+udevadm control --reload
+udevadm trigger --subsystem-match=usb
+udevadm trigger --subsystem-match=vfio
+printf 'udev rules: /etc/udev/rules.d/70-phial-usb.rules and 70-phial-vfio.rules\n'
+
+dnf install -y waypipe virt-firmware keepassxc pinentry-gnome3
+
+ethernet="${1:-}"
+if [[ -z "$ethernet" ]]; then
+    ethernet="$(nmcli -t -f DEVICE,TYPE,STATE device | awk -F: '$2 == "ethernet" && $3 == "connected" {print $1; exit}')"
+fi
+if [[ -z "$ethernet" ]]; then
+    ethernet="$(nmcli -t -f DEVICE,TYPE device | awk -F: '$2 == "ethernet" {print $1; exit}')"
+fi
+if [[ -n "$ethernet" ]]; then
+    printf 'ethernet port for the bridge: %s\n' "$ethernet"
+    if ! nmcli -t -f NAME connection show | grep -qx phialbr0; then
+        nmcli connection add type bridge con-name phialbr0 ifname phialbr0 stp no ipv4.method auto ipv6.method auto
+    fi
+    old="$(nmcli -t -f NAME,DEVICE connection show --active | awk -F: -v dev="$ethernet" '$2 == dev {print $1; exit}')"
+    if [[ -n "$old" && "$old" != phialbr0-* ]]; then
+        nmcli connection delete "$old"
+    fi
+    if ! nmcli -t -f NAME connection show | grep -qx "phialbr0-$ethernet"; then
+        nmcli connection add type bridge-slave con-name "phialbr0-$ethernet" ifname "$ethernet" master phialbr0
+    fi
+    if ! nmcli -t -f NAME connection show | grep -qx phialtap0; then
+        nmcli connection add type tun con-name phialtap0 ifname phialtap0 mode tap owner "$caller_uid" group "$caller_gid" pi no vnet-hdr yes master phialbr0 slave-type bridge autoconnect yes
+    fi
+    nmcli connection up phialbr0 || true
+    nmcli connection up "phialbr0-$ethernet" || true
+    nmcli connection up phialtap0 || true
+    firewall-cmd --permanent --zone=FedoraWorkstation --add-interface=phialbr0
+    firewall-cmd --permanent --zone=FedoraWorkstation --add-interface=phialtap0
+    firewall-cmd --permanent --zone=FedoraWorkstation --add-forward
+    firewall-cmd --reload
+    wifi="$(nmcli -t -f DEVICE,TYPE device | awk -F: '$2 == "wifi" {print $1; exit}')"
+    resolvectl mdns phialbr0 yes || true
+    [[ -n "$wifi" ]] && resolvectl mdns "$wifi" yes || true
+    printf 'bridge: phialbr0 with %s and phialtap0\n' "$ethernet"
+else
+    printf 'no connected ethernet port found, skipping the bridge\n' >&2
+fi
+
+printf '\nroot setup complete. manual steps that remain:\n'
+printf '  1. open KeePassXC and unlock the database, so the Secret Service answers keepassxc:// lookups\n'
+printf '  2. plug the USB Wi-Fi adapter, then add its vendor:product to PHIAL_USB_DEVICES\n'
+printf '  3. to pass the second xHCI controller with its hub to the guest: run0 %s bind <pci-address>\n' "$repo/host/phial-vfio.sh"
diff --git a/host/phial-vfio.sh b/host/phial-vfio.sh
new file mode 100755
index 0000000000000000000000000000000000000000..ba50d068e9b5a1552453e91a3eaf1674a15d6f7d
--- /dev/null
+++ b/host/phial-vfio.sh
@@ -0,0 +1,68 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+usage() {
+    printf 'usage: run0 %s <bind|restore> <pci-address>\n' "$0" >&2
+    printf 'example: run0 %s bind 0000:00:14.0\n' "$0" >&2
+    exit 2
+}
+
+action="${1:-}"
+address="${2:-}"
+[[ -n "$action" && -n "$address" ]] || usage
+
+if [[ "$(id -u)" -ne 0 ]]; then
+    printf 'run this with: run0 %s %s %s\n' "$0" "$action" "$address" >&2
+    exit 1
+fi
+
+device_dir="/sys/bus/pci/devices/$address"
+[[ -d "$device_dir" ]] || { printf 'no PCI device %s\n' "$address" >&2; exit 1; }
+
+group="$(basename "$(readlink -f "$device_dir/iommu_group")")"
+state_dir="/run/phial-vfio/$address"
+members=(/sys/kernel/iommu_groups/"$group"/devices/*)
+
+current_driver() {
+    basename "$(readlink "$1/driver" 2>/dev/null)" 2>/dev/null || true
+}
+
+case "$action" in
+    bind)
+        modprobe vfio-pci
+        modprobe vfio_iommu_type1 2>/dev/null || true
+        mkdir -p "$state_dir"
+        for member in "${members[@]}"; do
+            name="${member##*/}"
+            driver="$(current_driver "$member")"
+            printf '%s\n' "$driver" > "$state_dir/$name.driver"
+            if [[ -n "$driver" ]]; then
+                echo "$name" > "$member/driver/unbind"
+            fi
+            echo vfio-pci > "$member/driver_override"
+            echo "$name" > /sys/bus/pci/drivers/vfio-pci/bind
+            printf 'bound %s to vfio-pci (was: %s)\n' "$name" "${driver:-none}"
+        done
+        ;;
+    restore)
+        for member in "${members[@]}"; do
+            name="${member##*/}"
+            driver="$(cat "$state_dir/$name.driver" 2>/dev/null || true)"
+            current="$(current_driver "$member")"
+            if [[ "$current" == "vfio-pci" ]]; then
+                echo "$name" > "$member/driver/unbind"
+            fi
+            echo "" > "$member/driver_override" 2>/dev/null || true
+            if [[ -n "$driver" && -d "/sys/bus/pci/drivers/$driver" ]]; then
+                echo "$name" > "/sys/bus/pci/drivers/$driver/bind"
+                printf 'restored %s to %s\n' "$name" "$driver"
+            else
+                printf 'left %s unbound (no previous driver)\n' "$name"
+            fi
+        done
+        rm -rf "$state_dir"
+        ;;
+    *)
+        usage
+        ;;
+esac
diff --git a/host/phial-vm.sh b/host/phial-vm.sh
new file mode 100755
index 0000000000000000000000000000000000000000..8c7334d40cb1691f5eb9e7f1acff3b206b76ff58
--- /dev/null
+++ b/host/phial-vm.sh
@@ -0,0 +1,276 @@
+#!/usr/bin/env bash
+PHIAL_VCPUS=${PHIAL_VCPUS:-auto}
+PHIAL_MEMORY=${PHIAL_MEMORY:-16G}
+PHIAL_DISK=${PHIAL_DISK:-auto}
+PHIAL_DISK_SIZE=${PHIAL_DISK_SIZE:-128G}
+PHIAL_DISPLAY=${PHIAL_DISPLAY:-egl-headless}
+PHIAL_GPU=${PHIAL_GPU:-venus}
+PHIAL_SECURE_BOOT=${PHIAL_SECURE_BOOT:-on}
+PHIAL_HUGEPAGES=${PHIAL_HUGEPAGES:-on}
+PHIAL_AUDIO=${PHIAL_AUDIO:-none}
+PHIAL_USB_DEVICES=(${PHIAL_USB_DEVICES:-0403:6001 1a86:55d3 345f:2131 16c0:05df 0b95:1790})
+PHIAL_USB_XHCI=${PHIAL_USB_XHCI:-}
+PHIAL_NET_LAN=${PHIAL_NET_LAN:-auto}
+PHIAL_NET_LAN_IFNAME=${PHIAL_NET_LAN_IFNAME:-phialtap0}
+PHIAL_NET_LAN_MAC=${PHIAL_NET_LAN_MAC:-52:54:00:5e:a1:01}
+PHIAL_NET_FALLBACK=${PHIAL_NET_FALLBACK:-passt}
+PHIAL_NET_FALLBACK_MAC=${PHIAL_NET_FALLBACK_MAC:-52:54:00:5e:a1:02}
+PHIAL_IOTHREAD_CPU=${PHIAL_IOTHREAD_CPU:-auto}
+PHIAL_KERNEL=${PHIAL_KERNEL:-}
+PHIAL_SHIM=${PHIAL_SHIM:-}
+PHIAL_INITRD=${PHIAL_INITRD:-}
+PHIAL_APPEND=${PHIAL_APPEND:-}
+PHIAL_ISO=${PHIAL_ISO:-}
+PHIAL_KS_IMG=${PHIAL_KS_IMG:-}
+PHIAL_SERIAL=${PHIAL_SERIAL:-socket}
+# end of configuration
+
+set -euo pipefail
+
+OVMF_DIR=/usr/share/edk2/ovmf
+RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
+DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
+RUN=$RUNTIME_DIR/phial/vm
+STATE=$DATA_HOME/phial
+[[ "$PHIAL_DISK" == "auto" ]] && PHIAL_DISK=$STATE/phial.raw
+
+if [[ "$PHIAL_VCPUS" == "auto" ]]; then
+    physical=$(lscpu -p=SOCKET,CORE | grep -v '^#' | sort -u | wc -l)
+    PHIAL_VCPUS=$((physical > 1 ? physical - 1 : 1))
+fi
+if [[ "$PHIAL_IOTHREAD_CPU" == "auto" ]]; then
+    PHIAL_IOTHREAD_CPU=$(( $(nproc) - 1 ))
+fi
+
+firmware_code=$OVMF_DIR/OVMF_CODE.secboot.fd
+firmware_vars_template=$OVMF_DIR/OVMF_VARS.secboot.fd
+firmware_vars=$RUN/OVMF_VARS.secboot.fd
+if [[ "$PHIAL_SECURE_BOOT" != "on" ]]; then
+    firmware_code=$OVMF_DIR/OVMF_CODE.fd
+    firmware_vars_template=$OVMF_DIR/OVMF_VARS.fd
+    firmware_vars=$RUN/OVMF_VARS.fd
+fi
+
+prepare() {
+    mkdir -p "$RUN" "$STATE"
+    chmod 0700 "$RUNTIME_DIR/phial" "$RUN" 2>/dev/null || true
+    if [[ ! -f "$firmware_vars" ]]; then
+        cp "$firmware_vars_template" "$firmware_vars"
+        chmod 0600 "$firmware_vars"
+    fi
+    if [[ ! -f "$PHIAL_DISK" ]]; then
+        qemu-img create -f raw -o preallocation=falloc "$PHIAL_DISK" "$PHIAL_DISK_SIZE" >/dev/null
+    fi
+    if [[ "$PHIAL_HUGEPAGES" == "on" ]]; then
+        local memory_mib pages_needed pages_have
+        memory_mib=$(( $(numfmt --from=iec "$PHIAL_MEMORY") / 1024 / 1024 ))
+        pages_needed=$(( memory_mib / 2 ))
+        pages_have=$(cat /proc/sys/vm/nr_hugepages)
+        if [[ "$pages_have" -lt "$pages_needed" ]]; then
+            printf 'phial-vm: need %d huge pages, have %d; run: run0 %s\n' \
+                "$pages_needed" "$pages_have" \
+                "$(dirname "$0")/phial-host-root-setup.sh" >&2
+            exit 1
+        fi
+    fi
+}
+
+build_args() {
+    args=(
+        -name phial
+        -machine "q35,accel=kvm,smm=on,kernel-irqchip=split,memory-backend=mem0"
+        -cpu host
+        -smp "$PHIAL_VCPUS,sockets=1,cores=$PHIAL_VCPUS,threads=1"
+        -m "$PHIAL_MEMORY"
+        -object "memory-backend-memfd,id=mem0,size=$PHIAL_MEMORY,share=on,hugetlb=$( [[ "$PHIAL_HUGEPAGES" == "on" ]] && echo on || echo off )"
+        -overcommit mem-lock=on
+        -rtc base=utc,clock=host
+        -drive "if=pflash,format=raw,readonly=on,unit=0,file=$firmware_code"
+        -drive "if=pflash,format=raw,unit=1,file=$firmware_vars"
+        -chardev "socket,id=tpm0,path=$RUN/swtpm.sock"
+        -tpmdev emulator,id=tpmdev0,chardev=tpm0
+        -device tpm-crb,tpmdev=tpmdev0
+        -object iothread,id=io0
+        -drive "if=none,id=drive0,file=$PHIAL_DISK,format=raw,cache=none,aio=native,discard=unmap"
+        -device virtio-blk-pci,drive=drive0,iothread=io0,num-queues=4
+        -device vhost-vsock-pci,guest-cid=3
+        -device virtio-serial-pci,id=virtser0
+        -chardev "socket,id=qga0,path=$RUN/qga.sock,server=on,wait=off"
+        -device virtserialport,chardev=qga0,name=org.qemu.guest_agent.0
+        -chardev "socket,id=fs0,path=$RUN/virtiofsd-hostshare.sock"
+        -device vhost-user-fs-pci,chardev=fs0,tag=hostshare
+        -chardev "socket,id=fs1,path=$RUN/virtiofsd-phial-secrets.sock"
+        -device vhost-user-fs-pci,chardev=fs1,tag=phial-secrets
+        -debugcon "file:$RUN/ovmf-debug.log"
+        -global isa-debugcon.iobase=0x402
+        -qmp "unix:$RUN/qmp.sock,server=on,wait=off"
+        -pidfile "$RUN/qemu.pid"
+        -device qemu-xhci,id=xhci0
+    )
+    if [[ "$PHIAL_SECURE_BOOT" == "on" ]]; then
+        args+=(-global driver=cfi.pflash01,property=secure,value=on)
+    fi
+    case "$PHIAL_DISPLAY" in
+        egl-headless)
+            args+=(-display egl-headless)
+            ;;
+        gtk)
+            args+=(-display gtk,gl=on,grab-on-hover=on)
+            ;;
+        none)
+            args+=(-display none)
+            ;;
+        *)
+            printf 'phial-vm: unknown PHIAL_DISPLAY %s\n' "$PHIAL_DISPLAY" >&2
+            exit 1
+            ;;
+    esac
+    case "$PHIAL_GPU" in
+        venus)
+            args+=(-device virtio-vga-gl,venus=on,blob=on,hostmem=4G,drm_native_context=on)
+            ;;
+        virgl)
+            args+=(-device virtio-vga-gl,blob=off)
+            ;;
+        none)
+            args+=(-device virtio-vga)
+            ;;
+        *)
+            printf 'phial-vm: unknown PHIAL_GPU %s\n' "$PHIAL_GPU" >&2
+            exit 1
+            ;;
+    esac
+    case "$PHIAL_AUDIO" in
+        none) ;;
+        hda)
+            args+=(-audiodev pipewire,id=snd0 -device intel-hda -device hda-duplex,audiodev=snd0)
+            ;;
+        *)
+            printf 'phial-vm: unknown PHIAL_AUDIO %s\n' "$PHIAL_AUDIO" >&2
+            exit 1
+            ;;
+    esac
+    if [[ "$PHIAL_NET_LAN" == "on" ]] || { [[ "$PHIAL_NET_LAN" == "auto" ]] && ip link show "$PHIAL_NET_LAN_IFNAME" >/dev/null 2>&1; }; then
+        args+=(
+            -netdev "tap,id=lan0,ifname=$PHIAL_NET_LAN_IFNAME,script=no,downscript=no"
+            -device "virtio-net-pci,netdev=lan0,mac=$PHIAL_NET_LAN_MAC"
+        )
+    fi
+    case "$PHIAL_NET_FALLBACK" in
+        passt)
+            args+=(-nic "passt,model=virtio-net-pci,mac=$PHIAL_NET_FALLBACK_MAC")
+            ;;
+        stream)
+            args+=(
+                -netdev "stream,id=fb0,addr.type=unix,addr.path=$RUN/passt.sock,server=off"
+                -device "virtio-net-pci,netdev=fb0,mac=$PHIAL_NET_FALLBACK_MAC"
+            )
+            ;;
+        off) ;;
+        *)
+            printf 'phial-vm: unknown PHIAL_NET_FALLBACK %s\n' "$PHIAL_NET_FALLBACK" >&2
+            exit 1
+            ;;
+    esac
+    local device vendor product
+    for device in "${PHIAL_USB_DEVICES[@]}"; do
+        vendor=${device%%:*}
+        product=${device##*:}
+        if lsusb -d "$vendor:$product" >/dev/null 2>&1; then
+            args+=(-device "usb-host,vendorid=0x$vendor,productid=0x$product")
+        else
+            printf 'phial-vm: usb device %s not present, skipping\n' "$device" >&2
+        fi
+    done
+    if [[ -n "$PHIAL_USB_XHCI" ]]; then
+        local controllers
+        controllers=$(lspci -d ::0c03 | grep -ci xhci)
+        if [[ "$controllers" -le 1 ]]; then
+            printf 'phial-vm: refusing to pass the only xHCI controller to the guest\n' >&2
+            exit 1
+        fi
+        if [[ ! -e "/sys/bus/pci/devices/$PHIAL_USB_XHCI" ]]; then
+            printf 'phial-vm: no PCI device %s\n' "$PHIAL_USB_XHCI" >&2
+            exit 1
+        fi
+        if [[ "$(readlink "/sys/bus/pci/devices/$PHIAL_USB_XHCI/driver" 2>/dev/null | xargs -r basename)" != "vfio-pci" ]]; then
+            printf 'phial-vm: %s is not bound to vfio-pci; run: run0 %s\n' \
+                "$PHIAL_USB_XHCI" "$(dirname "$0")/phial-vfio.sh bind $PHIAL_USB_XHCI" >&2
+            exit 1
+        fi
+        args+=(-device "vfio-pci,host=$PHIAL_USB_XHCI")
+    fi
+    if [[ -n "$PHIAL_KERNEL" ]]; then
+        [[ -n "$PHIAL_SHIM" ]] && args+=(-shim "$PHIAL_SHIM")
+        args+=(-kernel "$PHIAL_KERNEL")
+        [[ -n "$PHIAL_INITRD" ]] && args+=(-initrd "$PHIAL_INITRD")
+        [[ -n "$PHIAL_APPEND" ]] && args+=(-append "$PHIAL_APPEND")
+    fi
+    if [[ -n "$PHIAL_ISO" ]]; then
+        args+=(-drive "file=$PHIAL_ISO,format=raw,media=cdrom,readonly=on")
+    fi
+    if [[ -n "$PHIAL_KS_IMG" ]]; then
+        args+=(-drive "file=$PHIAL_KS_IMG,format=raw,if=none,id=ksdisk,readonly=on,cache=none,aio=native")
+        args+=(-device virtio-blk-pci,drive=ksdisk)
+    fi
+    case "$PHIAL_SERIAL" in
+        socket)
+            args+=(-serial "unix:$RUN/console.sock,server=on,wait=off")
+            ;;
+        log)
+            args+=(-serial "file:$RUN/console.log")
+            ;;
+        *)
+            printf 'phial-vm: unknown PHIAL_SERIAL %s\n' "$PHIAL_SERIAL" >&2
+            exit 1
+            ;;
+    esac
+}
+
+pin_iothread() {
+    local pid="$1" attempts=0 tid
+    while [[ "$attempts" -lt 50 ]]; do
+        for task in "/proc/$pid/task"/*; do
+            [[ "$(cat "$task/comm" 2>/dev/null)" == "io0" ]] || continue
+            tid=${task##*/}
+            taskset -pc "$PHIAL_IOTHREAD_CPU" "$tid" >/dev/null 2>&1 && return 0
+        done
+        attempts=$((attempts + 1))
+        sleep 0.1
+    done
+    printf 'phial-vm: could not pin iothread io0\n' >&2
+    return 0
+}
+
+wait_for_sockets() {
+    local socket
+    for socket in "$@"; do
+        local attempts=0
+        while ! ss -xlp 2>/dev/null | grep -qF "$socket"; do
+            attempts=$((attempts + 1))
+            if [[ "$attempts" -gt 100 ]]; then
+                printf 'phial-vm: socket %s has no live listener\n' "$socket" >&2
+                exit 1
+            fi
+            sleep 0.1
+        done
+    done
+}
+
+main() {
+    if [[ "${1:-}" == "--print-args" ]]; then
+        build_args
+        printf '%q ' "${args[@]}"
+        printf '\n'
+        return 0
+    fi
+    prepare
+    build_args
+    wait_for_sockets "$RUN/swtpm.sock" "$RUN/virtiofsd-hostshare.sock" "$RUN/virtiofsd-phial-secrets.sock"
+    qemu-system-x86_64 "${args[@]}" &
+    qemu_pid=$!
+    pin_iothread "$qemu_pid"
+    wait "$qemu_pid"
+}
+
+main "$@"
