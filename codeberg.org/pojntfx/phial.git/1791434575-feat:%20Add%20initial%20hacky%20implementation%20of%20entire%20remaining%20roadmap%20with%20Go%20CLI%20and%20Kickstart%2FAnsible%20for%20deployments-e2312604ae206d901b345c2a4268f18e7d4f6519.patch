index 0000000000000000000000000000000000000000..22e8a7136acd2cf64e65dd0632150e6cd6a5cea8
--- /dev/null
+++ b/cli/pkg/phial/agent.go
@@ -0,0 +1,71 @@
+package phial
+
+import (
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+
+	"golang.org/x/crypto/ssh"
+	"golang.org/x/crypto/ssh/agent"
+)
+
+func (c *Client) agentClient() (agent.Agent, net.Conn, error) {
+	conn, err := net.Dial("unix", c.agentSock)
+	if err != nil {
+		return nil, nil, fmt.Errorf("cannot reach the dedicated agent at %s, start phial-agent.service: %w", c.agentSock, err)
+	}
+
+	return agent.NewClient(conn), conn, nil
+}
+
+func (c *Client) grantSSHKey(name string) error {
+	keyPath := filepath.Join(c.keysDir, name)
+
+	data, err := os.ReadFile(keyPath)
+	if err != nil {
+		return fmt.Errorf("no key file %s, put the private key for this grant there", keyPath)
+	}
+
+	key, err := ssh.ParseRawPrivateKey(data)
+	if err != nil {
+		return fmt.Errorf("cannot parse %s, use an unencrypted key: %w", keyPath, err)
+	}
+
+	client, conn, err := c.agentClient()
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+
+	if err := client.Add(agent.AddedKey{
+		PrivateKey:       key,
+		Comment:          name,
+		LifetimeSecs:     3600,
+		ConfirmBeforeUse: true,
+	}); err != nil {
+		return fmt.Errorf("cannot load %s into the dedicated agent: %w", name, err)
+	}
+
+	c.setForward("ssh-agent", "start")
+
+	return nil
+}
+
+func (c *Client) removeSSHKey(name string) {
+	keyPath := filepath.Join(c.keysDir, name)
+
+	data, err := os.ReadFile(keyPath)
+	if err == nil {
+		if key, err := ssh.ParseRawPrivateKey(data); err == nil {
+			if signer, err := ssh.NewSignerFromKey(key); err == nil {
+				if client, conn, err := c.agentClient(); err == nil {
+					_ = client.Remove(signer.PublicKey())
+					conn.Close()
+				}
+			}
+		}
+	}
+
+	c.setForward("ssh-agent", "stop")
+}
diff --git a/cli/pkg/phial/allow.go b/cli/pkg/phial/allow.go
new file mode 100644
index 0000000000000000000000000000000000000000..d302c2fe2c10363df194c5e2c48f212e44f37d66
--- /dev/null
+++ b/cli/pkg/phial/allow.go
@@ -0,0 +1,72 @@
+package phial
+
+import (
+	"errors"
+	"flag"
+	"fmt"
+	"time"
+)
+
+func (c *Client) Allow(args []string) error {
+	flags := flag.NewFlagSet("allow", flag.ContinueOnError)
+
+	duration := flags.String("for", "", "grant duration, a systemd timespan such as 30min or 1h")
+	kind := flags.String("kind", "api-key", "grant subject type: api-key, ssh-key, or gpg-key")
+
+	if err := flags.Parse(args); err != nil {
+		return err
+	}
+
+	if flags.NArg() != 1 || *duration == "" {
+		return errors.New("usage: phial allow --for <duration> [--kind api-key|ssh-key|gpg-key] <name>")
+	}
+
+	name := flags.Arg(0)
+
+	seconds, err := parseDuration(*duration)
+	if err != nil {
+		return err
+	}
+
+	if err := c.ensureDirs(); err != nil {
+		return err
+	}
+
+	switch *kind {
+	case "api-key":
+		r, err := c.findRow(name)
+		if err != nil {
+			return err
+		}
+
+		if err := c.materializeRow(r); err != nil {
+			return err
+		}
+
+		if err := writeSecret(c.caddyfile, c.caddyfileText()); err != nil {
+			return err
+		}
+
+		c.applyCaddy()
+	case "ssh-key":
+		if err := c.grantSSHKey(name); err != nil {
+			return err
+		}
+	case "gpg-key":
+		c.setForward("gpg-extra", "start")
+	default:
+		return fmt.Errorf("unknown kind %q", *kind)
+	}
+
+	expires := c.writeGrant(name, *kind, seconds)
+
+	if err := c.scheduleExpiry(name, seconds); err != nil {
+		return err
+	}
+
+	notify("phial grant", fmt.Sprintf("%s (%s) granted until %s", name, *kind, expires.Format("15:04")))
+
+	fmt.Printf("granted %s (%s) until %s\n", name, *kind, expires.Format(time.RFC3339))
+
+	return nil
+}
diff --git a/cli/pkg/phial/guest.go b/cli/pkg/phial/guest.go
new file mode 100644
index 0000000000000000000000000000000000000000..2be3b4aaae904f283696ceb2ba613325446552f3
--- /dev/null
+++ b/cli/pkg/phial/guest.go
@@ -0,0 +1,128 @@
+package phial
+
+import (
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/adrg/xdg"
+	"github.com/mdlayher/vsock"
+	"golang.org/x/crypto/ssh"
+	"golang.org/x/crypto/ssh/agent"
+	"golang.org/x/crypto/ssh/knownhosts"
+)
+
+func guestAuth() ([]ssh.AuthMethod, error) {
+	var methods []ssh.AuthMethod
+
+	if sock := os.Getenv("SSH_AUTH_SOCK"); sock != "" {
+		if conn, err := net.Dial("unix", sock); err == nil {
+			methods = append(methods, ssh.PublicKeysCallback(agent.NewClient(conn).Signers))
+		}
+	}
+
+	if signer, err := guestSigner(); err == nil {
+		methods = append(methods, ssh.PublicKeys(signer))
+	}
+
+	if len(methods) == 0 {
+		return nil, errors.New("no usable key: load one into ssh-agent or put one in ~/.ssh")
+	}
+
+	return methods, nil
+}
+
+func guestSigner() (ssh.Signer, error) {
+	for _, name := range []string{"id_ed25519", "id_rsa"} {
+		data, err := os.ReadFile(filepath.Join(xdg.Home, ".ssh", name))
+		if err != nil {
+			continue
+		}
+
+		signer, err := ssh.ParsePrivateKey(data)
+		if err == nil {
+			return signer, nil
+		}
+	}
+
+	return nil, errors.New("no usable key in ~/.ssh")
+}
+
+func guestHostKeyCallback() ssh.HostKeyCallback {
+	knownHostsFile := filepath.Join(xdg.Home, ".ssh", "known_hosts")
+
+	callback, err := knownhosts.New(knownHostsFile)
+	if err != nil {
+		callback = nil
+	}
+
+	return func(hostname string, remote net.Addr, key ssh.PublicKey) error {
+		if callback != nil {
+			err := callback(hostname, remote, key)
+			if err == nil {
+				return nil
+			}
+
+			var keyError *knownhosts.KeyError
+			if !errors.As(err, &keyError) || len(keyError.Want) > 0 {
+				return err
+			}
+		}
+
+		file, err := os.OpenFile(knownHostsFile, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o600)
+		if err != nil {
+			return err
+		}
+		defer file.Close()
+
+		_, err = fmt.Fprintln(file, knownhosts.Line([]string{"phial"}, key))
+
+		return err
+	}
+}
+
+func (c *Client) guestCommand(command string) error {
+	auth, err := guestAuth()
+	if err != nil {
+		return err
+	}
+
+	conn, err := vsock.Dial(3, 2222, nil)
+	if err != nil {
+		return err
+	}
+
+	config := &ssh.ClientConfig{
+		User:            "phial",
+		Auth:            auth,
+		HostKeyCallback: guestHostKeyCallback(),
+		Timeout:         5 * time.Second,
+	}
+
+	sshConn, chans, reqs, err := ssh.NewClientConn(conn, "phial:22", config)
+	if err != nil {
+		conn.Close()
+
+		return err
+	}
+
+	client := ssh.NewClient(sshConn, chans, reqs)
+	defer client.Close()
+
+	session, err := client.NewSession()
+	if err != nil {
+		return err
+	}
+	defer session.Close()
+
+	return session.Run(command)
+}
+
+func (c *Client) sshGuest(command string) {
+	if err := c.guestCommand(command); err != nil {
+		c.log.Info("guest command failed", "command", command, "err", err)
+	}
+}
