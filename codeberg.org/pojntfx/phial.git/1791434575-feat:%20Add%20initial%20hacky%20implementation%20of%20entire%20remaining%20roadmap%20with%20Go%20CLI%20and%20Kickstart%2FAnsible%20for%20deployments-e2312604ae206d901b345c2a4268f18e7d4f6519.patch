diff --git a/guest/playbooks/desktop.yaml b/guest/playbooks/desktop.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..47fd0c50733b79f0e5a2f9bd9e88e86ed909d32d
--- /dev/null
+++ b/guest/playbooks/desktop.yaml
@@ -0,0 +1,109 @@
+- name: desktop, display, and audio
+  hosts: phial
+  tasks:
+    - name: install the desktop tools
+      ansible.builtin.command: dnf install -y gnome-remote-desktop waypipe mesa-demos openssl
+      changed_when: false
+      become: true
+
+    - name: turn on autologin for the guest user
+      ansible.builtin.ini_file:
+        path: /etc/gdm/custom.conf
+        section: daemon
+        option: "{{ item.option }}"
+        value: "{{ item.value }}"
+      loop:
+        - {option: AutomaticLoginEnable, value: "true"}
+        - {option: AutomaticLogin, value: "{{ phial_guest_user }}"}
+      become: true
+
+    - name: create the RDP configuration directory
+      ansible.builtin.file:
+        path: /etc/gnome-remote-desktop
+        state: directory
+        mode: "0700"
+      become: true
+
+    - name: generate the RDP TLS certificate
+      ansible.builtin.command:
+        cmd: openssl req -x509 -newkey rsa:2048 -keyout /etc/gnome-remote-desktop/rdp-tls.key -out /etc/gnome-remote-desktop/rdp-tls.crt -days 3650 -nodes -subj /CN=phial
+        creates: /etc/gnome-remote-desktop/rdp-tls.key
+      become: true
+
+    - name: let the remote desktop daemon read the TLS pair
+      ansible.builtin.file:
+        path: "/etc/gnome-remote-desktop/{{ item }}"
+        owner: gnome-remote-desktop
+        group: gnome-remote-desktop
+        mode: "0600"
+      loop:
+        - rdp-tls.key
+        - rdp-tls.crt
+      become: true
+
+    - name: locate the RDP password file on the host
+      ansible.builtin.set_fact:
+        phial_rdp_password_file: "{{ lookup('ansible.builtin.env', 'HOME') }}/.config/phial/rdp-password"
+      run_once: true
+      become: false
+
+    - name: generate the RDP password on the host
+      ansible.builtin.set_fact:
+        phial_rdp_password: "{{ lookup('ansible.builtin.password', phial_rdp_password_file + ' length=32 chars=ascii_letters,digits') }}"
+      run_once: true
+      become: false
+
+    - name: protect the RDP password on the host
+      ansible.builtin.file:
+        path: "{{ phial_rdp_password_file }}"
+        mode: "0600"
+      delegate_to: localhost
+      run_once: true
+      become: false
+
+    - name: point RDP at the TLS certificate
+      ansible.builtin.command: grdctl --system rdp set-tls-cert /etc/gnome-remote-desktop/rdp-tls.crt
+      changed_when: false
+      become: true
+
+    - name: point RDP at the TLS key
+      ansible.builtin.command: grdctl --system rdp set-tls-key /etc/gnome-remote-desktop/rdp-tls.key
+      changed_when: false
+      become: true
+
+    - name: set the RDP credentials
+      ansible.builtin.command: grdctl --system rdp set-credentials {{ phial_guest_user }} {{ phial_rdp_password }}
+      changed_when: false
+      become: true
+      no_log: true
+
+    - name: allow remote control over RDP
+      ansible.builtin.command: grdctl --system rdp disable-view-only
+      changed_when: false
+      become: true
+
+    - name: disable the user session RDP backend
+      ansible.builtin.command: grdctl rdp disable
+      changed_when: false
+      become: false
+      ignore_errors: true
+
+    - name: enable RDP on the system daemon
+      ansible.builtin.command: grdctl --system rdp enable
+      changed_when: false
+      become: true
+
+    - name: run the remote desktop system daemon
+      ansible.builtin.systemd_service:
+        name: gnome-remote-desktop
+        enabled: true
+        state: started
+      become: true
+
+    - name: expose the RDP port to the host over vsock
+      ansible.builtin.systemd_service:
+        name: phial-guest-port@{{ phial_rdp_port }}
+        enabled: true
+        state: started
+        scope: user
+      become: false
diff --git a/guest/playbooks/network.yaml b/guest/playbooks/network.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..de375d906b23a8a62f991da74b8606471efe0325
--- /dev/null
+++ b/guest/playbooks/network.yaml
@@ -0,0 +1,16 @@
+- name: guest networking
+  hosts: phial
+  become: true
+  tasks:
+    - name: give the passt fallback route the highest metric
+      ansible.builtin.shell: |
+        set -e
+        for dev in $(nmcli -t -f DEVICE,TYPE device | awk -F: '$2 == "ethernet" {print $1}'); do
+            hw=$(nmcli -g GENERAL.HWADDR device show "$dev" | sed 's/\\//g')
+            if [ "$(echo "$hw" | tr 'A-F' 'a-f')" = "{{ phial_fallback_mac }}" ]; then
+                con=$(nmcli -g GENERAL.CONNECTION device show "$dev" | sed 's/\\//g')
+                nmcli connection modify "$con" ipv4.route-metric 1000 ipv6.route-metric 1000
+                nmcli connection up "$con" || true
+            fi
+        done
+      changed_when: false
