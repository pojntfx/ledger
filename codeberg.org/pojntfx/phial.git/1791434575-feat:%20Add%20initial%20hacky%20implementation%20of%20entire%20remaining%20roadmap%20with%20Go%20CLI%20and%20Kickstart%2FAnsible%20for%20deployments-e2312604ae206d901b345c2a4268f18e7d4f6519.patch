new file mode 100644
index 0000000000000000000000000000000000000000..63b7287d7559fefaaab71a51312ea92a7f35e044
--- /dev/null
+++ b/tests/qga.py
@@ -0,0 +1,80 @@
+import base64
+import json
+import socket
+import sys
+import time
+
+
+class GuestAgent:
+    def __init__(self, path):
+        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        self.sock.connect(path)
+        self.file = self.sock.makefile("rw")
+        self.sync()
+
+    def command(self, execute, arguments=None):
+        message = {"execute": execute}
+        if arguments is not None:
+            message["arguments"] = arguments
+        self.file.write(json.dumps(message))
+        self.file.write("\n")
+        self.file.flush()
+        while True:
+            line = self.file.readline()
+            if not line:
+                raise RuntimeError("agent closed the channel")
+            reply = json.loads(line)
+            if "return" in reply or "error" in reply:
+                if "error" in reply:
+                    raise RuntimeError(f"{execute}: {reply['error']}")
+                return reply["return"]
+
+    def sync(self):
+        marker = int(time.time() * 1000)
+        self.file.write(json.dumps({"execute": "guest-sync", "arguments": {"id": marker}}))
+        self.file.write("\n")
+        self.file.flush()
+        while True:
+            line = self.file.readline()
+            if not line:
+                raise RuntimeError("agent closed the channel")
+            reply = json.loads(line)
+            if reply.get("return") == marker:
+                return
+
+    def write_file(self, path, data):
+        handle = self.command("guest-file-open", {"path": path, "mode": "w+"})
+        self.command("guest-file-write", {"handle": handle, "buf-b64": base64.b64encode(data).decode()})
+        self.command("guest-file-close", {"handle": handle})
+
+    def exec(self, argv):
+        result = self.command("guest-exec", {"path": argv[0], "arg": argv[1:], "capture-output": True})
+        pid = result["pid"]
+        while True:
+            status = self.command("guest-exec-status", {"pid": pid})
+            if status.get("exited"):
+                if status.get("exitcode", 1) != 0:
+                    raise RuntimeError(f"{argv}: exit {status.get('exitcode')}: {status.get('err-data', '')}")
+                return status
+            time.sleep(0.5)
+
+    def ping(self):
+        self.command("guest-ping")
+
+
+if __name__ == "__main__":
+    socket_path, authorized_key = sys.argv[1], sys.argv[2]
+    agent = GuestAgent(socket_path)
+    agent.ping()
+    agent.exec(["/usr/bin/mkdir", "-p", "/home/phial/.ssh"])
+    agent.exec(["/usr/bin/sh", "-c", "touch /home/phial/.ssh/authorized_keys"])
+    handle = agent.command("guest-file-open", {"path": "/home/phial/.ssh/authorized_keys", "mode": "r"})
+    content = agent.command("guest-file-read", {"handle": handle})
+    agent.command("guest-file-close", {"handle": handle})
+    existing = base64.b64decode(content.get("buf-b64", "")).decode()
+    if authorized_key.strip() not in existing:
+        agent.exec(["/usr/bin/sh", "-c", f"printf '%s\n' {json.dumps(authorized_key.strip())} >> /home/phial/.ssh/authorized_keys"])
+    agent.exec(["/usr/bin/chmod", "700", "/home/phial/.ssh"])
+    agent.exec(["/usr/bin/chmod", "600", "/home/phial/.ssh/authorized_keys"])
+    agent.exec(["/usr/bin/chown", "-R", "phial:phial", "/home/phial/.ssh"])
+    print("validation key installed in the guest")
