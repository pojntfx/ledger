+scratch="$(mktemp -d)"
+cleanup() {
+    [[ -n "${caddy_pid:-}" ]] && kill "$caddy_pid" 2>/dev/null || true
+    [[ -n "${upstream_pid:-}" ]] && kill "$upstream_pid" 2>/dev/null || true
+    [[ -n "${agent_pid:-}" ]] && kill "$agent_pid" 2>/dev/null || true
+    rm -rf "$scratch"
+}
+trap cleanup EXIT
+pkill -f "caddy run --confi[g]" 2>/dev/null || true
+pkill -f "echo-upstrea[m]" 2>/dev/null || true
+sleep 0.3
+export PHIAL_CONFIG_DIR="$scratch/config/phial"
+export PHIAL_RUNTIME_DIR="$scratch/runtime/phial"
+mkdir -p "$PHIAL_CONFIG_DIR" "$PHIAL_RUNTIME_DIR"
+
+checks=0
+fails=0
+ok() {
+    checks=$((checks + 1))
+    if eval "$2"; then
+        printf 'PASS %s\n' "$1"
+    else
+        printf 'FAIL %s\n' "$1"
+        fails=$((fails + 1))
+    fi
+}
+
+cat > "$PHIAL_CONFIG_DIR/mapping" <<'EOF'
+testenv env keepassxc://phial-test-env -
+testproxy proxy keepassxc://phial-test-proxy http://[::1]:18099
+EOF
+
+printf 'env-secret-value' | secret-tool store --label="phial test env" phial phial-test-env
+printf 'proxy-secret-value' | secret-tool store --label="phial test proxy" phial phial-test-proxy
+
+listing="$(phial ls)"
+ok "ls lists the names" 'grep -q testenv <<<"$listing" && grep -q testproxy <<<"$listing"'
+ok "ls never prints the values" '! grep -q secret-value <<<"$listing"'
+
+phial sync >/dev/null
+ok "sync writes the env secret file" 'grep -qx env-secret-value "$PHIAL_RUNTIME_DIR/secrets/testenv"'
+ok "sync writes a placeholder for the proxy row" 'grep -qx phial-proxy-placeholder "$PHIAL_RUNTIME_DIR/secrets/testproxy"'
+ok "sync writes the proxy drop-in" '[[ -f "$PHIAL_RUNTIME_DIR/caddy/testproxy.caddy" ]]'
+ok "sync writes the Caddyfile" '[[ -f "$PHIAL_CONFIG_DIR/Caddyfile" ]]'
+ok "the Caddyfile is valid" 'caddy validate --config "$PHIAL_CONFIG_DIR/Caddyfile" --adapter caddyfile >/dev/null 2>&1'
+ok "secret files have mode 0600" '[[ "$(stat -c %a "$PHIAL_RUNTIME_DIR/secrets/testenv")" == 600 ]]'
+
+printed="$(PHIAL_SECRETS_DIR="$PHIAL_RUNTIME_DIR/secrets" phial run sh -c 'echo $testenv')"
+ok "the runner loads the secret as a variable" '[[ "$printed" == "env-secret-value" ]]'
+
+phial allow --for 30min testenv >/dev/null
+ok "allow writes the grant file" '[[ -f "$PHIAL_RUNTIME_DIR/grants/testenv.grant" ]]'
+ok "status shows the grant" 'phial status | grep -q "testenv.*granted"'
+phial revoke testenv >/dev/null
+ok "revoke removes the secret file" '[[ ! -f "$PHIAL_RUNTIME_DIR/secrets/testenv" ]]'
+ok "revoke removes the grant file" '[[ ! -f "$PHIAL_RUNTIME_DIR/grants/testenv.grant" ]]'
+ok "status shows the grant is closed" 'phial status | grep -q "testenv.*not granted"'
+
+phial allow --for 6s testenv >/dev/null
+[[ -f "$PHIAL_RUNTIME_DIR/secrets/testenv" ]] || { echo 'FAIL grant wrote the secret file'; fails=$((fails + 1)); }
+sleep 8
+ok "the secret file disappears on time" '[[ ! -f "$PHIAL_RUNTIME_DIR/secrets/testenv" ]]'
+ok "the grant file disappears on time" '[[ ! -f "$PHIAL_RUNTIME_DIR/grants/testenv.grant" ]]'
+
+python3 "$repo/tests/echo-upstream.py" python3 "$repo/tests/echo-upstream.py" &>/dev/null &>/dev/null python3 "$repo/tests/echo-upstream.py" &>/dev/null &
+upstream_pid=$!
+sleep 0.5
+caddy run --config "$PHIAL_CONFIG_DIR/Caddyfile" --adapter caddyfile >/dev/null 2>caddy run --config "$PHIAL_CONFIG_DIR/Caddyfile" --adapter caddyfile >/dev/null 2>&1 &1 caddy run --config "$PHIAL_CONFIG_DIR/Caddyfile" --adapter caddyfile >/dev/null 2>&1 &
+caddy_pid=$!
