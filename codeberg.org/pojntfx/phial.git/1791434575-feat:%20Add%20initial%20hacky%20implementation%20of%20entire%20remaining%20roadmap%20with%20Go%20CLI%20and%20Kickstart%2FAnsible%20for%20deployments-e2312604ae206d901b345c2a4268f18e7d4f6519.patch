--- /dev/null
+++ b/cli/pkg/phial/revoke.go
@@ -0,0 +1,43 @@
+package phial
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+)
+
+func (c *Client) Revoke(args []string) error {
+	if len(args) != 1 {
+		return errors.New("usage: phial revoke <name>")
+	}
+
+	name := args[0]
+
+	if err := c.ensureDirs(); err != nil {
+		return err
+	}
+
+	kind := "api-key"
+	if grant := c.readGrant(name); grant != nil && grant["kind"] != "" {
+		kind = grant["kind"]
+	}
+
+	_ = os.Remove(filepath.Join(c.secretsDir, name))
+	_ = os.Remove(c.grantPath(name))
+
+	switch kind {
+	case "ssh-key":
+		c.removeSSHKey(name)
+	case "gpg-key":
+		c.setForward("gpg-extra", "stop")
+	}
+
+	notify("phial revoke", fmt.Sprintf("%s (%s) revoked", name, kind))
+
+	fmt.Printf("revoked %s\n", name)
+
+	c.cancelExpiry(name)
+
+	return nil
+}
diff --git a/cli/pkg/phial/run.go b/cli/pkg/phial/run.go
new file mode 100644
index 0000000000000000000000000000000000000000..21b7df1e26e7f5ca14431400114fb676a8151f87
--- /dev/null
+++ b/cli/pkg/phial/run.go
@@ -0,0 +1,54 @@
+package phial
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"syscall"
+)
+
+func (c *Client) Run(args []string) error {
+	if len(args) == 0 {
+		return errors.New("usage: phial run <command> [argument...]")
+	}
+
+	dir := os.Getenv("PHIAL_SECRETS_DIR")
+	if dir == "" {
+		dir = "/mnt/phial-secrets"
+	}
+
+	environment := os.Environ()
+
+	entries, err := os.ReadDir(dir)
+	if err == nil {
+		for _, entry := range entries {
+			info, err := entry.Info()
+			if err != nil || !info.Mode().IsRegular() {
+				continue
+			}
+
+			if !namePattern.MatchString(entry.Name()) {
+				fmt.Fprintf(os.Stderr, "phial run: skipping %s, not a valid variable name\n", entry.Name())
+
+				continue
+			}
+
+			data, err := os.ReadFile(filepath.Join(dir, entry.Name()))
+			if err != nil {
+				continue
+			}
+
+			environment = append(environment, entry.Name()+"="+strings.TrimRight(string(data), "\n"))
+		}
+	}
+
+	binary, err := exec.LookPath(args[0])
+	if err != nil {
+		return err
+	}
+
+	return syscall.Exec(binary, args, environment)
+}
diff --git a/cli/pkg/phial/secrets.go b/cli/pkg/phial/secrets.go
new file mode 100644
index 0000000000000000000000000000000000000000..3e009b0c8da1b594999e31bcab770ef65cc99529
--- /dev/null
+++ b/cli/pkg/phial/secrets.go
@@ -0,0 +1,68 @@
+package phial
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/godbus/dbus/v5"
+)
+
+type secretItem struct {
+	Session     dbus.ObjectPath
+	Parameters  []byte
+	Value       []byte
+	ContentType string
+}
+
+func resolve(source string) (string, error) {
+	key, ok := strings.CutPrefix(source, "keepassxc://")
+	if !ok {
+		return "", fmt.Errorf("unsupported source %q, the only scheme is keepassxc://", source)
+	}
+
+	bus, err := dbus.ConnectSessionBus()
+	if err != nil {
+		return "", fmt.Errorf("no session bus: %w", err)
+	}
+	defer bus.Close()
+
+	service := bus.Object("org.freedesktop.secrets", dbus.ObjectPath("/org/freedesktop/secrets"))
+
+	var output dbus.Variant
+	var session dbus.ObjectPath
+	if err := service.Call("org.freedesktop.Secret.Service.OpenSession", 0, "plain",
+		dbus.MakeVariant("")).Store(&output, &session); err != nil {
+		return "", fmt.Errorf("cannot open a Secret Service session: %w", err)
+	}
+
+	var unlocked, locked []dbus.ObjectPath
+	if err := service.Call("org.freedesktop.Secret.Service.SearchItems", 0,
+		map[string]string{"phial": key}).Store(&unlocked, &locked); err != nil {
+		return "", fmt.Errorf("lookup of %s failed: %w", source, err)
+	}
+
+	if len(unlocked) == 0 {
+		if len(locked) > 0 {
+			return "", fmt.Errorf("the entry for %s is locked, open and unlock the KeePassXC window", source)
+		}
+
+		return "", fmt.Errorf("no entry for %s, store it with the attribute phial set to %q", source, key)
+	}
+
+	secrets := map[dbus.ObjectPath]secretItem{}
+	if err := service.Call("org.freedesktop.Secret.Service.GetSecrets", 0,
+		unlocked, session).Store(&secrets); err != nil {
+		return "", fmt.Errorf("cannot read %s: %w", source, err)
+	}
+
+	for _, item := range secrets {
+		value := strings.TrimRight(string(item.Value), "\n")
+		if value == "" {
+			return "", fmt.Errorf("empty value for %s", source)
+		}
+
+		return value, nil
+	}
+
+	return "", fmt.Errorf("no value for %s", source)
+}
diff --git a/cli/pkg/phial/status.go b/cli/pkg/phial/status.go
new file mode 100644
index 0000000000000000000000000000000000000000..da1d35d1faae60bf95a1d37eeedb3a844b1b66ea
--- /dev/null
+++ b/cli/pkg/phial/status.go
@@ -0,0 +1,68 @@
+package phial
+
+import (
+	"fmt"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"strings"
+	"time"
+)
+
+func (c *Client) Status() error {
+	if err := c.ensureDirs(); err != nil {
+		return err
+	}
+
+	rows := map[string]row{}
+	rowsList, err := c.readMapping()
+	if err != nil {
+		return err
+	}
+	for _, r := range rowsList {
+		rows[r.name] = r
+	}
+
+	names := map[string]bool{}
+	for name := range rows {
+		names[name] = true
+	}
+
+	grants, _ := filepath.Glob(filepath.Join(c.grantsDir, "*.grant"))
+	for _, grant := range grants {
+		names[strings.TrimSuffix(filepath.Base(grant), ".grant")] = true
+	}
+
+	if len(names) == 0 {
+		fmt.Println("no secrets and no grants")
+
+		return nil
+	}
+
+	sorted := []string{}
+	for name := range names {
+		sorted = append(sorted, name)
+	}
+	slices.Sort(sorted)
+
+	for _, name := range sorted {
+		mode := "-"
+		if r, ok := rows[name]; ok {
+			mode = r.mode
+		}
+
+		grant := c.readGrant(name)
+		if grant != nil {
+			unix, _ := strconv.ParseInt(grant["expires_unix"], 10, 64)
+			if remaining := unix - time.Now().Unix(); remaining > 0 {
+				fmt.Printf("%s\t%s\t%s\tgranted\t%ds left\n", name, grant["kind"], mode, remaining)
+
+				continue
+			}
+		}
+
+		fmt.Printf("%s\t-\t%s\tnot granted\n", name, mode)
+	}
+
+	return nil
+}
diff --git a/cli/pkg/phial/sync.go b/cli/pkg/phial/sync.go
new file mode 100644
index 0000000000000000000000000000000000000000..890254909cdc8e7f702ba77a694c6a392cd1f663
--- /dev/null
+++ b/cli/pkg/phial/sync.go
@@ -0,0 +1,45 @@
+package phial
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+func (c *Client) Sync() error {
+	if err := c.ensureDirs(); err != nil {
+		return err
+	}
+
+	rows, err := c.readMapping()
+	if err != nil {
+		return err
+	}
+
+	seen := map[string]bool{}
+	for _, r := range rows {
+		if err := c.materializeRow(r); err != nil {
+			return err
+		}
+
+		seen[r.name] = true
+	}
+
+	dropins, _ := filepath.Glob(filepath.Join(c.dropinsDir, "*.caddy"))
+	for _, dropin := range dropins {
+		if !seen[strings.TrimSuffix(filepath.Base(dropin), ".caddy")] {
+			_ = os.Remove(dropin)
+		}
+	}
+
+	if err := writeSecret(c.caddyfile, c.caddyfileText()); err != nil {
+		return err
+	}
+
+	c.applyCaddy()
+
+	fmt.Printf("synced %d row(s)\n", len(rows))
+
+	return nil
+}
diff --git a/cli/pkg/phial/systemd.go b/cli/pkg/phial/systemd.go
new file mode 100644
index 0000000000000000000000000000000000000000..d8f360b07ecd2c2fcd1046e3021558ae6bc7299c
--- /dev/null
+++ b/cli/pkg/phial/systemd.go
@@ -0,0 +1,133 @@
+package phial
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	systemdDbus "github.com/coreos/go-systemd/v22/dbus"
+	"github.com/godbus/dbus/v5"
+)
+
+func (c *Client) userManager() (*systemdDbus.Conn, error) {
+	return systemdDbus.NewUserConnectionContext(context.Background())
+}
+
+type timerEntry struct {
+	Name  string
+	Value uint64
+}
+
+func (c *Client) scheduleExpiry(name string, seconds int) error {
+	conn, err := c.userManager()
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+
+	binary, err := exec.LookPath("phial")
+	if err != nil {
+		binary, _ = filepath.Abs(os.Args[0])
+	}
+
+	timer := []systemdDbus.Property{
+		systemdDbus.PropDescription("phial grant expiry for " + name),
+		{Name: "TimersMonotonic", Value: dbus.MakeVariant([]timerEntry{{Name: "OnActiveSec", Value: uint64(seconds) * 1000000}})},
+		{Name: "AccuracyUSec", Value: dbus.MakeVariant(uint64(1000000))},
+		{Name: "CollectMode", Value: dbus.MakeVariant("inactive-or-failed")},
+	}
+
+	service := []systemdDbus.Property{
+		systemdDbus.PropDescription("phial grant expiry for " + name),
+		systemdDbus.PropType("oneshot"),
+		systemdDbus.PropExecStart([]string{binary, "revoke", name}, false),
+		{Name: "Environment", Value: dbus.MakeVariant([]string{
+			"PHIAL_CONFIG_DIR=" + filepath.Dir(c.mappingFile),
+			"PHIAL_RUNTIME_DIR=" + filepath.Dir(c.secretsDir),
+			"PATH=" + os.Getenv("PATH"),
+		})},
+		{Name: "CollectMode", Value: dbus.MakeVariant("inactive-or-failed")},
+	}
+
+	aux := []systemdDbus.PropertyCollection{
+		{Name: "phial-expire-" + name + ".service", Properties: service},
+	}
+
+	_, err = conn.StartTransientUnitAux(context.Background(), "phial-expire-"+name+".timer", "replace", timer, aux, nil)
+
+	return err
+}
+
+func (c *Client) cancelExpiry(name string) {
+	conn, err := c.userManager()
+	if err != nil {
+		return
+	}
+	defer conn.Close()
+
+	_, _ = conn.StopUnitContext(context.Background(), "phial-expire-"+name+".timer", "replace", nil)
+	_, _ = conn.StopUnitContext(context.Background(), "phial-expire-"+name+".service", "replace", nil)
+}
+
+func caddyVersion() (int, int, bool) {
+	out, err := exec.Command("caddy", "version").Output()
+	if err != nil {
+		return 0, 0, false
+	}
+
+	parts := strings.Split(strings.TrimPrefix(strings.TrimSpace(string(out)), "v"), ".")
+	if len(parts) < 2 {
+		return 0, 0, false
+	}
+
+	major, err1 := strconv.Atoi(parts[0])
+	minor, err2 := strconv.Atoi(parts[1])
+
+	return major, minor, err1 == nil && err2 == nil
+}
+
+func (c *Client) applyCaddy() {
+	conn, err := c.userManager()
+	if err != nil {
+		return
+	}
+	defer conn.Close()
+
+	property, err := conn.GetUnitPropertyContext(context.Background(), "phial-caddy.service", "ActiveState")
+	if err != nil {
+		return
+	}
+
+	state, ok := property.Value.Value().(string)
+	if !ok || state != "active" {
+		return
+	}
+
+	major, minor, ok := caddyVersion()
+	if ok && (major < 2 || (major == 2 && minor < 11)) {
+		_, _ = conn.RestartUnitContext(context.Background(), "phial-caddy.service", "replace", nil)
+	} else {
+		_, _ = conn.ReloadUnitContext(context.Background(), "phial-caddy.service", "replace", nil)
+	}
+}
+
+func (c *Client) setForward(name, state string) {
+	conn, err := c.userManager()
+	if err == nil {
+		unit := "phial-forward@" + name + ".service"
+
+		if state == "start" {
+			_, _ = conn.StartUnitContext(context.Background(), unit, "replace", nil)
+		} else {
+			_, _ = conn.StopUnitContext(context.Background(), unit, "replace", nil)
+		}
+
+		conn.Close()
+	}
+
+	c.sshGuest(fmt.Sprintf("systemctl --user %s phial-forward@%s.service", state, name))
+}
