diff --git a/cli/pkg/phial/phial.go b/cli/pkg/phial/phial.go
new file mode 100644
index 0000000000000000000000000000000000000000..5bc5392c06b2349a897763b8343d8cc3c9f322f0
--- /dev/null
+++ b/cli/pkg/phial/phial.go
@@ -0,0 +1,258 @@
+package phial
+
+import (
+	"fmt"
+	"log/slog"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/adrg/xdg"
+	"github.com/google/renameio/v2"
+)
+
+const Placeholder = "phial-proxy-placeholder"
+
+var namePattern = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)
+
+type Client struct {
+	log *slog.Logger
+
+	mappingFile string
+	keysDir     string
+	caddyfile   string
+	secretsDir  string
+	grantsDir   string
+	dropinsDir  string
+	agentSock   string
+}
+
+func NewClient(log *slog.Logger) *Client {
+	configDir := filepath.Join(xdg.ConfigHome, "phial")
+	if override := os.Getenv("PHIAL_CONFIG_DIR"); override != "" {
+		configDir = override
+	}
+
+	runtimeBase := xdg.RuntimeDir
+	if runtimeBase == "" {
+		runtimeBase = fmt.Sprintf("/run/user/%d", os.Getuid())
+	}
+	runtimeDir := filepath.Join(runtimeBase, "phial")
+	if override := os.Getenv("PHIAL_RUNTIME_DIR"); override != "" {
+		runtimeDir = override
+	}
+
+	return &Client{
+		log:         log,
+		mappingFile: filepath.Join(configDir, "mapping"),
+		keysDir:     filepath.Join(configDir, "keys"),
+		caddyfile:   filepath.Join(configDir, "Caddyfile"),
+		secretsDir:  filepath.Join(runtimeDir, "secrets"),
+		grantsDir:   filepath.Join(runtimeDir, "grants"),
+		dropinsDir:  filepath.Join(runtimeDir, "caddy"),
+		agentSock:   filepath.Join(runtimeDir, "agent", "ssh.sock"),
+	}
+}
+
+func (c *Client) ensureDirs() error {
+	for _, dir := range []string{c.keysDir, c.secretsDir, c.grantsDir, c.dropinsDir, filepath.Dir(c.agentSock)} {
+		if err := os.MkdirAll(dir, 0o700); err != nil {
+			return err
+		}
+
+		if err := os.Chmod(dir, 0o700); err != nil {
+			return err
+		}
+	}
+
+	return nil
+}
+
+type row struct {
+	name     string
+	mode     string
+	source   string
+	upstream string
+}
+
+func (c *Client) readMapping() ([]row, error) {
+	data, err := os.ReadFile(c.mappingFile)
+	if os.IsNotExist(err) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+
+	var rows []row
+	for index, line := range strings.Split(string(data), "\n") {
+		line = strings.TrimSpace(line)
+
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+
+		parts := strings.Fields(line)
+		if len(parts) != 4 {
+			return nil, fmt.Errorf("%s:%d: expected 4 columns: name mode source upstream", c.mappingFile, index+1)
+		}
+
+		if parts[1] != "env" && parts[1] != "proxy" {
+			return nil, fmt.Errorf("%s:%d: unknown mode %q, use env or proxy", c.mappingFile, index+1, parts[1])
+		}
+
+		if !namePattern.MatchString(parts[0]) {
+			return nil, fmt.Errorf("%s:%d: name %q must be a valid variable name", c.mappingFile, index+1, parts[0])
+		}
+
+		rows = append(rows, row{parts[0], parts[1], parts[2], parts[3]})
+	}
+
+	return rows, nil
+}
+
+func (c *Client) findRow(name string) (row, error) {
+	rows, err := c.readMapping()
+	if err != nil {
+		return row{}, err
+	}
+
+	for _, r := range rows {
+		if r.name == name {
+			return r, nil
+		}
+	}
+
+	return row{}, fmt.Errorf("no mapping row named %q", name)
+}
+
+func writeSecret(path, data string) error {
+	return renameio.WriteFile(path, []byte(data), 0o600, renameio.WithStaticPermissions(0o600))
+}
+
+func (c *Client) grantPath(name string) string {
+	return filepath.Join(c.grantsDir, name+".grant")
+}
+
+func (c *Client) readGrant(name string) map[string]string {
+	data, err := os.ReadFile(c.grantPath(name))
+	if err != nil {
+		return nil
+	}
+
+	fields := map[string]string{}
+	for _, line := range strings.Split(string(data), "\n") {
+		if key, value, ok := strings.Cut(line, "="); ok {
+			fields[key] = value
+		}
+	}
+
+	return fields
+}
+
+func (c *Client) writeGrant(name, kind string, seconds int) time.Time {
+	expires := time.Now().Add(time.Duration(seconds) * time.Second)
+
+	_ = writeSecret(c.grantPath(name), fmt.Sprintf("name=%s\nkind=%s\nexpires=%s\nexpires_unix=%d\n",
+		name, kind, expires.Format(time.RFC3339), expires.Unix()))
+
+	return expires
+}
+
+var durationPattern = regexp.MustCompile(`(\d+)\s*([A-Za-z]+)`)
+
+var durationUnits = map[string]int{
+	"s": 1, "sec": 1, "second": 1, "seconds": 1,
+	"m": 60, "min": 60, "minute": 60, "minutes": 60,
+	"h": 3600, "hr": 3600, "hour": 3600, "hours": 3600,
+	"d": 86400, "day": 86400, "days": 86400,
+}
+
+func parseDuration(text string) (int, error) {
+	if seconds, err := strconv.Atoi(text); err == nil && seconds > 0 {
+		return seconds, nil
+	}
+
+	total := 0
+	for _, match := range durationPattern.FindAllStringSubmatch(text, -1) {
+		unit, ok := durationUnits[match[2]]
+		if !ok {
+			return 0, fmt.Errorf("unknown duration unit %q in %q", match[2], text)
+		}
+
+		number, _ := strconv.Atoi(match[1])
+		total += number * unit
+	}
+
+	if total <= 0 {
+		return 0, fmt.Errorf("invalid duration %q, use a systemd timespan such as 30min or 1h", text)
+	}
+
+	return total, nil
+}
+
+func upstreamHost(upstream string) string {
+	if _, rest, ok := strings.Cut(upstream, "://"); ok {
+		upstream = rest
+	}
+
+	host, _, _ := strings.Cut(upstream, "/")
+
+	return host
+}
+
+func (c *Client) dropinText(r row, value string) string {
+	return fmt.Sprintf(`@phial_%[1]s_path path /%[1]s /%[1]s/*
+@phial_%[1]s_granted {
+	path /%[1]s /%[1]s/*
+	file {
+		root %[2]s
+		try_files %[1]s.grant
+	}
+}
+handle @phial_%[1]s_granted {
+	uri strip_prefix /%[1]s
+	reverse_proxy %[3]s {
+		header_up Host %[4]s
+		header_up Authorization "Bearer %[5]s"
+	}
+}
+handle @phial_%[1]s_path {
+	respond 403
+}
+`, r.name, c.grantsDir, r.upstream, upstreamHost(r.upstream), value)
+}
+
+func (c *Client) caddyfileText() string {
+	var out strings.Builder
+
+	out.WriteString("{\n\tadmin off\n}\n\n:4000 {\n\tbind ::1\n")
+
+	if dropins, _ := filepath.Glob(filepath.Join(c.dropinsDir, "*.caddy")); len(dropins) > 0 {
+		out.WriteString("\timport " + filepath.Join(c.dropinsDir, "*.caddy") + "\n")
+	}
+
+	out.WriteString("\thandle {\n\t\trespond 404\n\t}\n}\n")
+
+	return out.String()
+}
+
+func (c *Client) materializeRow(r row) error {
+	value, err := resolve(r.source)
+	if err != nil {
+		return err
+	}
+
+	if r.mode == "env" {
+		return writeSecret(filepath.Join(c.secretsDir, r.name), value+"\n")
+	}
+
+	if err := writeSecret(filepath.Join(c.dropinsDir, r.name+".caddy"), c.dropinText(r, value)); err != nil {
+		return err
+	}
+
+	return writeSecret(filepath.Join(c.secretsDir, r.name), Placeholder+"\n")
+}
diff --git a/cli/pkg/phial/revoke.go b/cli/pkg/phial/revoke.go
