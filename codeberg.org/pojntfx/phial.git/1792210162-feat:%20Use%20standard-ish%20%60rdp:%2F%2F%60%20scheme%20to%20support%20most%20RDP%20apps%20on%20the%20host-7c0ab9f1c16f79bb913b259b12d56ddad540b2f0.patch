diff --git a/internal/virt/accessors_test.go b/internal/virt/accessors_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..a8b045c0dc9a4c5338a53f1798d88d08bb0f7119
--- /dev/null
+++ b/internal/virt/accessors_test.go
@@ -0,0 +1,15 @@
+package virt
+
+import "testing"
+
+func TestRdpEndpoint(t *testing.T) {
+	def := Defaults("phial")
+
+	if got, want := def.RdpAddress(), "localhost:3392"; got != want {
+		t.Fatalf("RdpAddress() = %q, want %q", got, want)
+	}
+
+	if got, want := def.RdpURI(), "rdp://phial@localhost:3392"; got != want {
+		t.Fatalf("RdpURI() = %q, want %q", got, want)
+	}
+}
