diff --git a/internal/rdp/rdp.go b/internal/rdp/rdp.go
new file mode 100644
index 0000000000000000000000000000000000000000..29b7cea794bc44dac5c983cd79f648fda859633f
--- /dev/null
+++ b/internal/rdp/rdp.go
@@ -0,0 +1,15 @@
+package rdp
+
+import (
+	"fmt"
+
+	"github.com/rymdport/portal/openuri"
+)
+
+func Open(uri string) error {
+	if err := openuri.OpenURI("", uri, nil); err != nil {
+		return fmt.Errorf("could not open %s: install a client for rdp:// links (%w)", uri, err)
+	}
+
+	return nil
+}
