From e8130faef13664b85f9f961f3c10bc8b9359310c Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Wed, 18 Nov 2026 21:38:47 -0700
Subject: [PATCH] refactor: Reword disclosures to imply consent by ticking them
---
diff --git a/assets/resources/setup-dialog.blp b/assets/resources/setup-dialog.blp
index 79daaf84ca8dece1467ed1a94360ac6e61f5544c..b0dedb7cb6cd2333b72bcc2b6a2e8f727298eb72 100644
--- a/assets/resources/setup-dialog.blp
+++ b/assets/resources/setup-dialog.blp
@@ -85,7 +85,7 @@           Adw.PreferencesGroup {
             description: _("The host service runs your machines on this computer, outside the application sandbox. It is the only part of Phial that touches the system.");
 
             Adw.ActionRow {
-              title: _("Runs your machines <b>outside the application sandbox</b>");
+              title: _("I understand it <b>runs your machines outside the application sandbox</b>");
               use-markup: true;
               activatable-widget: disclosure_sandbox_check;
 
@@ -96,7 +96,7 @@               }
             }
 
             Adw.ActionRow {
-              title: _("Reads and writes only the <b>machines folder</b>");
+              title: _("I understand it <b>reads and writes to the machines folder</b>");
               use-markup: true;
               activatable-widget: disclosure_folders_check;
 
@@ -107,7 +107,7 @@               }
             }
 
             Adw.ActionRow {
-              title: _("Uses the <b>SSH and PGP agents</b> and the secret service of the host");
+              title: _("I understand it <b>uses the SSH and PGP agents and the secret service of the host</b>");
               use-markup: true;
               activatable-widget: disclosure_agents_check;
 
@@ -118,7 +118,7 @@               }
             }
 
             Adw.ActionRow {
-              title: _("Uses the <b>virtualisation tools</b> of the host");
+              title: _("I understand it <b>uses the virtualisation tools of the host</b>");
               use-markup: true;
               activatable-widget: disclosure_tools_check;
 
@@ -129,7 +129,7 @@               }
             }
 
             Adw.ActionRow {
-              title: _("Runs fixed <b>administrator commands</b>, which you approve each time");
+              title: _("I understand it <b>runs fixed administrator commands, which you approve each time</b>");
               use-markup: true;
               activatable-widget: disclosure_root_check;
 

