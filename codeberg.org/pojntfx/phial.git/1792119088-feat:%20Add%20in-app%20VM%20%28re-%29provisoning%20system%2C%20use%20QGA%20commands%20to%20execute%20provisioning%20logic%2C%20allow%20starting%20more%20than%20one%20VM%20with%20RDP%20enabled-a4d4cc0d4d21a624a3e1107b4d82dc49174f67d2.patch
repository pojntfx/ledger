 	)
 
-	if err := run(def, prepareGuestScript(strings.Join(steps, "\n"))); err != nil {
+	// The guest agent of QEMU runs in a confined SELinux domain that reads and
+	// writes nothing outside of /run and /tmp, so the script and the binary go
+	// to /run/phial through the file API of the agent, and the path unit of the
+	// guest starts the service that runs the script as root without
+	// confinement.
+	var payload strings.Builder
+
+	payload.WriteString("exec > /run/phial/output.log 2>&1\n")
+	payload.WriteString("trap 'echo failed > /run/phial/status' ERR\n")
+	payload.WriteString("set -e\n")
+	payload.WriteString("rm -f /run/phial/trigger\n")
+	payload.WriteString(prepareGuestScript(strings.Join(steps, "\n")))
+	payload.WriteString("\nif [ -f /run/phial/phial ]; then\n")
+	payload.WriteString("\tinstall -m 0755 -o " + guestUser + " -g " + guestUser + " /run/phial/phial " + guestHome + "/.local/bin/phial\n")
+	payload.WriteString("\trestorecon " + guestHome + "/.local/bin/phial > /dev/null 2>&1 || true\n")
+
+	// The version check of the agent reads the build time of the host from
+	// /etc, because the confined domain of the agent reads nothing of the home
+	// of the user.
+	if hostTime, err := virt.HostBuildTime(); err == nil {
+		payload.WriteString("\tprintf '%s\\n' '" + strconv.FormatInt(hostTime, 10) + "' > " + virt.GuestAgentBuildTimePath + "\n")
+	}
+
+	payload.WriteString("fi\n")
+	payload.WriteString("echo done > /run/phial/status\n")
+
+	if _, err := virt.QgaExec(def, "mkdir -p /run/phial && rm -f /run/phial/status /run/phial/output.log"); err != nil {
 		return err
 	}
 
-	if len(agent) == 0 {
-		return nil
+	if err := virt.QgaWriteFile(def, "/run/phial/provision.sh", 0755, []byte(payload.String())); err != nil {
+		return err
 	}
 
-	path := guestHome + "/.local/bin/phial"
+	if len(agent) > 0 {
+		if err := virt.QgaWriteFile(def, "/run/phial/phial", 0755, agent); err != nil {
+			return err
+		}
+	}
 
-	if err := virt.QgaWriteFile(def, path, 0755, agent); err != nil {
+	if _, err := virt.QgaExec(def, "touch /run/phial/trigger"); err != nil {
 		return err
 	}
 
-	_, err = virt.QgaExec(def, "chown phial:phial "+path+" && restorecon "+path+" > /dev/null 2>&1 || true")
+	deadline := time.Now().Add(15 * time.Minute)
+
+	for time.Now().Before(deadline) {
+		status, _ := virt.QgaExec(def, "cat /run/phial/status 2>/dev/null || true")
+
+		switch strings.TrimSpace(status) {
+		case "done":
+			return printOutput(def)
+		case "failed":
+			output, _ := virt.QgaExec(def, "tail -c 8192 /run/phial/output.log 2>/dev/null || true")
+
+			return fmt.Errorf("the provisioning script in the guest failed: %s", output)
+		}
+
+		time.Sleep(2 * time.Second)
+	}
+
+	return errors.New("the provisioning script in the guest did not finish in time")
+}
+
+// printOutput states the log of the provisioning script of the guest.
+func printOutput(def virt.Definition) error {
+	output, err := virt.QgaExec(def, "cat /run/phial/output.log 2>/dev/null || true")
+	if output != "" {
+		fmt.Fprintln(os.Stderr, output)
+	}
 
 	return err
 }
