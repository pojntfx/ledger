+		unit, err := files.ReadFile("files/systemd-system/" + item)
+		if err != nil {
+			return err
+		}
+
+		steps = append(steps, writeSystemFile("/etc/systemd/system/"+item, string(unit), "0644"))
 	}
-
-	steps = append(steps, writeSystemFile("/etc/systemd/system/phial-network.service", string(unit), "0644"))
 
 	steps = append(steps,
 		// The installer creates parts of the home directory as root, so the
@@ -111,24 +120,83 @@ 		"ln -sf /dev/null /etc/systemd/system/NetworkManager-wait-online.service 2>/dev/null || true",
 		"ln -sf /dev/null /etc/systemd/system/plymouth-quit-wait.service 2>/dev/null || true",
 		"sudo systemctl disable --now geoclue.service 2>/dev/null || true",
 		"sudo systemctl daemon-reload",
+		"sudo grubby --update-kernel=ALL --args='plymouth.enable=0' 2>/dev/null || true",
 		"sudo systemctl enable --now phial-network.service 2>/dev/null || true",
