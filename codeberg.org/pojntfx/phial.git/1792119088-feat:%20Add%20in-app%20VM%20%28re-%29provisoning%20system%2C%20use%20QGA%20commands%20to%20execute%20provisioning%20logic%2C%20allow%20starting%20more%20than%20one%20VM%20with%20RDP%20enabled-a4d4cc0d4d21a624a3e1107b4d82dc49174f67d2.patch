 UNIT
 systemctl enable phial-ssh-vsock.service
+cat > /etc/systemd/system/phial-provision.path <<'UNIT'
+[Unit]
+Description=phial guest provisioning trigger
+
+[Path]
+PathExists=/run/phial/trigger
+Unit=phial-provision.service
+
+[Install]
+WantedBy=multi-user.target
+UNIT
+cat > /etc/systemd/system/phial-provision.service <<'UNIT'
+[Unit]
+Description=phial guest provisioning
+
+[Service]
+Type=oneshot
+ExecStart=/bin/bash /run/phial/provision.sh
+UNIT
+systemctl enable phial-provision.path
 loginctl enable-linger phial
 %end
