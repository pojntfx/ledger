diff --git a/internal/virt/stop.go b/internal/virt/stop.go
new file mode 100644
index 0000000000000000000000000000000000000000..31afa1f95e560380add21167b7bc861c618128f3
--- /dev/null
+++ b/internal/virt/stop.go
@@ -0,0 +1,88 @@
+package virt
+
+import (
+	"log/slog"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+)
+
+// gracefulStopTimeout bounds the shutdown of the guest, after which the
+// machine is switched off.
+const gracefulStopTimeout = 60 * time.Second
+
+// GracefulStop asks the guest of one machine to shut down and switches the
+// machine off when the guest does not shut down in time, so that a stop does
+// not lose the writes of the guest.
+func GracefulStop(d Definition) {
+	// The agent shuts the guest down in order, which flushes its writes;
+	// without an agent, the power button of the machine asks the guest for
+	// the same thing.
+	if _, err := QgaCall(d, "guest-shutdown", map[string]interface{}{"mode": "powerdown"}); err != nil {
+		slog.Debug("could not shut down the guest through the agent, pressing the power button instead", "name", d.Name, "err", err)
+
+		if err := qmpSystemPowerdown(d); err != nil {
+			slog.Warn("could not press the power button of the machine", "name", d.Name, "err", err)
+		}
+	}
+
+	deadline := time.Now().Add(gracefulStopTimeout)
+
+	for time.Now().Before(deadline) {
+		running, err := machineRuns(d)
+		if err == nil && !running {
+			return
+		}
+
+		time.Sleep(500 * time.Millisecond)
+	}
+
+	// The guest ignored the shutdown, so the machine is switched off, like a
+	// long press of the power button.
+	if err := qmpQuit(d); err != nil {
+		slog.Warn("could not switch off the machine after the guest shutdown timed out", "name", d.Name, "err", err)
+	}
+}
+
+func qmpSystemPowerdown(d Definition) error {
+	conn, reader, err := qmpConnect(d)
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+
+	return qmpCall(conn, reader, qmpCommand{Execute: "system_powerdown"})
+}
+
+func qmpQuit(d Definition) error {
+	conn, reader, err := qmpConnect(d)
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+
+	return qmpCall(conn, reader, qmpCommand{Execute: "quit"})
+}
+
+// machineRuns states whether the QEMU process of one machine is still alive.
+func machineRuns(d Definition) (bool, error) {
+	data, err := os.ReadFile(filepath.Join(d.runtimePath(), "qemu.pid"))
+	if err != nil {
+		return false, err
+	}
+
+	pid, err := strconv.Atoi(strings.TrimSpace(string(data)))
+	if err != nil {
+		return false, err
+	}
+
+	process, err := os.FindProcess(pid)
+	if err != nil {
+		return false, err
+	}
+
+	return process.Signal(syscall.Signal(0)) == nil, nil
+}
