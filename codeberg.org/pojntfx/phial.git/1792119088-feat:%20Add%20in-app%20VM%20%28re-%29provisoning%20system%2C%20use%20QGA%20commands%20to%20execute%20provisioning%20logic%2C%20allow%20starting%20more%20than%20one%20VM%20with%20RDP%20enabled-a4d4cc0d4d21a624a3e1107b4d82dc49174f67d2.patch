--- a/host/systemd/phial-swtpm@.service
+++ b/host/systemd/phial-swtpm@.service
@@ -6,7 +6,11 @@ [Service]
 Type=exec
 RuntimeDirectory=phial/vms/%i
 RuntimeDirectoryMode=0700
+# The directory also carries the firmware state and the sockets of the
+# machine, so it must survive the restart of this service.
+RuntimeDirectoryPreserve=yes
 ExecStartPre=mkdir -p %t/phial/vms/%i/swtpm
+ExecStartPre=rm -f %t/phial/vms/%i/swtpm.sock
 ExecStart=@SWTPM@ socket --tpmstate dir=%t/phial/vms/%i/swtpm --ctrl type=unixio,path=%t/phial/vms/%i/swtpm.sock --tpm2 --log file=%t/phial/vms/%i/swtpm.log,level=5 --flags not-need-init
