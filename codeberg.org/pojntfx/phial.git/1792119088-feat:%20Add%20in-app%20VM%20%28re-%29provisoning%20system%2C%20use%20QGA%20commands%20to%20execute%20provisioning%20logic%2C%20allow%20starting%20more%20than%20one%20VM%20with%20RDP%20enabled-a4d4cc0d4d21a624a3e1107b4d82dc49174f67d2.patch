diff --git a/host/systemd/phial-vm@.service b/host/systemd/phial-vm@.service
index 492ee3b96c3a5961a0874488f0237d559edef5e3..eea44a6c59b6c1c6987b4b124a446f2050b3672f 100644
--- a/host/systemd/phial-vm@.service
+++ b/host/systemd/phial-vm@.service
@@ -10,6 +10,12 @@ ExecStart=%h/.local/bin/phial vm exec %i
 Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:@BREW_PREFIX@/bin
 LimitMEMLOCK=infinity
 Restart=on-failure
+# The stop signal goes to the supervisor alone, which shuts the guest down in
+# order first; anything left after the timeout is killed with the group. The
+# timeout leaves room for the shutdown of the guest, which outlives the
+# default of the distribution.
+KillMode=mixed
+TimeoutStopSec=120
 
 [Install]
 WantedBy=default.target
