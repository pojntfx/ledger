 	)
 
 	return run(def.Name, strings.Join(steps, "\n"))
+}
+
+func shareMountScript(def virt.Definition) string {
+	var builder strings.Builder
+
+	for _, share := range def.Shares {
+		tag := virt.ShareTag(share)
+		target := def.ShareTarget(share)
+
+		options := "defaults,nofail"
+
+		if def.ShareReadOnly(share) {
+			options = "ro,nosuid,nodev,nofail"
+		}
+
+		fmt.Fprintf(&builder, "sudo install -d -m 0755 %s\n", target)
+		fmt.Fprintf(&builder, "sudo sed -i '\\| %s |d' /etc/fstab\n", target)
+		fmt.Fprintf(&builder, "echo '%s %s virtiofs %s 0 0' | sudo tee -a /etc/fstab > /dev/null\n", tag, target, options)
+		fmt.Fprintf(&builder, "sudo mountpoint -q %s || sudo mount %s || true\n", target, target)
+	}
+
+	return builder.String()
 }
 
