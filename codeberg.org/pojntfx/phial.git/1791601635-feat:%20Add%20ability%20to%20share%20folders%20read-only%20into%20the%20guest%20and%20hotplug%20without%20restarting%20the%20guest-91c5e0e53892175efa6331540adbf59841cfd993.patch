diff --git a/internal/virt/hotplug.go b/internal/virt/hotplug.go
new file mode 100644
index 0000000000000000000000000000000000000000..c4fc786e4b65c49b1009cd2bd04522aa2141316b
--- /dev/null
+++ b/internal/virt/hotplug.go
@@ -0,0 +1,264 @@
+package virt
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+type qmpCommand struct {
+	Execute   string      `json:"execute"`
+	Arguments interface{} `json:"arguments,omitempty"`
+}
+
+type qmpResponse struct {
+	Return interface{} `json:"return"`
+	Error  *struct {
+		Class string `json:"class"`
+		Desc  string `json:"desc"`
+	} `json:"error"`
+}
+
+func qmpCall(conn net.Conn, reader *bufio.Reader, command qmpCommand) error {
+	payload, err := json.Marshal(command)
+	if err != nil {
+		return err
+	}
+
+	if _, err := conn.Write(append(payload, '\n')); err != nil {
+		return err
+	}
+
+	for {
+		line, err := reader.ReadBytes('\n')
+		if err != nil {
+			return err
+		}
+
+		var response qmpResponse
+		if err := json.Unmarshal(line, &response); err != nil {
+			continue
+		}
+
+		if response.Error != nil {
+			return fmt.Errorf("%s", response.Error.Desc)
+		}
+
+		if response.Return != nil || command.Execute == "qmp_capabilities" {
+			return nil
+		}
+	}
+}
+
+func qmpQuery(conn net.Conn, reader *bufio.Reader, execute string) ([]map[string]interface{}, error) {
+	payload, err := json.Marshal(qmpCommand{Execute: execute})
+	if err != nil {
+		return nil, err
+	}
+
+	if _, err := conn.Write(append(payload, '\n')); err != nil {
+		return nil, err
+	}
+
+	for {
+		line, err := reader.ReadBytes('\n')
+		if err != nil {
+			return nil, err
+		}
+
+		var response struct {
+			Return []map[string]interface{} `json:"return"`
+			Error  *struct {
+				Desc string `json:"desc"`
+			} `json:"error"`
+		}
+
+		if err := json.Unmarshal(line, &response); err != nil {
+			continue
+		}
+
+		if response.Error != nil {
+			return nil, fmt.Errorf("%s", response.Error.Desc)
+		}
+
+		return response.Return, nil
+	}
+}
+
+func qmpConnect(def Definition) (net.Conn, *bufio.Reader, error) {
+	conn, err := net.DialTimeout("unix", filepath.Join(def.runtimePath(), "qmp.sock"), 10*time.Second)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	reader := bufio.NewReader(conn)
+
+	if _, err := reader.ReadBytes('\n'); err != nil {
+		conn.Close()
+
+		return nil, nil, err
+	}
+
+	if err := qmpCall(conn, reader, qmpCommand{Execute: "qmp_capabilities"}); err != nil {
+		conn.Close()
+
+		return nil, nil, err
+	}
+
+	return conn, reader, nil
+}
+
+func shareSocket(tag string) string {
+	return filepath.Join(os.Getenv("XDG_RUNTIME_DIR"), "phial", "vm", "virtiofsd-"+tag+".sock")
+}
+
+func releaseShare(conn net.Conn, reader *bufio.Reader, tag string) {
+	socketPath := shareSocket(tag)
+
+	_ = qmpCall(conn, reader, qmpCommand{Execute: "device_del", Arguments: map[string]string{"id": "fs-" + tag}})
+
+	time.Sleep(time.Second)
+
+	entries, err := qmpQuery(conn, reader, "query-chardev")
+	if err != nil {
+		return
+	}
+
+	for _, entry := range entries {
+		label, _ := entry["label"].(string)
+		filename, _ := entry["filename"].(string)
+
+		if label == "" {
+			continue
+		}
+
+		if label == "fs-hotplug-"+tag || strings.Contains(filename, socketPath) {
+			_ = qmpCall(conn, reader, qmpCommand{Execute: "chardev-remove", Arguments: map[string]string{"id": label}})
+		}
+	}
+}
+
+func HotplugShare(def Definition, share string) error {
+	tag := ShareTag(share)
+	chardev := "fs-hotplug-" + tag
+	socketPath := shareSocket(tag)
+
+	conn, reader, err := qmpConnect(def)
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+
+	releaseShare(conn, reader, tag)
+
+	manager, err := userManager()
+	if err != nil {
+		return err
+	}
+
+	if _, err := manager.StartUnitContext(context.Background(), "phial-virtiofsd@"+tag+".service", "replace", nil); err != nil {
+		manager.Close()
+
+		return err
+	}
+
+	manager.Close()
+
+	for attempt := 0; attempt < 400; attempt++ {
+		if socketLive(socketPath) {
+			break
+		}
+
+		time.Sleep(100 * time.Millisecond)
+	}
+
+	if !socketLive(socketPath) {
+		return fmt.Errorf("virtiofsd did not listen on %s", socketPath)
+	}
+
+	if err := qmpCall(conn, reader, qmpCommand{
+		Execute: "chardev-add",
+		Arguments: map[string]interface{}{
+			"id": chardev,
+			"backend": map[string]interface{}{
+				"type": "socket",
+				"data": map[string]interface{}{
+					"addr": map[string]interface{}{
+						"type": "unix",
+						"data": map[string]string{"path": socketPath},
+					},
+					"server": false,
+				},
+			},
+		},
+	}); err != nil {
+		return err
+	}
+
+	var lastError error
+
+	for slot := 1; slot <= 8; slot++ {
+		lastError = qmpCall(conn, reader, qmpCommand{
+			Execute: "device_add",
+			Arguments: map[string]string{
+				"driver":  "vhost-user-fs-pci",
+				"bus":     fmt.Sprintf("hotplug%d", slot),
+				"chardev": chardev,
+				"tag":     tag,
+				"id":      "fs-" + tag,
+			},
+		})
+
+		if lastError == nil {
+			return nil
+		}
+	}
+
+	return lastError
+}
+
+func UnplugShare(def Definition, share string) error {
+	tag := ShareTag(share)
+
+	conn, err := net.DialTimeout("unix", filepath.Join(def.runtimePath(), "qmp.sock"), 10*time.Second)
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+
+	reader := bufio.NewReader(conn)
+
+	if _, err := reader.ReadBytes('\n'); err != nil {
+		return err
+	}
+
+	if err := qmpCall(conn, reader, qmpCommand{Execute: "qmp_capabilities"}); err != nil {
+		return err
+	}
+
+	if err := qmpCall(conn, reader, qmpCommand{Execute: "device_del", Arguments: map[string]string{"id": "fs-" + tag}}); err != nil {
+		if !strings.Contains(err.Error(), "not found") {
+			return err
+		}
+	} else {
+		time.Sleep(2 * time.Second)
+	}
+
+	_ = qmpCall(conn, reader, qmpCommand{Execute: "chardev-remove", Arguments: map[string]string{"id": "fs-hotplug-" + tag}})
+
+	manager, err := userManager()
+	if err != nil {
+		return err
+	}
+	defer manager.Close()
+
+	_, err = manager.StopUnitContext(context.Background(), "phial-virtiofsd@"+tag+".service", "replace", nil)
+
+	return err
+}
