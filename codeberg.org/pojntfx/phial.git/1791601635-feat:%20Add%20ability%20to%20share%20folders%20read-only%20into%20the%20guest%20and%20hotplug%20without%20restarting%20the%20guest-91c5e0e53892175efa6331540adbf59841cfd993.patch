From 91c5e0e53892175efa6331540adbf59841cfd993 Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Fri, 09 Oct 2026 20:07:15 -0700
Subject: [PATCH] feat: Add ability to share folders read-only into the guest and hotplug without restarting the guest
---
diff --git a/host/systemd/phial-virtiofsd@.service b/host/systemd/phial-virtiofsd@.service
index 1a589372e6eb65865069612511c995a07e7b8784..1138c3ffec38db5ac0047821a68c37097593059d 100644
--- a/host/systemd/phial-virtiofsd@.service
+++ b/host/systemd/phial-virtiofsd@.service
@@ -7,6 +7,7 @@ Type=simple
 Environment=PATH=@BREW_PREFIX@/bin:/usr/local/bin:/usr/bin:/bin
 EnvironmentFile=-%E/phial/share-%i.conf
 ExecStartPre=mkdir -p %t/phial/vm ${PHIAL_SHARE_DIR}
+ExecStartPre=rm -f %t/phial/vm/virtiofsd-%i.sock
 ExecStart=@VIRTIOFSD@ --socket-path=%t/phial/vm/virtiofsd-%i.sock --shared-dir=${PHIAL_SHARE_DIR} --xattr --announce-submounts --uid-map=:1000:1000:1: --gid-map=:1000:1000:1:
 Restart=always
 
