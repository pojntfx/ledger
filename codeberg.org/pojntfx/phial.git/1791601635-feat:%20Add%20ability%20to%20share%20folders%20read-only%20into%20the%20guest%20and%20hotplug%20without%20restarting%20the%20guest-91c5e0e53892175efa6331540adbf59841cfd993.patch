+func (a *App) showShareTargetDialog(def virt.Definition, share string) {
+	dialog := adw.NewDialog()
+	dialog.SetTitle(i18n.L("Share Folder"))
+	dialog.SetContentWidth(420)
+
+	toolbar := adw.NewToolbarView()
+
+	header := adw.NewHeaderBar()
+	header.SetShowStartTitleButtons(false)
+
+	title := adw.NewWindowTitle(i18n.L("Share Folder"), filepath.Base(share))
+	header.SetTitleWidget(&title.Widget)
+	toolbar.AddTopBar(&header.Widget)
+
+	group := adw.NewPreferencesGroup()
+	group.SetTitle(i18n.L("Mount Point"))
+
+	targetRow := adw.NewEntryRow()
+	targetRow.SetTitle(i18n.L("In the _guest"))
+	targetRow.SetUseUnderline(true)
+	targetRow.SetText(def.ShareTarget(share))
+	targetRow.SetShowApplyButton(false)
+	group.Add(&targetRow.Widget)
+
+	readOnly := false
+
+	readOnlyRow := adw.NewSwitchRow()
+	readOnlyRow.SetTitle(i18n.L("Read-only"))
+	readOnlyRow.SetSubtitle(i18n.L("The guest cannot change the files"))
+
+	var onReadOnlyNotify func(gobject.Object, uintptr)
+	onReadOnlyNotify = func(gobject.Object, uintptr) {
+		readOnly = readOnlyRow.GetActive()
+	}
+	readOnlyRow.ConnectNotify(&onReadOnlyNotify)
+	a.hold(&onReadOnlyNotify)
+
+	group.Add(&readOnlyRow.Widget)
+
+	group.Add(&a.buttonRow(i18n.L("_Share the folder"), "folder-symbolic", func() {
+		target := strings.TrimSpace(targetRow.GetText())
+		if target == "" {
+			a.toast(i18n.L("Enter a mount point first"))
+			return
+		}
+
+		a.goAsync(func() (string, error) {
+			_, _, err := a.Service.ShareAdd(a.Ctx, nil, mcp.ShareInput{Name: def.Name, Path: share, Target: target, ReadOnly: readOnly})
+			if err != nil {
+				return "", err
+			}
+
+			a.idle(func() { a.refreshVMDetail(def.Name) })
+
+			return i18n.L("Folder shared") + " at " + target, nil
+		})
+
+		dialog.Close()
+	}).Widget)
+
+	page := adw.NewPreferencesPage()
+	page.Add(group)
+
+	toolbar.SetContent(&page.Widget)
+	dialog.SetChild(&toolbar.Widget)
+	dialog.Present(&a.window.Widget)
+}
+
