diff --git a/internal/version/version.go b/internal/version/version.go
index 35f162dc6399b7950f9fe0590f1d56d58ddb6608..c794ae47fac7e66ee9824e0ab8022ced05a71566 100644
--- a/internal/version/version.go
+++ b/internal/version/version.go
@@ -8,3 +8,18 @@ const App = "2.0.0"
 
 // AppID is the Flatpak application identifier of Phial.
 const AppID = "com.pojtinger.felicitas.Phial"
+
+// BuildID states the content identity of this build. The build scripts set it
+// from the commit and the working tree, so two builds of one tree agree even
+// when the version stays the same.
+var BuildID = ""
+
+// Build states the content identity, or the version when the build scripts
+// carry none.
+func Build() string {
+	if BuildID != "" {
+		return BuildID
+	}
+
+	return App
+}
