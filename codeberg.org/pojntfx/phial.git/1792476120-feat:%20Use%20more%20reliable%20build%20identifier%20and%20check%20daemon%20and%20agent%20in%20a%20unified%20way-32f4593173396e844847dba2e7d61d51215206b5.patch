diff --git a/Makefile b/Makefile
index 14e6243ccc5441b566aae4a7c5025096bdcbd25c..68112f6f58ae6f2c69cc6a0ee0051c6ee27a6130 100644
--- a/Makefile
+++ b/Makefile
@@ -6,15 +6,18 @@ GUEST_AGENT := cmd/phiald/guest/agent/phial
 PHIALD := internal/hostsvc/phiald
 PHIALD_BINARY := bin/phiald
 
+BUILD_ID := $(shell { git rev-parse HEAD 2>/dev/null || echo dev; git diff --binary HEAD 2>/dev/null || true; git ls-files --others --exclude-standard -z 2>/dev/null | xargs -0 -r sha256sum; } | sha256sum | cut -c1-16)
+GO_LDFLAGS := -s -w -X codeberg.org/pojntfx/phial-neo/internal/version.BuildID=$(BUILD_ID)
+
 build:
 	: > $(GUEST_AGENT)
-	CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o $(GUEST_AGENT) .
-	CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o $(PHIALD) ./cmd/phiald
-	CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o bin/phial .
-	CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o $(PHIALD_BINARY) ./cmd/phiald
+	CGO_ENABLED=0 go build -trimpath -ldflags="$(GO_LDFLAGS)" -o $(GUEST_AGENT) .
+	CGO_ENABLED=0 go build -trimpath -ldflags="$(GO_LDFLAGS)" -o $(PHIALD) ./cmd/phiald
+	CGO_ENABLED=0 go build -trimpath -ldflags="$(GO_LDFLAGS)" -o bin/phial .
+	CGO_ENABLED=0 go build -trimpath -ldflags="$(GO_LDFLAGS)" -o $(PHIALD_BINARY) ./cmd/phiald
 
 guest-agent:
-	CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o $(GUEST_AGENT) .
+	CGO_ENABLED=0 go build -trimpath -ldflags="$(GO_LDFLAGS)" -o $(GUEST_AGENT) .
 
 generate:
 	cd assets/resources && blueprint-compiler batch-compile . . *.blp
diff --git a/cmd/phiald/guest/fingerprint.go b/cmd/phiald/guest/fingerprint.go
new file mode 100644
index 0000000000000000000000000000000000000000..c0d7f2f34976809288b21a56a86652d0a04084cb
--- /dev/null
+++ b/cmd/phiald/guest/fingerprint.go
@@ -0,0 +1,7 @@
+package guest
+
+import "codeberg.org/pojntfx/phial-neo/internal/version"
+
+func AgentFingerprint() string {
+	return version.Build()
