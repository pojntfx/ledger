diff --git a/cmd/phiald/virt/agent_version.go b/cmd/phiald/virt/agent_version.go
index 50d2fb78cb7bc14943a0d764ba3a1927ec1cfb2a..b0e490b3a8568fb553e4e3ba0f38efa4cb3c9de1 100644
--- a/cmd/phiald/virt/agent_version.go
+++ b/cmd/phiald/virt/agent_version.go
@@ -1,59 +1,29 @@
 package virt
 
-import (
-	"os"
-	"strconv"
-	"strings"
-)
+import "strings"
 
-// GuestAgentPath states where the provisioning copies the agent into a guest.
 const GuestAgentPath = "/home/phial/.local/bin/phial"
 
-// HostBuildTime states the build time of the binary of the host, which is the
-// time that the file of that binary changed.
-func HostBuildTime() (int64, error) {
-	executable, err := os.Executable()
-	if err != nil {
-		return 0, err
-	}
-
-	info, err := os.Stat(executable)
-	if err != nil {
-		return 0, err
-	}
-
-	return info.ModTime().Unix(), nil
-}
-
-// GuestAgentBuildTimePath states where the provisioning writes the build time
-// of the host. It lives in /etc, because the confined domain of the agent
-// reads nothing of the home of the user.
-const GuestAgentBuildTimePath = "/etc/phial-agent-build-time"
+const GuestAgentFingerprintPath = "/etc/phial-agent-fingerprint"
 
-// GuestBuildTime states the build time of the agent inside one guest, or zero
-// when the guest carries no agent yet. It reads over the guest agent protocol,
-// so the check works without SSH and without a login.
-func GuestBuildTime(def Definition) (int64, error) {
-	output, err := QgaExec(def, "cat "+GuestAgentBuildTimePath+" 2>/dev/null || echo 0")
+func GuestFingerprint(def Definition) (string, error) {
+	output, err := QgaExec(def, "cat "+GuestAgentFingerprintPath+" 2>/dev/null || true")
 	if err != nil {
-		return 0, err
+		return "", err
 	}
 
-	return strconv.ParseInt(strings.TrimSpace(output), 10, 64)
+	return strings.TrimSpace(output), nil
 }
 
-// GuestOutdated states whether the agent of a guest is older than the binary of
-// the host, so that the guest needs the update step.
-func GuestOutdated(def Definition) (bool, error) {
-	host, err := HostBuildTime()
-	if err != nil {
-		return false, err
+func GuestOutdated(def Definition, expected string) (bool, error) {
+	if expected == "" {
+		return false, nil
 	}
 
-	guest, err := GuestBuildTime(def)
+	guest, err := GuestFingerprint(def)
 	if err != nil {
 		return false, err
 	}
 
-	return guest < host, nil
+	return guest != expected, nil
 }
