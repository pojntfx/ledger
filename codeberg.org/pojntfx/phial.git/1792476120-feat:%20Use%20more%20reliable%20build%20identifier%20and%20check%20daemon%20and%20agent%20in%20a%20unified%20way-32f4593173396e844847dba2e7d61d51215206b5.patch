diff --git a/internal/host/update.go b/internal/host/update.go
index 382d2ebd434fc4dc0799b6237e7aae5c5b28f38e..35a17d44af121686563f4fadf7d1ad439e74f25d 100644
--- a/internal/host/update.go
+++ b/internal/host/update.go
@@ -21,14 +21,36 @@ func Embedded() bool {
 	return len(hostsvc.Binary) > 0
 }
 
-// NeedsUpdate reports whether the running service is older than the embedded
-// one, so that the application shows the update toast.
+// EmbeddedFingerprint states the content identity of the embedded service.
+func EmbeddedFingerprint() string {
+	return version.Build()
+}
+
+// NeedsUpdate reports whether the running service differs from the embedded
+// one, so that the application shows the update banner.
 func NeedsUpdate(info *InfoResponse) bool {
 	if info == nil || info.Version == "" {
 		return false
 	}
 
-	return info.Version != EmbeddedVersion() || info.Protocol != varlink.ProtocolVersion
+	if info.Protocol != varlink.ProtocolVersion {
+		return true
+	}
+
+	if info.Version != EmbeddedVersion() {
+		return true
+	}
+
+	if !Embedded() {
+		return false
+	}
+
+	embedded := EmbeddedFingerprint()
+	if embedded == "" {
+		return false
+	}
+
+	return info.Build != embedded
 }
 
 // UpdateCommand states the host command that re-installs the embedded service
diff --git a/internal/host/update_test.go b/internal/host/update_test.go
index ab4062c2981bfde2d72b213b7a31dddb74a04192..511fca887042edb0c3386602a4f1ae4cdce22498 100644
--- a/internal/host/update_test.go
+++ b/internal/host/update_test.go
@@ -4,31 +4,66 @@ import (
 	"strings"
 	"testing"
 
+	"codeberg.org/pojntfx/phial-neo/internal/hostsvc"
 	"codeberg.org/pojntfx/phial-neo/internal/varlink"
+	"codeberg.org/pojntfx/phial-neo/internal/version"
 )
 
 func TestNeedsUpdateComparesVersions(t *testing.T) {
-	// A matching version and protocol needs no update.
-	info := &InfoResponse{Version: EmbeddedVersion(), Protocol: varlink.ProtocolVersion}
+	build := EmbeddedFingerprint()
+
+	info := &InfoResponse{Version: EmbeddedVersion(), Build: build, Protocol: varlink.ProtocolVersion}
 	if NeedsUpdate(info) {
 		t.Fatal("a matching version asked for an update")
 	}
 
-	// A different version needs an update.
-	info = &InfoResponse{Version: "0.0.1", Protocol: varlink.ProtocolVersion}
+	info = &InfoResponse{Version: "0.0.1", Build: build, Protocol: varlink.ProtocolVersion}
 	if !NeedsUpdate(info) {
 		t.Fatal("an old version did not ask for an update")
 	}
 
-	// A different protocol needs an update.
-	info = &InfoResponse{Version: EmbeddedVersion(), Protocol: varlink.ProtocolVersion + 1}
+	info = &InfoResponse{Version: EmbeddedVersion(), Build: build, Protocol: varlink.ProtocolVersion + 1}
 	if !NeedsUpdate(info) {
 		t.Fatal("an old protocol did not ask for an update")
 	}
 
-	// No service means no update.
+	if Embedded() {
+		info = &InfoResponse{Version: EmbeddedVersion(), Build: "other", Protocol: varlink.ProtocolVersion}
+		if !NeedsUpdate(info) {
+			t.Fatal("another build did not ask for an update")
+		}
+	}
+
 	if NeedsUpdate(nil) {
 		t.Fatal("no service asked for an update")
+	}
+}
+
+func TestNeedsUpdateComparesTheBuildIdentity(t *testing.T) {
+	previousBinary := hostsvc.Binary
+	previousBuild := version.BuildID
+
+	hostsvc.Binary = []byte("service")
+	version.BuildID = "new-build"
+
+	defer func() {
+		hostsvc.Binary = previousBinary
+		version.BuildID = previousBuild
+	}()
+
+	info := &InfoResponse{Version: EmbeddedVersion(), Build: "new-build", Protocol: varlink.ProtocolVersion}
+	if NeedsUpdate(info) {
+		t.Fatal("the same build asked for an update")
+	}
+
+	info = &InfoResponse{Version: EmbeddedVersion(), Build: "old-build", Protocol: varlink.ProtocolVersion}
+	if !NeedsUpdate(info) {
+		t.Fatal("another build did not ask for an update")
+	}
+
+	info = &InfoResponse{Version: EmbeddedVersion(), Protocol: varlink.ProtocolVersion}
+	if !NeedsUpdate(info) {
+		t.Fatal("a service without a build identity did not ask for an update")
 	}
 }
 
