@@ -127,6 +129,8 @@ 	case "--background", "-background":
 		os.Exit(runApp(log, false))
 	case "--help", "-help", "-h", "help":
 		fmt.Print(usage)
+	case "--version", "-version", "version":
+		fmt.Println(version.App + " (" + version.Build() + ")")
 	case "host-install":
 		fail(runHostInstall(args[1:]))
 	case "acceptance":

