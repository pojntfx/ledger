+
+	if fingerprint := AgentFingerprint(); fingerprint != "" {
+		payload.WriteString("\tprintf '%s\\n' '" + fingerprint + "' > " + virt.GuestAgentFingerprintPath + "\n")
 	}
 
 	payload.WriteString("fi\n")
