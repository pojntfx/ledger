+++ b/internal/components/vms.go
@@ -8,6 +8,7 @@
 	"codeberg.org/puregotk/puregotk/v4/adw"
 	"codeberg.org/puregotk/puregotk/v4/gobject"
 	"codeberg.org/puregotk/puregotk/v4/gtk"
+	"codeberg.org/puregotk/puregotk/v4/pango"
 	"github.com/pojntfx/go-gettext/pkg/i18n"
 
 	"codeberg.org/pojntfx/phial/internal/mcp"
@@ -232,6 +233,67 @@ 		infoGroup.Add(&statusRow.Widget)
 	}
 
 	vbox.Append(&infoGroup.Widget)
+
+	usageGroup := adw.NewPreferencesGroup()
+	usageGroup.SetTitle(i18n.L("Usage"))
+
+	usageBox := gtk.NewBox(gtk.OrientationHorizontalValue, 6)
+	usageBox.SetHomogeneous(true)
+	usageBox.SetMarginTop(12)
+	usageBox.SetMarginBottom(12)
+	usageBox.SetMarginStart(12)
+	usageBox.SetMarginEnd(12)
+
+	usageValues := map[string]*gtk.Label{}
+
+	addUsage := func(key string, caption string, initial string) {
+		column := gtk.NewBox(gtk.OrientationVerticalValue, 2)
+
+		value := gtk.NewLabel(initial)
+		value.AddCssClass("title-3")
+		value.SetEllipsize(pango.EllipsizeEndValue)
+
+		label := gtk.NewLabel(caption)
+		label.AddCssClass("dim-label")
+		label.AddCssClass("caption")
+		label.SetEllipsize(pango.EllipsizeEndValue)
+
+		column.Append(&value.Widget)
+		column.Append(&label.Widget)
+
+		usageValues[key] = value
+		usageBox.Append(&column.Widget)
+	}
+
+	addUsage("cpu", i18n.L("CPU"), "-")
+	addUsage("memory", i18n.L("Memory"), "-")
+	addUsage("disk", i18n.L("Disk"), "-")
+	addUsage("network", i18n.L("Network"), "-")
+	addUsage("gpu", i18n.L("GPU"), def.GPU)
+
+	usageGroup.Add(&usageBox.Widget)
+	vbox.Append(&usageGroup.Widget)
+
+	if active {
+		a.every(3, func() bool {
+			go func() {
+				metrics, err := virt.CollectMetrics(def)
+				if err != nil {
+					return
+				}
+
+				a.idle(func() {
+					usageValues["cpu"].SetText(fmt.Sprintf("%.0f%%", metrics.CPUPercent))
+					usageValues["memory"].SetText(formatBytes(metrics.MemoryUsed))
+					usageValues["disk"].SetText(formatBytes(metrics.DiskAllocated))
+					usageValues["network"].SetText(formatBytes(int64(metrics.NetworkRxRate)) + "/s")
+					usageValues["gpu"].SetText(def.GPU)
+				})
+			}()
+
+			return true
+		})
+	}
 
 	actions := adw.NewPreferencesGroup()
 	actions.SetTitle(i18n.L("Access"))
@@ -751,3 +813,22 @@ 	}
 
 	a.toast(i18n.L("No terminal emulator found"))
 }
+
+func formatBytes(value int64) string {
+	const unit = 1024
+
+	if value < unit {
+		return fmt.Sprintf("%d B", value)
+	}
+
+	units := []string{"KiB", "MiB", "GiB", "TiB"}
+
+	divisor, exponent := int64(unit), 0
+
+	for value/divisor >= unit && exponent < len(units)-1 {
+		divisor *= unit
+		exponent++
+	}
+
+	return fmt.Sprintf("%.1f %s", float64(value)/float64(divisor), units[exponent])
+}
