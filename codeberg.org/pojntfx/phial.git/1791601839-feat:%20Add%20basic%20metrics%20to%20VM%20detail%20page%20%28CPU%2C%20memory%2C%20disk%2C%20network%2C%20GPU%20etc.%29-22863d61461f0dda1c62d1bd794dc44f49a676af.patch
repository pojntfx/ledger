diff --git a/internal/virt/metrics.go b/internal/virt/metrics.go
new file mode 100644
index 0000000000000000000000000000000000000000..58cf955b1444536ae12002f3cb1d754ce733f2b7
--- /dev/null
+++ b/internal/virt/metrics.go
@@ -0,0 +1,176 @@
+package virt
+
+import (
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"time"
+)
+
+type Metrics struct {
+	CPUPercent     float64 `json:"cpu_percent"`
+	MemoryUsed     int64   `json:"memory_used"`
+	MemoryTotal    int64   `json:"memory_total"`
+	DiskAllocated  int64   `json:"disk_allocated"`
+	DiskTotal      int64   `json:"disk_total"`
+	NetworkRxBytes int64   `json:"network_rx_bytes"`
+	NetworkTxBytes int64   `json:"network_tx_bytes"`
+	NetworkRxRate  float64 `json:"network_rx_rate"`
+	NetworkTxRate  float64 `json:"network_tx_rate"`
+	GPU            string  `json:"gpu"`
+	VCPUs          int     `json:"vcpus"`
+}
+
+func qemuPID(def Definition) int {
+	data, err := os.ReadFile(filepath.Join(def.runtimePath(), "qemu.pid"))
+	if err != nil {
+		return 0
+	}
+
+	pid, err := strconv.Atoi(strings.TrimSpace(string(data)))
+	if err != nil {
+		return 0
+	}
+
+	return pid
+}
+
+func processCPUTicks(pid int) (int64, error) {
+	data, err := os.ReadFile("/proc/" + strconv.Itoa(pid) + "/stat")
+	if err != nil {
+		return 0, err
+	}
+
+	fields := strings.Fields(string(data))
+	if len(fields) < 15 {
+		return 0, os.ErrInvalid
+	}
+
+	user, err := strconv.ParseInt(fields[13], 10, 64)
+	if err != nil {
+		return 0, err
+	}
+
+	system, err := strconv.ParseInt(fields[14], 10, 64)
+	if err != nil {
+		return 0, err
+	}
+
+	return user + system, nil
+}
+
+func processRSS(pid int) int64 {
+	data, err := os.ReadFile("/proc/" + strconv.Itoa(pid) + "/status")
+	if err != nil {
+		return 0
+	}
+
+	for _, line := range strings.Split(string(data), "\n") {
+		if !strings.HasPrefix(line, "VmRSS:") {
+			continue
+		}
+
+		fields := strings.Fields(line)
+		if len(fields) < 2 {
+			return 0
+		}
+
+		kb, err := strconv.ParseInt(fields[1], 10, 64)
+		if err != nil {
+			return 0
+		}
+
+		return kb * 1024
+	}
+
+	return 0
+}
+
+func CollectMetrics(def Definition) (Metrics, error) {
+	metrics := Metrics{GPU: def.GPU, VCPUs: def.VCPUs}
+
+	active, _ := def.Active()
+
+	image := def.DiskPathValue()
+	if info, err := os.Stat(image); err == nil {
+		metrics.DiskAllocated = info.Size()
+		metrics.DiskTotal = info.Size()
+	}
+
+	if size, err := parseSize(def.DiskSize); err == nil {
+		metrics.DiskTotal = size
+	}
+
+	metrics.MemoryTotal, _ = parseSize(def.Memory)
+
+	if !active {
+		return metrics, nil
+	}
+
+	pid := qemuPID(def)
+	if pid == 0 {
+		return metrics, nil
+	}
+
+	first, err := processCPUTicks(pid)
+	if err != nil {
+		return metrics, nil
+	}
+
+	rx, tx, _ := QgaNetworkBytes(def)
+
+	time.Sleep(time.Second)
+
+	second, err := processCPUTicks(pid)
+	if err != nil {
+		return metrics, nil
+	}
+
+	metrics.CPUPercent = float64(second-first) * 100 / 100
+
+	metrics.MemoryUsed = processRSS(pid)
+
+	if rx != 0 || tx != 0 {
+		metrics.NetworkRxBytes = rx
+		metrics.NetworkTxBytes = tx
+
+		nextRx, nextTx, err := QgaNetworkBytes(def)
+		if err == nil && nextRx >= rx && nextTx >= tx {
+			metrics.NetworkRxRate = float64(nextRx - rx)
+			metrics.NetworkTxRate = float64(nextTx - tx)
+		}
+	}
+
+	return metrics, nil
+}
+
+func parseSize(value string) (int64, error) {
+	if value == "" {
+		return 0, os.ErrInvalid
+	}
+
+	multiplier := int64(1)
+
+	switch value[len(value)-1] {
+	case 'K', 'k':
+		multiplier = 1024
+		value = value[:len(value)-1]
+	case 'M', 'm':
+		multiplier = 1024 * 1024
+		value = value[:len(value)-1]
+	case 'G', 'g':
+		multiplier = 1024 * 1024 * 1024
+		value = value[:len(value)-1]
+	case 'T', 't':
+		multiplier = 1024 * 1024 * 1024 * 1024
+		value = value[:len(value)-1]
+	}
+
+	number, err := strconv.ParseInt(strings.TrimSpace(value), 10, 64)
+	if err != nil {
+		return 0, err
+	}
+
+	return number * multiplier, nil
+}
diff --git a/internal/virt/qga.go b/internal/virt/qga.go
new file mode 100644
index 0000000000000000000000000000000000000000..69988dbe9ee548fd68d729ab104e9f1ac71429af
--- /dev/null
+++ b/internal/virt/qga.go
@@ -0,0 +1,88 @@
+package virt
+
+import (
+	"encoding/json"
+	"fmt"
+	"net"
+	"path/filepath"
+	"time"
+)
+
+type qgaRequest struct {
+	Execute   string      `json:"execute"`
+	Arguments interface{} `json:"arguments,omitempty"`
+}
+
+type qgaEnvelope struct {
+	Return json.RawMessage `json:"return"`
+	Error  *struct {
+		Class string `json:"class"`
+		Desc  string `json:"desc"`
+	} `json:"error"`
+}
+
+type qgaInterface struct {
+	Name       string `json:"name"`
+	Statistics struct {
+		RxBytes int64 `json:"rx-bytes"`
+		TxBytes int64 `json:"tx-bytes"`
+	} `json:"statistics"`
+	IPAddresses []interface{} `json:"ip-addresses"`
+}
+
+func QgaCall(def Definition, execute string, arguments interface{}) (json.RawMessage, error) {
+	conn, err := net.DialTimeout("unix", filepath.Join(def.runtimePath(), "qga.sock"), 5*time.Second)
+	if err != nil {
+		return nil, err
+	}
+	defer conn.Close()
+
+	_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
+
+	payload, err := json.Marshal(qgaRequest{Execute: execute, Arguments: arguments})
+	if err != nil {
+		return nil, err
+	}
+
+	if _, err := conn.Write(append(payload, '\n')); err != nil {
+		return nil, err
+	}
+
+	decoder := json.NewDecoder(conn)
+
+	var envelope qgaEnvelope
+	if err := decoder.Decode(&envelope); err != nil {
+		return nil, err
+	}
+
+	if envelope.Error != nil {
+		return nil, fmt.Errorf("%s", envelope.Error.Desc)
+	}
+
+	return envelope.Return, nil
+}
+
+func QgaNetworkBytes(def Definition) (int64, int64, error) {
+	raw, err := QgaCall(def, "guest-network-get-interfaces", nil)
+	if err != nil {
+		return 0, 0, err
+	}
+
+	var interfaces []qgaInterface
+	if err := json.Unmarshal(raw, &interfaces); err != nil {
+		return 0, 0, err
+	}
+
+	var rx, tx int64
+
+	for _, iface := range interfaces {
+		if iface.Name == "lo" {
+			continue
+		}
+
+		rx += iface.Statistics.RxBytes
+		tx += iface.Statistics.TxBytes
+	}
+
+	return rx, tx, nil
+}

