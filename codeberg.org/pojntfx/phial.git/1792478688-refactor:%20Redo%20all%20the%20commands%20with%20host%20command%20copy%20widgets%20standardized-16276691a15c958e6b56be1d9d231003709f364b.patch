diff --git a/internal/ui/clipboard.go b/internal/ui/clipboard.go
new file mode 100644
index 0000000000000000000000000000000000000000..f715ceb65ab2bd39e669c51013502f8d23dd9710
--- /dev/null
+++ b/internal/ui/clipboard.go
@@ -0,0 +1,66 @@
+package ui
+
+import (
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+)
+
+// Every control that copies a value works the same way: the button carries
+// the copy icon and a tooltip that names the value, the press copies the whole
+// value, and a toast states what was copied. A command is shown in a read-only
+// value row in the monospace font, so the dialog displays what the button
+// copies. The setup wizard keeps the full width row, because there the copy is
+// the step of the wizard rather than one value among many.
+
+// codeStyle marks the value of a row that reads as code: a command, a path, an
+// identifier, or a link. The class goes on the text widget alone, so the title
+// of the row keeps the normal font.
+func codeStyle(row *adw.EntryRow) {
+	var walk func(widget *gtk.Widget)
+	walk = func(widget *gtk.Widget) {
+		if widget == nil {
+			return
+		}
+
+		switch widget.GetCssName() {
+		case "text", "entry":
+			widget.AddCssClass("monospace")
+		}
+
+		for child := widget.GetFirstChild(); child != nil; child = child.GetNextSibling() {
+			walk(child)
+		}
+	}
+	walk(&row.Widget)
+}
+
+// valueRow states one value that the window offers to copy. The value row is
+// read-only and uses the monospace font, so it reads as something to copy
+// rather than as a setting.
+func (a *App) valueRow(title string, value string) *adw.EntryRow {
+	row := a.entryRow(title)
+	row.SetText(value)
+	row.SetEditable(false)
+	row.SetShowApplyButton(false)
+	codeStyle(row)
+
+	return row
+}
+
+// copySuffix adds the copy control that pairs with a value row.
+func (a *App) copySuffix(row *adw.EntryRow, tooltip string, copied string) {
+	copy := a.iconButton("edit-copy-symbolic", i18n.L(tooltip), func() {
+		a.copyText(row.GetText(), i18n.L(copied))
+	})
+	row.AddSuffix(&copy.Widget)
+}
+
+// commandGroup states one command with its copy control. The group title names
+// the command, and the description states what the command does.
+func (a *App) commandGroup(description string, command string, tooltip string) *adw.PreferencesGroup {
+	row := a.valueRow("Run this command", command)
+	a.copySuffix(row, tooltip, "Command copied")
+
+	return formGroup("Command", description, &row.Widget)
+}
