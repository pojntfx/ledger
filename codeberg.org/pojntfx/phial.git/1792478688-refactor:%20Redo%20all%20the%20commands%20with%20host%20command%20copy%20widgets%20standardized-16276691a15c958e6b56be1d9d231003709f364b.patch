diff --git a/internal/ui/screenshot.go b/internal/ui/screenshot.go
new file mode 100644
index 0000000000000000000000000000000000000000..36a6ce2b80929ebd806f3db1a45af51c6465f865
--- /dev/null
+++ b/internal/ui/screenshot.go
@@ -0,0 +1,146 @@
+package ui
+
+import (
+	"errors"
+	"io/fs"
+	"os"
+	"path/filepath"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+
+	"codeberg.org/pojntfx/phial-neo/internal/machine"
+	"codeberg.org/pojntfx/phial-neo/internal/state"
+)
+
+// The screenshot run in tests/ui-states.sh cannot change a machine definition,
+// so it presents the dialogs of a machine that belongs only to the pictures.
+// The machine never runs. Its name starts with phial- so that the definition
+// passes Definition.Validate.
+const screenshotMachineName = "phial-screenshots"
+
+// screenshotMachinePath states where the definition of the screenshot machine
+// lives.
+func screenshotMachinePath() string {
+	return filepath.Join(machine.ConfigDir(), "vms", screenshotMachineName+".json")
+}
+
+// screenshotMachine states the definition that the screenshots show.
+func screenshotMachine() machine.Definition {
+	def := machine.Defaults(screenshotMachineName)
+	def.VCPUs = 4
+	def.Memory = "8G"
+	def.DiskSize = "64G"
+
+	return def
+}
+
+// ensureScreenshotMachine creates the screenshot machine once. A definition
+// that the run needs for the photos outlives the process, so the run removes it
+// at its end.
+func (a *App) ensureScreenshotMachine() machine.Definition {
+	def := screenshotMachine()
+
+	if _, err := os.Stat(screenshotMachinePath()); err == nil {
+		return def
+	}
+
+	if err := def.Save(); err != nil {
+		a.Log.Warn("could not write the screenshot machine", "err", err)
+	}
+
+	return def
+}
+
+// removeScreenshotMachine removes the screenshot machine again.
+func (a *App) removeScreenshotMachine() {
+	if err := os.Remove(screenshotMachinePath()); err != nil && !errors.Is(err, fs.ErrNotExist) {
+		a.Log.Warn("could not remove the screenshot machine", "err", err)
+	}
+
+	a.refreshSidebar()
+}
+
+// screenshotTargetMachine states the machine of the open machine page. Every
+// dialog of a machine shows the same screenshot machine, so a page that shows
+// a machine of the person who runs the screenshots stays out of the pictures.
+func (a *App) screenshotTargetMachine() machine.Definition {
+	return a.ensureScreenshotMachine()
+}
+
+// screenshotConnections lists the connection dialogs as a row each, so that the
+// run reaches every dialog of a machine from the Secrets page too. The people
+// who run the screenshots find the states of the dialogs in one place.
+func (a *App) screenshotConnections() {
+	group := formGroup("Connections", "Every connection of a machine starts in the same place.")
+
+	for _, entry := range []struct {
+		title    string
+		subtitle string
+		dialog   string
+	}{
+		{"SSH", "Open a shell over vsock", "ssh"},
+		{"Serial Console", "Attach to the guest console", "serial"},
+		{"Remote Desktop", "Show the desktop of the machine", "rdp"},
+	} {
+		entry := entry
+
+		row := a.actionRow(entry.title, entry.subtitle, func() {
+			a.showScreenshotDialog(entry.dialog)
+		})
+		next := gtk.NewImageFromIconName("go-next-symbolic")
+		next.SetValign(gtk.AlignCenterValue)
+		row.AddSuffix(&next.Widget)
+
+		group.Add(&row.Widget)
+	}
+
+	a.screenshotDialogGroup("Connections", group)
+}
+
+// screenshotDialogGroup presents one group of the screenshot run in a dialog
+// that closes without an action.
+func (a *App) screenshotDialogGroup(subtitle string, group *adw.PreferencesGroup) {
+	scope := a.newScope()
+
+	content := a.formPage(group)
+	dialog := a.dialog(scope, "Screenshots", subtitle, "_Close", content, nil)
+
+	a.present(dialog, scope)
+}
+
+// screenshotDialog presents one dialog of a machine for the screenshot run.
+// The run cannot open the dialog from a machine page, so every connection
+// dialog is reachable here.
+func (a *App) showScreenshotDialog(name string) {
+	def := a.screenshotTargetMachine()
+
+	switch name {
+	case "ssh":
+		a.showTerminalDialog(def)
+	case "serial":
+		a.showSerialDialog(def)
+	case "rdp":
+		a.showRdpDialog(def)
+	case "share":
+		a.showShareTargetDialog(def, "/home/phial/shots", "/home/phial/shots")
+	case "grant":
+		a.showGrantDialog(state.KindSecret, "github")
+	case "token":
+		a.showSecretDialog("")
+	case "generate-ssh-key":
+		a.showGenerateKeyDialog("ssh")
+	case "generate-gpg-key":
+		a.showGenerateKeyDialog("gpg")
+	case "machine-settings":
+		a.showMachineSettingsDialog(def)
+	case "new-machine":
+		a.showNewMachineDialog()
+	case "guests":
+		a.showGuestAppsDialog(def)
+	case "devices":
+		a.showAddDeviceDialog(def)
+	case "hubs":
+		a.showAddHubDialog(def)
+	}
+}
