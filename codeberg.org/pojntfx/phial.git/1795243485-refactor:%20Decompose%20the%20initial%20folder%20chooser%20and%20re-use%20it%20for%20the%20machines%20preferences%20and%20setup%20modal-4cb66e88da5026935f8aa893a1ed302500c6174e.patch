diff --git a/internal/components/folder_chooser.go b/internal/components/folder_chooser.go
new file mode 100644
index 0000000000000000000000000000000000000000..c70e8973812e0865c0064d769e5eb245775e7044
--- /dev/null
+++ b/internal/components/folder_chooser.go
@@ -0,0 +1,65 @@
+package components
+
+import (
+	"log/slog"
+	"os"
+	"path/filepath"
+
+	"codeberg.org/puregotk/puregotk/v4/gio"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+)
+
+func chooseFolder(parent *gtk.Widget, log *slog.Logger, title string, initial string, onChosen func(path string)) gio.AsyncReadyCallback {
+	fileDialog := gtk.NewFileDialog()
+	fileDialog.SetTitle(title)
+
+	if folder := initialFolder(initial); folder != "" {
+		fileDialog.SetInitialFolder(gio.FileNewForPath(folder))
+	}
+
+	var onFolderChosen gio.AsyncReadyCallback
+	onFolderChosen = gio.AsyncReadyCallback(func(_ uintptr, resultPtr uintptr, _ uintptr) {
+		result := gio.AsyncResultBase{Ptr: resultPtr}
+
+		file, err := fileDialog.SelectFolderFinish(&result)
+		if err != nil {
+			log.Error("Could not choose folder", "err", err)
+
+			return
+		}
+
+		if file == nil {
+			return
+		}
+
+		onChosen(file.GetPath())
+	})
+
+	var parentWindow gtk.Window
+	parent.Cast(&parentWindow)
+
+	fileDialog.SelectFolder(&parentWindow, nil, &onFolderChosen, 0)
+
+	return onFolderChosen
+}
+
+func initialFolder(path string) string {
+	if path == "" {
+		return ""
+	}
+
+	if _, err := os.Stat(path); err == nil {
+		return path
+	}
+
+	parent := filepath.Dir(path)
+	if parent == path {
+		return ""
+	}
+
+	if _, err := os.Stat(parent); err == nil {
+		return parent
+	}
+
+	return ""
+}
