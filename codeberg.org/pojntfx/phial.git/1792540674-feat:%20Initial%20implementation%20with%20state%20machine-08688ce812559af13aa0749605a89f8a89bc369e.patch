-func (s Setup) Current() SetupPhase {
-	if s.phase == nil {
-		return s.Phase
-	}
-	value, err := s.phase.State(context.Background())
-	if err != nil {
-		return s.Phase
-	}
-	phase, ok := value.(SetupPhase)
-	if !ok {
-		return s.Phase
-	}
-	return phase
-}
