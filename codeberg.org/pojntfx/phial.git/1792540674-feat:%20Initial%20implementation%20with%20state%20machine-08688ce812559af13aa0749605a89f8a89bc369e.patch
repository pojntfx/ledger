-func (a *App) renderSetup() {
-	if a.setupDialog == nil {
-		return
-	}
-	snapshot := a.currentSnapshot()
-	setup := snapshot.Setup
-	if setup.Current() == domain.SetupDone {
-		a.finishSetupUI()
-		return
-	}
-
-	for kind, row := range a.setupFolderRows {
-		folder, ok := setup.Folders[kind]
-		if !ok {
-			row.SetSubtitle("Not selected")
-			continue
-		}
-		row.SetSubtitle(folder.HostPath)
-	}
-
-	hostCommand := setup.Command(domain.SetupHost)
-	systemCommand := setup.Command(domain.SetupSystem)
-	if label := a.setupCommandLabels[domain.SetupHost]; label != nil {
-		label.SetText(hostCommand)
-	}
-	if label := a.setupCommandLabels[domain.SetupSystem]; label != nil {
-		label.SetText(systemCommand)
-	}
-
-	hostReady := snapshot.Host.Phase == domain.HostOnline
-	canNext := setup.CanNext(hostReady)
-	if a.setupDialog != nil {
-		a.setupDialog.SetCanClose(setup.CanClose())
-	}
-	for phase, header := range a.setupHeaders {
-		header.SetShowEndTitleButtons(phase == domain.SetupWelcome || phase == domain.SetupFinish)
-	}
-	for _, button := range a.setupNextButtons {
-		button.SetSensitive(canNext)
-	}
-	if banner := a.setupBanners[setup.Current()]; banner != nil && canNext {
-		banner.SetRevealed(false)
-	}
-
-	if a.setupNavigation != nil {
-		target := string(setup.Current())
-		if a.setupNavigation.GetVisiblePageTag() != target {
-			order := map[domain.SetupPhase]int{
-				domain.SetupWelcome: 0,
-				domain.SetupFolders: 1,
-				domain.SetupHost:    2,
-				domain.SetupSystem:  3,
-				domain.SetupFinish:  4,
-			}
-			currentTag := domain.SetupPhase(a.setupNavigation.GetVisiblePageTag())
-			if order[setup.Current()] > order[currentTag] {
-				a.setupNavigation.PushByTag(target)
-			} else if !a.setupNavigation.PopToTag(target) {
-				a.setupNavigation.ReplaceWithTags([]string{target}, 1)
-			}
-		}
-	}
-}
