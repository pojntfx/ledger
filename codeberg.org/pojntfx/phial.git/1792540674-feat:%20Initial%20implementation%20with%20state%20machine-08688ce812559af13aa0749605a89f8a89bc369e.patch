-func (s *Setup) next(hostReady bool) error {
-	if !s.CanNext(hostReady) {
-		return ErrWrongPhase
-	}
-	if s.Current() == SetupFinish {
-		return s.finish()
-	}
-	if s.phase == nil {
-		return ErrInvalidTransition
-	}
-	if err := s.phase.FireCtx(context.Background(), setupNext); err != nil {
-		return err
-	}
-	s.Phase = s.Current()
-	return nil
-}
-
-func (s *Setup) back() {
-	if s.phase == nil {
-		return
-	}
-	_ = s.phase.FireCtx(context.Background(), setupBack)
-	s.Phase = s.Current()
-}
-
-func (s *Setup) finish() error {
-	if s.phase == nil {
-		return ErrInvalidTransition
-	}
-	if err := s.phase.FireCtx(context.Background(), setupFinish); err != nil {
-		return err
-	}
-	s.Phase = s.Current()
-	return nil
-}
-
-func (s *Setup) setStep(phase SetupPhase) {
-	s.Phase = phase
-	if s.phase == nil {
-		return
-	}
-	s.phase = newSetup().phase
-	for s.Current() != phase {
-		if s.Current() == SetupDone {
-			break
-		}
-		if s.Current() == SetupFinish {
-			_ = s.finish()
-			break
-		}
-		if err := s.phase.FireCtx(context.Background(), setupNext); err != nil {
-			break
-		}
-	}
-	s.Phase = s.Current()
-}
