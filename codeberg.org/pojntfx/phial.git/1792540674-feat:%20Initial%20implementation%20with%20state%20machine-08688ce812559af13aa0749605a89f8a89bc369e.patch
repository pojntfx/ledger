-<?xml version="1.0" encoding="UTF-8"?>
-<component type="desktop-application">
-  <id>com.pojtinger.felicitas.Phial</id>
-  <metadata_license>CC0-1.0</metadata_license>
-  <project_license>AGPL-3.0-or-later</project_license>
-
-  <name>Phial</name>
-  <summary>Run development machines safely</summary>
-  <description>
-    <p>Phial runs Fedora virtual machines on your desktop. Every secret and every private key stays on the host. A machine receives access to one secret or one key, for one machine, for a set time, and nothing more.</p>
-    <p>It enables you to:</p>
-    <ul>
-      <li>Create and install development machines from one window</li>
-      <li>Grant time-boxed access to tokens and link SSH keys and GnuPG keys</li>
-      <li>Review requests from a machine before you approve them</li>
-      <li>Pass USB devices, USB hubs, and shared folders to a machine</li>
-      <li>Open a remote desktop, a terminal, a serial console, or a guest application</li>
-    </ul>
-    <p>Phial does not create, import, or delete SSH keys or GnuPG keys. Manage those keys in Passwords and Keys, then link them to a machine on the Secrets page.</p>
-    <p>This build contains the complete interface and its state machines. Host actions are simulated.</p>
-  </description>
-
-  <developer id="com.pojtinger.felicitas">
-    <name translate="no">Felicitas Pojtinger</name>
-  </developer>
-
-  <content_rating type="oars-1.1" />
