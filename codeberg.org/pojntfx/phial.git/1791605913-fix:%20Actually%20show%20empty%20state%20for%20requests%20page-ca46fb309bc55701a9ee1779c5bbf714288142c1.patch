From ca46fb309bc55701a9ee1779c5bbf714288142c1 Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Fri, 09 Oct 2026 21:18:33 -0700
Subject: [PATCH] fix: Actually show empty state for requests page
---
diff --git a/internal/components/requests.go b/internal/components/requests.go
index 5713d19f6c1ccf903b3edf842453a8cc75540a49..2e65c812f87ead8ee01554376a2319ad05b4b74a 100644
--- a/internal/components/requests.go
+++ b/internal/components/requests.go
@@ -28,7 +28,7 @@
 func (a *App) refreshRequests(scrolled *gtk.ScrolledWindow) {
 	pending := a.Service.Pending()
 
-	signature := ""
+	signature := "empty"
 
 	for _, req := range pending {
 		signature += fmt.Sprintf("%s:%d;", req.ID, int64(time.Since(req.Created).Seconds())/15)
diff --git a/internal/components/window.go b/internal/components/window.go
index 496f42c84782325881ae19d75409e8fbaa3abf1f..28efb9e6ddc595da44cea03563d9df9d64dc2929 100644
--- a/internal/components/window.go
+++ b/internal/components/window.go
@@ -182,7 +182,7 @@ 			return
 		}
 		variant := (*glib.Variant)(unsafe.Pointer(parameter))
 		path := variant.GetString(nil)
-		println(a.captureWindow(path))
+		_ = a.captureWindow(path)
 	}
 	captureAction.ConnectActivate(&onCapture)
 	a.hold(&onCapture)

