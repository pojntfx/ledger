-func (s *Service) Serve(socketPath string, guest bool) error {
-	if err := os.MkdirAll(filepath.Dir(socketPath), 0o700); err != nil {
-		return err
+// vmContextKey carries the machine of one guest request.
+type vmContextKey struct{}
+
+// VMFromContext states the machine that sent one guest request, or false for
+// a request that arrived without a vsock address.
+func VMFromContext(ctx context.Context) (string, bool) {
+	vm, ok := ctx.Value(vmContextKey{}).(string)
+
+	return vm, ok && vm != ""
+}
+
+func vmForCID(cid uint32) (string, bool) {
+	definitions, err := virt.List()
+	if err != nil {
+		return "", false
 	}
 
-	if err := os.Remove(socketPath); err != nil && !errors.Is(err, os.ErrNotExist) {
-		return err
+	for _, def := range definitions {
+		if def.GuestCIDValue() == cid {
+			return def.Name, true
+		}
 	}
 
-	listener, err := net.Listen("unix", socketPath)
-	if err != nil {
-		return err
-	}
+	return "", false
+}
 
+func (s *Service) serve(listener net.Listener, guest bool, stampVM bool) error {
 	server := mcpgo.NewServer(
 		&mcpgo.Implementation{
 			Name:        "phial",
@@ -77,13 +97,48 @@ 		},
 		nil,
 	)
 
-	s.log.Info("serving MCP", "socket", socketPath, "guest", guest)
+	s.log.Info("serving MCP", "listener", listener.Addr().String(), "guest", guest)
+
+	daemon := &http.Server{Handler: handler}
 
-	return http.Serve(listener, handler)
+	if stampVM {
+		daemon.ConnContext = func(ctx context.Context, conn net.Conn) context.Context {
+			addr, ok := conn.RemoteAddr().(*vsock.Addr)
+			if !ok || addr == nil {
+				return ctx
+			}
+
+			vm, ok := vmForCID(addr.ContextID)
+			if !ok {
+				return ctx
+			}
+
+			return context.WithValue(ctx, vmContextKey{}, vm)
+		}
+	}
+
+	return daemon.Serve(listener)
+}
+
+func (s *Service) Serve(socketPath string, guest bool) error {
+	if err := os.MkdirAll(filepath.Dir(socketPath), 0o700); err != nil {
+		return err
+	}
+
+	if err := os.Remove(socketPath); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+
+	listener, err := net.Listen("unix", socketPath)
+	if err != nil {
+		return err
+	}
+
+	return s.serve(listener, guest, false)
 }
 
 func (s *Service) Run(runtimeDir string) error {
-	errChan := make(chan error, 2)
+	errChan := make(chan error, 3)
 
 	go func() {
 		errChan <- s.Serve(filepath.Join(runtimeDir, "phial", HostSocketName), false)
@@ -91,6 +146,17 @@ 	}()
 
 	go func() {
 		errChan <- s.Serve(filepath.Join(runtimeDir, "phial", GuestSocketName), true)
+	}()
+
+	go func() {
+		listener, err := vsock.Listen(GuestVsockPort, nil)
+		if err != nil {
+			errChan <- err
+
+			return
+		}
+
+		errChan <- s.serve(listener, true, true)
 	}()
 
 	select {
