diff --git a/internal/ui/setup.go b/internal/ui/setup.go
new file mode 100644
index 0000000000000000000000000000000000000000..3a8c9d184b9401b0ae7775c5cd5b91ac2a1e5311
--- /dev/null
+++ b/internal/ui/setup.go
@@ -0,0 +1,532 @@
+package ui
+
+import (
+	"os"
+	"strings"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gdk"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	"codeberg.org/puregotk/puregotk/v4/pango"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+
+	"codeberg.org/pojntfx/phial-neo/assets/resources"
+	"codeberg.org/pojntfx/phial-neo/internal/paths"
+	"codeberg.org/pojntfx/phial-neo/internal/setup"
+)
+
+const (
+	wizardWelcomeTag = "welcome"
+	wizardFoldersTag = "folders"
+	wizardHostTag    = "host"
+	wizardSystemTag  = "system"
+	wizardFinishTag  = "finish"
+)
+
+// setupStep is one page of the setup wizard. A step carries either a folder
+// form that the window can check, or a host command that the user copies and
+// runs in a terminal.
+type setupStep struct {
+	app *App
+
+	tag      string
+	nextTag  string
+	title    string
+	subtitle string
+
+	navigation *adw.NavigationView
+	page       *adw.NavigationPage
+
+	banner    *adw.Banner
+	actionRow *adw.ButtonRow
+	next      *gtk.Button
+
+	command      string
+	commandFunc  func() string
+	commandLabel *gtk.Label
+
+	validate func() bool
+	refresh  func()
+	apply    func() bool
+
+	copied bool
+	ready  bool
+}
+
+// showSetupDialog presents the setup wizard over the window. The first run
+// opens it, and the preferences can open it again.
+func (a *App) showSetupDialog(firstRun bool) {
+	a.showSetupDialogAt(firstRun, wizardWelcomeTag)
+}
+
+// showSetupDialogAt presents the wizard and opens one of its steps.
+func (a *App) showSetupDialogAt(firstRun bool, tag string) {
+	if a.win == nil {
+		return
+	}
+
+	a.win.Present()
+
+	if a.setupDialog != nil {
+		a.setupDialog.Present(&a.win.Widget)
+
+		if a.setupNavigation != nil && a.setupNavigation.GetVisiblePageTag() != tag {
+			a.setupNavigation.PushByTag(tag)
+		}
+
+		return
+	}
+
+	set := a.loadLocations()
+
+	// The runtime folder belongs to this process, so the wizard creates it
+	// without asking the user.
+	if err := os.MkdirAll(set.Runtime.AccessPath(), 0o700); err != nil {
+		a.Log.Warn("could not create the runtime folder", "err", err)
+	}
+
+	form := a.newLocationForm(set)
+	form.live = false
+
+	a.locationForm = form
+
+	navigation := adw.NewNavigationView()
+	navigation.SetPopOnEscape(true)
+	a.setupNavigation = navigation
+
+	foldersStep := a.buildFoldersStep(form, navigation)
+	hostStep := a.buildHostStep(navigation)
+	systemStep := a.buildSystemStep(navigation)
+
+	a.setupSteps = map[string]*setupStep{
+		wizardFoldersTag: foldersStep,
+		wizardHostTag:    hostStep,
+		wizardSystemTag:  systemStep,
+	}
+
+	navigation.Add(a.buildWelcomeStep(navigation))
+	navigation.Add(foldersStep.page)
+	navigation.Add(hostStep.page)
+	navigation.Add(systemStep.page)
+	navigation.Add(a.buildFinishStep())
+
+	width := int32(a.win.GetWidth())
+	if width <= 0 {
+		width = a.Settings.GetInt(resources.SettingWindowWidthKey)
+	}
+
+	height := int32(a.win.GetHeight())
+	if height <= 0 {
+		height = a.Settings.GetInt(resources.SettingWindowHeightKey)
+	}
+
+	contentWidth := int32(720)
+	if width > 0 && width-96 < contentWidth {
+		contentWidth = width - 96
+	}
+	if contentWidth < 280 {
+		contentWidth = 280
+	}
+
+	contentHeight := int32(640)
+	if height > 0 && height-96 < contentHeight {
+		contentHeight = height - 96
+	}
+	if contentHeight < 360 {
+		contentHeight = 360
+	}
+
+	dialog := adw.NewDialog()
+	dialog.SetTitle(i18n.L("Set Up Phial"))
+	dialog.SetContentWidth(contentWidth)
+	dialog.SetContentHeight(contentHeight)
+	dialog.SetCanClose(!firstRun)
+	overlay := adw.NewToastOverlay()
+	overlay.SetChild(&navigation.Widget)
+	a.setupToasts = overlay
+
+	dialog.SetChild(&overlay.Widget)
+
+	var onClosed func(adw.Dialog)
+	onClosed = func(adw.Dialog) {
+		a.setupDialog = nil
+		a.setupNavigation = nil
+		a.setupSteps = nil
+		a.setupToasts = nil
+		a.locationForm = nil
+	}
+	dialog.ConnectClosed(&onClosed)
+	a.hold(&onClosed)
+
+	a.setupDialog = dialog
+
+	if tag != wizardWelcomeTag {
+		navigation.PushByTag(tag)
+	}
+
+	dialog.Present(&a.win.Widget)
+}
+
+// wizardPage builds one step of the setup wizard.
+func (a *App) wizardPage(tag string, title string, subtitle string, content *gtk.Widget) (*adw.NavigationPage, *adw.HeaderBar) {
+	header := adw.NewHeaderBar()
+	header.SetShowEndTitleButtons(false)
+	windowTitle := adw.NewWindowTitle(i18n.L(title), i18n.L(subtitle))
+	header.SetTitleWidget(&windowTitle.Widget)
+
+	toolbar := adw.NewToolbarView()
+	toolbar.AddTopBar(&header.Widget)
+	toolbar.SetContent(content)
+
+	page := adw.NewNavigationPage(&toolbar.Widget, i18n.L(title))
+	page.SetTag(tag)
+
+	return page, header
+}
+
+// buildSetupPage builds the page of one step with its action row and its
+// continue control.
+func (a *App) buildSetupPage(step *setupStep, groups ...*adw.PreferencesGroup) *adw.NavigationPage {
+	step.banner = adw.NewBanner("")
+	step.banner.SetRevealed(false)
+
+	content := append([]*adw.PreferencesGroup{}, groups...)
+
+	if step.validate != nil {
+		step.actionRow = a.buttonRow("_Check Again", "view-refresh-symbolic", func() {
+			if step.refresh != nil {
+				step.refresh()
+			}
+
+			step.update()
+		})
+	} else {
+		step.actionRow = a.buttonRow("_Copy Command", "edit-copy-symbolic", func() {
+			step.copyCommand()
+		})
+	}
+
+	if len(content) > 0 {
+		content[len(content)-1].Add(&step.actionRow.Widget)
+	}
+
+	page, header := a.wizardPage(step.tag, step.title, step.subtitle, a.pageContentWithBanner(step.banner, content...))
+	step.page = page
+
+	step.next = a.labelButton("_Continue", func() { step.advance() })
+	step.next.AddCssClass("suggested-action")
+	header.PackEnd(&step.next.Widget)
+
+	step.update()
+
+	var onShown func(adw.NavigationPage)
+	onShown = func(adw.NavigationPage) {
+		if step.commandFunc != nil {
+			step.refreshCommand()
+		}
+
+		step.update()
+	}
+	page.ConnectShown(&onShown)
+	a.hold(&onShown)
+
+	return page
+}
+
+// buildWelcomeStep builds the splash step with the call to action.
+func (a *App) buildWelcomeStep(navigation *adw.NavigationView) *adw.NavigationPage {
+	status := adw.NewStatusPage()
+	status.SetTitle(i18n.L("Welcome to Phial"))
+	status.SetDescription(i18n.L("Run machines that see only the secrets you grant them"))
+
+	if icon := gdk.NewTextureFromResource(resources.ResourceIconPath); icon != nil {
+		status.SetPaintable(icon)
+	} else {
+		status.SetIconName("drive-harddisk-symbolic")
+	}
+
+	start := a.labelButton("_Get Started", func() {
+		navigation.PushByTag(wizardFoldersTag)
+	})
+	start.AddCssClass("suggested-action")
+	start.AddCssClass("pill")
+	start.SetHalign(gtk.AlignCenterValue)
+	status.SetChild(&start.Widget)
+
+	page, _ := a.wizardPage(wizardWelcomeTag, "Welcome", "", &status.Widget)
+
+	return page
+}
+
+// buildFoldersStep builds the step that chooses the folders. The rows of the
+// form carry the state of every folder, so the step can check itself.
+func (a *App) buildFoldersStep(form *locationForm, navigation *adw.NavigationView) *setupStep {
+	step := &setupStep{
+		app:        a,
+		tag:        wizardFoldersTag,
+		nextTag:    wizardHostTag,
+		title:      i18n.L("Folders"),
+		subtitle:   i18n.L("Step 1 of 3"),
+		navigation: navigation,
+		validate:   form.valid,
+		refresh:    form.refresh,
+		apply:      form.apply,
+	}
+
+	step.page = a.buildSetupPage(step, form.foldersGroup)
+
+	form.banner = step.banner
+	form.onChanged = func() { step.update() }
+	form.refresh()
+
+	return step
+}
+
+// buildHostStep builds the step that installs the host service.
+func (a *App) buildHostStep(navigation *adw.NavigationView) *setupStep {
+	step := &setupStep{
+		app:         a,
+		tag:         wizardHostTag,
+		nextTag:     wizardSystemTag,
+		title:       i18n.L("Host Services"),
+		subtitle:    i18n.L("Step 2 of 3"),
+		navigation:  navigation,
+		commandFunc: a.installCommand,
+	}
+
+	group := a.setupCommandGroup(
+		step,
+		"Run this command in a terminal. It installs the command and the services that run your machines.",
+	)
+
+	step.page = a.buildSetupPage(step, group)
+
+	return step
+}
+
+// buildSystemStep builds the step that prepares the host.
+func (a *App) buildSystemStep(navigation *adw.NavigationView) *setupStep {
+	step := &setupStep{
+		app:         a,
+		tag:         wizardSystemTag,
+		nextTag:     wizardFinishTag,
+		title:       i18n.L("System Setup"),
+		subtitle:    i18n.L("Step 3 of 3"),
+		navigation:  navigation,
+		commandFunc: a.rootSetupCommand,
+	}
+
+	group := a.setupCommandGroup(
+		step,
+		"Run this command in a terminal. It reserves huge pages and adds the rules for USB devices. It needs your password.",
+	)
+
+	step.page = a.buildSetupPage(step, group)
+
+	return step
+}
+
+// buildFinishStep builds the last step with the finished feeling of the wizard.
+func (a *App) buildFinishStep() *adw.NavigationPage {
+	status := adw.NewStatusPage()
+	status.SetIconName("object-select-symbolic")
+	status.SetTitle(i18n.L("You're Ready"))
+	status.SetDescription(i18n.L("Now make a machine your own"))
+
+	finish := a.labelButton("_Finish", func() { a.finishSetupDialog() })
+	finish.AddCssClass("suggested-action")
+	finish.AddCssClass("pill")
+	finish.SetHalign(gtk.AlignCenterValue)
+	status.SetChild(&finish.Widget)
+
+	page, _ := a.wizardPage(wizardFinishTag, i18n.L("Done"), "", &status.Widget)
+
+	return page
+}
+
+// setupCommandGroup builds the group that carries one command and its copy
+// control. The control marks the step as read, so the step can trust a copy
+// that the window cannot check.
+func (a *App) setupCommandGroup(step *setupStep, description string) *adw.PreferencesGroup {
+	group := adw.NewPreferencesGroup()
+	group.SetTitle(i18n.L("Command"))
+	group.SetDescription(i18n.L(description))
+
+	box := gtk.NewBox(gtk.OrientationHorizontalValue, 6)
+	box.SetMarginTop(12)
+	box.SetMarginBottom(12)
+	box.SetMarginStart(12)
+	box.SetMarginEnd(6)
+
+	step.command = a.currentCommand(step)
+	step.commandLabel = gtk.NewLabel(step.command)
+	step.commandLabel.AddCssClass("monospace")
+	step.commandLabel.SetWrap(true)
+	step.commandLabel.SetWrapMode(pango.WrapWordCharValue)
+	step.commandLabel.SetXalign(0)
+	step.commandLabel.SetHexpand(true)
+
+	box.Append(&step.commandLabel.Widget)
+
+	row := gtk.NewListBoxRow()
+	row.SetActivatable(false)
+	row.SetSelectable(false)
+	row.SetChild(&box.Widget)
+
+	group.Add(&row.Widget)
+
+	return group
+}
+
+// currentCommand states the command of a step from its source.
+func (a *App) currentCommand(step *setupStep) string {
+	if step.commandFunc == nil {
+		return step.command
+	}
+
+	return step.commandFunc()
+}
+
+// refreshCommand updates the command of a step, so that the folders of the
+// folder step reach the commands of the steps that follow it.
+func (s *setupStep) refreshCommand() {
+	s.command = s.app.currentCommand(s)
+
+	if s.commandLabel != nil {
+		s.commandLabel.SetText(s.command)
+	}
+}
+
+// installCommand states the command that installs the host service. The
+// command carries the chosen folders, because the host process cannot read the
+// settings of the sandbox.
+func (a *App) installCommand() string {
+	binary := "phial"
+
+	if !paths.Sandboxed() {
+		if self, err := os.Executable(); err == nil {
+			binary = shellQuote(self)
+		}
+	}
+
+	set := paths.Current()
+
+	return strings.Join([]string{
+		binary, "install", "--embedded",
+		"--config", shellQuote(set.Config.HostPath()),
+		"--data", shellQuote(set.Data.HostPath()),
+		"--ssh", shellQuote(set.SSH.HostPath()),
+	}, " ")
+}
+
+// rootSetupCommand states the command that prepares the host. It names the
+// installed command, because the host does not reach the folder of the user.
+func (a *App) rootSetupCommand() string {
+	binary := setup.HostCLI()
+	if binary == "" {
+		binary = "phial"
+	}
+
+	return "run0 " + shellQuote(binary) + " root-setup"
+}
+
+// copyCommand copies the command and marks the step as read. The window cannot
+// read the host state from the sandbox, so the step trusts the copy.
+func (s *setupStep) copyCommand() {
+	if s.command == "" {
+		return
+	}
+
+	s.app.copyText(s.command, "")
+
+	if s.app.setupToasts != nil {
+		toast := adw.NewToast(i18n.L("Command copied"))
+		toast.SetTimeout(4)
+		s.app.setupToasts.AddToast(toast)
+	}
+
+	s.copied = true
+
+	if s.actionRow != nil {
+		s.actionRow.SetTitle(i18n.L("Command Copied"))
+		s.actionRow.SetStartIconName("object-select-symbolic")
+	}
+
+	s.update()
+}
+
+// update states whether the step is done and enables the continue control.
+func (s *setupStep) update() {
+	if s.validate != nil {
+		s.ready = s.validate()
+	} else {
+		s.ready = s.copied
+	}
+
+	s.next.SetSensitive(s.ready)
+}
+
+// advance validates the step again and opens the next one. A step that is not
+// done never opens the next one.
+func (s *setupStep) advance() {
+	s.update()
+
+	if !s.ready {
+		if s.validate != nil {
+			s.banner.SetTitle(i18n.L("Finish this step before you continue"))
+		} else {
+			s.banner.SetTitle(i18n.L("Copy the command before you continue"))
+		}
+
+		s.banner.SetRevealed(true)
+
+		return
+	}
+
+	if s.apply != nil && !s.apply() {
+		return
+	}
+
+	s.banner.SetRevealed(false)
+	s.navigation.PushByTag(s.nextTag)
+}
+
+// shellQuote wraps a value so that a shell reads it as one word.
+func shellQuote(value string) string {
+	if value == "" {
+		return "''"
+	}
+
+	if !strings.ContainsAny(value, " \t\n'\"\\$\x60!&|;<>()[]{}*?~#") {
+		return value
+	}
+
+	return "'" + strings.ReplaceAll(value, "'", "'\\''") + "'"
+}
+
+// finishSetupDialog closes the wizard and refreshes the window.
+func (a *App) finishSetupDialog() {
+	if a.locationForm != nil && a.locationForm.valid() {
+		if err := a.saveLocations(a.locationForm.set); err != nil {
+			a.Log.Warn("could not save the folders of the setup", "err", err)
+		}
+	}
+
+	a.locationForm = nil
+	a.setupNavigation = nil
+	a.setupSteps = nil
+	a.setupToasts = nil
+
+	if a.setupDialog != nil {
+		a.setupDialog.ForceClose()
+		a.setupDialog = nil
+	}
+
+	a.refreshSidebar()
+	a.refreshSecretsPage()
+	a.refreshGrantsPage()
+	a.refreshCounts()
+	a.restoreActivePage()
+
+	a.win.Present()
+}
