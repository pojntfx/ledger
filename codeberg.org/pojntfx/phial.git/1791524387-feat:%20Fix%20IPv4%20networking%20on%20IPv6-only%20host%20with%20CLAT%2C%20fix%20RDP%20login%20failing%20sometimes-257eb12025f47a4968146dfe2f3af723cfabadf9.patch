From 257eb12025f47a4968146dfe2f3af723cfabadf9 Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Thu, 08 Oct 2026 22:39:47 -0700
Subject: [PATCH] feat: Fix IPv4 networking on IPv6-only host with CLAT, fix RDP login failing sometimes
---
diff --git a/host/systemd/phial-passt@.service b/host/systemd/phial-passt@.service
new file mode 100644
index 0000000000000000000000000000000000000000..4d51723cfe87ed3db6eacb55155298412be4be9c
--- /dev/null
+++ b/host/systemd/phial-passt@.service
@@ -0,0 +1,13 @@
+[Unit]
+Description=phial passt network backend %i
+After=network-online.target
+
+[Service]
+Type=simple
+ExecStartPre=mkdir -p %t/phial/vms/%i
+ExecStartPre=rm -f %t/phial/vms/%i/passt.sock
+ExecStart=@PASST@ --foreground --socket %t/phial/vms/%i/passt.sock --address 192.168.100.2 --netmask 24 --gateway 192.168.100.1 --dns 192.168.100.1 --dns-forward 192.168.100.1 --mtu 1472 --quiet
+Restart=on-failure
+
+[Install]
+WantedBy=default.target
diff --git a/internal/guest/files/systemd-system/phial-network.service b/internal/guest/files/systemd-system/phial-network.service
