+		"gsettings set org.gnome.desktop.screensaver idle-activation-enabled false 2>/dev/null || true",
+		"gsettings set org.gnome.desktop.session idle-delay 0 2>/dev/null || true",
+		"gsettings set org.gnome.shell enabled-extensions \"[]\" 2>/dev/null || true",
+		"sudo systemctl disable NetworkManager-wait-online.service 2>/dev/null || true",
+		"sudo systemctl daemon-reload",
+		"sudo systemctl enable --now phial-network.service 2>/dev/null || true",
 	)
 
 	return run(def.Name, strings.Join(steps, "\n"))
 }
 
+func installNetworkScript(mac string) string {
+	return writeSystemFile("/usr/local/libexec/phial-network.sh", fallbackMetricScript(mac), "0755")
+}
+
+func writeSystemFile(dest string, content string, mode string) string {
+	encoded := base64.StdEncoding.EncodeToString([]byte(content))
+
+	return fmt.Sprintf("sudo mkdir -p \"$(dirname %s)\" && printf '%%s' '%s' | base64 -d | sudo tee %s > /dev/null && sudo chmod %s %s", dest, encoded, dest, mode, dest)
+}
+
 func rdpScript(name string, password string) string {
 	key := "/etc/gnome-remote-desktop/rdp-tls.key"
 	cert := "/etc/gnome-remote-desktop/rdp-tls.crt"
@@ -109,8 +133,8 @@ 		"sudo systemctl enable gnome-remote-desktop > /dev/null 2>&1 || true",
 		"sudo systemctl restart gnome-remote-desktop > /dev/null 2>&1 || true",
 		"echo \"phial:" + password + "\" | sudo chpasswd || { echo \"phial: could not set the guest password, pwquality rejects it\" >&2; exit 1; }",
 		"sudo passwd -u " + name + " > /dev/null 2>&1 || true",
-		"sudo crudini --set /etc/gdm/custom.conf daemon AutomaticLoginEnable true",
-		"sudo crudini --set /etc/gdm/custom.conf daemon AutomaticLogin " + name,
+		"sudo crudini --del /etc/gdm/custom.conf daemon AutomaticLogin > /dev/null 2>&1 || true",
+		"sudo crudini --set /etc/gdm/custom.conf daemon AutomaticLoginEnable false",
 		"sudo loginctl enable-linger " + name + " || true",
 		"mkdir -p ~/.config/environment.d",
 		"printf 'XDG_SESSION_TYPE=wayland\\n' > ~/.config/environment.d/wayland.conf",
@@ -128,7 +152,54 @@ 	return fmt.Sprintf("mkdir -p \"$HOME/%s\" && printf '%%s' '%s' | base64 -d > \"$HOME/%s\" && chmod 0755 \"$HOME/%s\"", path.Dir(dest), content, dest, dest)
 }
 
 func fallbackMetricScript(mac string) string {
-	return fmt.Sprintf("for dev in $(nmcli -t -f DEVICE,TYPE device | awk -F: '$2 == \"ethernet\" {print $1}'); do\n  hw=$(nmcli -g GENERAL.HWADDR device show \"$dev\" | sed 's/\\\\//g')\n  if [ \"$(echo \"$hw\" | tr 'A-F' 'a-f')\" = \"%s\" ]; then\n    con=$(nmcli -g GENERAL.CONNECTION device show \"$dev\" | sed 's/\\\\//g')\n    sudo nmcli connection modify \"$con\" ipv4.route-metric 1000 ipv6.route-metric 1000 || true\n  fi\ndone", mac)
+	return fmt.Sprintf(`#!/bin/bash
+
+set -u
+
+for dev in $(nmcli -t -f DEVICE,TYPE device | awk -F: '$2 == "ethernet" {print $1}'); do
+  hw=$(nmcli -g GENERAL.HWADDR device show "$dev" | sed 's/\\//g')
+
+  if [ "$(echo "$hw" | tr 'A-F' 'a-f')" != "%s" ]; then
+    continue
+  fi
+
+  con=$(nmcli -g GENERAL.CONNECTION device show "$dev" | sed 's/\\//g')
+
+  if [ -z "$con" ] || [ "$con" = "--" ]; then
+    sudo nmcli connection add type ethernet ifname "$dev" con-name phial-fallback connection.autoconnect yes ipv4.method auto ipv6.method auto > /dev/null || true
+
+    con=phial-fallback
+  fi
+
+  sudo nmcli connection modify "$con" connection.autoconnect yes ipv6.route-metric 1000 ipv4.route-metric 2000 || true
+  sudo nmcli connection up "$con" || true
+
+  addr=$(ip -6 addr show dev "$dev" scope global 2>/dev/null | awk '/inet6/ {print $2; exit}' | cut -d/ -f1)
+  gw=""
+
+  if [ -n "$addr" ]; then
+    gw="$(echo "$addr" | sed 's/::.*/::/')1"
+  fi
+
+  if [ -n "$gw" ]; then
+    sudo nmcli connection modify "$con" ipv6.dns "$gw" ipv6.ignore-auto-dns yes ipv4.ignore-auto-dns yes || true
+    sudo nmcli connection up "$con" || true
+  fi
+done
+
+for dev in $(nmcli -t -f DEVICE,TYPE device | awk -F: '$2 == "ethernet" {print $1}'); do
+  hw=$(nmcli -g GENERAL.HWADDR device show "$dev" | sed 's/\\//g')
+
+  if [ "$(echo "$hw" | tr 'A-F' 'a-f')" = "%s" ]; then
+    continue
+  fi
+
+  con=$(nmcli -g GENERAL.CONNECTION device show "$dev" | sed 's/\\//g')
+
+  if [ -n "$con" ] && [ "$con" != "--" ]; then
+    sudo nmcli connection modify "$con" ipv6.route-metric 100 ipv4.route-metric 200 || true
+  fi
+done`, mac, mac)
 }
 
