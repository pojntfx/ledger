 func (p *MachinePage) Refresh(info state.MachineInfo) {
+	p.machineName = info.Name
+	p.info = info
+
+	status := machineStatusText(info.Status)
+
 	p.machineTitle.SetTitle(info.Name)
-	p.machineTitle.SetSubtitle(L("Not installed"))
+	p.machineTitle.SetSubtitle(status)
 
-	p.overviewStateRow.SetSubtitle(L("Not installed"))
+	p.overviewStateRow.SetSubtitle(status)
 	p.storageDiskRow.SetSubtitle(filepath.Join(p.machinesFolder, info.Name, "disk.qcow2"))
+
+	installable := info.Status == state.MachineStatusNotInstalled || info.Status == state.MachineStatusInstallFailed
+	p.installButton.SetVisible(installable)
+	p.installButton.SetSensitive(installable)
+
+	installing := info.Status == state.MachineStatusInstalling
+	p.installGroup.SetVisible(installing || info.Status == state.MachineStatusInstallFailed)
+	p.installActionsGroup.SetVisible(installing)
+
+	p.refreshInstallSteps()
+}
+
+func (p *MachinePage) buildInstallSteps() {
+	p.installStepModel = gio.NewListStore(gTypeInstallStepItem)
+	for index, step := range state.InstallSteps {
+		appendInstallStepItem(p.installStepModel, newInstallStepItem(step, index))
+	}
+
+	createRow := gtk.ListBoxCreateWidgetFunc(p.createInstallStepRow)
+	p.callbacks = append(p.callbacks, &createRow)
+
+	var destroyModel glib.DestroyNotify = func(uintptr) {}
+	p.callbacks = append(p.callbacks, &destroyModel)
+
+	p.installGroup.BindModel(p.installStepModel, &createRow, 0, &destroyModel)
+}
+
+func (p *MachinePage) createInstallStepRow(itemPtr, _ uintptr) uintptr {
+	obj := gobject.ObjectNewFromInternalPtr(itemPtr)
+	item := (*installStepItem)(unsafe.Pointer(obj.GetData(dataKeyGoInstance)))
+
+	row := adw.NewActionRow()
+	row.SetTitle(installStepText(item.step))
+
+	icon := gtk.NewImageFromIconName("object-select-symbolic")
+	icon.SetVisible(false)
+	row.AddPrefix(&icon.Widget)
+
+	spinner := adw.NewSpinner()
+	spinner.SetVisible(false)
+	row.AddPrefix(&spinner.Widget)
+
+	item.row = row
+	item.icon = icon
+	item.spinner = spinner
+
+	p.applyInstallStepState(item)
+
+	return row.GoPointer()
+}
+
+func (p *MachinePage) applyInstallStepState(item *installStepItem) {
+	row := item.row
+	if row == nil {
+		return
+	}
+
+	icon := item.icon
+	spinner := item.spinner
+
+	installing := p.info.Status == state.MachineStatusInstalling
+	failed := p.info.Status == state.MachineStatusInstallFailed
+	current := installStepIndex(p.info.InstallStep)
+
+	icon.SetVisible(false)
+	spinner.SetVisible(false)
+	row.SetSubtitle("")
+	row.RemoveCssClass("dim-label")
+	row.RemoveCssClass("phial-step-failed")
+
+	switch {
+	case item.index < current:
+		icon.SetFromIconName("object-select-symbolic")
+		icon.SetVisible(true)
+	case item.index == current && installing:
+		spinner.SetVisible(true)
+		row.SetSubtitle(installStepDetail(p.info.InstallStep, p.info.InstallProgress))
+	case item.index == current && failed:
+		icon.SetFromIconName("dialog-error-symbolic")
+		icon.SetVisible(true)
+		row.AddCssClass("phial-step-failed")
+		row.SetSubtitle(L("The installation failed"))
+	default:
+		row.AddCssClass("dim-label")
+	}
+}
+
+func (p *MachinePage) refreshInstallSteps() {
+	for pos := uint32(0); pos < p.installStepModel.GetNItems(); pos++ {
+		obj := gobject.ObjectNewFromInternalPtr(p.installStepModel.GetItem(pos))
+		item := (*installStepItem)(unsafe.Pointer(obj.GetData(dataKeyGoInstance)))
+
+		p.applyInstallStepState(item)
+	}
+}
+
+func installStepDetail(step state.InstallStep, progress state.InstallProgress) string {
+	switch step {
+	case state.InstallStepDownloading:
+		if progress.Total > 0 {
+			return fmt.Sprintf(
+				L("%v of %v, %d%%"),
+				formatBytes(progress.Downloaded),
+				formatBytes(progress.Total),
+				int(float64(progress.Downloaded)*100/float64(progress.Total)),
+			)
+		}
+
+		return L("Waiting for the first bytes")
+	case state.InstallStepStarting:
+		return L("The installer virtual machine starts")
+	case state.InstallStepPreInstall:
+		return L("The installer reads the kickstart file")
+	case state.InstallStepPackages:
+		if progress.PackagesTotal > 0 {
+			detail := fmt.Sprintf(L("%d of %d packages"), progress.Packages, progress.PackagesTotal)
+			if progress.PackageName != "" {
+				detail = progress.PackageName + ", " + detail
+			}
+
+			return detail
+		}
+
+		return L("The installer solves the package list")
+	case state.InstallStepPostInstall:
+		return L("The installer runs the post-install scripts")
+	case state.InstallStepConfiguring:
+		return L("The installer configures the system")
+	case state.InstallStepFinishing:
+		return L("The installer finishes and restarts the machine")
+	default:
+		return ""
+	}
+}
+
+func formatBytes(bytes uint64) string {
+	value, unit, ok := strings.Cut(humanize.IBytes(bytes), " ")
+	if !ok {
+		return humanize.IBytes(bytes)
+	}
+
+	switch unit {
+	case "B":
+		unit = L("B")
+	case "KiB":
+		unit = L("KiB")
+	case "MiB":
+		unit = L("MiB")
+	case "GiB":
+		unit = L("GiB")
+	case "TiB":
+		unit = L("TiB")
+	case "PiB":
+		unit = L("PiB")
+	case "EiB":
+		unit = L("EiB")
+	}
+
+	return value + " " + unit
+}
+
+func machineStatusText(status state.MachineStatus) string {
+	switch status {
+	case state.MachineStatusInstalling:
+		return L("Installing")
+	case state.MachineStatusInstallFailed:
+		return L("Installation failed")
+	case state.MachineStatusStopped:
+		return L("Stopped")
+	case state.MachineStatusStarting:
+		return L("Starting")
+	case state.MachineStatusRunning:
+		return L("Running")
+	case state.MachineStatusStopping:
+		return L("Stopping")
+	case state.MachineStatusRestarting:
+		return L("Restarting")
+	case state.MachineStatusUpdatingAgent:
+		return L("Updating the guest agent")
+	default:
+		return L("Not installed")
+	}
+}
+
+func installStepText(step state.InstallStep) string {
+	switch step {
+	case state.InstallStepDownloading:
+		return L("Downloading the installer")
+	case state.InstallStepStarting:
+		return L("Starting the installer")
+	case state.InstallStepPreInstall:
+		return L("Running pre-installation scripts")
+	case state.InstallStepPackages:
+		return L("Installing packages")
+	case state.InstallStepPostInstall:
+		return L("Running post-installation scripts")
+	case state.InstallStepConfiguring:
+		return L("Configuring the system")
+	case state.InstallStepFinishing:
+		return L("Finishing the installation")
+	default:
+		return ""
+	}
+}
+
+func installStepIndex(step state.InstallStep) int {
+	for index, current := range state.InstallSteps {
+		if current == step {
+			return index
+		}
+	}
+
+	return -1
+}
+
+func init() {
+	var classInit gobject.ClassInitFunc = func(tc *gobject.TypeClass, u uintptr) {
+		objClass := (*gobject.ObjectClass)(unsafe.Pointer(tc))
+
+		objClass.OverrideConstructed(func(o *gobject.Object) {
+			parentObjClass := (*gobject.ObjectClass)(unsafe.Pointer(tc.PeekParent()))
+			parentObjClass.GetConstructed()(o)
+
+			var parent gobject.Object
+			o.Cast(&parent)
+
+			item := &installStepItem{
+				Object: parent,
+			}
+
+			var pinner runtime.Pinner
+			pinner.Pin(item)
+
+			var cleanupCallback glib.DestroyNotify = func(data uintptr) {
+				pinner.Unpin()
+			}
+			o.SetDataFull(dataKeyGoInstance, uintptr(unsafe.Pointer(item)), &cleanupCallback)
+		})
+	}
+
+	var instanceInit gobject.InstanceInitFunc = func(ti *gobject.TypeInstance, tc *gobject.TypeClass) {}
+
+	var parentQuery gobject.TypeQuery
+	gobject.NewTypeQuery(gobject.TypeObjectVal, &parentQuery)
+
+	gTypeInstallStepItem = gobject.TypeRegisterStaticSimple(
+		parentQuery.Type,
+		"PhialInstallStepItem",
+		parentQuery.ClassSize,
+		&classInit,
+		parentQuery.InstanceSize,
+		&instanceInit,
+		0,
+	)
 }
 
