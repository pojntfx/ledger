+func (w *MainWindow) confirmCancelInstall(name string) {
+	dialog := adw.NewAlertDialog(
+		L("Cancel the Installation?"),
+		L("This stops the installer and removes the partial disk."),
+	)
+	dialog.AddResponse("keep", L("_Keep Installing"))
+	dialog.AddResponse("cancel", L("_Cancel Installation"))
+	dialog.SetResponseAppearance("cancel", adw.ResponseDestructiveValue)
+	dialog.SetCloseResponse("keep")
+
+	var onResponse func(adw.AlertDialog, string)
+	onResponse = func(_ adw.AlertDialog, response string) {
+		if response != "cancel" {
+			return
+		}
+
+		if err := w.store.InstallCancel(w.ctx, name); err != nil {
+			w.log.Error("Could not cancel installation", "err", err)
+		}
+	}
+	w.callbacks = append(w.callbacks, &onResponse)
+	dialog.ConnectResponse(&onResponse)
+
+	dialog.Present(&w.ApplicationWindow.Widget)
 }
 
