+func (a *App) contentButton(icon string, label string, tooltip string, suggested bool, fn func()) *gtk.Button {
+	button := gtk.NewButton()
+	content := adw.NewButtonContent()
+	content.SetIconName(icon)
+	content.SetLabel(label)
+	content.SetUseUnderline(true)
+	content.SetCanShrink(true)
+	button.SetChild(&content.Widget)
+	button.SetTooltipText(tooltip)
+	button.SetValign(gtk.AlignCenterValue)
+	if suggested {
+		button.AddCssClass("suggested-action")
+	}
+
+	var callback func(gtk.Button)
+	callback = func(gtk.Button) { fn() }
+	button.ConnectClicked(&callback)
+	a.hold(&callback)
+	return button
+}
+
+func (a *App) busyButton(label string, tooltip string, fn func()) *gtk.Button {
+	button := gtk.NewButton()
+	box := a.busyContent(label)
+	button.SetChild(&box.Widget)
+	button.SetValign(gtk.AlignCenterValue)
+	button.AddCssClass("flat")
+	button.SetTooltipText(tooltip)
+
+	var callback func(gtk.Button)
+	callback = func(gtk.Button) { fn() }
+	button.ConnectClicked(&callback)
+	a.hold(&callback)
+	return button
+}
+
+func (a *App) busyIndicator(label string, tooltip string) *gtk.Box {
+	box := a.busyContent(label)
+	box.SetMarginTop(8)
+	box.SetMarginBottom(8)
+	box.SetMarginStart(12)
+	box.SetMarginEnd(12)
+	box.SetTooltipText(tooltip)
+	return box
+}
+
+func (a *App) busyContent(label string) *gtk.Box {
+	box := gtk.NewBox(gtk.OrientationHorizontalValue, 6)
+	box.SetValign(gtk.AlignCenterValue)
+	spinner := adw.NewSpinner()
+	spinner.SetValign(gtk.AlignCenterValue)
+	text := gtk.NewLabel(label)
+	text.SetUseUnderline(true)
+	text.SetValign(gtk.AlignCenterValue)
+	box.Append(&spinner.Widget)
+	box.Append(&text.Widget)
+	return box
+}
+
