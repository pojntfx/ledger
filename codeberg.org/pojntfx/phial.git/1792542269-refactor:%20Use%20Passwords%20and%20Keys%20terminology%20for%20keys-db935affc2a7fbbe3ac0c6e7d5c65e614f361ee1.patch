+
+func (a *App) machineAction(machine domain.Machine, phase domain.MachinePhase, actions domain.MachineActions) *gtk.Stack {
+	stack := gtk.NewStack()
+	stack.SetHhomogeneous(true)
+	stack.SetVhomogeneous(true)
+	stack.SetTransitionType(gtk.StackTransitionTypeCrossfadeValue)
+	stack.SetTransitionDuration(150)
+
+	busy := machine.Transitioning() || phase == domain.MachineInstalling || (phase == domain.MachineRunning && !machine.Ready)
+	if busy {
+		label := ""
+		tooltip := ""
+		var fn func()
+		switch {
+		case actions.Stop:
+			label = "_Stop"
+			tooltip = "Stop Machine"
+			fn = func() {
+				_ = a.store.StopMachine(machine.Name)
+				a.render()
+			}
+		case phase == domain.MachineInstalling:
+			label = "Installing"
+			tooltip = "Installing the Machine"
+		case phase == domain.MachineStopping:
+			label = "Stopping"
+			tooltip = "Stopping the Machine"
+		case phase == domain.MachineUpdatingAgent:
+			label = "Updating"
+			tooltip = "Updating the Guest Agent"
+		default:
+			label = domain.MachinePhaseText(machine)
+			tooltip = label
+		}
+		if fn != nil {
+			button := a.busyButton(label, tooltip, fn)
+			stack.AddNamed(&button.Widget, "busy")
+		} else {
+			indicator := a.busyIndicator(label, tooltip)
+			stack.AddNamed(&indicator.Widget, "busy")
+		}
+		stack.SetVisibleChildName("busy")
+		return stack
+	}
+
+	icon := ""
+	label := ""
+	tooltip := ""
+	suggested := false
+	var fn func()
+	switch phase {
+	case domain.MachineNotInstalled, domain.MachineInstallFailed:
+		icon = "system-software-install-symbolic"
+		label = "_Install…"
+		tooltip = "Install Machine"
+		suggested = true
+		fn = func() { a.installMachine(machine.Name) }
+	case domain.MachineStopped:
+		icon = "media-playback-start-symbolic"
+		label = "_Start"
+		tooltip = "Start Machine"
+		suggested = true
+		fn = func() {
+			_ = a.store.StartMachine(machine.Name)
+			a.render()
+		}
+	case domain.MachineRunning:
+		icon = "media-playback-stop-symbolic"
+		label = "_Stop"
+		tooltip = "Stop Machine"
+		fn = func() {
+			_ = a.store.StopMachine(machine.Name)
+			a.render()
+		}
+	default:
+		return stack
+	}
+
+	button := a.contentButton(icon, label, tooltip, suggested, fn)
+	stack.AddNamed(&button.Widget, "action")
+	stack.SetVisibleChildName("action")
+	return stack
 }
 
