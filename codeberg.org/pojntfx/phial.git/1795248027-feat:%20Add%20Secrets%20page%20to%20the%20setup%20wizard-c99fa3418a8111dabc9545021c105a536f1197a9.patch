+func (s *Store) SetSSHAgentSockets(ctx context.Context, sockets []string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.session.SetSSHAgentSockets(sockets)
+
+	return s.onChange(ctx)
+}
+
+func (s *Store) SSHAgentSockets() []string {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	return s.session.SSHAgentSockets()
+}
+
+func (s *Store) SetGPGHome(ctx context.Context, home string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.session.SetGPGHome(home)
+
+	return s.onChange(ctx)
+}
+
+func (s *Store) GPGHome() string {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	return s.session.GPGHome()
+}
+
