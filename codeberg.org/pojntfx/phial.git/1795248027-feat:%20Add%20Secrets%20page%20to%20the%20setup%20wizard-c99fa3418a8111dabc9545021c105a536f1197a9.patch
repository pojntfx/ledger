@@ -185,6 +199,10 @@ }
 
 func (s *Session) onSetupSystem(ctx context.Context, _ ...any) error {
 	return s.onSetupStep(ctx, SetupPageSystem)
+}
+
+func (s *Session) onSetupSecrets(ctx context.Context, _ ...any) error {
+	return s.onSetupStep(ctx, SetupPageSecrets)
 }
 
 func (s *Session) onSetupFinish(ctx context.Context, _ ...any) error {
@@ -246,6 +264,39 @@ 	s.machinesFolder = path
 
 	s.hostCommandCopied = false
 	s.systemCommandCopied = false
+}
+
+func (s *Session) SSHAgentSockets() []string {
+	return append([]string(nil), s.sshAgentSockets...)
+}
+
+func (s *Session) SetSSHAgentSockets(sockets []string) {
+	cleaned := make([]string, 0, len(sockets))
+	seen := map[string]struct{}{}
+
+	for _, socket := range sockets {
+		socket = strings.TrimSpace(socket)
+		if socket == "" {
+			continue
+		}
+
+		if _, ok := seen[socket]; ok {
+			continue
+		}
+
+		seen[socket] = struct{}{}
+		cleaned = append(cleaned, socket)
+	}
+
+	s.sshAgentSockets = cleaned
+}
+
+func (s *Session) GPGHome() string {
+	return s.gpgHome
+}
+
+func (s *Session) SetGPGHome(home string) {
+	s.gpgHome = strings.TrimSpace(home)
 }
 
