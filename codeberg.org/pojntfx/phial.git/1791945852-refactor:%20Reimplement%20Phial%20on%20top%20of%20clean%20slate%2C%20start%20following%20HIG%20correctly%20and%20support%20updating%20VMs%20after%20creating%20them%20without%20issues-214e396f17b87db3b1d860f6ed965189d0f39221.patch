diff --git a/assets/resources/window.blp b/assets/resources/window.blp
new file mode 100644
index 0000000000000000000000000000000000000000..e815911dc73bf6117f4e639d3b94efd971f6b988
--- /dev/null
+++ b/assets/resources/window.blp
@@ -0,0 +1,105 @@
+using Gtk 4.0;
+using Adw 1;
+
+Adw.ApplicationWindow main_window {
+  default-width: 1020;
+  default-height: 720;
+  title: _("Phial");
+
+  Adw.Breakpoint {
+    condition ("max-width: 550sp")
+    setters {
+      split_view.collapsed: true;
+    }
+  }
+
+  content: Adw.ToastOverlay toast_overlay {
+    child: Adw.NavigationSplitView split_view {
+      min-sidebar-width: 260;
+      max-sidebar-width: 340;
+
+      sidebar: Adw.NavigationPage sidebar_page {
+        title: _("Phial");
+        child: Adw.ToolbarView {
+          [top]
+          Adw.HeaderBar {
+            title-widget: Adw.WindowTitle sidebar_title {
+              title: _("Phial");
+            };
+            [start]
+            Button new_machine_button {
+              icon-name: "list-add-symbolic";
+              tooltip-text: _("New Machine");
+              styles [ "flat" ]
+            }
+            [end]
+            MenuButton main_menu_button {
+              icon-name: "open-menu-symbolic";
+              tooltip-text: _("Main Menu");
+              primary: true;
+              menu-model: main_menu;
+            }
+          }
+          content: Adw.Sidebar sidebar {};
+        };
+      };
+
+      content: Adw.NavigationPage content_page {
+        child: Adw.NavigationView content_view {
+          pop-on-escape: true;
+
+          Adw.NavigationPage no_machines_page {
+            title: _("Machines");
+            tag: "no-machines";
+            child: Adw.ToolbarView {
+              [top]
+              Adw.HeaderBar {
+                title-widget: Adw.WindowTitle no_machines_title {
+                  title: _("Machines");
+                };
+              }
+              content: Adw.StatusPage no_machines_status {
+                icon-name: "drive-harddisk-symbolic";
+                title: _("No Machines");
+                description: _("A machine runs Fedora on this host and only sees the secrets you grant it.");
+              };
+            };
+          }
+        };
+      };
+    };
+  };
+}
+
+menu main_menu {
+  section {
+    item {
+      label: _("_Sync Secrets");
+      action: "app.sync";
+    }
+    item {
+      label: _("_System Setup…");
+      action: "app.system-setup";
+    }
+  }
+  section {
+    item {
+      label: _("_Keyboard Shortcuts");
+      action: "app.shortcuts";
+    }
+    item {
+      label: _("_Preferences");
+      action: "app.preferences";
+    }
+    item {
+      label: _("_About Phial");
+      action: "app.about";
+    }
+  }
+  section {
+    item {
+      label: _("_Quit");
+      action: "app.quit";
+    }
+  }
+}
