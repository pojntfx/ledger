+func idleAdd(fn func()) {
+	sourceFn := glib.SourceFunc(func(_ uintptr) bool {
+		fn()
+		return false // Return false to stop the idle source after first run
+	})
+	glib.IdleAdd(&sourceFn, 0)
+}
