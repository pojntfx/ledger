+// pageContent wraps boxed lists in a clamp inside a full width scroller. The
+// scrollbar then sits at the edge of the content area instead of at the clamp.
+func (a *App) pageContent(groups ...*adw.PreferencesGroup) *gtk.Widget {
+	box := gtk.NewBox(gtk.OrientationVerticalValue, 24)
+	box.SetMarginTop(24)
+	box.SetMarginBottom(24)
+	box.SetMarginStart(12)
+	box.SetMarginEnd(12)
