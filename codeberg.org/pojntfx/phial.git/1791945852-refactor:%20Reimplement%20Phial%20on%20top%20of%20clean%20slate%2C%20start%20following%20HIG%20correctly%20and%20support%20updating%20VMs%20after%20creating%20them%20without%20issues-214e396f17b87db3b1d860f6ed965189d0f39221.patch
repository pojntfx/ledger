+		initial time.Duration
+		minusTimes,
+		expectErrAt int
+	}{
+		{
+			initial:     MaxInitialRemainingTime,
+			minusTimes:  1,
+			expectErrAt: -1,
+		},
+		{
+			initial:     MinInitialRemainingTime + RemainingTimerAdjustmentInterval,
+			minusTimes:  1,
+			expectErrAt: -1,
+		},
+		{
+			initial:     MinInitialRemainingTime + RemainingTimerAdjustmentInterval,
+			minusTimes:  2,
+			expectErrAt: 1,
+		},
