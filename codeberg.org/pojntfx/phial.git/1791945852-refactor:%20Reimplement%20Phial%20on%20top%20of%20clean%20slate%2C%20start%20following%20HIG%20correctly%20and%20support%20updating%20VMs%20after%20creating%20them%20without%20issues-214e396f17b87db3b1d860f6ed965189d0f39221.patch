+// setState records the observed state of the machine and renders it. A pending
+// transition clears as soon as the machine reaches the new state.
+func (p *machinePage) setState(active bool, ready bool, installing bool, installed bool) {
+	if p.pending != "" {
+		reached := false
+
+		switch p.pending {
+		case "start", "restart":
+			reached = active
+		case "stop":
+			reached = !active
+		}
+
+		if reached || time.Since(p.pendingSince) > 3*time.Minute {
+			p.pending = ""
+		}
+	}
+
+	p.active = active
+	p.ready = ready
+	p.installing = installing
+	p.installed = installed
+
+	p.render()
+}
+
+// setActive keeps the sidebar reconciler in step with the page.
+func (p *machinePage) setActive(active bool, ready bool) {
+	p.setState(active, ready, p.installing, p.installed)
+}
+
+// setPending marks a transition that the user asked for.
+func (p *machinePage) setPending(action string) {
+	p.pending = action
+	p.pendingSince = time.Now()
+	p.render()
+}
+
+// stateText names the state of the machine, including the transition.
+func (p *machinePage) stateText() string {
+	return stateText(p.active, p.ready, p.installing, p.installed, p.pending)
+}
+
+// render writes the state into the page.
+func (p *machinePage) render() {
+	state := p.stateText()
+	p.title.SetSubtitle(state)
+	p.stateRow.SetSubtitle(state)
+
+	p.installGroup.SetVisible(p.installing)
+	p.installActions.SetVisible(p.installing)
+	p.editButton.SetSensitive(!p.installing)
+	p.spinner.SetVisible(p.pending != "" && !p.installing)
+
+	for _, row := range []*adw.ActionRow{p.cpuRow, p.memoryRow, p.diskRow, p.networkRow} {
+		row.SetVisible(p.active)
+	}
+
+	p.gpuRow.SetVisible(p.active && p.gpuRow.GetSubtitle() != "")
+
+	p.metricsIdle.SetVisible(!p.active || p.metricsFailed)
+
+	if p.metricsFailed {
+		p.metricsIdle.SetTitle(i18n.L("The usage is unavailable"))
+		p.metricsIdle.SetSubtitle(i18n.L("Phial could not read the usage of the machine"))
+	} else {
+		p.metricsIdle.SetTitle(i18n.L("No live usage"))
+		p.metricsIdle.SetSubtitle(i18n.L("Start the machine to read the usage of the guest"))
+	}
+
+	if p.installing {
+		p.actionButton.SetVisible(false)
+		p.applyInstallStatus()
+		p.refreshStorage()
+		p.refreshAccess()
+		return
+	}
+
+	p.actionButton.SetVisible(true)
+	p.actionButton.SetSensitive(p.pending == "")
+	p.actionButton.SetUseUnderline(true)
+
+	setStyle := func(label string, destructive bool, suggested bool) {
+		p.actionButton.SetLabel(i18n.L(label))
+
+		if destructive {
+			p.actionButton.RemoveCssClass("suggested-action")
+			p.actionButton.AddCssClass("destructive-action")
+			return
+		}
+
+		p.actionButton.RemoveCssClass("destructive-action")
+
+		if suggested {
+			p.actionButton.AddCssClass("suggested-action")
+			return
+		}
+
+		p.actionButton.RemoveCssClass("suggested-action")
+	}
+
+	switch {
+	case p.pending == "start":
+		setStyle("_Starting…", false, false)
+	case p.pending == "stop":
+		setStyle("_Stopping…", false, false)
+	case p.pending == "restart":
+		setStyle("_Restarting…", false, false)
+	case p.active:
+		setStyle("_Stop", true, false)
+	case p.installed:
+		setStyle("_Start", false, true)
+	default:
+		setStyle("_Install", false, true)
+	}
+
+	p.refreshStorage()
+	p.refreshAccess()
+}
+
+// refresh brings the page in step with the definition and the run state.
+func (p *machinePage) refresh() {
+	if def, err := virt.Load(p.def.Name); err == nil {
+		p.def = def
+	}
+
+	active, _ := p.def.Active()
+	ready := false
+	if active {
+		ready = p.def.Ready()
+	}
+
+	p.setState(active, ready, p.app.Service.Installing(p.def.Name), vmInstalled(p.def))
+}
+
+// refreshAccess turns the controls on that need a reachable guest.
+func (p *machinePage) refreshAccess() {
+	ready := p.active && p.ready
+
+	for _, row := range []*adw.ActionRow{p.appRow, p.rdpRow, p.terminalRow, p.sshRow} {
+		row.SetSensitive(ready)
+	}
+
+	p.serialRow.SetSensitive(p.active)
+}
+
+// refreshStorage writes the facts that no dialog changes.
+func (p *machinePage) refreshStorage() {
+	p.diskPathRow.SetSubtitle(p.def.DiskPathValue())
+}
+
+func graphicsText(value string) string {
+	switch value {
+	case "virgl":
+		return i18n.L("VirGL")
+	case "none":
+		return i18n.L("Off")
+	default:
+		return i18n.L("Venus")
+	}
+}
+
+// refreshMetrics samples the machine and writes the usage rows.
+func (a *App) refreshMetrics() {
+	tag := a.content.GetVisiblePageTag()
+	if !strings.HasPrefix(tag, machineTagPrefix) {
+		return
+	}
+
+	page := a.machinePages[strings.TrimPrefix(tag, machineTagPrefix)]
+	if page == nil || !page.active || page.metricsRunning {
+		return
+	}
+
+	page.metricsRunning = true
+	def := page.def
+
+	go func() {
+		metrics, err := virt.CollectMetrics(def)
+
+		a.idle(func() {
+			page.metricsRunning = false
+
+			if err != nil {
+				a.Log.Info("could not read the metrics", "err", err)
+				page.metricsFailed = true
+				page.render()
+				return
+			}
+
+			page.metricsFailed = false
+
+			if metrics.VCPUs > 0 {
+				page.cpuRow.SetSubtitle(fmt.Sprintf(i18n.L("%.1f of %d cores"), metrics.CPUPercent/100, metrics.VCPUs))
+			} else {
+				page.cpuRow.SetSubtitle(fmt.Sprintf(i18n.L("%.0f%% of one core"), metrics.CPUPercent))
+			}
+
+			page.memoryRow.SetSubtitle(fmt.Sprintf(i18n.L("%s of %s"), humanBytes(metrics.MemoryUsed), humanBytes(metrics.MemoryTotal)))
+
+			page.diskRow.SetSubtitle(fmt.Sprintf(
+				i18n.L("%s of %s on this host"),
+				humanBytes(metrics.DiskAllocated),
+				humanBytes(metrics.DiskTotal),
+			))
+
+			switch {
+			case !metrics.NetworkReady:
+				page.networkRow.SetSubtitle(i18n.L("The guest agent does not answer"))
+			case metrics.NetworkRxRate == 0 && metrics.NetworkTxRate == 0:
+				page.networkRow.SetSubtitle(i18n.L("No traffic"))
+			default:
+				page.networkRow.SetSubtitle(fmt.Sprintf(
+					i18n.L("%s/s received, %s/s sent"),
+					humanBytes(int64(metrics.NetworkRxRate)),
+					humanBytes(int64(metrics.NetworkTxRate)),
+				))
+			}
+
+			if metrics.GPU != "" && metrics.GPU != "none" {
+				page.gpuRow.SetSubtitle(graphicsText(metrics.GPU))
+			}
+
+			page.render()
+		})
+	}()
+}
