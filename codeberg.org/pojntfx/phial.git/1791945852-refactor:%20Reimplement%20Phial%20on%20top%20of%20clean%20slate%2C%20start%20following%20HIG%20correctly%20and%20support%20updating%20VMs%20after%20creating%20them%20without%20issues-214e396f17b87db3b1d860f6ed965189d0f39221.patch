+package ui
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strings"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+
+	"codeberg.org/pojntfx/phial-neo/internal/mcp"
+	"codeberg.org/pojntfx/phial-neo/internal/virt"
+)
+
+func (a *App) serialSocket(def virt.Definition) string {
+	return def.RuntimePathValue() + "/console.sock"
+}
+
+// openTerminal starts the first terminal emulator that is installed.
+func (a *App) openTerminal(args ...string) bool {
+	candidates := [][]string{
+		{"kgx", "--"},
+		{"ptyxis", "--"},
+		{"gnome-terminal", "--"},
+		{"foot"},
+		{"alacritty", "-e"},
+		{"tilix", "-e"},
+		{"konsole", "-e"},
+		{"xterm", "-e"},
+	}
+
+	if os.Getenv("FLATPAK_ID") != "" {
+		candidates = [][]string{
+			{"host-spawn", "kgx", "--"},
+			{"host-spawn", "ptyxis", "--"},
+			{"host-spawn", "gnome-terminal", "--"},
+		}
+	}
+
+	for _, candidate := range candidates {
+		if _, err := exec.LookPath(candidate[0]); err != nil {
+			continue
+		}
+
+		command := exec.Command(candidate[0], append(candidate[1:], args...)...)
+		if err := command.Start(); err != nil {
+			continue
+		}
+
+		return true
+	}
+
+	a.toast(i18n.L("No terminal emulator was found"))
+	return false
+}
+
+// unlockAgentRow states whether the agent of the session holds the key of the
+// user, and loads that key when the agent needs it.
+func (a *App) unlockAgentRow() *gtk.Widget {
+	row := a.buttonRow("_Unlock the SSH Agent", "dialog-password-symbolic", func() {
+		a.goAsync(func() (string, error) {
+			if err := virt.UnlockAgent(a.Ctx); err != nil {
+				return "", err
+			}
+
+			return i18n.L("The SSH agent holds your key"), nil
+		})
+	})
+
+	return &row.Widget
+}
+
+// credentialGroup states the credentials that the guest asks for at its login,
+// with a copy control for each of them.
+func (a *App) credentialGroup(user string, password string) *adw.PreferencesGroup {
+	group := formGroup("Sign In", "The guest asks for these credentials when you sign in.")
+
+	userRow := adw.NewEntryRow()
+	userRow.SetTitle(i18n.L("_User"))
+	userRow.SetUseUnderline(true)
+	userRow.SetText(user)
+	userRow.SetEditable(false)
+	userRow.SetShowApplyButton(false)
+	copyUser := a.iconButton("edit-copy-symbolic", i18n.L("Copy User"), func() {
+		a.copyText(user, i18n.L("User copied"))
+	})
+	userRow.AddSuffix(&copyUser.Widget)
+	group.Add(&userRow.Widget)
+
+	passwordRow := adw.NewPasswordEntryRow()
+	passwordRow.SetTitle(i18n.L("_Password"))
+	passwordRow.SetUseUnderline(true)
+	passwordRow.SetText(password)
+	passwordRow.SetEditable(false)
+	passwordRow.SetShowApplyButton(false)
+	copyPassword := a.iconButton("edit-copy-symbolic", i18n.L("Copy Password"), func() {
+		a.copyText(password, i18n.L("Password copied"))
+	})
+	passwordRow.AddSuffix(&copyPassword.Widget)
+	group.Add(&passwordRow.EntryRow.PreferencesRow.ListBoxRow.Widget)
+
+	return group
+}
+
+func (a *App) showSerialDialog(def virt.Definition) {
+	scope := a.newScope()
+
+	socket := a.serialSocket(def)
+	attach := "socat - UNIX-CONNECT:" + socket
+
