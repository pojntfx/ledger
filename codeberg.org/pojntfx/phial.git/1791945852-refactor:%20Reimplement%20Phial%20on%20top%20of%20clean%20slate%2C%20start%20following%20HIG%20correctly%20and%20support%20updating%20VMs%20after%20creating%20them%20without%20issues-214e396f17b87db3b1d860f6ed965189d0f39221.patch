diff --git a/host/bin/phial-passt b/host/bin/phial-passt
new file mode 100755
index 0000000000000000000000000000000000000000..a2680f388fd800216703077e4b8b3ebd1804b739
--- /dev/null
+++ b/host/bin/phial-passt
@@ -0,0 +1,21 @@
+#!/bin/sh
+set -e
+
+stub="/run/systemd/resolve/stub-resolv.conf"
+upstream="/run/systemd/resolve/resolv.conf"
+
+if [ -r "$stub" ]; then
+	exec "$@" --dns-host 127.0.0.53
+fi
+
+resolver="$(awk '/^nameserver/ && $2 !~ /^127\./ && $2 != "::1" {print $2; exit}' /etc/resolv.conf 2>/dev/null || true)"
+
+if [ -z "$resolver" ]; then
+	resolver="$(awk '/^nameserver/ && $2 !~ /^127\./ && $2 != "::1" {print $2; exit}' "$upstream" 2>/dev/null || true)"
+fi
+
+if [ -n "$resolver" ]; then
+	exec "$@" --dns-host "$resolver"
+fi
+
+exec "$@"
