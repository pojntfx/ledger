+	// The final entry is often a line that is still being written.
+	for index := len(lines) - 2; index >= 0; index-- {
+		if line := cleanConsoleLine(lines[index]); meaningfulConsoleLine(line) {
+			return line
+		}
+	}
+
+	if len(lines) > 0 {
+		if line := cleanConsoleLine(lines[len(lines)-1]); meaningfulConsoleLine(line) {
+			return line
+		}
+	}
