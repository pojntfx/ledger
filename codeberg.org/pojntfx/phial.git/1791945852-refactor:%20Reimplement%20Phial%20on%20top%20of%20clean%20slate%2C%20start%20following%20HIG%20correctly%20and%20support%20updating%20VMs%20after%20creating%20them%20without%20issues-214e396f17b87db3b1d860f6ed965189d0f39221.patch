+func (a *App) machinePrimaryAction(page *machinePage) {
+	installed := vmInstalled(page.def)
+
+	switch {
+	case page.active:
+		a.machineActionFor(page.def.Name, "stop")
+	case installed:
+		a.machineActionFor(page.def.Name, "start")
+	default:
+		a.confirmInstall(page.def)
+	}
+}
+
+func (a *App) machineActionFor(name string, action string) {
+	if page := a.machinePages[name]; page != nil {
+		page.setPending(action)
+	}
+
+	go func() {
+		def, err := virt.Load(name)
+
+		if err == nil {
+			switch action {
+			case "start":
+				err = def.Start()
+			case "stop":
+				err = def.Stop()
+			case "restart":
+				if stopErr := def.Stop(); stopErr != nil {
+					a.Log.Info("the machine was not running", "err", stopErr)
+				}
+
+				err = def.Start()
+			}
+		}
+
+		a.idle(func() {
+			if err != nil {
+				if page := a.machinePages[name]; page != nil {
+					page.pending = ""
+				}
+
+				a.showError(err)
+			}
+
+			a.refreshSidebar()
+			a.refreshMachinePage(name)
+		})
+	}()
+}
+
+func (a *App) confirmInstall(def virt.Definition) {
+	dialog := adw.NewAlertDialog(
+		i18n.L("Install the machine?"),
+		fmt.Sprintf(
+			i18n.L("Phial downloads the Fedora netinst image and installs %s onto %s. This takes about fifteen minutes."),
+			def.Name,
+			def.DiskSize,
+		),
+	)
+	dialog.AddResponse("cancel", i18n.L("_Cancel"))
+	dialog.AddResponse("install", i18n.L("_Install"))
+	dialog.SetResponseAppearance("install", adw.ResponseSuggestedValue)
+	dialog.SetDefaultResponse("install")
+	dialog.SetCloseResponse("cancel")
+
+	var cb func(adw.AlertDialog, string)
+	cb = func(_ adw.AlertDialog, response string) {
+		if response != "install" {
+			return
+		}
+
+		a.goAsync(func() (string, error) {
+			if _, _, err := a.Service.VmInstall(a.Ctx, nil, mcp.NameInput{Name: def.Name}); err != nil {
+				return "", err
+			}
+
+			a.idle(func() {
+				a.refreshSidebar()
+				a.refreshMachinePage(def.Name)
+			})
+
+			return i18n.L("The installer runs in the background"), nil
+		})
+	}
+	dialog.ConnectResponse(&cb)
+	a.hold(&cb)
+
+	dialog.Present(&a.win.Widget)
+}
