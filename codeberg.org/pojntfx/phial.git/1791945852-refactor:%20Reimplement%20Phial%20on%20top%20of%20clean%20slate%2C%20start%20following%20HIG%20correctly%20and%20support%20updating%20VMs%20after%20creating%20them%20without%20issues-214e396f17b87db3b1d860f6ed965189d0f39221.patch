+
+// cleanConsoleLine removes the escape sequences that a console writes. A
+// carriage return rewrites its line, so only the part after it stays.
+func cleanConsoleLine(line string) string {
+	if index := strings.LastIndex(line, "\r"); index >= 0 {
+		line = line[index+1:]
+	}
+
+	var (
+		clean   strings.Builder
+		escape  bool
+		bracket bool
+	)
+
+	for _, r := range line {
+		switch {
+		case r == 0x1b:
+			escape = true
+			bracket = false
+		case !escape:
+			switch {
+			case r == '\t':
+				clean.WriteRune(' ')
+			case r >= 32 && r != 127:
+				clean.WriteRune(r)
+			}
+		case r == '[' && !bracket:
+			bracket = true
+		case bracket && r >= 0x40 && r <= 0x7e:
+			escape = false
+			bracket = false
+		case !bracket:
+			// A short escape such as the two characters of a character set.
+			escape = false
+		}
+	}
+
+	value := strings.TrimSpace(clean.String())
+
+	if len(value) > 120 {
+		value = value[:120] + "…"
+	}
+
+	return value
 }
 
