+// QgaExec runs one script in the guest through the agent of the machine, which
+// runs as root, and states its output.
+func QgaExec(def Definition, script string) (string, error) {
+	raw, err := QgaCall(def, "guest-exec", map[string]interface{}{
+		"path":           "/bin/bash",
+		"arg":            []string{"-c", script},
+		"capture-output": true,
+	})
+	if err != nil {
+		return "", err
+	}
+
+	var started struct {
+		Pid int `json:"pid"`
+	}
+	if err := json.Unmarshal(raw, &started); err != nil {
+		return "", err
+	}
+
+	if started.Pid == 0 {
+		return "", errors.New("the agent of the machine started no script")
+	}
+
+	deadline := time.Now().Add(10 * time.Minute)
+
+	for time.Now().Before(deadline) {
+		raw, err := QgaCall(def, "guest-exec-status", map[string]interface{}{"pid": started.Pid})
+		if err != nil {
+			return "", err
+		}
+
+		var status struct {
+			Exited   bool   `json:"exited"`
+			ExitCode int    `json:"exitcode"`
+			OutData  string `json:"out-data"`
+			ErrData  string `json:"err-data"`
+		}
+		if err := json.Unmarshal(raw, &status); err != nil {
+			return "", err
+		}
+
+		if !status.Exited {
+			time.Sleep(500 * time.Millisecond)
+
+			continue
+		}
+
+		out, err := base64.StdEncoding.DecodeString(status.OutData)
+		if err != nil {
+			return "", err
+		}
+
+		errOut, err := base64.StdEncoding.DecodeString(status.ErrData)
+		if err != nil {
+			return "", err
+		}
+
+		message := strings.TrimSpace(string(out) + string(errOut))
+
+		if status.ExitCode != 0 {
+			return message, fmt.Errorf("the script in the guest failed with exit code %d: %s", status.ExitCode, message)
+		}
+
+		return message, nil
+	}
+
+	return "", errors.New("the script in the guest did not finish in time")
 }
 
