+// memoryLockable reports whether the host can lock one memory size, which keeps
+// the guest out of swap. The lock needs the whole size to be free, so a host
+// that cannot afford it runs the machine unlocked instead of failing.
+func memoryLockable(memory string) bool {
+	mib, err := memoryMiB(memory)
+	if err != nil {
+		return false
+	}
+
+	available, err := memoryAvailable()
+	if err != nil {
+		return false
+	}
+
+	return available >= int64(mib)*1024*1024
