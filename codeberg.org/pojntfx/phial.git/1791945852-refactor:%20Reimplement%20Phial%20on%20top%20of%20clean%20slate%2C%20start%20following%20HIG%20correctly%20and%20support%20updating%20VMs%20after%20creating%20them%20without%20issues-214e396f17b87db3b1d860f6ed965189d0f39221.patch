+// capture renders the window into a PNG file. It exists for the automated
+// screenshot run in tests/ui-test.sh.
+func (a *App) capture(path string) string {
+	if a.win == nil {
+		return "no window"
+	}
+
+	child := a.win.Widget.GetFirstChild()
+	if child == nil {
+		return "no child"
+	}
+
+	width := child.GetWidth()
+	height := child.GetHeight()
+	if width <= 0 || height <= 0 {
+		return "the window has no size yet"
+	}
+
+	// Render the full allocation, because the ink of the widget tree alone can
+	// be smaller than the window.
+	bounds := &graphene.Rect{}
+	bounds.Init(0, 0, float32(width), float32(height))
+
+	var background gdk.RGBA
+	a.win.Widget.GetStyleContext().LookupColor("window_bg_color", &background)
+
+	native := a.win.Widget.GetNative()
+	if native == nil {
+		return "no native surface"
+	}
+
+	render := func() *gdk.Texture {
+		snapshot := gtk.NewSnapshot()
+		snapshot.AppendColor(&background, bounds)
+		a.win.Widget.SnapshotChild(child, snapshot)
+
+		node := snapshot.ToNode()
+		if node == nil {
+			return nil
+		}
+
+		return native.GetRenderer().RenderTexture(node, bounds)
+	}
+
+	// The first frame of a freshly mapped window is empty, so one render warms
+	// the renderer up and the second one carries the content.
+	if render() == nil {
+		return "no texture"
+	}
+
+	texture := render()
+	if texture == nil {
+		return "no texture"
+	}
+
+	if !texture.SaveToPng(path) {
+		return "could not save " + path
+	}
+
+	message := "captured " + path + fmt.Sprintf(" (%dx%d)", texture.GetWidth(), texture.GetHeight())
+	a.Log.Info(message,
+		"window_width", a.win.Widget.GetWidth(),
+		"window_height", a.win.Widget.GetHeight(),
+		"collapsed", a.split.GetCollapsed(),
+	)
+
+	return message
+}
