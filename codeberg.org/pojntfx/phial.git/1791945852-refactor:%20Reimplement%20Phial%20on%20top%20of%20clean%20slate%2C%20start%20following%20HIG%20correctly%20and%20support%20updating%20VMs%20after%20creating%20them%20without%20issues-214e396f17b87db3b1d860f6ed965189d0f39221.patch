+
+	group.Add(&a.buttonRow("_Copy the Command", "edit-copy-symbolic", func() {
+		a.copyText("ssh "+def.Name, i18n.L("Command copied"))
+	}).Widget)
+
+	group.Add(a.unlockAgentRow())
+
+	content := a.formPage(group)
