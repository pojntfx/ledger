+func (a *App) refreshCounts() {
+	rows, err := a.State.Rows()
+	if err == nil {
+		granted := 0
+		for _, row := range rows {
+			if grant := a.State.GrantInfo(row.Name); grant != nil {
+				if grant.ExpiresUnix > nowUnix() {
+					granted++
+				}
+			}
+		}
+
+		a.providersItem.SetSubtitle(countText(len(rows), i18n.L("Provider"), i18n.L("Providers")))
+		if granted > 0 {
+			a.providersBadge.SetText(fmt.Sprintf("%d", granted))
+			a.providersBadge.SetVisible(true)
+		} else {
+			a.providersBadge.SetVisible(false)
+		}
+	}
+
+	pending := len(a.Service.Pending())
+	if pending > 0 {
+		a.requestsItem.SetSubtitle(fmt.Sprintf(i18n.L("%d waiting for approval"), pending))
+		a.requestsBadge.SetText(fmt.Sprintf("%d", pending))
+		a.requestsBadge.SetVisible(true)
+	} else {
+		a.requestsItem.SetSubtitle(i18n.L("None pending"))
+		a.requestsBadge.SetVisible(false)
+	}
+}
+
+func countText(count int, singular string, plural string) string {
+	if count == 1 {
+		return fmt.Sprintf(i18n.L("1 %s"), singular)
+	}
+	return fmt.Sprintf(i18n.L("%d %s"), count, plural)
+}
+
+// selectPage shows one top level page and keeps the sidebar in step.
+// ensureInView registers a page again after a page switch removed it. A switch
+// keeps only the pages that it names, so every cached page must come back
+// before the next switch.
+func (a *App) ensureInView(page *adw.NavigationPage) {
+	if page == nil || a.content.FindPage(page.GetTag()) != nil {
+		return
+	}
+	a.content.Add(page)
+}
+
+// showTags shows the last page of the list and keeps every cached page in the
+// view.
+func (a *App) showTags(tags ...string) {
+	a.ensureInView(a.providersPage)
+	a.ensureInView(a.requestsPage)
+	a.ensureInView(a.connectionsPage)
+	a.ensureInView(a.noMachinesPage)
+
+	for _, page := range a.machinePages {
+		a.ensureInView(page.page)
+	}
+
+	for _, page := range a.providerPages {
+		a.ensureInView(page.page)
+	}
+
+	a.content.ReplaceWithTags(tags, int32(len(tags)))
+}
+
+func (a *App) selectPage(tag string) {
+	switch {
+	case tag == providersTag:
+		a.showTags(providersTag)
+	case tag == requestsTag:
+		a.showTags(requestsTag)
+	case tag == connectionsTag:
+		a.showTags(connectionsTag)
+	case strings.HasPrefix(tag, providerTagPrefix):
+		name := strings.TrimPrefix(tag, providerTagPrefix)
+		a.ensureProviderPage(name)
+		a.showTags(providersTag, tag)
+	case strings.HasPrefix(tag, machineTagPrefix):
+		name := strings.TrimPrefix(tag, machineTagPrefix)
+
+		// The sidebar reconciles every two seconds, so it is not a source of
+		// truth for a machine that was just created.
+		if _, err := virt.Load(name); err != nil {
+			return
+		}
+
+		a.ensureMachinePage(name)
+		a.showTags(tag)
+	case tag == noMachinesTag:
+		a.showTags(noMachinesTag)
+	default:
+		return
+	}
+
+	a.selected = tag
+	a.updateAccels()
+
+	matched := false
+
+	// The page of one provider belongs to the Providers row.
+	selection := tag
+	if strings.HasPrefix(tag, providerTagPrefix) {
+		selection = providersTag
+	}
+
+	for index, value := range a.sidebarTags {
+		if value == selection {
+			a.sidebar.SetSelected(uint32(index))
+			matched = true
+			break
+		}
+	}
+
+	if !matched {
+		// No row carries this page, so no row carries a selection.
+		a.sidebar.SetSelected(gMaxUint32)
+	}
+
+	if a.split.GetCollapsed() {
+		a.split.SetShowContent(true)
+	}
+}
+
+func (a *App) selectMachine(index int) {
+	if index < 1 || index > len(a.machineOrder) {
+		return
+	}
+	a.selectPage(machineTagPrefix + a.machineOrder[index-1])
+}
+
+func (a *App) restoreActivePage() {
+	tag := a.Settings.GetString(resources.SettingActivePageKey)
+
+	if strings.HasPrefix(tag, machineTagPrefix) {
+		if _, ok := a.machineItems[strings.TrimPrefix(tag, machineTagPrefix)]; ok {
+			a.selectPage(tag)
+			return
+		}
+	}
+
+	if tag == providersTag || tag == requestsTag {
+		a.selectPage(tag)
+		return
+	}
+
+	if len(a.machineOrder) > 0 {
+		a.selectPage(machineTagPrefix + a.machineOrder[0])
+		return
+	}
+
+	a.selectPage(noMachinesTag)
+}
+
+// ensureMachinePage builds the page of a machine on first use.
+func (a *App) ensureMachinePage(name string) *machinePage {
+	if page := a.machinePages[name]; page != nil {
+		return page
+	}
+
+	def, err := virt.Load(name)
+	if err != nil {
+		a.Log.Error("could not load the machine", "name", name, "err", err)
+		return nil
+	}
+
+	page := a.buildMachinePage(def)
+	a.machinePages[name] = page
+	a.content.Add(page.page)
+
+	return page
+}
+
+func (a *App) refreshMachinePage(name string) {
+	if page := a.machinePages[name]; page != nil {
+		page.refresh()
+	}
+}
