--- a/tests/enable-linger.sh
+++ /dev/null
@@ -1,56 +0,0 @@
-#!/usr/bin/env bash
-set -euo pipefail
-
-IMAGE="${1:?usage: enable-linger.sh <image> <user>}"
-USER_NAME="${2:?usage: enable-linger.sh <image> <user>}"
-
-LOOP=$(losetup --find --show --partscan "$IMAGE")
-echo "loop device: $LOOP"
-
-cleanup() {
-  set +e
-  umount -R /mnt/phial-fix 2>/dev/null
-  losetup -d "$LOOP" 2>/dev/null
-}
-trap cleanup EXIT
-
-ROOT_PART=$(lsblk -nlo NAME,SIZE "$LOOP" | grep -v "^$(basename "$LOOP") " | sort -k2 -h | tail -1 | awk '{print $1}')
-echo "root partition: $ROOT_PART"
-
-mkdir -p /mnt/phial-fix
-
-if blkid -o value -s TYPE "/dev/$ROOT_PART" 2>/dev/null | grep -q btrfs; then
-  mount -o subvol=root "/dev/$ROOT_PART" /mnt/phial-fix || mount "/dev/$ROOT_PART" /mnt/phial-fix
-else
-  mount "/dev/$ROOT_PART" /mnt/phial-fix
-fi
-
-echo "mounted: $(findmnt -n -o TARGET /mnt/phial-fix)"
-
-mkdir -p /mnt/phial-fix/var/lib/systemd/linger
-touch "/mnt/phial-fix/var/lib/systemd/linger/$USER_NAME"
-
-install -d -m 0755 /mnt/phial-fix/etc/systemd/system
-cat > /mnt/phial-fix/etc/systemd/system/phial-ssh-vsock.service <<'UNIT'
-[Unit]
-Description=phial SSH over vsock
-After=sshd.service
-Wants=sshd.service
-
-[Service]
-Type=simple
-ExecStart=/usr/bin/socat VSOCK-LISTEN:2222,fork,reuseaddr TCP:[::1]:22
-Restart=on-failure
-
-[Install]
-WantedBy=multi-user.target
-UNIT
-
-rm -f /mnt/phial-fix/etc/systemd/system/multi-user.target.wants/phial-ssh-vsock.service
-mkdir -p /mnt/phial-fix/etc/systemd/system/multi-user.target.wants
-ln -sf /etc/systemd/system/phial-ssh-vsock.service /mnt/phial-fix/etc/systemd/system/multi-user.target.wants/phial-ssh-vsock.service
-
-echo "linger: $(ls /mnt/phial-fix/var/lib/systemd/linger/)"
-echo "unit: $(ls -l /mnt/phial-fix/etc/systemd/system/multi-user.target.wants/phial-ssh-vsock.service)"
-
-sync
diff --git a/tests/mcp-call.sh b/tests/mcp-call.sh
new file mode 100755
index 0000000000000000000000000000000000000000..82a81bfa9c3d81a4f2701bfc5bf380fefa0ab90a
--- /dev/null
+++ b/tests/mcp-call.sh
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+# Calls one tool over the agent channel of a running application. The channel
+# speaks the Model Context Protocol, so the call performs the session handshake
+# first.
+set -u
+
+SOCK="${SOCK:-/run/user/1000/phial/mcp.sock}"
+TOOL="${1:?give a tool name}"
+ARGS="${2:-{}}"
+
+headers=$(mktemp)
+trap 'rm -f "$headers"' EXIT
+
+curl -s -D "$headers" -o /dev/null -X POST http://localhost/mcp --unix-socket "$SOCK" \
+  -H 'Content-Type: application/json' \
+  -H 'Accept: application/json, text/event-stream' \
+  -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"phial-test","version":"1"}}}'
+
+session=$(grep -i 'mcp-session-id' "$headers" | tr -d '\r' | awk '{print $2}')
+
+if [ -z "$session" ]; then
+  echo "the agent channel did not open a session" >&2
+  exit 1
+fi
+
+curl -s -o /dev/null -X POST http://localhost/mcp --unix-socket "$SOCK" \
+  -H 'Content-Type: application/json' \
+  -H 'Accept: application/json, text/event-stream' \
+  -H "Mcp-Session-Id: $session" \
+  -d '{"jsonrpc":"2.0","method":"notifications/initialized"}'
+
+curl -s -X POST http://localhost/mcp --unix-socket "$SOCK" \
+  -H 'Content-Type: application/json' \
+  -H 'Accept: application/json, text/event-stream' \
+  -H "Mcp-Session-Id: $session" \
+  -d "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"$TOOL\",\"arguments\":$ARGS}}" |
+  tr -d '\r' | sed -n 's/^data: //p'
