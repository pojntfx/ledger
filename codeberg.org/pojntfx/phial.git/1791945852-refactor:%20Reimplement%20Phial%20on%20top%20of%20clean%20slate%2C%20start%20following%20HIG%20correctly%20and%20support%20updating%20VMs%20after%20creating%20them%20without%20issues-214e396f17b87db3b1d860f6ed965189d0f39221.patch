+
+func humanBytes(value int64) string {
+	const unit = 1024.0
+	if value < int64(unit) {
+		return fmt.Sprintf("%d B", value)
+	}
+
+	divisor, exponent := unit, 0
+	for value/int64(divisor) >= int64(unit) && exponent < 3 {
+		divisor *= unit
+		exponent++
+	}
+
+	return fmt.Sprintf("%.1f %ciB", float64(value)/divisor, "KMGTP"[exponent])
+}
+
+// durationText writes a remaining time with the smallest useful unit.
+func durationText(seconds int64) string {
+	switch {
+	case seconds >= 86400:
+		return fmt.Sprintf(i18n.L("%d d"), seconds/86400)
+	case seconds >= 3600:
+		return fmt.Sprintf(i18n.L("%d h"), seconds/3600)
+	case seconds >= 60:
+		return fmt.Sprintf(i18n.L("%d min"), seconds/60)
+	default:
+		return fmt.Sprintf(i18n.L("%d s"), seconds)
+	}
+}
+
+// stateText names the state of a machine for a row subtitle.
+// hugePagesDetail states what the host can back with huge pages, and whether
+// one memory size fits into it.
+func hugePagesDetail(memory string) string {
+	free, total, err := virt.HugePages()
+	if err != nil {
+		return i18n.L("The host state could not be read")
+	}
+
+	detail := fmt.Sprintf(
+		i18n.L("%s free of %s reserved"),
+		humanBytes(free),
+		humanBytes(total),
+	)
+
+	if memory == "" {
+		return detail
+	}
+
+	mib, err := virt.MemoryMiB(memory)
+	if err != nil {
+		return detail
+	}
+
+	if free < int64(mib)*1024*1024 {
+		return detail + ", " + i18n.L("too little for this machine")
+	}
+
+	return detail + ", " + i18n.L("enough for this machine")
+}
+
+func stateText(active bool, ready bool, installing bool, installed bool, pending string) string {
+	switch {
+	case installing:
+		return i18n.L("Installing")
+	case pending == "start" || (active && !ready):
+		return i18n.L("Starting")
+	case pending == "restart":
+		return i18n.L("Restarting")
+	case active:
+		return i18n.L("Running")
+	case pending == "stop":
+		return i18n.L("Stopping")
+	case installed:
+		return i18n.L("Stopped")
+	default:
+		return i18n.L("Not installed")
+	}
+}
+
+// sameStrings reports whether two string lists hold the same values.
+func sameStrings(left []string, right []string) bool {
+	if len(left) != len(right) {
+		return false
+	}
+	for index := range left {
+		if left[index] != right[index] {
+			return false
+		}
+	}
+	return true
+}
+
+// setModel replaces the options of a combo row without reporting a change.
+func (c *comboRow) setModel(labels []string, values []string, current string) {
+	c.values = values
+	c.selected = 0
+
+	for index, value := range values {
+		if value == current {
+			c.selected = index
+		}
+	}
+
+	c.row.SetModel(gtk.NewStringList(labels))
+	c.row.SetSelected(uint32(c.selected))
+}
+
+func shortUSBName(name string) string {
+	for _, suffix := range []string{" Corporation", " Inc.", " Ltd", " GmbH", " Corp.", " Co., Ltd."} {
+		name = strings.TrimSuffix(name, suffix)
+	}
+	return name
+}
