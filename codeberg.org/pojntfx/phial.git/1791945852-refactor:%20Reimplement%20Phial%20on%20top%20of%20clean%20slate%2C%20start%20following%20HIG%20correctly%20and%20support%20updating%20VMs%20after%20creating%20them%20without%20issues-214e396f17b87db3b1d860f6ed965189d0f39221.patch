+		t.Fatalf("ApplySSHKeys() = %q, want %q", got, want)
+	}
+}
+
+func TestAskpassCommandExists(t *testing.T) {
+	if _, err := os.Stat(AskpassCommand()); err != nil {
+		t.Fatalf("AskpassCommand() = %q, want a prompt that exists: %v", AskpassCommand(), err)
+	}
+}
+
+func TestSSHConfigTextUsesTheSessionAgent(t *testing.T) {
+	text := SSHConfigText([]Definition{{Name: "test-vm"}})
+
+	if strings.Contains(text, "IdentityAgent") {
+		t.Fatalf("SSHConfigText() = %q, want no agent, so ssh uses the session agent", text)
+	}
+
+	if !strings.Contains(text, "User phial") {
+		t.Fatalf("SSHConfigText() = %q, want the guest user", text)
+	}
+}
+
+func TestApplySSHKeysWithoutKeys(t *testing.T) {
+	got := string(ApplySSHKeys([]byte("@PHIAL_SSH_KEYS@\n"), nil))
+
+	if got != "\n" {
+		t.Fatalf("ApplySSHKeys() = %q, want an empty line", got)
+	}
+}
