+func (a *App) confirmDeleteMachine() {
+	a.withMachine(func(def virt.Definition) {
+		removeDisk := false
+
+		diskRow := a.switchRow(
+			"Delete the Disk Image",
+			"The disk holds the system and every file of the machine",
+			false,
+			func(value bool) { removeDisk = value },
+		)
+
+		// A boxed list keeps the row intact inside the small extra area of an
+		// alert dialog.
+		diskList := gtk.NewListBox()
+		diskList.SetSelectionMode(gtk.SelectionNoneValue)
+		diskList.AddCssClass("boxed-list")
+		diskList.Append(&diskRow.PreferencesRow.ListBoxRow.Widget)
+
+		a.confirmDestructive(
+			"Delete the machine?",
+			fmt.Sprintf(
+				i18n.L("This removes the definition of %s. The disk image stays on disk unless you ask for its removal."),
+				def.Name,
+			),
+			"_Delete",
+			&diskList.Widget,
+			func() {
+				a.goAsync(func() (string, error) {
+					if _, _, err := a.Service.VmDelete(a.Ctx, nil, mcp.VmDeleteInput{
+						Name:       def.Name,
+						DeleteDisk: removeDisk,
+					}); err != nil {
+						return "", err
+					}
+
+					a.idle(func() {
+						// The reconciler removes the row, the page, and the tag
+						// of a machine that no longer exists.
+						a.refreshSidebar()
+
+						if len(a.machineOrder) > 0 {
+							a.selectPage(machineTagPrefix + a.machineOrder[0])
+						} else {
+							a.selectPage(noMachinesTag)
+						}
+					})
+
+					if removeDisk {
+						return i18n.L("The machine and its disk were deleted"), nil
+					}
+
+					return i18n.L("The machine was deleted"), nil
+				})
+			},
+		)
+	})
+}
