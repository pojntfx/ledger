+	memoryRow.AddSuffix(&a.unitLabel("GiB").Widget)
+
+	diskGiB, err := strconv.Atoi(sizeDigits(def.DiskSize))
+	if err != nil || diskGiB < 8 {
+		diskGiB = 48
+	}
+	diskRow := a.spinRow("Disk Size", float64(diskGiB), 8, 2048, 1, nil)
+	diskRow.AddSuffix(&a.unitLabel("GiB").Widget)
+
+	display := def.Display
+	displayRow := a.comboRow(
+		"Display",
+		[]string{i18n.L("Headless"), i18n.L("Window on this host"), i18n.L("Off")},
+		[]string{"egl-headless", "gtk", "none"},
+		def.Display,
+		func(value string) { display = value },
+	)
+
+	graphics := def.GPU
+	graphicsRow := a.comboRow(
+		"Graphics",
+		[]string{i18n.L("Venus"), i18n.L("VirGL"), i18n.L("Off")},
+		[]string{"venus", "virgl", "none"},
+		def.GPU,
+		func(value string) { graphics = value },
+	)
+
+	audio := def.Audio
+	audioRow := a.comboRow(
+		"Audio",
+		[]string{i18n.L("Off"), i18n.L("On")},
+		[]string{"none", "hda"},
+		def.Audio,
+		func(value string) { audio = value },
+	)
+
+	secureBoot := def.SecureBoot
+	secureBootRow := a.switchRow("Secure Boot", "Turn this off only when a Machine Owner Key cannot be enrolled", def.SecureBoot, func(value bool) {
+		secureBoot = value
+	})
+
+	hugePages := def.HugePages
+	hugePagesRow := a.switchRow("Huge Pages", hugePagesDetail(def.Memory), def.HugePages, func(value bool) {
+		hugePages = value
+	})
+
+	localNetwork := def.NetLAN
+	localNetworkRow := a.comboRow(
+		"Local Network",
+		[]string{i18n.L("Bridge when available"), i18n.L("Bridge only"), i18n.L("Off")},
+		[]string{"auto", "on", "off"},
+		def.NetLAN,
+		func(value string) { localNetwork = value },
+	)
+
+	fallbackNetwork := def.NetFallback
+	fallbackNetworkRow := a.comboRow(
+		"Fallback Network",
+		[]string{i18n.L("passt"), i18n.L("Socket"), i18n.L("Off")},
+		[]string{"passt", "stream", "off"},
+		def.NetFallback,
+		func(value string) { fallbackNetwork = value },
+	)
+
+	identity := formGroup("Identity", "", &nameRow.Widget)
+
+	resources := formGroup("Resources", "", &coreRow.Widget, &memoryRow.Widget, &diskRow.Widget)
+
+	platform := formGroup("Display", "", &displayRow.row.Widget, &graphicsRow.row.Widget, &audioRow.row.Widget)
+
+	security := formGroup("Security", "", &secureBootRow.Widget, &hugePagesRow.Widget)
+
+	network := formGroup("Network", "", &localNetworkRow.row.Widget, &fallbackNetworkRow.row.Widget)
+
+	content := a.formPage(identity, resources, platform, security, network)
+
+	dialog := a.dialog(scope, "Machine Settings", def.Name, "_Save", content, func() bool {
+		newName := strings.TrimSpace(nameRow.GetText())
+		if !validMachineName(newName) {
+			a.toast(i18n.L("Give a name without spaces"))
+			return false
+		}
+
+		vcpus := int(coreRow.GetValue())
+		secure := secureBoot
+		memory := strconv.Itoa(int(memoryRow.GetValue())) + "G"
+		diskSize := strconv.Itoa(int(diskRow.GetValue())) + "G"
+
+		input := mcp.VmUpdateInput{
+			Name:       def.Name,
+			Display:    display,
+			GPU:        graphics,
+			VCPUs:      &vcpus,
+			Memory:     memory,
+			DiskSize:   diskSize,
+			SecureBoot: &secure,
+		}
+
+		if newName != def.Name {
+			input.NewName = newName
+		}
+
+		a.goAsync(func() (string, error) {
+			if _, _, err := a.Service.VmUpdate(a.Ctx, nil, input); err != nil {
+				return "", err
+			}
+
+			target := def.Name
+			if input.NewName != "" {
+				target = input.NewName
+			}
+
+			current, err := virt.Load(target)
+			if err != nil {
+				return "", err
+			}
+
+			current.HugePages = hugePages
+			current.NetLAN = localNetwork
+			current.NetFallback = fallbackNetwork
+			current.Audio = audio
+
+			if err := current.Save(); err != nil {
+				return "", err
+			}
+
+			a.idle(func() {
+				if page := a.machinePages[def.Name]; page != nil {
+					a.content.Remove(page.page)
+					delete(a.machinePages, def.Name)
+				}
+				if item := a.machineItems[def.Name]; item != nil {
+					a.machinesSection.Remove(item)
+					delete(a.machineItems, def.Name)
+				}
+
+				a.refreshSidebar()
+				a.selectPage(machineTagPrefix + target)
+			})
+
+			return i18n.L("The machine was updated"), nil
+		})
+
+		return true
+	})
+
+	validate := func() { scope.setValid(validMachineName(nameRow.GetText())) }
+	a.onEntryChanged(nameRow, validate)
+	validate()
+
+	a.present(dialog, scope)
+}
+
+func sizeDigits(size string) string {
+	value := strings.TrimSpace(size)
+
+	for _, unit := range []string{"K", "k", "M", "m", "G", "g", "T", "t"} {
+		value = strings.TrimSuffix(value, unit)
+	}
+
+	return strings.TrimSpace(value)
+}
