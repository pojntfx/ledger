diff --git a/internal/ui/providers.go b/internal/ui/providers.go
new file mode 100644
index 0000000000000000000000000000000000000000..65a3e867953ad4ba8f32893686fbbd3063b5c045
--- /dev/null
+++ b/internal/ui/providers.go
@@ -0,0 +1,551 @@
+package ui
+
+import (
+	"fmt"
+	"strings"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gio"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+
+	"codeberg.org/pojntfx/phial-neo/assets/resources"
+	"codeberg.org/pojntfx/phial-neo/internal/mcp"
+	"codeberg.org/pojntfx/phial-neo/internal/state"
+)
+
+// providerPage is the page of one provider.
+type providerPage struct {
+	app  *App
+	name string
+	page *adw.NavigationPage
+
+	title       *adw.WindowTitle
+	modeRow     *adw.ActionRow
+	sourceRow   *adw.ActionRow
+	upstreamRow *adw.ActionRow
+	accessRow   *adw.ActionRow
+	grantRow    *adw.ButtonRow
+	revokeRow   *adw.ButtonRow
+}
+
+func (a *App) buildProvidersPage() *adw.NavigationPage {
+	stack := gtk.NewStack()
+	stack.SetTransitionType(gtk.StackTransitionTypeCrossfadeValue)
+	a.providersStack = stack
+
+	a.providersEmpty = a.statusPage(
+		"dialog-password-symbolic",
+		"No Providers",
+		"A provider names one secret in your password store. A machine sees the secret only while a grant is open.",
+	)
+	a.providersEmptyButton = a.labelButton("_Add Provider", func() { a.activate("add-provider") })
+	a.providersEmptyButton.AddCssClass("suggested-action")
+	a.providersEmptyButton.AddCssClass("pill")
+	a.providersEmptyButton.SetHalign(gtk.AlignCenterValue)
+	a.providersEmpty.SetChild(&a.providersEmptyButton.Widget)
+
+	stack.AddNamed(&a.providersEmpty.Widget, "empty")
+
+	a.providersGroup = adw.NewPreferencesGroup()
+
+	actions := adw.NewPreferencesGroup()
+	a.providersSyncRow = a.buttonRow("_Sync Secrets", "view-refresh-symbolic", func() {
+		a.syncSecrets()
+	})
+	actions.Add(&a.providersSyncRow.Widget)
+	a.providersAddRow = a.buttonRow("_Add Provider", "list-add-symbolic", func() {
+		a.activate("add-provider")
+	})
+	actions.Add(&a.providersAddRow.Widget)
+
+	pageContent := a.pageContent(a.providersGroup, actions)
+	stack.AddNamed(pageContent, "list")
+
+	page_, _, title := a.pageToolbar("Providers", "", &stack.Widget)
+
+	page_.SetTag(providersTag)
+	title.SetTitle(i18n.L("Providers"))
+
+	return page_
+}
+
+// refreshProvidersPage reconciles the provider rows with the mapping file.
+func (a *App) refreshProvidersPage() {
+	rows, err := a.State.Rows()
+	if err != nil {
+		a.Log.Error("could not read the providers", "err", err)
+		return
+	}
+
+	signature := ""
+	for _, row := range rows {
+		signature += row.Name + "|" + row.Mode + "|" + row.Source + "|" + row.Upstream + ";"
+	}
+
+	if signature == a.providersSignature {
+		return
+	}
+	a.providersSignature = signature
+
+	for _, row := range a.providerRows {
+		a.providersGroup.Remove(&row.Widget)
+	}
+	a.providerRows = nil
+
+	if len(rows) == 0 {
+		a.providersStack.SetVisibleChildName("empty")
+		return
+	}
+
+	a.providersStack.SetVisibleChildName("list")
+
+	for _, entry := range rows {
+		entry := entry
+
+		row := adw.NewActionRow()
+		row.SetTitle(entry.Name)
+		row.SetSubtitle(providerSubtitle(a, entry))
+		row.SetActivatable(true)
+		row.AddSuffix(&gtk.NewImageFromIconName("go-next-symbolic").Widget)
+
+		var cb func(adw.ActionRow)
+		cb = func(adw.ActionRow) {
+			page := a.ensureProviderPage(entry.Name)
+			a.ensureInView(page.page)
+			a.content.PushByTag(providerTagPrefix + entry.Name)
+		}
+		row.ConnectActivated(&cb)
+		a.hold(&cb)
+
+		a.providersGroup.Add(&row.Widget)
+		a.providerRows = append(a.providerRows, row)
+	}
+}
+
+func providerSubtitle(a *App, row state.Row) string {
+	mode := i18n.L("Env")
+	if row.Mode == "proxy" {
+		mode = i18n.L("Proxy")
+	}
+
+	detail := mode + ", " + row.Source
+	if row.Mode == "proxy" && row.Upstream != "" && row.Upstream != "-" {
+		detail = mode + ", " + row.Upstream
+	}
+
+	if grant := a.State.GrantInfo(row.Name); grant != nil {
+		remaining := grant.ExpiresUnix - nowUnix()
+		if remaining > 0 {
+			return detail + ", " + fmt.Sprintf(i18n.L("granted for %s"), durationText(remaining))
+		}
+	}
+
+	return detail
+}
+
+// ensureProviderPage builds the page of a provider on first use.
+func (a *App) ensureProviderPage(name string) *providerPage {
+	if page := a.providerPages[name]; page != nil {
+		return page
+	}
+
+	page := a.buildProviderPage(name)
+	a.providerPages[name] = page
+	a.content.Add(page.page)
+	a.refreshProviderPage(name)
+
+	return page
+}
+
+func (a *App) buildProviderPage(name string) *providerPage {
+	p := &providerPage{app: a, name: name}
+
+	content := adw.NewPreferencesPage()
+
+	secretGroup := adw.NewPreferencesGroup()
+	secretGroup.SetTitle(i18n.L("Secret"))
+	secretGroup.SetDescription(i18n.L("Phial never shows the value of a secret."))
+
+	p.modeRow = a.propertyRow("Mode", "")
+	p.sourceRow = a.propertyRow("Source", "")
+	p.upstreamRow = a.propertyRow("Upstream", "")
+	secretGroup.Add(&p.modeRow.Widget)
+	secretGroup.Add(&p.sourceRow.Widget)
+	secretGroup.Add(&p.upstreamRow.Widget)
+	content.Add(secretGroup)
+
+	grantGroup := adw.NewPreferencesGroup()
+	grantGroup.SetTitle(i18n.L("Grant"))
+	grantGroup.SetDescription(i18n.L("The timer belongs to the system, so a grant ends even when Phial is closed."))
+
+	p.accessRow = a.propertyRow("Access", "")
+	grantGroup.Add(&p.accessRow.Widget)
+
+	p.grantRow = a.buttonRow("_Grant Access…", "object-select-symbolic", func() {
+		a.activate("grant-access")
+	})
+	grantGroup.Add(&p.grantRow.Widget)
+
+	p.revokeRow = a.buttonRow("_Revoke Access", "window-close-symbolic", func() {
+		a.activate("revoke-access")
+	})
+	p.revokeRow.AddCssClass("destructive-action")
+	grantGroup.Add(&p.revokeRow.Widget)
+
+	content.Add(grantGroup)
+
+	page, header, title := a.pageToolbar(name, i18n.L("Provider"), a.pageContent(secretGroup, grantGroup))
+	page.SetTag(providerTagPrefix + name)
+	p.page = page
+	p.title = title
+
+	// One flat list keeps the destructive entry last.
+	menu := gio.NewMenu()
+	menu.Append(i18n.L("_Edit Provider…"), "app.edit-provider")
+	menu.Append(i18n.L("_Remove Provider…"), "app.remove-provider")
+
+	menuButton := gtk.NewMenuButton()
+	menuButton.SetIconName("view-more-symbolic")
+	menuButton.SetTooltipText(i18n.L("Provider Menu"))
+	menuButton.SetMenuModel(&menu.MenuModel)
+	header.PackEnd(&menuButton.Widget)
+
+	return p
+}
+
+func (a *App) refreshProviderPage(name string) {
+	page := a.providerPages[name]
+	if page == nil {
+		return
+	}
+
+	rows, err := a.State.Rows()
+	if err != nil {
+		return
+	}
+
+	var entry *state.Row
+	for index := range rows {
+		if rows[index].Name == name {
+			entry = &rows[index]
+			break
+		}
+	}
+
+	if entry == nil {
+		return
+	}
+
+	mode := i18n.L("Env")
+	if entry.Mode == "proxy" {
+		mode = i18n.L("Proxy")
+	}
+
+	page.modeRow.SetSubtitle(mode)
+	page.sourceRow.SetSubtitle(entry.Source)
+
+	if entry.Mode == "proxy" {
+		page.upstreamRow.SetVisible(true)
+		page.upstreamRow.SetSubtitle(entry.Upstream)
+	} else {
+		page.upstreamRow.SetVisible(false)
+	}
+
+	grant := a.State.GrantInfo(name)
+	if grant != nil {
+		remaining := grant.ExpiresUnix - nowUnix()
+		if remaining > 0 {
+			page.accessRow.SetSubtitle(fmt.Sprintf(
+				i18n.L("Granted as %s for another %s"),
+				grant.Kind,
+				durationText(remaining),
+			))
+			page.grantRow.SetVisible(true)
+			page.grantRow.SetTitle(i18n.L("_Extend the Grant…"))
+			page.revokeRow.SetVisible(true)
+			return
+		}
+	}
+
+	page.accessRow.SetSubtitle(i18n.L("Not granted"))
+	page.grantRow.SetVisible(true)
+	page.grantRow.SetTitle(i18n.L("_Grant Access…"))
+	page.revokeRow.SetVisible(false)
+}
+
+// refreshGrants keeps the countdowns in step.
+func (a *App) refreshGrants() {
+	for name := range a.providerPages {
+		a.refreshProviderPage(name)
+	}
+	a.refreshProvidersPage()
+	a.refreshCounts()
+}
+
+func (a *App) showProviderDialog(name string) {
+	scope := a.newScope()
+
+	nameRow := adw.NewEntryRow()
+	nameRow.SetTitle(i18n.L("_Name"))
+	nameRow.SetUseUnderline(true)
+	nameRow.SetShowApplyButton(false)
+	nameRow.GrabFocus()
+
+	mode := "env"
+	upstreamRow := adw.NewEntryRow()
+	upstreamRow.SetTitle(i18n.L("_Upstream URL"))
+	upstreamRow.SetUseUnderline(true)
+	upstreamRow.SetShowApplyButton(false)
+
+	sourceRow := adw.NewEntryRow()
+	sourceRow.SetTitle(i18n.L("_Source"))
+	sourceRow.SetUseUnderline(true)
+	sourceRow.SetShowApplyButton(false)
+	sourceRow.SetText("keepassxc://")
+
+	sourceHint := adw.NewActionRow()
+	sourceHint.SetTitle(i18n.L("keepassxc://name"))
+	sourceHint.SetSubtitle(i18n.L("The entry in KeePassXC whose attribute phial is set to this name"))
+	sourceHint.AddCssClass("property")
+
+	modeRow := a.comboRow(
+		"Mode",
+		[]string{i18n.L("Env, the machine reads a file"), i18n.L("Proxy, the host injects the value")},
+		[]string{"env", "proxy"},
+		"env",
+		func(value string) {
+			mode = value
+			upstreamRow.SetVisible(value == "proxy")
+		},
+	)
+	upstreamRow.SetVisible(false)
+
+	identity := formGroup("Provider", "", &nameRow.Widget)
+	identity.Add(&modeRow.row.Widget)
+	identity.Add(&sourceRow.Widget)
+	identity.Add(&upstreamRow.Widget)
+	identity.Add(&sourceHint.Widget)
+
+	content := a.formPage(identity)
+
+	if name != "" {
+		if rows, err := a.State.Rows(); err == nil {
+			for _, row := range rows {
+				if row.Name != name {
+					continue
+				}
+				nameRow.SetText(row.Name)
+				nameRow.SetEditable(false)
+				sourceRow.SetText(row.Source)
+				upstreamRow.SetText(row.Upstream)
+				if row.Mode == "proxy" {
+					upstreamRow.SetVisible(true)
+				}
+			}
+		}
+	}
+
+	dialog := a.dialog(scope, "Add a Provider", i18n.L("One secret from your password store"), "_Add", content, func() bool {
+		provider := strings.TrimSpace(nameRow.GetText())
+		source := strings.TrimSpace(sourceRow.GetText())
+
+		if provider == "" || !strings.HasPrefix(source, "keepassxc://") {
+			a.toast(i18n.L("A name and a keepassxc:// source are required"))
+			return false
+		}
+
+		upstream := "-"
+		if mode == "proxy" {
+			upstream = strings.TrimSpace(upstreamRow.GetText())
+			if upstream == "" {
+				a.toast(i18n.L("A proxy provider needs an upstream URL"))
+				return false
+			}
+		}
+
+		a.goAsync(func() (string, error) {
+			if err := a.State.AddProvider(state.Row{
+				Name:     provider,
+				Mode:     mode,
+				Source:   source,
+				Upstream: upstream,
+			}); err != nil {
+				return "", err
+			}
+
+			a.idle(func() {
+				a.refreshProvidersPage()
+				a.refreshCounts()
+			})
+
+			return i18n.L("The provider was added"), nil
+		})
+
+		return true
+	})
+
+	if name != "" {
+		dialog.SetTitle(i18n.L("Edit Provider"))
+	}
+
+	validate := func() {
+		scope.setValid(providerFormValid(nameRow, sourceRow))
+	}
+
+	a.onEntryChanged(nameRow, validate)
+	a.onEntryChanged(sourceRow, validate)
+	validate()
+
+	a.present(dialog, scope)
+}
+
+// providerFormValid reports whether the provider form carries a name and a
+// password store source.
+func providerFormValid(nameRow *adw.EntryRow, sourceRow *adw.EntryRow) bool {
+	provider := strings.TrimSpace(nameRow.GetText())
+	source := strings.TrimSpace(sourceRow.GetText())
+
+	return provider != "" && strings.HasPrefix(source, "keepassxc://")
+}
+
+func (a *App) confirmRemoveProvider(name string) {
+	dialog := adw.NewAlertDialog(
+		i18n.L("Remove the provider?"),
+		fmt.Sprintf(i18n.L("This removes %s and revokes its grants. The entry in your password store stays."), name),
+	)
+	dialog.AddResponse("cancel", i18n.L("_Cancel"))
+	dialog.AddResponse("remove", i18n.L("_Remove"))
+	dialog.SetResponseAppearance("remove", adw.ResponseDestructiveValue)
+	dialog.SetCloseResponse("cancel")
+
+	var cb func(adw.AlertDialog, string)
+	cb = func(_ adw.AlertDialog, response string) {
+		if response != "remove" {
+			return
+		}
+
+		a.goAsync(func() (string, error) {
+			if err := a.State.RemoveProvider(name); err != nil {
+				return "", err
+			}
+
+			a.idle(func() {
+				if page := a.providerPages[name]; page != nil {
+					a.content.Remove(page.page)
+					delete(a.providerPages, name)
+				}
+				a.content.PopToTag(providersTag)
+				a.refreshProvidersPage()
+				a.refreshCounts()
+			})
+
+			return i18n.L("The provider was removed"), nil
+		})
+	}
+	dialog.ConnectResponse(&cb)
+	a.hold(&cb)
+
+	dialog.Present(&a.win.Widget)
+}
+
+func (a *App) showGrantDialog(name string) {
+	scope := a.newScope()
+
+	durations := []string{"15min", "1h", "4h", "1d"}
+	kinds := []string{"api-key", "ssh-key", "gpg-key"}
+
+	currentDuration := a.Settings.GetString(resources.SettingGrantDurationKey)
+	currentKind := a.Settings.GetString(resources.SettingGrantKindKey)
+
+	durationRow := a.comboRow(
+		"Duration",
+		[]string{i18n.L("15 minutes"), i18n.L("1 hour"), i18n.L("4 hours"), i18n.L("1 day")},
+		durations,
+		currentDuration,
+		func(value string) { currentDuration = value },
+	)
+
+	kindRow := a.comboRow(
+		"Kind",
+		[]string{i18n.L("API key"), i18n.L("SSH key"), i18n.L("GnuPG key")},
+		kinds,
+		currentKind,
+		func(value string) { currentKind = value },
+	)
+
+	group := formGroup(
+		"Grant",
+		"The grant ends on its own when the time runs out. An SSH key is loaded into a dedicated agent with a confirmation prompt on this host.",
+		&durationRow.row.Widget,
+		&kindRow.row.Widget,
+	)
+
+	content := a.formPage(group)
+
+	dialog := a.dialog(scope, "Grant Access", name, "_Grant", content, func() bool {
+		duration := currentDuration
+		kind := currentKind
+
+		a.goAsync(func() (string, error) {
+			if _, _, err := a.Service.GrantAllow(a.Ctx, nil, mcp.GrantInput{
+				Name:     name,
+				Kind:     kind,
+				Duration: duration,
+			}); err != nil {
+				return "", err
+			}
+
+			a.idle(func() {
+				a.refreshProviderPage(name)
+				a.refreshProvidersPage()
+				a.refreshCounts()
+			})
+
+			return i18n.L("The secret is granted"), nil
+		})
+
+		return true
+	})
+
+	// The two lists always carry a value, so the form is complete.
+	scope.setValid(grantIsReady(currentDuration, currentKind))
+
+	a.present(dialog, scope)
+}
+
+// grantIsReady reports whether the grant dialog carries a duration and a kind.
+func grantIsReady(duration string, kind string) bool {
+	return duration != "" && kind != ""
+}
+
+func (a *App) revokeGrant(name string) {
+	a.goAsync(func() (string, error) {
+		if _, _, err := a.Service.GrantRevoke(a.Ctx, nil, mcp.NameInput{Name: name}); err != nil {
+			return "", err
+		}
+
+		a.idle(func() {
+			a.refreshProviderPage(name)
+			a.refreshProvidersPage()
+			a.refreshCounts()
+		})
+
+		return i18n.L("The grant was revoked"), nil
+	})
+}
+
+func (a *App) syncSecrets() {
+	a.goAsync(func() (string, error) {
+		if err := a.State.Sync(); err != nil {
+			return "", err
+		}
+
+		a.idle(func() {
+			a.refreshProvidersPage()
+			a.refreshCounts()
+		})
+
+		return i18n.L("The secrets are in sync"), nil
+	})
+}
diff --git a/internal/ui/requests.go b/internal/ui/requests.go
new file mode 100644
index 0000000000000000000000000000000000000000..62c0fabb8e4f6dbeb4dd5fc2b558f10e3c7ad73d
--- /dev/null
+++ b/internal/ui/requests.go
@@ -0,0 +1,112 @@
+package ui
+
+import (
+	"fmt"
+	"time"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+)
+
+func (a *App) buildRequestsPage() *adw.NavigationPage {
+	stack := gtk.NewStack()
+	stack.SetTransitionType(gtk.StackTransitionTypeCrossfadeValue)
+	a.requestsStack = stack
+
+	empty := a.statusPage(
+		"object-select-symbolic",
+		"No Pending Requests",
+		"An agent inside a machine asks here for a provider, a grant, or a device. A request that nobody answers within five minutes counts as denied.",
+	)
+	stack.AddNamed(&empty.Widget, "empty")
+
+	a.requestsGroup = adw.NewPreferencesGroup()
+	a.requestsGroup.SetTitle(i18n.L("Pending Requests"))
+
+	stack.AddNamed(a.pageContent(a.requestsGroup), "list")
+
+	page_, _, _ := a.pageToolbar("Requests", "", &stack.Widget)
+
+	page_.SetTag(requestsTag)
+
+	return page_
+}
+
+// refreshRequests rebuilds the request list only when it changes.
+func (a *App) refreshRequests() {
+	pending := a.Service.Pending()
+
+	signature := "empty"
+	for _, request := range pending {
+		signature += fmt.Sprintf("%s:%d;", request.ID, int64(time.Since(request.Created).Seconds())/15)
+	}
+
+	if signature == a.requestsSignature {
+		return
+	}
+
+	changing := signature != a.requestsSignature
+	a.requestsSignature = signature
+
+	if changing {
+		for _, row := range a.requestRows {
+			a.requestsGroup.Remove(&row.Widget)
+		}
+		a.requestRows = nil
+	}
+
+	if len(pending) == 0 {
+		a.requestsStack.SetVisibleChildName("empty")
+		return
+	}
+
+	a.requestsStack.SetVisibleChildName("list")
+
+	for _, request := range pending {
+		request := request
+
+		row := adw.NewActionRow()
+		row.SetTitle(request.Action)
+		row.SetSubtitle(fmt.Sprintf(
+			i18n.L("%s, %s ago"),
+			request.Detail,
+			durationText(int64(time.Since(request.Created).Seconds())),
+		))
+
+		deny := a.iconButton("window-close-symbolic", i18n.L("Deny"), func() {
+			a.answerRequest(request.ID, false)
+		})
+		deny.AddCssClass("destructive-action")
+
+		approve := a.iconButton("object-select-symbolic", i18n.L("Approve"), func() {
+			a.answerRequest(request.ID, true)
+		})
+		approve.AddCssClass("suggested-action")
+
+		row.AddSuffix(&deny.Widget)
+		row.AddSuffix(&approve.Widget)
+
+		a.requestsGroup.Add(&row.Widget)
+		a.requestRows = append(a.requestRows, row)
+	}
+}
+
+func (a *App) answerRequest(id string, approve bool) {
+	a.goAsync(func() (string, error) {
+		if err := a.Service.Answer(id, approve); err != nil {
+			return "", err
+		}
+
+		a.idle(func() {
+			a.refreshRequests()
+			a.refreshCounts()
+		})
+
+		if approve {
+			return i18n.L("The request was approved"), nil
+		}
+
+		return i18n.L("The request was denied"), nil
+	})
+}
diff --git a/internal/ui/shares.go b/internal/ui/shares.go
new file mode 100644
index 0000000000000000000000000000000000000000..ddfb2cd90e5f60a3a4a679bd39d6e18dceff440a
--- /dev/null
+++ b/internal/ui/shares.go
@@ -0,0 +1,183 @@
+package ui
+
+import (
+	"net/url"
+	"strings"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+	"github.com/rymdport/portal/filechooser"
+
+	"codeberg.org/pojntfx/phial-neo/internal/mcp"
+	"codeberg.org/pojntfx/phial-neo/internal/virt"
+)
+
+// refreshShares reconciles the share rows with the definition.
+func (a *App) refreshShares(page *machinePage) {
+	if sameStrings(page.shareNames, page.def.Shares) {
+		for index, row := range page.shareRows {
+			share := page.def.Shares[index]
+			row.SetTitle(share)
+			row.SetSubtitle(shareSubtitle(page.def, share))
+		}
+		return
+	}
+
+	page.sharesGroup.Remove(&page.addShareRow.Widget)
+	for _, row := range page.shareRows {
+		page.sharesGroup.Remove(&row.Widget)
+	}
+	page.shareRows = nil
+
+	for _, share := range page.def.Shares {
+		share := share
+
+		row := adw.NewActionRow()
+		row.SetTitle(share)
+		row.SetSubtitle(shareSubtitle(page.def, share))
+		row.SetSubtitleSelectable(true)
+
+		remove := a.iconButton("user-trash-symbolic", i18n.L("Stop Sharing"), func() {
+			a.goAsync(func() (string, error) {
+				if _, _, err := a.Service.ShareRemove(a.Ctx, nil, mcp.ShareInput{Name: page.def.Name, Path: share}); err != nil {
+					return "", err
+				}
+
+				a.idle(func() {
+					if def, err := virt.Load(page.def.Name); err == nil {
+						page.def = def
+						a.refreshShares(page)
+					}
+				})
+
+				return i18n.L("The folder is no longer shared"), nil
+			})
+		})
+		row.AddSuffix(&remove.Widget)
+		page.sharesGroup.Add(&row.Widget)
+		page.shareRows = append(page.shareRows, row)
+	}
+
+	page.shareNames = append(page.shareNames[:0], page.def.Shares...)
+	page.shareEmpty.SetVisible(len(page.def.Shares) == 0)
+	page.sharesGroup.Add(&page.addShareRow.Widget)
+}
+
+func shareSubtitle(def virt.Definition, share string) string {
+	target := def.ShareTarget(share)
+	if def.ShareReadOnly(share) {
+		return i18n.L("Read-only") + ", " + target
+	}
+	return target
+}
+
+func (a *App) showShareDialog(def virt.Definition) {
+	go func() {
+		paths, err := filechooser.OpenFile("", i18n.L("Share a Folder"), &filechooser.OpenFileOptions{
+			Directory:   true,
+			AcceptLabel: i18n.L("_Share"),
+		})
+		if err != nil {
+			a.idle(func() { a.showError(err) })
+			return
+		}
+
+		if len(paths) == 0 {
+			return
+		}
+
+		path, err := filePathFromURI(paths[0])
+		if err != nil {
+			a.idle(func() { a.showError(err) })
+			return
+		}
+
+		a.idle(func() { a.showShareTargetDialog(def, path) })
+	}()
+}
+
+func filePathFromURI(uri string) (string, error) {
+	if !strings.HasPrefix(uri, "file://") {
+		return uri, nil
+	}
+
+	parsed, err := url.Parse(uri)
+	if err != nil {
+		return "", err
+	}
+
+	path, err := url.PathUnescape(parsed.Path)
+	if err != nil {
+		return "", err
+	}
+
+	return path, nil
+}
+
+func (a *App) showShareTargetDialog(def virt.Definition, path string) {
+	scope := a.newScope()
+
+	target := adw.NewEntryRow()
+	target.SetTitle(i18n.L("_Mount Point in the Machine"))
+	target.SetUseUnderline(true)
+	target.SetShowApplyButton(false)
+	target.SetText("/mnt/" + virt.ShareTag(path))
+	target.AddCssClass("monospace")
+
+	readOnly := false
+
+	group := formGroup("Mount Point", "The folder appears in the machine at this path.", &target.Widget)
+
+	readOnlyRow := a.switchRow("Read-only", "The machine cannot change the files", false, func(value bool) {
+		readOnly = value
+	})
+	group.Add(&readOnlyRow.Widget)
+
+	detail := adw.NewActionRow()
+	detail.SetTitle(i18n.L("Host Folder"))
+	detail.SetSubtitle(path)
+	detail.SetSubtitleSelectable(true)
+	detail.AddCssClass("property")
+
+	detailGroup := formGroup("Host Folder", "", &detail.Widget)
+
+	content := a.formPage(detailGroup, group)
+
+	dialog := a.dialog(scope, "Share a Folder", def.Name, "_Share", content, func() bool {
+		mount := strings.TrimSpace(target.GetText())
+		if mount == "" {
+			a.toast(i18n.L("Enter a mount point first"))
+			return false
+		}
+
+		a.goAsync(func() (string, error) {
+			if _, _, err := a.Service.ShareAdd(a.Ctx, nil, mcp.ShareInput{
+				Name:     def.Name,
+				Path:     path,
+				Target:   mount,
+				ReadOnly: readOnly,
+			}); err != nil {
+				return "", err
+			}
+
+			a.idle(func() {
+				if page := a.machinePages[def.Name]; page != nil {
+					if current, err := virt.Load(def.Name); err == nil {
+						page.def = current
+						a.refreshShares(page)
+					}
+				}
+			})
+
+			return i18n.L("The folder is shared"), nil
+		})
+
+		return true
+	})
+
+	validate := func() { scope.setValid(strings.TrimSpace(target.GetText()) != "") }
+	a.onEntryChanged(target, validate)
+	validate()
+
+	a.present(dialog, scope)
+}
diff --git a/internal/ui/system.go b/internal/ui/system.go
new file mode 100644
index 0000000000000000000000000000000000000000..16585e26e5cb50a07d2dc0d245662dbccd745945
--- /dev/null
+++ b/internal/ui/system.go
@@ -0,0 +1,136 @@
+package ui
+
+import (
+	"strconv"
+	"strings"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+
+	"codeberg.org/pojntfx/phial-neo/internal/mcp"
+	"codeberg.org/pojntfx/phial-neo/internal/virt"
+)
+
+// statusOK reports whether a status item looks healthy.
+func statusOK(item mcp.StatusItem) bool {
+	value := strings.ToLower(strings.TrimSpace(item.Value))
+
+	switch value {
+	case "present", "active", "up":
+		return true
+	case "", "missing", "inactive", "down", "unknown", "none":
+		return false
+	}
+
+	if count, err := strconv.Atoi(value); err == nil {
+		return count > 0
+	}
+
+	return false
+}
+
+func (a *App) showSystemSetupDialog() {
+	scope := a.newScope()
+
+	statusGroup := adw.NewPreferencesGroup()
+	statusGroup.SetTitle(i18n.L("Requirements"))
+	statusGroup.SetDescription(i18n.L("Phial needs huge pages, memory lock, udev rules, a bridge, and three user services on this host."))
+
+	loadingRow := adw.NewActionRow()
+	loadingRow.SetTitle(i18n.L("Reading the host state"))
+	spinner := adw.NewSpinner()
+	spinner.SetVisible(true)
+	loadingRow.AddPrefix(&spinner.Widget)
+	statusGroup.Add(&loadingRow.Widget)
+
+	actionGroup := adw.NewPreferencesGroup()
+	actionGroup.SetDescription(i18n.L("Phial writes system files and asks your desktop for administrator approval."))
+
+	hugePagesRow := adw.NewActionRow()
+	hugePagesRow.SetTitle(i18n.L("Huge Pages"))
+	hugePagesRow.SetSubtitle(hugePagesDetail(""))
+	hugePagesRow.AddCssClass("property")
+	hugePagesRow.SetSubtitleSelectable(true)
+	statusGroup.Add(&hugePagesRow.Widget)
+
+	detail := adw.NewActionRow()
+	detail.SetTitle(i18n.L("Applies"))
+	detail.SetSubtitle(i18n.L("Huge pages, the memory lock limit, the udev rules for USB and vfio, and the bridge with the tap device"))
+	detail.AddCssClass("property")
+	actionGroup.Add(&detail.Widget)
+
+	actionGroup.Add(&a.buttonRow("_Apply System Setup", "system-run-symbolic", func() {
+		a.applySystemSetup()
+	}).Widget)
+
+	content := a.formPage(statusGroup, actionGroup)
+	dialog := a.dialog(scope, "System Setup", i18n.L("Host Requirements"), "_Close", content, nil)
+
+	go func() {
+		_, output, err := a.Service.SystemStatus(a.Ctx, nil, struct{}{})
+
+		a.idle(func() {
+			spinner.SetVisible(false)
+
+			if err != nil {
+				loadingRow.SetTitle(i18n.L("The host state could not be read"))
+				loadingRow.SetSubtitle(err.Error())
+				return
+			}
+
+			statusGroup.Remove(&loadingRow.Widget)
+
+			if output == nil {
+				return
+			}
+
+			for _, item := range output.Items {
+				row := adw.NewActionRow()
+				row.SetTitle(item.Name)
+				row.SetSubtitle(item.Value)
+				row.SetSubtitleSelectable(true)
+				row.AddCssClass("property")
+
+				icon := gtk.NewImageFromIconName("object-select-symbolic")
+				if !statusOK(item) {
+					icon = gtk.NewImageFromIconName("dialog-warning-symbolic")
+					icon.AddCssClass("warning")
+				}
+				row.AddPrefix(&icon.Widget)
+
+				statusGroup.Add(&row.Widget)
+			}
+		})
+	}()
+
+	a.present(dialog, scope)
+}
+
+func (a *App) applySystemSetup() {
+	var devices []string
+
+	if defs, err := virt.List(); err == nil {
+		seen := map[string]bool{}
+		for _, def := range defs {
+			for _, device := range def.USBDevices {
+				if seen[device] {
+					continue
+				}
+				seen[device] = true
+				devices = append(devices, device)
+			}
+		}
+	}
+
+	a.goAsync(func() (string, error) {
+		if _, _, err := a.Service.SystemRootSetup(a.Ctx, nil, mcp.RootSetupInput{
+			Memory:  "16G",
+			Devices: devices,
+		}); err != nil {
+			return "", err
+		}
+
+		return i18n.L("The system setup finished"), nil
+	})
+}
diff --git a/internal/ui/util.go b/internal/ui/util.go
new file mode 100644
index 0000000000000000000000000000000000000000..b75182fea6e04dc1f9d914e78b6b0f576b1e0752
--- /dev/null
+++ b/internal/ui/util.go
@@ -0,0 +1,460 @@
+package ui
+
+import (
+	"fmt"
+	"path/filepath"
+	"strings"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gio"
+	"codeberg.org/puregotk/puregotk/v4/glib"
+	"codeberg.org/puregotk/puregotk/v4/gobject"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+
+	"codeberg.org/pojntfx/phial-neo/internal/virt"
+)
+
+// hold keeps a callback alive for the lifetime of the application. The
+// generated bindings register one C trampoline per connected signal, and a Go
+// callback that is dropped would leave that trampoline pointing at freed
+// memory, so every closure that is handed to a widget is kept here.
+func (a *App) hold(callback interface{}) {
+	a.keep = append(a.keep, callback)
+}
+
+func (a *App) idle(fn func()) {
+	var cb glib.SourceOnceFunc
+	cb = func(uintptr) {
+		defer glib.UnrefCallback(&cb)
+		fn()
+	}
+	glib.IdleAddOnce(&cb, 0)
+}
+
+func (a *App) every(seconds uint32, fn func() bool) {
+	var cb glib.SourceFunc
+	cb = func(uintptr) bool {
+		return fn()
+	}
+	a.hold(&cb)
+	glib.TimeoutAddSeconds(seconds, &cb, 0)
+}
+
+func (a *App) toast(text string) {
+	if a.suppressToasts || a.toasts == nil {
+		return
+	}
+	toast := adw.NewToast(text)
+	toast.SetTimeout(4)
+	a.toasts.AddToast(toast)
+}
+
+func (a *App) goAsync(work func() (string, error)) {
+	go func() {
+		message, err := work()
+		a.idle(func() {
+			if err != nil {
+				a.showError(err)
+				return
+			}
+			if message != "" {
+				a.toast(message)
+			}
+		})
+	}()
+}
+
+func (a *App) showError(err error) {
+	if err == nil {
+		return
+	}
+
+	detail := err.Error()
+	a.Log.Error("the action failed", "err", err)
+
+	dialog := adw.NewAlertDialog(i18n.L("The action failed"), detail)
+	dialog.AddResponse("copy", i18n.L("_Copy Error"))
+	dialog.AddResponse("close", i18n.L("_Close"))
+	dialog.SetDefaultResponse("close")
+	dialog.SetCloseResponse("close")
+	dialog.SetBodyUseMarkup(false)
+
+	var cb func(adw.AlertDialog, string)
+	cb = func(_ adw.AlertDialog, response string) {
+		if response == "copy" {
+			a.copyText(detail, i18n.L("Error copied"))
+		}
+	}
+	dialog.ConnectResponse(&cb)
+	a.hold(&cb)
+
+	if a.win != nil {
+		dialog.Present(&a.win.Widget)
+	}
+}
+
+func (a *App) copyText(value string, message string) {
+	if a.win == nil {
+		return
+	}
+	if display := a.win.Widget.GetDisplay(); display != nil {
+		display.GetClipboard().SetText(value)
+	}
+	if message != "" {
+		a.toast(message)
+	}
+}
+
+// iconButton builds a flat icon button for a header bar or a list row.
+// openContainingFolder shows the folder of one file in the file manager.
+func (a *App) openContainingFolder(path string) {
+	file := gio.FileNewForPath(filepath.Dir(path))
+	if file == nil {
+		return
+	}
+
+	if _, err := gio.AppInfoLaunchDefaultForUri(file.GetUri(), nil); err != nil {
+		a.showError(err)
+	}
+}
+
+func (a *App) iconButton(icon string, tooltip string, fn func()) *gtk.Button {
+	button := gtk.NewButton()
+	button.SetIconName(icon)
+	button.SetTooltipText(tooltip)
+	button.SetValign(gtk.AlignCenterValue)
+	button.SetHasFrame(false)
+
+	var cb func(gtk.Button)
