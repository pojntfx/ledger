+	address.AddCssClass("property")
+
+	group := formGroup("Console", "The guest writes its kernel log to this socket.", &address.Widget)
+
+	group.Add(&a.buttonRow("_Open in a Terminal", "utilities-terminal-symbolic", func() {
+		a.openTerminal("socat", "-", "UNIX-CONNECT:"+socket)
+	}).Widget)
+
+	group.Add(&a.buttonRow("_Copy the socat Command", "edit-copy-symbolic", func() {
+		a.copyText(attach, i18n.L("Command copied"))
+	}).Widget)
+
+	content := a.formPage(a.credentialGroup("phial", a.Service.RdpPassword()), group)
