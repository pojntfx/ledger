+// comboRow keeps the selected value in step with the widget and reports every
+// change once.
+type comboRow struct {
+	row      *adw.ComboRow
+	values   []string
+	selected int
+}
+
+func (a *App) comboRow(title string, labels []string, values []string, current string, onChange func(string)) *comboRow {
+	combo := &comboRow{row: adw.NewComboRow(), values: values}
+
+	combo.row.SetTitle(i18n.L(title))
+	combo.row.SetModel(gtk.NewStringList(labels))
+
+	for index, value := range values {
+		if value == current {
+			combo.selected = index
+		}
+	}
+	combo.row.SetSelected(uint32(combo.selected))
+
+	var cb func(gobject.Object, uintptr)
+	cb = func(gobject.Object, uintptr) {
+		next := int(combo.row.GetSelected())
+		if next == combo.selected || next >= len(combo.values) {
+			return
+		}
+		combo.selected = next
+		if onChange != nil {
+			onChange(combo.values[next])
+		}
+	}
+	combo.row.ConnectNotify(&cb)
+	a.hold(&cb)
+
+	return combo
+}
+
+func (c *comboRow) value() string {
+	if c.selected >= len(c.values) {
+		return ""
+	}
+	return c.values[c.selected]
+}
