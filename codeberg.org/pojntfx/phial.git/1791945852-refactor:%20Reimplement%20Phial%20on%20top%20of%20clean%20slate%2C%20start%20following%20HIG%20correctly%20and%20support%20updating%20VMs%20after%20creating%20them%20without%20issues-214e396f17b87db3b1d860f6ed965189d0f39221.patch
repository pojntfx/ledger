+// refreshSidebar reconciles the machine list in the sidebar with the machine
+// definitions on disk. It never builds a page for a machine that the user did
+// not open.
+func (a *App) refreshSidebar() {
+	defs, err := virt.List()
+	if err != nil {
+		a.Log.Error("could not list the machines", "err", err)
+		return
+	}
+
+	sort.Slice(defs, func(i int, j int) bool {
+		return defs[i].Name < defs[j].Name
+	})
+
+	exists := map[string]bool{}
+	for _, def := range defs {
+		exists[def.Name] = true
+	}
+
+	// A row leaves with its machine. A section owns the item that it carries,
+	// so a row is never moved between positions.
+	leftTheScreen := false
+
+	for name, item := range a.machineItems {
+		if exists[name] {
+			continue
+		}
+
+		a.machinesSection.Remove(item)
+		delete(a.machineItems, name)
+
+		if page := a.machinePages[name]; page != nil {
+			if a.content.GetVisiblePageTag() == machineTagPrefix+name {
+				leftTheScreen = true
+			}
+
+			a.content.Remove(page.page)
+			delete(a.machinePages, name)
+		}
+	}
+
+	// A new row takes the position that keeps the names, the tags, and the
+	// number shortcuts in one order.
+	a.machineOrder = a.machineOrder[:0]
+	a.sidebarTags = a.sidebarTags[:0]
+
+	for index, def := range defs {
+		a.machineOrder = append(a.machineOrder, def.Name)
+		a.sidebarTags = append(a.sidebarTags, machineTagPrefix+def.Name)
+
+		item := a.machineItems[def.Name]
+		if item == nil {
+			item = adw.NewSidebarItem(def.Name)
+			item.SetIconName("drive-harddisk-symbolic")
+			a.machineItems[def.Name] = item
+			a.machinesSection.Insert(item, int32(index))
+		}
+
+		active, _ := def.Active()
+		ready := false
+		if active {
+			ready = def.Ready()
+		}
+
+		if page := a.machinePages[def.Name]; page != nil {
+			page.setState(active, ready, a.Service.Installing(def.Name), vmInstalled(def))
+			item.SetSubtitle(page.stateText())
+		} else {
+			item.SetSubtitle(stateText(active, ready, a.Service.Installing(def.Name), vmInstalled(def), ""))
+		}
+	}
+
+	// One row stands for the empty page while the list is empty, so the left
+	// column never opens without a way forward. A section disposes the item
+	// that it removes, so the row is built again whenever it goes back in.
+	if len(defs) == 0 {
+		if !a.newMachineItemAttached {
+			// The row names the place where the first machine starts, so the
+			// only label that names the action is the button on the page. It
+			// carries the icon of the machines that will follow it.
+			item := adw.NewSidebarItem(i18n.L("Get Started"))
+			item.SetIconName("drive-harddisk-symbolic")
+			a.machinesSection.Insert(item, 0)
+			a.newMachineItem = item
+			a.newMachineItemAttached = true
+		}
+
+		a.sidebarTags = append(a.sidebarTags, noMachinesTag)
+	} else if a.newMachineItemAttached {
+		a.machinesSection.Remove(a.newMachineItem)
+		a.newMachineItem = nil
+		a.newMachineItemAttached = false
+	}
+
+	// The header carries the create control while a machine exists. The empty
+	// page carries it otherwise, so the control never appears twice.
+	a.newMachineButton.SetVisible(len(defs) > 0)
+
+	a.sidebarTags = append(a.sidebarTags, providersTag, requestsTag, connectionsTag)
+
+	keepSection := len(defs) > 0 || a.newMachineItemAttached
+
+	if !keepSection && a.machinesSectionAttached {
+		a.sidebar.Remove(a.machinesSection)
+		a.machinesSectionAttached = false
+	}
+
+	if keepSection && !a.machinesSectionAttached {
+		a.sidebar.Insert(a.machinesSection, 0)
+		a.machinesSectionAttached = true
+	}
+
+	// The page that is open follows the list. A machine that arrives takes the
+	// screen while the empty page is open, and a machine that leaves gives the
+	// screen to another machine or to the empty page.
+	switch {
+	case (leftTheScreen || a.selected == noMachinesTag) && len(a.machineOrder) > 0:
+		a.selectPage(machineTagPrefix + a.machineOrder[0])
+	case leftTheScreen:
+		a.selectPage(noMachinesTag)
+	}
+}
