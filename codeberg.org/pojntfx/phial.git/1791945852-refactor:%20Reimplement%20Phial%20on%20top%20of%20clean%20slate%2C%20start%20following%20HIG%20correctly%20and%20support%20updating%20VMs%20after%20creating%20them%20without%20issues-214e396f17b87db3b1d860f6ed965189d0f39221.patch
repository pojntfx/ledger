+          description: Source code retrieved successfully
+          content:
+            application/gzip:
+              schema:
+                type: string
+                format: binary
+          headers:
+            Content-Disposition:
+              schema:
+                type: string
+              example: 'attachment; filename="code.tar.gz"'
+        "500":
+          description: An internal error occurred
+          content:
+            text/plain:
+              schema:
+                type: string
