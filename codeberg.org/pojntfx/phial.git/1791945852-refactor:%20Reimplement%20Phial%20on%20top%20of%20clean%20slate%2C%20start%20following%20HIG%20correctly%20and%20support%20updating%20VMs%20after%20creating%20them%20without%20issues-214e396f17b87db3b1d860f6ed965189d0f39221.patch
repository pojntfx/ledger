+	if subtitle != "" {
+		row.SetSubtitle(i18n.L(subtitle))
+	}
+	row.SetActive(active)
+
+	state := active
+
+	var cb func(gobject.Object, uintptr)
+	cb = func(gobject.Object, uintptr) {
+		next := row.GetActive()
+		if next == state {
+			return
+		}
+		state = next
+		if onChange != nil {
+			onChange(next)
+		}
+	}
+	row.ConnectNotify(&cb)
+	a.hold(&cb)
+
+	return row
+}
