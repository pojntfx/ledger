+
+func (a *App) showTerminalDialog(def virt.Definition) {
+	scope := a.newScope()
+
+	group := formGroup(
+		"Connection",
+		"The host alias reaches the machine over vsock, so no network device is needed.",
+	)
+
+	command := adw.NewActionRow()
+	command.SetTitle("ssh " + def.Name)
+	command.SetSubtitle(i18n.L("A host alias that Phial keeps in your SSH configuration"))
