+// vmInstalled treats a disk that carries an installed system as installed. The
+// installer writes far more than a gigabyte, and a fresh disk is allocated but
+// empty.
+func vmInstalled(def virt.Definition) bool {
+	info, err := os.Stat(def.DiskPathValue())
+	if err != nil {
+		return false
+	}
+	return info.Size() > 1024*1024*1024
+}
