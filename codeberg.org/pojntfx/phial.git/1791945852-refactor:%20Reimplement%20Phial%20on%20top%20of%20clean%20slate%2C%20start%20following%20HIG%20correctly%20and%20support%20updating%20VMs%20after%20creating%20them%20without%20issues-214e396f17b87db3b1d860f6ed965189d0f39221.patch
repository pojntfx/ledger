+)
+
+func TestConsoleDetail(t *testing.T) {
+	tests := []struct {
+		name    string
+		content string
+		want    string
+	}{
+		{
+			name:    "takes the last complete line",
+			content: "first line\nsecond line\nstill being written",
+			want:    "second line",
+		},
+		{
+			name:    "removes the colour sequences of the console",
+			content: "[\x1b[0;32m  OK  \x1b[0m] Started the installer\n",
+			want:    "[  OK  ] Started the installer",
+		},
+		{
+			name:    "removes the carriage returns of a progress line",
+			content: "step one\rstep two\n",
+			want:    "step two",
+		},
+		{
+			name:    "keeps the spacing of the console and trims the ends",
+			content: "  Started\tthe   installer  \n",
+			want:    "Started the   installer",
+		},
+		{
+			name:    "states nothing for an empty console",
+			content: "",
+			want:    "",
+		},
+		{
+			name:    "skips an audit record",
+			content: "Finished anaconda-nm-config.service\n" + "[0;32maudit: type=1107 audit(1791933223.897:157): pid=2488 uid=81 msg='avc: denied { send_msg }'[0m\n",
+			want:    "Finished anaconda-nm-config.service",
+		},
+		{
+			name:    "skips a machine record",
+			content: "Starting the installer\nstart=7ed5;user=root;hostname=fedora;machineid=4608;bootid=1\n",
+			want:    "Starting the installer",
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if got := consoleDetail(test.content); got != test.want {
+				t.Fatalf("consoleDetail() = %q, want %q", got, test.want)
+			}
+		})
+	}
+}
+
+func TestConsoleDetailShortensALongLine(t *testing.T) {
+	got := consoleDetail(strings.Repeat("x", 200) + "\n")
+
+	if !strings.HasSuffix(got, "…") || len(got) >= 200 {
+		t.Fatalf("consoleDetail() = %q, want a shortened line", got)
+	}
+}
