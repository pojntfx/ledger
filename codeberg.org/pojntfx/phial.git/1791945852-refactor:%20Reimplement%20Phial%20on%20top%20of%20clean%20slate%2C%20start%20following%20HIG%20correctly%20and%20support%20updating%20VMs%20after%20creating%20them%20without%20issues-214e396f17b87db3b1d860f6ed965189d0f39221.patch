+
+// meaningfulConsoleLine reports whether a console line says what the installer
+// does, so the step of the interface never shows noise or a progress bar.
+func meaningfulConsoleLine(line string) bool {
+	letters := 0
+
+	for _, r := range line {
+		if unicode.IsLetter(r) {
+			letters++
+		}
+	}
+
+	// A line of bars, dots or dashes carries no words.
+	if letters < 4 {
+		return false
+	}
+
+	for _, noise := range consoleNoise {
+		if strings.Contains(line, noise) {
+			return false
+		}
+	}
+
+	return true
+}
+
+// CleanConsole removes the escape sequences and the carriage returns of a
+// console, so its text reads the way the console shows it.
+func CleanConsole(content string) string {
+	lines := strings.Split(content, "\n")
+
+	for index, line := range lines {
+		lines[index] = cleanConsoleLine(line)
+	}
+
+	return strings.Join(lines, "\n")
