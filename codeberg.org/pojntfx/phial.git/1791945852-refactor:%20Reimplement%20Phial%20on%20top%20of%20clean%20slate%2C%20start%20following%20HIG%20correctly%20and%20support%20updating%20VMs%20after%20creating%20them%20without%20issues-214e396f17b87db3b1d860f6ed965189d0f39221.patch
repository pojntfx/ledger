--- /dev/null
+++ b/internal/ui/app.go
@@ -0,0 +1,565 @@
+package ui
+
+import (
+	"context"
+	"fmt"
+	"log/slog"
+	"os"
+	"strconv"
+	"strings"
+	"unsafe"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gio"
+	"codeberg.org/puregotk/puregotk/v4/glib"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+	"github.com/rymdport/portal/background"
+
+	"codeberg.org/pojntfx/phial-neo/assets/resources"
+	"codeberg.org/pojntfx/phial-neo/internal/mcp"
+	"codeberg.org/pojntfx/phial-neo/internal/setup"
+	"codeberg.org/pojntfx/phial-neo/internal/state"
+	"codeberg.org/pojntfx/phial-neo/internal/virt"
+)
+
+// App holds the window, the state, and the agent channel.
+type App struct {
+	Ctx      context.Context
+	Log      *slog.Logger
+	State    *state.Client
+	Service  *mcp.Service
+	Settings *gio.Settings
+
+	app *adw.Application
+	win *adw.ApplicationWindow
+
+	toasts  *adw.ToastOverlay
+	split   *adw.NavigationSplitView
+	sidebar *adw.Sidebar
+	content *adw.NavigationView
+
+	sidebarTitle     *adw.WindowTitle
+	newMachineButton *gtk.Button
+	mainMenuButton   *gtk.MenuButton
+	noMachinesPage   *adw.NavigationPage
+	noMachinesStatus *adw.StatusPage
+
+	machinesSection         *adw.SidebarSection
+	machinesSectionAttached bool
+	newMachineItem          *adw.SidebarItem
+	newMachineItemAttached  bool
+	toolsSection            *adw.SidebarSection
+	machineItems            map[string]*adw.SidebarItem
+	machineOrder            []string
+	machinePages            map[string]*machinePage
+
+	providersItem  *adw.SidebarItem
+	providersBadge *gtk.Label
+	requestsItem   *adw.SidebarItem
+	requestsBadge  *gtk.Label
+
+	providersPage   *adw.NavigationPage
+	requestsPage    *adw.NavigationPage
+	connectionsPage *adw.NavigationPage
+	providerPages   map[string]*providerPage
+
+	providersStack       *gtk.Stack
+	providersEmpty       *adw.StatusPage
+	providersEmptyButton *gtk.Button
+	providersSyncRow     *adw.ButtonRow
+	providersAddRow      *adw.ButtonRow
+	providersGroup       *adw.PreferencesGroup
+	providerRows         []*adw.ActionRow
+	providersSignature   string
+
+	requestsStack     *gtk.Stack
+	requestsGroup     *adw.PreferencesGroup
+	requestRows       []*adw.ActionRow
+	requestsSignature string
+
+	connectionsStack     *gtk.Stack
+	connectionsGroup     *adw.PreferencesGroup
+	connectionRows       []*adw.SwitchRow
+	connectionsSignature string
+	connectionsItem      *adw.SidebarItem
+
+	selected       string
+	sidebarTags    []string
+	actions        map[string]*gio.SimpleAction
+	suppressToasts bool
+	held           int
+	background     bool
+	keep           []interface{}
+}
+
+// Run builds the application, serves the agent channel, and blocks until the
+// application quits. It returns the exit status.
+func Run(ctx context.Context, log *slog.Logger, settings *gio.Settings, kickstart []byte, showWindow bool) int {
+	a := &App{
+		Ctx:           ctx,
+		Log:           log,
+		Settings:      settings,
+		State:         state.NewClient(log),
+		machineItems:  map[string]*adw.SidebarItem{},
+		machinePages:  map[string]*machinePage{},
+		providerPages: map[string]*providerPage{},
+		actions:       map[string]*gio.SimpleAction{},
+		keep:          []interface{}{},
+	}
+
+	state.NotifyHook = a.notify
+	a.Service = mcp.NewService(ctx, log, a.State, kickstart, a.notify)
+
+	a.app = adw.NewApplication(resources.AppID, gio.GApplicationFlagsNoneValue)
+
+	var onStartup func(gio.Application)
+	onStartup = func(gio.Application) {
+		go func() {
+			if err := a.Service.Run(runtimeDir()); err != nil {
+				log.Error("the agent channel stopped", "err", err)
+			}
+		}()
+	}
+	a.app.ConnectStartup(&onStartup)
+	a.hold(&onStartup)
+
+	var onActivate func(gio.Application)
+	onActivate = func(gio.Application) {
+		if a.win != nil {
+			a.win.Present()
+			return
+		}
+
+		a.buildWindow(showWindow)
+	}
+	a.app.ConnectActivate(&onActivate)
+	a.hold(&onActivate)
+
+	var onShutdown func(gio.Application)
+	onShutdown = func(gio.Application) { a.saveWindowState() }
+	a.app.ConnectShutdown(&onShutdown)
+	a.hold(&onShutdown)
+
+	if a.keepRunning() {
+		go a.requestBackground()
+	} else {
+		a.app.Release()
+	}
+
+	return int(a.app.Run(int32(len(os.Args)), os.Args))
+}
+
+func runtimeDir() string {
+	if value := os.Getenv("XDG_RUNTIME_DIR"); value != "" {
+		return value
+	}
+	return "/run/user/" + strconv.Itoa(os.Getuid())
+}
+
+func (a *App) keepRunning() bool {
+	return a.Settings.GetBoolean(resources.SettingKeepRunningKey)
+}
+
+func (a *App) requestBackground() {
+	defer func() {
+		if recovered := recover(); recovered != nil {
+			a.Log.Info("the background request panicked", "err", recovered)
+		}
+	}()
+
+	result, err := background.RequestBackground("", &background.RequestOptions{
+		Reason: i18n.L("Phial keeps the agent channel open so that machines can ask for access."),
+	})
+	if err != nil {
+		a.Log.Info("the background request failed", "err", err)
+		return
+	}
+
+	if !result.Background {
+		a.Log.Info("the background request was denied")
+		return
+	}
+
+	a.idle(func() {
+		a.background = true
+		if a.win != nil {
+			a.win.Window.SetHideOnClose(true)
+		}
+	})
+}
+
+func (a *App) setBackgroundMessage(message string) {
+	if !a.background {
+		return
+	}
+	if err := background.SetStatus("", background.StatusOptions{Message: message}); err != nil {
+		a.Log.Info("could not set the background status", "err", err)
+	}
+}
+
+func (a *App) quit() {
+	a.saveWindowState()
+	for ; a.held > 0; a.held-- {
+		a.app.Release()
+	}
+	a.app.Quit()
+}
+
+// notify sends a desktop notification unless the user turned them off.
+func (a *App) notify(summary string, body string) {
+	if !a.Settings.GetBoolean(resources.SettingNotificationsKey) {
+		return
+	}
+
+	notification := gio.NewNotification(summary)
+	if body != "" {
+		notification.SetBody(body)
+	}
+
+	if strings.Contains(strings.ToLower(summary), "request") {
+		notification.SetPriority(gio.GNotificationPriorityHighValue)
+		notification.SetDefaultAction("app.show-requests")
+	}
+
+	a.app.SendNotification("phial", notification)
+}
+
+func (a *App) registerActions() {
+	simple := func(name string, fn func()) {
+		action := gio.NewSimpleAction(name, nil)
+
+		var cb func(gio.SimpleAction, uintptr)
+		cb = func(gio.SimpleAction, uintptr) { fn() }
+		action.ConnectActivate(&cb)
+		a.hold(&cb)
+
+		a.app.AddAction(action)
+		a.actions[name] = action
+	}
+
+	stringParameter := func(name string, fn func(string)) {
+		action := gio.NewSimpleAction(name, glib.NewVariantType("s"))
+
+		var cb func(gio.SimpleAction, uintptr)
+		cb = func(_ gio.SimpleAction, parameter uintptr) {
+			if parameter == 0 {
+				return
+			}
+			variant := (*glib.Variant)(unsafe.Pointer(parameter))
+			fn(variant.GetString(nil))
+		}
+		action.ConnectActivate(&cb)
+		a.hold(&cb)
+
+		a.app.AddAction(action)
+	}
+
+	intParameter := func(name string, fn func(int)) {
+		action := gio.NewSimpleAction(name, glib.NewVariantType("i"))
+
+		var cb func(gio.SimpleAction, uintptr)
+		cb = func(_ gio.SimpleAction, parameter uintptr) {
+			if parameter == 0 {
+				return
+			}
+			variant := (*glib.Variant)(unsafe.Pointer(parameter))
+			fn(int(variant.GetInt32()))
+		}
+		action.ConnectActivate(&cb)
+		a.hold(&cb)
+
+		a.app.AddAction(action)
+	}
+
+	simple("new-machine", func() { a.showNewMachineDialog() })
+	simple("sync", func() { a.syncSecrets() })
+	simple("system-setup", func() { a.showSystemSetupDialog() })
+	simple("shortcuts", func() { a.showShortcuts() })
+	simple("preferences", func() { a.showPreferences() })
+	simple("about", func() { a.showAbout() })
+	simple("quit", func() { a.confirmQuit() })
+	simple("show-requests", func() {
+		if a.win != nil {
+			a.win.Present()
+		}
+		a.selectPage("requests")
+	})
+
+	simple("add-provider", func() { a.showProviderDialog("") })
+	simple("add-forward", func() { a.showAddForwardDialog() })
+	simple("add-device", func() { a.withMachine(func(def virt.Definition) { a.showAddDeviceDialog(def) }) })
+	simple("share-folder", func() { a.withMachine(func(def virt.Definition) { a.showShareDialog(def) }) })
+	simple("show-apps", func() { a.withMachine(func(def virt.Definition) { a.showGuestAppsDialog(def) }) })
+	simple("show-rdp", func() { a.withMachine(func(def virt.Definition) { a.showRdpDialog(def) }) })
+	simple("show-terminal", func() { a.withMachine(func(def virt.Definition) { a.showTerminalDialog(def) }) })
+	simple("show-serial", func() { a.withMachine(func(def virt.Definition) { a.showSerialDialog(def) }) })
+	simple("grant-access", func() { a.withProvider(func(name string) { a.showGrantDialog(name) }) })
+	simple("revoke-access", func() { a.withProvider(func(name string) { a.revokeGrant(name) }) })
+	simple("cancel-install", func() { a.withMachine(func(def virt.Definition) { a.confirmCancelInstall(def.Name) }) })
+	simple("edit-machine", func() { a.withMachine(func(def virt.Definition) { a.showMachineSettingsDialog(def) }) })
+	simple("show-logs", func() { a.withMachine(func(def virt.Definition) { a.openLogs(def.Name) }) })
+	simple("restart-machine", func() { a.machineAction("restart") })
+	simple("toggle-machine", func() {
+		a.withMachine(func(def virt.Definition) {
+			if page := a.machinePages[def.Name]; page != nil {
+				a.machinePrimaryAction(page)
+			}
+		})
+	})
+	simple("provision-machine", func() { a.provisionMachine() })
+	simple("copy-ssh", func() {
+		a.withMachine(func(def virt.Definition) {
+			a.copyText("ssh "+def.Name, i18n.L("Command copied"))
+		})
+	})
+	simple("delete-machine", func() { a.confirmDeleteMachine() })
+	simple("edit-provider", func() { a.withProvider(func(name string) { a.showProviderDialog(name) }) })
+	simple("remove-provider", func() { a.withProvider(func(name string) { a.confirmRemoveProvider(name) }) })
+	simple("close-window", func() {
+		if a.win != nil {
+			a.win.Close()
+		}
+	})
+
+	stringParameter("select-page", func(tag string) { a.selectPage(tag) })
+	intParameter("select-machine", func(index int) { a.selectMachine(index) })
+	stringParameter("capture", func(path string) { a.capture(path) })
+
+	a.app.SetAccelsForAction("app.sync", []string{"<Primary>r"})
+	a.app.SetAccelsForAction("app.toggle-machine", []string{"<Primary>Return"})
+	a.app.SetAccelsForAction("app.shortcuts", []string{"<Primary>question"})
+	a.app.SetAccelsForAction("app.preferences", []string{"<Primary>comma"})
+	a.app.SetAccelsForAction("app.quit", []string{"<Primary>q"})
+	a.app.SetAccelsForAction("app.close-window", []string{"<Primary>w"})
+
+	for index := 1; index <= 9; index++ {
+		a.app.SetAccelsForAction(
+			fmt.Sprintf("app.select-machine(%d)", index),
+			[]string{fmt.Sprintf("<Primary>%d", index)},
+		)
+	}
+}
+
+// updateAccels points the new action at the page that is open, so that the
+// shortcut creates the item that the reader sees.
+func (a *App) updateAccels() {
+	target := "app.new-machine"
+
+	switch a.selected {
+	case providersTag:
+		target = "app.add-provider"
+	case connectionsTag:
+		target = "app.add-forward"
+	}
+
+	for _, name := range []string{"app.new-machine", "app.add-provider", "app.add-forward"} {
+		if name == target {
+			a.app.SetAccelsForAction(name, []string{"<Primary>n"})
+			continue
+		}
+
+		a.app.SetAccelsForAction(name, []string{})
+	}
+}
+
+// activate runs one of the actions of the application. Every control that
+// opens a dialog goes through an action, so a menu entry and a row share one
+// implementation.
+func (a *App) activate(name string) {
+	if action := a.actions[name]; action != nil {
+		action.Activate(nil)
+	}
+}
+
+func (a *App) loadWindowState() (int32, int32, bool) {
+	width := int32(a.Settings.GetInt(resources.SettingWindowWidthKey))
+	height := int32(a.Settings.GetInt(resources.SettingWindowHeightKey))
+
+	if width < 360 {
+		width = 1020
+	}
+	if height < 294 {
+		height = 720
+	}
+
+	return width, height, a.Settings.GetBoolean(resources.SettingWindowMaximizedKey)
+}
+
+func (a *App) saveWindowState() {
+	if a.win == nil || !a.win.Widget.GetMapped() {
+		return
+	}
+
+	width := int(a.win.Widget.GetWidth())
+	height := int(a.win.Widget.GetHeight())
+	maximized := a.win.IsMaximized()
+
+	if !maximized && width >= 360 && height >= 294 {
+		a.Settings.SetInt(resources.SettingWindowWidthKey, int32(width))
+		a.Settings.SetInt(resources.SettingWindowHeightKey, int32(height))
+	}
+	a.Settings.SetBoolean(resources.SettingWindowMaximizedKey, maximized)
+
+	a.Settings.SetString(resources.SettingActivePageKey, a.selected)
+}
+
+func (a *App) showAbout() {
+	about := adw.NewAboutDialogFromAppdata(resources.ResourceMetainfoPath, resources.AppVersion)
+	about.SetDevelopers(resources.AppDevelopers)
+	about.SetArtists(resources.AppArtists)
+	about.SetCopyright(resources.AppCopyright)
+	about.SetTranslatorCredits(i18n.L("translator-credits"))
+	about.SetDebugInfo(a.acceptanceText())
+	about.SetDebugInfoFilename("phial-acceptance.txt")
+	about.Present(&a.win.Widget)
+}
+
+func (a *App) acceptanceText() string {
+	var builder strings.Builder
+
+	for _, check := range setup.Acceptance() {
+		state := "PASS"
+		if !check.OK {
+			state = "FAIL"
+		}
+		builder.WriteString(state + " " + check.Name)
+		if check.Note != "" {
+			builder.WriteString(" (" + check.Note + ")")
+		}
+		builder.WriteString("\n")
+	}
+
+	return builder.String()
+}
+
+func (a *App) showShortcuts() {
+	dialog := adw.NewShortcutsDialog()
+
+	general := adw.NewShortcutsSection(i18n.L("General"))
+	general.Add(adw.NewShortcutsItem(i18n.L("New machine, provider, or forward"), "<Primary>n"))
+	general.Add(adw.NewShortcutsItem(i18n.L("Sync secrets"), "<Primary>r"))
+	general.Add(adw.NewShortcutsItem(i18n.L("Preferences"), "<Primary>comma"))
+	general.Add(adw.NewShortcutsItem(i18n.L("Keyboard shortcuts"), "<Primary>question"))
+	general.Add(adw.NewShortcutsItem(i18n.L("Close window"), "<Primary>w"))
+	general.Add(adw.NewShortcutsItem(i18n.L("Quit"), "<Primary>q"))
+	dialog.Add(general)
+
+	machines := adw.NewShortcutsSection(i18n.L("Machines"))
+	machines.Add(adw.NewShortcutsItem(i18n.L("Select a Machine 1 to 9"), "<Primary>1"))
+	machines.Add(adw.NewShortcutsItem(i18n.L("Install, start, or stop the machine"), "<Primary>Return"))
+	dialog.Add(machines)
+
+	dialog.Present(&a.win.Widget)
+}
+
+func (a *App) confirmQuit() {
+	defs, _ := virt.List()
+
+	running := []virt.Definition{}
+	for _, def := range defs {
+		if active, _ := def.Active(); active {
+			running = append(running, def)
+		}
+	}
+
+	if len(running) == 0 {
+		a.quit()
+		return
+	}
+
+	names := []string{}
+	for _, def := range running {
+		names = append(names, def.Name)
+	}
+
+	dialog := adw.NewAlertDialog(
+		i18n.L("Stop the machines and quit?"),
+		fmt.Sprintf(
+			i18n.L("This stops %s. Close the window instead to keep the agent channel open."),
+			strings.Join(names, ", "),
+		),
+	)
+	dialog.AddResponse("cancel", i18n.L("_Cancel"))
+	dialog.AddResponse("quit", i18n.L("_Stop and Quit"))
+	dialog.SetResponseAppearance("quit", adw.ResponseDestructiveValue)
+	dialog.SetCloseResponse("cancel")
+	dialog.SetDefaultResponse("quit")
+
+	var cb func(adw.AlertDialog, string)
+	cb = func(_ adw.AlertDialog, response string) {
+		if response != "quit" {
+			return
+		}
+
+		a.goAsync(func() (string, error) {
+			for _, def := range running {
+				if err := def.Stop(); err != nil {
+					return "", err
+				}
+			}
+			a.idle(a.quit)
+			return "", nil
+		})
+	}
+	dialog.ConnectResponse(&cb)
+	a.hold(&cb)
+
+	dialog.Present(&a.win.Widget)
+}
+
+// withMachine passes the definition of the machine page that is on screen.
+func (a *App) withMachine(fn func(def virt.Definition)) {
+	tag := ""
+	if a.content != nil {
+		tag = a.content.GetVisiblePageTag()
+	}
+	if !strings.HasPrefix(tag, machineTagPrefix) {
+		return
+	}
+
+	def, err := virt.Load(strings.TrimPrefix(tag, machineTagPrefix))
+	if err != nil {
+		a.showError(err)
+		return
+	}
+
+	fn(def)
+}
+
+// withProvider passes the name of the provider page that is on screen.
+func (a *App) withProvider(fn func(name string)) {
+	tag := ""
+	if a.content != nil {
+		tag = a.content.GetVisiblePageTag()
+	}
+	if !strings.HasPrefix(tag, providerTagPrefix) {
+		return
+	}
+
+	fn(strings.TrimPrefix(tag, providerTagPrefix))
+}
+
+// provisionMachine writes the agent unit, the shares, and the RDP credentials
+// into a running machine.
+func (a *App) provisionMachine() {
+	a.withMachine(func(def virt.Definition) {
+		active, err := def.Active()
+		if err != nil || !active {
+			a.toast(i18n.L("Start the machine first"))
+			return
+		}
+
+		a.goAsync(func() (string, error) {
+			if _, _, err := a.Service.VmProvision(a.Ctx, nil, mcp.NameInput{Name: def.Name}); err != nil {
+				return "", err
+			}
+
+			return i18n.L("The machine was provisioned"), nil
+		})
+	})
+}
+
+func (a *App) machineAction(action string) {
+	a.withMachine(func(def virt.Definition) { a.machineActionFor(def.Name, action) })
+}
diff --git a/internal/ui/connections.go b/internal/ui/connections.go
new file mode 100644
index 0000000000000000000000000000000000000000..cbcd9311864c25211bd61a4fafc96f1ad71eb15e
--- /dev/null
+++ b/internal/ui/connections.go
@@ -0,0 +1,295 @@
+package ui
+
+import (
+	"fmt"
+	"strings"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+
+	"codeberg.org/pojntfx/phial-neo/internal/mcp"
+)
+
+// forwardListenText shortens a listen address into the part that a reader needs.
+func forwardListenText(listen string) string {
+	value := strings.TrimPrefix(listen, "VSOCK-LISTEN:")
+
+	if index := strings.IndexByte(value, ','); index >= 0 {
+		value = value[:index]
+	}
+
+	if value == "" {
+		return listen
+	}
+
+	return "vsock " + value
+}
+
+// forwardTargetText shortens a target address into the part that a reader needs.
+func forwardTargetText(target string) string {
+	for _, prefix := range []string{"UNIX-CONNECT:", "TCP:", "VSOCK-CONNECT:"} {
+		if value, ok := strings.CutPrefix(target, prefix); ok {
+			return value
+		}
+	}
+
+	return target
+}
+
+func (a *App) buildConnectionsPage() *adw.NavigationPage {
+	stack := gtk.NewStack()
+	stack.SetTransitionType(gtk.StackTransitionTypeCrossfadeValue)
+	a.connectionsStack = stack
+
+	empty := a.statusPage(
+		"network-transmit-receive-symbolic",
+		"No Forwards",
+		"A forward carries one socket from a machine to this host. The agent channel uses the mcp forward on vsock port 8080.",
+	)
+	stack.AddNamed(&empty.Widget, "empty")
+
+	a.connectionsGroup = adw.NewPreferencesGroup()
+
+	actions := adw.NewPreferencesGroup()
+	actions.Add(&a.buttonRow("_Add Forward", "list-add-symbolic", func() {
+		a.activate("add-forward")
+	}).Widget)
+
+	stack.AddNamed(a.pageContent(a.connectionsGroup, actions), "list")
+
+	page_, _, _ := a.pageToolbar("Forwards", "", &stack.Widget)
+
+	page_.SetTag(connectionsTag)
+
+	return page_
+}
+
+// refreshConnections rebuilds the forward list only when it changes.
+func (a *App) refreshConnections() {
+	_, output, err := a.Service.ForwardLs(a.Ctx, nil, struct{}{})
+	if err != nil || output == nil {
+		return
+	}
+
+	signature := "empty"
+	for _, forward := range output.Forwards {
+		signature += fmt.Sprintf("%s|%s|%s|%t;", forward.Name, forward.Listen, forward.Target, forward.Active)
+	}
+
+	if signature == a.connectionsSignature {
+		return
+	}
+
+	a.connectionsSignature = signature
+
+	for _, row := range a.connectionRows {
+		a.connectionsGroup.Remove(&row.Widget)
+	}
+	a.connectionRows = nil
+
+	if len(output.Forwards) == 0 {
+		a.connectionsStack.SetVisibleChildName("empty")
+		a.connectionsItem.SetSubtitle(i18n.L("None"))
+		return
+	}
+
+	a.connectionsStack.SetVisibleChildName("list")
+
+	running := 0
+	for _, forward := range output.Forwards {
+		if forward.Active {
+			running++
+		}
+	}
+
+	a.connectionsItem.SetSubtitle(fmt.Sprintf(
+		i18n.L("%s, %d running"),
+		countText(len(output.Forwards), i18n.L("Forward"), i18n.L("Forwards")),
+		running,
+	))
+
+	for _, forward := range output.Forwards {
+		forward := forward
+
+		row := a.switchRow(
+			forward.Name,
+			fmt.Sprintf(i18n.L("%s to %s"), forwardListenText(forward.Listen), forwardTargetText(forward.Target)),
+			forward.Active,
+			func(on bool) { a.setForward(forward.Name, on) },
+		)
+
+		remove := a.iconButton("user-trash-symbolic", i18n.L("Remove Forward"), func() {
+			a.confirmRemoveForward(forward.Name)
+		})
+		row.AddSuffix(&remove.Widget)
+
+		a.connectionsGroup.Add(&row.Widget)
+		a.connectionRows = append(a.connectionRows, row)
+	}
+}
+
+func (a *App) setForward(name string, on bool) {
+	a.goAsync(func() (string, error) {
+		action := a.Service.ForwardStart
+		if !on {
+			action = a.Service.ForwardStop
+		}
+
+		if _, _, err := action(a.Ctx, nil, mcp.NameInput{Name: name}); err != nil {
+			a.reloadConnections()
+			return "", err
+		}
+
+		a.reloadConnections()
+
+		if on {
+			return i18n.L("The forward runs"), nil
+		}
+
+		return i18n.L("The forward stopped"), nil
+	})
+}
+
+// reloadConnections reads the forward state again, even when it looks unchanged.
+func (a *App) reloadConnections() {
+	a.connectionsSignature = ""
+	a.idle(func() {
+		a.refreshConnections()
+	})
+}
+
+func (a *App) confirmRemoveForward(name string) {
+	dialog := adw.NewAlertDialog(
+		i18n.L("Remove the forward?"),
+		fmt.Sprintf(i18n.L("This stops %s and removes its configuration."), name),
+	)
+	dialog.AddResponse("cancel", i18n.L("_Cancel"))
+	dialog.AddResponse("remove", i18n.L("_Remove"))
+	dialog.SetResponseAppearance("remove", adw.ResponseDestructiveValue)
+	dialog.SetCloseResponse("cancel")
+
+	var cb func(adw.AlertDialog, string)
+	cb = func(_ adw.AlertDialog, response string) {
+		if response != "remove" {
+			return
+		}
+
+		a.goAsync(func() (string, error) {
+			if _, _, err := a.Service.ForwardRemove(a.Ctx, nil, mcp.NameInput{Name: name}); err != nil {
+				return "", err
+			}
+
+			a.reloadConnections()
+
+			return i18n.L("The forward was removed"), nil
+		})
+	}
+	dialog.ConnectResponse(&cb)
+	a.hold(&cb)
+
+	dialog.Present(&a.win.Widget)
+}
+
+func (a *App) showAddForwardDialog() {
+	scope := a.newScope()
+
+	nameRow := adw.NewEntryRow()
+	nameRow.SetTitle(i18n.L("_Name"))
+	nameRow.SetUseUnderline(true)
+	nameRow.SetShowApplyButton(false)
+
+	portRow := a.spinRow("VSock Port", 8080, 1024, 65535, 1, nil)
+	portRow.SetSubtitle(i18n.L("A machine reaches this port over vsock"))
+
+	pathRow := adw.NewEntryRow()
+	pathRow.SetTitle(i18n.L("Host _Socket"))
+	pathRow.SetUseUnderline(true)
+	pathRow.SetShowApplyButton(false)
+	pathRow.SetText("/run/user/1000/phial/mcp-guest.sock")
+	pathRow.SetVisible(false)
+
+	kind := "tcp"
+
+	kindRow := a.comboRow(
+		"Kind",
+		[]string{i18n.L("TCP port on this host"), i18n.L("Unix socket on this host")},
+		[]string{"tcp", "unix"},
+		"tcp",
+		func(value string) {
+			kind = value
+			pathRow.SetVisible(value == "unix")
+			a.validateForwardForm(scope, nameRow, portRow, pathRow, value)
+		},
+	)
+
+	identity := formGroup(
+		"Forward",
+		"Phial writes one configuration file and starts one user service for the forward.",
+		&nameRow.Widget,
+		&kindRow.row.Widget,
+		&portRow.Widget,
+		&pathRow.Widget,
+	)
+
+	content := a.formPage(identity)
+
+	dialog := a.dialog(scope, "Add Forward", i18n.L("One socket from a machine to this host"), "_Add", content, func() bool {
+		name := strings.TrimSpace(nameRow.GetText())
+		if !validMachineName(name) {
+			a.toast(i18n.L("Give a name without spaces"))
+			return false
+		}
+
+		port := int(portRow.GetValue())
+		path := strings.TrimSpace(pathRow.GetText())
+
+		if kind == "unix" && path == "" {
+			a.toast(i18n.L("Give the socket path on this host"))
+			return false
+		}
+
+		a.goAsync(func() (string, error) {
+			if _, _, err := a.Service.ForwardAdd(a.Ctx, nil, mcp.ForwardInput{
+				Name: name,
+				Kind: kind,
+				Port: port,
+				Path: path,
+			}); err != nil {
+				return "", err
+			}
+
+			a.reloadConnections()
+
+			return i18n.L("The forward was added"), nil
+		})
+
+		return true
+	})
+
+	validate := func() {
+		a.validateForwardForm(scope, nameRow, portRow, pathRow, kind)
+	}
+
+	a.onEntryChanged(nameRow, validate)
+	a.onEntryChanged(pathRow, validate)
+
+	validate()
+
+	a.present(dialog, scope)
+}
+
+// validateForwardForm turns the affirmative control of the dialog on or off.
+func (a *App) validateForwardForm(scope *callbackScope, nameRow *adw.EntryRow, portRow *adw.SpinRow, pathRow *adw.EntryRow, kind string) {
+	valid := validMachineName(nameRow.GetText())
+
+	if kind == "unix" && strings.TrimSpace(pathRow.GetText()) == "" {
+		valid = false
+	}
+
+	if portRow.GetValue() < 1024 || portRow.GetValue() > 65535 {
+		valid = false
+	}
+
+	scope.setValid(valid)
+}
diff --git a/internal/ui/devices.go b/internal/ui/devices.go
new file mode 100644
index 0000000000000000000000000000000000000000..45d52d1f7903a38d5ecc7427f553bf30dd544067
--- /dev/null
+++ b/internal/ui/devices.go
@@ -0,0 +1,258 @@
+package ui
+
+import (
+	"fmt"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+
+	"codeberg.org/pojntfx/phial-neo/internal/mcp"
+	"codeberg.org/pojntfx/phial-neo/internal/virt"
+)
+
+// refreshHubControllers fills the controller list of the hub group.
+func (a *App) refreshHubControllers(page *machinePage) {
+	_, output, err := a.Service.ListXhci(a.Ctx, nil, struct{}{})
+	if err != nil {
+		a.Log.Info("could not list the xHCI controllers", "err", err)
+		return
+	}
+
+	labels := []string{i18n.L("None")}
+	values := []string{""}
+
+	if output != nil {
+		for _, controller := range output.Controllers {
+			name := shortUSBName(controller.Name)
+			if name == "" {
+				name = controller.Address
+			}
+			labels = append(labels, fmt.Sprintf("%s (%s)", name, controller.Address))
+			values = append(values, controller.Address)
+		}
+	}
+
+	page.hubRow.setModel(labels, values, page.def.USBXHCI)
+
+	if len(values) == 1 {
+		page.hubHint.SetTitle(i18n.L("No second xHCI controller"))
+		page.hubHint.SetSubtitle(i18n.L("Whole-hub passthrough needs a second xHCI controller on this host."))
+		page.hubHint.SetVisible(true)
+		return
+	}
+
+	page.hubHint.SetVisible(false)
+}
+
+func (a *App) setHubController(page *machinePage, address string) {
+	previous := page.def.USBXHCI
+
+	a.goAsync(func() (string, error) {
+		if previous != "" && previous != address {
+			if _, _, err := a.Service.UsbRestore(a.Ctx, nil, mcp.AddressInput{Address: previous}); err != nil {
+				return "", err
+			}
+		}
+
+		if address != "" {
+			if _, _, err := a.Service.UsbBind(a.Ctx, nil, mcp.AddressInput{Address: address}); err != nil {
+				return "", err
+			}
+		}
+
+		def, err := virt.Load(page.def.Name)
+		if err != nil {
+			return "", err
+		}
+
+		def.USBXHCI = address
+		if err := def.Save(); err != nil {
+			return "", err
+		}
+
+		a.idle(func() {
+			page.def = def
+			a.refreshHubControllers(page)
+		})
+
+		if address == "" {
+			return i18n.L("The hub went back to the host"), nil
+		}
+
+		return i18n.L("The hub belongs to the machine now"), nil
+	})
+}
+
+// refreshDevices reconciles the device rows with the definition.
+func (a *App) refreshDevices(page *machinePage) {
+	names := map[string]string{}
+	if _, output, err := a.Service.UsbNames(a.Ctx, nil, mcp.UsbNamesInput{IDs: page.def.USBDevices}); err == nil && output != nil {
+		for id, name := range output.Names {
+			names[id] = name
+		}
+	}
+
+	if sameStrings(page.deviceNames, page.def.USBDevices) {
+		for index, row := range page.deviceRows {
+			title, subtitle := deviceText(page.def.USBDevices[index], names)
+			row.SetTitle(title)
+			row.SetSubtitle(subtitle)
+		}
+		return
+	}
+
+	page.devicesGroup.Remove(&page.addDeviceRow.Widget)
+	for _, row := range page.deviceRows {
+		page.devicesGroup.Remove(&row.Widget)
+	}
+	page.deviceRows = nil
+
+	for _, device := range page.def.USBDevices {
+		device := device
+
+		row := adw.NewActionRow()
+		title, subtitle := deviceText(device, names)
+		row.SetTitle(title)
+		row.SetSubtitle(subtitle)
+		row.SetSubtitleSelectable(true)
+
+		remove := a.iconButton("user-trash-symbolic", i18n.L("Remove Device"), func() {
+			a.goAsync(func() (string, error) {
+				if _, _, err := a.Service.UsbRemoveDevice(a.Ctx, nil, mcp.UsbDeviceInput{VM: page.def.Name, Device: device}); err != nil {
+					return "", err
+				}
+
+				a.idle(func() {
+					def, err := virt.Load(page.def.Name)
+					if err == nil {
+						page.def = def
+						a.refreshDevices(page)
+					}
+				})
+
+				return i18n.L("The device was removed"), nil
+			})
+		})
+		row.AddSuffix(&remove.Widget)
+		page.devicesGroup.Add(&row.Widget)
+		page.deviceRows = append(page.deviceRows, row)
+	}
+
+	page.deviceNames = append(page.deviceNames[:0], page.def.USBDevices...)
+	page.deviceEmpty.SetVisible(len(page.def.USBDevices) == 0)
+	page.devicesGroup.Add(&page.addDeviceRow.Widget)
+}
+
+func deviceText(device string, names map[string]string) (string, string) {
+	if name := names[device]; name != "" {
+		return name, device
+	}
+	return device, ""
+}
+
+func (a *App) showAddDeviceDialog(def virt.Definition) {
+	scope := a.newScope()
+
+	group := adw.NewPreferencesGroup()
+	group.SetTitle(i18n.L("Devices on This Host"))
+	group.SetDescription(i18n.L("The device leaves this host while the machine runs."))
+
+	statusRow := adw.NewActionRow()
+	statusRow.SetTitle(i18n.L("Looking for devices"))
+	spinner := adw.NewSpinner()
+	spinner.SetVisible(true)
+	statusRow.AddPrefix(&spinner.Widget)
+	group.Add(&statusRow.Widget)
+
+	manualGroup := formGroup("Manual Entry", "Use the identifier when the device is not attached right now.")
+
+	entry := adw.NewEntryRow()
+	entry.SetTitle(i18n.L("Vendor and Product ID"))
+	entry.SetShowApplyButton(false)
+	manualGroup.Add(&entry.Widget)
+
+	var add func(device string)
+	add = func(device string) {
+		a.goAsync(func() (string, error) {
+			if _, _, err := a.Service.UsbAddDevice(a.Ctx, nil, mcp.UsbDeviceInput{VM: def.Name, Device: device}); err != nil {
+				return "", err
+			}
+
+			a.idle(func() {
+				page := a.ensureMachinePage(def.Name)
+				if page != nil {
+					if current, err := virt.Load(def.Name); err == nil {
+						page.def = current
+						a.refreshDevices(page)
+					}
+				}
+			})
+
+			return i18n.L("The device was added"), nil
+		})
+	}
+
+	manualGroup.Add(&a.buttonRow("_Add the device", "list-add-symbolic", func() {
+		device := entry.GetText()
+		if device == "" {
+			a.toast(i18n.L("Enter a vendor and product ID first"))
+			return
+		}
+		add(device)
+	}).Widget)
+
+	content := a.formPage(group, manualGroup)
+	dialog := a.dialog(scope, "Add a USB Device", def.Name, "_Close", content, nil)
+
+	go func() {
+		_, output, err := a.Service.UsbLs(a.Ctx, nil, mcp.NameInput{Name: def.Name})
+
+		a.idle(func() {
+			spinner.SetVisible(false)
+
+			if err != nil {
+				statusRow.SetTitle(i18n.L("The devices could not be listed"))
+				statusRow.SetSubtitle(err.Error())
+				return
+			}
+
+			devices := []mcp.UsbDeviceInfo{}
+			if output != nil {
+				devices = output.Devices
+			}
+
+			if len(devices) == 0 {
+				statusRow.SetTitle(i18n.L("No device is attached"))
+				return
+			}
+
+			group.Remove(&statusRow.Widget)
+
+			for _, device := range devices {
+				device := device
+
+				row := adw.NewActionRow()
+				if device.Name != "" {
+					row.SetTitle(shortUSBName(device.Name))
+					row.SetSubtitle(fmt.Sprintf("%s:%s", device.Vendor, device.Product))
+				} else {
+					row.SetTitle(fmt.Sprintf("%s:%s", device.Vendor, device.Product))
+					row.SetSubtitle(device.Address)
+				}
+				row.SetActivatable(true)
+
+				var cb func(adw.ActionRow)
+				cb = func(adw.ActionRow) {
+					add(fmt.Sprintf("%s:%s", device.Vendor, device.Product))
+					dialog.Close()
+				}
+				row.ConnectActivated(&cb)
+				scope.hold(&cb)
+
+				group.Add(&row.Widget)
+			}
+		})
+	}()
+
+	a.present(dialog, scope)
+}
diff --git a/internal/ui/dialogs.go b/internal/ui/dialogs.go
new file mode 100644
index 0000000000000000000000000000000000000000..9ee95d1429b4ffef8cca94d3161af5ccf9bd2d8e
--- /dev/null
+++ b/internal/ui/dialogs.go
@@ -0,0 +1,165 @@
+package ui
+
+import (
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/glib"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+)
+
+// callbackScope collects the callbacks of a widget tree that is thrown away, so
+// that their C trampolines can be released when the tree closes. The generated
+// bindings hold at most two thousand callbacks in one process.
+type callbackScope struct {
+	app     *App
+	cbs     []interface{}
+	confirm *gtk.Button
+}
+
+func (a *App) newScope() *callbackScope {
+	return &callbackScope{app: a}
+}
+
+func (s *callbackScope) hold(cb interface{}) {
+	s.cbs = append(s.cbs, cb)
+}
+
+func (s *callbackScope) release() {
+	for _, cb := range s.cbs {
+		if err := glib.UnrefCallback(cb); err != nil {
+			s.app.Log.Debug("could not release a callback", "err", err)
+		}
+	}
+	s.cbs = nil
+}
+
+func (a *App) present(dialog *adw.Dialog, scope *callbackScope) {
+	if scope != nil {
+		var onClosed func(adw.Dialog)
+		onClosed = func(adw.Dialog) { scope.release() }
+		dialog.ConnectClosed(&onClosed)
+		a.hold(&onClosed)
+	}
+
+	dialog.Present(&a.win.Widget)
+}
+
+// dialog builds a modal dialog with a cancel control and one affirmative
+// control.
+func (a *App) dialog(scope *callbackScope, title string, subtitle string, actionLabel string, content *gtk.Widget, action func() bool) *adw.Dialog {
+	dialog := adw.NewDialog()
+	dialog.SetTitle(i18n.L(title))
+	dialog.SetContentWidth(460)
+	dialog.SetContentHeight(560)
+
+	toolbar := adw.NewToolbarView()
+	header := adw.NewHeaderBar()
+
+	// The header bar of a dialog carries the native close button, so the dialog
+	// adds its own controls only for an action.
+	windowTitle := adw.NewWindowTitle(i18n.L(title), i18n.L(subtitle))
+	header.SetTitleWidget(&windowTitle.Widget)
+	if action == nil {
+		toolbar := adw.NewToolbarView()
+		toolbar.AddTopBar(&header.Widget)
+		toolbar.SetContent(content)
+		dialog.SetChild(&toolbar.Widget)
+
+		return dialog
+	}
+
+	cancel := gtk.NewButton()
+	cancel.SetLabel(i18n.L("_Cancel"))
+	cancel.SetUseUnderline(true)
+
+	var onCancel func(gtk.Button)
+	onCancel = func(gtk.Button) { dialog.Close() }
+	cancel.ConnectClicked(&onCancel)
+	scope.hold(&onCancel)
+	header.PackStart(&cancel.Widget)
+
+	confirm := gtk.NewButton()
+	confirm.SetLabel(i18n.L(actionLabel))
+	confirm.SetUseUnderline(true)
+	if action != nil {
+		confirm.AddCssClass("suggested-action")
+		confirm.SetSensitive(false)
+	}
+
+	var onConfirm func(gtk.Button)
+	onConfirm = func(gtk.Button) {
+		if action == nil || action() {
+			dialog.Close()
+		}
+	}
+	confirm.ConnectClicked(&onConfirm)
+	scope.hold(&onConfirm)
+	scope.confirm = confirm
+	header.PackEnd(&confirm.Widget)
+
+	toolbar.AddTopBar(&header.Widget)
+	toolbar.SetContent(content)
+	dialog.SetChild(&toolbar.Widget)
+
+	return dialog
+}
+
+// confirmDestructive asks for one confirmation and carries extra content, such
+// as a choice that changes what the action removes.
+func (a *App) confirmDestructive(title string, body string, actionLabel string, content *gtk.Widget, action func()) {
+	dialog := adw.NewAlertDialog(i18n.L(title), body)
+	dialog.AddResponse("cancel", i18n.L("_Cancel"))
+	dialog.AddResponse("confirm", i18n.L(actionLabel))
+	dialog.SetResponseAppearance("confirm", adw.ResponseDestructiveValue)
+	dialog.SetCloseResponse("cancel")
+
+	if content != nil {
+		dialog.SetExtraChild(content)
+	}
+
+	var cb func(adw.AlertDialog, string)
+	cb = func(_ adw.AlertDialog, response string) {
+		if response != "confirm" {
+			return
+		}
+
+		action()
+	}
+	dialog.ConnectResponse(&cb)
+	a.hold(&cb)
+
+	dialog.Present(&a.win.Widget)
+}
+
+// formPage wraps rows into a scrollable preferences page.
+// setValid turns the affirmative control of a dialog on or off.
+func (s *callbackScope) setValid(valid bool) {
+	if s.confirm == nil {
+		return
+	}
+	s.confirm.SetSensitive(valid)
+}
+
+func (a *App) formPage(groups ...*adw.PreferencesGroup) *gtk.Widget {
+	page := adw.NewPreferencesPage()
+	for _, group := range groups {
+		page.Add(group)
+	}
+
+	return &a.scrolled(&page.Widget).Widget
+}
+
+// formGroup builds a preferences group with the given rows.
+func formGroup(title string, description string, rows ...*gtk.Widget) *adw.PreferencesGroup {
+	group := adw.NewPreferencesGroup()
+	if title != "" {
+		group.SetTitle(i18n.L(title))
+	}
+	if description != "" {
+		group.SetDescription(i18n.L(description))
+	}
+	for _, row := range rows {
+		group.Add(row)
+	}
+	return group
+}
diff --git a/internal/ui/install.go b/internal/ui/install.go
new file mode 100644
index 0000000000000000000000000000000000000000..2a7761d7789c4e4fe84d66bd5bc975331981052f
--- /dev/null
+++ b/internal/ui/install.go
@@ -0,0 +1,206 @@
+package ui
+
+import (
+	"fmt"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+
+	"codeberg.org/pojntfx/phial-neo/internal/mcp"
+	"codeberg.org/pojntfx/phial-neo/internal/virt"
+)
+
+type installStepRow struct {
+	row     *adw.ActionRow
+	done    *gtk.Image
+	spinner *adw.Spinner
+	failed  *gtk.Image
+}
+
+func (a *App) buildInstallRows(page *machinePage) {
+	for _, name := range virt.InstallSteps() {
+		row := adw.NewActionRow()
+		row.SetTitle(i18n.L(name))
+		row.AddCssClass("dim-label")
+
+		done := gtk.NewImageFromIconName("object-select-symbolic")
+		done.SetVisible(false)
+		row.AddPrefix(&done.Widget)
+
+		spinner := adw.NewSpinner()
+		spinner.SetVisible(false)
+		row.AddPrefix(&spinner.Widget)
+
+		failed := gtk.NewImageFromIconName("dialog-error-symbolic")
+		failed.SetVisible(false)
+		row.AddPrefix(&failed.Widget)
+
+		page.installSteps = append(page.installSteps, installStepRow{
+			row:     row,
+			done:    done,
+			spinner: spinner,
+			failed:  failed,
+		})
+
+		page.installGroup.Add(&row.Widget)
+	}
+
+	page.cancelInstall = a.buttonRow("_Cancel Installation", "process-stop-symbolic", func() {
+		a.activate("cancel-install")
+	})
+	page.cancelInstall.AddCssClass("destructive-action")
+	page.installActions.Add(&page.cancelInstall.Widget)
+}
+
+// refreshInstall updates the step list of the machine that is on screen.
+func (a *App) refreshInstall() {
+	tag := a.content.GetVisiblePageTag()
+	if len(tag) <= len(machineTagPrefix) || tag[:len(machineTagPrefix)] != machineTagPrefix {
+		return
+	}
+
+	page := a.machinePages[tag[len(machineTagPrefix):]]
+	if page == nil {
+		return
+	}
+
+	installing := a.Service.Installing(page.def.Name)
+	if installing != page.installing {
+		page.refresh()
+	}
+
+	if !installing {
+		return
+	}
+
+	page.applyInstallStatus()
+}
+
+// applyInstallStatus writes the state of the installer into the step rows. The
+// precise progress belongs to the step that carries it, so the page needs no
+// second control.
+func (p *machinePage) applyInstallStatus() {
+	status := virt.InstallStatusFor(p.def.Name)
+
+	p.cancelInstall.SetVisible(p.app.Service.Installing(p.def.Name))
+
+	if status == nil {
+		return
+	}
+
+	failed := status.Failed != ""
+
+	for index, step := range p.installSteps {
+		step.done.SetVisible(false)
+		step.spinner.SetVisible(false)
+		step.failed.SetVisible(false)
+		step.row.SetSubtitle("")
+
+		switch {
+		case failed && index == status.Current:
+			step.row.RemoveCssClass("dim-label")
+			step.row.SetSubtitle(status.Failed)
+			step.failed.SetVisible(true)
+		case status.Done:
+			step.row.RemoveCssClass("dim-label")
+			step.done.SetVisible(true)
+		case index < status.Current:
+			step.row.RemoveCssClass("dim-label")
+			step.done.SetVisible(true)
+		case index == status.Current:
+			step.row.RemoveCssClass("dim-label")
+			step.spinner.SetVisible(true)
+			step.row.SetSubtitle(installStepDetail(status, index))
+		default:
+			step.row.AddCssClass("dim-label")
+		}
+	}
+}
+
+// installStepDetail states how far one step has come. Every step states
+// something, so no step is a bare spinner.
+func installStepDetail(status *virt.InstallStatus, index int) string {
+	switch {
+	case index == 0 && status.Total > 0:
+		return fmt.Sprintf(
+			i18n.L("%s of %s, %.0f%%"),
+			humanBytes(status.Downloaded),
+			humanBytes(status.Total),
+			float64(status.Downloaded)*100/float64(status.Total),
+		)
+	case index == 3 && status.PackagesTotal > 0:
+		detail := fmt.Sprintf(i18n.L("%d of %d packages"), status.Packages, status.PackagesTotal)
+		if status.PackageName != "" {
+			detail = status.PackageName + ", " + detail
+		}
+
+		return detail
+	}
+
+	// The installer writes to its console, so its last line states what the
+	// current step does.
+	if status.Detail != "" {
+		return status.Detail
+	}
+
+	return installStepIdleDetail(index)
+}
+
+// installStepIdleDetail states what a step does before its first console line.
+func installStepIdleDetail(index int) string {
+	switch index {
+	case 0:
+		return i18n.L("Waiting for the first bytes of the download")
+	case 1:
+		return i18n.L("The installer virtual machine starts")
+	case 2:
+		return i18n.L("The installer reads the kickstart file")
+	case 3:
+		return i18n.L("The installer solves the package list")
+	case 4:
+		return i18n.L("The installer runs the post-install scripts")
+	case 5:
+		return i18n.L("The installer configures the system")
+	case 6:
+		return i18n.L("The installer finishes and restarts the machine")
+	}
+
+	return ""
+}
+
+func (a *App) confirmCancelInstall(name string) {
+	dialog := adw.NewAlertDialog(
+		i18n.L("Cancel the installation?"),
+		i18n.L("This stops the installer and removes the partial disk of the machine."),
+	)
+	dialog.AddResponse("cancel-install", i18n.L("_Cancel Installation"))
+	dialog.AddResponse("cancel", i18n.L("_Keep Installing"))
+	dialog.SetResponseAppearance("cancel-install", adw.ResponseDestructiveValue)
+	dialog.SetCloseResponse("cancel")
+	dialog.SetDefaultResponse("cancel")
+
+	var cb func(adw.AlertDialog, string)
+	cb = func(_ adw.AlertDialog, response string) {
+		if response != "cancel-install" {
+			return
+		}
+
+		a.goAsync(func() (string, error) {
+			if _, _, err := a.Service.VmCancelInstall(a.Ctx, nil, mcp.NameInput{Name: name}); err != nil {
+				return "", err
+			}
+
+			a.idle(func() {
+				a.refreshSidebar()
+				a.refreshMachinePage(name)
+			})
+
+			return i18n.L("The installation was cancelled"), nil
+		})
+	}
+	dialog.ConnectResponse(&cb)
+	a.hold(&cb)
+
+	dialog.Present(&a.win.Widget)
+}
diff --git a/internal/ui/logs.go b/internal/ui/logs.go
new file mode 100644
index 0000000000000000000000000000000000000000..1e10c0033ceee0f2914df51fa8a2ad9529c26610
--- /dev/null
+++ b/internal/ui/logs.go
@@ -0,0 +1,49 @@
+package ui
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+
+	"codeberg.org/puregotk/puregotk/v4/gio"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+
+	"codeberg.org/pojntfx/phial-neo/internal/virt"
+)
+
+// openLogs opens the log of one machine in the text editor: the console of the
+// machine when it keeps one, else its service log written out for reading.
+func (a *App) openLogs(name string) {
+	path := virt.ConsoleLogPath(name)
+
+	if info, err := os.Stat(path); err != nil || info.Size() == 0 {
+		path = filepath.Join(filepath.Dir(path), "unit.log")
+
+		if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+			a.toast(err.Error())
+
+			return
+		}
+
+		if err := os.WriteFile(path, []byte(unitLog(name)), 0o600); err != nil {
+			a.toast(err.Error())
+
+			return
+		}
+	}
+
+	if _, err := gio.AppInfoLaunchDefaultForUri("file://"+filepath.Clean(path), nil); err != nil {
+		a.toast(err.Error())
+	}
+}
+
+// unitLog reads the service log of one machine, which carries the host side of
+// a machine that keeps no console file.
+func unitLog(name string) string {
+	out, err := exec.Command("journalctl", "--user", "-u", "phial-vm@"+name+".service", "-n", "400", "--no-pager", "-o", "short-iso").Output()
+	if err != nil {
+		return i18n.L("This machine has no log yet")
+	}
+
+	return string(out)
+}
diff --git a/internal/ui/machine_dialogs.go b/internal/ui/machine_dialogs.go
new file mode 100644
index 0000000000000000000000000000000000000000..032eb0885ba2c2edcc5ef4a850e24b313f23eaee
--- /dev/null
+++ b/internal/ui/machine_dialogs.go
@@ -0,0 +1,274 @@
+package ui
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+
+	"codeberg.org/pojntfx/phial-neo/internal/mcp"
+	"codeberg.org/pojntfx/phial-neo/internal/virt"
+)
+
+func validMachineName(name string) bool {
+	trimmed := strings.TrimSpace(name)
+
+	if trimmed == "" || strings.ContainsAny(trimmed, " /:") {
+		return false
+	}
+
+	return true
+}
+
+func (a *App) showNewMachineDialog() {
+	scope := a.newScope()
+
+	nameRow := adw.NewEntryRow()
+	nameRow.SetTitle(i18n.L("_Name"))
+	nameRow.SetUseUnderline(true)
+	nameRow.SetShowApplyButton(false)
+	nameRow.SetActivatesDefault(true)
+
+	memoryRow := a.spinRow("Memory", 16, 1, 256, 1, nil)
+	memoryRow.AddSuffix(&a.unitLabel("GiB").Widget)
+
+	diskRow := a.spinRow("Disk Size", 48, 8, 2048, 1, nil)
+	diskRow.AddSuffix(&a.unitLabel("GiB").Widget)
+
+	identity := formGroup(
+		"Identity",
+		"The name becomes the host alias for ssh, so it must be short and without spaces.",
+		&nameRow.Widget,
+	)
+
+	resources := formGroup(
+		"Resources",
+		"Phial allocates the disk image on the first start.",
+		&memoryRow.Widget,
+		&diskRow.Widget,
+	)
+
+	content := a.formPage(identity, resources)
+
+	dialog := a.dialog(scope, "New Machine", i18n.L("A Fedora machine that only sees granted secrets"), "_Create", content, func() bool {
+		name := strings.TrimSpace(nameRow.GetText())
+
+		if !validMachineName(name) {
+			a.toast(i18n.L("Give a name without spaces"))
+			return false
+		}
+
+		memory := strconv.Itoa(int(memoryRow.GetValue())) + "G"
+		diskSize := strconv.Itoa(int(diskRow.GetValue())) + "G"
+
+		a.goAsync(func() (string, error) {
+			if _, _, err := a.Service.VmCreate(a.Ctx, nil, mcp.VmCreateInput{
+				Name:     name,
+				Memory:   memory,
+				DiskSize: diskSize,
+			}); err != nil {
+				return "", err
+			}
+
+			a.idle(func() {
+				a.refreshSidebar()
+				a.selectPage(machineTagPrefix + name)
+			})
+
+			return i18n.L("The machine was created"), nil
+		})
+
+		return true
+	})
+
+	validate := func() { scope.setValid(validMachineName(nameRow.GetText())) }
+	a.onEntryChanged(nameRow, validate)
+	validate()
+
+	a.present(dialog, scope)
+}
