+
+func (a *App) showRdpDialog(def virt.Definition) {
+	scope := a.newScope()
+
+	password := a.Service.RdpPassword()
+
+	signIn := a.credentialGroup("phial", password)
+
+	address := formGroup("Address", "The port is forwarded from the machine to this host.")
+	addressRow := adw.NewActionRow()
+	addressRow.SetTitle("[::1]:3389")
+	addressRow.SetSubtitle(i18n.L("Local to this host"))
+	addressRow.SetSubtitleSelectable(true)
+	addressRow.AddCssClass("property")
+	address.Add(&addressRow.Widget)
+
+	address.Add(a.unlockAgentRow())
+
+	address.Add(&a.buttonRow("_Open the Remote Desktop", "video-display-symbolic", func() {
+		a.goAsync(func() (string, error) {
+			if _, _, err := a.Service.DisplayOpenRdp(a.Ctx, nil, mcp.RdpInput{VM: def.Name}); err != nil {
+				return "", err
+			}
+			return i18n.L("The remote desktop opens in a moment"), nil
+		})
+	}).Widget)
+
+	address.Add(&a.buttonRow("_Copy the Command for Another Client", "edit-copy-symbolic", func() {
+		a.copyText(
+			fmt.Sprintf("xfreerdp /v:[::1]:3389 /u:%s /cert:ignore", def.Name),
+			i18n.L("Command copied"),
+		)
+	}).Widget)
+
+	content := a.formPage(address, signIn)
+	dialog := a.dialog(scope, "Remote Desktop", def.Name, "_Close", content, nil)
+
+	a.present(dialog, scope)
+}
+
+// showGuestAppsDialog lists the applications of the guest and runs one of them
+// either on this host through waypipe or inside the remote desktop.
+func (a *App) showGuestAppsDialog(def virt.Definition) {
+	scope := a.newScope()
+
+	mode := "waypipe"
+
+	destination := a.comboRow(
+		"Window",
+		[]string{i18n.L("On this host (waypipe)"), i18n.L("In the remote desktop")},
+		[]string{"waypipe", "session"},
+		mode,
+		func(value string) { mode = value },
+	)
+
+	destinationGroup := formGroup("Destination", "A waypipe window belongs to this desktop, an RDP window to the guest session.")
+	destinationGroup.Add(&destination.row.Widget)
+
+	search := gtk.NewSearchEntry()
+	search.SetPlaceholderText(i18n.L("Search applications"))
+	search.SetMarginTop(12)
+	search.SetMarginBottom(6)
+
+	group := adw.NewPreferencesGroup()
+
+	statusRow := adw.NewActionRow()
+	statusRow.SetTitle(i18n.L("Looking for applications"))
+	spinner := adw.NewSpinner()
+	spinner.SetVisible(true)
+	statusRow.AddPrefix(&spinner.Widget)
+	group.Add(&statusRow.Widget)
+
+	var appRows []*adw.ActionRow
+
+	var onSearch func(gtk.SearchEntry)
+	onSearch = func(gtk.SearchEntry) {
+		query := strings.ToLower(strings.TrimSpace(search.GetText()))
+		shown := 0
+
+		for _, row := range appRows {
+			match := query == "" || strings.Contains(strings.ToLower(row.GetTitle()), query)
+			row.SetVisible(match)
+			if match {
+				shown++
+			}
+		}
+
+		if len(appRows) == 0 {
+			return
+		}
+
+		if shown == 0 {
+			statusRow.SetTitle(i18n.L("No application matches"))
+			statusRow.SetVisible(true)
+			return
+		}
+
+		statusRow.SetVisible(false)
+	}
+	search.ConnectSearchChanged(&onSearch)
+	scope.hold(&onSearch)
+
+	runApp := func(command string) {
+		a.goAsync(func() (string, error) {
+			if _, _, err := a.Service.DisplayRunApp(a.Ctx, nil, mcp.RunAppInput{VM: def.Name, Command: command, Mode: mode}); err != nil {
+				return "", err
+			}
+
+			if mode == "session" {
+				return i18n.L("The application opens in the remote desktop"), nil
+			}
+
+			return i18n.L("The application opens on this host"), nil
+		})
+	}
+
+	command := adw.NewEntryRow()
+	command.SetTitle(i18n.L("_Command"))
+	command.SetUseUnderline(true)
+	command.SetShowApplyButton(false)
+
+	commandGroup := formGroup("Custom Command", "Run a program by name when it does not appear in the list above.")
+	commandGroup.Add(&command.Widget)
+	commandGroup.Add(&a.buttonRow("_Run the Command", "system-run-symbolic", func() {
+		value := strings.TrimSpace(command.GetText())
+		if value == "" {
+			a.toast(i18n.L("Enter a command first"))
+			return
+		}
+		runApp(value)
+	}).Widget)
+
+	page := adw.NewPreferencesPage()
+	page.Add(destinationGroup)
+	page.Add(group)
+	page.Add(commandGroup)
+
+	layout := gtk.NewBox(gtk.OrientationVerticalValue, 0)
+	layout.SetMarginStart(12)
+	layout.SetMarginEnd(12)
+	layout.SetMarginTop(12)
+	layout.SetMarginBottom(12)
+	layout.Append(&search.Widget)
+	layout.Append(&page.Widget)
+
+	content := a.scrolled(&layout.Widget)
+
+	dialog := a.dialog(scope, "Guest Applications", def.Name, "_Close", &content.Widget, nil)
+
+	go func() {
+		_, output, err := a.Service.ListGuestApps(a.Ctx, nil, mcp.ListAppsInput{VM: def.Name})
+
+		a.idle(func() {
+			spinner.SetVisible(false)
+
+			if err != nil {
+				statusRow.SetTitle(i18n.L("The applications could not be listed"))
+				statusRow.SetSubtitle(err.Error())
+				return
+			}
+
+			apps := []mcp.GuestApp{}
+			if output != nil {
+				apps = output.Apps
+			}
+
+			if len(apps) == 0 {
+				statusRow.SetTitle(i18n.L("The guest lists no applications"))
+				return
+			}
+
+			group.Remove(&statusRow.Widget)
+
+			for _, app := range apps {
+				app := app
+
+				row := adw.NewActionRow()
+				row.SetTitle(app.Name)
+				row.SetSubtitle(app.ID)
+				row.SetActivatable(true)
+
+				var cb func(adw.ActionRow)
+				cb = func(adw.ActionRow) { runApp(app.Exec) }
+				row.ConnectActivated(&cb)
+				scope.hold(&cb)
+
+				group.Add(&row.Widget)
+				appRows = append(appRows, row)
+			}
+		})
+	}()
+
+	a.present(dialog, scope)
+}
