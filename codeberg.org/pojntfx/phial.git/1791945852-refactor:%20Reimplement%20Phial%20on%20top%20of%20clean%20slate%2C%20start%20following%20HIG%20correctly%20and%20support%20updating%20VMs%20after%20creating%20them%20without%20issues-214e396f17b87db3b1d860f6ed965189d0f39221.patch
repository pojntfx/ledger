+// hugePagesUsable reports whether the host can back one memory size with huge
+// pages right now. Another machine can hold the pages that are not free.
+func hugePagesUsable(memory string) bool {
+	mib, err := memoryMiB(memory)
+	if err != nil {
+		return false
+	}
+
+	free, _, err := HugePages()
+	if err != nil {
+		return false
+	}
+
+	return free >= int64(mib)*1024*1024
+}
