diff --git a/assets/resources/install-machine-dialog.blp b/assets/resources/install-machine-dialog.blp
new file mode 100644
index 0000000000000000000000000000000000000000..65de277e4efb15ea187695f386187351d02c42c3
--- /dev/null
+++ b/assets/resources/install-machine-dialog.blp
@@ -0,0 +1,52 @@
+using Gtk 4.0;
+using Adw 1;
+
+template $PhialInstallMachineDialog: Adw.Dialog {
+  title: _("Install Machine");
+
+  child: Adw.ToolbarView {
+    [top]
+    Adw.HeaderBar {
+      show-start-title-buttons: false;
+      show-end-title-buttons: false;
+
+      [start]
+      Button {
+        label: _("_Cancel");
+        use-underline: true;
+        action-name: "window.close";
+      }
+
+      title-widget: Adw.WindowTitle {
+        title: _("Install Machine");
+      };
+
+      [end]
+      Button install_button {
+        label: _("_Install");
+        use-underline: true;
+        styles [
+          "suggested-action",
+        ]
+      }
+    }
+
+    content: Adw.PreferencesPage {
+      Adw.PreferencesGroup {
+        Adw.ComboRow operating_system_row {
+          title: _("Operating system");
+          enable-search: true;
+          search-match-mode: substring;
+          expression: expr item as <Gtk.StringObject>.string;
+        }
+
+        Adw.ComboRow version_row {
+          title: _("Version");
+          enable-search: true;
+          search-match-mode: substring;
+          expression: expr item as <Gtk.StringObject>.string;
+        }
+      }
+    };
+  };
+}
diff --git a/internal/components/install_machine_dialog.go b/internal/components/install_machine_dialog.go
new file mode 100644
index 0000000000000000000000000000000000000000..2e770ee858ac9eeea7dcb50b7bc6d7d9d12fda74
--- /dev/null
+++ b/internal/components/install_machine_dialog.go
@@ -0,0 +1,182 @@
+package components
+
+import (
+	"context"
+	"log/slog"
+	"runtime"
+	"unsafe"
+
+	"codeberg.org/pojntfx/phial/assets/resources"
+	"codeberg.org/pojntfx/phial/pkg/state"
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/glib"
+	"codeberg.org/puregotk/puregotk/v4/gobject"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	. "github.com/pojntfx/go-gettext/pkg/i18n"
+)
+
+var (
+	gTypeInstallMachineDialog gobject.Type
+)
+
+var operatingSystemVersions = [][]string{
+	{"45", "44"},
+	{"10"},
+}
+
+type InstallMachineDialog struct {
+	adw.Dialog
+
+	ctx   context.Context
+	store *state.Store
+	log   *slog.Logger
+
+	onInstalled func(name string)
+
+	machineName        string
+	installButton      *gtk.Button
+	operatingSystemRow *adw.ComboRow
+	versionRow         *adw.ComboRow
+
+	callbacks []interface{}
+}
+
+func NewInstallMachineDialog(ctx context.Context, store *state.Store, log *slog.Logger, onInstalled func(name string)) InstallMachineDialog {
+	obj := gobject.NewObject(gTypeInstallMachineDialog, "css-name")
+	gobject.IncreaseRef(obj.GoPointer())
+
+	var v InstallMachineDialog
+	obj.Cast(&v)
+
+	dialog := (*InstallMachineDialog)(unsafe.Pointer(obj.GetData(dataKeyGoInstance)))
+	dialog.ctx = ctx
+	dialog.store = store
+	dialog.log = log
+	dialog.onInstalled = onInstalled
+
+	dialog.operatingSystemRow.SetModel(gtk.NewStringList([]string{L("Fedora"), L("AlmaLinux")}))
+	dialog.versionRow.SetModel(gtk.NewStringList(operatingSystemVersions[0]))
+
+	onInstall := func(gtk.Button) {
+		if err := dialog.store.Install(dialog.ctx, dialog.machineName); err != nil {
+			dialog.log.Error("Could not install machine", "err", err)
+
+			return
+		}
+
+		if dialog.onInstalled != nil {
+			dialog.onInstalled(dialog.machineName)
+		}
+
+		dialog.Close()
+	}
+	dialog.callbacks = append(dialog.callbacks, &onInstall)
+	dialog.installButton.ConnectClicked(&onInstall)
+
+	onOperatingSystemChanged := func(gobject.Object, uintptr) {
+		dialog.updateVersions()
+	}
+	dialog.callbacks = append(dialog.callbacks, &onOperatingSystemChanged)
+	dialog.operatingSystemRow.ConnectNotify(&onOperatingSystemChanged)
+
+	dialog.operatingSystemRow.SetSelected(0)
+	dialog.versionRow.SetSelected(0)
+
+	return v
+}
+
+func (d *InstallMachineDialog) SetMachine(name string) {
+	d.machineName = name
+	d.operatingSystemRow.SetSelected(0)
+	d.updateVersions()
+}
+
+func (d *InstallMachineDialog) updateVersions() {
+	selected := d.operatingSystemRow.GetSelected()
+	if int(selected) >= len(operatingSystemVersions) {
+		selected = 0
+	}
+
+	d.versionRow.SetModel(gtk.NewStringList(operatingSystemVersions[selected]))
+	d.versionRow.SetSelected(0)
+}
+
+func init() {
+	var dialogClassInit gobject.ClassInitFunc = func(tc *gobject.TypeClass, u uintptr) {
+		typeClass := (*gtk.WidgetClass)(unsafe.Pointer(tc))
+		typeClass.SetTemplateFromResource(resources.ResourceInstallMachineDialogUIPath)
+		typeClass.BindTemplateChildFull("install_button", false, 0)
+		typeClass.BindTemplateChildFull("operating_system_row", false, 0)
+		typeClass.BindTemplateChildFull("version_row", false, 0)
+
+		objClass := (*gobject.ObjectClass)(unsafe.Pointer(tc))
+
+		objClass.OverrideConstructed(func(o *gobject.Object) {
+			parentObjClass := (*gobject.ObjectClass)(unsafe.Pointer(tc.PeekParent()))
+			parentObjClass.GetConstructed()(o)
+
+			var parent adw.Dialog
+			o.Cast(&parent)
+
+			parent.InitTemplate()
+
+			var (
+				installButton      gtk.Button
+				operatingSystemRow adw.ComboRow
+				versionRow         adw.ComboRow
+			)
+
+			parent.Widget.GetTemplateChild(
+				gTypeInstallMachineDialog,
+				"install_button",
+			).Cast(&installButton)
+			parent.Widget.GetTemplateChild(
+				gTypeInstallMachineDialog,
+				"operating_system_row",
+			).Cast(&operatingSystemRow)
+			parent.Widget.GetTemplateChild(
+				gTypeInstallMachineDialog,
+				"version_row",
+			).Cast(&versionRow)
+
+			d := &InstallMachineDialog{
+				Dialog: parent,
+
+				installButton:      &installButton,
+				operatingSystemRow: &operatingSystemRow,
+				versionRow:         &versionRow,
+
+				callbacks: []interface{}{},
+			}
+
+			var pinner runtime.Pinner
+			pinner.Pin(d)
+
+			var cleanupCallback glib.DestroyNotify = func(data uintptr) {
+				for _, callback := range d.callbacks {
+					if err := glib.UnrefCallback(callback); err != nil {
+						d.log.Error("Could not unref callback", "err", err)
+					}
+				}
+
+				pinner.Unpin()
+			}
+			o.SetDataFull(dataKeyGoInstance, uintptr(unsafe.Pointer(d)), &cleanupCallback)
+		})
+	}
+
+	var dialogInstanceInit gobject.InstanceInitFunc = func(ti *gobject.TypeInstance, tc *gobject.TypeClass) {}
+
+	var dialogParentQuery gobject.TypeQuery
+	gobject.NewTypeQuery(adw.DialogGLibType(), &dialogParentQuery)
+
+	gTypeInstallMachineDialog = gobject.TypeRegisterStaticSimple(
+		dialogParentQuery.Type,
+		"PhialInstallMachineDialog",
+		dialogParentQuery.ClassSize,
+		&dialogClassInit,
+		dialogParentQuery.InstanceSize,
+		&dialogInstanceInit,
+		0,
+	)
+}
