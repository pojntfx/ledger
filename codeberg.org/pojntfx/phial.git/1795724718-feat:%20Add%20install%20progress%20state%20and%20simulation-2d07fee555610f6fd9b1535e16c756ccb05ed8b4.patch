+	require.Equal(t, MachineStatusNotInstalled, s.Machines()[0].Status)
+}
+
+func TestStoreInstallCachesStatusAndStep(t *testing.T) {
+	s := newTestingStore(t, func(_ context.Context) (bool, error) { return false, nil })
+
+	require.NoError(t, s.AddMachine(t.Context(), MachineConfig{Name: "m1", MemoryGiB: 16, DiskGiB: 48}))
+	require.NoError(t, s.Install(t.Context(), "m1"))
+
+	machine := s.Machines()[0]
+	require.Equal(t, MachineStatusInstalling, machine.Status)
+	require.Equal(t, InstallStepDownloading, machine.InstallStep)
+	require.Equal(t, uint64(0), machine.InstallProgress.Downloaded)
+}
+
+func TestStoreInstallProgress(t *testing.T) {
+	s := newTestingStore(t, func(_ context.Context) (bool, error) { return false, nil })
+
+	require.NoError(t, s.AddMachine(t.Context(), MachineConfig{Name: "m1", MemoryGiB: 16, DiskGiB: 48}))
+	require.NoError(t, s.Install(t.Context(), "m1"))
+
+	require.NoError(t, s.advance(t.Context()))
+	require.Equal(t, uint64(installDownloadTotal/4), s.Machines()[0].InstallProgress.Downloaded)
+
+	for i := 0; i < 20 && s.Machines()[0].InstallStep != InstallStepPackages; i++ {
+		require.NoError(t, s.advance(t.Context()))
+	}
+	require.Equal(t, InstallStepPackages, s.Machines()[0].InstallStep)
+
+	require.NoError(t, s.advance(t.Context()))
+	require.Equal(t, uint32(installPackagesTotal/4), s.Machines()[0].InstallProgress.Packages)
+	require.NotEmpty(t, s.Machines()[0].InstallProgress.PackageName)
+}
+
