From cd61d947b574bbd423c8e996481c9978769eed70 Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Mon, 23 Nov 2026 23:45:00 -0700
Subject: [PATCH] fix: Left-align empty list rows in the Secrets pages
---
diff --git a/internal/components/secrets.go b/internal/components/secrets.go
index 4326394d9ec8676ff65976c940209d5fc6c7e0a1..958c2d5978ac9be478d91df9c4a1ef488855b490 100644
--- a/internal/components/secrets.go
+++ b/internal/components/secrets.go
@@ -167,15 +167,12 @@
 		return row.GoPointer()
 
 	case secretsRowEmpty:
-		label := gtk.NewLabel(item.title)
-		label.AddCssClass("dim-label")
-		label.SetHalign(gtk.AlignCenterValue)
-		label.SetMarginTop(12)
-		label.SetMarginBottom(12)
-		label.SetMarginStart(12)
-		label.SetMarginEnd(12)
+		row := adw.NewActionRow()
+		row.SetTitle(item.title)
+		row.AddCssClass("dim-label")
+		row.SetSensitive(false)
 
-		return label.GoPointer()
+		return row.GoPointer()
 	}
 
 	row := adw.NewActionRow()
diff --git a/internal/components/secrets_preferences.go b/internal/components/secrets_preferences.go
index bea28ebf5e9072b9b4ec7ff049f5a78da3dcc78c..1d36a381c0dc338b61d58796607ad917c263664a 100644
--- a/internal/components/secrets_preferences.go
+++ b/internal/components/secrets_preferences.go
@@ -221,15 +221,12 @@
 		return row.GoPointer()
 
 	case agentSocketRowEmpty:
-		label := gtk.NewLabel(item.title)
-		label.AddCssClass("dim-label")
-		label.SetHalign(gtk.AlignCenterValue)
-		label.SetMarginTop(12)
-		label.SetMarginBottom(12)
-		label.SetMarginStart(12)
-		label.SetMarginEnd(12)
+		row := adw.NewActionRow()
+		row.SetTitle(item.title)
+		row.AddCssClass("dim-label")
+		row.SetSensitive(false)
 
-		return label.GoPointer()
+		return row.GoPointer()
 	}
 
 	row := adw.NewActionRow()

