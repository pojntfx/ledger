+  <path d="M54 39V53.5C54 58.5 47 60.5 41 65.5C32 73 31 80.5 31 91C31 108 46 121 64 121C82 121 97 108 97 91C97 80.5 96 73 87 65.5C81 60.5 74 58.5 74 53.5V39Z" fill="none" stroke="#62a0ea" stroke-width="3" stroke-linejoin="round"/>
