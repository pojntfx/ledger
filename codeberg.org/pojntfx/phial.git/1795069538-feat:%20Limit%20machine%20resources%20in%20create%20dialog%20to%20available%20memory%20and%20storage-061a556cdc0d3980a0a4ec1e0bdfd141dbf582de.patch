 )
 
 var (
@@ -19,16 +26,29 @@ 	gTypeCreateMachineDialog gobject.Type
 	hostnameValidator        = validator.New()
 )
 
+const (
+	minimumMemoryGiB = 1
+	minimumDiskGiB   = 8
+)
+
 type CreateMachineDialog struct {
 	adw.Dialog
 
+	store *state.Store
+	log   *slog.Logger
+
 	nameRow         *adw.EntryRow
 	nameErrorButton *gtk.MenuButton
+	memoryRow       *adw.SpinRow
+	diskRow         *adw.SpinRow
+
+	memoryLimitKnown bool
+	diskLimitKnown   bool
 
 	callbacks []interface{}
 }
 
-func NewCreateMachineDialog() CreateMachineDialog {
+func NewCreateMachineDialog(store *state.Store, log *slog.Logger) CreateMachineDialog {
 	obj := gobject.NewObject(gTypeCreateMachineDialog, "css-name")
 	gobject.IncreaseRef(obj.GoPointer())
 
@@ -36,6 +56,8 @@ 	var v CreateMachineDialog
 	obj.Cast(&v)
 
 	dialog := (*CreateMachineDialog)(unsafe.Pointer(obj.GetData(dataKeyGoInstance)))
+	dialog.store = store
+	dialog.log = log
 
 	onAliasChanged := func() {
 		dialog.validateAlias()
@@ -43,9 +65,99 @@ 	}
 	dialog.callbacks = append(dialog.callbacks, &onAliasChanged)
 	dialog.nameRow.PreferencesRow.ListBoxRow.Widget.InitiallyUnowned.Object.ConnectSignal("changed", &onAliasChanged)
 
+	onMemoryChanged := func(gtk.Adjustment) {
+		dialog.updateMemoryTooltip()
+	}
+	dialog.callbacks = append(dialog.callbacks, &onMemoryChanged)
+	dialog.memoryRow.GetAdjustment().ConnectValueChanged(&onMemoryChanged)
+
+	onDiskChanged := func(gtk.Adjustment) {
+		dialog.updateDiskTooltip()
+	}
+	dialog.callbacks = append(dialog.callbacks, &onDiskChanged)
+	dialog.diskRow.GetAdjustment().ConnectValueChanged(&onDiskChanged)
+
+	dialog.Refresh()
+
 	return v
 }
 
+func (w *CreateMachineDialog) Refresh() {
+	w.memoryRow.SetSensitive(false)
+	w.diskRow.SetSensitive(false)
+
+	folder := w.store.MachinesFolder()
+	if folder == "" {
+		folder = w.store.SuggestedMachinesFolder()
+	}
+
+	if memory, ok := availableMemoryGiB(); ok {
+		w.memoryLimitKnown = true
+		w.setUpper(w.memoryRow, memory, minimumMemoryGiB)
+		w.memoryRow.SetSensitive(true)
+	} else {
+		w.memoryLimitKnown = false
+	}
+
+	if diskFree, ok := freeDiskGiB(folder); ok {
+		w.diskLimitKnown = true
+		w.setUpper(w.diskRow, diskFree, minimumDiskGiB)
+		w.diskRow.SetSensitive(true)
+	} else {
+		w.diskLimitKnown = false
+	}
+
+	w.updateMemoryTooltip()
+	w.updateDiskTooltip()
+	w.validateAlias()
+}
+
+func (w *CreateMachineDialog) setUpper(row *adw.SpinRow, value float64, minimum float64) {
+	adjustment := row.GetAdjustment()
+
+	upper := math.Max(0, math.Floor(value))
+	lower := minimum
+	if upper < lower {
+		lower = upper
+	}
+
+	value = math.Min(math.Max(adjustment.GetValue(), lower), upper)
+
+	adjustment.Configure(
+		value,
+		lower,
+		upper,
+		adjustment.GetStepIncrement(),
+		adjustment.GetPageIncrement(),
+		adjustment.GetPageSize(),
+	)
+}
+
+func (w *CreateMachineDialog) updateMemoryTooltip() {
+	w.updateUpperTooltip(w.memoryRow, L("No more memory available"), w.memoryLimitKnown)
+}
+
+func (w *CreateMachineDialog) updateDiskTooltip() {
+	w.updateUpperTooltip(w.diskRow, L("No more storage available"), w.diskLimitKnown)
+}
+
+func (w *CreateMachineDialog) updateUpperTooltip(row *adw.SpinRow, message string, known bool) {
+	if !known {
+		row.SetTooltipText("")
+
+		return
+	}
+
