+func availableMemoryGiB() (float64, bool) {
+	stat, err := mem.VirtualMemory()
+	if err != nil {
+		return 0, false
+	}
+
+	return float64(stat.Available) / (1024 * 1024 * 1024), true
+}
+
+func freeDiskGiB(path string) (float64, bool) {
+	if path == "" {
+		return 0, false
+	}
+
+	path = filepath.Clean(path)
+
+	for {
+		usage, err := disk.Usage(path)
+		if err == nil {
+			return float64(usage.Free) / (1024 * 1024 * 1024), true
+		}
+
+		if !errors.Is(err, fs.ErrNotExist) {
+			return 0, false
+		}
+
+		parent := filepath.Dir(path)
+		if parent == path || parent == "/" {
+			return 0, false
+		}
+
+		path = parent
+	}
+}
