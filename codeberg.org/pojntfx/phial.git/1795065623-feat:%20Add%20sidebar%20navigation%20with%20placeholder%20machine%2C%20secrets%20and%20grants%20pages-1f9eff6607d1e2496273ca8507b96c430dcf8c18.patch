diff --git a/internal/components/main_window.go b/internal/components/main_window.go
index 5c75b3528f4975e74c4efd17fc9748477fb71c9a..8bfb4aed5c91107c668b45895fd9b0f0eebeefbb 100644
--- a/internal/components/main_window.go
+++ b/internal/components/main_window.go
@@ -20,6 +20,16 @@ const (
 	contentPageConnecting = "connecting"
 	contentPageSetup      = "setup"
 	contentPageReady      = "ready"
+
+	contentPageNoMachines = "no-machines"
+	contentPageSecrets    = "secrets"
+	contentPageGrants     = "grants"
+)
+
+const (
+	sidebarItemGetStarted uint32 = iota
+	sidebarItemSecrets
+	sidebarItemGrants
 )
 
 var (
@@ -38,6 +48,12 @@ 	store *state.Store
 
 	contentStack gtk.Stack
 
+	splitView   *adw.NavigationSplitView
+	sidebar     *adw.Sidebar
+	contentView *adw.NavigationView
+
+	currentPage string
+
 	welcomeStatusPage *adw.StatusPage
 
 	setupDialog *SetupDialog
@@ -62,6 +78,30 @@ 	window.store = store
 
 	window.ctx = ctx
 
+	onSidebarActivated := func(_ adw.Sidebar, index uint32) {
+		var tag string
+
+		switch index {
+		case sidebarItemGetStarted:
+			tag = contentPageNoMachines
+		case sidebarItemSecrets:
+			tag = contentPageSecrets
+		case sidebarItemGrants:
+			tag = contentPageGrants
+		default:
+			return
+		}
+
+		window.currentPage = tag
+		window.showPage(tag)
+
+		if window.splitView.GetCollapsed() {
+			window.splitView.SetShowContent(true)
+		}
+	}
+	window.callbacks = append(window.callbacks, &onSidebarActivated)
+	window.sidebar.ConnectActivated(&onSidebarActivated)
+
 	setupDialog := NewSetupDialog(window.ctx, window.store, window.settings, window.log, &window.ApplicationWindow.Widget)
 	window.setupDialog = (*SetupDialog)(unsafe.Pointer(setupDialog.Widget.GetData(dataKeyGoInstance)))
 
@@ -118,6 +158,7 @@
 	if w.store.HostStatus() == state.HostStatusConnecting {
 		w.contentStack.SetVisibleChildName(contentPageConnecting)
 	} else if w.store.Ready() || w.store.Page() == state.SetupPageFinish {
+		w.syncSidebar()
 		w.contentStack.SetVisibleChildName(contentPageReady)
 	} else {
 		w.contentStack.SetVisibleChildName(contentPageSetup)
@@ -126,12 +167,42 @@
 	w.setupDialog.Refresh()
 }
 
+func (w *MainWindow) syncSidebar() {
+	index := sidebarItemGetStarted
+
+	switch w.currentPage {
+	case contentPageSecrets:
+		index = sidebarItemSecrets
+	case contentPageGrants:
+		index = sidebarItemGrants
+	default:
+		w.currentPage = contentPageNoMachines
+	}
+
+	if w.sidebar.GetSelected() != index {
+		w.sidebar.SetSelected(index)
+	}
+
+	w.showPage(w.currentPage)
+}
+
+func (w *MainWindow) showPage(tag string) {
+	if w.contentView.GetVisiblePageTag() == tag {
+		return
+	}
+
+	w.contentView.ReplaceWithTags([]string{tag}, 1)
+}
+
 func init() {
 	var windowClassInit gobject.ClassInitFunc = func(tc *gobject.TypeClass, u uintptr) {
 		typeClass := (*gtk.WidgetClass)(unsafe.Pointer(tc))
 		typeClass.SetTemplateFromResource(resources.ResourceWindowUIPath)
 		typeClass.BindTemplateChildFull("content_stack", false, 0)
 		typeClass.BindTemplateChildFull("welcome_status_page", false, 0)
+		typeClass.BindTemplateChildFull("split_view", false, 0)
+		typeClass.BindTemplateChildFull("sidebar", false, 0)
+		typeClass.BindTemplateChildFull("content_view", false, 0)
 
 		objClass := (*gobject.ObjectClass)(unsafe.Pointer(tc))
 
@@ -147,6 +218,9 @@
 			var (
 				contentStack      gtk.Stack
 				welcomeStatusPage adw.StatusPage
+				splitView         adw.NavigationSplitView
+				sidebar           adw.Sidebar
+				contentView       adw.NavigationView
 			)
 
 			parent.Widget.GetTemplateChild(
@@ -157,11 +231,27 @@ 			parent.Widget.GetTemplateChild(
 				gTypeMainWindow,
 				"welcome_status_page",
 			).Cast(&welcomeStatusPage)
+			parent.Widget.GetTemplateChild(
+				gTypeMainWindow,
+				"split_view",
+			).Cast(&splitView)
+			parent.Widget.GetTemplateChild(
+				gTypeMainWindow,
+				"sidebar",
+			).Cast(&sidebar)
+			parent.Widget.GetTemplateChild(
+				gTypeMainWindow,
+				"content_view",
+			).Cast(&contentView)
 
 			w := &MainWindow{
 				ApplicationWindow: parent,
 
 				contentStack: contentStack,
+
+				splitView:   &splitView,
+				sidebar:     &sidebar,
+				contentView: &contentView,
 
 				welcomeStatusPage: &welcomeStatusPage,
 
