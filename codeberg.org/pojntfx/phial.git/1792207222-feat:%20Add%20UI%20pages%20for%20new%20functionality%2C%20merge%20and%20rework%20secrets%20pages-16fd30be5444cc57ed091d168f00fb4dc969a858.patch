-	currentDuration := a.Settings.GetString(resources.SettingGrantDurationKey)
-	currentKind := a.Settings.GetString(resources.SettingGrantKindKey)
-
-	durationRow := a.comboRow(
-		"Duration",
-		[]string{i18n.L("15 minutes"), i18n.L("1 hour"), i18n.L("4 hours"), i18n.L("1 day")},
-		durations,
-		currentDuration,
-		func(value string) { currentDuration = value },
-	)
-
-	kindRow := a.comboRow(
-		"Kind",
-		[]string{i18n.L("API key"), i18n.L("SSH key"), i18n.L("GnuPG key")},
-		kinds,
-		currentKind,
-		func(value string) { currentKind = value },
-	)
-
-	group := formGroup(
-		"Grant",
-		"The grant ends on its own when the time runs out. An SSH key is loaded into a dedicated agent with a confirmation prompt on this host.",
-		&durationRow.row.Widget,
-		&kindRow.row.Widget,
-	)
-
-	content := a.formPage(group)
-
-	dialog := a.dialog(scope, "Grant Access", name, "_Grant", content, func() bool {
-		duration := currentDuration
-		kind := currentKind
-
-		a.goAsync(func() (string, error) {
-			if _, _, err := a.Service.GrantAllow(a.Ctx, nil, mcp.GrantInput{
-				Name:     name,
-				Kind:     kind,
-				Duration: duration,
-			}); err != nil {
