diff --git a/internal/ui/grants.go b/internal/ui/grants.go
new file mode 100644
index 0000000000000000000000000000000000000000..f2a879a16adeed0236ca9aff4f4c711ed0251842
--- /dev/null
+++ b/internal/ui/grants.go
@@ -0,0 +1,358 @@
+package ui
+
+import (
+	"fmt"
+	"time"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+
+	"codeberg.org/pojntfx/phial-neo/assets/resources"
+	"codeberg.org/pojntfx/phial-neo/internal/mcp"
+	"codeberg.org/pojntfx/phial-neo/internal/state"
+	"codeberg.org/pojntfx/phial-neo/internal/virt"
+)
+
+// The Grants page lists the open grants and the grant requests that wait for
+// an answer.
+func (a *App) buildGrantsPage() *adw.NavigationPage {
+	stack := gtk.NewStack()
+	stack.SetTransitionType(gtk.StackTransitionTypeCrossfadeValue)
+	a.grantsStack = stack
+
+	empty := a.statusPage(
+		"alarm-symbolic",
+		"No Grants",
+		"A grant opens one secret or key for one machine. Grant access from the Secrets page.",
+	)
+	stack.AddNamed(&empty.Widget, "empty")
+
+	a.grantsGroup = adw.NewPreferencesGroup()
+	a.grantsGroup.SetTitle(i18n.L("Active Grants"))
+
+	a.grantRequestsGroup = adw.NewPreferencesGroup()
+	a.grantRequestsGroup.SetTitle(i18n.L("Pending Requests"))
+
+	stack.AddNamed(a.pageContent(a.grantRequestsGroup, a.grantsGroup), "list")
+
+	page_, _, title := a.pageToolbar("Grants", "", &stack.Widget)
+
+	page_.SetTag(grantsTag)
+	title.SetTitle(i18n.L("Grants"))
+
+	return page_
+}
+
+// grantIcon names the icon of one grant kind.
+func grantIcon(kind string) string {
+	switch kind {
+	case state.KindSSHKey:
+		return "channel-secure-symbolic"
+	case state.KindGPGKey:
+		return "security-high-symbolic"
+	default:
+		return "dialog-password-symbolic"
+	}
+}
+
+// grantKindText names the kind of a grant for a row subtitle.
+func grantKindText(kind string) string {
+	switch kind {
+	case state.KindSSHKey:
+		return i18n.L("SSH key")
+	case state.KindGPGKey:
+		return i18n.L("GnuPG keys")
+	default:
+		return i18n.L("Secret")
+	}
+}
+
+// grantSubtitle states the machine and the remaining time of one grant.
+func grantSubtitle(grant state.Grant) string {
+	suffix := ""
+	switch {
+	case grant.Once:
+		suffix = i18n.L("one use")
+	case grant.Expires == 0:
+		suffix = i18n.L("until revoked")
+	default:
+		remaining := grant.Expires - nowUnix()
+		if remaining <= 0 {
+			suffix = i18n.L("expired")
+		} else {
+			suffix = fmt.Sprintf(i18n.L("%s left"), durationText(remaining))
+		}
+	}
+
+	return fmt.Sprintf(i18n.L("%s to %s, %s"), grantKindText(grant.Kind), grant.VM, suffix)
+}
+
+// refreshGrantsPage reconciles the grant rows with the grant store and the
+// pending grant requests.
+func (a *App) refreshGrantsPage() {
+	grants := a.State.ActiveGrants()
+
+	pending := a.Service.Pending()
+
+	signature := "empty"
+	for _, grant := range grants {
+		signature += fmt.Sprintf("%s:%d;", grant.ID, grant.Expires-nowUnix())
+	}
+	for _, request := range pending {
+		signature += request.ID + ";"
+	}
+
+	if signature == a.grantsSignature {
+		return
+	}
+	a.grantsSignature = signature
+
+	for _, row := range a.grantRows {
+		a.grantsGroup.Remove(&row.Widget)
+	}
+	a.grantRows = nil
+
+	for _, row := range a.grantRequestRows {
+		a.grantRequestsGroup.Remove(&row.Widget)
+	}
+	a.grantRequestRows = nil
+
+	a.grantRequestsGroup.SetVisible(len(pending) > 0)
+	a.grantsGroup.SetVisible(len(grants) > 0)
+
+	if len(grants) == 0 && len(pending) == 0 {
+		a.grantsStack.SetVisibleChildName("empty")
+		return
+	}
+
+	a.grantsStack.SetVisibleChildName("list")
+
+	for _, grant := range grants {
+		grant := grant
+
+		row := adw.NewActionRow()
+		row.SetUseMarkup(false)
+		row.SetTitle(grant.Name)
+		row.SetSubtitle(grantSubtitle(grant))
+		row.SetIconName(grantIcon(grant.Kind))
+
+		revoke := a.iconButton("window-close-symbolic", i18n.L("Revoke"), func() {
+			a.revokeGrant(grant.ID)
+		})
+		revoke.AddCssClass("destructive-action")
+		row.AddSuffix(&revoke.Widget)
+
+		a.grantsGroup.Add(&row.Widget)
+		a.grantRows = append(a.grantRows, row)
+	}
+
+	for _, request := range pending {
+		request := request
+
+		row := adw.NewActionRow()
+		row.SetUseMarkup(false)
+
+		// A grant request reads as one line already, a change request names
+		// its action first.
+		title := request.Detail
+		if request.Category != mcp.CategoryGrant {
+			title = request.Action + ": " + request.Detail
+		}
+		row.SetTitle(title)
+
+		subtitle := fmt.Sprintf(i18n.L("%s ago"), durationText(int64(time.Since(request.Created).Seconds())))
+		if request.VM != "" {
+			subtitle = request.VM + ", " + subtitle
+		}
+		row.SetSubtitle(subtitle)
+
+		approve := a.iconButton("object-select-symbolic", i18n.L("Approve"), func() {
+			a.answerRequest(request.ID, true)
+		})
+		// A flat button with the suggested style paints nothing with this
+		// libadwaita, so the approve control keeps its frame.
+		approve.SetHasFrame(true)
+		approve.AddCssClass("suggested-action")
+
+		deny := a.iconButton("window-close-symbolic", i18n.L("Deny"), func() {
+			a.answerRequest(request.ID, false)
+		})
+		deny.AddCssClass("destructive-action")
+
+		row.AddSuffix(&approve.Widget)
+		row.AddSuffix(&deny.Widget)
+
+		a.grantRequestsGroup.Add(&row.Widget)
+		a.grantRequestRows = append(a.grantRequestRows, row)
+	}
+}
+
+// revokeGrant closes one grant.
+func (a *App) revokeGrant(id string) {
+	a.goAsync(func() (string, error) {
+		if err := a.State.RevokeGrant(id); err != nil {
+			return "", err
+		}
+
+		a.idle(func() {
+			a.refreshGrantsPage()
+			a.refreshSecretsPage()
+			a.refreshCounts()
+		})
+
+		return i18n.L("The grant was revoked"), nil
+	})
+}
+
+// showGrantDialog opens the grant dialog for one target. The kind comes from
+// the target, so the dialog asks for the machine and the duration only.
+func (a *App) showGrantDialog(kind string, name string) {
+	scope := a.newScope()
+
+	machines := []string{}
+	if defs, err := virt.List(); err == nil {
+		for _, def := range defs {
+			machines = append(machines, def.Name)
+		}
+	}
+
+	if len(machines) == 0 {
+		a.toast(i18n.L("Create a machine first"))
+		return
+	}
+
+	selectedMachine := machines[0]
+	for _, machine := range machines {
+		if def, err := virt.Load(machine); err == nil {
+			if active, _ := def.Active(); active {
+				selectedMachine = machine
+				break
+			}
+		}
+	}
+
+	machineRow := a.comboRow(
+		"Machine",
+		machines,
+		machines,
+		selectedMachine,
+		func(value string) { selectedMachine = value },
+	)
+
+	durations := []string{"once", "15min", "1h", "4h", "1d", "forever"}
+	durationLabels := []string{
+		i18n.L("One use"),
+		i18n.L("15 minutes"),
+		i18n.L("1 hour"),
+		i18n.L("4 hours"),
+		i18n.L("1 day"),
+		i18n.L("Until revoked"),
+	}
+
+	currentDuration := a.Settings.GetString(resources.SettingGrantDurationKey)
+	if currentDuration == "" {
+		currentDuration = "1h"
+	}
+
+	durationRow := a.comboRow(
+		"Duration",
+		durationLabels,
+		durations,
+		currentDuration,
+		func(value string) { currentDuration = value },
+	)
+
+	description := i18n.L("The timer runs on the host, so a grant ends after Phial closes.")
+
+	// An env secret cannot close after one use, because the host never sees
+	// the read. The choice goes for it.
+	if kind == state.KindSecret {
+		if rows, err := a.State.Rows(); err == nil {
+			for _, row := range rows {
+				if row.Name == name && row.Mode == "env" {
+					durations = durations[1:]
+					durationLabels = durationLabels[1:]
+
+					if currentDuration == "once" {
+						currentDuration = "1h"
+					}
+				}
+			}
+		}
+	}
+
+	group := formGroup("Grant", description, &machineRow.row.Widget, &durationRow.row.Widget)
+
+	content := a.formPage(group)
+
+	target := name
+	switch kind {
+	case state.KindSSHKey:
+		target = state.SSHAgentScheme + name
+	case state.KindGPGKey:
+		target = state.GPGAgentScheme
+	}
+
+	title := i18n.L("Grant Access")
+	subtitle := name
+	if kind == state.KindGPGKey {
+		subtitle = i18n.L("The GnuPG keys of this host")
+	}
+
+	dialog := a.dialog(scope, title, subtitle, "_Grant", content, func() bool {
+		duration := currentDuration
+		vm := selectedMachine
+
+		a.goAsync(func() (string, error) {
+			options := state.AllowOptions{Target: target, VM: vm}
+
+			switch duration {
+			case "once":
+				options.Once = true
+			case "forever":
+				options.Forever = true
+			default:
+				options.Duration = duration
+			}
+
+			if _, err := a.State.Grant(options); err != nil {
+				return "", err
+			}
+
+			a.idle(func() {
+				a.refreshGrantsPage()
+				a.refreshSecretsPage()
+				a.refreshCounts()
+			})
+
+			return i18n.L("The grant is open"), nil
+		})
+
+		return true
+	})
+
+	scope.setValid(true)
+
+	a.present(dialog, scope)
+}
+
+func (a *App) answerRequest(id string, approve bool) {
+	a.goAsync(func() (string, error) {
+		if err := a.Service.Answer(id, approve); err != nil {
+			return "", err
+		}
+
+		a.idle(func() {
+			a.refreshGrantsPage()
+			a.refreshSecretsPage()
+			a.refreshCounts()
+		})
+
+		if approve {
+			return i18n.L("The request was approved"), nil
+		}
+
+		return i18n.L("The request was denied"), nil
+	})
+}
