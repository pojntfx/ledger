-func (a *App) refreshProviderPage(name string) {
-	page := a.providerPages[name]
-	if page == nil {
-		return
-	}
-
-	rows, err := a.State.Rows()
-	if err != nil {
-		return
-	}
-
-	var entry *state.Row
-	for index := range rows {
-		if rows[index].Name == name {
-			entry = &rows[index]
-			break
-		}
-	}
-
-	if entry == nil {
-		return
-	}
-
-	mode := i18n.L("Env")
-	if entry.Mode == "proxy" {
-		mode = i18n.L("Proxy")
-	}
-
-	page.modeRow.SetSubtitle(mode)
-	page.sourceRow.SetSubtitle(entry.Source)
-
-	if entry.Mode == "proxy" {
-		page.upstreamRow.SetVisible(true)
-		page.upstreamRow.SetSubtitle(entry.Upstream)
-	} else {
-		page.upstreamRow.SetVisible(false)
-	}
-
-	grant := a.State.GrantInfo(name)
-	if grant != nil {
-		remaining := grant.ExpiresUnix - nowUnix()
-		if remaining > 0 {
-			page.accessRow.SetSubtitle(fmt.Sprintf(
-				i18n.L("Granted as %s for another %s"),
-				grant.Kind,
-				durationText(remaining),
-			))
-			page.grantRow.SetVisible(true)
-			page.grantRow.SetTitle(i18n.L("_Extend the Grant…"))
-			page.revokeRow.SetVisible(true)
-			return
-		}
-	}
-
-	page.accessRow.SetSubtitle(i18n.L("Not granted"))
-	page.grantRow.SetVisible(true)
-	page.grantRow.SetTitle(i18n.L("_Grant Access…"))
-	page.revokeRow.SetVisible(false)
-}
