+// The Secrets page lists what a machine can be granted: the keys of the host
+// agents and the secrets of the host keyring. Private parts never leave the
+// host.
+func (a *App) buildSecretsPage() *adw.NavigationPage {
+	stack := gtk.NewStack()
+	stack.SetTransitionType(gtk.StackTransitionTypeCrossfadeValue)
+	a.secretsStack = stack
+
+	a.secretsEmpty = a.statusPage(
+		"dialog-password-symbolic",
+		"No Secrets",
+		"A machine uses a secret or a key only while a grant is open. The values stay on this host.",
+	)
+	a.secretsEmptyButton = a.labelButton("_Add Secret", func() { a.activate("add-secret") })
+	a.secretsEmptyButton.AddCssClass("suggested-action")
+	a.secretsEmptyButton.AddCssClass("pill")
+	a.secretsEmptyButton.SetHalign(gtk.AlignCenterValue)
+	a.secretsEmpty.SetChild(&a.secretsEmptyButton.Widget)
+
