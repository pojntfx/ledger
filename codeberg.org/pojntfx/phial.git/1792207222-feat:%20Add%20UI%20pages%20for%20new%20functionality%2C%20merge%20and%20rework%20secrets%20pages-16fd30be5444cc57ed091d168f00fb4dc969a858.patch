-func providerSubtitle(a *App, row state.Row) string {
-	mode := i18n.L("Env")
-	if row.Mode == "proxy" {
-		mode = i18n.L("Proxy")
-	}
-
-	detail := mode + ", " + row.Source
-	if row.Mode == "proxy" && row.Upstream != "" && row.Upstream != "-" {
-		detail = mode + ", " + row.Upstream
-	}
-
-	if grant := a.State.GrantInfo(row.Name); grant != nil {
-		remaining := grant.ExpiresUnix - nowUnix()
-		if remaining > 0 {
-			return detail + ", " + fmt.Sprintf(i18n.L("granted for %s"), durationText(remaining))
-		}
-	}
-
-	return detail
-}
