-// providerFormValid reports whether the provider form carries a name and a
-// password store source.
-func providerFormValid(nameRow *adw.EntryRow, sourceRow *adw.EntryRow) bool {
-	provider := strings.TrimSpace(nameRow.GetText())
-	source := strings.TrimSpace(sourceRow.GetText())
-
-	return provider != "" && strings.HasPrefix(source, "keepassxc://")
-}
