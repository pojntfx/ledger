new file mode 100644
index 0000000000000000000000000000000000000000..cfdcd995209f1c79b85dc6fc0856f9f22a90497a
--- /dev/null
+++ b/internal/ui/keys.go
@@ -0,0 +1,237 @@
+package ui
+
+import (
+	"fmt"
+	"strings"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gio"
+	"codeberg.org/puregotk/puregotk/v4/glib"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+
+	"codeberg.org/pojntfx/phial-neo/internal/state"
+)
+
+// shortFingerprint shortens a fingerprint for a row subtitle.
+func shortFingerprint(fingerprint string) string {
+	if len(fingerprint) > 16 {
+		return fingerprint[len(fingerprint)-16:]
+	}
+
+	return fingerprint
+}
+
+// showAddSSHKeyDialog loads one private key file into the agent of the
+// session. The passphrase prompt comes from the session.
+func (a *App) showAddSSHKeyDialog() {
+	dialog := gtk.NewFileDialog()
+	dialog.SetTitle(i18n.L("Select the private key"))
+
+	startDir := gio.FileNewForPath(glib.GetHomeDir() + "/.ssh")
+	dialog.SetInitialFolder(startDir)
+
+	var cb gio.AsyncReadyCallback
+	cb = func(_ uintptr, resultPtr uintptr, _ uintptr) {
+		result := gio.AsyncResultBase{Ptr: resultPtr}
+		file, err := dialog.OpenFinish(&result)
+		if err != nil || file == nil {
+			return
+		}
+
+		a.goAsync(func() (string, error) {
+			if err := a.State.AddSSHKey(file.GetPath()); err != nil {
+				return "", err
+			}
+
+			a.idle(func() {
+				a.secretsSignature = ""
+				a.refreshSecretsPage()
+			})
+
+			return i18n.L("The key was loaded into the agent"), nil
+		})
+	}
+	a.hold(&cb)
+
+	dialog.Open(&a.win.Window, nil, &cb, 0)
+}
+
+// showGenerateKeyDialog creates a new key on the host: an SSH key pair in
+// ~/.ssh, or a GnuPG key in the host keyring.
+func (a *App) showGenerateKeyDialog() {
+	scope := a.newScope()
+
+	kind := "ssh"
+
+	commentRow := a.entryRow("_Comment")
+	commentRow.SetUseUnderline(true)
+	commentRow.SetShowApplyButton(false)
+	commentRow.GrabFocus()
+
+	ownerRow := a.entryRow("_Name")
+	ownerRow.SetUseUnderline(true)
+	ownerRow.SetShowApplyButton(false)
+
+	emailRow := a.entryRow("_Email")
+	emailRow.SetUseUnderline(true)
+	emailRow.SetShowApplyButton(false)
+
+	kindRow := a.comboRow(
+		"Kind",
+		[]string{i18n.L("SSH key"), i18n.L("GnuPG key")},
+		[]string{"ssh", "gpg"},
+		"ssh",
+		func(value string) {
+			kind = value
+			commentRow.SetVisible(value == "ssh")
+			ownerRow.SetVisible(value == "gpg")
+			emailRow.SetVisible(value == "gpg")
+		},
+	)
+	ownerRow.SetVisible(false)
+	emailRow.SetVisible(false)
+
+	group := formGroup("New Key", "The private key never leaves this host.", &kindRow.row.Widget)
+	group.Add(&commentRow.Widget)
+	group.Add(&ownerRow.Widget)
+	group.Add(&emailRow.Widget)
+
+	content := a.formPage(group)
+
+	dialog := a.dialog(scope, "Generate a Key", i18n.L("A new key for the agent of this host"), "_Generate", content, func() bool {
+		switch kind {
+		case "ssh":
+			comment := strings.TrimSpace(commentRow.GetText())
+			if comment == "" {
+				a.toast(i18n.L("A comment is required"))
+				return false
+			}
+
+			a.goAsync(func() (string, error) {
+				if err := a.State.GenerateSSHKey(comment); err != nil {
+					return "", err
+				}
+
+				a.idle(func() {
+					a.secretsSignature = ""
+					a.refreshSecretsPage()
+				})
+
+				return i18n.L("The SSH key was generated"), nil
+			})
+		default:
+			name := strings.TrimSpace(ownerRow.GetText())
+			if name == "" {
+				a.toast(i18n.L("A name is required"))
+				return false
+			}
+
+			email := strings.TrimSpace(emailRow.GetText())
+
+			a.goAsync(func() (string, error) {
+				if err := a.State.GenerateGPGKey(name, email); err != nil {
+					return "", err
+				}
+
+				a.idle(func() {
+					a.secretsSignature = ""
+					a.refreshSecretsPage()
+				})
+
+				return i18n.L("The GnuPG key was generated"), nil
+			})
+		}
+
+		return true
+	})
+
+	validate := func() {
+		if kind == "ssh" {
+			scope.setValid(strings.TrimSpace(commentRow.GetText()) != "")
+			return
+		}
+
+		scope.setValid(strings.TrimSpace(ownerRow.GetText()) != "")
+	}
+
+	a.onEntryChanged(commentRow, validate)
+	a.onEntryChanged(ownerRow, validate)
+	validate()
+
+	a.present(dialog, scope)
+}
+
+// confirmUnloadSSHKey drops one key from the agent of the session. The file
+// on disk stays.
+func (a *App) confirmUnloadSSHKey(comment string) {
+	dialog := adw.NewAlertDialog(
+		i18n.L("Unload the key from the agent?"),
+		fmt.Sprintf(i18n.L("This unloads %s from the agent of the session. The file on disk stays."), comment),
+	)
+	dialog.AddResponse("cancel", i18n.L("_Cancel"))
+	dialog.AddResponse("remove", i18n.L("_Unload"))
+	dialog.SetResponseAppearance("remove", adw.ResponseDestructiveValue)
+	dialog.SetCloseResponse("cancel")
+
+	var cb func(adw.AlertDialog, string)
+	cb = func(_ adw.AlertDialog, response string) {
+		if response != "remove" {
+			return
+		}
+
+		a.goAsync(func() (string, error) {
+			if err := a.State.RemoveSSHKey(comment); err != nil {
+				return "", err
+			}
+
+			a.idle(func() {
+				a.secretsSignature = ""
+				a.refreshSecretsPage()
+			})
+
+			return i18n.L("The key was unloaded"), nil
+		})
+	}
+	dialog.ConnectResponse(&cb)
+	a.hold(&cb)
+
+	dialog.Present(&a.win.Widget)
+}
+
+// confirmRemoveGPGKey deletes the secret part of one key. The public part
+// stays, so old signatures still verify.
+func (a *App) confirmRemoveGPGKey(key state.GPGKey) {
+	dialog := adw.NewAlertDialog(
+		i18n.L("Delete the secret key?"),
+		fmt.Sprintf(i18n.L("This deletes the secret part of %s. The public part stays, so old signatures still verify."), key.UID),
+	)
+	dialog.AddResponse("cancel", i18n.L("_Cancel"))
+	dialog.AddResponse("remove", i18n.L("_Delete"))
+	dialog.SetResponseAppearance("remove", adw.ResponseDestructiveValue)
+	dialog.SetCloseResponse("cancel")
+
+	var cb func(adw.AlertDialog, string)
+	cb = func(_ adw.AlertDialog, response string) {
+		if response != "remove" {
+			return
+		}
+
+		a.goAsync(func() (string, error) {
+			if err := a.State.RemoveGPGKey(key.Fingerprint); err != nil {
+				return "", err
+			}
+
+			a.idle(func() {
+				a.secretsSignature = ""
+				a.refreshSecretsPage()
+			})
+
+			return i18n.L("The secret key was deleted"), nil
+		})
+	}
+	dialog.ConnectResponse(&cb)
+	a.hold(&cb)
+
+	dialog.Present(&a.win.Widget)
+}
