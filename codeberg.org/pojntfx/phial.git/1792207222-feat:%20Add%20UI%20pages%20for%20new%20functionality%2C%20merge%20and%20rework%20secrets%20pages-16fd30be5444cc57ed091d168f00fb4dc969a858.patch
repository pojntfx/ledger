+
+// refreshSecretsPage reconciles the rows with the mapping file and the agents
+// of the host.
+func (a *App) refreshSecretsPage() {
+	rows, err := a.State.Rows()
+	if err != nil {
+		a.Log.Error("could not read the secrets", "err", err)
+		return
+	}
+
+	sshKeys, sshErr := a.State.ListSSHKeys()
+	gpgKeys, gpgErr := a.State.ListGPGKeys()
+	grants := a.State.ActiveGrants()
+
+	signature := fmt.Sprintf("%v|%v;", sshErr, gpgErr)
+	for _, row := range rows {
+		signature += row.Name + "|" + row.Mode + "|" + row.Source + "|" + row.Upstream + ";"
+	}
+	for _, key := range sshKeys {
+		signature += key.Fingerprint + "|" + key.Comment + ";"
+	}
+	for _, key := range gpgKeys {
+		signature += key.Fingerprint + "|" + key.UID + ";"
+	}
+	for _, grant := range grants {
+		signature += grant.ID + ";"
+	}
+
+	if signature == a.secretsSignature {
+		return
+	}
+	a.secretsSignature = signature
+
+	for _, row := range a.secretRows {
+		a.secretsGroup.Remove(&row.Widget)
+	}
+	a.secretRows = nil
+
+	for _, row := range a.keyRows {
+		a.sshKeysGroup.Remove(&row.Widget)
+	}
+	a.keyRows = nil
+
+	for _, row := range a.gpgKeyRows {
+		a.gpgKeysGroup.Remove(&row.Widget)
+	}
+	a.gpgKeyRows = nil
+
+	if len(rows) == 0 && len(sshKeys) == 0 && len(gpgKeys) == 0 {
+		a.secretsStack.SetVisibleChildName("empty")
+		return
+	}
+
+	a.secretsStack.SetVisibleChildName("list")
+
+	if len(rows) == 0 {
+		a.secretsGroup.Add(&a.dimmedRow(i18n.L("No secrets stored")).Widget)
+	}
+
+	for _, entry := range rows {
+		entry := entry
+
+		row := adw.NewActionRow()
+		row.SetUseMarkup(false)
+		row.SetTitle(entry.Name)
+		row.SetSubtitle(a.secretSubtitle(entry, grants))
+		row.SetActivatable(true)
+
+		var cb func(adw.ActionRow)
+		cb = func(adw.ActionRow) { a.showSecretDialog(entry.Name) }
+		row.ConnectActivated(&cb)
+		a.hold(&cb)
+
+		grant := a.labelButton(i18n.L("_Grant…"), func() {
+			a.showGrantDialog(state.KindSecret, entry.Name)
+		})
+		grant.SetValign(gtk.AlignCenterValue)
+		grant.SetHasFrame(false)
+		row.AddSuffix(&grant.Widget)
+
+		row.AddSuffix(&a.secretMenu(entry).Widget)
+
+		a.secretsGroup.Add(&row.Widget)
+		a.secretRows = append(a.secretRows, row)
+	}
+
+	if sshErr != nil {
+		a.sshKeysGroup.Add(&a.dimmedRow(i18n.L("The agent of the session could not be reached")).Widget)
+	} else if len(sshKeys) == 0 {
+		a.sshKeysGroup.Add(&a.dimmedRow(i18n.L("The agent of the session holds no keys")).Widget)
+	}
+
+	for _, key := range sshKeys {
+		key := key
+
+		row := adw.NewActionRow()
+		row.SetUseMarkup(false)
+		row.SetTitle(key.Comment)
+		row.SetSubtitle(key.Fingerprint + ", " + strings.TrimPrefix(key.Type, "ssh-"))
+		row.SetIconName("channel-secure-symbolic")
+
+		grant := a.labelButton(i18n.L("_Grant…"), func() {
+			a.showGrantDialog(state.KindSSHKey, key.Comment)
+		})
+		grant.SetValign(gtk.AlignCenterValue)
+		grant.SetHasFrame(false)
+		row.AddSuffix(&grant.Widget)
+
+		row.AddSuffix(&a.iconButton("list-remove-symbolic", i18n.L("Unload from the Agent"), func() {
+			a.confirmUnloadSSHKey(key.Comment)
+		}).Widget)
+
+		a.sshKeysGroup.Add(&row.Widget)
+		a.keyRows = append(a.keyRows, row)
+	}
+
+	if gpgErr != nil {
+		a.gpgKeysGroup.Add(&a.dimmedRow(i18n.L("The GnuPG agent of this host could not be reached")).Widget)
+	} else if len(gpgKeys) == 0 {
+		a.gpgKeysGroup.Add(&a.dimmedRow(i18n.L("The GnuPG agent of this host holds no keys")).Widget)
+	}
+
+	for _, key := range gpgKeys {
+		key := key
+
+		row := adw.NewActionRow()
+		row.SetUseMarkup(false)
+		row.SetTitle(key.UID)
+		row.SetSubtitle(shortFingerprint(key.Fingerprint))
+		row.SetIconName("security-high-symbolic")
+
+		grant := a.labelButton(i18n.L("_Grant…"), func() {
+			a.showGrantDialog(state.KindGPGKey, "agent")
+		})
+		grant.SetValign(gtk.AlignCenterValue)
+		grant.SetHasFrame(false)
+		row.AddSuffix(&grant.Widget)
+
+		row.AddSuffix(&a.iconButton("user-trash-symbolic", i18n.L("Delete Secret Key…"), func() {
+			a.confirmRemoveGPGKey(key)
+		}).Widget)
+
+		a.gpgKeysGroup.Add(&row.Widget)
+		a.gpgKeyRows = append(a.gpgKeyRows, row)
+	}
+}
+
+// secretSubtitle states the mode and the grants of one secret.
+func (a *App) secretSubtitle(row state.Row, grants []state.Grant) string {
+	mode := i18n.L("Environment file")
+	if row.Mode == "proxy" {
+		mode = i18n.L("Proxy") + ", " + row.Upstream
+	}
+
+	names := []string{}
+	for _, grant := range grants {
+		if grant.Kind != state.KindSecret || grant.Name != row.Name {
+			continue
+		}
+
+		names = append(names, grant.VM)
+	}
+
+	if len(names) > 0 {
+		return mode + ", " + fmt.Sprintf(i18n.L("granted to %s"), strings.Join(names, ", "))
+	}
+
+	return mode
+}
+
+// secretMenu builds the per-row menu of one secret.
+func (a *App) secretMenu(row state.Row) *gtk.MenuButton {
+	menu := gio.NewMenu()
+
+	edit := gio.NewMenuItem(i18n.L("_Edit Secret…"), "app.edit-secret")
+	edit.SetActionAndTargetValue("app.edit-secret", glib.NewVariantString(row.Name))
+	menu.AppendItem(edit)
+
+	remove := gio.NewMenuItem(i18n.L("_Delete Secret…"), "app.delete-secret")
+	remove.SetActionAndTargetValue("app.delete-secret", glib.NewVariantString(row.Name))
+	menu.AppendItem(remove)
+
+	menuButton := gtk.NewMenuButton()
+	menuButton.SetIconName("view-more-symbolic")
+	menuButton.SetTooltipText(i18n.L("Secret Menu"))
+	menuButton.SetMenuModel(&menu.MenuModel)
+	menuButton.SetValign(gtk.AlignCenterValue)
+
+	return menuButton
+}
+
+// showSecretDialog adds or edits one secret. The value field stays empty on
+// an edit, and an empty value keeps the stored one.
+func (a *App) showSecretDialog(name string) {
+	scope := a.newScope()
+
+	nameRow := a.entryRow("_Name")
+	nameRow.SetUseUnderline(true)
+	nameRow.SetShowApplyButton(false)
+	nameRow.GrabFocus()
+
+	valueRow := adw.NewPasswordEntryRow()
+	valueRow.SetTitle(i18n.L("_Value"))
+	valueRow.SetUseUnderline(true)
+
+	// The screenshot run fills the field by its title, so the row registers
+	// like every other entry row.
+	a.entries = append(a.entries, &valueRow.EntryRow)
+
+	mode := "env"
+	upstreamRow := a.entryRow("_Upstream URL")
+	upstreamRow.SetUseUnderline(true)
+	upstreamRow.SetShowApplyButton(false)
+
+	modeRow := a.comboRow(
+		"Delivery",
+		[]string{i18n.L("Environment file in the machine"), i18n.L("Injected into host requests")},
+		[]string{"env", "proxy"},
+		"env",
+		func(value string) {
+			mode = value
+			upstreamRow.SetVisible(value == "proxy")
+		},
+	)
+	upstreamRow.SetVisible(false)
+
+	group := formGroup("Secret", "The value lives in the keyring of this host and never appears again.", &nameRow.Widget)
+	group.Add(&valueRow.EntryRow.PreferencesRow.ListBoxRow.Widget)
+	group.Add(&modeRow.row.Widget)
+	group.Add(&upstreamRow.Widget)
+
+	content := a.formPage(group)
+
+	existing := false
+	if name != "" {
+		if rows, err := a.State.Rows(); err == nil {
+			for _, row := range rows {
+				if row.Name != name {
+					continue
+				}
+
+				existing = true
+				nameRow.SetText(row.Name)
+				nameRow.SetEditable(false)
+				upstreamRow.SetText(row.Upstream)
+				if row.Mode == "proxy" {
+					mode = "proxy"
+					modeRow.row.SetSelected(1)
+					upstreamRow.SetVisible(true)
+				}
+			}
+		}
+	}
+
+	title := i18n.L("Add a Secret")
+	verb := "_Add"
+	if existing {
+		title = i18n.L("Edit Secret")
+		verb = "_Save"
+		valueRow.SetTitle(i18n.L("_New value, empty keeps the stored one"))
+	}
+
+	dialog := a.dialog(scope, title, i18n.L("A value for a machine, stored on this host"), verb, content, func() bool {
+		secret := strings.TrimSpace(nameRow.GetText())
+
+		if secret == "" {
+			a.toast(i18n.L("A name is required"))
+			return false
+		}
+
+		upstream := "-"
+		if mode == "proxy" {
+			upstream = strings.TrimSpace(upstreamRow.GetText())
+			if upstream == "" {
+				a.toast(i18n.L("A proxied secret needs an upstream URL"))
+				return false
+			}
+		}
+
+		value := valueRow.GetText()
+		if !existing && value == "" {
+			a.toast(i18n.L("A value is required"))
+			return false
+		}
+
+		a.goAsync(func() (string, error) {
+			if err := a.State.SetSecret(state.Row{
+				Name:     secret,
+				Mode:     mode,
+				Source:   "secret://" + secret,
+				Upstream: upstream,
+			}, value); err != nil {
+				return "", err
+			}
+
+			a.idle(func() {
+				a.refreshSecretsPage()
+				a.refreshCounts()
+			})
+
+			if existing {
+				return i18n.L("The secret was updated"), nil
+			}
+
+			return i18n.L("The secret was added"), nil
+		})
+
+		return true
+	})
+
+	validate := func() {
+		valid := strings.TrimSpace(nameRow.GetText()) != ""
+		if mode == "proxy" && strings.TrimSpace(upstreamRow.GetText()) == "" {
+			valid = false
+		}
+		if !existing && valueRow.GetText() == "" {
+			valid = false
+		}
+		scope.setValid(valid)
+	}
+
+	a.onEntryChanged(nameRow, validate)
+	a.onEntryChanged(upstreamRow, validate)
+
+	var onValueChanged func()
+	onValueChanged = func() { validate() }
+	valueRow.EntryRow.PreferencesRow.ListBoxRow.Widget.InitiallyUnowned.Object.ConnectSignal("changed", &onValueChanged)
+	scope.hold(&onValueChanged)
+
+	validate()
+
+	a.present(dialog, scope)
+}
+
+// confirmRemoveSecret asks before it deletes one secret and its stored value.
+func (a *App) confirmRemoveSecret(name string) {
+	dialog := adw.NewAlertDialog(
+		i18n.L("Delete the secret?"),
+		fmt.Sprintf(i18n.L("This deletes %s from the keyring and revokes its grants."), name),
+	)
+	dialog.AddResponse("cancel", i18n.L("_Cancel"))
+	dialog.AddResponse("remove", i18n.L("_Delete"))
+	dialog.SetResponseAppearance("remove", adw.ResponseDestructiveValue)
+	dialog.SetCloseResponse("cancel")
+
+	var cb func(adw.AlertDialog, string)
+	cb = func(_ adw.AlertDialog, response string) {
+		if response != "remove" {
+			return
+		}
+
+		a.goAsync(func() (string, error) {
+			if err := a.State.RemoveSecret(name); err != nil {
+				return "", err
+			}
+
+			a.idle(func() {
+				a.refreshSecretsPage()
+				a.refreshGrantsPage()
+				a.refreshCounts()
+			})
+
+			return i18n.L("The secret was deleted"), nil
+		})
+	}
+	dialog.ConnectResponse(&cb)
+	a.hold(&cb)
+
+	dialog.Present(&a.win.Widget)
+}
