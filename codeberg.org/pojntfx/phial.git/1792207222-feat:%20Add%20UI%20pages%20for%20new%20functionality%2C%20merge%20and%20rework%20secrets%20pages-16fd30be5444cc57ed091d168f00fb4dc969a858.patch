+// resizeWindow sets the window to the size that the screenshot run asks for.
+// The settings backend of a test host can be read-only, so the size is set
+// here instead of through the settings.
+func (a *App) resizeWindow(value string) {
+	if a.win == nil {
+		return
+	}
+
+	width, height, found := strings.Cut(value, "x")
+	if !found {
+		return
+	}
+
+	w, err := strconv.Atoi(width)
+	if err != nil {
+		return
+	}
+
+	h, err := strconv.Atoi(height)
+	if err != nil {
+		return
+	}
+
+	a.win.SetDefaultSize(int32(w), int32(h))
+}
+
+// scrollDialog moves the scrollable content of the open dialog, so that the
+// screenshot run sees the rows below the fold. The value is the fraction of the
+// content that is left above the view, from 0 to 1.
+func (a *App) scrollDialog(value string) {
+	fraction, err := strconv.ParseFloat(value, 64)
+	if err != nil {
+		return
+	}
+
+	// The tallest scrollable area holds the page or the form. A smaller one can
+	// sit inside it, for example in a search result list.
+	var largest *gtk.ScrolledWindow
+	var largestArea int32
+
+	var collect func(widget *gtk.Widget)
+	collect = func(widget *gtk.Widget) {
+		if widget == nil {
+			return
+		}
+
+		if widget.GetCssName() == "scrolledwindow" {
+			if area := widget.GetWidth() * widget.GetHeight(); area > largestArea {
+				largest = gtk.ScrolledWindowNewFromInternalPtr(widget.GoPointer())
+				largestArea = area
+			}
+		}
+
+		for child := widget.GetFirstChild(); child != nil; child = child.GetNextSibling() {
+			collect(child)
+		}
+	}
+
+	var root *gtk.Widget
+	if a.openDialog != nil {
+		root = a.openDialog.GetChild()
+	} else if a.content != nil {
+		if page := a.content.GetVisiblePage(); page != nil {
+			root = &page.Widget
+		}
+	}
+
+	if root == nil {
+		return
+	}
+
+	collect(root)
+	if largest == nil {
+		return
+	}
+
+	adjustment := largest.GetVadjustment()
+	if adjustment == nil {
+		return
+	}
+
+	adjustment.SetValue(fraction * adjustment.GetUpper())
+}
+
+// selectDialogOption picks the option with this label in the open dialog. The
+// screenshot run cannot click, so it names the option instead.
+func (a *App) selectDialogOption(label string) {
+	for _, combo := range a.dialogCombos {
+		for index, text := range combo.labels {
+			if text != label {
+				continue
+			}
+
+			combo.row.SetSelected(uint32(index))
+			// The focus scrolls the row into view, so that the run sees the
+			// change even in a long dialog.
+			combo.row.GrabFocus()
+
+			return
+		}
+	}
+}
+
+// fillDialogEntry writes into the field of the open dialog whose title comes
+// before the separator. The screenshot run cannot type, so it names the field.
+func (a *App) fillDialogEntry(value string) {
+	title, text, found := strings.Cut(value, "=")
+	if !found {
+		return
+	}
+
+	for _, entry := range a.dialogEntries {
+		if entry.GetTitle() != title {
+			continue
+		}
+
+		entry.SetText(text)
+		entry.GrabFocus()
+
+		return
+	}
+}
