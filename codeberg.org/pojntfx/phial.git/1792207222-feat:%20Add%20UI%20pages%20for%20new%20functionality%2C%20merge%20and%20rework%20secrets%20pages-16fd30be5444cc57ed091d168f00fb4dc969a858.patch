-func (a *App) confirmRemoveProvider(name string) {
-	dialog := adw.NewAlertDialog(
-		i18n.L("Remove the provider?"),
-		fmt.Sprintf(i18n.L("This removes %s and revokes its grants. The entry in your password store stays."), name),
-	)
-	dialog.AddResponse("cancel", i18n.L("_Cancel"))
-	dialog.AddResponse("remove", i18n.L("_Remove"))
-	dialog.SetResponseAppearance("remove", adw.ResponseDestructiveValue)
-	dialog.SetCloseResponse("cancel")
-
-	var cb func(adw.AlertDialog, string)
-	cb = func(_ adw.AlertDialog, response string) {
-		if response != "remove" {
-			return
-		}
-
-		a.goAsync(func() (string, error) {
-			if err := a.State.RemoveProvider(name); err != nil {
-				return "", err
-			}
-
-			a.idle(func() {
-				if page := a.providerPages[name]; page != nil {
-					a.content.Remove(page.page)
-					delete(a.providerPages, name)
-				}
-				a.content.PopToTag(providersTag)
-				a.refreshProvidersPage()
-				a.refreshCounts()
-			})
-
-			return i18n.L("The provider was removed"), nil
-		})
-	}
-	dialog.ConnectResponse(&cb)
-	a.hold(&cb)
-
-	dialog.Present(&a.win.Widget)
-}
