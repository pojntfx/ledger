-// ensureProviderPage builds the page of a provider on first use.
-func (a *App) ensureProviderPage(name string) *providerPage {
-	if page := a.providerPages[name]; page != nil {
-		return page
-	}
-
-	page := a.buildProviderPage(name)
-	a.providerPages[name] = page
-	a.content.Add(page.page)
-	a.refreshProviderPage(name)
-
-	return page
-}
