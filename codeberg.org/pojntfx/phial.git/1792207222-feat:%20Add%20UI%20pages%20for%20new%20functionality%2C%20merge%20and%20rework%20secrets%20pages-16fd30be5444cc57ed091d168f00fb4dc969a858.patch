-// refreshProvidersPage reconciles the provider rows with the mapping file.
-func (a *App) refreshProvidersPage() {
-	rows, err := a.State.Rows()
-	if err != nil {
-		a.Log.Error("could not read the providers", "err", err)
-		return
-	}
-
-	signature := ""
-	for _, row := range rows {
-		signature += row.Name + "|" + row.Mode + "|" + row.Source + "|" + row.Upstream + ";"
-	}
-
-	if signature == a.providersSignature {
-		return
-	}
-	a.providersSignature = signature
-
-	for _, row := range a.providerRows {
-		a.providersGroup.Remove(&row.Widget)
-	}
-	a.providerRows = nil
-
-	if len(rows) == 0 {
-		a.providersStack.SetVisibleChildName("empty")
-		return
-	}
-
-	a.providersStack.SetVisibleChildName("list")
-
-	for _, entry := range rows {
-		entry := entry
-
-		row := adw.NewActionRow()
-		row.SetTitle(entry.Name)
-		row.SetSubtitle(providerSubtitle(a, entry))
-		row.SetActivatable(true)
-		row.AddSuffix(&gtk.NewImageFromIconName("go-next-symbolic").Widget)
-
-		var cb func(adw.ActionRow)
-		cb = func(adw.ActionRow) {
-			page := a.ensureProviderPage(entry.Name)
-			a.ensureInView(page.page)
-			a.content.PushByTag(providerTagPrefix + entry.Name)
-		}
-		row.ConnectActivated(&cb)
-		a.hold(&cb)
-
-		a.providersGroup.Add(&row.Widget)
-		a.providerRows = append(a.providerRows, row)
-	}
-}
