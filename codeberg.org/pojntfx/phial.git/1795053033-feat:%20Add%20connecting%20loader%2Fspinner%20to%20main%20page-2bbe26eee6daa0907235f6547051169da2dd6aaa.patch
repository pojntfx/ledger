diff --git a/assets/resources/window.blp b/assets/resources/window.blp
index 0c79cca17e1ebff4c76ac924fa9895d334707d2c..00bdb849b6b5d2ff3355043e63fc3ecb4d0bf2b0 100644
--- a/assets/resources/window.blp
+++ b/assets/resources/window.blp
@@ -10,6 +10,36 @@   content: Stack content_stack {
     transition-type: crossfade;
 
     StackPage {
+      name: "connecting";
+      child: Adw.ToolbarView {
+        [top]
+        Adw.HeaderBar {
+          title-widget: Adw.WindowTitle {
+            title: _("Phial");
+          };
+
+          [end]
+          MenuButton {
+            icon-name: "open-menu-symbolic";
+            tooltip-text: _("Main Menu");
+            primary: true;
+            menu-model: main_menu;
+          }
+        }
+
+        content: Adw.StatusPage {
+          title: _("Starting Phial");
+          description: _("Connecting to the host service");
+
+          Adw.Spinner {
+            width-request: 48;
+            height-request: 48;
+          }
+        };
+      };
+    }
+
+    StackPage {
       name: "setup";
       child: Adw.ToolbarView {
         [top]
diff --git a/internal/components/main_window.go b/internal/components/main_window.go
index 332d7ac9a2c250dc9f0e10179b52684a3a204b29..42d1c0e7caa202bb98845bf096f67798e174443f 100644
--- a/internal/components/main_window.go
+++ b/internal/components/main_window.go
@@ -17,8 +17,9 @@ 	"codeberg.org/puregotk/puregotk/v4/gtk"
 )
 
 const (
-	contentPageSetup = "setup"
-	contentPageReady = "ready"
+	contentPageConnecting = "connecting"
+	contentPageSetup      = "setup"
+	contentPageReady      = "ready"
 )
 
 var (
@@ -102,7 +103,9 @@ 	if w.store == nil {
 		return
 	}
 
-	if w.store.Ready() || w.store.Page() == state.SetupPageFinish {
+	if w.store.HostStatus() == state.HostStatusConnecting {
+		w.contentStack.SetVisibleChildName(contentPageConnecting)
+	} else if w.store.Ready() || w.store.Page() == state.SetupPageFinish {
 		w.contentStack.SetVisibleChildName(contentPageReady)
 	} else {
 		w.contentStack.SetVisibleChildName(contentPageSetup)
