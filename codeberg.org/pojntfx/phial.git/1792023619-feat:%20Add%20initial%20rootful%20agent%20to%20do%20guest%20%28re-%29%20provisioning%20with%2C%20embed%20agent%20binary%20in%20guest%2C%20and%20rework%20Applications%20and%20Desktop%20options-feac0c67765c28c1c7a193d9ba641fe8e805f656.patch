diff --git a/internal/virt/agent_version.go b/internal/virt/agent_version.go
new file mode 100644
index 0000000000000000000000000000000000000000..6fa0cae5a20f1936fa1a62b032096c5728e8c3be
--- /dev/null
+++ b/internal/virt/agent_version.go
@@ -0,0 +1,55 @@
+package virt
+
+import (
+	"context"
+	"os"
+	"strconv"
+	"strings"
+)
+
+// GuestAgentPath states where the provisioning copies the agent into a guest.
+const GuestAgentPath = "/home/phial/.local/bin/phial"
+
+// HostBuildTime states the build time of the binary of the host, which is the
+// time that the file of that binary changed.
+func HostBuildTime() (int64, error) {
+	executable, err := os.Executable()
+	if err != nil {
+		return 0, err
+	}
+
+	info, err := os.Stat(executable)
+	if err != nil {
+		return 0, err
+	}
+
+	return info.ModTime().Unix(), nil
+}
+
+// GuestBuildTime states the build time of the agent inside one guest, or zero
+// when the guest carries no agent yet. It reads the file as the user of the
+// guest, like every other call of the guest that is not the provisioning.
+func GuestBuildTime(def Definition) (int64, error) {
+	output, err := SSHRun(context.Background(), def.Name, "stat -c %Y "+GuestAgentPath+" 2>/dev/null || echo 0")
+	if err != nil {
+		return 0, err
+	}
+
+	return strconv.ParseInt(strings.TrimSpace(string(output)), 10, 64)
+}
+
+// GuestOutdated states whether the agent of a guest is older than the binary of
+// the host, so that the guest needs the update step.
+func GuestOutdated(def Definition) (bool, error) {
+	host, err := HostBuildTime()
+	if err != nil {
+		return false, err
+	}
+
+	guest, err := GuestBuildTime(def)
+	if err != nil {
+		return false, err
+	}
+
+	return guest < host, nil
+}
