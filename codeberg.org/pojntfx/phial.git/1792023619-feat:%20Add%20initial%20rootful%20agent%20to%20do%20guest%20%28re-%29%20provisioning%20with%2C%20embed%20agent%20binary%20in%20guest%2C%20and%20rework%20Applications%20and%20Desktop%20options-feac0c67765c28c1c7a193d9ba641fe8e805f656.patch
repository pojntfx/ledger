+// qgaSend states whether the agent of the machine received one request.
+func qgaSend(conn net.Conn, payload qgaRequest) error {
+	data, err := json.Marshal(payload)
+	if err != nil {
+		return err
+	}
+
+	_, err = conn.Write(append(data, '\n'))
+
+	return err
+}
+
+// qgaRead states the reply of the agent of the machine for one request.
+func qgaRead(decoder *json.Decoder) (json.RawMessage, error) {
+	var envelope qgaEnvelope
+	if err := decoder.Decode(&envelope); err != nil {
+		return nil, err
+	}
+
+	if envelope.Error != nil {
+		return nil, fmt.Errorf("%s", envelope.Error.Desc)
+	}
+
+	return envelope.Return, nil
+}
