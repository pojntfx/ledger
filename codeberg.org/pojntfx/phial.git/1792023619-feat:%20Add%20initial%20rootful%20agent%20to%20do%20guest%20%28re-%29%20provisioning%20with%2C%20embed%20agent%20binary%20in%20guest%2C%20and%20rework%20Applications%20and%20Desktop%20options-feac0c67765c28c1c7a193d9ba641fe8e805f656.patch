+// QgaWriteFile writes one file in the guest through the agent, in chunks that
+// stay small because the channel carries a request as one message.
+func QgaWriteFile(def Definition, path string, mode int, data []byte) error {
+	raw, err := QgaCall(def, "guest-file-open", map[string]interface{}{"path": path, "mode": "wb"})
+	if err != nil {
+		return err
+	}
+
+	var handle int
+	if err := json.Unmarshal(raw, &handle); err != nil {
+		return err
+	}
+
+	defer func() {
+		_, _ = QgaCall(def, "guest-file-close", map[string]interface{}{"handle": handle})
+	}()
+
+	for len(data) > 0 {
+		chunk := data
+		if len(chunk) > 512*1024 {
+			chunk = chunk[:512*1024]
+		}
+		data = data[len(chunk):]
+
+		if _, err := QgaCall(def, "guest-file-write", map[string]interface{}{
+			"handle":  handle,
+			"buf-b64": base64.StdEncoding.EncodeToString(chunk),
+		}); err != nil {
+			return err
+		}
+	}
+
+	_, err = QgaExec(def, fmt.Sprintf("chmod %04o %s", mode, path))
+
+	return err
+}
