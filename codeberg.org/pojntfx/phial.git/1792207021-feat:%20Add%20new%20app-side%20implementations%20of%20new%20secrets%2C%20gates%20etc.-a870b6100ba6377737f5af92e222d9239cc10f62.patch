+	return grant
+}
+
+// GrantsForVM lists the open grants of one kind on one machine. An empty
+// machine receives every open grant of the kind, because the local sockets of
+// the gate belong to the host itself.
+func (c *Client) GrantsForVM(kind, vm string) []Grant {
+	grants := []Grant{}
+
+	for _, grant := range c.Grants() {
+		if grant.Kind != kind || !grant.Active() {
+			continue
+		}
+
+		if vm != "" && grant.VM != vm {
