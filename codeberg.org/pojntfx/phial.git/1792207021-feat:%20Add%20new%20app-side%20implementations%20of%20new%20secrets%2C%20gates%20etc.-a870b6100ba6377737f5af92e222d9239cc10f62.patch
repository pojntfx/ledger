--- /dev/null
+++ b/internal/state/proxy.go
@@ -0,0 +1,191 @@
+package state
+
+import (
+	"context"
+	"encoding/base64"
+	"io"
+	"log/slog"
+	"net"
+	"net/http"
+	"net/url"
+	"strings"
+
+	"github.com/mdlayher/vsock"
+)
+
+func mustDecode(text string) []byte {
+	data, err := base64.StdEncoding.DecodeString(text)
+	if err != nil {
+		return nil
+	}
+
+	return data
+}
+
+// serveProxyGate answers the proxied requests of guests. A request names one
+// secret in its path, and a grant decides whether the host answers it with
+// the real value injected.
+func (c *Client) serveProxyGate() error {
+	listener, err := vsock.Listen(PortProxy, nil)
+	if err != nil {
+		return err
+	}
+	defer listener.Close()
+
+	c.log.Info("serving the gated secret proxy", "port", PortProxy)
+
+	server := &http.Server{
+		Handler: http.HandlerFunc(c.serveProxyRequest),
+		ConnContext: func(ctx context.Context, conn net.Conn) context.Context {
+			vconn, ok := conn.(*vsock.Conn)
+			if !ok {
+				return ctx
+			}
+
+			p, ok := vsockPeer(vconn)
+			if !ok {
+				return ctx
+			}
+
+			return context.WithValue(ctx, peerContextKey{}, p)
+		},
+	}
+
+	return server.Serve(&knownMachineListener{Listener: listener, log: c.log})
+}
+
+// serveProxyRequest injects the value of one granted secret into one outbound
+// request. The path carries the name of the secret, and the host replaces the
+// connection target with the upstream of the secret.
+func (c *Client) serveProxyRequest(w http.ResponseWriter, r *http.Request) {
+	var p peer
+
+	if vconn, ok := r.Context().Value(peerContextKey{}).(peer); ok {
+		p = vconn
+	}
+
+	name := strings.SplitN(strings.TrimPrefix(r.URL.Path, "/"), "/", 2)[0]
+	rest := strings.TrimPrefix(r.URL.Path, "/"+name)
+
+	if !namePattern.MatchString(name) {
+		http.Error(w, "no secret named in the path", http.StatusBadRequest)
+
+		return
+	}
+
+	row, err := c.findRow(name)
+	if err != nil || row.Mode != "proxy" {
+		http.Error(w, "no proxied secret named "+name, http.StatusNotFound)
+
+		return
+	}
+
+	grant := c.GrantFor(KindSecret, p.vm, name)
+	if grant == nil && !p.host {
+		http.Error(w, "no grant allows "+name, http.StatusForbidden)
+
+		return
+	}
+
+	value, err := resolveSource(row.Source)
+	if err != nil {
+		c.log.Error("cannot resolve the secret", "name", name, "err", err)
+		http.Error(w, "cannot resolve "+name, http.StatusBadGateway)
+
+		return
+	}
+
+	upstream, err := url.Parse(row.Upstream)
+	if err != nil || upstream.Scheme == "" || upstream.Host == "" {
+		http.Error(w, "the upstream of "+name+" is not a URL", http.StatusBadGateway)
+
+		return
+	}
+
+	target := &url.URL{
+		Scheme:   upstream.Scheme,
+		Host:     upstream.Host,
+		Path:     strings.TrimSuffix(upstream.Path, "/") + rest,
+		RawQuery: r.URL.RawQuery,
+	}
+
+	outgoing, err := http.NewRequestWithContext(r.Context(), r.Method, target.String(), r.Body)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadGateway)
+
+		return
+	}
+
+	for key, values := range r.Header {
+		if strings.EqualFold(key, "Authorization") || strings.EqualFold(key, "Host") {
+			continue
+		}
+
+		for _, value := range values {
+			outgoing.Header.Add(key, value)
+		}
+	}
+
+	outgoing.Host = upstream.Host
+	outgoing.Header.Set("Host", upstream.Host)
+	outgoing.Header.Set("Authorization", "Bearer "+value)
+
+	c.log.Info("proxying a request", "vm", p.vm, "name", name, "upstream", upstream.Host)
+
+	response, err := http.DefaultTransport.RoundTrip(outgoing)
+	if err != nil {
+		http.Error(w, "the upstream did not answer: "+err.Error(), http.StatusBadGateway)
+
+		return
+	}
+	defer response.Body.Close()
+
+	for key, values := range response.Header {
+		for _, value := range values {
+			w.Header().Add(key, value)
+		}
+	}
+
+	w.WriteHeader(response.StatusCode)
+	_, _ = io.Copy(w, response.Body)
+
+	if grant != nil && grant.Once {
+		c.revokeGrant(grant.ID)
+	}
+}
+
+// peerContextKey carries the machine of a proxied connection through the
+// request context.
+type peerContextKey struct{}
+
+// knownMachineListener drops connections from vsock addresses that no machine
+// owns, so the gate never serves an unknown guest.
+type knownMachineListener struct {
+	net.Listener
+	log *slog.Logger
+}
+
+func (l *knownMachineListener) Accept() (net.Conn, error) {
+	for {
+		conn, err := l.Listener.Accept()
+		if err != nil {
+			return nil, err
+		}
+
+		vconn, ok := conn.(*vsock.Conn)
+		if !ok {
+			_ = conn.Close()
+
+			continue
+		}
+
+		if _, ok := vmForCID(cidOf(vconn)); !ok {
+			l.log.Info("dropped a connection from an unknown machine", "addr", cidOf(vconn))
+			_ = conn.Close()
+
+			continue
+		}
+
+		return conn, nil
+	}
+}
