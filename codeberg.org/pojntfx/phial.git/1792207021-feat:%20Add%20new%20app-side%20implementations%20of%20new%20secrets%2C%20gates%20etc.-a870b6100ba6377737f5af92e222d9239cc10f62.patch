diff --git a/internal/state/gate.go b/internal/state/gate.go
new file mode 100644
index 0000000000000000000000000000000000000000..8f9a05b7f074795745acfc735cadfe990223bcbb
--- /dev/null
+++ b/internal/state/gate.go
@@ -0,0 +1,474 @@
+package state
+
+import (
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sync"
+	"time"
+
+	"github.com/adrg/xdg"
+	"github.com/mdlayher/vsock"
+	"golang.org/x/crypto/ssh"
+	"golang.org/x/crypto/ssh/agent"
+
+	"codeberg.org/pojntfx/phial-neo/internal/virt"
+)
+
+// The vsock ports of the gate. A guest connects to one port per transport,
+// and the grant decides what the transport serves.
+const (
+	PortSSHAgent = 5551
+	PortGPGAgent = 5552
+	PortProxy    = 4000
+)
+
+// peer states who is on the other end of a connection: one machine over
+// vsock, or the host itself over the local socket.
+type peer struct {
+	vm   string
+	host bool
+}
+
+// vmForCID states the machine that owns one vsock address. An address that no
+// machine owns serves nothing.
+func vmForCID(cid uint32) (string, bool) {
+	definitions, err := virt.List()
+	if err != nil {
+		return "", false
+	}
+
+	for _, def := range definitions {
+		if def.GuestCIDValue() == cid {
+			return def.Name, true
+		}
+	}
+
+	return "", false
+}
+
+// vsockPeer wraps one accepted connection with the machine it came from.
+func vsockPeer(conn *vsock.Conn) (peer, bool) {
+	return peerForAddr(conn.RemoteAddr())
+}
+
+// peerForAddr states the machine that owns one vsock address.
+func peerForAddr(addr net.Addr) (peer, bool) {
+	remote, ok := addr.(*vsock.Addr)
+	if !ok || remote == nil {
+		return peer{}, false
+	}
+
+	vm, ok := vmForCID(remote.ContextID)
+	if !ok {
+		return peer{}, false
+	}
+
+	return peer{vm: vm}, true
+}
+
+// cidOf states the vsock address of one connection, for logging.
+func cidOf(conn net.Conn) uint32 {
+	addr, ok := conn.RemoteAddr().(*vsock.Addr)
+	if !ok || addr == nil {
+		return 0
+	}
+
+	return addr.ContextID
+}
+
+// ServeGate runs the gate: the gated SSH agent, the gated GnuPG channel, and
+// the secret proxy. Every one of them serves a guest only what a grant opens.
+func (c *Client) ServeGate() error {
+	if err := c.ensureDirs(); err != nil {
+		return err
+	}
+
+	errChan := make(chan error, 3)
+
+	go c.sweepExpiredGrants()
+
+	go func() {
+		errChan <- c.serveSSHGate()
+	}()
+
+	go func() {
+		errChan <- c.serveGPGGate()
+	}()
+
+	go func() {
+		errChan <- c.serveProxyGate()
+	}()
+
+	return <-errChan
+}
+
+// sweepExpiredGrants closes every grant whose time ran out. The expiry
+// timers already do this, but a suspended host or a lost timer leaves a grant
+// behind, and only the sweep keeps the promise that a grant ends on time.
+func (c *Client) sweepExpiredGrants() {
+	for {
+		for _, grant := range c.Grants() {
+			if grant.Active() {
+				continue
+			}
+
+			if err := c.revokeGrant(grant.ID); err != nil {
+				c.log.Error("could not close an expired grant", "id", grant.ID, "err", err)
+			}
+		}
+
+		time.Sleep(30 * time.Second)
+	}
+}
+
+// serveSSHGate answers the agent protocol on the local socket and on the
+// vsock port.
+func (c *Client) serveSSHGate() error {
+	_ = os.Remove(c.agentSock)
+
+	listener, err := net.Listen("unix", c.agentSock)
+	if err != nil {
+		return err
+	}
+	defer listener.Close()
+
+	if err := os.Chmod(c.agentSock, 0o600); err != nil {
+		return err
+	}
+
+	c.log.Info("serving the gated SSH agent", "socket", c.agentSock, "port", PortSSHAgent)
+
+	go func() {
+		vlistener, err := vsock.Listen(PortSSHAgent, nil)
+		if err != nil {
+			c.log.Error("the vsock listener of the SSH gate failed", "err", err)
+
+			return
+		}
+
+		for {
+			conn, err := vlistener.Accept()
+			if err != nil {
+				return
+			}
+
+			go c.serveSSHConn(conn, false)
+		}
+	}()
+
+	for {
+		conn, err := listener.Accept()
+		if err != nil {
+			return err
+		}
+
+		go c.serveSSHConn(conn, true)
+	}
+}
+
+func (c *Client) serveSSHConn(conn net.Conn, host bool) {
+	defer conn.Close()
+
+	p := peer{host: true}
+
+	if !host {
+		vconn, ok := conn.(*vsock.Conn)
+		if !ok {
+			return
+		}
+
+		vpeer, ok := vsockPeer(vconn)
+		if !ok {
+			c.log.Info("rejected a connection from an unknown machine", "addr", cidOf(vconn))
+
+			return
+		}
+
+		p = vpeer
+	}
+
+	gated := &gatedAgent{client: c, peer: p}
+
+	_ = agent.ServeAgent(gated, conn)
+}
+
+// grantedKeys states the keys that the open grants of one machine allow, by
+// the wire form of each public key.
+func (c *Client) grantedKeys(p peer) map[string]*agent.Key {
+	keys := map[string]*agent.Key{}
+
+	for _, grant := range c.ActiveGrants() {
+		if grant.Kind != KindSSHKey || grant.Key == "" {
+			continue
+		}
+
+		if !p.host && grant.VM != p.vm {
+			continue
+		}
+
+		key, err := ssh.ParsePublicKey(mustDecode(grant.Key))
+		if err != nil {
+			continue
+		}
+
+		keys[grant.Key] = &agent.Key{
+			Format:  key.Type(),
+			Blob:    key.Marshal(),
+			Comment: grant.Comment,
+		}
+	}
+
+	return keys
+}
+
+// grantForKey states the grant that covers one key for one machine.
+func (c *Client) grantForKey(p peer, blob []byte) *Grant {
+	wanted := string(blob)
+
+	for _, grant := range c.ActiveGrants() {
+		if grant.Kind != KindSSHKey || grant.Key == "" {
+			continue
+		}
+
+		if !p.host && grant.VM != p.vm {
+			continue
+		}
+
+		if grant.Key == wanted || string(mustDecode(grant.Key)) == wanted {
+			return &grant
+		}
+	}
+
+	return nil
+}
+
+// gatedAgent answers the agent protocol for one connection. It lists only the
+// granted keys, and it asks the user before it signs with one of them.
+type gatedAgent struct {
+	client *Client
+	peer   peer
+
+	mutex       sync.Mutex
+	approved    map[string]time.Time
+	approvalFor time.Duration
+}
+
+func (g *gatedAgent) List() ([]*agent.Key, error) {
+	keys := []*agent.Key{}
+	for _, key := range g.client.grantedKeys(g.peer) {
+		keys = append(keys, key)
+	}
+
+	return keys, nil
+}
+
+func (g *gatedAgent) Signers() ([]ssh.Signer, error) {
+	keys, err := g.List()
+	if err != nil {
+		return nil, err
+	}
+
+	signers := []ssh.Signer{}
+	for _, key := range keys {
+		signers = append(signers, &gatedSigner{agent: g, key: key})
+	}
+
+	return signers, nil
+}
+
+func (g *gatedAgent) Sign(key ssh.PublicKey, data []byte) (*ssh.Signature, error) {
+	grant := g.client.grantForKey(g.peer, key.Marshal())
+	if grant == nil {
+		return nil, fmt.Errorf("no grant allows this key")
+	}
+
+	if err := g.approve(grant); err != nil {
+		return nil, err
+	}
+
+	client, conn, err := sessionAgent()
+	if err != nil {
+		return nil, err
+	}
+	defer conn.Close()
+
+	signature, err := client.Sign(key, data)
+	if err != nil {
+		return nil, err
+	}
+
+	if grant.Once {
+		g.client.revokeGrant(grant.ID)
+	}
+
+	return signature, nil
+}
+
+func (g *gatedAgent) Add(agent.AddedKey) error   { return errGatedAgentHoldsNoKeys }
+func (g *gatedAgent) Remove(ssh.PublicKey) error { return errGatedAgentHoldsNoKeys }
+func (g *gatedAgent) RemoveAll() error           { return errGatedAgentHoldsNoKeys }
+func (g *gatedAgent) Lock([]byte) error          { return errGatedAgentCannotLock }
+func (g *gatedAgent) Unlock([]byte) error        { return errGatedAgentCannotLock }
+
+func (g *gatedAgent) Extension(string, []byte) ([]byte, error) {
+	return nil, agent.ErrExtensionUnsupported
+}
+
+// approve asks the user once for each key and remembers the answer for a
+// short time, so that one connection asks once.
+func (g *gatedAgent) approve(grant *Grant) error {
+	g.mutex.Lock()
+	defer g.mutex.Unlock()
+
+	if g.approved == nil {
+		g.approved = map[string]time.Time{}
+	}
+
+	if g.approvalFor == 0 {
+		g.approvalFor = time.Minute
+	}
+
+	cacheKey := grant.VM + ":" + grant.Name
+
+	if until, ok := g.approved[cacheKey]; ok && time.Now().Before(until) {
+		return nil
+	}
+
+	who := grant.VM
+	if who == "" {
+		who = "the host"
+	}
+
+	prompt := fmt.Sprintf("Allow %s to sign with %q?", who, grant.Comment)
+
+	if err := exec.Command(askpassCommand(), prompt).Run(); err != nil {
+		g.client.log.Info("signature denied", "vm", grant.VM, "key", grant.Comment)
+
+		return fmt.Errorf("the user did not allow the key %q: %w", grant.Comment, err)
+	}
+
+	g.client.log.Info("signature allowed", "vm", grant.VM, "key", grant.Comment)
+
+	g.approved[cacheKey] = time.Now().Add(g.approvalFor)
+
+	return nil
+}
+
+// gatedSigner hands one allowed key to a caller that wants a signer.
+type gatedSigner struct {
+	agent *gatedAgent
+	key   *agent.Key
+}
+
+func (s *gatedSigner) PublicKey() ssh.PublicKey {
+	key, err := ssh.ParsePublicKey(s.key.Blob)
+	if err != nil {
+		return nil
+	}
+
+	return key
+}
+
+func (s *gatedSigner) Sign(_ io.Reader, data []byte) (*ssh.Signature, error) {
+	return s.agent.Sign(s.PublicKey(), data)
+}
+
+// gpgAgentSocket states the extra socket of the GnuPG agent of the host,
+// which exists for exactly this kind of forwarding.
+func gpgAgentSocket() string {
+	runtimeBase := xdg.RuntimeDir
+	if runtimeBase == "" {
+		runtimeBase = fmt.Sprintf("/run/user/%d", os.Getuid())
+	}
+
+	return filepath.Join(runtimeBase, "gnupg", "S.gpg-agent.extra")
+}
+
+// serveGPGGate carries the agent protocol of GnuPG from a granted machine to
+// the agent of the host.
+func (c *Client) serveGPGGate() error {
+	listener, err := vsock.Listen(PortGPGAgent, nil)
+	if err != nil {
+		return err
+	}
+	defer listener.Close()
+
+	c.log.Info("serving the gated GnuPG channel", "port", PortGPGAgent)
+
+	for {
+		conn, err := listener.Accept()
+		if err != nil {
+			return err
+		}
+
+		go c.serveGPGConn(conn)
+	}
+}
+
+func (c *Client) serveGPGConn(conn net.Conn) {
+	defer conn.Close()
+
+	vconn, ok := conn.(*vsock.Conn)
+	if !ok {
+		return
+	}
+
+	p, ok := vsockPeer(vconn)
+	if !ok {
+		c.log.Info("rejected a GnuPG connection from an unknown machine", "addr", cidOf(vconn))
+
+		return
+	}
+
+	grant := c.GrantFor(KindGPGKey, p.vm, "agent")
+	if grant == nil {
+		c.log.Info("rejected a GnuPG connection without a grant", "vm", p.vm)
+
+		return
+	}
+
+	prompt := fmt.Sprintf("Allow %s to use your GnuPG keys?", p.vm)
+	if err := exec.Command(askpassCommand(), prompt).Run(); err != nil {
+		c.log.Info("GnuPG use denied", "vm", p.vm)
+
+		return
+	}
+
+	c.log.Info("GnuPG use allowed", "vm", p.vm)
+
+	agentConn, err := net.Dial("unix", gpgAgentSocket())
+	if err != nil {
+		c.log.Error("cannot reach the GnuPG agent of the host", "err", err)
+
+		return
+	}
+	defer agentConn.Close()
+
+	done := make(chan struct{}, 2)
+
+	copy := func(dst net.Conn, src net.Conn) {
+		_, _ = io.Copy(dst, src)
+		_ = dst.Close()
+		_ = src.Close()
+
+		done <- struct{}{}
+	}
+
+	go copy(agentConn, conn)
+	go copy(conn, agentConn)
+
+	<-done
+
+	if grant.Once {
+		c.revokeGrant(grant.ID)
+	}
+}
+
+var (
+	errGatedAgentHoldsNoKeys = fmt.Errorf("the gated agent holds no keys")
+	errGatedAgentCannotLock  = fmt.Errorf("the gated agent does not lock")
+)
