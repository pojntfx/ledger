new file mode 100644
index 0000000000000000000000000000000000000000..dbc2a5aa3631a4ed9055fe9e9eeff447bf5f3b46
--- /dev/null
+++ b/internal/state/set.go
@@ -0,0 +1,75 @@
+package state
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"strings"
+)
+
+// Set stores one secret: the value comes from the reader, so the command line
+// never carries it.
+func (c *Client) Set(args []string, stdin io.Reader) error {
+	mode := "env"
+	upstream := "-"
+	name := ""
+
+	// The flags can stand before or after the name.
+	for index := 0; index < len(args); index++ {
+		arg := args[index]
+
+		value := ""
+		if key, rest, ok := strings.Cut(arg, "="); ok && strings.HasPrefix(key, "--") {
+			arg = key
+			value = rest
+		}
+
+		switch arg {
+		case "--mode", "--upstream":
+			if value == "" {
+				index++
+				if index >= len(args) {
+					return fmt.Errorf("%s needs a value", arg)
+				}
+				value = args[index]
+			}
+
+			if arg == "--mode" {
+				mode = value
+			} else {
+				upstream = value
+			}
+		default:
+			if strings.HasPrefix(arg, "-") {
+				return fmt.Errorf("unknown flag %q", arg)
+			}
+
+			if name != "" {
+				return errors.New("usage: phial set <name> [--mode env|proxy] [--upstream <url>] < value")
+			}
+
+			name = arg
+		}
+	}
+
+	if name == "" {
+		return errors.New("usage: phial set <name> [--mode env|proxy] [--upstream <url>] < value")
+	}
+
+	data, err := io.ReadAll(stdin)
+	if err != nil {
+		return err
+	}
+
+	value := strings.TrimRight(string(data), "\n")
+	if value == "" {
+		return errors.New("give the value on stdin")
+	}
+
+	return c.SetSecret(Row{
+		Name:     name,
+		Mode:     mode,
+		Source:   secretScheme + name,
+		Upstream: upstream,
+	}, value)
+}
