diff --git a/internal/state/keys.go b/internal/state/keys.go
new file mode 100644
index 0000000000000000000000000000000000000000..6513e2a3e0327cb680f6bb6258747c483f15547f
--- /dev/null
+++ b/internal/state/keys.go
@@ -0,0 +1,283 @@
+package state
+
+import (
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"codeberg.org/pojntfx/phial-neo/internal/hostcmd"
+	"github.com/adrg/xdg"
+	"golang.org/x/crypto/ssh"
+	"golang.org/x/crypto/ssh/agent"
+)
+
+// SSHKey is one key of the agent of the session. Phial never reads the
+// private part.
+type SSHKey struct {
+	Comment     string `json:"comment"`
+	Fingerprint string `json:"fingerprint"`
+	Type        string `json:"type"`
+	Blob        []byte `json:"-"`
+}
+
+// GPGKey is one secret key of the GnuPG agent of the host.
+type GPGKey struct {
+	Fingerprint string `json:"fingerprint"`
+	Keygrip     string `json:"keygrip"`
+	UID         string `json:"uid"`
+	Expires     string `json:"expires"`
+}
+
+// sessionAgent reaches the agent of the desktop session, which holds the keys
+// of the user.
+func sessionAgent() (agent.ExtendedAgent, net.Conn, error) {
+	socket := os.Getenv("SSH_AUTH_SOCK")
+	if socket == "" {
+		return nil, nil, fmt.Errorf("no SSH_AUTH_SOCK, start the agent of the session")
+	}
+
+	conn, err := net.Dial("unix", socket)
+	if err != nil {
+		return nil, nil, fmt.Errorf("cannot reach the agent of the session at %s: %w", socket, err)
+	}
+
+	return agent.NewClient(conn), conn, nil
+}
+
+// ListSSHKeys lists the keys of the agent of the session.
+func (c *Client) ListSSHKeys() ([]SSHKey, error) {
+	client, conn, err := sessionAgent()
+	if err != nil {
+		return nil, err
+	}
+	defer conn.Close()
+
+	keys, err := client.List()
+	if err != nil {
+		return nil, err
+	}
+
+	out := []SSHKey{}
+	for _, key := range keys {
+		parsed, err := ssh.ParsePublicKey(key.Blob)
+		if err != nil {
+			continue
+		}
+
+		out = append(out, SSHKey{
+			Comment:     key.Comment,
+			Fingerprint: ssh.FingerprintSHA256(parsed),
+			Type:        parsed.Type(),
+			Blob:        key.Blob,
+		})
+	}
+
+	return out, nil
+}
+
+// FindSSHKey states the key of the session that a name carries. The name is
+// the comment of the key, as ssh-add -l prints it, or the name of a public
+// key file in ~/.ssh.
+func (c *Client) FindSSHKey(name string) (SSHKey, error) {
+	keys, err := c.ListSSHKeys()
+	if err != nil {
+		return SSHKey{}, err
+	}
+
+	wanted := []byte(nil)
+	if data, err := os.ReadFile(filepath.Join(xdg.Home, ".ssh", name+".pub")); err == nil {
+		if key, _, _, _, err := ssh.ParseAuthorizedKey(data); err == nil {
+			wanted = key.Marshal()
+		}
+	}
+
+	for _, key := range keys {
+		if key.Comment != name && (wanted == nil || string(key.Blob) != string(wanted)) {
+			continue
+		}
+
+		return key, nil
+	}
+
+	comments := []string{}
+	for _, key := range keys {
+		comments = append(comments, key.Comment)
+	}
+
+	return SSHKey{}, fmt.Errorf("the agent of the session holds no key named %q, it holds: %s", name, strings.Join(comments, ", "))
+}
+
+// AddSSHKey loads one private key file into the agent of the session. The
+// passphrase prompt comes from the askpass program of the session.
+func (c *Client) AddSSHKey(path string) error {
+	command := hostcmd.Command("ssh-add", path)
+	command.Env = append(os.Environ(),
+		"SSH_ASKPASS="+askpassCommand(),
+		"SSH_ASKPASS_REQUIRE=prefer",
+	)
+
+	if output, err := command.CombinedOutput(); err != nil {
+		return fmt.Errorf("ssh-add: %s: %w", strings.TrimSpace(string(output)), err)
+	}
+
+	return nil
+}
+
+// RemoveSSHKey drops one key from the agent of the session. The private key
+// file on disk stays.
+func (c *Client) RemoveSSHKey(comment string) error {
+	key, err := c.FindSSHKey(comment)
+	if err != nil {
+		return err
+	}
+
+	client, conn, err := sessionAgent()
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+
+	parsed, err := ssh.ParsePublicKey(key.Blob)
+	if err != nil {
+		return err
+	}
+
+	if err := client.Remove(parsed); err != nil {
+		return fmt.Errorf("cannot remove %q from the agent of the session: %w", comment, err)
+	}
+
+	return nil
+}
+
+// GenerateSSHKey writes a new key pair into ~/.ssh and loads it into the
+// agent of the session.
+func (c *Client) GenerateSSHKey(comment string) error {
+	if strings.TrimSpace(comment) == "" {
+		return fmt.Errorf("a comment is required")
+	}
+
+	sanitized := strings.Map(func(r rune) rune {
+		if r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r >= '0' && r <= '9' || r == '-' || r == '_' || r == '.' {
+			return r
+		}
+
+		return '_'
+	}, comment)
+
+	path := filepath.Join(xdg.Home, ".ssh", "phial_"+sanitized)
+	if _, err := os.Stat(path); err == nil {
+		return fmt.Errorf("the file %s already exists", path)
+	}
+
+	if output, err := hostcmd.Command("ssh-keygen", "-t", "ed25519", "-N", "", "-C", comment, "-f", path).CombinedOutput(); err != nil {
+		return fmt.Errorf("ssh-keygen: %s: %w", strings.TrimSpace(string(output)), err)
+	}
+
+	if err := c.AddSSHKey(path); err != nil {
+		return err
+	}
+
+	return nil
+}
+
+// ListGPGKeys lists the secret keys of the GnuPG agent of the host.
+func (c *Client) ListGPGKeys() ([]GPGKey, error) {
+	output, err := hostcmd.Command("gpg", "--batch", "--with-colons", "--with-keygrip", "--list-secret-keys").Output()
+	if err != nil {
+		return nil, fmt.Errorf("gpg: %w", err)
+	}
+
+	keys := []GPGKey{}
+	current := -1
+
+	for _, line := range strings.Split(string(output), "\n") {
+		fields := strings.Split(line, ":")
+
+		switch fields[0] {
+		case "sec":
+			keys = append(keys, GPGKey{})
+			current = len(keys) - 1
+
+			if len(fields) > 9 {
+				keys[current].Fingerprint = fields[9]
+			}
+			if len(fields) > 6 {
+				keys[current].Expires = fields[6]
+			}
+		case "fpr":
+			if current >= 0 && len(fields) > 9 && keys[current].Fingerprint == "" {
+				keys[current].Fingerprint = fields[9]
+			}
+		case "grp":
+			if current >= 0 && len(fields) > 9 && keys[current].Keygrip == "" {
+				keys[current].Keygrip = fields[9]
+			}
+		case "uid":
+			if current >= 0 && len(fields) > 9 && keys[current].UID == "" {
+				keys[current].UID = fields[9]
+			}
+		}
+	}
+
+	return keys, nil
+}
+
+// GenerateGPGKey creates a new secret key on the host. The agent of the host
+// asks for the passphrase through its pinentry.
+func (c *Client) GenerateGPGKey(name, email string) error {
+	name = strings.TrimSpace(name)
+	email = strings.TrimSpace(email)
+
+	if name == "" {
+		return fmt.Errorf("a name is required")
+	}
+
+	uid := name
+	if email != "" {
+		uid = fmt.Sprintf("%s <%s>", name, email)
+	}
+
+	command := hostcmd.Command("gpg", "--batch", "--quick-generate-key", uid, "ed25519", "sign", "never")
+	command.Stderr = os.Stderr
+
+	if output, err := command.CombinedOutput(); err != nil {
+		return fmt.Errorf("gpg: %s: %w", strings.TrimSpace(string(output)), err)
+	}
+
+	return nil
+}
+
+// RemoveGPGKey deletes the secret part of one key. The public part stays, so
+// old signatures still verify.
+func (c *Client) RemoveGPGKey(fingerprint string) error {
+	if strings.TrimSpace(fingerprint) == "" {
+		return fmt.Errorf("a fingerprint is required")
+	}
+
+	if output, err := hostcmd.Command("gpg", "--batch", "--yes", "--delete-secret-keys", fingerprint).CombinedOutput(); err != nil {
+		return fmt.Errorf("gpg: %s: %w", strings.TrimSpace(string(output)), err)
+	}
+
+	return nil
+}
+
+// askpassCommand states the prompt that asks the user to allow one use. It
+// prefers a prompt that works inside a graphical session.
+func askpassCommand() string {
+	if command := os.Getenv("SSH_ASKPASS"); command != "" {
+		return command
+	}
+
+	for _, candidate := range []string{
+		"/usr/bin/pinentry-gnome3",
+		"/usr/bin/zenity",
+	} {
+		if _, err := os.Stat(candidate); err == nil {
+			return candidate
+		}
+	}
+
+	return "/usr/bin/pinentry"
+}
