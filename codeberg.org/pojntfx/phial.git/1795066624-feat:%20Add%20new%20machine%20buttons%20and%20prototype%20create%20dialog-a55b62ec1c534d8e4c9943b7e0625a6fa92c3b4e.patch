+
 	preferencesAction *gio.SimpleAction
 
 	callbacks []interface{}
@@ -105,6 +108,21 @@
 	setupDialog := NewSetupDialog(window.ctx, window.store, window.settings, window.log, &window.ApplicationWindow.Widget)
 	window.setupDialog = (*SetupDialog)(unsafe.Pointer(setupDialog.Widget.GetData(dataKeyGoInstance)))
 
+	createMachineDialog := NewCreateMachineDialog()
+	window.createMachineDialog = (*CreateMachineDialog)(unsafe.Pointer(createMachineDialog.Widget.GetData(dataKeyGoInstance)))
+
+	createMachineAction := gio.NewSimpleAction("newMachine", nil)
+	onCreateMachine := func(gio.SimpleAction, uintptr) {
+		window.createMachineDialog.Present(&window.ApplicationWindow.Widget)
+	}
+	window.callbacks = append(window.callbacks, &onCreateMachine)
+	createMachineAction.ConnectActivate(&onCreateMachine)
+	createMachineAction.SetEnabled(false)
+	window.createMachineAction = createMachineAction
+	window.AddAction(createMachineAction)
+
+	window.app.SetAccelsForAction("win.newMachine", []string{`<Primary>n`})
+
 	setupNextAction := gio.NewSimpleAction("setupNext", nil)
 	onSetupNext := func(gio.SimpleAction, uintptr) {
 		if window.store.Page() == state.SetupPageWelcome {
@@ -153,6 +171,10 @@ 	}
 
 	if w.preferencesAction != nil {
 		w.preferencesAction.SetEnabled(w.store.Ready() || w.store.Page() == state.SetupPageFinish)
+	}
+
+	if w.createMachineAction != nil {
+		w.createMachineAction.SetEnabled(w.store.Ready())
 	}
 
 	if w.store.HostStatus() == state.HostStatusConnecting {
@@ -270,6 +292,10 @@ 				}
 
 				if w.setupDialog != nil {
 					w.setupDialog.Widget.Object.Unref()
+				}
+
+				if w.createMachineDialog != nil {
+					w.createMachineDialog.Widget.Object.Unref()
 				}
 
 				pinner.Unpin()
