diff --git a/assets/resources/create-machine-dialog.blp b/assets/resources/create-machine-dialog.blp
new file mode 100644
index 0000000000000000000000000000000000000000..61bc596fc6beca51ae7778ca3c5e7bb0ce07e083
--- /dev/null
+++ b/assets/resources/create-machine-dialog.blp
@@ -0,0 +1,99 @@
+using Gtk 4.0;
+using Adw 1;
+
+template $PhialCreateMachineDialog: Adw.Dialog {
+  title: _("New Machine");
+  content-width: 640;
+  content-height: 600;
+
+  child: Adw.ToolbarView {
+    [top]
+    Adw.HeaderBar {
+      show-start-title-buttons: false;
+      show-end-title-buttons: false;
+
+      [start]
+      Button {
+        label: _("_Cancel");
+        use-underline: true;
+        action-name: "window.close";
+      }
+
+      title-widget: Adw.WindowTitle {
+        title: _("New Machine");
+      };
+
+      [end]
+      Button create_machine_button {
+        sensitive: false;
+        label: _("_Create");
+        use-underline: true;
+        styles [
+          "suggested-action",
+        ]
+      }
+    }
+
+    content: Adw.PreferencesPage {
+      Adw.PreferencesGroup {
+        title: _("Identity");
+        description: _("The name becomes the SSH host alias");
+
+        Adw.EntryRow {
+          title: _("_Name");
+          use-underline: true;
+          activates-default: true;
+        }
+      }
+
+      Adw.PreferencesGroup {
+        title: _("Resources");
+        description: _("Phial allocates the disk image on the first start");
+
+        Adw.SpinRow {
+          title: _("Memory");
+          numeric: true;
+          digits: 0;
+          adjustment: Adjustment {
+            lower: 1;
+            upper: 256;
+            value: 16;
+            step-increment: 1;
+            page-increment: 10;
+          };
+
+          [suffix]
+          Label {
+            label: _("GiB");
+            margin-end: 8;
+            styles [
+              "dim-label",
+            ]
+          }
+        }
+
+        Adw.SpinRow {
+          title: _("Disk Size");
+          numeric: true;
+          digits: 0;
+          adjustment: Adjustment {
+            lower: 8;
+            upper: 2048;
+            value: 48;
+            step-increment: 1;
+            page-increment: 10;
+          };
+
+          [suffix]
+          Label {
+            label: _("GiB");
+            margin-end: 8;
+            styles [
+              "dim-label",
+            ]
+          }
+        }
+      }
+    };
+  };
+}
