diff --git a/internal/components/add_token_dialog.go b/internal/components/add_token_dialog.go
new file mode 100644
index 0000000000000000000000000000000000000000..dc2b97be06cc97cc2209b4f66675383e0c82e581
--- /dev/null
+++ b/internal/components/add_token_dialog.go
@@ -0,0 +1,150 @@
+package components
+
+import (
+	"log/slog"
+	"runtime"
+	"unsafe"
+
+	"codeberg.org/pojntfx/phial/assets/resources"
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/glib"
+	"codeberg.org/puregotk/puregotk/v4/gobject"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+)
+
+var (
+	gTypeAddTokenDialog gobject.Type
+)
+
+type AddTokenDialog struct {
+	adw.Dialog
+
+	log *slog.Logger
+
+	nameRow     *adw.EntryRow
+	valueRow    *adw.PasswordEntryRow
+	deliveryRow *adw.ComboRow
+	upstreamRow *adw.EntryRow
+
+	callbacks []interface{}
+}
+
+func NewAddTokenDialog(log *slog.Logger) AddTokenDialog {
+	obj := gobject.NewObject(gTypeAddTokenDialog, "css-name")
+	gobject.IncreaseRef(obj.GoPointer())
+
+	var v AddTokenDialog
+	obj.Cast(&v)
+
+	dialog := (*AddTokenDialog)(unsafe.Pointer(obj.GetData(dataKeyGoInstance)))
+	dialog.log = log
+
+	onDeliveryChanged := func(gobject.Object, uintptr) {
+		dialog.updateUpstreamVisibility()
+	}
+	dialog.callbacks = append(dialog.callbacks, &onDeliveryChanged)
+	dialog.deliveryRow.ConnectNotify(&onDeliveryChanged)
+
+	dialog.Refresh()
+
+	return v
+}
+
+func (w *AddTokenDialog) Refresh() {
+	w.nameRow.SetText("")
+	w.valueRow.SetText("")
+	w.deliveryRow.SetSelected(0)
+	w.upstreamRow.SetText("")
+	w.updateUpstreamVisibility()
+}
+
+func (w *AddTokenDialog) updateUpstreamVisibility() {
+	w.upstreamRow.SetVisible(w.deliveryRow.GetSelected() == 1)
+}
+
+func init() {
+	var dialogClassInit gobject.ClassInitFunc = func(tc *gobject.TypeClass, u uintptr) {
+		typeClass := (*gtk.WidgetClass)(unsafe.Pointer(tc))
+		typeClass.SetTemplateFromResource(resources.ResourceAddTokenDialogUIPath)
+		typeClass.BindTemplateChildFull("name_row", false, 0)
+		typeClass.BindTemplateChildFull("value_row", false, 0)
+		typeClass.BindTemplateChildFull("delivery_row", false, 0)
+		typeClass.BindTemplateChildFull("upstream_row", false, 0)
+
+		objClass := (*gobject.ObjectClass)(unsafe.Pointer(tc))
+
+		objClass.OverrideConstructed(func(o *gobject.Object) {
+			parentObjClass := (*gobject.ObjectClass)(unsafe.Pointer(tc.PeekParent()))
+			parentObjClass.GetConstructed()(o)
+
+			var parent adw.Dialog
+			o.Cast(&parent)
+
+			parent.InitTemplate()
+
+			var (
+				nameRow     adw.EntryRow
+				valueRow    adw.PasswordEntryRow
+				deliveryRow adw.ComboRow
+				upstreamRow adw.EntryRow
+			)
+
+			parent.Widget.GetTemplateChild(
+				gTypeAddTokenDialog,
+				"name_row",
+			).Cast(&nameRow)
+			parent.Widget.GetTemplateChild(
+				gTypeAddTokenDialog,
+				"value_row",
+			).Cast(&valueRow)
+			parent.Widget.GetTemplateChild(
+				gTypeAddTokenDialog,
+				"delivery_row",
+			).Cast(&deliveryRow)
+			parent.Widget.GetTemplateChild(
+				gTypeAddTokenDialog,
+				"upstream_row",
+			).Cast(&upstreamRow)
+
+			d := &AddTokenDialog{
+				Dialog: parent,
+
+				nameRow:     &nameRow,
+				valueRow:    &valueRow,
+				deliveryRow: &deliveryRow,
+				upstreamRow: &upstreamRow,
+
+				callbacks: []interface{}{},
+			}
+
+			var pinner runtime.Pinner
+			pinner.Pin(d)
+
+			var cleanupCallback glib.DestroyNotify = func(data uintptr) {
+				for _, callback := range d.callbacks {
+					if err := glib.UnrefCallback(callback); err != nil {
+						d.log.Error("Could not unref callback", "err", err)
+					}
+				}
+
+				pinner.Unpin()
+			}
+			o.SetDataFull(dataKeyGoInstance, uintptr(unsafe.Pointer(d)), &cleanupCallback)
+		})
+	}
+
+	var dialogInstanceInit gobject.InstanceInitFunc = func(ti *gobject.TypeInstance, tc *gobject.TypeClass) {}
+
+	var dialogParentQuery gobject.TypeQuery
+	gobject.NewTypeQuery(adw.DialogGLibType(), &dialogParentQuery)
+
+	gTypeAddTokenDialog = gobject.TypeRegisterStaticSimple(
+		dialogParentQuery.Type,
+		"PhialAddTokenDialog",
+		dialogParentQuery.ClassSize,
+		&dialogClassInit,
+		dialogParentQuery.InstanceSize,
+		&dialogInstanceInit,
+		0,
+	)
+}
