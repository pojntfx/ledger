diff --git a/assets/resources/add-token-dialog.blp b/assets/resources/add-token-dialog.blp
new file mode 100644
index 0000000000000000000000000000000000000000..e6511c890098d915efaebb8135f4b578f50ffae8
--- /dev/null
+++ b/assets/resources/add-token-dialog.blp
@@ -0,0 +1,68 @@
+using Gtk 4.0;
+using Adw 1;
+
+template $PhialAddTokenDialog: Adw.Dialog {
+  title: _("Add Token");
+
+  child: Adw.ToolbarView {
+    [top]
+    Adw.HeaderBar {
+      show-start-title-buttons: false;
+      show-end-title-buttons: false;
+
+      [start]
+      Button {
+        label: _("_Cancel");
+        use-underline: true;
+        action-name: "window.close";
+      }
+
+      title-widget: Adw.WindowTitle {
+        title: _("Add Token");
+      };
+
+      [end]
+      Button {
+        sensitive: false;
+        label: _("_Add");
+        use-underline: true;
+        styles [
+          "suggested-action",
+        ]
+      }
+    }
+
+    content: Adw.PreferencesPage {
+      Adw.PreferencesGroup {
+        Adw.EntryRow name_row {
+          title: _("_Name");
+          use-underline: true;
+          show-apply-button: false;
+        }
+
+        Adw.PasswordEntryRow value_row {
+          title: _("_Value");
+          use-underline: true;
+          show-apply-button: false;
+        }
+
+        Adw.ComboRow delivery_row {
+          title: _("Delivery");
+          model: StringList {
+            strings [
+              _("Environment file"),
+              _("Proxy"),
+            ]
+          };
+        }
+
+        Adw.EntryRow upstream_row {
+          visible: false;
+          title: _("_Upstream URL");
+          use-underline: true;
+          show-apply-button: false;
+        }
+      }
+    };
+  };
+}
