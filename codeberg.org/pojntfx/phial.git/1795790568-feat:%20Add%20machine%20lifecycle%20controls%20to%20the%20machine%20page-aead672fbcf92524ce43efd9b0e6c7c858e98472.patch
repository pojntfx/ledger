@@ -21,19 +21,132 @@       Adw.HeaderBar {
         title-widget: Adw.WindowTitle machine_title {};
 
         [end]
-        Button install_button {
-          sensitive: false;
-          tooltip-text: _("Install Machine");
-          styles [
-            "suggested-action",
-          ]
+        Stack machine_action_stack {
+          transition-type: crossfade;
+          transition-duration: 150;
+
+          StackPage {
+            name: "install";
+            child: Button install_button {
+              sensitive: false;
+              tooltip-text: _("Install Machine");
+              styles [
+                "suggested-action",
+              ]
+
+              child: Adw.ButtonContent {
+                icon-name: "system-software-install-symbolic";
+                label: _("_Install...");
+                use-underline: true;
+                can-shrink: true;
+              };
+            };
+          }
+
+          StackPage {
+            name: "start";
+            child: Button start_button {
+              sensitive: false;
+              tooltip-text: _("Start Machine");
+              styles [
+                "suggested-action",
+              ]
+
+              child: Adw.ButtonContent {
+                icon-name: "media-playback-start-symbolic";
+                label: _("_Start");
+                use-underline: true;
+                can-shrink: true;
+              };
+            };
+          }
+
+          StackPage {
+            name: "stop";
+            child: Button stop_button {
+              sensitive: false;
+              tooltip-text: _("Stop Machine");
+
+              child: Adw.ButtonContent {
+                icon-name: "media-playback-stop-symbolic";
+                label: _("_Stop");
+                use-underline: true;
+                can-shrink: true;
+              };
+            };
+          }
+
+          StackPage {
+            name: "busy";
+            child: Button busy_button {
+              sensitive: false;
+              tooltip-text: _("Cancel Startup");
+              styles [
+                "flat",
+              ]
 
-          child: Adw.ButtonContent {
-            icon-name: "system-software-install-symbolic";
-            label: _("_Install...");
-            use-underline: true;
-            can-shrink: true;
-          };
+              child: Box {
+                spacing: 6;
+
+                Adw.Spinner {
+                  valign: center;
+                }
+
+                Label busy_button_label {
+                  label: _("_Cancel");
+                  use-underline: true;
+                  valign: center;
+                }
+              };
+            };
+          }
+
+          StackPage {
+            name: "cancel-install";
+            child: Button cancel_install_button {
+              sensitive: false;
+              tooltip-text: _("Cancel Installation");
+              styles [
+                "destructive-action",
+              ]
+
+              child: Box {
+                spacing: 6;
+
+                Adw.Spinner {
+                  valign: center;
+                }
+
+                Label {
+                  label: _("_Cancel...");
+                  use-underline: true;
+                  valign: center;
+                }
+              };
+            };
+          }
+
+          StackPage {
+            name: "busy-indicator";
+            child: Button busy_indicator {
+              sensitive: false;
+              styles [
+                "flat",
+              ]
+
+              child: Box {
+                spacing: 6;
+
+                Adw.Spinner {
+                  valign: center;
+                }
+
+                Label busy_indicator_label {
+                  valign: center;
+                }
+              };
+            };
+          }
         }
 
         [end]
@@ -86,19 +199,6 @@
           Adw.PreferencesGroup install_group {
             visible: false;
             title: _("Installation");
-          }
-
-          Adw.PreferencesGroup install_actions_group {
-            visible: false;
-
-            Adw.ButtonRow install_cancel_row {
-              title: _("_Cancel Installation...");
-              use-underline: true;
-              start-icon-name: "process-stop-symbolic";
-              styles [
-                "destructive-action",
-              ]
-            }
           }
 
           Adw.PreferencesGroup {
diff --git a/internal/components/machine_page.go b/internal/components/machine_page.go
index 126c6793f91b87372ec3537a96cd1c036cf90d2b..7b9dd916b8527d48a3554fe609add9e08e2a706c 100644
--- a/internal/components/machine_page.go
+++ b/internal/components/machine_page.go
@@ -56,6 +56,8 @@
 type MachinePageActions struct {
 	OnInstall       func(name string)
 	OnCancelInstall func(name string)
+	OnStart         func(name string)
+	OnStop          func(name string)
 }
 
 type MachinePage struct {
@@ -70,13 +72,19 @@ 	actions        MachinePageActions
 	info           state.MachineInfo
 
 	machineTitle        *adw.WindowTitle
+	machineActionStack  *gtk.Stack
 	overviewStateRow    *adw.ActionRow
 	storageDiskRow      *adw.ActionRow
 	storageOpenButton   *gtk.Button
 	installButton       *gtk.Button
+	startButton         *gtk.Button
+	stopButton          *gtk.Button
+	busyButton          *gtk.Button
+	busyButtonLabel     *gtk.Label
+	cancelInstallButton *gtk.Button
+	busyIndicator       *gtk.Button
+	busyIndicatorLabel  *gtk.Label
 	installGroup        *adw.PreferencesGroup
-	installActionsGroup *adw.PreferencesGroup
-	installCancelRow    *adw.ButtonRow
 	installStepModel    *gio.ListStore
 
 	callbacks []interface{}
@@ -113,13 +121,37 @@ 	}
 	page.callbacks = append(page.callbacks, &onInstall)
 	page.installButton.ConnectClicked(&onInstall)
 
-	onCancelInstall := func(adw.ButtonRow) {
+	onCancelInstall := func(gtk.Button) {
 		if page.actions.OnCancelInstall != nil {
 			page.actions.OnCancelInstall(page.machineName)
 		}
 	}
 	page.callbacks = append(page.callbacks, &onCancelInstall)
-	page.installCancelRow.ConnectActivated(&onCancelInstall)
+	page.cancelInstallButton.ConnectClicked(&onCancelInstall)
+
+	onStart := func(gtk.Button) {
+		if page.actions.OnStart != nil {
+			page.actions.OnStart(page.machineName)
+		}
+	}
+	page.callbacks = append(page.callbacks, &onStart)
+	page.startButton.ConnectClicked(&onStart)
+
+	onStop := func(gtk.Button) {
+		if page.actions.OnStop != nil {
+			page.actions.OnStop(page.machineName)
+		}
+	}
+	page.callbacks = append(page.callbacks, &onStop)
+	page.stopButton.ConnectClicked(&onStop)
+
+	onBusyAction := func(gtk.Button) {
+		if page.actions.OnStop != nil {
+			page.actions.OnStop(page.machineName)
+		}
+	}
+	page.callbacks = append(page.callbacks, &onBusyAction)
+	page.busyButton.ConnectClicked(&onBusyAction)
 
 	page.buildInstallSteps()
 	page.Refresh(info)
@@ -134,7 +166,7 @@ func (p *MachinePage) Refresh(info state.MachineInfo) {
 	p.machineName = info.Name
 	p.info = info
 
-	status := machineStatusText(info.Status)
+	status := machineStatusText(info)
 
 	p.machineTitle.SetTitle(info.Name)
 	p.machineTitle.SetSubtitle(status)
@@ -143,12 +175,33 @@ 	p.overviewStateRow.SetSubtitle(status)
 	p.storageDiskRow.SetSubtitle(filepath.Join(p.machinesFolder, info.Name, "disk.qcow2"))
 
 	installable := info.Status == state.MachineStatusNotInstalled || info.Status == state.MachineStatusInstallFailed
-	p.installButton.SetVisible(installable)
 	p.installButton.SetSensitive(installable)
+	p.startButton.SetSensitive(info.Status == state.MachineStatusStopped)
+	p.stopButton.SetSensitive(info.Status == state.MachineStatusRunning && info.Ready)
+	p.busyButton.SetSensitive(info.Status == state.MachineStatusStarting || info.Status == state.MachineStatusRestarting || info.Status == state.MachineStatusRunning && !info.Ready)
+	p.cancelInstallButton.SetSensitive(info.Status == state.MachineStatusInstalling)
+
+	if info.Status == state.MachineStatusStarting || info.Status == state.MachineStatusRunning && !info.Ready {
+		p.busyButtonLabel.SetTextWithMnemonic(L("_Cancel"))
+		p.busyButton.SetTooltipText(L("Cancel Startup"))
+	} else {
+		p.busyButtonLabel.SetTextWithMnemonic(L("_Stop"))
+		p.busyButton.SetTooltipText(L("Stop Machine"))
+	}
+
+	p.machineActionStack.SetVisibleChildName(machineActionPage(info))
+
+	switch info.Status {
+	case state.MachineStatusStopping:
+		p.busyIndicatorLabel.SetText(L("Stopping"))
+		p.busyIndicator.SetTooltipText(L("Stopping the Machine"))
+	case state.MachineStatusUpdatingAgent:
+		p.busyIndicatorLabel.SetText(L("Updating"))
+		p.busyIndicator.SetTooltipText(L("Updating the Guest Agent"))
+	}
 
 	installing := info.Status == state.MachineStatusInstalling
 	p.installGroup.SetVisible(installing || info.Status == state.MachineStatusInstallFailed)
-	p.installActionsGroup.SetVisible(installing)
 
 	p.refreshInstallSteps()
 }
@@ -302,8 +355,29 @@
 	return value + " " + unit
 }
 
-func machineStatusText(status state.MachineStatus) string {
-	switch status {
+func machineActionPage(info state.MachineInfo) string {
+	if info.Status == state.MachineStatusRunning && !info.Ready {
+		return "busy"
+	}
+
+	switch info.Status {
+	case state.MachineStatusStopped:
+		return "start"
+	case state.MachineStatusStarting, state.MachineStatusRestarting:
+		return "busy"
+	case state.MachineStatusRunning:
+		return "stop"
+	case state.MachineStatusInstalling:
+		return "cancel-install"
+	case state.MachineStatusStopping, state.MachineStatusUpdatingAgent:
+		return "busy-indicator"
+	default:
+		return "install"
+	}
+}
+
+func machineStatusText(info state.MachineInfo) string {
+	switch info.Status {
 	case state.MachineStatusInstalling:
 		return L("Installing")
 	case state.MachineStatusInstallFailed:
@@ -313,6 +387,10 @@ 		return L("Stopped")
 	case state.MachineStatusStarting:
 		return L("Starting")
 	case state.MachineStatusRunning:
+		if !info.Ready {
+			return L("Starting")
+		}
+
 		return L("Running")
 	case state.MachineStatusStopping:
 		return L("Stopping")
@@ -402,13 +480,19 @@ 	var classInit gobject.ClassInitFunc = func(tc *gobject.TypeClass, u uintptr) {
 		typeClass := (*gtk.WidgetClass)(unsafe.Pointer(tc))
 		typeClass.SetTemplateFromResource(resources.ResourceMachinePageUIPath)
