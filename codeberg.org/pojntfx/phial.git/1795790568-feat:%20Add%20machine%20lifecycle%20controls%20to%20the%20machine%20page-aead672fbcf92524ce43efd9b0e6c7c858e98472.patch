+		typeClass.BindTemplateChildFull("machine_action_stack", false, 0)
 		typeClass.BindTemplateChildFull("overview_state_row", false, 0)
 		typeClass.BindTemplateChildFull("storage_disk_row", false, 0)
 		typeClass.BindTemplateChildFull("storage_open_button", false, 0)
 		typeClass.BindTemplateChildFull("install_button", false, 0)
+		typeClass.BindTemplateChildFull("start_button", false, 0)
+		typeClass.BindTemplateChildFull("stop_button", false, 0)
+		typeClass.BindTemplateChildFull("busy_button", false, 0)
+		typeClass.BindTemplateChildFull("busy_button_label", false, 0)
+		typeClass.BindTemplateChildFull("cancel_install_button", false, 0)
+		typeClass.BindTemplateChildFull("busy_indicator", false, 0)
+		typeClass.BindTemplateChildFull("busy_indicator_label", false, 0)
 		typeClass.BindTemplateChildFull("install_group", false, 0)
-		typeClass.BindTemplateChildFull("install_actions_group", false, 0)
-		typeClass.BindTemplateChildFull("install_cancel_row", false, 0)
 
 		objClass := (*gobject.ObjectClass)(unsafe.Pointer(tc))
 
@@ -423,19 +507,29 @@ 			parent.InitTemplate()
 
 			var (
 				machineTitle        adw.WindowTitle
+				machineActionStack  gtk.Stack
 				overviewStateRow    adw.ActionRow
 				storageDiskRow      adw.ActionRow
 				storageOpenButton   gtk.Button
 				installButton       gtk.Button
+				startButton         gtk.Button
+				stopButton          gtk.Button
+				busyButton          gtk.Button
+				busyButtonLabel     gtk.Label
+				cancelInstallButton gtk.Button
+				busyIndicator       gtk.Button
+				busyIndicatorLabel  gtk.Label
 				installGroup        adw.PreferencesGroup
-				installActionsGroup adw.PreferencesGroup
-				installCancelRow    adw.ButtonRow
 			)
 
 			parent.Widget.GetTemplateChild(
 				gTypeMachinePage,
 				"machine_title",
 			).Cast(&machineTitle)
+			parent.Widget.GetTemplateChild(
+				gTypeMachinePage,
+				"machine_action_stack",
+			).Cast(&machineActionStack)
 			parent.Widget.GetTemplateChild(
 				gTypeMachinePage,
 				"overview_state_row",
@@ -454,28 +548,54 @@ 				"install_button",
 			).Cast(&installButton)
 			parent.Widget.GetTemplateChild(
 				gTypeMachinePage,
-				"install_group",
-			).Cast(&installGroup)
+				"start_button",
+			).Cast(&startButton)
 			parent.Widget.GetTemplateChild(
 				gTypeMachinePage,
-				"install_actions_group",
-			).Cast(&installActionsGroup)
+				"stop_button",
+			).Cast(&stopButton)
 			parent.Widget.GetTemplateChild(
 				gTypeMachinePage,
-				"install_cancel_row",
-			).Cast(&installCancelRow)
+				"busy_button",
+			).Cast(&busyButton)
+			parent.Widget.GetTemplateChild(
+				gTypeMachinePage,
+				"busy_button_label",
+			).Cast(&busyButtonLabel)
+			parent.Widget.GetTemplateChild(
+				gTypeMachinePage,
+				"cancel_install_button",
+			).Cast(&cancelInstallButton)
+			parent.Widget.GetTemplateChild(
+				gTypeMachinePage,
+				"busy_indicator",
+			).Cast(&busyIndicator)
+			parent.Widget.GetTemplateChild(
+				gTypeMachinePage,
+				"busy_indicator_label",
+			).Cast(&busyIndicatorLabel)
+			parent.Widget.GetTemplateChild(
+				gTypeMachinePage,
+				"install_group",
+			).Cast(&installGroup)
 
 			p := &MachinePage{
 				NavigationPage: parent,
 
 				machineTitle:        &machineTitle,
+				machineActionStack:  &machineActionStack,
 				overviewStateRow:    &overviewStateRow,
 				storageDiskRow:      &storageDiskRow,
 				storageOpenButton:   &storageOpenButton,
 				installButton:       &installButton,
+				startButton:         &startButton,
+				stopButton:          &stopButton,
+				busyButton:          &busyButton,
+				busyButtonLabel:     &busyButtonLabel,
+				cancelInstallButton: &cancelInstallButton,
+				busyIndicator:       &busyIndicator,
+				busyIndicatorLabel:  &busyIndicatorLabel,
 				installGroup:        &installGroup,
-				installActionsGroup: &installActionsGroup,
-				installCancelRow:    &installCancelRow,
 
 				callbacks: []interface{}{},
 			}
diff --git a/internal/components/main_window.go b/internal/components/main_window.go
index dbc23b2e63bbdd06621fde79c2ec0226263b654e..e88f2540e5cfacd1f4bbc6875aeb8d1daff53766 100644
--- a/internal/components/main_window.go
+++ b/internal/components/main_window.go
@@ -250,7 +250,7 @@ 	} else {
 		for _, machine := range machines {
 			item := adw.NewSidebarItem(machine.Name)
 			item.SetIconName("computer-symbolic")
-			item.SetSubtitle(machineStatusText(machine.Status))
+			item.SetSubtitle(machineStatusText(machine))
 
 			w.machinesSection.Append(item)
 			w.sidebarTags = append(w.sidebarTags, machinePageTag(machine.Name))
@@ -314,6 +314,16 @@ 						w.installMachineDialog.operatingSystemRow.GrabFocus()
 					},
 					OnCancelInstall: func(name string) {
 						w.confirmCancelInstall(name)
+					},
+					OnStart: func(name string) {
+						if err := w.store.Start(w.ctx, name); err != nil {
+							w.log.Error("Could not start machine", "err", err)
+						}
+					},
+					OnStop: func(name string) {
+						if err := w.store.Stop(w.ctx, name); err != nil {
+							w.log.Error("Could not stop machine", "err", err)
+						}
