diff --git a/internal/ui/util_test.go b/internal/ui/util_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..b9709f70713650bb2590f7479918512d0fd44e01
--- /dev/null
+++ b/internal/ui/util_test.go
@@ -0,0 +1,49 @@
+package ui
+
+import (
+	"log/slog"
+	"testing"
+
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+)
+
+// TestStateText keeps a stop in the Stopping state until the guest is gone,
+// because a stop keeps the unit deactivating while the guest still shuts down.
+func TestStateText(t *testing.T) {
+	t.Setenv("LC_ALL", "C")
+	t.Setenv("LANG", "C")
+
+	if err := i18n.InitI18n("phial", t.TempDir(), slog.Default()); err != nil {
+		t.Skipf("the translations cannot be initialized: %v", err)
+	}
+
+	tests := []struct {
+		name       string
+		runState   string
+		ready      bool
+		installing bool
+		installed  bool
+		pending    string
+		want       string
+	}{
+		{"fresh disk", "inactive", false, false, false, "", "Not installed"},
+		{"stopped", "inactive", false, false, true, "", "Stopped"},
+		{"start job", "activating", false, false, true, "", "Starting"},
+		{"guest not up", "active", false, false, true, "", "Starting"},
+		{"ready", "active", true, false, true, "", "Running"},
+		{"shutdown of the guest", "deactivating", false, false, true, "", "Stopping"},
+		{"stop requested", "inactive", false, false, true, "stop", "Stopping"},
+		{"stop requested while the guest answers", "active", true, false, true, "stop", "Stopping"},
+		{"restart", "deactivating", false, false, true, "restart", "Restarting"},
+		{"provision", "active", true, false, true, "provision", "Updating the guest agent"},
+		{"install", "inactive", false, true, true, "", "Installing"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := stateText(tt.runState, tt.ready, tt.installing, tt.installed, tt.pending); got != tt.want {
+				t.Fatalf("stateText(%q, %v, %v, %v, %q) = %q, want %q", tt.runState, tt.ready, tt.installing, tt.installed, tt.pending, got, tt.want)
+			}
+		})
+	}
+}
