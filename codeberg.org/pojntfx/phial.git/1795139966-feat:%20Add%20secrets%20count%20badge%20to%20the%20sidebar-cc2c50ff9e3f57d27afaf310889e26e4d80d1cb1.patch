diff --git a/pkg/state/secrets.go b/pkg/state/secrets.go
new file mode 100644
index 0000000000000000000000000000000000000000..6ea383fb177aeaacffbcb7edb394a74cd038c216
--- /dev/null
+++ b/pkg/state/secrets.go
@@ -0,0 +1,104 @@
+package state
+
+type SecretMode string
+
+const (
+	SecretModeEnvironment SecretMode = "environment"
+	SecretModeProxy       SecretMode = "proxy"
+)
+
+type Secret struct {
+	Name     string
+	Mode     SecretMode
+	Upstream string
+
+	// TODO: Remove this mock once grants reference secrets.
+	GrantedTo []string
+}
+
+type SSHKey struct {
+	Comment     string
+	Fingerprint string
+	Type        string
+
+	// TODO: Remove this mock once grants reference SSH keys.
+	LinkedTo []string
+}
+
+type GPGKey struct {
+	UID         string
+	Fingerprint string
+
+	// TODO: Remove this mock once grants reference PGP keys.
+	LinkedTo []string
+}
+
+// TODO: Remove this mock once actual implementation exists
+func (s *Store) seedSecrets() {
+	s.secrets = []Secret{
+		{
+			Name:      "e2e_host_test",
+			Mode:      SecretModeEnvironment,
+			GrantedTo: []string{"test-vm"},
+		},
+		{
+			Name:     "stripe-api",
+			Mode:     SecretModeProxy,
+			Upstream: "https://api.stripe.com",
+		},
+	}
+
+	s.sshKeys = []SSHKey{
+		{
+			Comment:     "felicitas@pojntfx",
+			Fingerprint: "SHA256:57d8a2b4c6d8e0f1a3c5e7",
+			Type:        "ssh-ed25519",
+			LinkedTo:    []string{"test-vm"},
+		},
+		{
+			Comment:     "phial@host",
+			Fingerprint: "SHA256:0c2c6e4a6b6d8f8hJ0",
+			Type:        "ssh-rsa",
+		},
+	}
+
+	s.gpgKeys = []GPGKey{
+		{
+			UID:         "Felicitas Pojtinger <felicitas@pojtinger.com>",
+			Fingerprint: "6D7E8F9012345678",
+			LinkedTo:    []string{"test-vm"},
+		},
+		{
+			UID:         "Phial Test Key <phial@example.org>",
+			Fingerprint: "7D8E9F01A2B3C4D5",
+		},
+	}
+}
+
+func (s *Store) Secrets() []Secret {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	return append([]Secret(nil), s.secrets...)
+}
+
+func (s *Store) SSHKeys() []SSHKey {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	return append([]SSHKey(nil), s.sshKeys...)
+}
+
+func (s *Store) GPGKeys() []GPGKey {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	return append([]GPGKey(nil), s.gpgKeys...)
+}
+
+func (s *Store) SecretCount() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	return len(s.secrets) + len(s.sshKeys) + len(s.gpgKeys)
+}
