diff --git a/internal/host/client_test.go b/internal/host/client_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..22232e2c77b58cf2de6a83cfcd650d8c678ecc02
--- /dev/null
+++ b/internal/host/client_test.go
@@ -0,0 +1,69 @@
+package host
+
+import (
+	"context"
+	"encoding/json"
+	"log/slog"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"codeberg.org/pojntfx/phial-neo/internal/varlink"
+)
+
+// TestCallsDoNotShareOneConnection keeps a slow call from holding up a fast
+// one. The window polls the service while a restart runs, so one shared
+// connection would freeze the poll for the length of the restart.
+func TestCallsDoNotShareOneConnection(t *testing.T) {
+	dir := t.TempDir()
+	socket := filepath.Join(dir, "control.sock")
+
+	listener, err := varlink.ListenUnix(socket)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+
+	handler := func(_ context.Context, method string, _ json.RawMessage) (any, *varlink.Error) {
+		if method == "VMStart" {
+			time.Sleep(600 * time.Millisecond)
+		}
+
+		return &struct{}{}, nil
+	}
+
+	server := varlink.NewServer(slog.Default(), handler, nil)
+	defer server.Close()
+
+	go server.Serve(listener)
+
+	t.Setenv("PHIAL_CONTROL_SOCK", socket)
+
+	client, err := Dial()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+
+		if err := client.VMStart(context.Background(), "slow"); err != nil {
+			t.Errorf("the slow call failed: %v", err)
+		}
+	}()
+
+	// Give the slow call time to reach the service.
+	time.Sleep(100 * time.Millisecond)
+
+	start := time.Now()
+	if err := client.VMStop(context.Background(), "fast"); err != nil {
+		t.Fatal(err)
+	}
+
+	if elapsed := time.Since(start); elapsed > 300*time.Millisecond {
+		t.Fatalf("the fast call waited %s for the slow call", elapsed)
+	}
+
+	<-done
+}
