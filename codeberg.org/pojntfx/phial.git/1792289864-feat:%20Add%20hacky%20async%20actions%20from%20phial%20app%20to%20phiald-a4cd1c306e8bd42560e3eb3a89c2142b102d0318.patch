@@ -0,0 +1,38 @@
+package setup
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+
+	"github.com/adrg/xdg"
+)
+
+// appID is the application identifier of Phial.
+const appID = "com.pojtinger.felicitas.Phial"
+
+// RemoveLegacyHostExports removes the desktop entry, the icons, and the
+// settings schema that an older install wrote into the home folder. The
+// Flatpak export owns the desktop entry now. A host entry runs the old phial
+// command, which shadows the Flatpak entry and fails when the host binary is
+// missing or out of date.
+func RemoveLegacyHostExports() error {
+	return removeLegacyHostExports(xdg.DataHome)
+}
+
+func removeLegacyHostExports(dataHome string) error {
+	targets := []string{
+		filepath.Join(dataHome, "applications", appID+".desktop"),
+		filepath.Join(dataHome, "icons", "hicolor", "scalable", "apps", appID+".svg"),
+		filepath.Join(dataHome, "icons", "hicolor", "symbolic", "apps", appID+"-symbolic.svg"),
+		filepath.Join(dataHome, "glib-2.0", "schemas", appID+".gschema.xml"),
+	}
+
+	for _, target := range targets {
+		if err := os.Remove(target); err != nil && !errors.Is(err, os.ErrNotExist) {
+			return err
+		}
+	}
+
+	return nil
+}
diff --git a/internal/setup/legacy_test.go b/internal/setup/legacy_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..73ecf3a2bb5edd7a37a7581765c3b88a9035b958
--- /dev/null
+++ b/internal/setup/legacy_test.go
@@ -0,0 +1,46 @@
+package setup
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// TestRemoveLegacyHostExports keeps the host desktop entry and its icons out
+// of the way, so that the Flatpak entry of the same application ID is the one
+// that the menu opens.
+func TestRemoveLegacyHostExports(t *testing.T) {
+	dataHome := t.TempDir()
+
+	targets := []string{
+		filepath.Join(dataHome, "applications", appID+".desktop"),
+		filepath.Join(dataHome, "icons", "hicolor", "scalable", "apps", appID+".svg"),
+		filepath.Join(dataHome, "icons", "hicolor", "symbolic", "apps", appID+"-symbolic.svg"),
+		filepath.Join(dataHome, "glib-2.0", "schemas", appID+".gschema.xml"),
+	}
+
+	for _, target := range targets {
+		if err := os.MkdirAll(filepath.Dir(target), 0o700); err != nil {
+			t.Fatal(err)
+		}
+
+		if err := os.WriteFile(target, []byte("legacy\n"), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	if err := removeLegacyHostExports(dataHome); err != nil {
+		t.Fatal(err)
+	}
+
+	for _, target := range targets {
+		if _, err := os.Stat(target); !os.IsNotExist(err) {
+			t.Fatalf("%s still exists after the cleanup", target)
+		}
+	}
+
+	// A second run sees no file and reports no error.
+	if err := removeLegacyHostExports(dataHome); err != nil {
+		t.Fatal(err)
+	}
+}
