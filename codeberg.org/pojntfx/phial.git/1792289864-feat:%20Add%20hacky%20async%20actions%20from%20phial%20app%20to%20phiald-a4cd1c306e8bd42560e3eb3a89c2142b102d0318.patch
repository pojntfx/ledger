diff --git a/internal/ui/hostwatch.go b/internal/ui/hostwatch.go
new file mode 100644
index 0000000000000000000000000000000000000000..62d6866e181c89a006068f44495d7c9beb22c0e3
--- /dev/null
+++ b/internal/ui/hostwatch.go
@@ -0,0 +1,237 @@
+package ui
+
+import (
+	"context"
+	"strings"
+	"sync"
+	"time"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+
+	"codeberg.org/pojntfx/phial-neo/internal/host"
+	"codeberg.org/pojntfx/phial-neo/internal/paths"
+	"codeberg.org/pojntfx/phial-neo/internal/state"
+)
+
+// The window reads the host state from this snapshot. A worker goroutine
+// refreshes it over the varlink socket, so the GTK main thread never waits for
+// the host service. A long call, such as a restart, therefore cannot freeze
+// the window.
+type hostView struct {
+	info      *host.InfoResponse
+	infoErr   error
+	status    *host.StatusResponse
+	statusErr error
+
+	rows      []state.Row
+	rowsErr   error
+	grants    []state.Grant
+	grantsErr error
+
+	sshKeys []state.SSHKey
+	sshErr  error
+
+	gpgKeys []state.GPGKey
+	gpgErr  error
+}
+
+// hostCache guards the snapshot and the one-time flags of the worker.
+type hostCache struct {
+	mu          sync.RWMutex
+	view        hostView
+	updateShown bool
+	foldersKey  string
+	wake        chan struct{}
+}
+
+// hostHubPoll is the interval between two snapshots.
+const hostHubPoll = 2 * time.Second
+
+// hostView returns the last snapshot. The caller never waits for the host.
+func (a *App) hostView() hostView {
+	a.host.mu.RLock()
+	defer a.host.mu.RUnlock()
+
+	return a.host.view
+}
+
+// hostReady reports whether the host service answered the last Info call.
+func (a *App) hostReady() bool {
+	view := a.hostView()
+
+	return view.info != nil && view.infoErr == nil
+}
+
+// requestHostRefresh asks the worker for a fresh snapshot now, so that an
+// action shows its result without waiting for the next poll.
+func (a *App) requestHostRefresh() {
+	if a.host.wake == nil {
+		return
+	}
+
+	select {
+	case a.host.wake <- struct{}{}:
+	default:
+	}
+}
+
+// watchHost refreshes the snapshot until the application quits.
+func (a *App) watchHost() {
+	ticker := time.NewTicker(hostHubPoll)
+	defer ticker.Stop()
+
+	for {
+		a.refreshHost()
+
+		select {
+		case <-a.Ctx.Done():
+			return
+		case <-ticker.C:
+		case <-a.host.wake:
+		}
+	}
+}
+
+// refreshHost reads the host state on the worker goroutine and applies it on
+// the main thread.
+func (a *App) refreshHost() {
+	view := hostView{}
+
+	// The first connection starts the host service through socket
+	// activation, so it retries once.
+	if err := a.State.EnsureRemote(a.Log); err != nil {
+		view.infoErr = err
+		view.statusErr = err
+		view.sshErr = err
+		view.gpgErr = err
+		view.rows, view.rowsErr = a.State.Rows()
+		view.grants = a.State.ActiveGrants()
+
+		a.storeHostView(view)
+		a.idle(a.applyHostView)
+
+		return
+	}
+
+	ctx, cancel := context.WithTimeout(a.Ctx, 15*time.Second)
+	defer cancel()
+
+	info, err := a.hostClient().Info(ctx)
+	view.info, view.infoErr = info, err
+
+	if err == nil {
+		// The host service reads the machine definitions from the chosen
+		// folder, so the window sends the folders whenever they change.
+		set := paths.Current()
+		key := set.Config.HostPath() + "|" + set.Data.HostPath() + "|" + set.SSH.HostPath()
+
+		if key != a.hostFoldersKey() {
+			if folderErr := a.hostClient().Folders(ctx, set.Config.HostPath(), set.Data.HostPath(), set.SSH.HostPath()); folderErr != nil {
+				a.Log.Info("could not send the folders to the host service", "err", folderErr)
+			} else {
+				a.setHostFoldersKey(key)
+			}
+		}
+	}
+
+	status, statusErr := a.hostClient().Status(ctx)
+	view.status, view.statusErr = status, statusErr
+
+	view.rows, view.rowsErr = a.State.Rows()
+	view.sshKeys, view.sshErr = a.State.ListSSHKeys()
+	view.gpgKeys, view.gpgErr = a.State.ListGPGKeys()
+	view.grants = a.State.ActiveGrants()
+
+	a.storeHostView(view)
+	a.idle(a.applyHostView)
+}
+
+func (a *App) storeHostView(view hostView) {
+	a.host.mu.Lock()
+	defer a.host.mu.Unlock()
+
+	a.host.view = view
+}
+
+func (a *App) hostFoldersKey() string {
+	a.host.mu.RLock()
+	defer a.host.mu.RUnlock()
+
+	return a.host.foldersKey
+}
+
+func (a *App) setHostFoldersKey(key string) {
+	a.host.mu.Lock()
+	defer a.host.mu.Unlock()
+
+	a.host.foldersKey = key
+}
+
+// applyHostView redraws the window from the snapshot. It runs on the main
+// thread, and every call that it makes only reads the snapshot or local files.
+func (a *App) applyHostView() {
+	if a.win == nil {
+		return
+	}
+
+	a.refreshSidebar()
+	a.refreshSecretsPage()
+	a.refreshGrantsPage()
+	a.refreshCounts()
+	a.refreshInstall()
+	a.refreshSetupHostStep()
+	a.maybeShowUpdateToast()
+
+	if a.content == nil {
+		return
+	}
+
+	tag := a.content.GetVisiblePageTag()
+	if !strings.HasPrefix(tag, machineTagPrefix) {
+		return
+	}
+
+	if page := a.machinePages[strings.TrimPrefix(tag, machineTagPrefix)]; page != nil {
+		page.refresh()
+	}
+}
+
+// refreshSetupHostStep turns the Continue control of the wizard on as soon as
+// the host service answers, without blocking the step on a socket read.
+func (a *App) refreshSetupHostStep() {
+	if a.setupNavigation == nil || a.setupSteps == nil {
+		return
+	}
+
+	if step := a.setupSteps[wizardHostTag]; step != nil {
+		step.update()
+	}
+}
+
+// maybeShowUpdateToast compares the embedded service with the running one and
+// shows the copyable update command once.
+func (a *App) maybeShowUpdateToast() {
+	view := a.hostView()
+	if view.info == nil || !host.NeedsUpdate(view.info) {
+		return
+	}
+
+	if a.toasts == nil {
+		return
+	}
+
+	a.host.mu.Lock()
+	if a.host.updateShown {
+		a.host.mu.Unlock()
+
+		return
+	}
+	a.host.updateShown = true
+	a.host.mu.Unlock()
+
+	toast := adw.NewToast(i18n.L("The host service is out of date"))
+	toast.SetButtonLabel(i18n.L("Copy Command"))
+	toast.SetActionName("app.copy-update-command")
+	a.toasts.AddToast(toast)
+}
