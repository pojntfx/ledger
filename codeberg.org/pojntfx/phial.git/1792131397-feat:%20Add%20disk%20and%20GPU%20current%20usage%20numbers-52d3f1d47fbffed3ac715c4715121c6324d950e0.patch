+// gpuEngineNs sums the DRM engine times of one process, which count the
+// nanoseconds of GPU work that the process asked for. The second return value
+// states whether any engine answered, so an idle GPU and a missing driver look
+// different.
+func gpuEngineNs(pid int) (int64, bool) {
+	entries, err := os.ReadDir("/proc/" + strconv.Itoa(pid) + "/fdinfo")
+	if err != nil {
+		return 0, false
+	}
+
+	total := int64(0)
+	found := false
+
+	for _, entry := range entries {
+		data, err := os.ReadFile(filepath.Join("/proc", strconv.Itoa(pid), "fdinfo", entry.Name()))
+		if err != nil {
+			continue
+		}
+
+		for _, line := range strings.Split(string(data), "\n") {
+			if !strings.HasPrefix(line, "drm-engine-") {
+				continue
+			}
+
+			fields := strings.Fields(line)
+			if len(fields) < 2 {
+				continue
+			}
+
+			ns, err := strconv.ParseInt(fields[1], 10, 64)
+			if err != nil {
+				continue
+			}
+
+			total += ns
+			found = true
+		}
+	}
+
+	return total, found
+}
+
+// processDiskIO reads the block layer counters of one process, so the numbers
+// stay close to the disk image instead of the sockets of the process.
+func processDiskIO(pid int) (int64, int64) {
+	data, err := os.ReadFile("/proc/" + strconv.Itoa(pid) + "/io")
+	if err != nil {
+		return 0, 0
+	}
+
+	var read, written int64
+
+	for _, line := range strings.Split(string(data), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) != 2 {
+			continue
+		}
+
+		value, err := strconv.ParseInt(fields[1], 10, 64)
+		if err != nil {
+			continue
+		}
+
+		switch fields[0] {
+		case "read_bytes:":
+			read = value
+		case "write_bytes:":
+			written = value
+		}
+	}
+
+	return read, written
+}
