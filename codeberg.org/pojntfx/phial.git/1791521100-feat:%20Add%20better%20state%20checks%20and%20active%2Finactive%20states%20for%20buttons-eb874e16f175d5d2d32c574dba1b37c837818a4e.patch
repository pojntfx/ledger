diff --git a/tests/enable-linger.sh b/tests/enable-linger.sh
new file mode 100644
index 0000000000000000000000000000000000000000..d27f3e7408d965bc357fbd3c26c4b25545bb0671
--- /dev/null
+++ b/tests/enable-linger.sh
@@ -0,0 +1,56 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+IMAGE="${1:?usage: enable-linger.sh <image> <user>}"
+USER_NAME="${2:?usage: enable-linger.sh <image> <user>}"
+
+LOOP=$(losetup --find --show --partscan "$IMAGE")
+echo "loop device: $LOOP"
+
+cleanup() {
+  set +e
+  umount -R /mnt/phial-fix 2>/dev/null
+  losetup -d "$LOOP" 2>/dev/null
+}
+trap cleanup EXIT
+
+ROOT_PART=$(lsblk -nlo NAME,SIZE "$LOOP" | grep -v "^$(basename "$LOOP") " | sort -k2 -h | tail -1 | awk '{print $1}')
+echo "root partition: $ROOT_PART"
+
+mkdir -p /mnt/phial-fix
+
+if blkid -o value -s TYPE "/dev/$ROOT_PART" 2>/dev/null | grep -q btrfs; then
+  mount -o subvol=root "/dev/$ROOT_PART" /mnt/phial-fix || mount "/dev/$ROOT_PART" /mnt/phial-fix
+else
+  mount "/dev/$ROOT_PART" /mnt/phial-fix
+fi
+
+echo "mounted: $(findmnt -n -o TARGET /mnt/phial-fix)"
+
+mkdir -p /mnt/phial-fix/var/lib/systemd/linger
+touch "/mnt/phial-fix/var/lib/systemd/linger/$USER_NAME"
+
+install -d -m 0755 /mnt/phial-fix/etc/systemd/system
+cat > /mnt/phial-fix/etc/systemd/system/phial-ssh-vsock.service <<'UNIT'
+[Unit]
+Description=phial SSH over vsock
+After=sshd.service
+Wants=sshd.service
+
+[Service]
+Type=simple
+ExecStart=/usr/bin/socat VSOCK-LISTEN:2222,fork,reuseaddr TCP:[::1]:22
+Restart=on-failure
+
+[Install]
+WantedBy=multi-user.target
+UNIT
+
+rm -f /mnt/phial-fix/etc/systemd/system/multi-user.target.wants/phial-ssh-vsock.service
+mkdir -p /mnt/phial-fix/etc/systemd/system/multi-user.target.wants
+ln -sf /etc/systemd/system/phial-ssh-vsock.service /mnt/phial-fix/etc/systemd/system/multi-user.target.wants/phial-ssh-vsock.service
+
+echo "linger: $(ls /mnt/phial-fix/var/lib/systemd/linger/)"
+echo "unit: $(ls -l /mnt/phial-fix/etc/systemd/system/multi-user.target.wants/phial-ssh-vsock.service)"
+
+sync
