+	a.hold(&onActivated)
+
+	sidebarScroll := gtk.NewScrolledWindow()
+	sidebarScroll.SetChild(&sidebarList.Widget)
+	sidebarScroll.SetVexpand(true)
+
+	sidebarToolbar.SetContent(&sidebarScroll.Widget)
+	sidebarBox.Append(&sidebarToolbar.Widget)
+
+	sidebarPage := adw.NewNavigationPage(&sidebarBox.Widget, i18n.L("Phial"))
+	split.SetSidebar(sidebarPage)
+
+	stack := adw.NewViewStack()
+	a.stack = stack
