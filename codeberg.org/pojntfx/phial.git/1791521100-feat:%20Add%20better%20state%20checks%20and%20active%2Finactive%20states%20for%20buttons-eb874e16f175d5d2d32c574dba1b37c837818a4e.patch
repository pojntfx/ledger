+	about.SetDeveloperName("Felicitas Pojtinger")
+	about.SetVersion("1.0.0")
+	about.SetWebsite("https://codeberg.org/pojntfx/phial")
+	about.SetIssueUrl("https://codeberg.org/pojntfx/phial/issues")
