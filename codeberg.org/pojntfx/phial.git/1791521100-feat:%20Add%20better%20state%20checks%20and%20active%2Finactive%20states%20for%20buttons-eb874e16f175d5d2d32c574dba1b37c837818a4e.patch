+func (s *Service) VmInstall(ctx context.Context, req *mcpgo.CallToolRequest, input NameInput) (*mcpgo.CallToolResult, any, error) {
+	def, err := virt.Load(input.Name)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	if s.installs[def.Name] {
+		return nil, nil, fmt.Errorf("an install already runs for %s", def.Name)
+	}
+
+	s.installs[def.Name] = true
+
+	go func() {
+		defer delete(s.installs, def.Name)
+
+		result, err := virt.Install(def, s.kickstart, "")
+
+		summary := "phial install finished"
+		body := ""
+
+		if err != nil {
+			summary = "phial install failed"
+			body = err.Error()
+		} else {
+			body = result.Message
+		}
+
+		if s.notify != nil {
+			s.notify(summary, body)
+		}
+
+		s.log.Info(summary, "body", body, "err", err)
+	}()
+
+	return nil, map[string]string{"state": "installing"}, nil
