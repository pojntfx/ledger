@@ -0,0 +1,55 @@
+package virt
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+)
+
+func WriteSSHConfig() error {
+	defs, err := List()
+	if err != nil {
+		return err
+	}
+
+	configDir, err := os.UserConfigDir()
+	if err != nil {
+		return err
+	}
+
+	path := filepath.Join(configDir, "phial", "ssh_config")
+
+	var builder strings.Builder
+	builder.WriteString("# Generated by phial. Do not edit.\n\n")
+
+	for _, def := range defs {
+		fmt.Fprintf(&builder,
+			"Host %s\n    User phial\n    ProxyCommand socat - VSOCK-CONNECT:%d:2222\n    IdentityFile ~/.ssh/id_ed25519\n    IdentitiesOnly yes\n    IdentityAgent %s\n    StrictHostKeyChecking accept-new\n\n",
+			def.Name, def.guestCID(), filepath.Join(os.Getenv("XDG_RUNTIME_DIR"), "phial", "agent", "ssh.sock"))
+	}
+
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return err
+	}
+
+	return os.WriteFile(path, []byte(builder.String()), 0o600)
+}
+
+func SSHCommand(host string, args ...string) *exec.Cmd {
+	base := []string{"-o", "StrictHostKeyChecking=accept-new", "-o", "ConnectTimeout=15", host}
+
+	base = append(base, args...)
+
+	return exec.Command("ssh", base...)
+}
+
+func SSHExec(host string, script string) error {
+	command := SSHCommand(host, "bash -s")
+	command.Stdin = strings.NewReader(script)
+	command.Stdout = os.Stdout
+	command.Stderr = os.Stderr
+
+	return command.Run()
+}
diff --git a/internal/virt/vfio.go b/internal/virt/vfio.go
new file mode 100644
index 0000000000000000000000000000000000000000..903a64e8735e653467ca175ad620bfa747e7ca25
--- /dev/null
+++ b/internal/virt/vfio.go
@@ -0,0 +1,136 @@
+package virt
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+func iommuGroup(address string) (string, error) {
+	link, err := os.Readlink(filepath.Join("/sys/bus/pci/devices", address, "iommu_group"))
+	if err != nil {
+		return "", fmt.Errorf("no IOMMU group for %s: %w", address, err)
+	}
+
+	return filepath.Base(link), nil
+}
+
+func groupMembers(group string) ([]string, error) {
+	entries, err := os.ReadDir(filepath.Join("/sys/kernel/iommu_groups", group, "devices"))
+	if err != nil {
+		return nil, err
+	}
+
+	var out []string
+	for _, entry := range entries {
+		out = append(out, entry.Name())
+	}
+
+	return out, nil
+}
+
+func writeSysfs(path, value string) error {
+	return os.WriteFile(path, []byte(value), 0o200)
+}
+
+func deviceDriver(device string) string {
+	link, err := os.Readlink(filepath.Join("/sys/bus/pci/devices", device, "driver"))
+	if err != nil {
+		return ""
+	}
+
+	return filepath.Base(link)
+}
+
+func VfioBind(address string) error {
+	if os.Getuid() != 0 {
+		return errors.New("vfio bind needs root, run it with run0")
+	}
+
+	group, err := iommuGroup(address)
+	if err != nil {
+		return err
+	}
+
+	members, err := groupMembers(group)
+	if err != nil {
+		return err
+	}
+
+	stateDir := filepath.Join("/run/phial-vfio", address)
+	if err := os.MkdirAll(stateDir, 0o755); err != nil {
+		return err
+	}
+
+	for _, member := range members {
+		driver := deviceDriver(member)
+
+		if err := os.WriteFile(filepath.Join(stateDir, member+".driver"), []byte(driver), 0o600); err != nil {
+			return err
+		}
+
+		if driver != "" {
+			if err := writeSysfs(filepath.Join("/sys/bus/pci/devices", member, "driver", "unbind"), member); err != nil {
+				return err
+			}
+		}
+
+		if err := writeSysfs(filepath.Join("/sys/bus/pci/devices", member, "driver_override"), "vfio-pci"); err != nil {
+			return err
+		}
+
+		if err := writeSysfs("/sys/bus/pci/drivers/vfio-pci/bind", member); err != nil {
+			return err
+		}
+
+		fmt.Printf("bound %s to vfio-pci (was: %s)\n", member, driver)
+	}
+
+	return nil
+}
+
+func VfioRestore(address string) error {
+	if os.Getuid() != 0 {
+		return errors.New("vfio restore needs root, run it with run0")
+	}
+
+	group, err := iommuGroup(address)
+	if err != nil {
+		return err
+	}
+
+	members, err := groupMembers(group)
+	if err != nil {
+		return err
+	}
+
+	stateDir := filepath.Join("/run/phial-vfio", address)
+
+	for _, member := range members {
+		data, _ := os.ReadFile(filepath.Join(stateDir, member+".driver"))
+		driver := strings.TrimSpace(string(data))
+
+		if deviceDriver(member) == "vfio-pci" {
+			if err := writeSysfs(filepath.Join("/sys/bus/pci/devices", member, "driver", "unbind"), member); err != nil {
+				return err
+			}
+		}
+
+		writeSysfs(filepath.Join("/sys/bus/pci/devices", member, "driver_override"), "")
+
+		if driver != "" {
+			target := filepath.Join("/sys/bus/pci/drivers", driver)
+			if _, err := os.Stat(target); err == nil {
+				if err := writeSysfs(filepath.Join(target, "bind"), member); err != nil {
+					return err
+				}
+
+				fmt.Printf("restored %s to %s\n", member, driver)
+			}
+		}
+	}
+
+	return os.RemoveAll(stateDir)
+}
diff --git a/internal/virt/vm.go b/internal/virt/vm.go
new file mode 100644
index 0000000000000000000000000000000000000000..79bb85aba8dc7449ddaadf29750f1b69dd1989cc
--- /dev/null
+++ b/internal/virt/vm.go
@@ -0,0 +1,233 @@
+package virt
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"hash/crc32"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+
+	"github.com/adrg/xdg"
+	"github.com/google/renameio/v2"
+)
+
+func OVMFDirValue() string {
+	for _, dir := range []string{"/app/share/edk2", "/usr/share/edk2/ovmf"} {
+		if _, err := os.Stat(dir); err == nil {
+			return dir
+		}
+	}
+
+	return "/usr/share/edk2/ovmf"
+}
+
+type Definition struct {
+	Name        string   `json:"name"`
+	VCPUs       int      `json:"vcpus"`
+	Memory      string   `json:"memory"`
+	Disk        string   `json:"disk"`
+	DiskSize    string   `json:"disk_size"`
+	Display     string   `json:"display"`
+	GPU         string   `json:"gpu"`
+	SecureBoot  bool     `json:"secure_boot"`
+	HugePages   bool     `json:"hugepages"`
+	USBDevices  []string `json:"usb_devices"`
+	USBXHCI     string   `json:"usb_xhci"`
+	NetLAN      string   `json:"net_lan"`
+	NetFallback string   `json:"net_fallback"`
+	Audio       string   `json:"audio"`
+	Shares      []string `json:"shares"`
+}
+
+func Defaults(name string) Definition {
+	return Definition{
+		Name:        name,
+		VCPUs:       0,
+		Memory:      "16G",
+		DiskSize:    "128G",
+		Display:     "egl-headless",
+		GPU:         "venus",
+		SecureBoot:  true,
+		HugePages:   true,
+		USBDevices:  []string{"0403:6001", "1a86:55d3", "345f:2131", "16c0:05df", "0b95:1790"},
+		NetLAN:      "auto",
+		NetFallback: "passt",
+		Audio:       "none",
+	}
+}
+
+func configDir() string {
+	return filepath.Join(xdg.ConfigHome, "phial")
+}
+
+func dataDir() string {
+	return filepath.Join(xdg.DataHome, "phial")
+}
+
+func runtimeDir() string {
+	base := xdg.RuntimeDir
+	if base == "" {
+		base = fmt.Sprintf("/run/user/%d", os.Getuid())
+	}
+
+	return filepath.Join(base, "phial")
+}
+
+func (d Definition) diskPath() string {
+	if d.Disk != "" {
+		return d.Disk
+	}
+
+	return filepath.Join(dataDir(), "vms", d.Name+".raw")
+}
+
+func (d Definition) runtimePath() string {
+	return filepath.Join(runtimeDir(), "vms", d.Name)
+}
+
+func (d Definition) guestCID() uint32 {
+	if d.Name == "phial" {
+		return 3
+	}
+
+	return 4 + crc32.ChecksumIEEE([]byte(d.Name))%1021
+}
+
+func Load(name string) (Definition, error) {
+	data, err := os.ReadFile(filepath.Join(configDir(), "vms", name+".json"))
+	if err != nil {
+		return Definition{}, err
+	}
+
+	def := Defaults(name)
+	if err := json.Unmarshal(data, &def); err != nil {
+		return Definition{}, err
+	}
+
+	if def.Name == "" {
+		def.Name = name
+	}
+
+	if err := def.validate(); err != nil {
+		return Definition{}, err
+	}
+
+	return def, nil
+}
+
+func (d Definition) validate() error {
+	if !strings.HasPrefix(d.Name, "phial-") && d.Name != "phial" && !namePattern.MatchString(d.Name) {
+		return errors.New("the name must be a valid variable name or start with phial-")
+	}
+
+	switch d.Display {
+	case "egl-headless", "gtk", "none":
+	default:
+		return fmt.Errorf("unknown display mode %q", d.Display)
+	}
+
+	switch d.GPU {
+	case "venus", "virgl", "none":
+	default:
+		return fmt.Errorf("unknown GPU mode %q", d.GPU)
+	}
+
+	switch d.NetLAN {
+	case "auto", "on", "off":
+	default:
+		return fmt.Errorf("unknown LAN mode %q", d.NetLAN)
+	}
+
+	switch d.NetFallback {
+	case "passt", "stream", "off":
+	default:
+		return fmt.Errorf("unknown fallback mode %q", d.NetFallback)
+	}
+
+	switch d.Audio {
+	case "none", "hda":
+	default:
+		return fmt.Errorf("unknown audio mode %q", d.Audio)
+	}
+
+	for _, device := range d.USBDevices {
+		vendor, product, ok := strings.Cut(device, ":")
+		if !ok || !isHex4(vendor) || !isHex4(product) {
+			return fmt.Errorf("usb device %q must be vendor:product in hex", device)
+		}
+	}
+
+	return nil
+}
+
+var namePattern = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_-]*$`)
+
+func isHex4(text string) bool {
+	if len(text) != 4 {
+		return false
+	}
+
+	for _, r := range text {
+		if !((r >= '0' && r <= '9') || (r >= 'a' && r <= 'f') || (r >= 'A' && r <= 'F')) {
+			return false
+		}
+	}
+
+	return true
+}
+
+func (d Definition) Save() error {
+	if err := d.validate(); err != nil {
+		return err
+	}
+
+	dir := filepath.Join(configDir(), "vms")
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		return err
+	}
+
+	data, err := json.MarshalIndent(d, "", "  ")
+	if err != nil {
+		return err
+	}
+
+	return renameio.WriteFile(filepath.Join(dir, d.Name+".json"), append(data, '\n'), 0o600, renameio.WithStaticPermissions(0o600))
+}
+
+func List() ([]Definition, error) {
+	dir := filepath.Join(configDir(), "vms")
+
+	var out []Definition
+
+	err := filepath.WalkDir(dir, func(path string, entry fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+
+		if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".json") {
+			return nil
+		}
+
+		def, err := Load(strings.TrimSuffix(entry.Name(), ".json"))
+		if err != nil {
+			return nil
+		}
+
+		out = append(out, def)
+
+		return nil
+	})
+	if errors.Is(err, fs.ErrNotExist) {
+		return nil, nil
+	}
+
+	return out, err
+}
+
+func (d Definition) Delete() error {
+	return os.Remove(filepath.Join(configDir(), "vms", d.Name+".json"))
+}
diff --git a/main.go b/main.go
new file mode 100644
index 0000000000000000000000000000000000000000..296f773a3335474042a34c98fa28bae5a4a805f6
--- /dev/null
+++ b/main.go
@@ -0,0 +1,243 @@
+package main
+
+import (
+	"context"
+	"fmt"
+	"log/slog"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+
+	"codeberg.org/pojntfx/phial/internal/components"
+	"codeberg.org/pojntfx/phial/internal/setup"
+	"codeberg.org/pojntfx/phial/internal/state"
+	"codeberg.org/pojntfx/phial/internal/virt"
+)
+
+const usage = `phial: virtual machines, secrets, and agents under host control
+
+Usage:
+  phial                     open the window (also serves the agent channel)
+  phial --background        start in the background, for autostart
+  phial vm exec <name>      run one virtual machine in the foreground
+  phial vfio <bind|restore> <address>  bind or restore a PCI controller
+  phial root-setup <ethernet> <memory> apply the system setup, needs run0
+  phial install <repo>      install the binary and the configuration
+  phial acceptance          run the host acceptance checks
+  phial forward-guest <name> forward one socket to the host, guest side
+  phial run <command...>    run a command with the granted secrets, guest side
+  phial sync                sync the secrets
+  phial allow [--for <duration>] [--kind <kind>] <name>
+  phial revoke <name>
+  phial status              show the grant status
+  phial ls                  list the secret names, never the values
+`
+
+func main() {
+	log := slog.New(slog.NewTextHandler(os.Stderr, &slog.HandlerOptions{Level: slog.LevelInfo}))
+
+	args := os.Args[1:]
+
+	if len(args) == 0 {
+		os.Exit(runApp(log, true))
+	}
+
+	switch args[0] {
+	case "--background", "-background":
+		os.Exit(runApp(log, false))
+	case "--help", "-help", "-h", "help":
+		fmt.Print(usage)
+	case "vm":
+		fail(runVM(args[1:]))
+	case "vfio":
+		fail(runVfio(args[1:]))
+	case "root-setup":
+		fail(runRootSetup(args[1:]))
+	case "install":
+		fail(runInstall(args[1:]))
+	case "acceptance":
+		os.Exit(setup.PrintAcceptance(setup.Acceptance()))
+	case "forward-guest":
+		fail(runForwardGuest(args[1:]))
+	case "run":
+		client := state.NewClient(log)
+		fail(client.Run(args[1:]))
+	case "sync":
+		client := state.NewClient(log)
+		fail(client.Sync())
+	case "allow":
+		client := state.NewClient(log)
+		fail(client.Allow(args[1:]))
+	case "revoke":
+		client := state.NewClient(log)
+		fail(client.Revoke(args[1:]))
+	case "status":
+		client := state.NewClient(log)
+		fail(client.Status())
+	case "ls":
+		client := state.NewClient(log)
+		fail(client.Ls())
+	default:
+		fmt.Fprintln(os.Stderr, "unknown command: "+args[0])
+		fmt.Fprint(os.Stderr, usage)
+		os.Exit(1)
+	}
+}
+
+func fail(err error) {
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func runApp(log *slog.Logger, showWindow bool) int {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	return components.Run(ctx, log, loadKickstart(), showWindow)
+}
+
+func loadKickstart() []byte {
+	candidates := []string{}
+
+	if value := os.Getenv("PHIAL_KICKSTART"); value != "" {
+		candidates = append(candidates, value)
+	}
+
+	if self, err := os.Executable(); err == nil {
+		candidates = append(candidates,
+			filepath.Join(filepath.Dir(self), "..", "guest", "phial.ks"),
+			filepath.Join(filepath.Dir(self), "phial.ks"),
+		)
+	}
+
+	candidates = append(candidates,
+		"/app/share/phial/phial.ks",
+		"/usr/share/phial/phial.ks",
+	)
+
+	for _, candidate := range candidates {
+		data, err := os.ReadFile(candidate)
+		if err == nil {
+			return data
+		}
+	}
+
+	return nil
+}
+
+func runVM(args []string) error {
+	if len(args) < 2 || args[0] != "exec" {
+		return fmt.Errorf("usage: phial vm exec <name>")
+	}
+
+	def, err := virt.Load(args[1])
+	if err != nil {
+		return err
+	}
+
+	return def.RunExec(virt.BootConfig{})
+}
+
+func runVfio(args []string) error {
+	if len(args) < 2 {
+		return fmt.Errorf("usage: phial vfio <bind|restore> <address>")
+	}
+
+	switch args[0] {
+	case "bind":
+		return virt.VfioBind(args[1])
+	case "restore":
+		return virt.VfioRestore(args[1])
+	default:
+		return fmt.Errorf("usage: phial vfio <bind|restore> <address>")
+	}
+}
+
+func runRootSetup(args []string) error {
+	ethernet := ""
+	if len(args) > 0 {
+		ethernet = args[0]
+	}
+
+	memory := ""
+	if len(args) > 1 {
+		memory = args[1]
+	}
+
+	return setup.RootSetup(setup.RootSetupOptions{
+		Memory:     memory,
+		USBDevices: virt.Defaults("phial").USBDevices,
+		Ethernet:   ethernet,
+	})
+}
+
+func runInstall(args []string) error {
+	repo := ""
+	if len(args) > 0 {
+		repo = args[0]
+	} else if self, err := os.Executable(); err == nil {
+		repo = filepath.Dir(filepath.Dir(self))
+	}
+
+	return setup.Install(setup.InstallOptions{RepoDir: repo})
+}
+
+func runForwardGuest(args []string) error {
+	if len(args) < 1 {
+		return fmt.Errorf("usage: phial forward-guest <name>")
+	}
+
+	name := args[0]
+	kind := os.Getenv("PHIAL_KIND")
+	port := os.Getenv("PHIAL_PORT")
+
+	binary, err := exec.LookPath("socat")
+	if err != nil {
+		return err
+	}
+
+	vsock := "VSOCK:2:" + port
+
+	var command *exec.Cmd
+
+	switch kind {
+	case "tcp":
+		command = exec.Command(binary, "TCP6-LISTEN:"+port+",fork,bind=[::1],reuseaddr", vsock)
+	case "unix":
+		socket := os.Getenv("PHIAL_SOCKET")
+
+		target := socket
+		if strings.HasPrefix(target, "~/") {
+			home, err := os.UserHomeDir()
+			if err != nil {
+				return err
+			}
+
+			target = filepath.Join(home, target[2:])
+		} else if !strings.HasPrefix(target, "/") {
+			configHome := os.Getenv("XDG_CONFIG_HOME")
+			if configHome == "" {
+				home, err := os.UserHomeDir()
+				if err != nil {
+					return err
+				}
+
+				configHome = filepath.Join(home, ".config")
+			}
+
+			target = filepath.Join(configHome, "phial", target)
+		}
+
+		command = exec.Command(binary, "UNIX-LISTEN:"+target+",fork,unlink-early", vsock)
+	default:
+		return fmt.Errorf("unknown PHIAL_KIND %q for %s", kind, name)
+	}
+
+	command.Stdout = os.Stdout
+	command.Stderr = os.Stderr
+
+	return command.Run()
+}
