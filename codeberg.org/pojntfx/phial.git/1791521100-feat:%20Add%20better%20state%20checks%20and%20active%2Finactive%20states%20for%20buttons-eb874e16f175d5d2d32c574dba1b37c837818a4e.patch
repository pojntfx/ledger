+
+func (a *App) registerActions() {
+	aboutAction := gio.NewSimpleAction("about", nil)
+	quitAction := gio.NewSimpleAction("quit", nil)
+	shortcutsAction := gio.NewSimpleAction("shortcuts", nil)
+	settingsAction := gio.NewSimpleAction("settings", nil)
+	a.app.AddAction(aboutAction)
+	a.app.AddAction(quitAction)
+	a.app.AddAction(shortcutsAction)
+	a.app.AddAction(settingsAction)
+	a.app.SetAccelsForAction("app.quit", []string{"<Primary>q"})
+	a.app.SetAccelsForAction("app.shortcuts", []string{"<Primary>question"})
+
+	var onAbout func(gio.SimpleAction, uintptr)
+	onAbout = func(gio.SimpleAction, uintptr) { a.showAbout() }
+	aboutAction.ConnectActivate(&onAbout)
+	a.hold(&onAbout)
+
+	var onQuit func(gio.SimpleAction, uintptr)
+	onQuit = func(gio.SimpleAction, uintptr) { a.confirmQuit() }
+	quitAction.ConnectActivate(&onQuit)
+	a.hold(&onQuit)
+
+	var onShortcuts func(gio.SimpleAction, uintptr)
+	onShortcuts = func(gio.SimpleAction, uintptr) { a.showShortcuts() }
+	shortcutsAction.ConnectActivate(&onShortcuts)
+	a.hold(&onShortcuts)
+
+	var onSettings func(gio.SimpleAction, uintptr)
+	onSettings = func(gio.SimpleAction, uintptr) { a.showSettings() }
+	settingsAction.ConnectActivate(&onSettings)
+	a.hold(&onSettings)
+
+	for i, p := range pageDefs {
+		action := gio.NewSimpleAction("page-"+p.name, nil)
+		a.app.AddAction(action)
+
+		name := p.name
+		var cb func(gio.SimpleAction, uintptr)
+		cb = func(gio.SimpleAction, uintptr) { a.showPage(name) }
+		action.ConnectActivate(&cb)
+		a.hold(&cb)
+
+		a.app.SetAccelsForAction("app.page-"+name, []string{fmt.Sprintf("<Primary>%d", i+1)})
+	}
+
+	newVMAction := gio.NewSimpleAction("new-vm", nil)
+	a.app.AddAction(newVMAction)
+	a.app.SetAccelsForAction("app.new-vm", []string{"<Primary>n"})
+
+	var onNewVM func(gio.SimpleAction, uintptr)
+	onNewVM = func(gio.SimpleAction, uintptr) { a.showNewVMDialog() }
+	newVMAction.ConnectActivate(&onNewVM)
+	a.hold(&onNewVM)
+
+	openVMAction := gio.NewSimpleAction("open-vm", glib.NewVariantType("s"))
+	a.app.AddAction(openVMAction)
+
+	var onOpenVM func(gio.SimpleAction, uintptr)
+	onOpenVM = func(_ gio.SimpleAction, parameter uintptr) {
+		if parameter == 0 {
+			return
+		}
+		variant := (*glib.Variant)(unsafe.Pointer(parameter))
+		name := variant.GetString(nil)
+		def, err := virt.Load(name)
+		if err != nil {
+			return
+		}
+		a.openVMDetail(def)
+	}
+	openVMAction.ConnectActivate(&onOpenVM)
+	a.hold(&onOpenVM)
+
+	copyErrorAction := gio.NewSimpleAction("copy-error", glib.NewVariantType("s"))
+	a.app.AddAction(copyErrorAction)
+
+	var onCopyError func(gio.SimpleAction, uintptr)
+	onCopyError = func(_ gio.SimpleAction, parameter uintptr) {
+		if parameter == 0 {
+			return
+		}
+		variant := (*glib.Variant)(unsafe.Pointer(parameter))
+		text := variant.GetString(nil)
+		if a.window != nil {
+			if display := a.window.Widget.GetDisplay(); display != nil {
+				display.GetClipboard().SetText(text)
+			}
+		}
+	}
+	copyErrorAction.ConnectActivate(&onCopyError)
+	a.hold(&onCopyError)
+
+	resizeAction := gio.NewSimpleAction("resize", glib.NewVariantType("i"))
+	a.app.AddAction(resizeAction)
+
+	var onResize func(gio.SimpleAction, uintptr)
+	onResize = func(_ gio.SimpleAction, parameter uintptr) {
+		if parameter == 0 {
+			return
+		}
+		variant := (*glib.Variant)(unsafe.Pointer(parameter))
+		width := variant.GetInt32()
+		if a.window != nil {
+			a.window.SetDefaultSize(width, 640)
+			a.window.SetSizeRequest(width, 640)
+		}
+	}
+	resizeAction.ConnectActivate(&onResize)
+	a.hold(&onResize)
+
+	captureAction := gio.NewSimpleAction("capture", glib.NewVariantType("s"))
+	a.app.AddAction(captureAction)
+
+	var onCapture func(gio.SimpleAction, uintptr)
+	onCapture = func(_ gio.SimpleAction, parameter uintptr) {
