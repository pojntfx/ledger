+	general := adw.NewShortcutsSection(i18n.L("General"))
+	general.Add(adw.NewShortcutsItem(i18n.L("Show keyboard shortcuts"), "<Primary>question"))
+	general.Add(adw.NewShortcutsItem(i18n.L("Preferences"), "<Primary>comma"))
+	general.Add(adw.NewShortcutsItem(i18n.L("Quit"), "<Primary>q"))
+	dialog.Add(general)
+
+	navigation := adw.NewShortcutsSection(i18n.L("Navigation"))
+	navigation.Add(adw.NewShortcutsItem(i18n.L("Machines"), "<Primary>1"))
+	navigation.Add(adw.NewShortcutsItem(i18n.L("Secrets"), "<Primary>2"))
+	navigation.Add(adw.NewShortcutsItem(i18n.L("Requests"), "<Primary>3"))
+	dialog.Add(navigation)
+
+	actions := adw.NewShortcutsSection(i18n.L("Actions"))
+	actions.Add(adw.NewShortcutsItem(i18n.L("New machine"), "<Primary>n"))
