+func formPage(rows ...*gtk.Widget) *gtk.Widget {
+	group := adw.NewPreferencesGroup()
+	for _, row := range rows {
+		group.Add(row)
+	}
+
+	page := adw.NewPreferencesPage()
+	page.Add(group)
+
+	scrolled := gtk.NewScrolledWindow()
+	scrolled.SetChild(&page.Widget)
+
+	return &scrolled.Widget
+}
+
+func (a *App) statusPage(icon, title, description string, actionLabel string, action func()) *gtk.Widget {
+	page := adw.NewStatusPage()
+	page.SetIconName(icon)
+	page.SetTitle(title)
+	page.SetDescription(description)
+
+	if actionLabel != "" {
+		btn := a.mnemonicButton(actionLabel, action)
+		btn.AddCssClass("suggested-action")
+		btn.AddCssClass("pill")
+		btn.SetHalign(gtk.AlignCenterValue)
+		page.SetChild(&btn.Widget)
+	}
+
+	return &page.Widget
+}
+
+func (a *App) confirmDialog(heading, body, label string, fn func()) {
+	dialog := adw.NewAlertDialog(heading, body)
+	dialog.AddResponse("cancel", i18n.L("_Cancel"))
+	dialog.AddResponse("confirm", label)
+	dialog.SetResponseAppearance("confirm", adw.ResponseDestructiveValue)
+	dialog.SetCloseResponse("cancel")
+
+	var cb func(adw.AlertDialog, string)
+	cb = func(_ adw.AlertDialog, response string) {
+		if response == "confirm" {
+			fn()
+		}
+	}
+	dialog.ConnectResponse(&cb)
+	a.hold(&cb)
+
+	dialog.Present(&a.window.Widget)
+}
+
+func (a *App) errorDialog(heading, detail string) {
+	dialog := adw.NewAlertDialog(heading, detail)
+	dialog.AddResponse("copy", i18n.L("_Copy Error"))
+	dialog.AddResponse("close", i18n.L("_Close"))
+	dialog.SetDefaultResponse("close")
+	dialog.SetCloseResponse("close")
+
+	var cb func(adw.AlertDialog, string)
+	cb = func(_ adw.AlertDialog, response string) {
+		_ = response
+	}
+	dialog.ConnectResponse(&cb)
+	a.hold(&cb)
+
+	dialog.Present(&a.window.Widget)
+}
+
+func (a *App) modalDialog(heading, label string, body *gtk.Widget, onApply func() bool) {
+	dialog := adw.NewDialog()
+	dialog.SetTitle(heading)
+	dialog.SetContentWidth(400)
+	dialog.SetContentHeight(420)
+
+	toolbar := adw.NewToolbarView()
+
+	header := adw.NewHeaderBar()
+	header.SetShowStartTitleButtons(false)
+	header.SetShowEndTitleButtons(false)
+
+	cancel := a.mnemonicButton(i18n.L("_Cancel"), func() { dialog.Close() })
+	header.PackStart(&cancel.Widget)
+
+	apply := a.mnemonicButton(label, func() {
+		if onApply() {
+			dialog.Close()
+		}
+	})
+	apply.AddCssClass("suggested-action")
+	header.PackEnd(&apply.Widget)
+
+	toolbar.AddTopBar(&header.Widget)
+	toolbar.SetContent(body)
+
+	dialog.SetChild(&toolbar.Widget)
+	dialog.Present(&a.window.Widget)
+}
+
+func pageWithHeader(title string, content *gtk.Widget) *gtk.Widget {
+	toolbar := adw.NewToolbarView()
+
+	header := adw.NewHeaderBar()
+	titleWidget := adw.NewWindowTitle(title, "")
+	header.SetTitleWidget(&titleWidget.Widget)
+
+	toolbar.AddTopBar(&header.Widget)
+	toolbar.SetContent(content)
+
+	return &toolbar.Widget
+}
+
+func humanBytes(value int64) string {
+	const unit = 1024.0
+	if value < int64(unit) {
+		return fmt.Sprintf("%d B", value)
+	}
+
+	divisor, exponent := unit, 0
+	for value/int64(divisor) >= int64(unit) && exponent < 4 {
+		divisor *= unit
+		exponent++
+	}
+
+	return fmt.Sprintf("%.1f %ciB", float64(value)/divisor, "KMGTP"[exponent])
+}
+
+func shortVendor(name string) string {
+	for _, suffix := range []string{" Corporation", " Inc.", " Ltd", " GmbH", " Corp."} {
+		name = strings.TrimSuffix(name, suffix)
+	}
+
+	return name
+}
