+
+func (a *App) showSettings() {
+	dialog := adw.NewPreferencesDialog()
+	dialog.SetTitle(i18n.L("Preferences"))
+
+	page := adw.NewPreferencesPage()
+	page.SetTitle(i18n.L("System"))
+	page.SetIconName("preferences-system-symbolic")
+	dialog.Add(page)
+
+	status := adw.NewPreferencesGroup()
+	status.SetTitle(i18n.L("Status"))
+
+	_, output, err := a.Service.SystemStatus(a.Ctx, nil, struct{}{})
+	if err == nil {
+		for _, item := range output.Items {
+			status.Add(&a.textRow(item.Name, item.Value).Widget)
+		}
+	}
+	page.Add(status)
+
+	actions := adw.NewPreferencesGroup()
+	actions.SetTitle(i18n.L("Actions"))
+
+	actions.Add(&a.buttonRow(i18n.L("_Apply System Setup"), "system-run-symbolic", func() {
+		a.showSetupDialog()
+	}).Widget)
+
+	page.Add(actions)
+
+	dialog.Present(&a.window.Widget)
+}
+
+func (a *App) confirmQuit() {
+	defs, _ := virt.List()
+
+	var running []virt.Definition
+
+	for _, def := range defs {
+		if active, _ := def.Active(); active {
+			running = append(running, def)
+		}
+	}
+
+	if len(running) == 0 {
+		a.app.Quit()
+		return
+	}
+
+	names := ""
+
+	for index, def := range running {
+		if index > 0 {
+			names += ", "
+		}
+		names += def.Name
+	}
+
+	a.confirmDialog(
+		i18n.L("Shutdown and quit?"),
+		fmt.Sprintf(i18n.L("This stops %s. Close the window instead to keep Phial running in the background."), names),
+		i18n.L("_Shutdown and Quit"),
+		func() {
+			a.goAsync(func() (string, error) {
+				for _, def := range running {
+					if err := def.Stop(); err != nil {
+						return "", err
+					}
+				}
+
+				a.idle(func() { a.app.Quit() })
+
+				return "", nil
+			})
+		},
+	)
+}
