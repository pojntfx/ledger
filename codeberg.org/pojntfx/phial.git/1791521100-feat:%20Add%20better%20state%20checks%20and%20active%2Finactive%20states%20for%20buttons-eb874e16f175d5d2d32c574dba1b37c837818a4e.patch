index 0000000000000000000000000000000000000000..f7533fb0768bcffc89713c2a2664add81cfb8f18
--- /dev/null
+++ b/internal/mcp/approvals.go
@@ -0,0 +1,94 @@
+package mcp
+
+import (
+	"errors"
+	"fmt"
+	"sync"
+	"time"
+)
+
+const approvalTTL = 5 * time.Minute
+
+type Approval struct {
+	ID      string    `json:"id"`
+	Action  string    `json:"action"`
+	Detail  string    `json:"detail"`
+	Created time.Time `json:"created"`
+
+	execute func() error
+}
+
+type Approvals struct {
+	mu      sync.Mutex
+	pending map[string]Approval
+	nextID  int
+	notify  func(summary, body string)
+}
+
+func NewApprovals(notify func(summary, body string)) *Approvals {
+	return &Approvals{
+		pending: map[string]Approval{},
+		notify:  notify,
+	}
+}
+
+func (a *Approvals) Create(action, detail string, execute func() error) (string, error) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+
+	a.nextID++
+	id := fmt.Sprintf("req-%d", a.nextID)
+
+	a.pending[id] = Approval{
+		ID:      id,
+		Action:  action,
+		Detail:  detail,
+		Created: time.Now(),
+		execute: execute,
+	}
+
+	if a.notify != nil {
+		a.notify("phial agent request", fmt.Sprintf("%s: %s", action, detail))
+	}
+
+	return id, nil
+}
+
+func (a *Approvals) List() []Approval {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+
+	var out []Approval
+
+	for id, approval := range a.pending {
+		if time.Since(approval.Created) > approvalTTL {
+			delete(a.pending, id)
+
+			continue
+		}
+
+		out = append(out, approval)
+	}
+
+	return out
+}
+
+func (a *Approvals) Answer(id string, approve bool) error {
+	a.mu.Lock()
+
+	approval, ok := a.pending[id]
+	if !ok {
+		a.mu.Unlock()
+
+		return errors.New("no pending request with that id")
+	}
+
+	delete(a.pending, id)
+	a.mu.Unlock()
+
+	if !approve {
+		return nil
+	}
+
+	return approval.execute()
+}
diff --git a/internal/mcp/register.go b/internal/mcp/register.go
new file mode 100644
index 0000000000000000000000000000000000000000..34e12c825a104f73367b7b2f1237cb866b771341
--- /dev/null
+++ b/internal/mcp/register.go
@@ -0,0 +1,212 @@
+package mcp
+
+import (
+	"context"
+	"fmt"
+
+	mcpgo "github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+func (s *Service) registerTools(server *mcpgo.Server, guest bool) {
+	mcpgo.AddTool(server, SecretsLsTool, s.SecretsLs)
+	mcpgo.AddTool(server, GrantStatusTool, s.GrantStatus)
+	mcpgo.AddTool(server, GrantRevokeTool, s.GrantRevoke)
+	mcpgo.AddTool(server, VmLsTool, s.VmLs)
+	mcpgo.AddTool(server, VmStartTool, s.VmStart)
+	mcpgo.AddTool(server, VmUpdateTool, s.VmUpdate)
+	mcpgo.AddTool(server, VmStopTool, s.VmStop)
+	mcpgo.AddTool(server, VmRestartTool, s.VmRestart)
+	mcpgo.AddTool(server, ForwardLsTool, s.ForwardLs)
+	mcpgo.AddTool(server, ForwardStopTool, s.ForwardStop)
+	mcpgo.AddTool(server, UsbLsTool, s.UsbLs)
+	mcpgo.AddTool(server, UsbNamesTool, s.UsbNames)
+	mcpgo.AddTool(server, ShareLsTool, s.ShareLs)
+	mcpgo.AddTool(server, ShareAddTool, s.ShareAdd)
+	mcpgo.AddTool(server, ShareRemoveTool, s.ShareRemove)
+	mcpgo.AddTool(server, ListXhciTool, s.ListXhci)
+	mcpgo.AddTool(server, DisplaySetModeTool, s.DisplaySetMode)
+	mcpgo.AddTool(server, DisplayRunAppTool, s.DisplayRunApp)
+	mcpgo.AddTool(server, ListGuestAppsTool, s.ListGuestApps)
+	mcpgo.AddTool(server, DisplayOpenRdpTool, s.DisplayOpenRdp)
+	mcpgo.AddTool(server, DisplayOpenSerialTool, s.DisplayOpenSerial)
+	mcpgo.AddTool(server, SystemStatusTool, s.SystemStatus)
+	mcpgo.AddTool(server, SystemAcceptanceTool, s.SystemAcceptance)
+
+	if !guest {
+		mcpgo.AddTool(server, ApprovalsListTool, s.ApprovalsList)
+		mcpgo.AddTool(server, ApprovalsAnswerTool, s.ApprovalsAnswer)
+	}
+
+	mcpgo.AddTool(server, SecretsRequestGrantTool, s.SecretsRequestGrant)
+
+	gate := func(action string, run func() (any, error)) (any, error) {
+		if !guest {
+			return run()
+		}
+
+		id, err := s.approvals.Create(action, action, func() error {
+			_, err := run()
+
+			return err
+		})
+		if err != nil {
+			return nil, err
+		}
+
+		return map[string]string{"approval": id, "state": "pending"}, nil
+	}
+
+	mcpgo.AddTool(server, SecretsSyncTool, func(ctx context.Context, req *mcpgo.CallToolRequest, input struct{}) (*mcpgo.CallToolResult, any, error) {
+		out, err := gate("secrets.sync", func() (any, error) {
+			_, out, err := s.SecretsSync(ctx, req, input)
+
+			return out, err
+		})
+
+		return nil, out, err
+	})
+
+	mcpgo.AddTool(server, SecretsAddProviderTool, func(ctx context.Context, req *mcpgo.CallToolRequest, input ProviderInput) (*mcpgo.CallToolResult, any, error) {
+		out, err := gate("secrets.addProvider "+input.Name, func() (any, error) {
+			_, out, err := s.SecretsAddProvider(ctx, req, input)
+
+			return out, err
+		})
+
+		return nil, out, err
+	})
+
+	mcpgo.AddTool(server, SecretsRemoveProviderTool, func(ctx context.Context, req *mcpgo.CallToolRequest, input NameInput) (*mcpgo.CallToolResult, any, error) {
+		out, err := gate("secrets.removeProvider "+input.Name, func() (any, error) {
+			_, out, err := s.SecretsRemoveProvider(ctx, req, input)
+
+			return out, err
+		})
+
+		return nil, out, err
+	})
+
+	mcpgo.AddTool(server, GrantAllowTool, func(ctx context.Context, req *mcpgo.CallToolRequest, input GrantInput) (*mcpgo.CallToolResult, any, error) {
+		out, err := gate(fmt.Sprintf("grant %s (%s) for %s", input.Name, input.Kind, input.Duration), func() (any, error) {
+			_, out, err := s.GrantAllow(ctx, req, input)
+
+			return out, err
+		})
+
+		return nil, out, err
+	})
+
+	mcpgo.AddTool(server, ForwardStartTool, func(ctx context.Context, req *mcpgo.CallToolRequest, input NameInput) (*mcpgo.CallToolResult, any, error) {
+		out, err := gate("forward.start "+input.Name, func() (any, error) {
+			_, out, err := s.ForwardStart(ctx, req, input)
+
+			return out, err
+		})
+
+		return nil, out, err
+	})
+
+	mcpgo.AddTool(server, ForwardAddTool, func(ctx context.Context, req *mcpgo.CallToolRequest, input ForwardInput) (*mcpgo.CallToolResult, any, error) {
+		out, err := gate("forward.add "+input.Name, func() (any, error) {
+			_, out, err := s.ForwardAdd(ctx, req, input)
+
+			return out, err
+		})
+
+		return nil, out, err
+	})
+
+	mcpgo.AddTool(server, ForwardRemoveTool, func(ctx context.Context, req *mcpgo.CallToolRequest, input NameInput) (*mcpgo.CallToolResult, any, error) {
+		out, err := gate("forward.remove "+input.Name, func() (any, error) {
