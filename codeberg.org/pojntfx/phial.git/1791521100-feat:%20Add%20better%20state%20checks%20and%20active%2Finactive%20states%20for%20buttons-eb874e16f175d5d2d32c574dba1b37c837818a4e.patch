+)
+
+type pageDef struct {
+	name  string
+	title string
+	icon  string
+	build func() *gtk.Widget
+}
+
+var pageDefs = []pageDef{
+	{"machines", "", "drive-harddisk-symbolic", nil},
+	{"secrets", "", "dialog-password-symbolic", nil},
+	{"requests", "", "mail-send-receive-symbolic", nil},
+}
+
+func (a *App) buildWindow(show bool) {
+	pageDefs[0].title = i18n.L("Machines")
+	pageDefs[0].build = a.buildVMsPage
+	pageDefs[1].title = i18n.L("Secrets")
+	pageDefs[1].build = a.buildSecretsPage
+	pageDefs[2].title = i18n.L("Requests")
+	pageDefs[2].build = a.buildRequestsPage
+
+	a.window = adw.NewApplicationWindow(&a.app.Application)
+	a.window.SetTitle("Phial")
+	a.window.SetDefaultSize(960, 640)
+
+	toasts := adw.NewToastOverlay()
+	a.toasts = toasts
+
+	homePage := a.buildHomePage()
+
+	toasts.SetChild(&homePage.Widget)
+	a.window.SetContent(&toasts.Widget)
+
+	cond := adw.NewBreakpointConditionLength(adw.BreakpointConditionMaxWidthValue, 500, adw.LengthUnitSpValue)
+	bp := adw.NewBreakpoint(cond)
+
+	var onApply func(adw.Breakpoint)
+	onApply = func(adw.Breakpoint) {
+		if a.split != nil {
+			a.split.SetCollapsed(true)
+		}
+	}
+	bp.ConnectApply(&onApply)
+	a.hold(&onApply)
+
+	var onUnapply func(adw.Breakpoint)
+	onUnapply = func(adw.Breakpoint) {
+		if a.split != nil {
+			a.split.SetCollapsed(false)
+		}
+	}
+	bp.ConnectUnapply(&onUnapply)
+	a.hold(&onUnapply)
+
+	a.window.AddBreakpoint(bp)
+
+	a.registerActions()
+
+	a.every(2, func() bool {
+		a.refreshBanner()
+		return true
+	})
+
+	if show {
+		a.window.Present()
+	}
