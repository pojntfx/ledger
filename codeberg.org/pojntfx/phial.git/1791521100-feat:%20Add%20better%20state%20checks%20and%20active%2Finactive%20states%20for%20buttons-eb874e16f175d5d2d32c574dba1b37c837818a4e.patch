diff --git a/internal/mcp/server.go b/internal/mcp/server.go
new file mode 100644
index 0000000000000000000000000000000000000000..0ca006c61943526be51b6adf1ce1782467d87f71
--- /dev/null
+++ b/internal/mcp/server.go
@@ -0,0 +1,114 @@
+package mcp
+
+import (
+	"context"
+	"errors"
+	"log/slog"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+
+	mcpgo "github.com/modelcontextprotocol/go-sdk/mcp"
+
+	"codeberg.org/pojntfx/phial/internal/state"
+)
+
+const (
+	HostSocketName  = "mcp.sock"
+	GuestSocketName = "mcp-guest.sock"
+)
+
+type Service struct {
+	ctx       context.Context
+	log       *slog.Logger
+	state     *state.Client
+	approvals *Approvals
+	installs  map[string]bool
+	kickstart []byte
+	notify    func(summary, body string)
+}
+
+func NewService(ctx context.Context, log *slog.Logger, client *state.Client, kickstart []byte, notify func(summary, body string)) *Service {
+	return &Service{
+		ctx:       ctx,
+		log:       log,
+		state:     client,
+		approvals: NewApprovals(notify),
+		installs:  map[string]bool{},
+		kickstart: kickstart,
+		notify:    notify,
+	}
+}
+
+func (s *Service) Serve(socketPath string, guest bool) error {
+	if err := os.MkdirAll(filepath.Dir(socketPath), 0o700); err != nil {
+		return err
+	}
+
+	if err := os.Remove(socketPath); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+
+	listener, err := net.Listen("unix", socketPath)
+	if err != nil {
+		return err
+	}
+
+	server := mcpgo.NewServer(
+		&mcpgo.Implementation{
+			Name:        "phial",
+			Title:       "Phial",
+			Description: "Virtual machines, secrets, and agents under host control.",
+			Version:     "1.0.0",
+			WebsiteURL:  "https://codeberg.org/pojntfx/phial",
+		},
+		&mcpgo.ServerOptions{
+			Logger: s.log,
+		},
+	)
+
+	s.registerTools(server, guest)
+
+	handler := mcpgo.NewStreamableHTTPHandler(
+		func(r *http.Request) *mcpgo.Server {
+			return server
+		},
+		nil,
+	)
+
+	s.log.Info("serving MCP", "socket", socketPath, "guest", guest)
+
+	return http.Serve(listener, handler)
+}
+
+func (s *Service) Run(runtimeDir string) error {
+	errChan := make(chan error, 2)
+
+	go func() {
+		errChan <- s.Serve(filepath.Join(runtimeDir, "phial", HostSocketName), false)
+	}()
+
+	go func() {
+		errChan <- s.Serve(filepath.Join(runtimeDir, "phial", GuestSocketName), true)
+	}()
+
+	select {
+	case err := <-errChan:
+		return err
+	case <-s.ctx.Done():
+		return nil
+	}
+}
+
+func (s *Service) Pending() []Approval {
+	return s.approvals.List()
+}
+
+func (s *Service) Answer(id string, approve bool) error {
+	return s.approvals.Answer(id, approve)
+}
+
+func (s *Service) Installing(name string) bool {
+	return s.installs[name]
+}
