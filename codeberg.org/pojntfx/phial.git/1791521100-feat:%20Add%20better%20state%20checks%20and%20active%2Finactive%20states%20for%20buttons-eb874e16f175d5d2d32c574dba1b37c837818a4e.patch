+func (a *App) buildRequestsPage() *gtk.Widget {
+	scrolled := gtk.NewScrolledWindow()
+	scrolled.SetHexpand(true)
+	scrolled.SetVexpand(true)
+
+	a.pages["requests"] = scrolled
+	a.refreshRequests(scrolled)
+
+	a.every(2, func() bool {
+		a.refreshRequests(scrolled)
+		return true
+	})
+
+	return pageWithHeader(i18n.L("Requests"), &scrolled.Widget)
+}
+
+func (a *App) refreshRequests(scrolled *gtk.ScrolledWindow) {
+	pending := a.Service.Pending()
+
+	signature := ""
+
+	for _, req := range pending {
+		signature += fmt.Sprintf("%s:%d;", req.ID, int64(time.Since(req.Created).Seconds())/15)
+	}
+
+	if signature == a.requestsSignature {
+		return
+	}
+	a.requestsSignature = signature
+
+	if len(pending) == 0 {
+		scrolled.SetChild(a.statusPage(
+			"mail-mark-important-symbolic",
+			i18n.L("No Pending Requests"),
+			i18n.L("Requests from virtual machines and agents appear here for approval."),
+			"", nil,
+		))
+		return
+	}
+
+	page := adw.NewPreferencesPage()
+	group := adw.NewPreferencesGroup()
+
+	for _, req := range pending {
+		req := req
+		age := time.Since(req.Created).Round(time.Second)
+		subtitle := fmt.Sprintf("%s · %s ago", req.Detail, age)
+
+		row := a.actionRow(req.Action, subtitle, nil)
+
+		deny := a.iconButton("window-close-symbolic", i18n.L("Deny"), func() {
+			a.answerRequest(req.ID, false, scrolled)
+		})
+		deny.AddCssClass("destructive-action")
+
+		approve := a.iconButton("object-select-symbolic", i18n.L("Approve"), func() {
+			a.answerRequest(req.ID, true, scrolled)
+		})
+		approve.AddCssClass("suggested-action")
+
+		row.AddSuffix(&deny.Widget)
+		row.AddSuffix(&approve.Widget)
+		group.Add(&row.Widget)
+	}
+
+	page.Add(group)
+	scrolled.SetChild(&page.Widget)
+}
+
+func (a *App) answerRequest(id string, approve bool, scrolled *gtk.ScrolledWindow) {
+	a.goAsync(func() (string, error) {
+		if err := a.Service.Answer(id, approve); err != nil {
+			return "", err
+		}
+		a.idle(func() { a.refreshRequests(scrolled) })
+		if approve {
+			return i18n.L("Request approved"), nil
+		}
+		return i18n.L("Request denied"), nil
+	})
+}
diff --git a/internal/components/secrets.go b/internal/components/secrets.go
new file mode 100644
index 0000000000000000000000000000000000000000..d263358e85b7167bc8f698f03955ec5ac9237748
--- /dev/null
+++ b/internal/components/secrets.go
@@ -0,0 +1,168 @@
+package components
+
+import (
+	"fmt"
+	"time"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+)
+
+func (a *App) buildSecretsPage() *gtk.Widget {
+	scrolled := gtk.NewScrolledWindow()
+	scrolled.SetHexpand(true)
+	scrolled.SetVexpand(true)
+
+	a.pages["secrets"] = scrolled
+	a.refreshSecrets(scrolled)
+
+	a.every(2, func() bool {
+		a.refreshSecrets(scrolled)
+		return true
+	})
+
+	return pageWithHeader(i18n.L("Secrets"), &scrolled.Widget)
+}
+
+func (a *App) refreshSecrets(scrolled *gtk.ScrolledWindow) {
+	rows, _ := a.State.Rows()
+
+	signature := ""
+
+	for _, row := range rows {
+		signature += fmt.Sprintf("%s:%s:%s:%s;", row.Name, row.Mode, row.Source, row.Upstream)
+
+		if grant := a.State.GrantInfo(row.Name); grant != nil {
+			signature += fmt.Sprintf("%s:%d;", row.Name, grant.ExpiresUnix)
+		}
+	}
+
+	if signature == a.secretsSignature {
+		return
+	}
+	a.secretsSignature = signature
+
+	if len(rows) == 0 {
+		scrolled.SetChild(a.statusPage(
+			"dialog-password-symbolic",
+			i18n.L("No Providers"),
+			i18n.L("Add a provider to give virtual machines time-boxed access to secrets."),
+			i18n.L("_Add Provider"),
+			func() { a.showProviderDialog() },
+		))
+		return
+	}
+
+	page := adw.NewPreferencesPage()
+
+	providers := adw.NewPreferencesGroup()
+	providers.SetTitle(i18n.L("Providers"))
+
+	for _, row := range rows {
+		row := row
+		subtitle := row.Mode + " · " + row.Source
+		if row.Mode == "proxy" {
+			subtitle = row.Mode + " · " + row.Upstream
+		}
+
+		pRow := a.actionRow(row.Name, subtitle, nil)
+
+		remove := a.iconButton("user-trash-symbolic", i18n.L("Remove provider"), func() {
+			a.confirmDialog(
+				i18n.L("Remove provider?"),
+				fmt.Sprintf(i18n.L("This removes the provider %s and revokes its grants."), row.Name),
+				i18n.L("_Remove"),
+				func() {
+					a.goAsync(func() (string, error) {
+						if err := a.State.RemoveProvider(row.Name); err != nil {
+							return "", err
+						}
+						a.idle(func() { a.refreshPage("secrets") })
+						return i18n.L("Provider removed"), nil
+					})
+				},
+			)
+		})
+		pRow.AddSuffix(&remove.Widget)
+		providers.Add(&pRow.Widget)
+	}
+
+	page.Add(providers)
+
+	actions := adw.NewPreferencesGroup()
+
+	addRow := a.actionRow(i18n.L("Add Provider"), "", func() {
+		a.showProviderDialog()
+	})
+	addIcon := gtk.NewImage()
+	addIcon.SetFromIconName("list-add-symbolic")
+	addRow.AddPrefix(&addIcon.Widget)
+	actions.Add(&addRow.Widget)
+
+	syncRow := a.actionRow(i18n.L("Sync Now"), "", func() {
+		a.goAsync(func() (string, error) {
+			if err := a.State.Sync(); err != nil {
+				return "", err
+			}
+			return i18n.L("Secrets synced"), nil
+		})
+	})
+	syncIcon := gtk.NewImage()
+	syncIcon.SetFromIconName("view-refresh-symbolic")
+	syncRow.AddPrefix(&syncIcon.Widget)
+	actions.Add(&syncRow.Widget)
+
+	page.Add(actions)
+
+	grants := adw.NewPreferencesGroup()
+	grants.SetTitle(i18n.L("Grants"))
+
+	for _, row := range rows {
+		row := row
+		grant := a.State.GrantInfo(row.Name)
+
+		subtitle := i18n.L("Not granted")
+		if grant != nil {
+			remaining := grant.ExpiresUnix - time.Now().Unix()
+			if remaining > 0 {
+				subtitle = fmt.Sprintf(i18n.L("Granted, %s left"), durationText(remaining))
+			}
+		}
+
+		gRow := a.actionRow(row.Name, subtitle, nil)
+
+		revoke := a.iconButton("window-close-symbolic", i18n.L("Revoke grant"), func() {
+			a.goAsync(func() (string, error) {
+				if err := a.State.Revoke([]string{row.Name}); err != nil {
+					return "", err
+				}
+				return i18n.L("Grant revoked"), nil
+			})
+		})
+		gRow.AddSuffix(&revoke.Widget)
+
+		grantBtn := a.iconButton("object-select-symbolic", i18n.L("Grant access"), func() {
+			a.showGrantDialog(row)
+		})
+		gRow.AddSuffix(&grantBtn.Widget)
+
+		grants.Add(&gRow.Widget)
+	}
+
+	page.Add(grants)
+	scrolled.SetChild(&page.Widget)
+}
+
+func durationText(seconds int64) string {
+	if seconds >= 86400 {
+		return fmt.Sprintf("%dd", seconds/86400)
+	}
+	if seconds >= 3600 {
+		return fmt.Sprintf("%dh", seconds/3600)
+	}
+	if seconds >= 60 {
+		return fmt.Sprintf("%dmin", seconds/60)
+	}
+	return fmt.Sprintf("%ds", seconds)
+}
diff --git a/internal/components/snapshot.go b/internal/components/snapshot.go
new file mode 100644
index 0000000000000000000000000000000000000000..5c008e8bbd868f84f2aecac1f6e930ff0be07335
--- /dev/null
+++ b/internal/components/snapshot.go
@@ -0,0 +1,44 @@
+package components
+
+import (
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+)
+
+func (a *App) captureWindow(path string) string {
+	if a.window == nil {
+		return "no window"
+	}
+
+	if a.window.Widget.GetWidth() <= 0 || a.window.Widget.GetHeight() <= 0 {
+		return "the window has no size yet"
+	}
+
+	child := a.window.Widget.GetFirstChild()
+	if child == nil {
+		return "no child"
+	}
+
+	snapshot := gtk.NewSnapshot()
+	a.window.Widget.SnapshotChild(child, snapshot)
+
+	node := snapshot.ToNode()
+	if node == nil {
+		return "no render node"
+	}
+
+	native := a.window.Widget.GetNative()
+	if native == nil {
+		return "no native surface"
+	}
+
+	texture := native.GetRenderer().RenderTexture(node, nil)
+	if texture == nil {
+		return "no texture"
+	}
+
+	if !texture.SaveToPng(path) {
+		return "could not save " + path
+	}
+
+	return "captured " + path
+}
diff --git a/internal/components/system.go b/internal/components/system.go
new file mode 100644
index 0000000000000000000000000000000000000000..105bebb78d677a50739dd2962082ad9f1cfbdc90
--- /dev/null
+++ b/internal/components/system.go
@@ -0,0 +1,39 @@
+package components
+
+import (
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+
+	"codeberg.org/pojntfx/phial/internal/mcp"
+)
+
+func (a *App) showSetupDialog() {
+	dialog := adw.NewAlertDialog(
+		i18n.L("Apply system setup?"),
+		i18n.L("This reserves huge pages for the guest, writes udev rules for the USB devices and vfio groups, raises the memory lock limit, installs the remaining tools, and connects the Ethernet to the bridge. Your desktop will ask for administrator approval through polkit."),
+	)
+
+	dialog.AddResponse("cancel", i18n.L("_Cancel"))
+	dialog.AddResponse("apply", i18n.L("_Apply"))
+	dialog.SetResponseAppearance("apply", adw.ResponseSuggestedValue)
+	dialog.SetDefaultResponse("apply")
+	dialog.SetCloseResponse("cancel")
+
+	var cb func(adw.AlertDialog, string)
+	cb = func(_ adw.AlertDialog, response string) {
+		if response != "apply" {
+			return
+		}
+		a.goAsync(func() (string, error) {
+			_, _, err := a.Service.SystemRootSetup(a.Ctx, nil, mcp.RootSetupInput{Memory: "16G"})
+			return "", err
+		})
+	}
+	dialog.ConnectResponse(&cb)
+	a.hold(&cb)
+
+	dialog.Present(&a.window.Widget)
+}
+
+var _ = gtk.Widget{}
diff --git a/internal/components/tasks.go b/internal/components/tasks.go
new file mode 100644
index 0000000000000000000000000000000000000000..c89024699918f46272893924180c9010d6a532fe
--- /dev/null
+++ b/internal/components/tasks.go
@@ -0,0 +1,195 @@
+package components
+
+import (
+	"fmt"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+
+	"codeberg.org/pojntfx/phial/internal/mcp"
+	"codeberg.org/pojntfx/phial/internal/virt"
+)
+
+type taskStep struct {
+	row     *adw.ActionRow
+	done    *gtk.Image
+	spinner *adw.Spinner
+	failed  *gtk.Image
+}
+
+func (a *App) buildTasksPanel(def virt.Definition, onToggle func(bool), onClose func()) (*gtk.Widget, *gtk.ToggleButton) {
+	box := gtk.NewBox(gtk.OrientationVerticalValue, 0)
+
+	centerBox := gtk.NewCenterBox()
+	centerBox.SetMarginTop(6)
+	centerBox.SetMarginBottom(6)
+	centerBox.SetMarginStart(6)
+	centerBox.SetMarginEnd(6)
+
+	toggle := gtk.NewToggleButton()
+	toggle.SetIconName("view-list-symbolic")
+	toggle.SetTooltipText(i18n.L("Progress"))
+	toggle.SetHasFrame(false)
+	toggle.SetActive(true)
+
+	var onSidebarToggle func(gtk.ToggleButton)
+	onSidebarToggle = func(gtk.ToggleButton) { onToggle(toggle.GetActive()) }
+	toggle.ConnectToggled(&onSidebarToggle)
+	a.hold(&onSidebarToggle)
+
+	centerBox.SetStartWidget(&toggle.Widget)
+
+	title := gtk.NewLabel(i18n.L("Progress"))
+	title.AddCssClass("heading")
+	centerBox.SetCenterWidget(&title.Widget)
+
+	closeBtn := a.iconButton("window-close-symbolic", i18n.L("Hide progress"), onClose)
+	centerBox.SetEndWidget(&closeBtn.Widget)
+
+	box.Append(&centerBox.Widget)
+
+	scrolled := gtk.NewScrolledWindow()
+	scrolled.SetHexpand(true)
+	scrolled.SetVexpand(true)
+
+	page := adw.NewPreferencesPage()
+	group := adw.NewPreferencesGroup()
+
+	var steps []taskStep
+
+	for _, name := range virt.InstallSteps() {
+		row := adw.NewActionRow()
+		row.SetTitle(name)
+		row.AddCssClass("dim-label")
+
+		done := gtk.NewImage()
+		done.SetFromIconName("object-select-symbolic")
+		done.SetVisible(false)
+		row.AddPrefix(&done.Widget)
+
+		spinner := adw.NewSpinner()
+		spinner.SetVisible(false)
+		row.AddPrefix(&spinner.Widget)
+
+		failed := gtk.NewImage()
+		failed.SetFromIconName("dialog-error-symbolic")
+		failed.SetVisible(false)
+		row.AddPrefix(&failed.Widget)
+
+		steps = append(steps, taskStep{row: row, done: done, spinner: spinner, failed: failed})
+		group.Add(&row.Widget)
+	}
+
+	page.Add(group)
+
+	actionGroup := adw.NewPreferencesGroup()
+
+	cancelRow := a.buttonRow(i18n.L("_Cancel Install"), "process-stop-symbolic", func() {
+		a.confirmDialog(
+			i18n.L("Cancel the install?"),
+			i18n.L("This stops the installer and removes the partial disk of the machine."),
+			i18n.L("_Cancel Install"),
+			func() {
+				a.goAsync(func() (string, error) {
+					_, _, err := a.Service.VmCancelInstall(a.Ctx, nil, mcp.NameInput{Name: def.Name})
+					if err != nil {
+						return "", err
+					}
+					a.idle(func() { a.refreshVMDetail(def.Name) })
+					return i18n.L("Install cancelled"), nil
+				})
+			},
+		)
+	})
+	cancelRow.AddCssClass("destructive-action")
+
+	actionGroup.Add(&cancelRow.Widget)
+	page.Add(actionGroup)
+
+	scrolled.SetChild(&page.Widget)
+	box.Append(&scrolled.Widget)
+
+	lastStep := -1
+	lastFailed := ""
+	lastDone := false
+	settled := false
+
+	a.every(1, func() bool {
+		running := a.Service.Installing(def.Name)
+		status := a.Service.InstallStatus(def.Name)
+
+		if status == nil {
+			return running
+		}
+
+		isFailed := status.Failed != ""
+
+		if status.Current == lastStep && isFailed == (lastFailed != "") && status.Done == lastDone {
+			if !running {
+				if settled {
+					return false
+				}
+				settled = true
+			}
+			return true
+		}
+
+		lastStep = status.Current
+		lastFailed = status.Failed
+		lastDone = status.Done
+
+		for index, step := range steps {
+			step.done.SetVisible(false)
+			step.spinner.SetVisible(false)
+			step.failed.SetVisible(false)
+
+			switch {
+			case isFailed && index == status.Current:
+				step.row.RemoveCssClass("dim-label")
+				step.row.SetSubtitle(status.Failed)
+				step.failed.SetVisible(true)
+			case index < status.Current || status.Done:
+				step.row.RemoveCssClass("dim-label")
+				step.row.SetSubtitle("")
+				step.done.SetVisible(true)
+			case index == status.Current:
+				step.row.RemoveCssClass("dim-label")
+				step.failed.SetVisible(false)
+
+				switch {
+				case index == 0 && status.Total > 0:
+					step.row.SetSubtitle(humanBytes(status.Downloaded) + " " + i18n.L("of") + " " + humanBytes(status.Total))
+				case index == 3 && status.PackagesTotal > 0:
+					detail := fmt.Sprintf(i18n.L("%d of %d packages"), status.Packages, status.PackagesTotal)
+
+					if status.PackageName != "" {
+						detail = status.PackageName + " · " + detail
+					}
+
+					step.row.SetSubtitle(detail)
+				default:
+					step.row.SetSubtitle("")
+				}
+
+				step.spinner.SetVisible(true)
+			default:
+				step.row.AddCssClass("dim-label")
+				step.row.SetSubtitle("")
+			}
+		}
+
+		actionGroup.SetVisible(!status.Done && !isFailed)
+
+		if !running {
+			if settled {
+				return false
+			}
+			settled = true
+		}
+
+		return true
+	})
+
+	return &box.Widget, toggle
+}
diff --git a/internal/components/vms.go b/internal/components/vms.go
new file mode 100644
index 0000000000000000000000000000000000000000..d2a20141c518076180a0dff4322ac9730a695c9a
--- /dev/null
+++ b/internal/components/vms.go
@@ -0,0 +1,751 @@
+package components
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gobject"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+
+	"codeberg.org/pojntfx/phial/internal/mcp"
+	"codeberg.org/pojntfx/phial/internal/virt"
+)
+
+func (a *App) buildVMsPage() *gtk.Widget {
+	scrolled := gtk.NewScrolledWindow()
+	scrolled.SetHexpand(true)
+	scrolled.SetVexpand(true)
+
+	a.pages["machines"] = scrolled
+	a.refreshVMs(scrolled)
+
+	a.every(3, func() bool {
+		a.refreshVMs(scrolled)
+		return true
+	})
+
+	return pageWithHeader(i18n.L("Machines"), &scrolled.Widget)
+}
+
+func (a *App) refreshVMs(scrolled *gtk.ScrolledWindow) {
+	defs, _ := virt.List()
+
+	signature := ""
+
+	for _, def := range defs {
+		active, _ := def.Active()
+		signature += fmt.Sprintf("%s:%v:%v:%s:%s:%v:%v;", def.Name, active, a.Service.Installing(def.Name), def.Display, def.GPU, def.SecureBoot, def.USBDevices)
+	}
+
+	if signature == a.vmsSignature {
+		return
+	}
+	a.vmsSignature = signature
+
+	if len(defs) == 0 {
+		scrolled.SetChild(a.statusPage(
+			"drive-harddisk-symbolic",
+			i18n.L("Welcome to Phial"),
+			i18n.L("Create your first development virtual machine to get started."),
+			i18n.L("_Create a Machine"),
+			func() { a.showNewVMDialog() },
+		))
+		return
+	}
+
+	page := adw.NewPreferencesPage()
+
+	group := adw.NewPreferencesGroup()
+
+	for _, def := range defs {
+		def := def
+		active, _ := def.Active()
+		installing := a.Service.Installing(def.Name)
+
+		subtitle := fmt.Sprintf("%s · %s", def.Display, def.GPU)
+
+		switch {
+		case installing:
+			subtitle = i18n.L("Installing") + " · " + subtitle
+		case !vmInstalled(def):
+			subtitle = i18n.L("Not installed")
+		case active && !def.Ready():
+			subtitle = i18n.L("Starting")
+		}
+
+		row := a.actionRow(def.Name, subtitle, func() { a.openVMDetail(def) })
+
+		if installing {
+			spinner := adw.NewSpinner()
+			spinner.SetValign(gtk.AlignCenterValue)
+			row.AddSuffix(&spinner.Widget)
+		} else if active {
+			stopBtn := a.iconButton("media-playback-stop-symbolic", i18n.L("Stop"), func() {
+				a.vmAction(def.Name, "stop")
+			})
+			row.AddSuffix(&stopBtn.Widget)
+		} else {
+			startBtn := a.iconButton("media-playback-start-symbolic", i18n.L("Start"), func() {
+				a.vmAction(def.Name, "start")
+			})
+			row.AddSuffix(&startBtn.Widget)
+		}
+
+		group.Add(&row.Widget)
+	}
+
+	page.Add(group)
+
+	addGroup := adw.NewPreferencesGroup()
+
+	addRow := a.actionRow(i18n.L("New Machine"), "", func() {
+		a.showNewVMDialog()
+	})
+
+	addIcon := gtk.NewImage()
+	addIcon.SetFromIconName("list-add-symbolic")
+	addRow.AddPrefix(&addIcon.Widget)
+
+	addGroup.Add(&addRow.Widget)
+	page.Add(addGroup)
+
+	scrolled.SetChild(&page.Widget)
+}
+
+func (a *App) openVMDetail(def virt.Definition) {
+	a.suppressToasts = true
+	defer func() { a.suppressToasts = false }()
+
+	active, _ := def.Active()
+	installing := a.Service.Installing(def.Name)
+	installed := vmInstalled(def)
+
+	toolbar := adw.NewToolbarView()
+	header := adw.NewHeaderBar()
+
+	title := adw.NewWindowTitle(def.Name, i18n.L("Machine"))
+	header.SetTitleWidget(&title.Widget)
+
+	var tasksBtn *gtk.ToggleButton
+
+	if installing {
+		tasksBtn = gtk.NewToggleButton()
+		tasksBtn.SetIconName("view-list-symbolic")
+		tasksBtn.SetTooltipText(i18n.L("Progress"))
+		tasksBtn.SetHasFrame(false)
+		tasksBtn.SetActive(true)
+
+		var onTasksToggled func(gtk.ToggleButton)
+		onTasksToggled = func(gtk.ToggleButton) {
+			if a.tasksSplit != nil {
+				a.tasksSplit.SetShowSidebar(tasksBtn.GetActive())
+			}
+		}
+		tasksBtn.ConnectToggled(&onTasksToggled)
+		a.hold(&onTasksToggled)
+
+		header.PackEnd(&tasksBtn.Widget)
+	}
+
+	if installing {
+		deleteBtn := a.iconButton("user-trash-symbolic", i18n.L("Delete Machine"), func() {
+			a.confirmDelete(def)
+		})
+		header.PackEnd(&deleteBtn.Widget)
+	} else if installed && !active {
+		startBtn := a.mnemonicButton(i18n.L("_Start"), func() {
+			a.vmAction(def.Name, "start")
+		})
+		startBtn.AddCssClass("suggested-action")
+		header.PackEnd(&startBtn.Widget)
+
+		deleteBtn := a.iconButton("user-trash-symbolic", i18n.L("Delete Machine"), func() {
+			a.confirmDelete(def)
+		})
+		header.PackEnd(&deleteBtn.Widget)
+	} else if active {
+		stopBtn := a.iconButton("media-playback-stop-symbolic", i18n.L("Stop"), func() {
+			a.vmAction(def.Name, "stop")
+		})
+		header.PackEnd(&stopBtn.Widget)
+
+		restartBtn := a.iconButton("view-refresh-symbolic", i18n.L("Restart"), func() {
+			a.vmAction(def.Name, "restart")
+		})
+		header.PackEnd(&restartBtn.Widget)
+	} else {
+		installBtn := a.mnemonicButton(i18n.L("_Install"), func() {
+			a.runInstall(def)
+		})
+		installBtn.AddCssClass("suggested-action")
+		header.PackEnd(&installBtn.Widget)
+
+		deleteBtn := a.iconButton("user-trash-symbolic", i18n.L("Delete Machine"), func() {
+			a.confirmDelete(def)
+		})
+		header.PackEnd(&deleteBtn.Widget)
+	}
+
+	toolbar.AddTopBar(&header.Widget)
+
+	scrolled := gtk.NewScrolledWindow()
+	scrolled.SetHexpand(true)
+	scrolled.SetVexpand(true)
+
+	vbox := gtk.NewBox(gtk.OrientationVerticalValue, 18)
+	vbox.SetMarginTop(18)
+	vbox.SetMarginBottom(18)
+	vbox.SetMarginStart(18)
+	vbox.SetMarginEnd(18)
+
+	starting := active && !def.Ready()
+
+	infoGroup := adw.NewPreferencesGroup()
+	infoGroup.SetTitle(i18n.L("Status"))
+
+	if starting {
+		startRow := adw.NewActionRow()
+		startRow.SetTitle(i18n.L("Starting"))
+		startRow.SetSubtitle(i18n.L("The guest is booting"))
+
+		startSpinner := adw.NewSpinner()
