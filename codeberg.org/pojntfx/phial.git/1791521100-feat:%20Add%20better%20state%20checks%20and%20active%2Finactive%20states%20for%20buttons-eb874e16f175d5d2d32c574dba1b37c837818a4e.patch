new file mode 100644
index 0000000000000000000000000000000000000000..5c524addb51f220c4342ebd52ad0c8b90a8d6efa
--- /dev/null
+++ b/internal/mcp/tools_share.go
@@ -0,0 +1,127 @@
+package mcp
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	mcpgo "github.com/modelcontextprotocol/go-sdk/mcp"
+
+	"codeberg.org/pojntfx/phial/internal/virt"
+)
+
+var (
+	ShareLsTool = &mcpgo.Tool{
+		Name:        "share.ls",
+		Title:       "List shared folders",
+		Description: "List the host directories that a machine shares over virtiofs.",
+		Annotations: &mcpgo.ToolAnnotations{ReadOnlyHint: true},
+	}
+
+	ShareAddTool = &mcpgo.Tool{
+		Name:        "share.add",
+		Title:       "Share a folder",
+		Description: "Share one host directory with a machine over virtiofs.",
+	}
+
+	ShareRemoveTool = &mcpgo.Tool{
+		Name:        "share.remove",
+		Title:       "Stop sharing a folder",
+		Description: "Stop sharing one host directory with a machine.",
+	}
+)
+
+type ShareInput struct {
+	Name string `json:"name" jsonschema:"the VM name"`
+	Path string `json:"path" jsonschema:"the host directory to share"`
+}
+
+type ShareLsOutput struct {
+	Shares []string `json:"shares" jsonschema:"the shared host directories"`
+}
+
+func writeShareConfig(share string) error {
+	configDir, err := os.UserConfigDir()
+	if err != nil {
+		return err
+	}
+
+	path := filepath.Join(configDir, "phial", "share-"+virt.ShareTag(share)+".conf")
+
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return err
+	}
+
+	return os.WriteFile(path, []byte("PHIAL_SHARE_DIR="+share+"\n"), 0o644)
+}
+
+func (s *Service) ShareLs(ctx context.Context, req *mcpgo.CallToolRequest, input NameInput) (*mcpgo.CallToolResult, *ShareLsOutput, error) {
+	def, err := virt.Load(input.Name)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	return nil, &ShareLsOutput{Shares: def.Shares}, nil
+}
+
+func (s *Service) ShareAdd(ctx context.Context, req *mcpgo.CallToolRequest, input ShareInput) (*mcpgo.CallToolResult, any, error) {
+	if input.Path == "" {
+		return nil, nil, fmt.Errorf("give a host directory to share")
+	}
+
+	info, err := os.Stat(input.Path)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	if !info.IsDir() {
+		return nil, nil, fmt.Errorf("%s is not a directory", input.Path)
+	}
+
+	def, err := virt.Load(input.Name)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	for _, existing := range def.Shares {
+		if existing == input.Path {
+			return nil, map[string]string{"state": "present"}, nil
+		}
+	}
+
+	if err := writeShareConfig(input.Path); err != nil {
+		return nil, nil, err
+	}
+
+	def.Shares = append(def.Shares, input.Path)
+
+	if err := def.Save(); err != nil {
+		return nil, nil, err
+	}
+
+	return nil, map[string]string{"state": "shared", "tag": virt.ShareTag(input.Path)}, nil
+}
+
+func (s *Service) ShareRemove(ctx context.Context, req *mcpgo.CallToolRequest, input ShareInput) (*mcpgo.CallToolResult, any, error) {
+	def, err := virt.Load(input.Name)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	kept := []string{}
+
+	for _, existing := range def.Shares {
+		if existing != input.Path {
+			kept = append(kept, existing)
+		}
+	}
+
+	def.Shares = kept
+
+	if err := def.Save(); err != nil {
+		return nil, nil, err
+	}
+
+	return nil, map[string]string{"state": "removed"}, nil
+}
