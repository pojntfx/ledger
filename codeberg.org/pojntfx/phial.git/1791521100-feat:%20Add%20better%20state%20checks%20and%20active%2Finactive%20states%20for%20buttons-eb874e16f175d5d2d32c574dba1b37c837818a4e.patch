+func (a *App) openSSHConsole(def virt.Definition) {
+	terminals := [][]string{
+		{"kgx", "--", "ssh", def.Name},
+		{"ptyxis", "--", "ssh", def.Name},
+		{"gnome-terminal", "--", "ssh", def.Name},
+		{"foot", "ssh", def.Name},
+		{"xterm", "-e", "ssh", def.Name},
+	}
+
+	if os.Getenv("FLATPAK_ID") != "" {
+		terminals = [][]string{
+			{"host-spawn", "kgx", "--", "ssh", def.Name},
+			{"host-spawn", "ptyxis", "--", "ssh", def.Name},
+			{"host-spawn", "gnome-terminal", "--", "ssh", def.Name},
+		}
+	}
+
+	for _, cmd := range terminals {
+		if _, err := exec.LookPath(cmd[0]); err == nil {
+			if err := exec.Command(cmd[0], cmd[1:]...).Start(); err == nil {
+				a.toast(i18n.L("SSH opened in a terminal"))
+				return
+			}
+		}
+	}
+
+	a.toast(i18n.L("No terminal emulator found"))
+}
