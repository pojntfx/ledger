@@ -0,0 +1,633 @@
+package components
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strings"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+	"github.com/rymdport/portal/filechooser"
+
+	"net/url"
+
+	"codeberg.org/pojntfx/phial/internal/mcp"
+	"codeberg.org/pojntfx/phial/internal/state"
+	"codeberg.org/pojntfx/phial/internal/virt"
+)
+
+func (a *App) showNewVMDialog() {
+	nameRow := adw.NewEntryRow()
+	nameRow.SetTitle(i18n.L("_Name"))
+	nameRow.SetUseUnderline(true)
+
+	memoryRow := adw.NewEntryRow()
+	memoryRow.SetTitle(i18n.L("_Memory"))
+	memoryRow.SetUseUnderline(true)
+	memoryRow.SetText("16G")
+
+	diskRow := adw.NewEntryRow()
+	diskRow.SetTitle(i18n.L("_Disk Size"))
+	diskRow.SetUseUnderline(true)
+	diskRow.SetText("128G")
+
+	a.modalDialog(i18n.L("New Machine"), i18n.L("_Create"),
+		formPage(&nameRow.Widget, &memoryRow.Widget, &diskRow.Widget),
+		func() bool {
+			name := nameRow.GetText()
+			if name == "" || strings.ContainsAny(name, " /") {
+				a.toast(i18n.L("Give a name without spaces"))
+				return false
+			}
+
+			def := virt.Defaults(name)
+			def.Memory = memoryRow.GetText()
+			def.DiskSize = diskRow.GetText()
+
+			if err := def.Save(); err != nil {
+				a.toast(err.Error())
+				return false
+			}
+
+			a.idle(func() { a.refreshPage("machines") })
+			a.toast(i18n.L("Machine created"))
+			return true
+		},
+	)
+}
+
+func (a *App) showProviderDialog() {
+	nameRow := adw.NewEntryRow()
+	nameRow.SetTitle(i18n.L("_Name"))
+	nameRow.SetUseUnderline(true)
+
+	sourceRow := adw.NewEntryRow()
+	sourceRow.SetTitle(i18n.L("_Source (keepassxc:// name)"))
+	sourceRow.SetUseUnderline(true)
+
+	upstreamRow := adw.NewEntryRow()
+	upstreamRow.SetTitle(i18n.L("_Upstream URL (proxy only)"))
+	upstreamRow.SetUseUnderline(true)
+
+	a.modalDialog(i18n.L("Add Provider"), i18n.L("_Add"),
+		formPage(&nameRow.Widget, &sourceRow.Widget, &upstreamRow.Widget),
+		func() bool {
+			name := nameRow.GetText()
+			source := sourceRow.GetText()
+
+			if name == "" || !strings.HasPrefix(source, "keepassxc://") {
+				a.toast(i18n.L("Give a name and a keepassxc:// source"))
+				return false
+			}
+
+			mode := "env"
+			upstream := upstreamRow.GetText()
+			if upstream != "" {
+				mode = "proxy"
+			}
+
+			if mode == "env" {
+				upstream = "-"
+			}
+
+			err := a.State.AddProvider(state.Row{
+				Name:     name,
+				Mode:     mode,
+				Source:   source,
+				Upstream: upstream,
+			})
+			if err != nil {
+				a.toast(err.Error())
+				return false
+			}
+
+			a.idle(func() { a.refreshPage("secrets") })
+			a.toast(i18n.L("Provider added"))
+			return true
+		},
+	)
+}
