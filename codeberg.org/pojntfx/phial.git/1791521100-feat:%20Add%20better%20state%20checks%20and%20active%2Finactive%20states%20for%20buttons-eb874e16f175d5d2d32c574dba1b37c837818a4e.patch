diff --git a/internal/components/app.go b/internal/components/app.go
new file mode 100644
index 0000000000000000000000000000000000000000..4b2597da6e6d15f7233bd461754b10af1df02b30
--- /dev/null
+++ b/internal/components/app.go
@@ -0,0 +1,204 @@
+package components
+
+import (
+	"context"
+	"log/slog"
+	"os"
+	"strconv"
+	"strings"
+
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gio"
+	"codeberg.org/puregotk/puregotk/v4/glib"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	"github.com/pojntfx/go-gettext/pkg/i18n"
+	"github.com/rymdport/portal/background"
+
+	"codeberg.org/pojntfx/phial/internal/mcp"
+	"codeberg.org/pojntfx/phial/internal/state"
+)
+
+const (
+	appID          = "com.pojtinger.felicitas.Phial"
+	gettextPackage = "phial"
+)
+
+var LocaleDir = "/usr/share/locale"
+
+func init() {
+	if err := i18n.InitI18n(gettextPackage, LocaleDir, slog.Default()); err != nil {
+		panic(err)
+	}
+}
+
+type App struct {
+	Ctx     context.Context
+	Log     *slog.Logger
+	State   *state.Client
+	Service *mcp.Service
+
+	app               *adw.Application
+	window            *adw.ApplicationWindow
+	toolbar           *gtk.Widget
+	toasts            *adw.ToastOverlay
+	stack             *adw.ViewStack
+	split             *adw.NavigationSplitView
+	sidebarList       *gtk.ListBox
+	syncing           bool
+	sidebar           *adw.Sidebar
+	banner            *adw.Banner
+	title             *adw.WindowTitle
+	pages             map[string]*gtk.ScrolledWindow
+	detail            *gtk.ScrolledWindow
+	contentNav        *adw.NavigationView
+	tasksSplit        *adw.OverlaySplitView
+	keep              []interface{}
+	suppressToasts    bool
+	vmsSignature      string
+	secretsSignature  string
+	requestsSignature string
+	visible           string
+}
+
+func Run(ctx context.Context, log *slog.Logger, kickstart []byte, showWindow bool) int {
+	a := &App{
+		Ctx:     ctx,
+		Log:     log,
+		State:   state.NewClient(log),
+		pages:   map[string]*gtk.ScrolledWindow{},
+		visible: "vms",
+	}
+
+	state.NotifyHook = a.notify
+	a.Service = mcp.NewService(ctx, log, a.State, kickstart, a.notify)
+
+	a.app = adw.NewApplication(appID, gio.GApplicationFlagsNoneValue)
+
+	var onStartup func(gio.Application)
+	onStartup = func(gio.Application) {
+		go func() {
+			if err := a.Service.Run(xdgRuntimeDir()); err != nil {
+				log.Error("mcp serve failed", "err", err)
+			}
+		}()
+
+		go func() {
+			if _, err := background.RequestBackground("", &background.RequestOptions{
+				Reason: i18n.L("Phial keeps the agent channel open for requests from virtual machines."),
+			}); err != nil {
+				log.Info("background request failed", "err", err)
+			}
+		}()
+
+	}
+	a.app.ConnectStartup(&onStartup)
+	a.hold(&onStartup)
+
+	var onActivate func(gio.Application)
+	onActivate = func(gio.Application) {
+		if a.window != nil {
+			a.window.Present()
+			return
+		}
+
+		a.buildWindow(showWindow)
+	}
+	a.app.ConnectActivate(&onActivate)
+	a.hold(&onActivate)
+
+	a.app.Hold()
+
+	return int(a.app.Run(int32(len(os.Args)), os.Args))
+}
+
+func (a *App) notify(summary, body string) {
+	n := gio.NewNotification(summary)
+
+	if body != "" {
+		n.SetBody(body)
+
+		if strings.Contains(strings.ToLower(summary), "fail") {
+			n.AddButtonWithTargetValue(i18n.L("Copy Error"), "app.copy-error", glib.NewVariantString(body))
+		}
+	}
+
+	a.app.SendNotification("phial-notification", n)
+}
+
+func xdgRuntimeDir() string {
+	if v := os.Getenv("XDG_RUNTIME_DIR"); v != "" {
+		return v
+	}
+	return "/run/user/" + strconv.Itoa(os.Getuid())
+}
+
+func (a *App) hold(v interface{}) {
+	a.keep = append(a.keep, v)
+}
+
+func (a *App) idle(fn func()) {
+	var cb glib.SourceOnceFunc
+	cb = func(uintptr) {
+		defer glib.UnrefCallback(&cb)
+		fn()
+	}
+	glib.IdleAddOnce(&cb, 0)
+}
+
+func (a *App) every(seconds uint32, fn func() bool) {
+	var cb glib.SourceFunc
+	cb = func(uintptr) bool {
+		return fn()
+	}
+	a.hold(&cb)
+	glib.TimeoutAddSeconds(seconds, &cb, 0)
+}
+
+func (a *App) toast(text string) {
+	if a.suppressToasts {
+		return
+	}
+	t := adw.NewToast(text)
+	t.SetTimeout(4)
+	a.toasts.AddToast(t)
+}
+
+func (a *App) goAsync(work func() (string, error)) {
+	go func() {
+		msg, err := work()
+		a.idle(func() {
+			if err != nil {
+				a.showError(err)
+				return
+			}
+			if msg != "" {
+				a.toast(msg)
+			}
+		})
+	}()
+}
+
+func (a *App) showError(err error) {
+	detail := err.Error()
+
+	dialog := adw.NewAlertDialog(i18n.L("Something went wrong"), detail)
+	dialog.AddResponse("copy", i18n.L("_Copy Error"))
+	dialog.AddResponse("close", i18n.L("_Close"))
+	dialog.SetDefaultResponse("close")
+	dialog.SetCloseResponse("close")
+
+	var cb func(adw.AlertDialog, string)
+	cb = func(_ adw.AlertDialog, response string) {
+		if response == "copy" {
+			if a.window != nil {
+				if display := a.window.Widget.GetDisplay(); display != nil {
+					display.GetClipboard().SetText(detail)
+				}
+			}
+		}
+	}
+	dialog.ConnectResponse(&cb)
+	a.hold(&cb)
+
+	dialog.Present(&a.window.Widget)
+}
diff --git a/internal/components/dialogs.go b/internal/components/dialogs.go
new file mode 100644
index 0000000000000000000000000000000000000000..f43a7d189241abdb7cadf29d1cec9cfd6acf3530
