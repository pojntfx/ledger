+
+	sidebarHeader := adw.NewHeaderBar()
+	sidebarHeader.SetShowTitle(true)
+
+	sidebarTitle := adw.NewWindowTitle("Phial", "")
+	sidebarHeader.SetTitleWidget(&sidebarTitle.Widget)
+
+	menuBtn := gtk.NewMenuButton()
+	menuBtn.SetIconName("open-menu-symbolic")
+	menuBtn.SetTooltipText(i18n.L("Main Menu"))
+	menuBtn.SetPrimary(true)
+	menuBtn.SetHasFrame(false)
+
+	menuModel := gio.NewMenu()
+	menuModel.Append(i18n.L("_Keyboard Shortcuts"), "app.shortcuts")
+	menuModel.Append(i18n.L("_Preferences"), "app.settings")
+	menuModel.Append(i18n.L("_About Phial"), "app.about")
+	menuModel.Append(i18n.L("_Quit"), "app.quit")
+	menuBtn.SetMenuModel(&menuModel.MenuModel)
+	sidebarHeader.PackEnd(&menuBtn.Widget)
+
+	sidebarToolbar.AddTopBar(&sidebarHeader.Widget)
+
+	sidebarList := gtk.NewListBox()
+	sidebarList.SetSelectionMode(gtk.SelectionSingleValue)
+	sidebarList.SetActivateOnSingleClick(true)
+	sidebarList.AddCssClass("navigation-sidebar")
+	a.sidebarList = sidebarList
+
+	for _, p := range pageDefs {
+		row := gtk.NewListBoxRow()
+		row.SetName(p.name)
+
+		box := gtk.NewBox(gtk.OrientationHorizontalValue, 12)
+		box.SetMarginTop(8)
+		box.SetMarginBottom(8)
+		box.SetMarginStart(12)
+		box.SetMarginEnd(12)
+
+		icon := gtk.NewImage()
+		icon.SetFromIconName(p.icon)
+		icon.SetPixelSize(16)
+		box.Append(&icon.Widget)
+
+		label := gtk.NewLabel(p.title)
+		label.SetHalign(gtk.AlignStartValue)
+		label.SetHexpand(true)
+		box.Append(&label.Widget)
+
+		row.SetChild(&box.Widget)
+		sidebarList.Append(&row.Widget)
+	}
+
+	var onActivated func(gtk.ListBox, uintptr)
+	onActivated = func(_ gtk.ListBox, rowPtr uintptr) {
