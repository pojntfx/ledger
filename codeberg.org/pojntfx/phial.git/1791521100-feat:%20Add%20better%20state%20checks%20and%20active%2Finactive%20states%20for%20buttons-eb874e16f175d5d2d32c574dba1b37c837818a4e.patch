+
+func vmInstalled(def virt.Definition) bool {
+	info, err := os.Stat(def.DiskPathValue())
+	if err != nil {
+		return false
+	}
+	return info.Size() > 1024*1024*1024
+}
+
+func vmStatusText(a *App, def virt.Definition) string {
+	if a.Service.Installing(def.Name) {
+		return i18n.L("Installing")
+	}
+
+	active, _ := def.Active()
+
+	if active {
+		if !def.Ready() {
+			return i18n.L("Starting")
+		}
+
+		return i18n.L("Running")
+	}
+
+	if vmInstalled(def) {
+		return i18n.L("Stopped")
+	}
+
+	return i18n.L("Not installed")
+}
+
+func (a *App) saveDef(def virt.Definition, msg string) {
+	snapshot := def
+	snapshot.Shares = append([]string{}, def.Shares...)
+	snapshot.USBDevices = append([]string{}, def.USBDevices...)
+
+	a.goAsync(func() (string, error) {
+		if err := snapshot.Save(); err != nil {
+			return "", err
+		}
+
+		return "", nil
+	})
+}
+
+func (a *App) runInstall(def virt.Definition) {
+	if a.Service.Installing(def.Name) {
+		a.toast(i18n.L("An install already runs for this machine"))
+		return
+	}
+	a.goAsync(func() (string, error) {
+		_, _, err := a.Service.VmInstall(a.Ctx, nil, mcp.NameInput{Name: def.Name})
+		if err != nil {
+			return "", err
+		}
+		a.idle(func() { a.refreshVMDetail(def.Name) })
+		return i18n.L("The installer runs in the background"), nil
+	})
+}
+
+func (a *App) confirmDelete(def virt.Definition) {
+	a.confirmDialog(
+		i18n.L("Delete machine?"),
+		fmt.Sprintf(i18n.L("This removes the definition of %s. The disk stays on disk."), def.Name),
+		i18n.L("_Delete"),
+		func() {
+			a.goAsync(func() (string, error) {
+				_ = def.Stop()
+				if err := def.Delete(); err != nil {
+					return "", err
+				}
+				a.idle(func() {
+					if a.contentNav != nil {
+						a.contentNav.Pop()
+					}
+					a.detail = nil
+					a.showPage("machines")
+					a.refreshPage("machines")
+				})
+				return i18n.L("Machine deleted"), nil
+			})
+		},
+	)
+}
+
+func (a *App) vmAction(name, action string) {
+	a.goAsync(func() (string, error) {
+		def, err := virt.Load(name)
+		if err != nil {
+			return "", err
+		}
+		switch action {
+		case "start":
+			if err := def.Start(); err != nil {
+				return "", err
+			}
+		case "stop":
+			if err := def.Stop(); err != nil {
+				return "", err
+			}
+		case "restart":
+			_ = def.Stop()
+			if err := def.Start(); err != nil {
+				return "", err
+			}
+		}
+		a.idle(func() {
+			if a.contentNav != nil {
+				a.contentNav.Pop()
+			}
+			a.detail = nil
+			def2, err := virt.Load(name)
+			if err == nil {
+				a.openVMDetail(def2)
+			}
+			a.refreshPage("machines")
+		})
+		return "", nil
+	})
+}
+
+func (a *App) refreshVMDetail(name string) {
+	def, err := virt.Load(name)
+	if err != nil {
+		return
+	}
+	a.detail = nil
+	a.openVMDetail(def)
+}
+
+func (a *App) refreshPage(name string) {
+	w, ok := a.pages[name]
+	if !ok {
+		return
+	}
+	switch name {
+	case "machines":
+		a.refreshVMs(w)
+	case "secrets":
+		a.refreshSecrets(w)
+	case "requests":
+		a.refreshRequests(w)
+	}
+}
+
+func (a *App) openSerialConsole(def virt.Definition) {
+	socketPath := def.RuntimePathValue() + "/console.sock"
+
+	terminals := [][]string{
+		{"kgx", "--", "socat", "-", "UNIX-CONNECT:" + socketPath},
+		{"ptyxis", "--", "socat", "-", "UNIX-CONNECT:" + socketPath},
+		{"gnome-terminal", "--", "socat", "-", "UNIX-CONNECT:" + socketPath},
+		{"foot", "socat", "-", "UNIX-CONNECT:" + socketPath},
+		{"alacritty", "-e", "socat", "-", "UNIX-CONNECT:" + socketPath},
+		{"tilix", "-e", "socat", "-", "UNIX-CONNECT:" + socketPath},
+		{"konsole", "-e", "socat", "-", "UNIX-CONNECT:" + socketPath},
+		{"xterm", "-e", "socat", "-", "UNIX-CONNECT:" + socketPath},
+	}
+
+	if os.Getenv("FLATPAK_ID") != "" {
+		terminals = [][]string{
+			{"host-spawn", "kgx", "--", "socat", "-", "UNIX-CONNECT:" + socketPath},
+			{"host-spawn", "ptyxis", "--", "socat", "-", "UNIX-CONNECT:" + socketPath},
+			{"host-spawn", "gnome-terminal", "--", "socat", "-", "UNIX-CONNECT:" + socketPath},
+		}
+	}
+
+	for _, cmd := range terminals {
+		if _, err := exec.LookPath(cmd[0]); err == nil {
+			c := exec.Command(cmd[0], cmd[1:]...)
+			_ = c.Start()
+			a.toast(i18n.L("Serial console opened in a terminal"))
+			return
+		}
+	}
+
+	a.toast(i18n.L("No terminal emulator found"))
+}
