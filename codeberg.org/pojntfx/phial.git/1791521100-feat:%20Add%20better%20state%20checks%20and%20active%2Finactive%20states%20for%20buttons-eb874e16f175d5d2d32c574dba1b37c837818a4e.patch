--- /dev/null
+++ b/internal/state/run.go
@@ -0,0 +1,54 @@
+package state
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"syscall"
+)
+
+func (c *Client) Run(args []string) error {
+	if len(args) == 0 {
+		return errors.New("usage: phial run <command> [argument...]")
+	}
+
+	dir := os.Getenv("PHIAL_SECRETS_DIR")
+	if dir == "" {
+		dir = "/mnt/phial-secrets"
+	}
+
+	environment := os.Environ()
+
+	entries, err := os.ReadDir(dir)
+	if err == nil {
+		for _, entry := range entries {
+			info, err := entry.Info()
+			if err != nil || !info.Mode().IsRegular() {
+				continue
+			}
+
+			if !namePattern.MatchString(entry.Name()) {
+				fmt.Fprintf(os.Stderr, "phial run: skipping %s, not a valid variable name\n", entry.Name())
+
+				continue
+			}
+
+			data, err := os.ReadFile(filepath.Join(dir, entry.Name()))
+			if err != nil {
+				continue
+			}
+
+			environment = append(environment, entry.Name()+"="+strings.TrimRight(string(data), "\n"))
+		}
+	}
+
+	binary, err := exec.LookPath(args[0])
+	if err != nil {
+		return err
+	}
+
+	return syscall.Exec(binary, args, environment)
+}
diff --git a/internal/state/secrets.go b/internal/state/secrets.go
new file mode 100644
index 0000000000000000000000000000000000000000..256eeee346fd3bc2963eab95b345721b391c9523
--- /dev/null
+++ b/internal/state/secrets.go
@@ -0,0 +1,78 @@
+package state
+
+import (
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/godbus/dbus/v5"
+)
+
+type secretItem struct {
+	Session     dbus.ObjectPath
+	Parameters  []byte
+	Value       []byte
+	ContentType string
+}
+
+func resolve(source string) (string, error) {
+	if key, ok := strings.CutPrefix(source, "env://"); ok {
+		value, ok := os.LookupEnv(key)
+		if !ok {
+			return "", fmt.Errorf("environment variable %s is not set", key)
+		}
+
+		return value, nil
+	}
+
+	key, ok := strings.CutPrefix(source, "keepassxc://")
+	if !ok {
+		return "", fmt.Errorf("unsupported source %q, the schemes are keepassxc:// and env://", source)
+	}
+
+	bus, err := dbus.ConnectSessionBus()
+	if err != nil {
+		return "", fmt.Errorf("no session bus: %w", err)
+	}
+	defer bus.Close()
+
+	service := bus.Object("org.freedesktop.secrets", dbus.ObjectPath("/org/freedesktop/secrets"))
+
+	var output dbus.Variant
+	var session dbus.ObjectPath
+	if err := service.Call("org.freedesktop.Secret.Service.OpenSession", 0, "plain",
+		dbus.MakeVariant("")).Store(&output, &session); err != nil {
+		return "", fmt.Errorf("cannot open a Secret Service session: %w", err)
+	}
+
+	var unlocked, locked []dbus.ObjectPath
+	if err := service.Call("org.freedesktop.Secret.Service.SearchItems", 0,
+		map[string]string{"phial": key}).Store(&unlocked, &locked); err != nil {
+		return "", fmt.Errorf("lookup of %s failed: %w", source, err)
+	}
+
+	if len(unlocked) == 0 {
+		if len(locked) > 0 {
+			return "", fmt.Errorf("the entry for %s is locked, open and unlock the KeePassXC window", source)
+		}
+
+		return "", fmt.Errorf("no entry for %s, store it with the attribute phial set to %q", source, key)
+	}
+
+	secrets := map[dbus.ObjectPath]secretItem{}
+	if err := service.Call("org.freedesktop.Secret.Service.GetSecrets", 0,
+		unlocked, session).Store(&secrets); err != nil {
+		return "", fmt.Errorf("cannot read %s: %w", source, err)
+	}
+
+	for _, item := range secrets {
+		value := strings.TrimRight(string(item.Value), "\n")
+		if value == "" {
+			return "", fmt.Errorf("empty value for %s", source)
+		}
+
+		return value, nil
+	}
+
+	return "", fmt.Errorf("no value for %s", source)
+}
diff --git a/internal/state/state_test.go b/internal/state/state_test.go
