index 0000000000000000000000000000000000000000..07635b00540463ccaaab373fec36b0b652b3a165
--- /dev/null
+++ b/internal/mcp/tools_system.go
@@ -0,0 +1,194 @@
+package mcp
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	systemdDbus "github.com/coreos/go-systemd/v22/dbus"
+	mcpgo "github.com/modelcontextprotocol/go-sdk/mcp"
+
+	"codeberg.org/pojntfx/phial/internal/setup"
+)
+
+var (
+	SystemStatusTool = &mcpgo.Tool{
+		Name:        "system.status",
+		Title:       "Show the system setup status",
+		Description: "Show huge pages, the bridge, the tap, the udev rules, and the unit states.",
+		Annotations: &mcpgo.ToolAnnotations{ReadOnlyHint: true},
+	}
+
+	SystemRootSetupTool = &mcpgo.Tool{
+		Name:        "system.rootSetup",
+		Title:       "Apply the system setup",
+		Description: "Apply huge pages, udev rules, the bridge, and the tool installs. Needs polkit approval.",
+	}
+
+	SystemAcceptanceTool = &mcpgo.Tool{
+		Name:        "system.acceptance",
+		Title:       "Run the host acceptance",
+		Description: "Run every host acceptance check and report the results.",
+		Annotations: &mcpgo.ToolAnnotations{ReadOnlyHint: true},
+	}
+)
+
+type StatusItem struct {
+	Name  string `json:"name" jsonschema:"the item name"`
+	Value string `json:"value" jsonschema:"the item state"`
+}
+
+type SystemStatusOutput struct {
+	Items []StatusItem `json:"items" jsonschema:"the status items"`
+}
+
+func (s *Service) SystemStatus(ctx context.Context, req *mcpgo.CallToolRequest, input struct{}) (*mcpgo.CallToolResult, *SystemStatusOutput, error) {
+	out := &SystemStatusOutput{}
+
+	add := func(name, value string) {
+		out.Items = append(out.Items, StatusItem{name, value})
+	}
+
+	hugepages := "unknown"
+	if data, err := os.ReadFile("/proc/sys/vm/nr_hugepages"); err == nil {
+		hugepages = strings.TrimSpace(string(data))
+	}
+
+	add("hugepages", hugepages)
+	add("bridge phialbr0", interfaceState("phialbr0"))
+	add("tap phialtap0", interfaceState("phialtap0"))
+	add("udev usb rules", fileState("/etc/udev/rules.d/70-phial-usb.rules"))
+	add("udev vfio rules", fileState("/etc/udev/rules.d/70-phial-vfio.rules"))
+	add("memlock dropin", fileState("/etc/systemd/system/user@.service.d/99-phial-memlock.conf"))
+
+	for _, unit := range []string{"phial-caddy.service", "phial-agent.service", "phial-forward@proxy.service", "phial-forward@mcp.service"} {
+		active, err := s.unitActive(unit)
+		value := "unknown"
+
+		if err == nil {
+			if active {
+				value = "active"
+			} else {
+				value = "inactive"
+			}
+		}
+
+		add(unit, value)
+	}
+
+	return nil, out, nil
+}
+
+func interfaceState(name string) string {
+	if _, err := os.Stat(filepath.Join("/sys/class/net", name)); err != nil {
+		return "missing"
+	}
+
+	data, err := os.ReadFile(filepath.Join("/sys/class/net", name, "operstate"))
+	if err != nil {
+		return "present"
+	}
+
+	return strings.TrimSpace(string(data))
+}
+
+func fileState(path string) string {
+	if _, err := os.Stat(path); err != nil {
+		return "missing"
+	}
+
+	return "present"
+}
+
+type RootSetupInput struct {
+	Memory   string   `json:"memory" jsonschema:"the guest memory size for huge pages, for example 16G"`
+	Ethernet string   `json:"ethernet" jsonschema:"the Ethernet device for the bridge, empty for auto"`
+	Devices  []string `json:"devices" jsonschema:"the USB vendor:product list for the udev rules"`
+}
+
+func (s *Service) SystemRootSetup(ctx context.Context, req *mcpgo.CallToolRequest, input RootSetupInput) (*mcpgo.CallToolResult, any, error) {
+	ethernet := input.Ethernet
+	if ethernet == "" {
+		ethernet = setup.FirstEthernet()
+	}
+
+	output, err := run0("root-setup", ethernet, input.Memory)
+	if err != nil {
+		return nil, nil, fmt.Errorf("root setup: %s: %w", output, err)
+	}
+
+	return nil, map[string]string{"state": "applied", "ethernet": ethernet}, nil
+}
+
+type AcceptanceOutput struct {
+	Checks []setup.Check `json:"checks" jsonschema:"the acceptance results"`
+}
+
+func (s *Service) SystemAcceptance(ctx context.Context, req *mcpgo.CallToolRequest, input struct{}) (*mcpgo.CallToolResult, *AcceptanceOutput, error) {
+	return nil, &AcceptanceOutput{Checks: setup.Acceptance()}, nil
+}
+
+func run0(args ...string) (string, error) {
+	self, err := os.Executable()
+	if err != nil {
+		return "", err
+	}
+
+	command := exec.Command("run0", append([]string{self}, args...)...)
+
+	output, err := command.CombinedOutput()
+
+	return strings.TrimSpace(string(output)), err
+}
+
+func (s *Service) userManager() (*systemdDbus.Conn, error) {
+	return systemdDbus.NewUserConnectionContext(context.Background())
+}
+
+func (s *Service) unitStart(name string) error {
+	conn, err := s.userManager()
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+
+	_, err = conn.StartUnitContext(context.Background(), name, "replace", nil)
+
+	return err
+}
+
+func (s *Service) unitStop(name string) error {
+	conn, err := s.userManager()
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+
+	_, err = conn.StopUnitContext(context.Background(), name, "replace", nil)
+
+	return err
+}
+
+func (s *Service) unitActive(name string) (bool, error) {
+	conn, err := s.userManager()
+	if err != nil {
+		return false, err
+	}
+	defer conn.Close()
+
+	property, err := conn.GetUnitPropertyContext(context.Background(), name, "ActiveState")
+	if err != nil {
+		return false, err
+	}
+
+	state, ok := property.Value.Value().(string)
+
+	return ok && state == "active", nil
+}
+
+var _ = strconv.Itoa
+var _ = filepath.Join
diff --git a/internal/mcp/tools_usb.go b/internal/mcp/tools_usb.go
new file mode 100644
index 0000000000000000000000000000000000000000..de6291d9d3f4f15a85423e2afe3c6f46fbb7df6c
--- /dev/null
+++ b/internal/mcp/tools_usb.go
@@ -0,0 +1,274 @@
+package mcp
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"strings"
+
+	mcpgo "github.com/modelcontextprotocol/go-sdk/mcp"
+
+	"codeberg.org/pojntfx/phial/internal/virt"
+)
+
+var (
+	UsbLsTool = &mcpgo.Tool{
+		Name:        "usb.ls",
+		Title:       "List USB devices",
+		Description: "List the host USB devices and the passthrough configuration of a VM.",
+		Annotations: &mcpgo.ToolAnnotations{ReadOnlyHint: true},
+	}
+
+	UsbAddDeviceTool = &mcpgo.Tool{
+		Name:        "usb.addDevice",
+		Title:       "Add a USB device",
+		Description: "Add one host USB device to a VM by vendor and product ID.",
+	}
+
+	UsbRemoveDeviceTool = &mcpgo.Tool{
+		Name:        "usb.removeDevice",
+		Title:       "Remove a USB device",
+		Description: "Remove one USB device from a VM.",
+	}
+
+	UsbBindTool = &mcpgo.Tool{
+		Name:        "usb.bindXhci",
+		Title:       "Bind an xHCI controller to the VM",
+		Description: "Bind one PCI xHCI controller and its IOMMU group to vfio-pci for the VM. Needs polkit approval.",
+	}
+
+	UsbRestoreTool = &mcpgo.Tool{
+		Name:        "usb.restoreXhci",
+		Title:       "Restore an xHCI controller to the host",
+		Description: "Give one PCI xHCI controller and its group back to the host drivers. Needs polkit approval.",
+	}
+)
+
+type UsbDeviceInfo struct {
+	Address string `json:"address" jsonschema:"the sysfs address, for example 3-5.2.3"`
+	Vendor  string `json:"vendor" jsonschema:"the vendor ID in hex"`
+	Product string `json:"product" jsonschema:"the product ID in hex"`
+	Name    string `json:"name" jsonschema:"manufacturer and product strings"`
+}
+
+type UsbLsOutput struct {
+	Devices    []UsbDeviceInfo `json:"devices" jsonschema:"the host USB devices"`
+	Passthru   []string        `json:"passthru" jsonschema:"the devices configured for the VM"`
+	Controller string          `json:"controller" jsonschema:"the xHCI controller bound to the VM, if any"`
+}
+
+func (s *Service) UsbLs(ctx context.Context, req *mcpgo.CallToolRequest, input NameInput) (*mcpgo.CallToolResult, *UsbLsOutput, error) {
+	out := &UsbLsOutput{}
+
+	vendors, _ := filepath.Glob("/sys/bus/usb/devices/*/idVendor")
+
+	for _, vendorFile := range vendors {
+		vendor := strings.TrimSpace(readFile(vendorFile))
+		product := strings.TrimSpace(readFile(filepath.Join(filepath.Dir(vendorFile), "idProduct")))
+
+		if vendor == "" || product == "" || vendor == "1d6b" {
+			continue
+		}
+
+		manufacturer := strings.TrimSpace(readFile(filepath.Join(filepath.Dir(vendorFile), "manufacturer")))
+		productName := strings.TrimSpace(readFile(filepath.Join(filepath.Dir(vendorFile), "product")))
+
+		name := strings.TrimSpace(manufacturer + " " + productName)
+
+		out.Devices = append(out.Devices, UsbDeviceInfo{
+			Address: filepath.Base(filepath.Dir(vendorFile)),
+			Vendor:  vendor,
+			Product: product,
+			Name:    name,
+		})
+	}
+
+	if input.Name != "" {
+		if def, err := virt.Load(input.Name); err == nil {
+			out.Passthru = def.USBDevices
+			out.Controller = def.USBXHCI
+		}
+	}
+
+	return nil, out, nil
+}
+
+func readFile(path string) string {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return ""
+	}
+
+	return string(data)
+}
+
+type UsbDeviceInput struct {
+	VM     string `json:"vm" jsonschema:"the VM name"`
+	Device string `json:"device" jsonschema:"vendor:product in hex, for example 0403:6001"`
+}
+
+func (s *Service) UsbAddDevice(ctx context.Context, req *mcpgo.CallToolRequest, input UsbDeviceInput) (*mcpgo.CallToolResult, any, error) {
+	def, err := virt.Load(input.VM)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	vendor, product, ok := strings.Cut(input.Device, ":")
+	if !ok || len(vendor) != 4 || len(product) != 4 {
+		return nil, nil, fmt.Errorf("the device must be vendor:product in hex")
+	}
+
+	for _, existing := range def.USBDevices {
+		if existing == input.Device {
+			return nil, nil, fmt.Errorf("the device %s is already in the list", input.Device)
+		}
+	}
+
+	def.USBDevices = append(def.USBDevices, input.Device)
+
+	if err := def.Save(); err != nil {
+		return nil, nil, err
+	}
+
+	return nil, map[string]string{"state": "added"}, nil
+}
+
+func (s *Service) UsbRemoveDevice(ctx context.Context, req *mcpgo.CallToolRequest, input UsbDeviceInput) (*mcpgo.CallToolResult, any, error) {
+	def, err := virt.Load(input.VM)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	kept := []string{}
+
+	for _, existing := range def.USBDevices {
+		if existing != input.Device {
+			kept = append(kept, existing)
+		}
+	}
+
+	def.USBDevices = kept
+
+	if err := def.Save(); err != nil {
+		return nil, nil, err
+	}
+
+	return nil, map[string]string{"state": "removed"}, nil
+}
+
+type AddressInput struct {
+	Address string `json:"address" jsonschema:"the PCI address of the controller, for example 0000:00:14.0"`
+}
+
+func (s *Service) UsbBind(ctx context.Context, req *mcpgo.CallToolRequest, input AddressInput) (*mcpgo.CallToolResult, any, error) {
+	output, err := run0("vfio", "bind", input.Address)
+	if err != nil {
+		return nil, nil, fmt.Errorf("vfio bind: %s: %w", output, err)
+	}
+
+	return nil, map[string]string{"state": "bound"}, nil
+}
+
+func (s *Service) UsbRestore(ctx context.Context, req *mcpgo.CallToolRequest, input AddressInput) (*mcpgo.CallToolResult, any, error) {
+	output, err := run0("vfio", "restore", input.Address)
+	if err != nil {
+		return nil, nil, fmt.Errorf("vfio restore: %s: %w", output, err)
+	}
+
+	return nil, map[string]string{"state": "restored"}, nil
+}
+
+var ListXhciTool = &mcpgo.Tool{
+	Name:        "usb.listXhci",
+	Title:       "List xHCI controllers",
+	Description: "List available xHCI controllers on the host for hub passthrough.",
+	Annotations: &mcpgo.ToolAnnotations{ReadOnlyHint: true},
+}
+
+type XhciController struct {
+	Address string `json:"address" jsonschema:"the PCI address"`
+	Name    string `json:"name" jsonschema:"the controller name"`
+	Count   int    `json:"count" jsonschema:"the number of xHCI controllers"`
+}
+
+type ListXhciOutput struct {
+	Controllers []XhciController
+	Count       int `json:"controllers" jsonschema:"available xHCI controllers"`
+}
+
+func (s *Service) ListXhci(ctx context.Context, req *mcpgo.CallToolRequest, input struct{}) (*mcpgo.CallToolResult, *ListXhciOutput, error) {
+	out := &ListXhciOutput{}
+
+	matches, _ := filepath.Glob("/sys/bus/pci/devices/*/class")
+	for _, classFile := range matches {
+		data, err := os.ReadFile(classFile)
+		if err != nil {
+			continue
+		}
+		if strings.TrimSpace(string(data)) != "0x0c0330" {
+			continue
+		}
+
+		deviceDir := filepath.Dir(classFile)
+		address := filepath.Base(deviceDir)
+
+		vendorData, _ := os.ReadFile(filepath.Join(deviceDir, "vendor"))
+		deviceData, _ := os.ReadFile(filepath.Join(deviceDir, "device"))
+		vendor := strings.TrimSpace(string(vendorData))
+		device := strings.TrimSpace(string(deviceData))
+
+		name := vendor + " " + device
+
+		if lspci, err := exec.Command("lspci", "-s", address).Output(); err == nil {
+			line := strings.TrimSpace(string(lspci))
+			if colon := strings.Index(line, ": "); colon >= 0 {
+				name = strings.TrimSpace(line[colon+2:])
+				name = regexp.MustCompile("\\s*\\(rev [^)]+\\)$").ReplaceAllString(name, "")
+			}
+		}
+
+		out.Controllers = append(out.Controllers, XhciController{
+			Address: address,
+			Name:    name,
+		})
+	}
+
+	out.Count = len(out.Controllers)
+
+	return nil, out, nil
+}
+
+var UsbNamesTool = &mcpgo.Tool{
+	Name:        "usb.names",
+	Title:       "Resolve USB device names",
+	Description: "Return the human name for each USB vendor and product ID.",
+	Annotations: &mcpgo.ToolAnnotations{ReadOnlyHint: true},
+}
+
+type UsbNamesInput struct {
+	IDs []string `json:"ids" jsonschema:"the vendor and product IDs, for example 0403:6001"`
+}
+
+type UsbNamesOutput struct {
+	Names map[string]string `json:"names" jsonschema:"the name for each ID"`
+}
+
+func (s *Service) UsbNames(ctx context.Context, req *mcpgo.CallToolRequest, input UsbNamesInput) (*mcpgo.CallToolResult, *UsbNamesOutput, error) {
+	out := &UsbNamesOutput{Names: map[string]string{}}
+
+	for _, id := range input.IDs {
+		parts := strings.SplitN(id, ":", 2)
+		if len(parts) != 2 {
+			continue
+		}
+
+		if name := virt.USBName(parts[0], parts[1]); name != "" {
+			out.Names[id] = name
+		}
+	}
+
+	return nil, out, nil
+}
