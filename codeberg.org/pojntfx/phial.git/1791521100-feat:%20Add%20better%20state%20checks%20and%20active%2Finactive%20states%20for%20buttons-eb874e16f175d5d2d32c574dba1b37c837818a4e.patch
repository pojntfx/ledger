diff --git a/internal/guest/provision.go b/internal/guest/provision.go
new file mode 100644
index 0000000000000000000000000000000000000000..1f15a7b29a5d2e203f362d1a014320509d22e6d5
--- /dev/null
+++ b/internal/guest/provision.go
@@ -0,0 +1,141 @@
+package guest
+
+import (
+	"embed"
+	"encoding/base64"
+	"fmt"
+	"os"
+	"path"
+	"strings"
+
+	"codeberg.org/pojntfx/phial/internal/virt"
+)
+
+//go:embed files
+var files embed.FS
+
+type target struct {
+	source string
+	dest   string
+	mode   string
+}
+
+var targets = []target{
+	{"files/systemd-user/phial-guest-port@.service", ".config/systemd/user/phial-guest-port@.service", "0644"},
+	{"files/systemd-user/phial-forward@.service", ".config/systemd/user/phial-forward@.service", "0644"},
+	{"files/systemd-user/phial-secrets.path", ".config/systemd/user/phial-secrets.path", "0644"},
+	{"files/systemd-user/phial-secrets-refresh.service", ".config/systemd/user/phial-secrets-refresh.service", "0644"},
+	{"files/systemd-user/phial-consumer@.service", ".config/systemd/user/phial-consumer@.service", "0644"},
+	{"files/user.conf", ".config/systemd/user.conf", "0644"},
+	{"files/systemd-user/phial-waypipe.service", ".config/systemd/user/phial-waypipe.service", "0644"},
+	{"files/forward-proxy.conf", ".config/phial/forward-proxy.conf", "0644"},
+	{"files/forward-ssh-agent.conf", ".config/phial/forward-ssh-agent.conf", "0644"},
+	{"files/forward-gpg-extra.conf", ".config/phial/forward-gpg-extra.conf", "0644"},
+	{"files/forward-mcp.conf", ".config/phial/forward-mcp.conf", "0644"},
+	{"files/skills/SKILL.md", ".agents/skills/phial/SKILL.md", "0644"},
+}
+
+func Provision(def virt.Definition, hostAlias string, hostshareMount string, secretsMount string, fallbackMAC string, binary string, rdpPassword string) error {
+	active, _ := def.Active()
+	if !active {
+		return fmt.Errorf("%s does not run", def.Name)
+	}
+
+	steps := []string{
+		"set -e",
+		"mkdir -p ~/.local/bin ~/.config/systemd/user ~/.config/phial ~/.agents/skills/phial",
+	}
+
+	for _, item := range targets {
+		data, err := files.ReadFile(item.source)
+		if err != nil {
+			return err
+		}
+
+		steps = append(steps, writeText(item.dest, item.mode, string(data)))
+	}
+
+	if binary != "" {
+		data, err := os.ReadFile(binary)
+		if err != nil {
+			return err
+		}
+
+		steps = append(steps, writeBinary(".local/bin/phial", base64.StdEncoding.EncodeToString(data)))
+	}
+
+	steps = append(steps,
+		"sudo install -d -m 0755 "+hostshareMount+" "+secretsMount,
+		"grep -q phial-hostshare /etc/fstab || echo 'hostshare "+hostshareMount+" virtiofs defaults,nofail 0 0' | sudo tee -a /etc/fstab > /dev/null",
+		"grep -q phial-secrets /etc/fstab || echo 'phial-secrets "+secretsMount+" virtiofs ro,nosuid,nodev,noexec,nofail 0 0' | sudo tee -a /etc/fstab > /dev/null",
+		"sudo mountpoint -q "+hostshareMount+" || sudo mount "+hostshareMount+" || true",
+		"sudo mountpoint -q "+secretsMount+" || sudo mount "+secretsMount+" || true",
+		"sudo sed -i '/# BEGIN phial/,/# END phial/d' /etc/hosts",
+		"printf '# BEGIN phial\n::1 "+hostAlias+"\n127.0.0.1 "+hostAlias+"\n# END phial\n' | sudo tee -a /etc/hosts > /dev/null",
+		"printf 'options kvm-intel nested=1\noptions kvm-amd nested=1\n' | sudo tee /etc/modprobe.d/99-phial-nested.conf > /dev/null",
+		"systemctl --user disable --now phial-ssh-vsock.service > /dev/null 2>&1 || true",
+		"rm -f ~/.config/systemd/user/phial-ssh-vsock.service ~/.config/systemd/user/default.target.wants/phial-ssh-vsock.service",
+		"systemctl --user daemon-reload",
+		"systemctl --user enable --now phial-forward@proxy.service 2>/dev/null || true",
+		"systemctl --user enable --now phial-forward@mcp.service 2>/dev/null || true",
+		"systemctl --user enable --now phial-secrets.path 2>/dev/null || true",
+		"systemctl --user enable phial-waypipe.service 2>/dev/null || true",
+		"systemctl --user restart phial-waypipe.service 2>/dev/null || true",
+		"systemctl --user enable --now gnome-remote-desktop-handover.service 2>/dev/null || true",
+		"systemctl --user enable --now phial-guest-port@3389.service 2>/dev/null || true",
+		rdpScript(def.Name, rdpPassword),
+		fallbackMetricScript(fallbackMAC),
+	)
+
+	return run(def.Name, strings.Join(steps, "\n"))
+}
+
+func rdpScript(name string, password string) string {
+	key := "/etc/gnome-remote-desktop/rdp-tls.key"
+	cert := "/etc/gnome-remote-desktop/rdp-tls.crt"
+
+	steps := []string{
+		"sudo dnf install -y gnome-remote-desktop waypipe mesa-demos openssl crudini > /dev/null 2>&1 || true",
+		"sudo install -d -m 0700 /etc/gnome-remote-desktop",
+		"sudo test -s " + key + " || sudo test -s " + cert + " || sudo openssl req -x509 -newkey rsa:2048 -keyout " + key + " -out " + cert + " -days 3650 -nodes -subj /CN=" + name + " < /dev/null",
+		"sudo chown gnome-remote-desktop:gnome-remote-desktop " + key + " " + cert + " 2>/dev/null || true",
+		"sudo chmod 0600 " + key + " " + cert,
+		"sudo grdctl --system rdp set-tls-cert " + cert,
+		"sudo grdctl --system rdp set-tls-key " + key,
+		"sudo grdctl --system rdp set-credentials " + name + " " + password,
+		"sudo grdctl --system rdp disable-view-only",
+		"sudo grdctl --system rdp enable",
+		"sudo systemctl enable gnome-remote-desktop > /dev/null 2>&1 || true",
+		"sudo systemctl restart gnome-remote-desktop > /dev/null 2>&1 || true",
+		"echo \"phial:" + password + "\" | sudo chpasswd || { echo \"phial: could not set the guest password, pwquality rejects it\" >&2; exit 1; }",
+		"sudo passwd -u " + name + " > /dev/null 2>&1 || true",
+		"sudo crudini --set /etc/gdm/custom.conf daemon AutomaticLoginEnable true",
+		"sudo crudini --set /etc/gdm/custom.conf daemon AutomaticLogin " + name,
+		"sudo loginctl enable-linger " + name + " || true",
+		"mkdir -p ~/.config/environment.d",
+		"printf 'XDG_SESSION_TYPE=wayland\\n' > ~/.config/environment.d/wayland.conf",
+	}
+
+	return strings.Join(steps, "\n")
+}
+
+func writeText(dest string, mode string, content string) string {
+	return fmt.Sprintf("mkdir -p \"$HOME/%s\" && cat > \"$HOME/%s\" <<'PHIALEOF'\n%s\nPHIALEOF\nchmod %s \"$HOME/%s\"", path.Dir(dest), dest, content, mode, dest)
+}
+
+func writeBinary(dest string, content string) string {
+	return fmt.Sprintf("mkdir -p \"$HOME/%s\" && printf '%%s' '%s' | base64 -d > \"$HOME/%s\" && chmod 0755 \"$HOME/%s\"", path.Dir(dest), content, dest, dest)
+}
+
+func fallbackMetricScript(mac string) string {
+	return fmt.Sprintf("for dev in $(nmcli -t -f DEVICE,TYPE device | awk -F: '$2 == \"ethernet\" {print $1}'); do\n  hw=$(nmcli -g GENERAL.HWADDR device show \"$dev\" | sed 's/\\\\//g')\n  if [ \"$(echo \"$hw\" | tr 'A-F' 'a-f')\" = \"%s\" ]; then\n    con=$(nmcli -g GENERAL.CONNECTION device show \"$dev\" | sed 's/\\\\//g')\n    sudo nmcli connection modify \"$con\" ipv4.route-metric 1000 ipv6.route-metric 1000 || true\n  fi\ndone", mac)
+}
+
+func run(host string, script string) error {
+	command := virt.SSHCommand(host, "bash -s")
+	command.Stdin = strings.NewReader(script)
+	command.Stdout = os.Stdout
+	command.Stderr = os.Stderr
+
+	return command.Run()
+}
diff --git a/internal/mcp/approvals.go b/internal/mcp/approvals.go
