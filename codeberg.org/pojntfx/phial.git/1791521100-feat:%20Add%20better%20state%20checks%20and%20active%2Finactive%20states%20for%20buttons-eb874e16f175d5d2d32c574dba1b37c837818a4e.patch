+
+func (s *Service) ApprovalsList(ctx context.Context, req *mcpgo.CallToolRequest, input struct{}) (*mcpgo.CallToolResult, *ApprovalsListOutput, error) {
+	return nil, &ApprovalsListOutput{Pending: s.approvals.List()}, nil
