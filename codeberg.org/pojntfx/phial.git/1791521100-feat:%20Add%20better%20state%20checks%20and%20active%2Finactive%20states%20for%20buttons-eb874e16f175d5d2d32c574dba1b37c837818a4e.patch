+
+var VmCancelInstallTool = &mcpgo.Tool{
+	Name:        "vm.cancelInstall",
+	Title:       "Cancel an install",
+	Description: "Stop a running install and remove the partial disk of the machine.",
+}
+
+func (s *Service) VmCancelInstall(ctx context.Context, req *mcpgo.CallToolRequest, input NameInput) (*mcpgo.CallToolResult, any, error) {
+	if !s.installs[input.Name] {
+		return nil, nil, fmt.Errorf("no install runs for %s", input.Name)
+	}
+
+	if !virt.CancelInstall(input.Name) {
+		return nil, nil, fmt.Errorf("the install for %s cannot be cancelled", input.Name)
+	}
+
+	deadline := time.Now().Add(30 * time.Second)
+	for time.Now().Before(deadline) {
+		if !s.installs[input.Name] {
+			break
+		}
+		time.Sleep(200 * time.Millisecond)
+	}
+
+	if def, err := virt.Load(input.Name); err == nil {
+		_ = def.Stop()
+	}
+
+	if err := virt.CleanPartialInstall(input.Name); err != nil {
+		return nil, nil, err
+	}
+
+	virt.ClearInstallStatus(input.Name)
+
+	return nil, map[string]string{"state": "cancelled"}, nil
+}
+
+var VmProvisionTool = &mcpgo.Tool{
+	Name:        "vm.provision",
+	Title:       "Provision the guest",
+	Description: "Install or upgrade the guest tools over SSH. Run this after the install and after every update.",
+}
+
+func (s *Service) rdpPassword() (string, error) {
+	lookup := exec.Command("secret-tool", "lookup", "service", "phial", "kind", "rdp-password")
+
+	if output, err := lookup.Output(); err == nil {
+		if password := strings.TrimSpace(string(output)); password != "" {
+			return password, nil
+		}
+	}
+
+	raw := make([]byte, 24)
+	if _, err := rand.Read(raw); err != nil {
+		return "", err
+	}
+
+	password := hex.EncodeToString(raw)
+
+	store := exec.Command("secret-tool", "store", "--label="+i18n.L("Phial RDP password"), "service", "phial", "kind", "rdp-password")
+	store.Stdin = strings.NewReader(password)
+
+	if err := store.Run(); err != nil {
+		return "", fmt.Errorf("could not store the RDP password in the secret service: %w", err)
+	}
+
+	return password, nil
+}
+
+func (s *Service) RdpPassword() string {
+	password, _ := s.rdpPassword()
+
+	return password
+}
+
+func (s *Service) VmProvision(ctx context.Context, req *mcpgo.CallToolRequest, input NameInput) (*mcpgo.CallToolResult, any, error) {
+	def, err := virt.Load(input.Name)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	password, err := s.rdpPassword()
+	if err != nil {
+		return nil, nil, err
+	}
+
+	binary, err := os.Executable()
+	if err != nil {
+		return nil, nil, err
+	}
+
+	if err := guest.Provision(def, "host.internal", "/mnt/hostshare", "/mnt/phial-secrets", "52:54:00:5e:a1:02", binary, password); err != nil {
+		return nil, nil, err
+	}
+
+	return nil, map[string]string{"state": "provisioned"}, nil
+}
