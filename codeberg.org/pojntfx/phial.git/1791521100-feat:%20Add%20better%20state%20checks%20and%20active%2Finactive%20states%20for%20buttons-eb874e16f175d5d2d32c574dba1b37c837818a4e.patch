diff --git a/internal/mcp/tools_display.go b/internal/mcp/tools_display.go
new file mode 100644
index 0000000000000000000000000000000000000000..52abded767d8057fd73f89e787ad22019eac769a
--- /dev/null
+++ b/internal/mcp/tools_display.go
@@ -0,0 +1,292 @@
+package mcp
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"time"
+
+	mcpgo "github.com/modelcontextprotocol/go-sdk/mcp"
+
+	"codeberg.org/pojntfx/phial/internal/virt"
+)
+
+var (
+	DisplaySetModeTool = &mcpgo.Tool{
+		Name:        "display.setMode",
+		Title:       "Set the display mode",
+		Description: "Set one VM display mode to egl-headless, gtk, or none, and restart the VM.",
+	}
+
+	DisplayRunAppTool = &mcpgo.Tool{
+		Name:        "display.runApp",
+		Title:       "Run an app through waypipe",
+		Description: "Run one guest app over waypipe on the host display.",
+	}
+
+	DisplayOpenRdpTool = &mcpgo.Tool{
+		Name:        "display.openRdp",
+		Title:       "Open the RDP session",
+		Description: "Open the full desktop session of one VM over RDP.",
+	}
+
+	DisplayOpenSerialTool = &mcpgo.Tool{
+		Name:        "display.openSerial",
+		Title:       "Show the serial console path",
+		Description: "Print the serial console socket path of one VM for socat attach.",
+		Annotations: &mcpgo.ToolAnnotations{ReadOnlyHint: true},
+	}
+)
+
+type DisplayModeInput struct {
+	VM   string `json:"vm" jsonschema:"the VM name"`
+	Mode string `json:"mode" jsonschema:"egl-headless, gtk, or none"`
+}
+
+func (s *Service) DisplaySetMode(ctx context.Context, req *mcpgo.CallToolRequest, input DisplayModeInput) (*mcpgo.CallToolResult, any, error) {
+	def, err := virt.Load(input.VM)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	switch input.Mode {
+	case "egl-headless", "gtk", "none":
+	default:
+		return nil, nil, fmt.Errorf("unknown display mode %q", input.Mode)
+	}
+
+	def.Display = input.Mode
+
+	if err := def.Save(); err != nil {
+		return nil, nil, err
+	}
+
+	if active, _ := def.Active(); active {
+		if err := def.Stop(); err != nil {
+			return nil, nil, err
+		}
+
+		if err := def.Start(); err != nil {
+			return nil, nil, err
+		}
+	}
+
+	return nil, map[string]string{"state": input.Mode}, nil
+}
+
+type RunAppInput struct {
+	Mode    string `json:"mode,omitempty" jsonschema:"waypipe shows the window on the host, session shows it in the remote desktop, optional"`
+	VM      string `json:"vm" jsonschema:"the VM name"`
+	Command string `json:"command" jsonschema:"the guest command line to run"`
+}
+
+type GuestApp struct {
+	Name string `json:"name" jsonschema:"the application name"`
+	ID   string `json:"id" jsonschema:"the desktop file ID"`
+	Exec string `json:"exec" jsonschema:"the executable to run"`
+}
+
+var ListGuestAppsTool = &mcpgo.Tool{
+	Name:        "display.listApps",
+	Title:       "List guest applications",
+	Description: "List applications from the guest's desktop database with their real names.",
+	Annotations: &mcpgo.ToolAnnotations{ReadOnlyHint: true},
+}
+
+type ListAppsInput struct {
+	VM string `json:"vm" jsonschema:"the VM name"`
+}
+
+type ListAppsOutput struct {
+	Apps []GuestApp `json:"apps" jsonschema:"the guest applications"`
+}
+
+func (s *Service) ListGuestApps(ctx context.Context, req *mcpgo.CallToolRequest, input ListAppsInput) (*mcpgo.CallToolResult, *ListAppsOutput, error) {
+	def, err := virt.Load(input.VM)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	script := `for dir in /usr/share/applications "$HOME/.local/share/applications"; do
+  [ -d "$dir" ] || continue
+
+  for file in "$dir"/*.desktop; do
+    [ -f "$file" ] || continue
+
+    grep -q '^Type=Application' "$file" 2>/dev/null || continue
+    grep -q '^NoDisplay=true' "$file" 2>/dev/null && continue
+
+    name=$(grep -m1 '^Name=' "$file" 2>/dev/null | cut -d= -f2-)
+    [ -n "$name" ] || continue
+
+    exec=$(grep -m1 '^Exec=' "$file" 2>/dev/null | cut -d= -f2-)
+    exec=$(printf '%s' "$exec" | sed 's/%[a-zA-Z]//g')
+
+    set -- $exec
+
+    if [ "${1:-}" = "env" ]; then
+      shift
+      while [ $# -gt 0 ] && printf '%s' "$1" | grep -q '='; do shift; done
+    fi
+
+    exec="${1:-}"
+    [ -n "$exec" ] || continue
+
+    printf '%s	%s	%s
+' "$(basename "$file" .desktop)" "$name" "$exec"
+  done
+done | sort -u -k2 | head -200`
+
+	cmd := virt.SSHCommand(def.Name, script)
+
+	output, err := cmd.Output()
+	if err != nil {
+		return nil, nil, fmt.Errorf("could not list guest apps: %w", err)
+	}
+
+	out := &ListAppsOutput{}
+
+	for _, line := range strings.Split(strings.TrimSpace(string(output)), "\n") {
+		parts := strings.Split(line, "\t")
+		if len(parts) != 3 {
+			continue
+		}
+
+		out.Apps = append(out.Apps, GuestApp{Name: parts[1], ID: parts[0], Exec: parts[2]})
+	}
+
+	return nil, out, nil
+}
+
+func (s *Service) DisplayRunApp(ctx context.Context, req *mcpgo.CallToolRequest, input RunAppInput) (*mcpgo.CallToolResult, any, error) {
+	if input.Command == "" {
+		return nil, nil, fmt.Errorf("give a command to run")
+	}
+
+	def, err := virt.Load(input.VM)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	port := "5000"
+
+	if err := ensureWaypipe(def, port); err != nil {
+		return nil, nil, err
+	}
+
+	display := "waypipe"
+
+	if input.Mode == "session" {
+		display = "wayland-0"
+	}
+
+	server := virt.SSHCommand(def.Name, "G_APPLICATION_NON_UNIQUE=1 GDK_BACKEND=wayland WAYLAND_DISPLAY="+display+" XDG_SESSION_TYPE=wayland XDG_RUNTIME_DIR=/run/user/1000 "+input.Command)
+	if err := server.Start(); err != nil {
+		return nil, nil, err
+	}
+
+	go func() {
+		_ = server.Wait()
+	}()
+
+	return nil, map[string]string{"state": "running"}, nil
+}
+
+func ensureWaypipe(def virt.Definition, port string) error {
+	pattern := fmt.Sprintf("waypipe --vsock -s %d:%s client", def.GuestCIDValue(), port)
+
+	if err := exec.Command("pgrep", "-f", pattern).Run(); err != nil {
+		if err := virt.SSHCommand(def.Name, "systemctl --user start phial-waypipe.service").Run(); err != nil {
+			return fmt.Errorf("could not start the guest waypipe server: %w", err)
+		}
+
+		client := exec.Command("waypipe", "--vsock", "-s", fmt.Sprintf("%d:%s", def.GuestCIDValue(), port), "client")
+		client.Env = os.Environ()
+
+		if err := client.Start(); err != nil {
+			return fmt.Errorf("could not start the waypipe client: %w", err)
+		}
+
+		go func() { _ = client.Wait() }()
+
+		time.Sleep(2 * time.Second)
+	}
+
+	return nil
+}
+
+type RdpInput struct {
+	VM string `json:"vm" jsonschema:"the VM name"`
+}
+
+func (s *Service) syncRdpCredentials(def virt.Definition, password string) error {
+	script := "echo \"phial:" + password + "\" | sudo chpasswd && " +
+		"sudo grdctl --system rdp set-credentials phial '" + password + "' && " +
+		"sudo systemctl restart gnome-remote-desktop"
+
+	return virt.SSHExec(def.Name, script)
+}
+
+func (s *Service) DisplayOpenRdp(ctx context.Context, req *mcpgo.CallToolRequest, input RdpInput) (*mcpgo.CallToolResult, any, error) {
+	def, err := virt.Load(input.VM)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	password, err := s.rdpPassword()
+	if err != nil {
+		return nil, nil, err
+	}
+
+	if err := s.syncRdpCredentials(def, password); err != nil {
+		return nil, nil, fmt.Errorf("could not set the RDP credentials in the guest: %w", err)
+	}
+
+	if err := s.unitStart("phial-guest-port@3389.service"); err != nil {
+		return nil, nil, err
+	}
+
+	command := exec.Command("xfreerdp", "/v:[::1]:3389", "/u:"+input.VM, "/p:"+password, "/cert:ignore", "+clipboard", "/sound", "/dynamic-resolution")
+
+	var output strings.Builder
+	command.Stdout = &output
+	command.Stderr = &output
+
+	if err := command.Start(); err != nil {
+		return nil, nil, err
+	}
+
+	done := make(chan error, 1)
+	go func() { done <- command.Wait() }()
+
+	select {
+	case err := <-done:
+		message := strings.TrimSpace(output.String())
+
+		if lines := strings.Split(message, "\n"); len(lines) > 6 {
+			message = strings.Join(lines[len(lines)-6:], "\n")
+		}
+
+		if err != nil {
+			return nil, nil, fmt.Errorf("the RDP client stopped: %s", message)
+		}
+
+		return nil, nil, fmt.Errorf("the RDP client stopped at once: %s", message)
+	case <-time.After(6 * time.Second):
+		return nil, map[string]string{"state": "running"}, nil
+	}
+}
+
+func (s *Service) DisplayOpenSerial(ctx context.Context, req *mcpgo.CallToolRequest, input RdpInput) (*mcpgo.CallToolResult, any, error) {
+	def, err := virt.Load(input.VM)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	path := filepath.Join(def.RuntimePathValue(), "console.sock")
+
+	return nil, map[string]string{"socket": path, "attach": "socat - UNIX-CONNECT:" + path}, nil
+}
diff --git a/internal/mcp/tools_forwards.go b/internal/mcp/tools_forwards.go
new file mode 100644
index 0000000000000000000000000000000000000000..d2abc8a0eda770fc2c7f47f6d7f837de10662c44
--- /dev/null
+++ b/internal/mcp/tools_forwards.go
@@ -0,0 +1,166 @@
+package mcp
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	mcpgo "github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+var (
+	ForwardLsTool = &mcpgo.Tool{
+		Name:        "forward.ls",
+		Title:       "List forwards",
+		Description: "List the forwards between the host and the guest with their state.",
+		Annotations: &mcpgo.ToolAnnotations{ReadOnlyHint: true},
+	}
+
+	ForwardStartTool = &mcpgo.Tool{
+		Name:        "forward.start",
+		Title:       "Start a forward",
+		Description: "Start one forward, for example an agent socket window.",
+	}
+
+	ForwardStopTool = &mcpgo.Tool{
+		Name:        "forward.stop",
+		Title:       "Stop a forward",
+		Description: "Stop one forward and close the window.",
+	}
+
+	ForwardAddTool = &mcpgo.Tool{
+		Name:        "forward.add",
+		Title:       "Add a forward",
+		Description: "Add one new forward: a TCP port or a unix socket on a vsock port.",
+	}
+
+	ForwardRemoveTool = &mcpgo.Tool{
+		Name:        "forward.remove",
+		Title:       "Remove a forward",
+		Description: "Remove one forward and its configuration.",
+	}
+)
+
+type ForwardInfo struct {
+	Name   string `json:"name" jsonschema:"the forward name"`
+	Listen string `json:"listen" jsonschema:"the listen address"`
+	Target string `json:"target" jsonschema:"the target address"`
+	Active bool   `json:"active" jsonschema:"whether the forward runs"`
+}
+
+type ForwardLsOutput struct {
+	Forwards []ForwardInfo `json:"forwards" jsonschema:"the forward list"`
+}
+
+func (s *Service) forwardConfPath(name string) string {
+	return filepath.Join(s.state.ConfigDir(), "forward-"+name+".conf")
+}
+
+func (s *Service) ForwardLs(ctx context.Context, req *mcpgo.CallToolRequest, input struct{}) (*mcpgo.CallToolResult, *ForwardLsOutput, error) {
+	entries, err := os.ReadDir(s.state.ConfigDir())
+	if err != nil {
+		return nil, nil, err
+	}
+
+	out := &ForwardLsOutput{}
+
+	for _, entry := range entries {
+		name := entry.Name()
+
+		if !strings.HasPrefix(name, "forward-") || !strings.HasSuffix(name, ".conf") {
+			continue
+		}
+
+		short := strings.TrimSuffix(strings.TrimPrefix(name, "forward-"), ".conf")
+
+		data, err := os.ReadFile(s.forwardConfPath(short))
+		if err != nil {
+			continue
+		}
+
+		info := ForwardInfo{Name: short}
+
+		for _, line := range strings.Split(string(data), "\n") {
+			if value, ok := strings.CutPrefix(line, "PHIAL_LISTEN="); ok {
+				info.Listen = value
+			}
+
+			if value, ok := strings.CutPrefix(line, "PHIAL_TARGET="); ok {
+				info.Target = value
+			}
+		}
+
+		active, err := s.unitActive("phial-forward@" + short + ".service")
+		if err == nil {
+			info.Active = active
+		}
+
+		out.Forwards = append(out.Forwards, info)
+	}
+
+	return nil, out, nil
+}
+
+func (s *Service) ForwardStart(ctx context.Context, req *mcpgo.CallToolRequest, input NameInput) (*mcpgo.CallToolResult, any, error) {
+	if err := s.unitStart("phial-forward@" + input.Name + ".service"); err != nil {
+		return nil, nil, err
+	}
+
+	return nil, map[string]string{"state": "started"}, nil
+}
+
+func (s *Service) ForwardStop(ctx context.Context, req *mcpgo.CallToolRequest, input NameInput) (*mcpgo.CallToolResult, any, error) {
+	if err := s.unitStop("phial-forward@" + input.Name + ".service"); err != nil {
+		return nil, nil, err
+	}
+
+	return nil, map[string]string{"state": "stopped"}, nil
+}
+
+type ForwardInput struct {
+	Name string `json:"name" jsonschema:"the forward name"`
+	Kind string `json:"kind" jsonschema:"tcp or unix"`
+	Port int    `json:"port" jsonschema:"the vsock port number"`
+	Path string `json:"path" jsonschema:"the host unix socket path, for unix forwards"`
+}
+
+func (s *Service) ForwardAdd(ctx context.Context, req *mcpgo.CallToolRequest, input ForwardInput) (*mcpgo.CallToolResult, any, error) {
+	if input.Name == "" || input.Port < 1024 || input.Port > 65535 {
+		return nil, nil, fmt.Errorf("give a name and a vsock port above 1024")
+	}
+
+	var target string
+
+	switch input.Kind {
+	case "tcp":
+		target = fmt.Sprintf("TCP:[::1]:%d", input.Port)
+	case "unix":
+		if input.Path == "" {
+			return nil, nil, fmt.Errorf("a unix forward needs a host socket path")
+		}
+
+		target = "UNIX-CONNECT:" + input.Path
+	default:
+		return nil, nil, fmt.Errorf("kind must be tcp or unix")
+	}
+
+	content := fmt.Sprintf("PHIAL_LISTEN=VSOCK-LISTEN:%d,fork,reuseaddr\nPHIAL_TARGET=%s\n", input.Port, target)
+
+	if err := os.WriteFile(s.forwardConfPath(input.Name), []byte(content), 0o600); err != nil {
+		return nil, nil, err
+	}
+
+	return nil, map[string]string{"state": "added"}, nil
+}
+
+func (s *Service) ForwardRemove(ctx context.Context, req *mcpgo.CallToolRequest, input NameInput) (*mcpgo.CallToolResult, any, error) {
+	_ = s.unitStop("phial-forward@" + input.Name + ".service")
+
+	if err := os.Remove(s.forwardConfPath(input.Name)); err != nil {
+		return nil, nil, err
+	}
+
+	return nil, map[string]string{"state": "removed"}, nil
+}
