+
+func (a *App) showPage(name string) {
+	if a.contentNav != nil {
+		a.contentNav.PopToTag("home")
+		a.detail = nil
+	}
+	for i, p := range pageDefs {
+		if p.name == name {
+			a.visible = name
+			a.stack.SetVisibleChildName(name)
+			if a.sidebarList != nil {
+				a.syncing = true
+				if row := a.sidebarList.GetRowAtIndex(int32(i)); row != nil {
+					a.sidebarList.SelectRow(row)
+				}
+				a.syncing = false
+			}
+			if a.split != nil && a.split.GetCollapsed() {
+				a.split.SetShowContent(true)
+			}
+			return
+		}
+	}
+}
+
+func (a *App) refreshBanner() {
+	pending := len(a.Service.Pending())
+
+	if pending > 0 {
+		a.banner.SetTitle(fmt.Sprintf(i18n.L("%d requests need approval"), pending))
+		a.banner.SetButtonLabel(i18n.L("Review"))
+		a.banner.SetRevealed(true)
+		return
+	}
+
+	a.banner.SetRevealed(false)
+}
