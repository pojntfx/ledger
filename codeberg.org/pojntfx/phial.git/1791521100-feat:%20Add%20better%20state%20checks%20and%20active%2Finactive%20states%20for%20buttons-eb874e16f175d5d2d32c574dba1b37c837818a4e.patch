+func (a *App) comboRow(title string, labels, values []string, current string, onChange func(string)) *adw.ComboRow {
+	row := adw.NewComboRow()
+	row.SetTitle(title)
+	row.SetUseUnderline(true)
+
+	model := gtk.NewStringList(nil)
+	for _, label := range labels {
+		model.Append(label)
+	}
+	row.SetModel(model)
+
+	selected := uint32(0)
+	for i, v := range values {
+		if v == current {
+			selected = uint32(i)
+		}
+	}
+	row.SetSelected(selected)
+
+	var cb func(gobject.Object, uintptr)
+	cb = func(gobject.Object, uintptr) {
+		idx := row.GetSelected()
+		if int(idx) < len(values) {
+			onChange(values[idx])
+		}
+	}
+	row.ConnectNotify(&cb)
+	a.hold(&cb)
+
+	return row
+}
