@@ -0,0 +1,92 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"strings"
+	"time"
+)
+
+type rpcRequest struct {
+	JSONRPC string      `json:"jsonrpc"`
+	ID      int         `json:"id"`
+	Method  string      `json:"method"`
+	Params  interface{} `json:"params,omitempty"`
+}
+
+func main() {
+	if len(os.Args) < 3 {
+		fmt.Fprintln(os.Stderr, "usage: mcpctl <socket> <tool> [json-arguments]")
+		os.Exit(2)
+	}
+
+	socket := os.Args[1]
+	tool := os.Args[2]
+
+	arguments := "{}"
+	if len(os.Args) > 3 {
+		arguments = os.Args[3]
+	}
+
+	client := &http.Client{
+		Transport: &http.Transport{
+			DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+				return (&net.Dialer{}).DialContext(ctx, "unix", socket)
+			},
+		},
+		Timeout: 15 * time.Minute,
+	}
+
+	call := func(method string, params interface{}, session string) (string, string) {
+		body, _ := json.Marshal(rpcRequest{JSONRPC: "2.0", ID: 1, Method: method, Params: params})
+
+		request, err := http.NewRequest(http.MethodPost, "http://localhost/mcp", bytes.NewReader(body))
+		if err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(1)
+		}
+
+		request.Header.Set("Content-Type", "application/json")
+		request.Header.Set("Accept", "application/json, text/event-stream")
+
+		if session != "" {
+			request.Header.Set("Mcp-Session-Id", session)
+		}
+
+		response, err := client.Do(request)
+		if err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(1)
+		}
+		defer response.Body.Close()
+
+		data, _ := io.ReadAll(response.Body)
+
+		return response.Header.Get("Mcp-Session-Id"), string(data)
+	}
+
+	session, _ := call("initialize", map[string]interface{}{
+		"protocolVersion": "2025-06-18",
+		"capabilities":    map[string]interface{}{},
+		"clientInfo":      map[string]string{"name": "mcpctl", "version": "1"},
+	}, "")
+
+	call("notifications/initialized", map[string]interface{}{}, session)
+
+	_, result := call("tools/call", map[string]interface{}{
+		"name":      tool,
+		"arguments": json.RawMessage(arguments),
+	}, session)
+
+	for _, line := range strings.Split(result, "\n") {
+		if strings.HasPrefix(line, "data: ") {
+			fmt.Println(strings.TrimPrefix(line, "data: "))
+		}
+	}
+}
