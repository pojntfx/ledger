@@ -0,0 +1,191 @@
+package setup
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"strings"
+)
+
+type Check struct {
+	Name string
+	OK   bool
+	Note string
+}
+
+func qemuHelp(args ...string) string {
+	output, _ := exec.Command("qemu-system-x86_64", args...).CombinedOutput()
+
+	return string(output)
+}
+
+func contains(haystack, needle string) bool {
+	return strings.Contains(haystack, needle)
+}
+
+func toolPresent(name string) bool {
+	_, err := exec.LookPath(name)
+
+	return err == nil
+}
+
+func fileExists(path string) bool {
+	_, err := os.Stat(path)
+
+	return err == nil
+}
+
+func Acceptance() []Check {
+	var checks []Check
+
+	add := func(name string, ok bool, note string) {
+		checks = append(checks, Check{name, ok, note})
+	}
+
+	add("display backend lists egl-headless", contains(qemuHelp("-display", "help"), "egl-headless"), "")
+	add("virtio-vga-gl lists venus", contains(qemuHelp("-device", "virtio-vga-gl,help"), "venus"), "")
+	add("virtio-vga-gl lists drm_native_context", contains(qemuHelp("-device", "virtio-vga-gl,help"), "drm_native_context"), "")
+
+	for _, device := range []string{"qemu-xhci", "vhost-vsock-pci", "vhost-user-fs-pci", "virtio-blk-pci"} {
+		add("device help lists "+device, contains(qemuHelp("-device", "help"), device), "")
+	}
+
+	add("q35 machine help lists smm", contains(qemuHelp("-machine", "q35,help"), "smm"), "")
+	add("q35 accepts kernel-irqchip=split", probeIRQChip(), "not listed in q35,help on this QEMU")
+
+	version, err := exec.Command("virtiofsd", "--version").Output()
+	add("virtiofsd reports the Rust backend", err == nil && regexp.MustCompile(`^virtiofsd 1.`).MatchString(strings.TrimSpace(string(version))), "")
+
+	add("virt-fw-vars lists a DER enrollment flag", contains(func() string {
+		output, _ := exec.Command("virt-fw-vars", "--help").CombinedOutput()
+
+		return string(output)
+	}(), "add-mok"), "")
+
+	add("netdev help lists passt", contains(qemuHelp("-netdev", "help"), "passt"), "")
+
+	add("caddy is 2.11 or newer for SIGUSR1 reload", caddyModern(), "")
+	add("kvm device exists", fileExists("/dev/kvm"), "")
+	add("vhost-vsock device exists", fileExists("/dev/vhost-vsock"), "")
+	add("OVMF secboot code file exists", fileExists("/usr/share/edk2/ovmf/OVMF_CODE.secboot.fd"), "")
+	add("OVMF secboot vars file exists", fileExists("/usr/share/edk2/ovmf/OVMF_VARS.secboot.fd"), "")
+	add("firmware descriptor declares requires-smm", descriptorRequiresSMM(), "")
+	add("nested virtualization is on", nestedOn(), "")
+
+	for _, tool := range []string{"swtpm", "passt", "socat", "gpg", "ssh-add", "secret-tool", "zenity", "wl-copy", "xfreerdp", "mokutil", "pinentry"} {
+		add(tool+" is installed", toolPresent(tool), "")
+	}
+
+	return checks
+}
+
+func probeIRQChip() bool {
+	command := exec.Command("qemu-system-x86_64", "-machine", "q35,accel=tcg,kernel-irqchip=split", "-display", "none", "-nodefaults", "-S", "-monitor", "none", "-serial", "none", "-parallel", "none")
+
+	if err := command.Start(); err != nil {
+		return false
+	}
+
+	done := make(chan error, 1)
+	go func() {
+		done <- command.Wait()
+	}()
+
+	select {
+	case <-done:
+		return false
+	default:
+		_ = command.Process.Kill()
+		<-done
+
+		return true
+	}
+}
+
+func caddyModern() bool {
+	output, err := exec.Command("caddy", "version").Output()
+	if err != nil {
+		return false
+	}
+
+	parts := strings.Split(strings.TrimPrefix(strings.TrimSpace(string(output)), "v"), ".")
+	if len(parts) < 2 {
+		return false
+	}
+
+	major := atoi(parts[0])
+	minor := atoi(parts[1])
+
+	return major > 2 || (major == 2 && minor >= 11)
+}
+
+func atoi(text string) int {
+	value := 0
+
+	for _, r := range text {
+		if r < '0' || r > '9' {
+			break
+		}
+
+		value = value*10 + int(r-'0')
+	}
+
+	return value
+}
+
+func descriptorRequiresSMM() bool {
+	matches, _ := filepath.Glob("/usr/share/qemu/firmware/*.json")
+
+	for _, match := range matches {
+		data, err := os.ReadFile(match)
+		if err != nil {
+			continue
+		}
+
+		content := string(data)
+		if strings.Contains(content, "requires-smm") && strings.Contains(content, "OVMF_CODE.secboot.fd") {
+			return true
+		}
+	}
+
+	return false
+}
+
+func nestedOn() bool {
+	for _, path := range []string{"/sys/module/kvm_intel/parameters/nested", "/sys/module/kvm_amd/parameters/nested"} {
+		data, err := os.ReadFile(path)
+		if err != nil {
+			continue
+		}
+
+		value := strings.TrimSpace(string(data))
+		if value == "Y" || value == "1" {
+			return true
+		}
+	}
+
+	return false
+}
+
+func PrintAcceptance(checks []Check) int {
+	failures := 0
+
+	for _, check := range checks {
+		status := "PASS"
+		if !check.OK {
+			status = "FAIL"
+			failures++
+		}
+
+		note := ""
+		if check.Note != "" {
+			note = " (" + check.Note + ")"
+		}
+
+		fmt.Printf("%s %s%s\n", status, check.Name, note)
+	}
+
+	return failures
+}
diff --git a/internal/setup/install.go b/internal/setup/install.go
new file mode 100644
index 0000000000000000000000000000000000000000..ce4c469f01d1f585258fba0d29e6ad6ad552bb61
--- /dev/null
+++ b/internal/setup/install.go
@@ -0,0 +1,300 @@
+package setup
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+
+	"github.com/adrg/xdg"
+
+	"codeberg.org/pojntfx/phial/internal/virt"
+)
+
+type InstallOptions struct {
+	RepoDir   string
+	BrewRoot  string
+	Overwrite bool
+}
+
+func toolPath(name string) (string, error) {
+	path, err := exec.LookPath(name)
+	if err != nil {
+		return "", fmt.Errorf("tool %s not found in PATH", name)
+	}
+
+	return path, nil
+}
+
+func installFile(data []byte, target string, mode os.FileMode, overwrite bool) error {
+	if _, err := os.Stat(target); err == nil && !overwrite {
+		return nil
+	}
+
+	if err := os.MkdirAll(filepath.Dir(target), 0o700); err != nil {
+		return err
+	}
+
+	return os.WriteFile(target, data, mode)
+}
+
+func Install(options InstallOptions) error {
+	if options.RepoDir == "" {
+		return fmt.Errorf("no repository directory given")
+	}
+
+	configHome := xdg.ConfigHome
+	runtimeDir := xdg.RuntimeDir
+	if runtimeDir == "" {
+		runtimeDir = fmt.Sprintf("/run/user/%d", os.Getuid())
+	}
+
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return err
+	}
+
+	phialConfig := filepath.Join(configHome, "phial")
+	unitDir := filepath.Join(configHome, "systemd", "user")
+	dataDir := filepath.Join(xdg.DataHome, "phial")
+
+	for _, dir := range []string{phialConfig, filepath.Join(phialConfig, "keys"), unitDir, filepath.Join(dataDir, "hostshare"), filepath.Join(home, ".local", "bin"), filepath.Join(home, ".local", "share", "applications")} {
+		if err := os.MkdirAll(dir, 0o700); err != nil {
+			return err
+		}
+	}
+
+	self, err := os.Executable()
+	if err != nil {
+		return err
+	}
+
+	binary, err := os.ReadFile(self)
+	if err != nil {
+		return err
+	}
+
+	if err := installFile(binary, filepath.Join(home, ".local", "bin", "phial"), 0o755, true); err != nil {
+		return err
+	}
+
+	tools := map[string]string{}
+
+	for _, name := range []string{"caddy", "virtiofsd", "swtpm", "socat", "ssh-agent"} {
+		path, err := toolPath(name)
+		if err != nil {
+			return err
+		}
+
+		tools[name] = path
+	}
+
+	brewPrefix := options.BrewRoot
+	if brewPrefix == "" {
+		brewPrefix = "/home/linuxbrew/.linuxbrew"
+	}
+
+	units, err := os.ReadDir(filepath.Join(options.RepoDir, "host", "systemd"))
+	if err != nil {
+		return err
+	}
+
+	wanted := map[string]bool{}
+
+	for _, unit := range units {
+		if unit.IsDir() || !strings.HasSuffix(unit.Name(), ".service") {
+			continue
+		}
+
+		wanted[unit.Name()] = true
+	}
+
+	installed, err := os.ReadDir(unitDir)
+	if err != nil {
+		return err
+	}
+
+	for _, unit := range installed {
+		if unit.IsDir() || !strings.HasPrefix(unit.Name(), "phial-") || !strings.HasSuffix(unit.Name(), ".service") {
+			continue
+		}
+
+		if wanted[unit.Name()] {
+			continue
+		}
+
+		if err := os.Remove(filepath.Join(unitDir, unit.Name())); err != nil {
+			return err
+		}
+	}
+
+	for _, unit := range units {
+		if unit.IsDir() || !strings.HasSuffix(unit.Name(), ".service") {
+			continue
+		}
+
+		data, err := os.ReadFile(filepath.Join(options.RepoDir, "host", "systemd", unit.Name()))
+		if err != nil {
+			return err
+		}
+
+		text := string(data)
+		text = strings.ReplaceAll(text, "@BREW_PREFIX@", brewPrefix)
+		text = strings.ReplaceAll(text, "@CADDY@", tools["caddy"])
+		text = strings.ReplaceAll(text, "@VIRTIOFSD@", tools["virtiofsd"])
+		text = strings.ReplaceAll(text, "@SWTPM@", tools["swtpm"])
+		text = strings.ReplaceAll(text, "@SOCAT@", tools["socat"])
+		text = strings.ReplaceAll(text, "@SSH_AGENT@", tools["ssh-agent"])
+
+		if err := installFile([]byte(text), filepath.Join(unitDir, unit.Name()), 0o644, true); err != nil {
+			return err
+		}
+	}
+
+	for _, pair := range [][2]string{
+		{"share-hostshare.conf", "PHIAL_SHARE_DIR=" + filepath.Join(dataDir, "hostshare") + "\n"},
+		{"share-phial-secrets.conf", "PHIAL_SHARE_DIR=" + filepath.Join(runtimeDir, "phial", "secrets") + "\n"},
+		{"forward-proxy.conf", "PHIAL_LISTEN=VSOCK-LISTEN:4000,fork,reuseaddr\nPHIAL_TARGET=TCP:[::1]:4000\n"},
+		{"forward-ssh-agent.conf", "PHIAL_LISTEN=VSOCK-LISTEN:5551,fork,reuseaddr\nPHIAL_TARGET=UNIX-CONNECT:" + filepath.Join(runtimeDir, "phial", "agent", "ssh.sock") + "\n"},
+		{"forward-gpg-extra.conf", "PHIAL_LISTEN=VSOCK-LISTEN:5552,fork,reuseaddr\nPHIAL_TARGET=UNIX-CONNECT:" + filepath.Join(runtimeDir, "gnupg", "S.gpg-agent.extra") + "\n"},
+	} {
+		if err := installFile([]byte(pair[1]), filepath.Join(phialConfig, pair[0]), 0o644, true); err != nil {
+			return err
+		}
+	}
+
+	defaults := map[string]string{
+		"mapping":   "# name mode source upstream\n# openai proxy keepassxc://openai https://api.openai.com\n# github_token env keepassxc://github_token -\n",
+		"Caddyfile": "{\n\tadmin off\n}\n\n:4000 {\n\tbind ::1\n\thandle {\n\t\trespond 404\n\t}\n}\n",
+	}
+
+	for name, content := range defaults {
+		if err := installFile([]byte(content), filepath.Join(phialConfig, name), 0o600, false); err != nil {
+			return err
+		}
+	}
+
+	sshConfig := filepath.Join(home, ".ssh", "config")
+	sshBlock := "\n# >>> phial >>>\nInclude " + filepath.Join(configHome, "phial", "ssh_config") + "\n# <<< phial <<<\n"
+
+	if err := virt.WriteSSHConfig(); err != nil {
+		return err
+	}
+
+	if err := prependBlock(sshConfig, sshBlock, "# >>> phial >>>"); err != nil {
+		return err
+	}
+
+	gnupgDir := filepath.Join(home, ".gnupg")
+	if err := os.MkdirAll(gnupgDir, 0o700); err != nil {
+		return err
+	}
+
+	gpgAgent := filepath.Join(gnupgDir, "gpg-agent.conf")
+	gpgBlock := "\n# phial\npinentry-program /usr/bin/pinentry-gnome3\n"
+
+	if err := appendBlock(gpgAgent, gpgBlock, "# phial"); err != nil {
+		return err
+	}
+
+	for _, desktop := range []string{"com.pojtinger.felicitas.Phial.desktop"} {
+		data, err := os.ReadFile(filepath.Join(options.RepoDir, "assets", "meta", desktop))
+		if err != nil {
+			continue
+		}
+
+		if err := installFile(data, filepath.Join(home, ".local", "share", "applications", desktop), 0o644, true); err != nil {
+			return err
+		}
+	}
+
+	_ = exec.Command("systemctl", "--user", "daemon-reload").Run()
+	_ = exec.Command("systemctl", "--user", "enable", "--now", "phial-forward@proxy.service").Run()
+	_ = exec.Command("systemctl", "--user", "enable", "--now", "phial-forward@mcp.service").Run()
+
+	fmt.Println("phial installed")
+
+	return nil
+}
+
+func appendBlock(path, block, marker string) error {
+	data, err := os.ReadFile(path)
+	if err != nil && !os.IsNotExist(err) {
+		return err
+	}
+
+	if strings.Contains(string(data), marker) {
+		return nil
+	}
+
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return err
+	}
+
+	file, err := os.OpenFile(path, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o600)
+	if err != nil {
+		return err
+	}
+	defer file.Close()
+
+	_, err = file.WriteString(block)
+
+	return err
+}
+
+func prependBlock(path, block, marker string) error {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		if !os.IsNotExist(err) {
+			return err
+		}
+
+		return os.WriteFile(path, []byte(strings.TrimSpace(block)+"\n"), 0o600)
+	}
+
+	content := string(data)
+
+	if start := strings.Index(content, marker); start >= 0 {
+		if end := strings.Index(content[start:], "# <<< phial <<<"); end >= 0 {
+			content = content[:start] + content[start+end+len("# <<< phial <<<"):]
+			content = strings.TrimLeft(content, "\n")
+		}
+	}
+
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return err
+	}
+
+	return os.WriteFile(path, []byte(strings.TrimSpace(block)+"\n\n"+content), 0o600)
+}
+
+func replaceBlock(path, block, marker string) error {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		if !os.IsNotExist(err) {
+			return err
+		}
+
+		return appendBlock(path, block, marker)
+	}
+
+	content := string(data)
+	start := strings.Index(content, marker)
+
+	if start < 0 {
+		return appendBlock(path, block, marker)
+	}
+
+	end := strings.Index(content[start:], "# <<< phial <<<")
+
+	if end < 0 {
+		return appendBlock(path, block, marker)
+	}
+
+	end += start + len("# <<< phial <<<")
+
+	updated := content[:start] + strings.TrimSpace(block) + content[end:]
+
+	return os.WriteFile(path, []byte(updated), 0o600)
+}
diff --git a/internal/setup/rootsetup.go b/internal/setup/rootsetup.go
new file mode 100644
index 0000000000000000000000000000000000000000..714b2eff0e9be063790c48227c9953631b3b7d32
--- /dev/null
+++ b/internal/setup/rootsetup.go
@@ -0,0 +1,221 @@
+package setup
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"os/user"
+	"strconv"
+	"strings"
+)
+
+type RootSetupOptions struct {
+	Memory     string
+	USBDevices []string
+	Ethernet   string
+}
+
+func sysctlPages(memory string) (int, error) {
+	mib := 16384
+
+	if memory != "" {
+		last := memory[len(memory)-1]
+		digits := memory
+
+		switch last {
+		case 'G', 'g':
+			digits = memory[:len(memory)-1]
+
+			value, err := strconv.Atoi(digits)
+			if err != nil {
+				return 0, err
+			}
+
+			mib = value * 1024
+		case 'M', 'm':
+			value, err := strconv.Atoi(memory[:len(memory)-1])
+			if err != nil {
+				return 0, err
+			}
+
+			mib = value
+		}
+	}
+
+	return mib/2 + 256, nil
+}
+
+func RootSetup(options RootSetupOptions) error {
+	if os.Getuid() != 0 {
+		return errors.New("root setup needs root, run it with run0")
+	}
+
+	caller := os.Getenv("SUDO_USER")
+	if caller == "" {
+		caller = os.Getenv("PHIAL_USER")
+	}
+
+	if caller == "" {
+		return errors.New("set SUDO_USER or PHIAL_USER to the desktop user name")
+	}
+
+	account, err := user.Lookup(caller)
+	if err != nil {
+		return err
+	}
+
+	pages, err := sysctlPages(options.Memory)
+	if err != nil {
+		return err
+	}
+
+	if err := os.WriteFile("/etc/sysctl.d/99-phial-hugepages.conf",
+		[]byte(fmt.Sprintf("vm.nr_hugepages=%d\n", pages)), 0o644); err != nil {
+		return err
+	}
+
+	if output, err := exec.Command("sysctl", "-w", fmt.Sprintf("vm.nr_hugepages=%d", pages)).CombinedOutput(); err != nil {
+		return fmt.Errorf("sysctl: %s: %w", strings.TrimSpace(string(output)), err)
+	}
+
+	fmt.Printf("huge pages: %d\n", pages)
+
+	if err := os.WriteFile("/etc/modprobe.d/99-phial-nested.conf",
+		[]byte("options kvm-intel nested=1\noptions kvm-amd nested=1\n"), 0o644); err != nil {
+		return err
+	}
+
+	if err := os.MkdirAll("/etc/systemd/system/user@.service.d", 0o755); err != nil {
+		return err
+	}
+
+	if err := os.WriteFile("/etc/systemd/system/user@.service.d/99-phial-memlock.conf",
+		[]byte("[Service]\nLimitMEMLOCK=infinity\n"), 0o644); err != nil {
+		return err
+	}
+
+	_ = exec.Command("systemctl", "daemon-reload").Run()
+
+	if output, err := exec.Command("systemctl", "show", "-p", "MainPID", "--value", "user@"+account.Uid+".service").Output(); err == nil {
+		if pid, err := strconv.Atoi(strings.TrimSpace(string(output))); err == nil && pid > 0 {
+			_ = exec.Command("prlimit", "--pid", strconv.Itoa(pid), "--memlock=unlimited").Run()
+		}
+	}
+
+	var rules strings.Builder
+
+	for _, device := range options.USBDevices {
+		vendor, product, ok := strings.Cut(device, ":")
+		if !ok {
+			continue
+		}
+
+		fmt.Fprintf(&rules, "SUBSYSTEM==\"usb\", ATTR{idVendor}==\"%s\", ATTR{idProduct}==\"%s\", TAG+=\"uaccess\"\n", vendor, product)
+	}
+
+	if err := os.WriteFile("/etc/udev/rules.d/70-phial-usb.rules", []byte(rules.String()), 0o644); err != nil {
+		return err
+	}
+
+	if err := os.WriteFile("/etc/udev/rules.d/70-phial-vfio.rules",
+		[]byte("SUBSYSTEM==\"vfio\", KERNEL==\"*\", TAG+=\"uaccess\"\n"), 0o644); err != nil {
+		return err
+	}
+
+	_ = exec.Command("udevadm", "control", "--reload").Run()
+	_ = exec.Command("udevadm", "trigger", "--subsystem-match=usb").Run()
+	_ = exec.Command("udevadm", "trigger", "--subsystem-match=vfio").Run()
+
+	if output, err := exec.Command("dnf", "install", "-y", "waypipe", "virt-firmware", "keepassxc", "pinentry-gnome3").CombinedOutput(); err != nil {
+		return fmt.Errorf("dnf: %s: %w", strings.TrimSpace(string(output)), err)
+	}
+
+	if options.Ethernet != "" {
+		if err := bridgeSetup(options.Ethernet, account.Uid, account.Gid); err != nil {
+			return err
+		}
+	}
+
+	fmt.Println("root setup complete")
+
+	return nil
+}
+
+func bridgeSetup(ethernet, ownerUID, ownerGID string) error {
+	run := func(args ...string) error {
+		output, err := exec.Command("nmcli", args...).CombinedOutput()
+		if err != nil {
+			return fmt.Errorf("nmcli %s: %s: %w", strings.Join(args, " "), strings.TrimSpace(string(output)), err)
+		}
+
+		return nil
+	}
+
+	hasConnection := func(name string) bool {
+		return exec.Command("nmcli", "-t", "-f", "NAME", "connection", "show", name).Run() == nil
+	}
+
+	if !hasConnection("phialbr0") {
+		if err := run("connection", "add", "type", "bridge", "con-name", "phialbr0", "ifname", "phialbr0", "stp", "no", "ipv4.method", "auto", "ipv6.method", "auto"); err != nil {
+			return err
+		}
+	}
+
+	portName := "phialbr0-" + ethernet
+	if !hasConnection(portName) {
+		if err := run("connection", "add", "type", "bridge-slave", "con-name", portName, "ifname", ethernet, "master", "phialbr0"); err != nil {
+			return err
+		}
+	}
+
+	if !hasConnection("phialtap0") {
+		if err := run("connection", "add", "type", "tun", "con-name", "phialtap0", "ifname", "phialtap0", "mode", "tap", "owner", ownerUID, "group", ownerGID, "pi", "no", "vnet-hdr", "yes", "master", "phialbr0", "slave-type", "bridge", "autoconnect", "yes"); err != nil {
+			return err
+		}
+	}
+
+	_ = run("connection", "up", "phialbr0")
+	_ = run("connection", "up", portName)
+	_ = run("connection", "up", "phialtap0")
+
+	firewall := func(args ...string) error {
+		output, err := exec.Command("firewall-cmd", args...).CombinedOutput()
+		if err != nil {
+			return fmt.Errorf("firewall-cmd %s: %s: %w", strings.Join(args, " "), strings.TrimSpace(string(output)), err)
+		}
+
+		return nil
+	}
+
+	for _, step := range [][]string{
+		{"--permanent", "--zone=FedoraWorkstation", "--add-interface=phialbr0"},
+		{"--permanent", "--zone=FedoraWorkstation", "--add-interface=phialtap0"},
+		{"--permanent", "--zone=FedoraWorkstation", "--add-forward"},
+		{"--reload"},
+	} {
+		if err := firewall(step...); err != nil {
+			return err
+		}
+	}
+
+	fmt.Printf("bridge: phialbr0 with %s and phialtap0\n", ethernet)
+
+	return nil
+}
+
+func FirstEthernet() string {
+	output, err := exec.Command("nmcli", "-t", "-f", "DEVICE,TYPE", "device").Output()
+	if err != nil {
+		return ""
+	}
+
+	for _, line := range strings.Split(string(output), "\n") {
+		parts := strings.Split(line, ":")
+		if len(parts) == 2 && parts[1] == "ethernet" {
+			return parts[0]
+		}
+	}
+
+	return ""
+}
diff --git a/internal/state/agent.go b/internal/state/agent.go
new file mode 100644
index 0000000000000000000000000000000000000000..92cd37001cd3cdd1b00d05f9707c4f9eedd862f3
--- /dev/null
+++ b/internal/state/agent.go
@@ -0,0 +1,71 @@
+package state
+
+import (
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+
+	"golang.org/x/crypto/ssh"
+	"golang.org/x/crypto/ssh/agent"
+)
+
+func (c *Client) agentClient() (agent.Agent, net.Conn, error) {
+	conn, err := net.Dial("unix", c.agentSock)
+	if err != nil {
+		return nil, nil, fmt.Errorf("cannot reach the dedicated agent at %s, start phial-agent.service: %w", c.agentSock, err)
+	}
+
+	return agent.NewClient(conn), conn, nil
+}
+
+func (c *Client) grantSSHKey(name string) error {
+	keyPath := filepath.Join(c.keysDir, name)
+
+	data, err := os.ReadFile(keyPath)
+	if err != nil {
+		return fmt.Errorf("no key file %s, put the private key for this grant there", keyPath)
+	}
+
+	key, err := ssh.ParseRawPrivateKey(data)
+	if err != nil {
+		return fmt.Errorf("cannot parse %s, use an unencrypted key: %w", keyPath, err)
+	}
+
+	client, conn, err := c.agentClient()
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+
+	if err := client.Add(agent.AddedKey{
+		PrivateKey:       key,
+		Comment:          name,
+		LifetimeSecs:     3600,
+		ConfirmBeforeUse: true,
+	}); err != nil {
+		return fmt.Errorf("cannot load %s into the dedicated agent: %w", name, err)
+	}
+
+	c.setForward("ssh-agent", "start")
+
+	return nil
+}
+
+func (c *Client) removeSSHKey(name string) {
+	keyPath := filepath.Join(c.keysDir, name)
+
+	data, err := os.ReadFile(keyPath)
+	if err == nil {
+		if key, err := ssh.ParseRawPrivateKey(data); err == nil {
+			if signer, err := ssh.NewSignerFromKey(key); err == nil {
+				if client, conn, err := c.agentClient(); err == nil {
+					_ = client.Remove(signer.PublicKey())
+					conn.Close()
+				}
+			}
+		}
+	}
+
+	c.setForward("ssh-agent", "stop")
+}
diff --git a/internal/state/allow.go b/internal/state/allow.go
new file mode 100644
index 0000000000000000000000000000000000000000..746adc63ccc2123b649754279da453a064109161
--- /dev/null
+++ b/internal/state/allow.go
@@ -0,0 +1,72 @@
+package state
+
+import (
+	"errors"
+	"flag"
+	"fmt"
+	"time"
+)
+
+func (c *Client) Allow(args []string) error {
+	flags := flag.NewFlagSet("allow", flag.ContinueOnError)
+
+	duration := flags.String("for", "", "grant duration, a systemd timespan such as 30min or 1h")
+	kind := flags.String("kind", "api-key", "grant subject type: api-key, ssh-key, or gpg-key")
+
+	if err := flags.Parse(args); err != nil {
+		return err
+	}
+
+	if flags.NArg() != 1 || *duration == "" {
+		return errors.New("usage: phial allow --for <duration> [--kind api-key|ssh-key|gpg-key] <name>")
+	}
+
+	name := flags.Arg(0)
+
+	seconds, err := parseDuration(*duration)
+	if err != nil {
+		return err
+	}
+
+	if err := c.ensureDirs(); err != nil {
+		return err
+	}
+
+	switch *kind {
+	case "api-key":
+		r, err := c.findRow(name)
+		if err != nil {
+			return err
+		}
+
+		if err := c.materializeRow(r); err != nil {
+			return err
+		}
+
+		if err := writeSecret(c.caddyfile, c.caddyfileText()); err != nil {
+			return err
+		}
+
+		c.applyCaddy()
+	case "ssh-key":
+		if err := c.grantSSHKey(name); err != nil {
+			return err
+		}
+	case "gpg-key":
+		c.setForward("gpg-extra", "start")
+	default:
+		return fmt.Errorf("unknown kind %q", *kind)
+	}
+
+	expires := c.writeGrant(name, *kind, seconds)
+
+	if err := c.scheduleExpiry(name, seconds); err != nil {
+		return err
+	}
+
+	notify("phial grant", fmt.Sprintf("%s (%s) granted until %s", name, *kind, expires.Format("15:04")))
+
+	fmt.Printf("granted %s (%s) until %s\n", name, *kind, expires.Format(time.RFC3339))
+
+	return nil
+}
diff --git a/internal/state/api.go b/internal/state/api.go
new file mode 100644
index 0000000000000000000000000000000000000000..577b92d6a0f614904fcc7de7a180e9d16e092978
--- /dev/null
+++ b/internal/state/api.go
@@ -0,0 +1,133 @@
+package state
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/google/renameio/v2"
+)
+
+type Row struct {
+	Name     string `json:"name"`
+	Mode     string `json:"mode"`
+	Source   string `json:"source"`
+	Upstream string `json:"upstream"`
+}
+
+func (c *Client) Rows() ([]Row, error) {
+	rows, err := c.readMapping()
+	if err != nil {
+		return nil, err
+	}
+
+	out := []Row{}
+	for _, r := range rows {
+		out = append(out, Row{r.name, r.mode, r.source, r.upstream})
+	}
+
+	return out, nil
+}
+
+func validateRow(r Row) error {
+	if !namePattern.MatchString(r.Name) {
+		return fmt.Errorf("name %q must be a valid variable name", r.Name)
+	}
+
+	if r.Mode != "env" && r.Mode != "proxy" {
+		return fmt.Errorf("unknown mode %q, use env or proxy", r.Mode)
+	}
+
+	if !strings.HasPrefix(r.Source, "keepassxc://") && !strings.HasPrefix(r.Source, "env://") {
+		return fmt.Errorf("unsupported source %q, the schemes are keepassxc:// and env://", r.Source)
+	}
+
+	return nil
+}
+
+func (c *Client) writeMappingFile(rows []Row) error {
+	var out strings.Builder
+
+	out.WriteString("# name mode source upstream\n")
+
+	for _, r := range rows {
+		if err := validateRow(r); err != nil {
+			return err
+		}
+
+		upstream := r.Upstream
+		if r.Mode == "env" && (upstream == "" || upstream == "-") {
+			upstream = "-"
+		}
+
+		fmt.Fprintf(&out, "%s %s %s %s\n", r.Name, r.Mode, r.Source, upstream)
+	}
+
+	if err := os.MkdirAll(filepath.Dir(c.mappingFile), 0o700); err != nil {
+		return err
+	}
+
+	return renameio.WriteFile(c.mappingFile, []byte(out.String()), 0o600, renameio.WithStaticPermissions(0o600))
+}
+
+func (c *Client) SetRows(rows []Row) error {
+	return c.writeMappingFile(rows)
+}
+
+func (c *Client) AddProvider(r Row) error {
+	if err := validateRow(r); err != nil {
+		return err
+	}
+
+	rows, err := c.Rows()
+	if err != nil {
+		return err
+	}
+
+	for _, existing := range rows {
+		if existing.Name == r.Name {
+			return fmt.Errorf("a provider named %q already exists", r.Name)
+		}
+	}
+
+	if err := c.writeMappingFile(append(rows, r)); err != nil {
+		return err
+	}
+
+	return c.Sync()
+}
+
+func (c *Client) RemoveProvider(name string) error {
+	rows, err := c.Rows()
+	if err != nil {
+		return err
+	}
+
+	kept := []Row{}
+	found := false
+
+	for _, r := range rows {
+		if r.Name == name {
+			found = true
+
+			continue
+		}
+
+		kept = append(kept, r)
+	}
+
+	if !found {
+		return fmt.Errorf("no provider named %q", name)
+	}
+
+	if err := c.writeMappingFile(kept); err != nil {
+		return err
+	}
+
+	if err := c.Revoke([]string{name}); err != nil {
+		return err
+	}
+
+	return c.Sync()
+}
