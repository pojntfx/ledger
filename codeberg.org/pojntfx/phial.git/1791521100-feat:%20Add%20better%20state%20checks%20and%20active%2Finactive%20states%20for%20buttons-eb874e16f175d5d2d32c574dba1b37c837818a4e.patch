+func (a *App) showRunAppDialog(def virt.Definition) {
+	dialog := adw.NewDialog()
+	dialog.SetTitle(i18n.L("Start Guest App"))
+	dialog.SetContentWidth(440)
+	dialog.SetContentHeight(560)
+
+	toolbar := adw.NewToolbarView()
+
+	header := adw.NewHeaderBar()
+	header.SetShowStartTitleButtons(false)
+
+	title := adw.NewWindowTitle(i18n.L("Start Guest App"), "")
+	header.SetTitleWidget(&title.Widget)
+	toolbar.AddTopBar(&header.Widget)
+
+	mode := "waypipe"
+
+	destinationGroup := adw.NewPreferencesGroup()
+	destinationGroup.SetTitle(i18n.L("Destination"))
+
+	destinationGroup.Add(&a.comboRow(i18n.L("_Show the window"),
+		[]string{i18n.L("Waypipe (this host)"), i18n.L("Remote desktop")},
+		[]string{"waypipe", "session"},
+		mode, func(value string) {
+			mode = value
+		}).Widget)
+
+	appTitle := gtk.NewLabel(i18n.L("Applications"))
+	appTitle.SetXalign(0)
+	appTitle.AddCssClass("heading")
+	appTitle.SetMarginTop(18)
+	appTitle.SetMarginBottom(6)
+
+	search := gtk.NewSearchEntry()
+	search.SetPlaceholderText(i18n.L("Search applications"))
+	search.SetMarginBottom(6)
+
+	appGroup := adw.NewPreferencesGroup()
+
+	statusRow := adw.NewActionRow()
+	statusRow.SetTitle(i18n.L("Looking for applications"))
+
+	statusSpinner := adw.NewSpinner()
+	statusSpinner.SetVisible(true)
+	statusRow.AddPrefix(&statusSpinner.Widget)
+	appGroup.Add(&statusRow.Widget)
+
+	var rows []*adw.ActionRow
+
+	var onSearchChanged func(gtk.SearchEntry)
+	onSearchChanged = func(gtk.SearchEntry) {
+		query := strings.ToLower(strings.TrimSpace(search.GetText()))
+		shown := 0
+
+		for _, row := range rows {
+			match := query == "" || strings.Contains(strings.ToLower(row.GetTitle()), query)
+			row.SetVisible(match)
+
+			if match {
+				shown++
+			}
+		}
+
+		if len(rows) == 0 {
+			return
+		}
+
+		if shown == 0 {
+			statusRow.SetTitle(i18n.L("No application matches"))
+			statusRow.SetVisible(true)
+		} else {
+			statusRow.SetVisible(false)
+		}
+	}
+	search.ConnectSearchChanged(&onSearchChanged)
+	a.hold(&onSearchChanged)
+
+	a.goAsync(func() (string, error) {
+		_, out, err := a.Service.ListGuestApps(a.Ctx, nil, mcp.ListAppsInput{VM: def.Name})
+		if err != nil {
+			return "", err
+		}
+
+		a.idle(func() {
+			statusSpinner.SetVisible(false)
+
+			apps := []mcp.GuestApp{}
+			if out != nil {
+				apps = out.Apps
+			}
+
+			for _, app := range apps {
+				app := app
+
+				row := adw.NewActionRow()
+				row.SetTitle(app.Name)
+				row.SetActivatable(true)
+
+				cb := func(adw.ActionRow) {
+					a.goAsync(func() (string, error) {
+						_, _, err := a.Service.DisplayRunApp(a.Ctx, nil, mcp.RunAppInput{VM: def.Name, Command: app.Exec, Mode: mode})
+
+						return runAppMessage(mode, app.Name), err
+					})
+				}
+				row.ConnectActivated(&cb)
+				a.hold(&cb)
+
+				rows = append(rows, row)
+				appGroup.Add(&row.Widget)
+			}
+
+			if len(apps) == 0 {
+				statusRow.SetTitle(i18n.L("No applications found"))
+				statusRow.SetVisible(true)
+			} else {
+				statusRow.SetVisible(false)
+			}
+		})
+
+		return "", nil
+	})
+
+	commandGroup := adw.NewPreferencesGroup()
+	commandGroup.SetTitle(i18n.L("Custom Command"))
+	commandGroup.SetMarginTop(12)
+
+	commandRow := adw.NewEntryRow()
+	commandRow.SetTitle(i18n.L("Command"))
+	commandRow.SetShowApplyButton(false)
+	commandGroup.Add(&commandRow.Widget)
+
+	commandGroup.Add(&a.buttonRow(i18n.L("_Run the command"), "system-run-symbolic", func() {
+		command := commandRow.GetText()
+		if command == "" {
+			a.toast(i18n.L("Enter a command first"))
+			return
+		}
+
+		a.goAsync(func() (string, error) {
+			_, _, err := a.Service.DisplayRunApp(a.Ctx, nil, mcp.RunAppInput{VM: def.Name, Command: command, Mode: mode})
+
+			return runAppMessage(mode, command), err
+		})
+	}).Widget)
+
+	layout := gtk.NewBox(gtk.OrientationVerticalValue, 0)
+	layout.SetMarginStart(12)
+	layout.SetMarginEnd(12)
+	layout.SetMarginTop(12)
+	layout.SetMarginBottom(12)
+	layout.Append(&destinationGroup.Widget)
+	layout.Append(&appTitle.Widget)
+	layout.Append(&search.Widget)
+	layout.Append(&appGroup.Widget)
+	layout.Append(&commandGroup.Widget)
+
+	scrolled := gtk.NewScrolledWindow()
+	scrolled.SetPolicy(gtk.PolicyNeverValue, gtk.PolicyAutomaticValue)
+	scrolled.SetVexpand(true)
+	scrolled.SetChild(&layout.Widget)
+
+	toolbar.SetContent(&scrolled.Widget)
+	dialog.SetChild(&toolbar.Widget)
+	dialog.Present(&a.window.Widget)
+}
