+#!/usr/bin/env bash
+set -u
+
+cd "$(dirname "$0")/.."
+
+export WAYLAND_DISPLAY=wayland-0
+export DISPLAY=:0
+export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
+
+OUT=/tmp/phial-ui
+mkdir -p "$OUT"
+
+./bin/phial > /tmp/phial-test.log 2>&1 &
+APP_PID=$!
+
+for i in $(seq 1 30); do
+  if gdbus call --session --dest com.pojtinger.felicitas.Phial --object-path /com/pojtinger/felicitas/Phial --method org.gtk.Actions.List > /dev/null 2>&1; then
+    echo "ready after ${i}s"
+    break
+  fi
+  sleep 1
+done
+
+act() {
+  gdbus call --session --dest com.pojtinger.felicitas.Phial --object-path /com/pojtinger/felicitas/Phial --method org.gtk.Actions.Activate "$@" > /dev/null 2>&1
+}
+
+shot() {
+  sleep 3
+  act capture "[<@s '$OUT/$1.png'>]" "[]"
+}
+
+act page-machines "[]" "[]"; shot 01-machines
+act page-secrets "[]" "[]"; shot 02-secrets
+act page-requests "[]" "[]"; shot 03-requests
+
+act page-machines "[]" "[]"; sleep 1
+act open-vm "[<@s 'phial'>]" "[]"; shot 04-detail
+
+act resize "[<420>]" "[]"; sleep 1
+act page-machines "[]" "[]"; shot 05-phone-machines
+act page-secrets "[]" "[]"; shot 06-phone-secrets
+
+act resize "[<960>]" "[]"; sleep 1
+act page-machines "[]" "[]"; shot 07-back-machines
+
+ls -la "$OUT"
+
+kill "$APP_PID" 2>/dev/null
+echo "DONE"
diff --git a/tests/uitest/main.go b/tests/uitest/main.go
new file mode 100644
index 0000000000000000000000000000000000000000..08defeef6d23597cb6b1741170a95d8f627dc2bf
--- /dev/null
+++ b/tests/uitest/main.go
@@ -0,0 +1,200 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/godbus/dbus/v5"
+)
+
+const (
+	busService  = "org.a11y.Bus"
+	busPath     = "/org/a11y/bus"
+	busIface    = "org.a11y.Bus"
+	registry    = "org.a11y.atspi.Registry"
+	registryObj = "/org/a11y/atspi/registry"
+	accessible  = "org.a11y.atspi.Accessible"
+	action      = "org.a11y.atspi.Action"
+	rootPath    = "/org/a11y/atspi/accessible/root"
+)
+
+type reference struct {
+	Sender string
+	Path   dbus.ObjectPath
+}
+
+func main() {
+	if len(os.Args) < 3 {
+		fmt.Fprintln(os.Stderr, "usage: uitest <click|list|wait> <name>")
+		os.Exit(2)
+	}
+
+	mode := os.Args[1]
+	target := os.Args[2]
+
+	session, err := dbus.SessionBus()
+	if err != nil {
+		fail("session bus: %v", err)
+	}
+
+	var address string
+	if err := session.Object(busService, busPath).Call(busIface+".GetAddress", 0).Store(&address); err != nil {
+		fail("a11y address: %v", err)
+	}
+
+	conn, err := dbus.Dial(address)
+	if err != nil {
+		fail("a11y dial: %v", err)
+	}
+
+	if err := conn.Auth(nil); err != nil {
+		fail("a11y auth: %v", err)
+	}
+
+	if err := conn.Hello(); err != nil {
+		fail("a11y hello: %v", err)
+	}
+
+	type entry struct {
+		node   reference
+		parent reference
+	}
+
+	deadline := time.Now().Add(20 * time.Second)
+	var found reference
+
+	for time.Now().Before(deadline) {
+		nodes := []entry{{node: reference{Sender: registry, Path: rootPath}}}
+		visited := map[string]bool{}
+
+		for len(nodes) > 0 {
+			current := nodes[0]
+			nodes = nodes[1:]
+
+			key := current.node.Sender + string(current.node.Path)
+			if visited[key] {
+				continue
+			}
+			visited[key] = true
+
+			name, role := describe(conn, current.node)
+
+			if mode == "list" && name != "" {
+				fmt.Printf("%s\t%s\n", role, name)
+			}
+
+			if strings.EqualFold(name, target) {
+				found = current.node
+
+				if mode == "click" && current.parent.Path != "" {
+					found = current.parent
+				}
+
+				break
+			}
+
+			for _, child := range children(conn, current.node) {
+				nodes = append(nodes, entry{node: child, parent: current.node})
+			}
+		}
+
+		if found.Path != "" || mode == "list" {
+			break
+		}
+
+		time.Sleep(500 * time.Millisecond)
+	}
+
+	if mode == "list" {
+		return
+	}
+
+	if found.Path == "" {
+		fail("no accessible node named %q", target)
+	}
+
+	if mode == "click" {
+		var ok bool
+
+		if err := conn.Object(found.Sender, found.Path).Call(action+".DoAction", 0, int32(0)).Store(&ok); err != nil {
+			fail("click %q: %v", target, err)
+		}
+
+		fmt.Printf("clicked %q\n", target)
+	}
+}
+
+func property(conn *dbus.Conn, node reference, name string) dbus.Variant {
+	obj := conn.Object(node.Sender, node.Path)
+
+	var value dbus.Variant
+	if err := obj.Call("org.freedesktop.DBus.Properties.Get", 0, accessible, name).Store(&value); err != nil {
+		return dbus.MakeVariant("")
+	}
+
+	return value
+}
+
+func describe(conn *dbus.Conn, node reference) (string, string) {
+	name := ""
+	_ = property(conn, node, "Name").Store(&name)
+
+	var role uint32
+	_ = property(conn, node, "Role").Store(&role)
+
+	return name, roleName(role)
+}
+
+func children(conn *dbus.Conn, node reference) []reference {
+	obj := conn.Object(node.Sender, node.Path)
+
+	var count int32
+	if err := property(conn, node, "ChildCount").Store(&count); err != nil {
+		return nil
+	}
+
+	result := make([]reference, 0, count)
+
+	for index := int32(0); index < count; index++ {
+		var child reference
+		if err := obj.Call(accessible+".GetChildAtIndex", 0, index).Store(&child); err != nil {
+			continue
+		}
+
+		if child.Path == "" {
+			continue
+		}
+
+		result = append(result, child)
+	}
+
+	return result
+}
+
+func roleName(role uint32) string {
+	names := map[uint32]string{
+		11: "push button",
+		12: "toggle button",
+		16: "list",
+		23: "frame",
+		24: "window",
+		25: "dialog",
+		34: "text",
+		40: "page tab",
+		43: "label",
+		62: "table",
+	}
+
+	if name, ok := names[role]; ok {
+		return name
+	}
+
+	return fmt.Sprintf("role-%d", role)
+}
+
+func fail(format string, args ...interface{}) {
+	fmt.Fprintf(os.Stderr, format+"\n", args...)
+	os.Exit(1)
+}

