new file mode 100644
index 0000000000000000000000000000000000000000..2a1d9c71dfee150458a8f9968351411007f8b29c
--- /dev/null
+++ b/internal/state/sync.go
@@ -0,0 +1,45 @@
+package state
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+func (c *Client) Sync() error {
+	if err := c.ensureDirs(); err != nil {
+		return err
+	}
+
+	rows, err := c.readMapping()
+	if err != nil {
+		return err
+	}
+
+	seen := map[string]bool{}
+	for _, r := range rows {
+		if err := c.materializeRow(r); err != nil {
+			return err
+		}
+
+		seen[r.name] = true
+	}
+
+	dropins, _ := filepath.Glob(filepath.Join(c.dropinsDir, "*.caddy"))
+	for _, dropin := range dropins {
+		if !seen[strings.TrimSuffix(filepath.Base(dropin), ".caddy")] {
+			_ = os.Remove(dropin)
+		}
+	}
+
+	if err := writeSecret(c.caddyfile, c.caddyfileText()); err != nil {
+		return err
+	}
+
+	c.applyCaddy()
+
+	fmt.Printf("synced %d row(s)\n", len(rows))
+
+	return nil
+}
diff --git a/internal/state/systemd.go b/internal/state/systemd.go
new file mode 100644
index 0000000000000000000000000000000000000000..6a33fb1f210abe06f3761b7193c3567ec8a43a4e
--- /dev/null
+++ b/internal/state/systemd.go
@@ -0,0 +1,136 @@
+package state
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	systemdDbus "github.com/coreos/go-systemd/v22/dbus"
+	"github.com/godbus/dbus/v5"
+)
+
+func (c *Client) userManager() (*systemdDbus.Conn, error) {
+	return systemdDbus.NewUserConnectionContext(context.Background())
+}
+
+type timerEntry struct {
+	Name  string
+	Value uint64
+}
+
+func (c *Client) scheduleExpiry(name string, seconds int) error {
+	conn, err := c.userManager()
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+
+	binary, err := exec.LookPath("phial")
+	if err != nil {
+		binary, _ = filepath.Abs(os.Args[0])
+	}
+
+	conn.ResetFailedUnitContext(context.Background(), "phial-expire-"+name+".timer")
+	_, _ = conn.StopUnitContext(context.Background(), "phial-expire-"+name+".timer", "replace", nil)
+
+	timer := []systemdDbus.Property{
+		systemdDbus.PropDescription("phial grant expiry for " + name),
+		{Name: "TimersMonotonic", Value: dbus.MakeVariant([]timerEntry{{Name: "OnActiveSec", Value: uint64(seconds) * 1000000}})},
+		{Name: "AccuracyUSec", Value: dbus.MakeVariant(uint64(1000000))},
+		{Name: "CollectMode", Value: dbus.MakeVariant("inactive-or-failed")},
+	}
+
+	service := []systemdDbus.Property{
+		systemdDbus.PropDescription("phial grant expiry for " + name),
+		systemdDbus.PropType("oneshot"),
+		systemdDbus.PropExecStart([]string{binary, "revoke", name}, false),
+		{Name: "Environment", Value: dbus.MakeVariant([]string{
+			"PHIAL_CONFIG_DIR=" + filepath.Dir(c.mappingFile),
+			"PHIAL_RUNTIME_DIR=" + filepath.Dir(c.secretsDir),
+			"PATH=" + os.Getenv("PATH"),
+		})},
+		{Name: "CollectMode", Value: dbus.MakeVariant("inactive-or-failed")},
+	}
+
+	aux := []systemdDbus.PropertyCollection{
+		{Name: "phial-expire-" + name + ".service", Properties: service},
+	}
+
+	_, err = conn.StartTransientUnitAux(context.Background(), "phial-expire-"+name+".timer", "replace", timer, aux, nil)
+
+	return err
+}
+
+func (c *Client) cancelExpiry(name string) {
+	conn, err := c.userManager()
+	if err != nil {
+		return
+	}
+	defer conn.Close()
+
+	_, _ = conn.StopUnitContext(context.Background(), "phial-expire-"+name+".timer", "replace", nil)
+	_, _ = conn.StopUnitContext(context.Background(), "phial-expire-"+name+".service", "replace", nil)
+}
+
+func caddyVersion() (int, int, bool) {
+	out, err := exec.Command("caddy", "version").Output()
+	if err != nil {
+		return 0, 0, false
+	}
+
+	parts := strings.Split(strings.TrimPrefix(strings.TrimSpace(string(out)), "v"), ".")
+	if len(parts) < 2 {
+		return 0, 0, false
+	}
+
+	major, err1 := strconv.Atoi(parts[0])
+	minor, err2 := strconv.Atoi(parts[1])
+
+	return major, minor, err1 == nil && err2 == nil
+}
+
+func (c *Client) applyCaddy() {
+	conn, err := c.userManager()
+	if err != nil {
+		return
+	}
+	defer conn.Close()
+
+	property, err := conn.GetUnitPropertyContext(context.Background(), "phial-caddy.service", "ActiveState")
+	if err != nil {
+		return
+	}
+
+	state, ok := property.Value.Value().(string)
+	if !ok || state != "active" {
+		return
+	}
+
+	major, minor, ok := caddyVersion()
+	if ok && (major < 2 || (major == 2 && minor < 11)) {
+		_, _ = conn.RestartUnitContext(context.Background(), "phial-caddy.service", "replace", nil)
+	} else {
+		_, _ = conn.ReloadUnitContext(context.Background(), "phial-caddy.service", "replace", nil)
+	}
+}
+
+func (c *Client) setForward(name, state string) {
+	conn, err := c.userManager()
+	if err == nil {
+		unit := "phial-forward@" + name + ".service"
+
+		if state == "start" {
+			_, _ = conn.StartUnitContext(context.Background(), unit, "replace", nil)
+		} else {
+			_, _ = conn.StopUnitContext(context.Background(), unit, "replace", nil)
+		}
+
+		conn.Close()
+	}
+
+	c.sshGuest(fmt.Sprintf("systemctl --user %s phial-forward@%s.service", state, name))
+}
