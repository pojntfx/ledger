new file mode 100644
index 0000000000000000000000000000000000000000..fb50f5969255bfbd79ea3eaa94769867a7a0fc2f
--- /dev/null
+++ b/internal/virt/accessors.go
@@ -0,0 +1,56 @@
+package virt
+
+import (
+	"path/filepath"
+	"strings"
+
+	"github.com/mdlayher/vsock"
+)
+
+func (d Definition) GuestCIDValue() uint32 {
+	return d.guestCID()
+}
+
+func (d Definition) RuntimePathValue() string {
+	return d.runtimePath()
+}
+
+func (d Definition) DiskPathValue() string {
+	return d.diskPath()
+}
+
+func ShareTag(path string) string {
+	tag := filepath.Base(filepath.Clean(path))
+
+	var builder strings.Builder
+
+	for _, r := range tag {
+		switch {
+		case r >= 'a' && r <= 'z', r >= '0' && r <= '9', r == '-', r == '_':
+			builder.WriteRune(r)
+		case r >= 'A' && r <= 'Z':
+			builder.WriteRune(r + 32)
+		default:
+			builder.WriteRune('-')
+		}
+	}
+
+	result := strings.Trim(builder.String(), "-")
+
+	if result == "" {
+		return "share"
+	}
+
+	return result
+}
+
+func (d Definition) Ready() bool {
+	conn, err := vsock.Dial(d.guestCID(), 2222, &vsock.Config{})
+	if err != nil {
+		return false
+	}
+
+	_ = conn.Close()
+
+	return true
+}
diff --git a/internal/virt/fat16.go b/internal/virt/fat16.go
new file mode 100644
index 0000000000000000000000000000000000000000..3771dc6443b08ba770c8fe92317fe07a425398b3
--- /dev/null
+++ b/internal/virt/fat16.go
@@ -0,0 +1,150 @@
+package virt
+
+import (
+	"encoding/binary"
+	"errors"
+	"os"
+)
+
+func writeFAT16Image(path, label string, files map[string][]byte) error {
+	const (
+		sectorSize   = 512
+		sectors      = 16384
+		sectorsPerCl = 16
+		fatSectors   = 4
+		rootSectors  = 32
+		fat1Start    = 1
+		fat2Start    = fat1Start + fatSectors
+		rootStart    = fat2Start + fatSectors
+		dataStart    = rootStart + rootSectors
+	)
+
+	if len(files) == 0 {
+		return errors.New("no files for the image")
+	}
+
+	image := make([]byte, sectors*sectorSize)
+
+	boot := image
+	copy(boot[0:3], []byte{0xEB, 0x3C, 0x90})
+	copy(boot[3:11], []byte("MSDOS5.0"))
+	binary.LittleEndian.PutUint16(boot[11:13], sectorSize)
+	boot[13] = sectorsPerCl
+	binary.LittleEndian.PutUint16(boot[14:16], 1)
+	boot[16] = 2
+	binary.LittleEndian.PutUint16(boot[17:19], rootSectors*sectorSize/32)
+	binary.LittleEndian.PutUint16(boot[19:21], sectors)
+	boot[21] = 0xF8
+	binary.LittleEndian.PutUint16(boot[22:24], fatSectors)
+	binary.LittleEndian.PutUint16(boot[24:26], 32)
+	binary.LittleEndian.PutUint16(boot[26:28], 64)
+	binary.LittleEndian.PutUint32(boot[28:32], 0)
+	binary.LittleEndian.PutUint32(boot[32:36], 0)
+	boot[36] = 0x80
+	boot[38] = 0x29
+	binary.LittleEndian.PutUint32(boot[39:43], 0x7000AB12)
+	copy(boot[43:54], padLabel(label, 11))
+	copy(boot[54:62], []byte("FAT16   "))
+	boot[510] = 0x55
+	boot[511] = 0xAA
+
+	setFAT := func(index int, value uint16) {
+		for _, start := range []int{fat1Start, fat2Start} {
+			binary.LittleEndian.PutUint16(image[start*sectorSize+index*2:start*sectorSize+index*2+2], value)
+		}
+	}
+
+	setFAT(0, 0xFFF8)
+	setFAT(1, 0xFFFF)
+
+	root := image[rootStart*sectorSize:]
+	cluster := uint16(2)
+	entry := 0
+
+	names := []string{}
+	for name := range files {
+		names = append(names, name)
+	}
+
+	for _, name := range names {
+		data := files[name]
+		clusters := (len(data) + sectorsPerCl*sectorSize - 1) / (sectorsPerCl * sectorSize)
+
+		for i := 0; i < clusters; i++ {
+			current := cluster + uint16(i)
+			next := uint16(0xFFFF)
+			if i < clusters-1 {
+				next = current + 1
+			}
+
+			setFAT(int(current), next)
+		}
+
+		offset := (dataStart + (int(cluster)-2)*sectorsPerCl) * sectorSize
+		copy(image[offset:], data)
+
+		short := pad83(name)
+		copy(root[entry*32:entry*32+11], short)
+		root[entry*32+11] = 0x20
+		binary.LittleEndian.PutUint16(root[entry*32+26:entry*32+28], cluster)
+		binary.LittleEndian.PutUint32(root[entry*32+28:entry*32+32], uint32(len(data)))
+
+		cluster += uint16(clusters)
+		entry++
+	}
+
+	return os.WriteFile(path, image, 0o600)
+}
+
+func pad83(name string) []byte {
+	out := make([]byte, 11)
+	for i := range out {
+		out[i] = ' '
+	}
+
+	base := name
+	ext := ""
+
+	for i := len(name) - 1; i >= 0; i-- {
+		if name[i] == '.' {
+			base = name[:i]
+			ext = name[i+1:]
+
+			break
+		}
+	}
+
+	if len(base) > 8 {
+		base = base[:8]
+	}
+
+	if len(ext) > 3 {
+		ext = ext[:3]
+	}
+
+	copy(out, base)
+	copy(out[8:], ext)
+
+	for i, r := range out {
+		if r >= 'a' && r <= 'z' {
+			out[i] = byte(r - 'a' + 'A')
+		}
+	}
+
+	return out
+}
+
+func padLabel(label string, size int) []byte {
+	out := make([]byte, size)
+	for i := range out {
+		out[i] = ' '
+	}
+
+	if len(label) > size {
+		label = label[:size]
+	}
+
+	copy(out, label)
+
+	return out
+}
diff --git a/internal/virt/ids.go b/internal/virt/ids.go
new file mode 100644
index 0000000000000000000000000000000000000000..d882a8f1645f5155beeff51f07da48dbacd7b3d2
--- /dev/null
+++ b/internal/virt/ids.go
@@ -0,0 +1,106 @@
+package virt
+
+import (
+	"os"
+	"strings"
+	"sync"
+)
+
+var (
+	usbIDsOnce sync.Once
+	usbIDsMap  map[string]map[string]string
+
+	pciIDsOnce sync.Once
+	pciIDsMap  map[string]map[string]string
+)
+
+func loadIDs(path string) map[string]map[string]string {
+	result := map[string]map[string]string{}
+
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return result
+	}
+
+	vendor := ""
+
+	for _, line := range strings.Split(string(data), "\n") {
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+
+		if strings.HasPrefix(line, "\t") {
+			if strings.HasPrefix(line, "\t\t") || vendor == "" {
+				continue
+			}
+
+			fields := strings.Fields(strings.TrimPrefix(line, "\t"))
+			if len(fields) < 2 {
+				continue
+			}
+
+			id := strings.ToLower(fields[0])
+
+			if _, ok := result[vendor][id]; !ok {
+				result[vendor][id] = strings.Join(fields[1:], " ")
+			}
+
+			continue
+		}
+
+		fields := strings.Fields(line)
+		if len(fields) < 2 {
+			continue
+		}
+
+		vendor = strings.ToLower(fields[0])
+
+		if _, ok := result[vendor]; !ok {
+			result[vendor] = map[string]string{}
+		}
+
+		result[vendor]["_vendor"] = strings.Join(fields[1:], " ")
+	}
+
+	return result
+}
+
+func USBName(vendor, product string) string {
+	usbIDsOnce.Do(func() {
+		usbIDsMap = loadIDs("/usr/share/hwdata/usb.ids")
+	})
+
+	return lookupName(usbIDsMap, vendor, product)
+}
+
+func PCIName(vendor, device string) string {
+	pciIDsOnce.Do(func() {
+		pciIDsMap = loadIDs("/usr/share/hwdata/pci.ids")
+	})
+
+	return lookupName(pciIDsMap, vendor, device)
+}
+
+func lookupName(table map[string]map[string]string, vendor, device string) string {
+	vendor = normalizeID(vendor)
+	device = normalizeID(device)
+
+	entries, ok := table[vendor]
+	if !ok {
+		return ""
+	}
+
+	name := entries["_vendor"]
+
+	if product, ok := entries[device]; ok {
+		return name + " " + product
+	}
+
+	return name
+}
+
+func normalizeID(value string) string {
+	value = strings.ToLower(strings.TrimSpace(value))
+
+	return strings.TrimPrefix(value, "0x")
+}
diff --git a/internal/virt/install.go b/internal/virt/install.go
new file mode 100644
index 0000000000000000000000000000000000000000..60265d3b156a4ed566577ddfe1b56b573c932609
--- /dev/null
+++ b/internal/virt/install.go
@@ -0,0 +1,359 @@
+package virt
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+const defaultFedoraBase = "https://download.fedoraproject.org/pub/fedora/linux/development/45/Everything/x86_64"
+
+type InstallResult struct {
+	Completed bool
+	Message   string
+}
+
+func assetsDir() string {
+	return filepath.Join(dataDir(), "install")
+}
+
+func fetch(url, target string, onProgress func(downloaded, total int64)) error {
+	if info, err := os.Stat(target); err == nil && info.Size() > 0 {
+		if onProgress != nil {
+			onProgress(info.Size(), info.Size())
+		}
+		return nil
+	}
+
+	response, err := http.Get(url)
+	if err != nil {
+		return err
+	}
+	defer response.Body.Close()
+
+	if response.StatusCode != http.StatusOK {
+		return fmt.Errorf("fetch %s: %s", url, response.Status)
+	}
+
+	file, err := os.Create(target)
+	if err != nil {
+		return err
+	}
+	defer file.Close()
+
+	if onProgress != nil {
+		onProgress(0, response.ContentLength)
+	}
+
+	buffer := make([]byte, 4*1024*1024)
+	var written int64
+
+	for {
+		read, readErr := response.Body.Read(buffer)
+		if read > 0 {
+			if _, writeErr := file.Write(buffer[:read]); writeErr != nil {
+				return writeErr
+			}
+			written += int64(read)
+			if onProgress != nil {
+				onProgress(written, response.ContentLength)
+			}
+		}
+		if readErr == io.EOF {
+			break
+		}
+		if readErr != nil {
+			return readErr
+		}
+	}
+
+	return nil
+}
+
+func isoLabel(iso string) (string, error) {
+	file, err := os.Open(iso)
+	if err != nil {
+		return "", err
+	}
+	defer file.Close()
+
+	label := make([]byte, 32)
+	if _, err := file.ReadAt(label, 0x8028); err != nil {
+		return "", err
+	}
+
+	return strings.TrimSpace(string(label)), nil
+}
+
+func kickstartImage(kickstart []byte) (string, error) {
+	if err := os.MkdirAll(assetsDir(), 0o700); err != nil {
+		return "", err
+	}
+
+	target := filepath.Join(assetsDir(), "phial-ks.img")
+
+	if err := writeFAT16Image(target, "PHIALKS", map[string][]byte{"phial.ks": kickstart}); err != nil {
+		return "", err
+	}
+
+	return target, nil
+}
+
+func Install(def Definition, kickstart []byte, fedoraBase string) (*InstallResult, error) {
+	if fedoraBase == "" {
+		fedoraBase = defaultFedoraBase
+	}
+
+	if err := os.MkdirAll(assetsDir(), 0o700); err != nil {
+		return nil, err
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	registerInstallCancel(def.Name, cancel)
+	defer unregisterInstallCancel(def.Name)
+	defer cancel()
+
+	defer func() {
+		if r := recover(); r != nil {
+			markInstallFailed(def.Name, "the installer stopped unexpectedly")
+			panic(r)
+		}
+	}()
+
+	markInstallStep(def.Name, 0, "Downloading the installer")
+
+	kernel := filepath.Join(assetsDir(), "vmlinuz")
+	initrd := filepath.Join(assetsDir(), "initrd.img")
+
+	if err := fetch(fedoraBase+"/os/images/pxeboot/vmlinuz", kernel, nil); err != nil {
+		return nil, err
+	}
+
+	if err := fetch(fedoraBase+"/os/images/pxeboot/initrd.img", initrd, nil); err != nil {
+		return nil, err
+	}
+
+	isoName, err := netinstName(fedoraBase)
+	if err != nil {
+		return nil, err
+	}
+
+	iso := filepath.Join(assetsDir(), isoName)
+	if err := fetch(fedoraBase+"/iso/"+isoName, iso, func(downloaded, total int64) {
+		markInstallProgress(def.Name, downloaded, total)
+	}); err != nil {
+		return nil, err
+	}
+
+	label, err := isoLabel(iso)
+	if err != nil {
+		return nil, err
+	}
+
+	kickstart = append([]byte("url --url=\""+fedoraBase+"/os\"\n"), kickstart...)
+
+	ksImg, err := kickstartImage(kickstart)
+	if err != nil {
+		return nil, err
+	}
+
+	boot := BootConfig{
+		Kernel: kernel,
+		Initrd: initrd,
+		Shim:   filepath.Join(assetsDir(), "shim.efi"),
+		Append: "inst.ks=hd:vdb:/phial.ks inst.stage2=hd:LABEL=" + label + " inst.repo=" + fedoraBase + "/os/ console=tty0 console=ttyS0,115200n8",
+		ISO:    iso,
+		KSImg:  ksImg,
+		Serial: "log",
+	}
+
+	if err := fetchShim(iso, boot.Shim); err != nil {
+		return nil, err
+	}
+
+	markInstallStep(def.Name, 1, "Starting the installer")
+
+	console := filepath.Join(def.runtimePath(), "console.log")
+	os.Remove(console)
+
+	errChan := make(chan error, 1)
+	go func() {
+		errChan <- def.RunExecContext(ctx, boot)
+	}()
+
+	deadline := time.Now().Add(45 * time.Minute)
+
+	for time.Now().Before(deadline) {
+		select {
+		case err := <-errChan:
+			if ctx.Err() != nil {
+				markInstallFailed(def.Name, "Installation cancelled")
+				return nil, errors.New("the install was cancelled")
+			}
+			markInstallFailed(def.Name, "the installer stopped: "+err.Error())
+			return nil, fmt.Errorf("the installer VM ended early: %w", err)
+		default:
+		}
+
+		if data, err := os.ReadFile(console); err == nil {
+			content := string(data)
+
+			if strings.Contains(content, "Restarting system") {
+				markInstallDone(def.Name)
+				return &InstallResult{Completed: true, Message: "the guest installed and rebooted"}, nil
+			}
+
+			scanConsole(def.Name, content)
+
+			for _, needle := range []string{"An unknown error has occurred", "anaconda died", "Pane is dead"} {
+				if strings.Contains(content, needle) {
+					markInstallFailed(def.Name, "the installer failed, see the console log at "+console)
+					return nil, errors.New("the installer failed, see the console log at " + console)
+				}
+			}
+		}
+
+		time.Sleep(15 * time.Second)
+	}
+
+	markInstallFailed(def.Name, "the installer timed out after 45 minutes")
+	return nil, errors.New("the installer timed out after 45 minutes")
+}
+
+func netinstName(base string) (string, error) {
+	response, err := http.Get(base + "/iso/")
+	if err != nil {
+		return "", err
+	}
+	defer response.Body.Close()
+
+	body, err := io.ReadAll(response.Body)
+	if err != nil {
+		return "", err
+	}
+
+	parts := strings.Split(string(body), "Fedora-Everything-netinst-x86_64-45")
+	if len(parts) < 2 {
+		return "", errors.New("no netinst ISO found in the Fedora mirror listing")
+	}
+
+	rest := parts[1]
+	end := strings.Index(rest, ".iso")
+	if end < 0 {
+		return "", errors.New("no netinst ISO found in the Fedora mirror listing")
+	}
+
+	return "Fedora-Everything-netinst-x86_64-45" + rest[:end] + ".iso", nil
+}
+
+func fetchShim(iso, target string) error {
+	if info, err := os.Stat(target); err == nil && info.Size() > 0 {
+		return nil
+	}
+
+	file, err := os.Open(iso)
+	if err != nil {
+		return err
+	}
+	defer file.Close()
+
+	data, err := isoReadFile(file, []string{"EFI", "BOOT", "BOOTX64.EFI"})
+	if err != nil {
+		return err
+	}
+
+	return os.WriteFile(target, data, 0o600)
+}
+
+func isoReadFile(file *os.File, parts []string) ([]byte, error) {
+	pvd := make([]byte, 2048)
+	if _, err := file.ReadAt(pvd, 16*2048); err != nil {
+		return nil, err
+	}
+
+	extent := int64(binaryLE(pvd[156+2:156+6])) * 2048
+	size := int64(binaryLE(pvd[156+10 : 156+14]))
+
+	for _, part := range parts {
+		found := false
+
+		for position := int64(0); position < size; position += 2048 {
+			block := make([]byte, 2048)
+			if _, err := file.ReadAt(block, extent+position); err != nil {
+				return nil, err
+			}
+
+			offset := 0
+			for offset < len(block) && block[offset] != 0 {
+				record := block[offset:]
+				length := int(record[0])
+				if length == 0 {
+					break
+				}
+
+				nameLength := int(record[32])
+				name := string(record[33 : 33+nameLength])
+
+				if name == part || (part == "BOOTX64.EFI" && strings.HasPrefix(name, "BOOTX64.EFI")) {
+					extent = int64(binaryLE(record[2:6])) * 2048
+					size = int64(binaryLE(record[10:14]))
+					found = true
+
+					break
+				}
+
+				offset += length
+			}
+
+			if found {
+				break
+			}
+		}
+
+		if !found {
+			return nil, errors.New(part + " not found in the ISO")
+		}
+	}
+
+	data := make([]byte, size)
+	if _, err := file.ReadAt(data, extent); err != nil {
+		return nil, err
+	}
+
+	return data, nil
+}
+
+func binaryLE(data []byte) int {
+	value := 0
+
+	for index := len(data) - 1; index >= 0; index-- {
+		value = value<<8 | int(data[index])
+	}
+
+	return value
+}
+
+func CleanPartialInstall(name string) error {
+	def, err := Load(name)
+	if err != nil {
+		return err
+	}
+
+	for _, path := range []string{
+		def.DiskPathValue(),
+		filepath.Join(def.runtimePath(), "console.log"),
+		filepath.Join(def.runtimePath(), "OVMF_VARS.secboot.fd"),
+	} {
+		if err := os.Remove(path); err != nil && !os.IsNotExist(err) {
+			return err
+		}
+	}
+
+	return nil
+}
diff --git a/internal/virt/launcher.go b/internal/virt/launcher.go
new file mode 100644
index 0000000000000000000000000000000000000000..52dfe74778b975f7c0a43b458f3c93909291774d
--- /dev/null
+++ b/internal/virt/launcher.go
@@ -0,0 +1,611 @@
+package virt
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strconv"
+	"strings"
+	"time"
+
+	systemdDbus "github.com/coreos/go-systemd/v22/dbus"
+	"golang.org/x/sys/unix"
+)
+
+type BootConfig struct {
+	Kernel string
+	Initrd string
+	Shim   string
+	Append string
+	ISO    string
+	KSImg  string
+	Serial string
+}
+
+func physicalCores() (int, error) {
+	file, err := os.Open("/proc/cpuinfo")
+	if err != nil {
+		return 0, err
+	}
+	defer file.Close()
+
+	cores := map[string]bool{}
+	socket := ""
+	core := ""
+
+	scanner := bufio.NewScanner(file)
+	for scanner.Scan() {
+		line := scanner.Text()
+
+		if strings.HasPrefix(line, "physical id") {
+			socket = strings.TrimSpace(strings.SplitN(line, ":", 2)[1])
+		}
+
+		if strings.HasPrefix(line, "core id") {
+			core = strings.TrimSpace(strings.SplitN(line, ":", 2)[1])
+			cores[socket+":"+core] = true
+		}
+	}
+
+	if len(cores) == 0 {
+		return 0, errors.New("could not count physical cores")
+	}
+
+	return len(cores), nil
+}
+
+func memoryMiB(memory string) (int, error) {
+	memory = strings.TrimSpace(memory)
+	if memory == "" {
+		return 0, errors.New("empty memory size")
+	}
+
+	last := memory[len(memory)-1]
+	factor := 1
+	digits := memory
+
+	switch last {
+	case 'G', 'g':
+		factor = 1024
+		digits = memory[:len(memory)-1]
+	case 'M', 'm':
+		digits = memory[:len(memory)-1]
+	case 'K', 'k':
+		digits = memory[:len(memory)-1]
+		factor = 0
+	}
+
+	value, err := strconv.Atoi(digits)
+	if err != nil {
+		return 0, fmt.Errorf("invalid memory size %q", memory)
+	}
+
+	if factor == 0 {
+		return value / 1024, nil
+	}
+
+	return value * factor, nil
+}
+
+func firmwarePair(def Definition) (code, varsTemplate, vars string) {
+	if def.SecureBoot {
+		return filepath.Join(OVMFDirValue(), "OVMF_CODE.secboot.fd"),
+			filepath.Join(OVMFDirValue(), "OVMF_VARS.secboot.fd"),
+			filepath.Join(def.runtimePath(), "OVMF_VARS.secboot.fd")
+	}
+
+	return filepath.Join(OVMFDirValue(), "OVMF_CODE.fd"),
+		filepath.Join(OVMFDirValue(), "OVMF_VARS.fd"),
+		filepath.Join(def.runtimePath(), "OVMF_VARS.fd")
+}
+
+func (d Definition) prepare() error {
+	run := d.runtimePath()
+
+	if err := os.MkdirAll(run, 0o700); err != nil {
+		return err
+	}
+
+	_, varsTemplate, vars := firmwarePair(d)
+
+	if _, err := os.Stat(vars); errors.Is(err, os.ErrNotExist) {
+		data, err := os.ReadFile(varsTemplate)
+		if err != nil {
+			return err
+		}
+
+		if err := os.WriteFile(vars, data, 0o600); err != nil {
+			return err
+		}
+	}
+
+	disk := d.diskPath()
+
+	info, statErr := os.Stat(disk)
+	needsAllocation := errors.Is(statErr, os.ErrNotExist) || (statErr == nil && info.Size() == 0)
+
+	if needsAllocation {
+		if err := os.MkdirAll(filepath.Dir(disk), 0o700); err != nil {
+			return err
+		}
+
+		sizeMiB, err := memoryMiB(d.DiskSize)
+		if err != nil {
+			return err
+		}
+
+		file, err := os.OpenFile(disk, os.O_CREATE|os.O_RDWR, 0o600)
+		if err != nil {
+			return err
+		}
+		defer file.Close()
+
+		if err := unix.Fallocate(int(file.Fd()), 0, 0, int64(sizeMiB)*1024*1024); err != nil {
+			return err
+		}
+	}
+
+	if d.HugePages {
+		mib, err := memoryMiB(d.Memory)
+		if err != nil {
+			return err
+		}
+
+		needed := mib / 2
+
+		data, err := os.ReadFile("/proc/sys/vm/nr_hugepages")
+		if err != nil {
+			return err
+		}
+
+		have, err := strconv.Atoi(strings.TrimSpace(string(data)))
+		if err != nil {
+			return err
+		}
+
+		if have < needed {
+			return fmt.Errorf("need %d huge pages, have %d; apply the system setup from the System view", needed, have)
+		}
+	}
+
+	return nil
+}
+
+func socketLive(path string) bool {
+	data, err := os.ReadFile("/proc/net/unix")
+	if err != nil {
+		return false
+	}
+
+	for _, line := range strings.Split(string(data), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) >= 8 && fields[7] == path && fields[5] == "01" {
+			return true
+		}
+	}
+
+	return false
+}
+
+func waitForSockets(paths ...string) error {
+	deadline := time.Now().Add(15 * time.Second)
+
+	for _, path := range paths {
+		for {
+			if socketLive(path) {
+				break
+			}
+
+			if time.Now().After(deadline) {
+				return fmt.Errorf("socket %s has no live listener; start the phial-swtpm and phial-virtiofsd units", path)
+			}
+
+			time.Sleep(100 * time.Millisecond)
+		}
+	}
+
+	return nil
+}
+
+func usbDevicePresent(vendor, product string) bool {
+	matches, _ := filepath.Glob("/sys/bus/usb/devices/*/idVendor")
+
+	for _, vendorFile := range matches {
+		data, err := os.ReadFile(vendorFile)
+		if err != nil {
+			continue
+		}
+
+		if strings.TrimSpace(string(data)) != vendor {
+			continue
+		}
+
+		productFile := filepath.Join(filepath.Dir(vendorFile), "idProduct")
+		if data, err := os.ReadFile(productFile); err == nil && strings.TrimSpace(string(data)) == product {
+			return true
+		}
+	}
+
+	return false
+}
+
+func xhciControllerCount() int {
+	matches, _ := filepath.Glob("/sys/bus/pci/devices/*/class")
+
+	count := 0
+	for _, classFile := range matches {
+		data, err := os.ReadFile(classFile)
+		if err != nil {
+			continue
+		}
+
+		if strings.TrimSpace(string(data)) == "0x0c0330" {
+			count++
+		}
+	}
+
+	return count
+}
+
+func (d Definition) BuildArgs(boot BootConfig) ([]string, error) {
+	vcpus := d.VCPUs
+	if vcpus == 0 {
+		cores, err := physicalCores()
+		if err != nil {
+			return nil, err
+		}
+
+		vcpus = cores - 1
+		if vcpus < 1 {
+			vcpus = 1
+		}
+	}
+
+	run := d.runtimePath()
+	code, _, vars := firmwarePair(d)
+
+	hugetlb := "off"
+	if d.HugePages {
+		hugetlb = "on"
+	}
+
+	args := []string{
+		"-name", d.Name,
+		"-machine", "q35,accel=kvm,smm=on,kernel-irqchip=split,memory-backend=mem0",
+		"-cpu", "host",
+		"-smp", fmt.Sprintf("%d,sockets=1,cores=%d,threads=1", vcpus, vcpus),
+		"-m", d.Memory,
+		"-object", "memory-backend-memfd,id=mem0,size=" + d.Memory + ",share=on,hugetlb=" + hugetlb,
+		"-overcommit", "mem-lock=on",
+		"-rtc", "base=utc,clock=host",
+		"-drive", "if=pflash,format=raw,readonly=on,unit=0,file=" + code,
+		"-drive", "if=pflash,format=raw,unit=1,file=" + vars,
+		"-chardev", "socket,id=tpm0,path=" + filepath.Join(run, "swtpm.sock"),
+		"-tpmdev", "emulator,id=tpmdev0,chardev=tpm0",
+		"-device", "tpm-crb,tpmdev=tpmdev0",
+		"-object", "iothread,id=io0",
+		"-drive", "if=none,id=drive0,file=" + d.diskPath() + ",format=raw,cache=none,aio=native,discard=unmap",
+		"-device", "virtio-blk-pci,drive=drive0,iothread=io0,num-queues=4",
+		"-device", fmt.Sprintf("vhost-vsock-pci,guest-cid=%d", d.guestCID()),
+		"-device", "virtio-serial-pci,id=virtser0",
+		"-chardev", "socket,id=qga0,path=" + filepath.Join(run, "qga.sock") + ",server=on,wait=off",
+		"-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0",
+		"-chardev", "socket,id=fs0,path=" + filepath.Join(runtimeDir(), "vm", "virtiofsd-hostshare.sock"),
+		"-device", "vhost-user-fs-pci,chardev=fs0,tag=hostshare",
+		"-chardev", "socket,id=fs1,path=" + filepath.Join(runtimeDir(), "vm", "virtiofsd-phial-secrets.sock"),
+		"-device", "vhost-user-fs-pci,chardev=fs1,tag=phial-secrets",
+		"-debugcon", "file:" + filepath.Join(run, "ovmf-debug.log"),
+		"-global", "isa-debugcon.iobase=0x402",
+		"-qmp", "unix:" + filepath.Join(run, "qmp.sock") + ",server=on,wait=off",
+		"-pidfile", filepath.Join(run, "qemu.pid"),
+		"-device", "qemu-xhci,id=xhci0",
+	}
+
+	for index, share := range d.Shares {
+		tag := ShareTag(share)
+		id := fmt.Sprintf("fsx%d", index)
+
+		args = append(args,
+			"-chardev", "socket,id="+id+",path="+filepath.Join(runtimeDir(), "vm", "virtiofsd-"+tag+".sock"),
+			"-device", "vhost-user-fs-pci,chardev="+id+",tag="+tag,
+		)
+	}
+
+	if def2 := d.SecureBoot; def2 {
+		args = append(args, "-global", "driver=cfi.pflash01,property=secure,value=on")
+	}
+
+	switch d.Display {
+	case "egl-headless":
+		args = append(args, "-display", "egl-headless")
+	case "gtk":
+		args = append(args, "-display", "gtk,gl=on,grab-on-hover=on")
+	case "none":
+		args = append(args, "-display", "none")
+	}
+
+	switch d.GPU {
+	case "venus":
+		args = append(args, "-device", "virtio-vga-gl,venus=on,blob=on,hostmem=4G,drm_native_context=on")
+	case "virgl":
+		args = append(args, "-device", "virtio-vga-gl,blob=off")
+	case "none":
+		args = append(args, "-device", "virtio-vga")
+	}
+
+	if d.Audio == "hda" {
+		args = append(args, "-audiodev", "pipewire,id=snd0", "-device", "intel-hda", "-device", "hda-duplex,audiodev=snd0")
+	}
+
+	lanIf := "phialtap0"
+	if d.NetLAN == "on" || (d.NetLAN == "auto" && fileExists("/sys/class/net/"+lanIf)) {
+		args = append(args,
+			"-netdev", "tap,id=lan0,ifname="+lanIf+",script=no,downscript=no",
+			"-device", "virtio-net-pci,netdev=lan0,mac=52:54:00:5e:a1:01",
+		)
+	}
+
+	switch d.NetFallback {
+	case "passt":
+		args = append(args, "-nic", "passt,model=virtio-net-pci,mac=52:54:00:5e:a1:02")
+	case "stream":
+		args = append(args,
+			"-netdev", "stream,id=fb0,addr.type=unix,addr.path="+filepath.Join(run, "passt.sock")+",server=off",
+			"-device", "virtio-net-pci,netdev=fb0,mac=52:54:00:5e:a1:02",
+		)
+	}
+
+	var missing []string
+	for _, device := range d.USBDevices {
+		vendor, product, _ := strings.Cut(device, ":")
+		if usbDevicePresent(vendor, product) {
+			args = append(args, "-device", "usb-host,vendorid=0x"+vendor+",productid=0x"+product)
+		} else {
+			missing = append(missing, device)
+		}
+	}
+
+	if len(missing) > 0 {
+		fmt.Fprintf(os.Stderr, "phial: usb devices not present, skipping: %s\n", strings.Join(missing, " "))
+	}
+
+	if d.USBXHCI != "" {
+		if xhciControllerCount() <= 1 {
+			return nil, errors.New("refusing to pass the only xHCI controller to the guest")
+		}
+
+		sysfs := filepath.Join("/sys/bus/pci/devices", d.USBXHCI)
+		if _, err := os.Stat(sysfs); err != nil {
+			return nil, fmt.Errorf("no PCI device %s", d.USBXHCI)
+		}
+
+		driver, err := os.Readlink(filepath.Join(sysfs, "driver"))
+		if err != nil || filepath.Base(driver) != "vfio-pci" {
+			return nil, fmt.Errorf("%s is not bound to vfio-pci; run: run0 phial vfio bind %s", d.USBXHCI, d.USBXHCI)
+		}
+
+		args = append(args, "-device", "vfio-pci,host="+d.USBXHCI)
+	}
+
+	if boot.Shim != "" {
+		args = append(args, "-shim", boot.Shim)
+	}
+
+	if boot.Kernel != "" {
+		args = append(args, "-kernel", boot.Kernel)
+
+		if boot.Initrd != "" {
+			args = append(args, "-initrd", boot.Initrd)
+		}
+
+		if boot.Append != "" {
+			args = append(args, "-append", boot.Append)
+		}
+	}
+
+	if boot.ISO != "" {
+		args = append(args, "-drive", "file="+boot.ISO+",format=raw,media=cdrom,readonly=on")
+	}
+
+	if boot.KSImg != "" {
+		args = append(args,
+			"-drive", "file="+boot.KSImg+",format=raw,if=none,id=ksdisk,readonly=on,cache=none,aio=native",
+			"-device", "virtio-blk-pci,drive=ksdisk",
+		)
+	}
+
+	serial := boot.Serial
+	if serial == "" {
+		serial = "socket"
+	}
+
+	switch serial {
+	case "socket":
+		args = append(args, "-serial", "unix:"+filepath.Join(run, "console.sock")+",server=on,wait=off")
+	case "log":
+		args = append(args, "-serial", "file:"+filepath.Join(run, "console.log"))
+	}
+
+	return args, nil
+}
+
+func fileExists(path string) bool {
+	_, err := os.Stat(path)
+
+	return err == nil
+}
+
+func pinIOThread(pid int) {
+	for attempts := 0; attempts < 50; attempts++ {
+		tasks, _ := filepath.Glob(fmt.Sprintf("/proc/%d/task/*", pid))
+
+		for _, task := range tasks {
+			data, err := os.ReadFile(filepath.Join(task, "comm"))
+			if err != nil || strings.TrimSpace(string(data)) != "io0" {
+				continue
+			}
+
+			tid, err := strconv.Atoi(filepath.Base(task))
+			if err != nil {
+				continue
+			}
+
+			var set unix.CPUSet
+			set.Set(runtime.NumCPU() - 1)
+
+			if err := unix.SchedSetaffinity(tid, &set); err == nil {
+				return
+			}
+		}
+
+		time.Sleep(100 * time.Millisecond)
+	}
+}
+
+func (d Definition) RunExec(boot BootConfig) error {
+	return d.RunExecContext(context.Background(), boot)
+}
+
+func (d Definition) RunExecContext(ctx context.Context, boot BootConfig) error {
+	if err := d.prepare(); err != nil {
+		return err
+	}
+
+	args, err := d.BuildArgs(boot)
+	if err != nil {
+		return err
+	}
+
+	run := d.runtimePath()
+
+	if err := d.startDependencies(); err != nil {
+		return err
+	}
+
+	paths := []string{
+		filepath.Join(run, "swtpm.sock"),
+		filepath.Join(runtimeDir(), "vm", "virtiofsd-hostshare.sock"),
+		filepath.Join(runtimeDir(), "vm", "virtiofsd-phial-secrets.sock"),
+	}
+
+	for _, share := range d.Shares {
+		paths = append(paths, filepath.Join(runtimeDir(), "vm", "virtiofsd-"+ShareTag(share)+".sock"))
+	}
+
+	if err := waitForSockets(paths...); err != nil {
+		return err
+	}
+
+	command, err := qemuCommand(ctx, args)
+	if err != nil {
+		return err
+	}
+	command.Stdout = os.Stdout
+	command.Stderr = os.Stderr
+
+	if err := command.Start(); err != nil {
+		return err
+	}
+
+	go pinIOThread(command.Process.Pid)
+
+	return command.Wait()
+}
+
+func qemuCommand(ctx context.Context, args []string) (*exec.Cmd, error) {
+	if os.Getenv("FLATPAK_ID") != "" {
+		spawn, err := exec.LookPath("flatpak-spawn")
+		if err != nil {
+			return nil, fmt.Errorf("flatpak-spawn is missing: %w", err)
+		}
+
+		return exec.CommandContext(ctx, spawn, append([]string{"--host", "qemu-system-x86_64"}, args...)...), nil
+	}
+
+	binary, err := exec.LookPath("qemu-system-x86_64")
+	if err != nil {
+		return nil, err
+	}
+
+	return exec.CommandContext(ctx, binary, args...), nil
+}
+
+func userManager() (*systemdDbus.Conn, error) {
+	return systemdDbus.NewUserConnectionContext(context.Background())
+}
+
+func (d Definition) unit() string {
+	return "phial-vm@" + d.Name + ".service"
+}
+
+func (d Definition) startDependencies() error {
+	conn, err := userManager()
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+
+	units := []string{
+		"phial-swtpm@" + d.Name + ".service",
+		"phial-virtiofsd@hostshare.service",
+		"phial-virtiofsd@phial-secrets.service",
+	}
+
+	for _, share := range d.Shares {
+		units = append(units, "phial-virtiofsd@"+ShareTag(share)+".service")
+	}
+
+	for _, unit := range units {
+		if _, err := conn.StartUnitContext(context.Background(), unit, "replace", nil); err != nil {
+			return fmt.Errorf("start %s: %w", unit, err)
+		}
+	}
+
+	return nil
+}
+
+func (d Definition) Start() error {
+	conn, err := userManager()
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+
+	_, err = conn.StartUnitContext(context.Background(), d.unit(), "replace", nil)
+
+	return err
+}
+
+func (d Definition) Stop() error {
+	conn, err := userManager()
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+
+	_, err = conn.StopUnitContext(context.Background(), d.unit(), "replace", nil)
+
+	return err
+}
+
+func (d Definition) Active() (bool, error) {
+	conn, err := userManager()
+	if err != nil {
+		return false, err
+	}
+	defer conn.Close()
+
+	property, err := conn.GetUnitPropertyContext(context.Background(), d.unit(), "ActiveState")
+	if err != nil {
+		return false, err
+	}
+
+	state, ok := property.Value.Value().(string)
+
+	return ok && state == "active", nil
+}
diff --git a/internal/virt/progress.go b/internal/virt/progress.go
new file mode 100644
index 0000000000000000000000000000000000000000..6537c735913ce4713a148e0efe068a00278067dd
--- /dev/null
+++ b/internal/virt/progress.go
@@ -0,0 +1,193 @@
+package virt
+
+import (
+	"strconv"
+	"strings"
+	"sync"
+)
+
+var installSteps = []string{
+	"Downloading the installer",
+	"Starting the installer",
+	"Running pre-installation scripts",
+	"Installing packages",
+	"Running post-installation scripts",
+	"Configuring the system",
+	"Finishing the installation",
+}
+
+type InstallStatus struct {
+	Steps         []string
+	Current       int
+	Message       string
+	Downloaded    int64
+	Total         int64
+	Packages      int
+	PackagesTotal int
+	PackageName   string
+	Done          bool
+	Failed        string
+}
+
+var (
+	installMu       sync.Mutex
+	installStatuses = map[string]*InstallStatus{}
+)
+
+func InstallSteps() []string {
+	return append([]string{}, installSteps...)
+}
+
+func InstallStatusFor(name string) *InstallStatus {
+	installMu.Lock()
+	defer installMu.Unlock()
+
+	status, ok := installStatuses[name]
+	if !ok {
+		return nil
+	}
+
+	copied := *status
+	copied.Steps = append([]string{}, installSteps...)
+
+	return &copied
+}
+
+func updateInstallStatus(name string, apply func(status *InstallStatus)) {
+	installMu.Lock()
+	defer installMu.Unlock()
+
+	status, ok := installStatuses[name]
+	if !ok {
+		status = &InstallStatus{Steps: installSteps}
+		installStatuses[name] = status
+	}
+
+	apply(status)
+}
+
+func clearInstallStatus(name string) {
+	installMu.Lock()
+	defer installMu.Unlock()
+
+	delete(installStatuses, name)
+}
+
+func markInstallStep(name string, step int, message string) {
+	updateInstallStatus(name, func(status *InstallStatus) {
+		if step > status.Current {
+			status.Current = step
+		}
+		if message != "" {
+			status.Message = message
+		}
+	})
+}
+
+func markInstallProgress(name string, downloaded, total int64) {
+	updateInstallStatus(name, func(status *InstallStatus) {
+		status.Downloaded = downloaded
+		status.Total = total
+	})
+}
+
+func markInstallDone(name string) {
+	updateInstallStatus(name, func(status *InstallStatus) {
+		status.Current = len(installSteps) - 1
+		status.Done = true
+		status.Message = "Installation finished"
+	})
+}
+
+func markInstallFailed(name string, reason string) {
+	updateInstallStatus(name, func(status *InstallStatus) {
+		status.Failed = reason
+	})
+}
+
+var consoleMarkers = []struct {
+	Needle string
+	Step   int
+	Label  string
+}{
+	{"Starting installer", 1, "Starting the installer"},
+	{"Running pre-installation scripts", 2, "Running pre-installation scripts"},
+	{"Starting package installation process", 3, "Installing packages"},
+	{"Installing ", 3, "Installing packages"},
+	{"Performing post-installation setup tasks", 4, "Running post-installation scripts"},
+	{"Running post-installation scripts", 4, "Running post-installation scripts"},
+	{"Configuring installed system", 5, "Configuring the system"},
+	{"Writing network configuration", 5, "Configuring the system"},
+	{"Creating users", 5, "Configuring the system"},
+	{"Generating initramfs", 6, "Finishing the installation"},
+	{"Completing installation", 6, "Finishing the installation"},
+}
+
+func scanConsole(name string, content string) {
+	for _, marker := range consoleMarkers {
+		if strings.Contains(content, marker.Needle) {
+			markInstallStep(name, marker.Step, marker.Label)
+		}
+	}
+
+	markPackageProgress(name, content)
+}
+
+func markPackageProgress(name string, content string) {
+	position := strings.LastIndex(content, "Installing ")
+
+	for position >= 0 {
+		tail := content[position:]
+
+		if open := strings.Index(tail, "("); open >= 0 {
+			if close := strings.Index(tail[open:], ")"); close > 0 {
+				inside := tail[open+1 : open+close]
+
+				if slash := strings.Index(inside, "/"); slash > 0 {
+					done, doneErr := strconv.Atoi(strings.TrimSpace(inside[:slash]))
+					total, totalErr := strconv.Atoi(strings.TrimSpace(inside[slash+1:]))
+
+					if doneErr == nil && totalErr == nil && total > 0 {
+						packageName := strings.TrimSpace(tail[len("Installing "):open])
+
+						updateInstallStatus(name, func(status *InstallStatus) {
+							status.Packages = done
+							status.PackagesTotal = total
+							status.PackageName = packageName
+						})
+						return
+					}
+				}
+			}
+		}
+
+		position = strings.LastIndex(content[:position], "Installing ")
+	}
+}
+
+var (
+	installCancels sync.Map
+)
+
+func registerInstallCancel(name string, cancel func()) {
+	installCancels.Store(name, cancel)
+}
+
+func unregisterInstallCancel(name string) {
+	installCancels.Delete(name)
+}
+
+func CancelInstall(name string) bool {
+	value, ok := installCancels.Load(name)
+	if !ok {
+		return false
+	}
+
+	value.(func())()
+
+	return true
+}
+
+func ClearInstallStatus(name string) {
+	clearInstallStatus(name)
+}
