+func (s *Service) VmCreate(ctx context.Context, req *mcpgo.CallToolRequest, input VmCreateInput) (*mcpgo.CallToolResult, any, error) {
+	if input.Name == "" {
+		return nil, nil, fmt.Errorf("the VM needs a name")
+	}
+
+	def := virt.Defaults(input.Name)
+
+	def.SecureBoot = true
+
+	if input.VCPUs != 0 {
+		def.VCPUs = input.VCPUs
+	}
+
+	if input.Memory != "" {
+		def.Memory = input.Memory
+	}
+
+	if input.Disk != "" {
+		def.Disk = input.Disk
+	}
+
+	if input.DiskSize != "" {
+		def.DiskSize = input.DiskSize
+	}
+
+	if input.Display != "" {
+		def.Display = input.Display
+	}
+
+	if input.GPU != "" {
+		def.GPU = input.GPU
+	}
+
+	if input.SecureBoot {
+		def.SecureBoot = true
+	}
+
+	if input.USBDevices != nil {
+		def.USBDevices = input.USBDevices
+	}
+
+	if input.USBXHCI != "" {
+		def.USBXHCI = input.USBXHCI
+	}
+
+	if input.NetLAN != "" {
+		def.NetLAN = input.NetLAN
+	}
+
+	if input.NetFallback != "" {
+		def.NetFallback = input.NetFallback
+	}
+
+	if input.Audio != "" {
+		def.Audio = input.Audio
+	}
+
+	if err := def.Save(); err != nil {
+		return nil, nil, err
+	}
+
+	if err := virt.WriteSSHConfig(); err != nil {
+		return nil, nil, err
+	}
+
+	return nil, map[string]string{"state": "created"}, nil
+}
