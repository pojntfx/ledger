+	SecureBoot  bool     `json:"secure_boot,omitempty" jsonschema:"whether Secure Boot runs, optional"`
+	USBDevices  []string `json:"usb_devices,omitempty" jsonschema:"the USB vendor:product list, optional"`
+	USBXHCI     string   `json:"usb_xhci,omitempty" jsonschema:"the hub controller PCI address, optional"`
+	NetLAN      string   `json:"net_lan,omitempty" jsonschema:"auto, on, or off, optional"`
+	NetFallback string   `json:"net_fallback,omitempty" jsonschema:"passt, stream, or off, optional"`
+	Audio       string   `json:"audio,omitempty" jsonschema:"none or hda, optional"`
