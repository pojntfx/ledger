+func (a *App) showShareDialog(def virt.Definition) {
+	paths, err := filechooser.OpenFile("", i18n.L("Share Folder"), &filechooser.OpenFileOptions{
+		Directory:   true,
+		AcceptLabel: i18n.L("_Share"),
+	})
+	if err != nil {
+		a.showError(err)
+		return
+	}
+
+	for _, uri := range paths {
+		share, err := filePathFromURI(uri)
+		if err != nil {
+			a.showError(err)
+			continue
+		}
+
+		a.goAsync(func() (string, error) {
+			_, _, err := a.Service.ShareAdd(a.Ctx, nil, mcp.ShareInput{Name: def.Name, Path: share})
+			if err != nil {
+				return "", err
+			}
+			a.idle(func() { a.refreshVMDetail(def.Name) })
+			return i18n.L("Folder shared"), nil
+		})
+	}
+}
+
+func filePathFromURI(uri string) (string, error) {
+	if !strings.HasPrefix(uri, "file://") {
+		return uri, nil
+	}
+
+	parsed, err := url.Parse(uri)
+	if err != nil {
+		return "", err
+	}
+
+	path, err := url.PathUnescape(parsed.Path)
+	if err != nil {
+		return "", err
+	}
+
+	return path, nil
+}
