+
+# phase_install shows the installation while it runs, the confirmation that
+# cancels it, and the state after the cancel.
+phase_install() {
+  log "phase: installing"
+  start
+  world_state
+  expect_machine "$DEMO"
+  expect_machine "$SECOND"
