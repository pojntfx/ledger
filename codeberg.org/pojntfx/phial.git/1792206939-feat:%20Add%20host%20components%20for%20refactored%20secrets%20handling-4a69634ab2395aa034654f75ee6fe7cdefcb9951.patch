diff --git a/tests/ui-states.sh b/tests/ui-states.sh
new file mode 100755
index 0000000000000000000000000000000000000000..c1ab907363bd8d837f440fc49e3a945c3b7cee1d
--- /dev/null
+++ b/tests/ui-states.sh
@@ -0,0 +1,656 @@
+#!/usr/bin/env bash
+# Drives every screen, dialog, and state of the app and writes one PNG per
+# state to ./screenshots. The window is rendered with the GTK snapshot API, so
+# no compositor screenshot is needed.
+#
+# The run uses two worlds:
+#   - an isolated world under /tmp/phial-states/world, so that the pages that
+#     need an empty host or a throwaway machine never touch a real machine, and
+#   - the real host, for the states that need a booted guest.
+#
+# PHASES selects the phases: "isolated", "real", or "all".
+set -u
+
+cd "$(dirname "$0")/.."
+
+export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
+export DISPLAY="${DISPLAY:-:0}"
+export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"
+GSETTINGS="${GSETTINGS:-/usr/bin/gsettings}"
+export GSETTINGS_SCHEMA_DIR="$PWD/assets/resources"
+export LC_ALL=C.UTF-8
+export LANG=C.UTF-8
+export PHIAL_RUNTIME_DIR="${PHIAL_RUNTIME_DIR:-/tmp/phial-states/runtime/phial}"
+export SOCK="$PHIAL_RUNTIME_DIR/mcp.sock"
+
+OUT="${OUT:-$PWD/screenshots}"
+LOG="${LOG:-/tmp/phial-states.log}"
+APP_ID="com.pojtinger.felicitas.Phial"
+APP_PATH="/com/pojtinger/felicitas/Phial"
+BIN="${BIN:-/tmp/phial-states-app}"
+WORLD="${WORLD:-/tmp/phial-states/world}"
+DEMO="${DEMO:-phial-ui-demo}"
+SECOND="${SECOND:-phial-ui-second}"
+REAL="${REAL:-test-vm}"
+PHASES="${PHASES:-all}"
+
+mkdir -p "$OUT"
+
+go build -o "$BIN" -ldflags="-X 'main.LocaleDir=$PWD/po'" . || exit 1
+
+pid=""
+missing=0
+
+log() {
+  echo "== $*"
+}
+
+fail() {
+  echo "!! $*" >&2
+  missing=$((missing + 1))
+}
+
+start() {
+  # The application owns its name, so an instance left over from an earlier run
+  # would answer every action of this one.
+  pkill -f "$BIN" 2>/dev/null
+  sleep 1
+
+  "$BIN" >>"$LOG" 2>&1 &
+  pid=$!
+
+  for _ in $(seq 1 60); do
+    if gdbus call --session --dest "$APP_ID" --object-path "$APP_PATH" --method org.gtk.Actions.List >/dev/null 2>&1; then
+      break
+    fi
+    sleep 1
+  done
+
+  if ! kill -0 "$pid" 2>/dev/null; then
+    fail "another instance answered instead of the one that was started"
+    return 1
+  fi
+
+  sleep 2
+
+  return 0
+}
+
+stop() {
+  kill "$pid" 2>/dev/null
+  sleep 1
+  kill -9 "$pid" 2>/dev/null
+  wait "$pid" 2>/dev/null
+  pid=""
+
+  for _ in $(seq 1 10); do
+    if ! pgrep -f "$BIN" >/dev/null 2>&1; then
+      return 0
+    fi
+    sleep 1
+  done
+
+  pkill -9 -f "$BIN" 2>/dev/null
+  sleep 2
+
+  if ! pgrep -f "$BIN" >/dev/null 2>&1; then
+    return 0
+  fi
+
+  fail "an instance of the application is still running"
+}
+
+act() {
+  gdbus call --session --dest "$APP_ID" --object-path "$APP_PATH" --method org.gtk.Actions.Activate "$1" "[]" "[]" >/dev/null 2>&1
+}
+
+act_string() {
+  gdbus call --session --dest "$APP_ID" --object-path "$APP_PATH" --method org.gtk.Actions.Activate "$1" "[<@s '$2'>]" "[]" >/dev/null 2>&1
+}
+
+page() {
+  act_string select-page "$1"
+  sleep 4
+}
+
+# set_size asks the running window for another size. The settings backend of
+# a test host is often read-only, so the size travels through an action.
+set_size() {
+  act_string window-size "$1x$2"
+  sleep 2
+}
+
+# capture renders the window. The first frames of a freshly mapped window can
+# be empty, so an empty picture is taken again before it counts as a failure.
+capture() {
+  size=0
+
+  attempt=0
+
+  for _ in $(seq 1 4); do
+    attempt=$((attempt + 1))
+    sleep 1
+    act_string capture "$OUT/$1.png"
+    sleep 1
+    act_string capture "$OUT/$1.png"
+    sleep 1
+
+    if [ -s "$OUT/$1.png" ]; then
+      size=$(stat -c %s "$OUT/$1.png")
+    fi
+
+    if [ "$size" -ge 5000 ]; then
+      log "captured $1.png ($size bytes)"
+      return 0
+    fi
+
+    # A window that lost its allocation draws again after a resize, so nudge it
+    # once before the next attempt. The size that counts is set back first.
+    if [ "$attempt" -eq 2 ]; then
+      act_string window-size "1021x721"
+      sleep 1
+      act_string window-size "1020x720"
+      sleep 1
+    fi
+  done
+
+  if [ "$size" -eq 0 ]; then
+    fail "$1.png was not written"
+    return 1
+  fi
+
+  fail "$1.png looks empty ($size bytes)"
+  return 1
+}
+
+mcp() {
+  ./tests/mcp-call.sh "$1" "$2"
+}
+
+# world_state records which machines exist, so that a phase that loses one is
+# easy to find in the log.
+world_state() {
+  log "machines: $(ls "$XDG_CONFIG_HOME/phial/vms" 2>/dev/null | tr '\n' ' ')"
+}
+
+expect_machine() {
+  if [ ! -f "$XDG_CONFIG_HOME/phial/vms/$1.json" ]; then
+    fail "the machine $1 is missing"
+  fi
+}
+
+close_dialog() {
+  act close-dialog
+  sleep 2
+}
+
+# dialog_shot shows one dialog that the run cannot close, so the application
+# restarts around it.
+dialog_shot() {
+  start
+  page "$2"
+  act "$3"
+  sleep 3
+  capture "$1"
+  stop
+}
+
+# The isolated world is a host without a machine and without a secret. The
+# agents of the session stay out of the screenshots: a throwaway SSH agent and
+# a throwaway keyring stand in, so no real key or secret leaves the host.
+isolated_world() {
+  export XDG_CONFIG_HOME="$WORLD/config"
+  export XDG_DATA_HOME="$WORLD/data"
+
+  rm -rf "$WORLD"
+  mkdir -p "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$WORLD/gnupg"
+
+  export SSH_AUTH_SOCK="$WORLD/ssh-agent.sock"
+  export GNUPGHOME="$WORLD/gnupg"
+
+  ssh-agent -D -a "$SSH_AUTH_SOCK" &
+  AGENT_PID=$!
+
+  chmod 700 "$GNUPGHOME"
+}
+
+real_world() {
+  unset XDG_CONFIG_HOME XDG_DATA_HOME
+}
+
+# phase_empty shows a host that has no machine: every page of the sidebar in
+# its empty state, and every dialog that does not need a machine.
+# phase_empty shows a host that has no machine: every page of the sidebar in
+# its empty state, and every dialog that does not need a machine.
+phase_empty() {
+  log "phase: empty host"
+  start
+
+  page "no-machines"
+  capture 01-no-machines
+
+  page "secrets"
+  capture 02-secrets-empty
+
+  page "grants"
+  capture 03-grants-empty
+
+  act new-machine
+  sleep 3
+  capture 05-new-machine
+  act_string dialog-text "_Name=acme"
+  sleep 1
+  capture 06-new-machine-name
+  close_dialog
+
+  act system-setup
+  sleep 4
+  capture 10-system-setup
+  close_dialog
+
+  act add-secret
+  sleep 3
+  capture 14-add-secret
+  act_string dialog-option "Injected into host requests"
+  sleep 1
+  capture 15-add-secret-proxy
+  act_string dialog-text "_Name=github"
+  act_string dialog-text "_Value=demo-value"
+  act_string dialog-text "_Upstream URL=https://api.github.com"
+  sleep 2
+  capture 16-add-secret-filled
+  close_dialog
+
+  act generate-key
+  sleep 3
+  capture 17-generate-key
+  act_string dialog-option "GnuPG key"
+  sleep 1
+  capture 17-generate-key-gpg
+  close_dialog
+
+  # The adaptive preview of libadwaita is the mobile view of the same window,
+  # so the narrow states need no second window size.
+  act mobile-preview
+  sleep 2
+  page "no-machines"
+  capture 18-mobile-no-machines
+  page "secrets"
+  capture 19-mobile-secrets
+  page "grants"
+  capture 20-mobile-grants
+  act mobile-preview
+  sleep 2
+
+  stop
+
+  # These dialogs close only on a response, so each one gets its own run.
+  dialog_shot 11-preferences "no-machines" preferences
+  dialog_shot 12-shortcuts "no-machines" shortcuts
+  dialog_shot 13-about "no-machines" about
+}
+
+# phase_machine shows one machine that is not installed, with every dialog that
+# belongs to it.
+phase_machine() {
+  log "phase: one machine, not installed"
+  start
+  world_state
+
+  mcp vm.create "{\"name\":\"$DEMO\",\"memory\":\"4G\",\"disk_size\":\"16G\"}" >/dev/null
