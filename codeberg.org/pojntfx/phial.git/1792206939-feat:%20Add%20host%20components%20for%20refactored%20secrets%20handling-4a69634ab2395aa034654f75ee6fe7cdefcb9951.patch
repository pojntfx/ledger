+
+  start
+  mcp vm.cancelInstall "{\"name\":\"$SECOND\"}" >/dev/null
+  sleep 3
+  page "machine:$SECOND"
+  capture 73-install-cancelled
+  stop
+}
+
+# phase_mobile shows the same screens in the adaptive preview of libadwaita,
+# which is the mobile view of one window.
+phase_mobile() {
+  log "phase: mobile"
+  start
+  world_state
+  expect_machine "$DEMO"
+
+  act mobile-preview
+  sleep 2
+
+  page "machine:$DEMO"
+  capture 80-mobile-machine
+  page "secrets"
+  capture 81-mobile-secrets
+  page "grants"
+  capture 82-mobile-grants
+
+  page "machine:$DEMO"
+  act edit-machine
+  sleep 3
+  capture 84-mobile-machine-settings
+  close_dialog
+
+  act add-device
+  sleep 4
+  capture 85-mobile-add-device
+  close_dialog
+
+  act add-hub
+  sleep 4
+  capture 86-mobile-add-hub
+  close_dialog
+
+  act show-apps
+  sleep 4
+  capture 87-mobile-guest-applications
+  close_dialog
+
+  act show-rdp
+  sleep 3
+  capture 88-mobile-remote-desktop
+  close_dialog
+
+  act_string share-path "/home/pojntfx/Documents"
+  sleep 3
+  capture 89-mobile-share-folder
+  close_dialog
+
+  act mobile-preview
+  sleep 2
+
+  # The demo secret leaves the keyring of the host again.
+  mcp secrets.remove "{\"name\":\"demo\"}" >/dev/null
+  sleep 2
+
+  stop
+}
+
+# phase_real uses the real host, because only a booted guest shows the usage
+# figures, the agent banner, and the provisioning state.
+phase_real() {
+  log "phase: real host"
+  start
+  # The stored window size comes from an older run, so the desktop size is set
+  # here for the states of this phase.
+  set_size 1020 720
+
+  page "secrets"
+  capture 90-real-secrets
+  page "grants"
+  capture 91-real-grants
+
+  page "machine:$REAL"
+  capture 92-real-machine-stopped
+
+  act toggle-machine
+  sleep 3
+  capture 93-real-machine-starting
+  sleep 45
+  capture 94-real-machine-running
+  sleep 15
+  capture 95-real-machine-running-usage
+
+  act provision-machine
+  sleep 4
+  capture 96-real-provisioning
+  sleep 120
+  capture 97-real-provisioned
+
+  act quit
+  sleep 3
+  capture 98-real-quit-confirmation
+  stop
+
+  # The machine goes back to the state it was found in.
+  start
+  page "machine:$REAL"
+  sleep 2
+  act toggle-machine
+  sleep 8
+  capture 99-real-machine-stopped-again
+  stop
+}
+
+main() {
+  rm -f "$LOG"
+
+  # The application owns its name, so the installed copy would answer the
+  # actions of this run and the screenshots would show its window. A forward
+  # service runs the same binary with a subcommand, so only the bare command
+  # counts here.
+  if pgrep -f "(^|/)phial$" >/dev/null 2>&1; then
+    echo "!! close the running Phial window first" >&2
+    exit 1
+  fi
+
+  case "$PHASES" in
+  isolated | all)
+    isolated_world
+    phase_empty
+    phase_machine
+    phase_data
+    phase_install
+    phase_mobile
+    ;;
+  esac
+
+
+  case "$PHASES" in
+  real | all)
+    real_world
+    phase_real
+    ;;
+  esac
+
+  set_size 1020 720
+
+  if [ -n "${AGENT_PID:-}" ]; then
+    kill "$AGENT_PID" 2>/dev/null
+  fi
+
+  rm -rf "$WORLD"
+
+  count=$(ls -1 "$OUT"/*.png 2>/dev/null | wc -l)
+  errors=$(grep -c "level=ERROR" "$LOG" 2>/dev/null || true)
+
+  echo
+  echo "screenshots: $count"
+  echo "log errors: $errors"
+
+  if [ "$missing" -gt 0 ]; then
+    echo "failed states: $missing" >&2
+    exit 1
+  fi
+
+  echo "every state captured"
+}
+
+main "$@"

