diff --git a/internal/components/application.go b/internal/components/application.go
index ba0bbd4724e8c82f7eb173283b6633599790f319..0512bcf97e1de62cbb1cd3283ed81eecb6cbab2e 100644
--- a/internal/components/application.go
+++ b/internal/components/application.go
@@ -4,6 +4,7 @@ import (
 	"context"
 	"log/slog"
 	"runtime"
+	"time"
 	"unsafe"
 
 	"codeberg.org/pojntfx/phial/assets/resources"
@@ -111,7 +112,14 @@
 						return nil
 					},
 				},
-				func(_ context.Context) (bool, error) {
+				// TODO: Remove this mock once actual implementation exists
+				func(ctx context.Context) (bool, error) {
+					select {
+					case <-ctx.Done():
+						return false, ctx.Err()
+					case <-time.After(time.Millisecond * 750):
+					}
+
 					return false, nil
 				},
 			)
