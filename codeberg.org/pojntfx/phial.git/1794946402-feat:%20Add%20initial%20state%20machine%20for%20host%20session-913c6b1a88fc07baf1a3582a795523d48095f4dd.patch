diff --git a/pkg/state/constants.go b/pkg/state/constants.go
new file mode 100644
index 0000000000000000000000000000000000000000..3482b0c118c4e72d30b3354f7db8ca1ea22d95a2
--- /dev/null
+++ b/pkg/state/constants.go
@@ -0,0 +1,43 @@
+package state
+
+type sessionState string
+
+const (
+	sessionBooting sessionState = "booting"
+	sessionSetup   sessionState = "setup"
+
+	sessionSetupWelcome sessionState = "setup-welcome"
+	sessionSetupFolders sessionState = "setup-folders"
+	sessionSetupHost    sessionState = "setup-host"
+	sessionSetupSystem  sessionState = "setup-system"
+	sessionSetupFinish  sessionState = "setup-finish"
+
+	sessionReady sessionState = "ready"
+)
+
+type sessionTrigger string
+
+const (
+	triggerBoot      sessionTrigger = "boot"
+	triggerSetupNext sessionTrigger = "setupNext"
+	triggerSetupBack sessionTrigger = "setupBack"
+	triggerFinish    sessionTrigger = "finish"
+)
+
+type SetupPage string
+
+const (
+	SetupPageWelcome SetupPage = "welcome"
+	SetupPageFolders SetupPage = "folders"
+	SetupPageHost    SetupPage = "host"
+	SetupPageSystem  SetupPage = "system"
+	SetupPageFinish  SetupPage = "finish"
+)
+
+type FolderKind string
+
+const (
+	FolderConfig FolderKind = "config"
+	FolderData   FolderKind = "data"
+	FolderSSH    FolderKind = "ssh"
+)
diff --git a/pkg/state/session.go b/pkg/state/session.go
new file mode 100644
index 0000000000000000000000000000000000000000..e9e05c5ac66d87a7e4c2b5220c2dab3b042a08ea
--- /dev/null
+++ b/pkg/state/session.go
@@ -0,0 +1,232 @@
+package state
+
+import (
+	"context"
+	"log/slog"
+	"reflect"
+	"strings"
+
+	"github.com/qmuntal/stateless"
+)
+
+type SessionHooks struct {
+	OnSetupStep func(ctx context.Context, page SetupPage) error
+	OnReady     func(ctx context.Context) error
+}
+
+type Folders struct {
+	Config string
+	Data   string
+	SSH    string
+}
+
+type Session struct {
+	folders Folders
+
+	hostCommandCopied   bool
+	systemCommandCopied bool
+
+	ctx   context.Context
+	log   *slog.Logger
+	hooks *SessionHooks
+
+	machine *stateless.StateMachine
+}
+
+func NewSession(ctx context.Context, log *slog.Logger, hooks *SessionHooks) *Session {
+	s := &Session{
+		ctx:   ctx,
+		log:   log,
+		hooks: hooks,
+
+		machine: stateless.NewStateMachine(sessionBooting),
+	}
+
+	s.machine.SetTriggerParameters(triggerBoot, reflect.TypeFor[bool]())
+	s.machine.SetTriggerParameters(triggerSetupNext, reflect.TypeFor[bool]())
+
+	s.machine.Configure(sessionBooting).
+		Permit(triggerBoot, sessionSetup, notOnboarded).
+		Permit(triggerBoot, sessionReady, isOnboarded)
+
+	s.machine.Configure(sessionSetup).InitialTransition(sessionSetupWelcome)
+
+	s.machine.
+		Configure(sessionSetupWelcome).
+		SubstateOf(sessionSetup).
+		OnEntry(s.onSetupWelcome).
+		Permit(triggerSetupNext, sessionSetupFolders)
+
+	s.machine.
+		Configure(sessionSetupFolders).
+		SubstateOf(sessionSetup).
+		OnEntry(s.onSetupFolders).
+		Permit(triggerSetupNext, sessionSetupHost, s.foldersValid).
+		Permit(triggerSetupBack, sessionSetupWelcome)
+
+	s.machine.
+		Configure(sessionSetupHost).
+		SubstateOf(sessionSetup).
+		OnEntry(s.onSetupHost).
+		Permit(triggerSetupNext, sessionSetupSystem, hostReady, s.hostCommandCopiedGuard).
+		Permit(triggerSetupBack, sessionSetupFolders)
+
+	s.machine.
+		Configure(sessionSetupSystem).
+		SubstateOf(sessionSetup).
+		OnEntry(s.onSetupSystem).
+		Permit(triggerSetupNext, sessionSetupFinish, s.systemCommandCopiedGuard).
+		Permit(triggerSetupBack, sessionSetupHost)
+
+	s.machine.
+		Configure(sessionSetupFinish).
+		SubstateOf(sessionSetup).
+		OnEntry(s.onSetupFinish).
+		Permit(triggerFinish, sessionReady).
+		Permit(triggerSetupBack, sessionSetupSystem)
+
+	s.machine.Configure(sessionReady).OnEntry(s.onReady)
+
+	return s
+}
+
+func (s *Session) ToGraph() string {
+	return s.machine.ToGraph()
+}
+
+func (s *Session) String() string {
+	return s.machine.String()
+}
+
+func notOnboarded(_ context.Context, args ...any) bool {
+	if len(args) == 0 {
+		return false
+	}
+
+	onboarded, ok := args[0].(bool)
+
+	return ok && !onboarded
+}
+
+func isOnboarded(_ context.Context, args ...any) bool {
+	if len(args) == 0 {
+		return false
+	}
+
+	onboarded, ok := args[0].(bool)
+
+	return ok && onboarded
+}
+
+func hostReady(_ context.Context, args ...any) bool {
+	if len(args) == 0 {
+		return false
+	}
+
+	ready, ok := args[0].(bool)
+
+	return ok && ready
+}
+
+func (s *Session) foldersValid(_ context.Context, _ ...any) bool {
+	for _, path := range []string{s.folders.Config, s.folders.Data, s.folders.SSH} {
+		if strings.TrimSpace(path) == "" {
+			return false
+		}
+	}
+
+	return true
+}
+
+func (s *Session) hostCommandCopiedGuard(_ context.Context, _ ...any) bool {
+	return s.hostCommandCopied
+}
+
+func (s *Session) systemCommandCopiedGuard(_ context.Context, _ ...any) bool {
+	return s.systemCommandCopied
+}
+
+func (s *Session) onSetupStep(ctx context.Context, page SetupPage) error {
+	s.log.InfoContext(s.ctx, "Calling onSetupStep hook", "page", page)
+
+	return s.hooks.OnSetupStep(ctx, page)
+}
+
+func (s *Session) onSetupWelcome(ctx context.Context, _ ...any) error {
+	return s.onSetupStep(ctx, SetupPageWelcome)
+}
+
+func (s *Session) onSetupFolders(ctx context.Context, _ ...any) error {
+	return s.onSetupStep(ctx, SetupPageFolders)
+}
+
+func (s *Session) onSetupHost(ctx context.Context, _ ...any) error {
+	return s.onSetupStep(ctx, SetupPageHost)
+}
+
+func (s *Session) onSetupSystem(ctx context.Context, _ ...any) error {
+	return s.onSetupStep(ctx, SetupPageSystem)
+}
+
+func (s *Session) onSetupFinish(ctx context.Context, _ ...any) error {
+	return s.onSetupStep(ctx, SetupPageFinish)
+}
+
+func (s *Session) onReady(ctx context.Context, _ ...any) error {
+	s.log.InfoContext(s.ctx, "Calling onReady hook")
+
+	return s.hooks.OnReady(ctx)
+}
+
+func (s *Session) Boot(ctx context.Context, onboarded bool) error {
+	return s.machine.FireCtx(ctx, triggerBoot, onboarded)
+}
+
+func (s *Session) SetupNext(ctx context.Context, hostReady bool) error {
+	return s.machine.FireCtx(ctx, triggerSetupNext, hostReady)
+}
+
+func (s *Session) SetupBack(ctx context.Context) error {
+	return s.machine.FireCtx(ctx, triggerSetupBack)
+}
+
+func (s *Session) SetupFinish(ctx context.Context) error {
+	return s.machine.FireCtx(ctx, triggerFinish)
+}
+
+func (s *Session) CanSetupNext(ctx context.Context, hostReady bool) (bool, error) {
+	return s.machine.CanFireCtx(ctx, triggerSetupNext, hostReady)
+}
+
+func (s *Session) CanSetupBack(ctx context.Context) (bool, error) {
+	return s.machine.CanFireCtx(ctx, triggerSetupBack)
+}
+
+func (s *Session) CanSetupFinish(ctx context.Context) (bool, error) {
+	return s.machine.CanFireCtx(ctx, triggerFinish)
+}
+
+func (s *Session) SetFolder(kind FolderKind, path string) {
+	switch kind {
+	case FolderConfig:
+		s.folders.Config = path
+	case FolderData:
+		s.folders.Data = path
+	case FolderSSH:
+		s.folders.SSH = path
+	default:
+		return
+	}
+
+	s.hostCommandCopied = false
+	s.systemCommandCopied = false
+}
+
+func (s *Session) SetupCopy() {
+	switch s.machine.MustState() {
+	case sessionSetupHost:
+		s.hostCommandCopied = true
+	case sessionSetupSystem:
+		s.systemCommandCopied = true
+	}
+}
diff --git a/pkg/state/session_test.go b/pkg/state/session_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..59921a695b74ee46b2e04b92b18708dba603dfc0
--- /dev/null
+++ b/pkg/state/session_test.go
@@ -0,0 +1,129 @@
+package state
+
+import (
+	"context"
+	"testing"
+
+	"github.com/neilotoole/slogt"
+	"github.com/stretchr/testify/require"
+)
+
+func newTestingSession(t *testing.T, hooks *SessionHooks) *Session {
+	return NewSession(t.Context(), slogt.New(t), hooks)
+}
+
+func TestSessionBootSetup(t *testing.T) {
+	var (
+		pages []SetupPage
+		ready int
+	)
+
+	s := newTestingSession(t, &SessionHooks{
+		OnSetupStep: func(_ context.Context, page SetupPage) error {
+			pages = append(pages, page)
+
+			return nil
+		},
+		OnReady: func(_ context.Context) error {
+			ready++
+
+			return nil
+		},
+	})
+
+	require.NoError(t, s.Boot(t.Context(), false))
+	require.Equal(t, []SetupPage{SetupPageWelcome}, pages)
+	require.Zero(t, ready)
+}
+
+func TestSessionBootReady(t *testing.T) {
+	var (
+		pages []SetupPage
+		ready int
+	)
+
+	s := newTestingSession(t, &SessionHooks{
+		OnSetupStep: func(_ context.Context, page SetupPage) error {
+			pages = append(pages, page)
+
+			return nil
+		},
+		OnReady: func(_ context.Context) error {
+			ready++
+
+			return nil
+		},
+	})
+
+	require.NoError(t, s.Boot(t.Context(), true))
+	require.Empty(t, pages)
+	require.Equal(t, 1, ready)
+}
+
+func TestSessionSetupNext(t *testing.T) {
+	var (
+		pages []SetupPage
+		ready int
+	)
+
+	s := newTestingSession(t, &SessionHooks{
+		OnSetupStep: func(_ context.Context, page SetupPage) error {
+			pages = append(pages, page)
+
+			return nil
+		},
+		OnReady: func(_ context.Context) error {
+			ready++
+
+			return nil
+		},
+	})
+
+	require.NoError(t, s.Boot(t.Context(), false))
+
+	s.SetFolder(FolderConfig, "/tmp/config")
+	s.SetFolder(FolderData, "/tmp/data")
+	s.SetFolder(FolderSSH, "/tmp/ssh")
+
+	require.NoError(t, s.SetupNext(t.Context(), false))
+	require.NoError(t, s.SetupNext(t.Context(), false))
+
+	s.SetupCopy()
+
+	require.NoError(t, s.SetupNext(t.Context(), true))
+
+	s.SetupCopy()
+
+	require.NoError(t, s.SetupNext(t.Context(), true))
+	require.NoError(t, s.SetupFinish(t.Context()))
+
+	require.Equal(t, []SetupPage{SetupPageWelcome, SetupPageFolders, SetupPageHost, SetupPageSystem, SetupPageFinish}, pages)
+	require.Equal(t, 1, ready)
+}
+
+func TestSessionSetupBack(t *testing.T) {
+	var (
+		pages []SetupPage
+		ready int
+	)
+
+	s := newTestingSession(t, &SessionHooks{
+		OnSetupStep: func(_ context.Context, page SetupPage) error {
+			pages = append(pages, page)
+
+			return nil
+		},
+		OnReady: func(_ context.Context) error {
+			ready++
+
+			return nil
+		},
+	})
+
+	require.NoError(t, s.Boot(t.Context(), false))
+	require.NoError(t, s.SetupNext(t.Context(), false))
+	require.NoError(t, s.SetupBack(t.Context()))
+
+	require.Equal(t, []SetupPage{SetupPageWelcome, SetupPageFolders, SetupPageWelcome}, pages)
+	require.Zero(t, ready)
+}

