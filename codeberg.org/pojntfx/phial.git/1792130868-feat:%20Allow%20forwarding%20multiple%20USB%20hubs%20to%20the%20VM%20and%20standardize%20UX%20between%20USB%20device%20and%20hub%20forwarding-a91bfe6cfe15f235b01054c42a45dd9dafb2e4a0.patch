+// UnmarshalJSON accepts the single controller of an old definition as well
+// as the list that a current definition carries, both under usb_xhci.
+func (d *Definition) UnmarshalJSON(data []byte) error {
+	type alias Definition
+
+	aux := struct {
+		alias
+		RawUSBXHCIs json.RawMessage `json:"usb_xhci"`
+	}{}
+
+	if err := json.Unmarshal(data, &aux); err != nil {
+		return err
