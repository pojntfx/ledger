+// showAddHubDialog lists the xHCI controllers of the host and binds one of
+// them to the machine. A controller can only belong to one machine, so the
+// dialog hides the controllers that any machine already uses.
+func (a *App) showAddHubDialog(def virt.Definition) {
+	scope := a.newScope()
+
+	statusGroup := adw.NewPreferencesGroup()
+
+	statusRow := adw.NewActionRow()
+	statusRow.SetTitle(i18n.L("Looking for controllers"))
+	spinner := adw.NewSpinner()
+	statusRow.AddPrefix(&spinner.Widget)
+	statusGroup.Add(&statusRow.Widget)
+
+	group := adw.NewPreferencesGroup()
+	group.SetTitle(i18n.L("Controllers on This Host"))
+	group.SetDescription(i18n.L("The controller leaves this host while the machine runs."))
+	group.SetVisible(false)
+
+	var controllerRows []*adw.ActionRow
+
+	var dialog *adw.Dialog
+
+	var searchEntry *gtk.SearchEntry
+
+	var refresh *gtk.Button
+
+	var onSearch func(gtk.SearchEntry)
+	onSearch = func(gtk.SearchEntry) {
+		query := strings.ToLower(strings.TrimSpace(searchEntry.GetText()))
+		shown := 0
+
+		for _, row := range controllerRows {
+			match := query == "" ||
+				strings.Contains(strings.ToLower(row.GetTitle()), query) ||
+				strings.Contains(strings.ToLower(row.GetSubtitle()), query)
+			row.SetVisible(match)
+			if match {
+				shown++
+			}
+		}
+
+		if len(controllerRows) == 0 {
+			group.SetVisible(false)
+
+			return
+		}
+
+		if shown == 0 {
+			group.SetVisible(false)
+			statusRow.SetTitle(i18n.L("No controller matches"))
+			statusGroup.SetVisible(true)
+			return
+		}
+
+		group.SetVisible(true)
+		statusGroup.SetVisible(false)
+	}
+
+	var load func()
+	load = func() {
+		for _, row := range controllerRows {
+			group.Remove(&row.Widget)
+		}
+		controllerRows = nil
+
+		statusRow.SetTitle(i18n.L("Looking for controllers"))
+		statusRow.SetSubtitle("")
+		statusGroup.SetVisible(true)
+		spinner.SetVisible(true)
+		group.SetVisible(false)
+		refresh.SetSensitive(false)
+
+		taken := map[string]bool{}
+		if defs, err := virt.List(); err == nil {
+			for _, other := range defs {
+				for _, controller := range other.USBXHCIs {
+					taken[controller] = true
+				}
+			}
 		}
 
-		return i18n.L("The hub belongs to the machine now"), nil
-	})
+		go func() {
+			_, output, err := a.Service.ListXhci(a.Ctx, nil, struct{}{})
+
+			a.idle(func() {
+				spinner.SetVisible(false)
+				refresh.SetSensitive(true)
+
+				if err != nil {
+					statusRow.SetTitle(i18n.L("The controllers could not be listed"))
+					statusRow.SetSubtitle(err.Error())
+					return
+				}
+
+				controllers := []mcp.XhciController{}
+				if output != nil {
+					controllers = output.Controllers
+				}
+
+				statusGroup.SetVisible(false)
+
+				page := a.machinePages[def.Name]
+
+				for _, controller := range controllers {
+					controller := controller
+
+					if taken[controller.Address] {
+						continue
+					}
+
+					row := adw.NewActionRow()
+					if name := shortUSBName(controller.Name); name != "" {
+						row.SetTitle(name)
+					} else {
+						row.SetTitle(i18n.L("xHCI controller"))
+					}
+					row.SetSubtitle(controller.Address)
+					row.SetActivatable(true)
+
+					var cb func(adw.ActionRow)
+					cb = func(adw.ActionRow) {
+						if page != nil {
+							a.addHubController(page, controller.Address)
+						}
+						dialog.Close()
+					}
+					row.ConnectActivated(&cb)
+					scope.hold(&cb)
+
+					group.Add(&row.Widget)
+					controllerRows = append(controllerRows, row)
+				}
+
+				if len(controllerRows) == 0 {
+					statusRow.SetTitle(i18n.L("No second xHCI controller"))
+					statusRow.SetSubtitle(i18n.L("Whole-hub passthrough needs a second xHCI controller on this host."))
+					statusGroup.SetVisible(true)
+
+					return
+				}
+
+				onSearch(gtk.SearchEntry{})
+			})
+		}()
+	}
+
+	refresh = a.iconButton("view-refresh-symbolic", i18n.L("Refresh the Controller List"), func() { load() })
+
+	content := a.formPage(statusGroup, group)
+	dialog, searchEntry = a.dialogSearch(scope, "Add a USB Hub", def.Name, content, "Search controllers", &refresh.Widget)
+	searchEntry.ConnectSearchChanged(&onSearch)
+	scope.hold(&onSearch)
+
+	load()
+
+	a.present(dialog, scope)
 }
 
