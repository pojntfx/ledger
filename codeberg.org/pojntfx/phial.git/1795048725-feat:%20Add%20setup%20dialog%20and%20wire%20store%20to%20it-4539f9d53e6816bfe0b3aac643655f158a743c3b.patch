@@ -0,0 +1,242 @@
+using Gtk 4.0;
+using Adw 1;
+
+template $PhialSetupDialog: Adw.Dialog {
+  title: _("Set Up Phial");
+  can-close: false;
+  content-width: 600;
+  content-height: 480;
+
+  child: Adw.ToolbarView {
+    [top]
+    Adw.HeaderBar dialog_header_bar {
+      show-start-title-buttons: false;
+      show-end-title-buttons: false;
+
+      [start]
+      Button dialog_cancel_button {
+        visible: false;
+        label: _("_Cancel");
+        use-underline: true;
+      }
+
+      [start]
+      Button dialog_back_button {
+        label: _("_Back");
+        use-underline: true;
+      }
+
+      title-widget: Adw.WindowTitle dialog_title {};
+
+      [end]
+      Button dialog_next_button {
+        styles [
+          "suggested-action",
+        ]
+
+        Box {
+          spacing: 6;
+
+          Adw.Spinner verify_spinner {
+            visible: false;
+          }
+          Label {
+            label: _("_Continue");
+            use-underline: true;
+          }
+        }
+      }
+    }
+
+    content: Stack dialog_stack {
+      transition-type: slide_left_right;
+
+      StackPage {
+        name: "storage";
+        child: Adw.PreferencesPage {
+          Adw.PreferencesGroup {
+            description: _("Phial keeps its machines and their configurations in this folder");
+
+            Adw.ActionRow machines_folder_row {
+              title: _("Machines Folder");
+              subtitle: _("Not selected");
+
+              [prefix]
+              Image {
+                icon-name: "folder-symbolic";
+              }
+
+              [suffix]
+              Button machines_folder_button {
+                label: _("_Choose...");
+                use-underline: true;
+                valign: center;
+              }
+            }
+          }
+        };
+      }
+
+      StackPage {
+        name: "disclosure";
+        child: Adw.PreferencesPage {
+          Adw.PreferencesGroup {
+            description: _("The host service runs your machines on this computer, outside the application sandbox. It is the only part of Phial that touches the system.");
+
+            Adw.ActionRow {
+              title: _("Runs your machines <b>outside the application sandbox</b>");
+              use-markup: true;
+              activatable-widget: disclosure_sandbox_check;
+
+              [prefix]
+              CheckButton disclosure_sandbox_check {
+                valign: center;
+              }
+            }
+
+            Adw.ActionRow {
+              title: _("Reads and writes only the <b>machines folder</b>");
+              use-markup: true;
+              activatable-widget: disclosure_folders_check;
+
+              [prefix]
+              CheckButton disclosure_folders_check {
+                valign: center;
+              }
+            }
+
+            Adw.ActionRow {
+              title: _("Uses the <b>SSH and PGP agents</b> and the secret service of the host");
+              use-markup: true;
+              activatable-widget: disclosure_agents_check;
+
+              [prefix]
+              CheckButton disclosure_agents_check {
+                valign: center;
+              }
+            }
+
+            Adw.ActionRow {
+              title: _("Uses the <b>virtualisation tools</b> of the host");
+              use-markup: true;
+              activatable-widget: disclosure_tools_check;
+
+              [prefix]
+              CheckButton disclosure_tools_check {
+                valign: center;
+              }
+            }
+
+            Adw.ActionRow {
+              title: _("Runs fixed <b>administrator commands</b>, which you approve each time");
+              use-markup: true;
+              activatable-widget: disclosure_root_check;
+
+              [prefix]
+              CheckButton disclosure_root_check {
+                valign: center;
+              }
+            }
+          }
+        };
+      }
+
+      StackPage {
+        name: "host";
+        child: Adw.PreferencesPage {
+          Adw.PreferencesGroup {
+            description: _("Run this command in a terminal. It installs the host service and starts it.");
+
+            Gtk.ListBoxRow {
+              activatable: false;
+              selectable: false;
+
+              Box {
+                margin-top: 12;
+                margin-bottom: 12;
+                margin-start: 12;
+                margin-end: 12;
+
+                Label host_command_label {
+                  selectable: true;
+                  wrap: true;
+                  xalign: 0;
+                  styles [
+                    "monospace",
+                  ]
+                }
+              }
+            }
+
+            Adw.ButtonRow host_copy_row {
+              title: _("_Copy Command");
+              use-underline: true;
+              start-icon-name: "edit-copy-symbolic";
+            }
+
+            Adw.ButtonRow verify_connection_row {
+              title: _("_Verify Connection");
+              use-underline: true;
+              start-icon-name: "view-refresh-symbolic";
+            }
+          }
+        };
+      }
+
+      StackPage {
+        name: "system";
+        child: Adw.PreferencesPage {
+          Adw.PreferencesGroup {
+            description: _("Run this command in a terminal. It adds the rules for the USB devices and needs your password.");
+
+            Gtk.ListBoxRow {
+              activatable: false;
+              selectable: false;
+
+              Box {
+                margin-top: 12;
+                margin-bottom: 12;
+                margin-start: 12;
+                margin-end: 12;
+
+                Label system_command_label {
+                  selectable: true;
+                  wrap: true;
+                  xalign: 0;
+                  styles [
+                    "monospace",
+                  ]
+                }
+              }
+            }
+
+            Adw.ButtonRow system_copy_row {
+              title: _("_Copy Command");
+              use-underline: true;
+              start-icon-name: "edit-copy-symbolic";
+            }
+          }
+        };
+      }
+
+      StackPage {
+        name: "finish";
+        child: Adw.StatusPage {
+          icon-name: "object-select-symbolic";
+          title: _("You're Ready");
+          description: _("Now make a machine your own");
+
+          Button dialog_finish_button {
+            halign: center;
+            label: _("_Finish");
+            use-underline: true;
+            styles [
+              "suggested-action",
+              "pill",
+            ]
+          }
+        };
+      }
+    };
+  };
+}
