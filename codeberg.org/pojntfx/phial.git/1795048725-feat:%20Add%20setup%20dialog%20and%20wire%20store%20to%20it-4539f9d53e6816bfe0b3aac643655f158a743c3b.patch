diff --git a/internal/components/setup_dialog.go b/internal/components/setup_dialog.go
new file mode 100644
index 0000000000000000000000000000000000000000..ebd3251a4d201e3b54be63ceeed3be6a066fa15a
--- /dev/null
+++ b/internal/components/setup_dialog.go
@@ -0,0 +1,604 @@
+package components
+
+import (
+	"context"
+	"log/slog"
+	"os"
+	"path/filepath"
+	"runtime"
+	"time"
+	"unsafe"
+
+	"codeberg.org/pojntfx/phial/assets/resources"
+	"codeberg.org/pojntfx/phial/pkg/state"
+	"codeberg.org/puregotk/puregotk/v4/adw"
+	"codeberg.org/puregotk/puregotk/v4/gdk"
+	"codeberg.org/puregotk/puregotk/v4/gio"
+	"codeberg.org/puregotk/puregotk/v4/glib"
+	"codeberg.org/puregotk/puregotk/v4/gobject"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	. "github.com/pojntfx/go-gettext/pkg/i18n"
+)
+
+var (
+	gTypeSetupDialog gobject.Type
+)
+
+type SetupDialog struct {
+	adw.Dialog
+
+	ctx    context.Context
+	log    *slog.Logger
+	store  *state.Store
+	parent *gtk.Widget
+
+	dialogStack        gtk.Stack
+	dialogHeaderBar    *adw.HeaderBar
+	dialogTitle        *adw.WindowTitle
+	dialogCancelButton *gtk.Button
+	dialogBackButton   *gtk.Button
+	dialogNextButton   *gtk.Button
+	dialogFinishButton *gtk.Button
+
+	verifySpinner *adw.Spinner
+
+	machinesFolderRow    *adw.ActionRow
+	machinesFolderButton *gtk.Button
+
+	hostCommandLabel   *gtk.Label
+	systemCommandLabel *gtk.Label
+
+	disclosureSandboxCheck *gtk.CheckButton
+	disclosureFoldersCheck *gtk.CheckButton
+	disclosureAgentsCheck  *gtk.CheckButton
+	disclosureToolsCheck   *gtk.CheckButton
+	disclosureRootCheck    *gtk.CheckButton
+
+	hostCopyRow         *adw.ButtonRow
+	systemCopyRow       *adw.ButtonRow
+	verifyConnectionRow *adw.ButtonRow
+
+	verifying bool
+
+	callbacks []interface{}
+}
+
+func NewSetupDialog(ctx context.Context, store *state.Store, log *slog.Logger, parent *gtk.Widget) SetupDialog {
+	obj := gobject.NewObject(gTypeSetupDialog, "css-name")
+	gobject.IncreaseRef(obj.GoPointer())
+
+	var v SetupDialog
+	obj.Cast(&v)
+
+	dialog := (*SetupDialog)(unsafe.Pointer(obj.GetData(dataKeyGoInstance)))
+	dialog.ctx = ctx
+	dialog.log = log
+	dialog.store = store
+	dialog.parent = parent
+
+	closeDialog := func() {
+		if dialog.store.Page() == state.SetupPageFinish {
+			canSetupFinish, err := dialog.store.CanSetupFinish(dialog.ctx)
+			if err != nil {
+				dialog.log.Error("Could not determine whether setup can finish", "err", err)
+			} else if canSetupFinish {
+				if err := dialog.store.SetupFinish(dialog.ctx); err != nil {
+					dialog.log.Error("Could not finish setup", "err", err)
+				}
+			}
+		}
+
+		dialog.ForceClose()
+	}
+
+	onBack := func(gtk.Button) {
+		if err := dialog.store.SetupBack(dialog.ctx); err != nil {
+			dialog.log.Error("Could not go back in setup", "err", err)
+
+			return
+		}
+
+		dialog.Refresh()
+	}
+	dialog.callbacks = append(dialog.callbacks, &onBack)
+	dialog.dialogBackButton.ConnectClicked(&onBack)
+
+	onNext := func(gtk.Button) {
+		if err := dialog.store.SetupNext(dialog.ctx); err != nil {
+			dialog.log.Error("Could not continue setup", "err", err)
+
+			return
+		}
+
+		dialog.Refresh()
+	}
+	dialog.callbacks = append(dialog.callbacks, &onNext)
+	dialog.dialogNextButton.ConnectClicked(&onNext)
+
+	onCancel := func(gtk.Button) {
+		closeDialog()
+	}
+	dialog.callbacks = append(dialog.callbacks, &onCancel)
+	dialog.dialogCancelButton.ConnectClicked(&onCancel)
+
+	onCloseAttempt := func(adw.Dialog) {
+		closeDialog()
+	}
+	dialog.callbacks = append(dialog.callbacks, &onCloseAttempt)
+	dialog.ConnectCloseAttempt(&onCloseAttempt)
+
+	onCopy := func(adw.ButtonRow) {
+		var command string
+		switch dialog.store.Page() {
+		case state.SetupPageHost:
+			command = dialog.store.HostCommand()
+		case state.SetupPageSystem:
+			command = dialog.store.SystemCommand()
+		default:
+			return
+		}
+
+		dialog.parent.GetClipboard().SetText(command)
+
+		if err := dialog.store.SetupCopy(dialog.ctx); err != nil {
+			dialog.log.Error("Could not copy setup command", "err", err)
+
+			return
+		}
+
+		dialog.Refresh()
+	}
+	dialog.callbacks = append(dialog.callbacks, &onCopy)
+	dialog.hostCopyRow.ConnectActivated(&onCopy)
+	dialog.systemCopyRow.ConnectActivated(&onCopy)
+
+	onVerifyConnection := func(adw.ButtonRow) {
+		dialog.setVerifying(true)
+
+		go func() {
+			if err := dialog.store.RetryHost(dialog.ctx); err != nil {
+				dialog.log.Error("Could not verify host connection", "err", err)
+			}
+
+			time.Sleep(time.Millisecond * 750)
+
+			var fn glib.SourceFunc
+			fn = glib.SourceFunc(func(uintptr) bool {
+				defer glib.UnrefCallback(&fn)
+
+				dialog.setVerifying(false)
+
+				return false
+			})
+			glib.IdleAdd(&fn, 0)
+		}()
+	}
+	dialog.callbacks = append(dialog.callbacks, &onVerifyConnection)
+	dialog.verifyConnectionRow.ConnectActivated(&onVerifyConnection)
+
+	onFinish := func(gtk.Button) {
+		canSetupFinish, err := dialog.store.CanSetupFinish(dialog.ctx)
+		if err != nil {
+			dialog.log.Error("Could not determine whether setup can finish", "err", err)
+
+			return
+		}
+
+		if !canSetupFinish {
+			return
+		}
+
+		if err := dialog.store.SetupFinish(dialog.ctx); err != nil {
+			dialog.log.Error("Could not finish setup", "err", err)
+
+			return
+		}
+
+		dialog.ForceClose()
+	}
+	dialog.callbacks = append(dialog.callbacks, &onFinish)
+	dialog.dialogFinishButton.ConnectClicked(&onFinish)
+
+	connectDisclosureCheck := func(item state.DisclosureItem, check *gtk.CheckButton) {
+		onToggled := func(gtk.CheckButton) {
+			if err := dialog.store.SetDisclosureAcknowledged(dialog.ctx, item, check.GetActive()); err != nil {
+				dialog.log.Error("Could not acknowledge the host service disclosure", "err", err)
+
+				return
+			}
+
+			dialog.Refresh()
+		}
+
+		dialog.callbacks = append(dialog.callbacks, &onToggled)
+		check.ConnectToggled(&onToggled)
+	}
+	connectDisclosureCheck(state.DisclosureSandbox, dialog.disclosureSandboxCheck)
+	connectDisclosureCheck(state.DisclosureFolders, dialog.disclosureFoldersCheck)
+	connectDisclosureCheck(state.DisclosureAgents, dialog.disclosureAgentsCheck)
+	connectDisclosureCheck(state.DisclosureTools, dialog.disclosureToolsCheck)
+	connectDisclosureCheck(state.DisclosureRoot, dialog.disclosureRootCheck)
+
+	chooseMachinesFolder := func(title string, initial string) {
+		fileDialog := gtk.NewFileDialog()
+		fileDialog.SetTitle(title)
+
+		if initial == "" {
+			initial = dialog.store.SuggestedMachinesFolder()
+		}
+
+		if _, err := os.Stat(initial); err != nil {
+			initial = filepath.Dir(initial)
+		}
+
+		if _, err := os.Stat(initial); err == nil {
+			fileDialog.SetInitialFolder(gio.FileNewForPath(initial))
+		}
+
+		var onFolderChosen gio.AsyncReadyCallback
+		onFolderChosen = gio.AsyncReadyCallback(func(_ uintptr, resultPtr uintptr, _ uintptr) {
+			result := gio.AsyncResultBase{Ptr: resultPtr}
+
+			file, err := fileDialog.SelectFolderFinish(&result)
+			if err != nil {
+				dialog.log.Error("Could not choose folder", "err", err)
+
+				return
+			}
+
+			if err := dialog.store.SetMachinesFolder(dialog.ctx, file.GetPath()); err != nil {
+				dialog.log.Error("Could not set machines folder", "err", err)
+
+				return
+			}
+
+			dialog.Refresh()
+		})
+		dialog.callbacks = append(dialog.callbacks, &onFolderChosen)
+
+		var parentWindow gtk.Window
+		dialog.parent.Cast(&parentWindow)
+
+		fileDialog.SelectFolder(&parentWindow, nil, &onFolderChosen, 0)
+	}
+
+	onMachinesFolderClicked := func(gtk.Button) {
+		chooseMachinesFolder(
+			L("Choose the Machines Folder"),
+			dialog.store.MachinesFolder(),
+		)
+	}
+	dialog.callbacks = append(dialog.callbacks, &onMachinesFolderClicked)
+	dialog.machinesFolderButton.ConnectClicked(&onMachinesFolderClicked)
+
+	onKeyPressed := func(_ gtk.EventControllerKey, keyval uint32, _ uint32, _ gdk.ModifierType) bool {
+		if int32(keyval) == gdk.KEY_Escape {
+			closeDialog()
+
+			return true
+		}
+
+		return false
+	}
+	dialog.callbacks = append(dialog.callbacks, &onKeyPressed)
+
+	keyController := gtk.NewEventControllerKey()
+	keyController.SetPropagationPhase(gtk.PhaseCaptureValue)
+	keyController.ConnectKeyPressed(&onKeyPressed)
+	dialog.Widget.AddController(&keyController.EventController)
+
+	onClosed := func(adw.Dialog) {
+		dialog.verifying = false
+		dialog.verifySpinner.SetVisible(false)
+	}
+	dialog.callbacks = append(dialog.callbacks, &onClosed)
+	dialog.ConnectClosed(&onClosed)
+
+	dialog.Refresh()
+
+	return v
+}
+
+func (w *SetupDialog) Refresh() {
+	if w.store == nil {
+		return
+	}
+
+	page := w.store.Page()
+
+	if page == "" || page == state.SetupPageWelcome || w.store.Ready() {
+		return
+	}
+
+	w.dialogStack.SetVisibleChildName(string(page))
+
+	w.dialogTitle.SetTitle(setupPageTitle(page))
+
+	w.dialogCancelButton.SetVisible(page == state.SetupPageStorage)
+	w.dialogBackButton.SetVisible(page != state.SetupPageStorage && page != state.SetupPageFinish)
+	w.dialogNextButton.SetVisible(page != state.SetupPageFinish)
+
+	w.dialogHeaderBar.SetShowEndTitleButtons(page == state.SetupPageFinish)
+
+	w.hostCommandLabel.SetText(w.store.HostCommand())
+	w.systemCommandLabel.SetText(w.store.SystemCommand())
+
+	setFolderRowSubtitle(w.machinesFolderRow, w.store.MachinesFolder())
+
+	setCheckButtonActive := func(check *gtk.CheckButton, active bool) {
+		if check.GetActive() != active {
+			check.SetActive(active)
+		}
+	}
+	setCheckButtonActive(w.disclosureSandboxCheck, w.store.DisclosureAcknowledged(state.DisclosureSandbox))
+	setCheckButtonActive(w.disclosureFoldersCheck, w.store.DisclosureAcknowledged(state.DisclosureFolders))
+	setCheckButtonActive(w.disclosureAgentsCheck, w.store.DisclosureAcknowledged(state.DisclosureAgents))
+	setCheckButtonActive(w.disclosureToolsCheck, w.store.DisclosureAcknowledged(state.DisclosureTools))
+	setCheckButtonActive(w.disclosureRootCheck, w.store.DisclosureAcknowledged(state.DisclosureRoot))
+
+	w.verifyConnectionRow.SetSensitive(w.store.HostCommandCopied() && !w.verifying)
+
+	canSetupNext, err := w.store.CanSetupNext(w.ctx)
+	if err != nil {
+		w.log.Error("Could not determine whether setup can continue", "err", err)
+
+		return
+	}
+	w.dialogNextButton.SetSensitive(canSetupNext && !w.verifying)
+
+	canSetupBack, err := w.store.CanSetupBack(w.ctx)
+	if err != nil {
+		w.log.Error("Could not determine whether setup can go back", "err", err)
+
+		return
+	}
+	w.dialogBackButton.SetSensitive(canSetupBack)
+
+	canSetupFinish, err := w.store.CanSetupFinish(w.ctx)
+	if err != nil {
+		w.log.Error("Could not determine whether setup can finish", "err", err)
+
+		return
+	}
+	w.dialogFinishButton.SetSensitive(canSetupFinish)
+}
+
+func (w *SetupDialog) setVerifying(verifying bool) {
+	w.verifying = verifying
+	w.verifySpinner.SetVisible(verifying)
+
+	w.Refresh()
+}
+
+func setupPageTitle(page state.SetupPage) string {
+	switch page {
+	case state.SetupPageWelcome:
+		return L("Welcome")
+	case state.SetupPageStorage:
+		return L("Storage")
+	case state.SetupPageDisclosure:
+		return L("Host Access")
+	case state.SetupPageHost:
+		return L("Host Service")
+	case state.SetupPageSystem:
+		return L("System Setup")
+	case state.SetupPageFinish:
+		return L("Done")
+	}
+
+	return ""
+}
+
+func setFolderRowSubtitle(row *adw.ActionRow, path string) {
+	if path == "" {
+		row.SetSubtitle(L("Not selected"))
+
+		return
+	}
+
+	row.SetSubtitle(path)
+}
