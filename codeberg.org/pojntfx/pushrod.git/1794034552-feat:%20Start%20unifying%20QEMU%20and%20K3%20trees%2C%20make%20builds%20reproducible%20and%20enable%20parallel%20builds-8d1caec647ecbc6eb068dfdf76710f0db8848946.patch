+#!/usr/bin/env python3
+from contextlib import contextmanager
+import functools
+import hashlib
+import http.server
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import threading
+import time
+import urllib.request
+
+from verify_boot import Console
+
+
+class InterruptingHandler(http.server.SimpleHTTPRequestHandler):
+    def do_GET(self):
+        if self.path.startswith("/rva23_2_") and self.path.endswith(".usr.erofs.xz"):
+            data = (Path(self.directory) / self.path.lstrip("/")).read_bytes()
+            self.send_response(200)
+            self.send_header("Content-Length", str(len(data)))
+            self.end_headers()
+            self.wfile.write(data[: len(data) // 2])
+            self.wfile.flush()
+            self.close_connection = True
+            return
+        super().do_GET()
+
+    def log_message(self, format, *args):
+        pass
+
+
+@contextmanager
+def registry_server(path, interrupt=False):
+    handler = InterruptingHandler if interrupt else http.server.SimpleHTTPRequestHandler
+    server = http.server.ThreadingHTTPServer(("::1", 8000), functools.partial(handler, directory=str(path)))
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    try:
+        deadline = time.monotonic() + 15
+        while True:
+            try:
+                urllib.request.urlopen("http://[::1]:8000/SHA256SUMS", timeout=1).close()
+                break
+            except Exception:
+                if not thread.is_alive() or time.monotonic() > deadline:
+                    raise
+                time.sleep(0.1)
+        yield
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join(timeout=10)
+
+
+def clone(source, destination):
+    if destination.exists():
+        shutil.rmtree(destination)
+    shutil.copytree(source, destination)
+
+
+def make_offline_image(output, offline):
+    for component, directory in (("os", "sysupdate.d"), ("extensions", "sysupdate.extensions.d"), ("bootloader", "sysupdate.bootloader.d")):
+        for source in (output / "target/usr/lib" / directory).glob("*.transfer"):
+            text = source.read_text()
+            text = text.replace("Type=url-file", "Type=regular-file")
+            text = text.replace("Path=http://[::1]:8000/", "Path=/")
+            text = text.replace("[Source]\n", "[Source]\nPathRelativeTo=explicit\n")
+            destination = offline / "definitions" / component / source.name
+            destination.parent.mkdir(parents=True, exist_ok=True)
+            destination.write_text(text)
+    image = output / "offline-registry.img"
+    payload = sum(path.stat().st_size for path in offline.rglob("*") if path.is_file())
+    size = max(512 * 1024 * 1024, ((payload + 128 * 1024 * 1024 - 1) // (64 * 1024 * 1024)) * (64 * 1024 * 1024))
+    subprocess.run(["truncate", "-s", str(size), image], check=True)
+    subprocess.run(["mkfs.ext2", "-F", "-d", offline, image], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    return image
+
+
+def update_failure(console, component=None):
+    option = f" --component={component}" if component else ""
+    console.command(f"if /usr/lib/systemd/systemd-sysupdate{option} update; then false; else true; fi", 300)
+    console.command("test ! -e /boot/EFI/Linux/rva23_2+3-0.efi")
+    console.command("if lsblk -ln -o PARTLABEL | grep -q rva23_2_verity; then false; else true; fi")
+
+
+def main():
+    output = Path(sys.argv[1]).resolve()
+    key_dir = Path(sys.argv[2]).resolve()
+    registry = output / "registry"
+    registry_v2 = output / "registry-v2"
+    clone(registry, registry_v2)
+    bad = output / "registry-bad"
+    clone(registry_v2, bad)
+    with (bad / "SHA256SUMS.gpg").open("ab") as stream:
+        stream.write(b"bad")
+    interrupted = output / "registry-interrupted"
+    clone(registry_v2, interrupted)
+    offline = output / "offline-registry"
+    clone(registry_v2, offline)
+    subprocess.run(["gpg", "--batch", "--homedir", key_dir / "gnupg", "--verify", offline / "SHA256SUMS.gpg", offline / "SHA256SUMS"], check=True)
+    subprocess.run(["sha256sum", "-c", "SHA256SUMS"], cwd=offline, check=True, stdout=subprocess.DEVNULL)
+    os.environ["RVA23_UPDATE_IMAGE"] = str(make_offline_image(output, offline))
+    console = Console(output, "update.log")
+    try:
+        console.expect(b"rva23 login:", 1800)
