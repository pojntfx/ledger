-	case "SHA256":
-		return 0x000b, nil
-	case "SHA384":
-		return 0x000c, nil
-	case "SHA512":
-		return 0x000d, nil
-	default:
-		return 0, fmt.Errorf("unsupported hash algorithm %q", value)
-	}
-}
