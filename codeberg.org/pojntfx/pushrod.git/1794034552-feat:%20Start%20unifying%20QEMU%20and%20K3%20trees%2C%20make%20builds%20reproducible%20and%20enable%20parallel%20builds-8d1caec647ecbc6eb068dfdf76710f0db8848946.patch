+++ b/buildroot/scripts/share-target-package.py
@@ -0,0 +1,27 @@
+#!/usr/bin/env python3
+from pathlib import Path
+import sys
+
+
+def main():
+    source_output = Path(sys.argv[1]).resolve()
+    destination_output = Path(sys.argv[2]).resolve()
+    prefixes = sys.argv[3:] or ["llvm"]
+    source_build = source_output / "build"
+    destination_build = destination_output / "build"
+    destination_build.mkdir(parents=True, exist_ok=True)
+    for prefix in prefixes:
+        for source in sorted(source_build.glob(f"{prefix}-*")):
+            if not source.is_dir():
+                continue
+            destination = destination_build / source.name
+            if destination.exists() or destination.is_symlink():
+                continue
+            destination.symlink_to(source, target_is_directory=True)
+            for stamp in (".stamp_target_installed", ".stamp_host_installed"):
+                (destination / stamp).unlink(missing_ok=True)
+            print(f"linked {source} -> {destination}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/buildroot/scripts/verify-k3.py b/buildroot/scripts/verify-k3.py
new file mode 100644
index 0000000000000000000000000000000000000000..b6a63357edcccaeb579d76c8011ab634a8b8e1ac
--- /dev/null
+++ b/buildroot/scripts/verify-k3.py
@@ -0,0 +1,313 @@
+#!/usr/bin/env python3
+import base64
+import filecmp
+import functools
+import hashlib
+import http.server
+import json
+import os
+from pathlib import Path
+import secrets
+import shutil
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+
+
+class K3:
+    def __init__(self, output):
+        self.output = output
+        self.host = os.environ.get("K3_SSH", "")
+        if self.host and not self.host.startswith("root@"):
+            self.host = f"root@{self.host}"
+        self.key = Path(os.environ.get("K3_SSH_KEY", output / "build/k3-keys/root_ed25519"))
+
+    def command(self, command, timeout=120):
+        if not self.host:
+            raise ValueError("Set K3_SSH to the board IPv6 address")
+        result = subprocess.run(
+            ["ssh", "-6", "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=10", "-i", str(self.key), self.host, command],
+            check=True,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+        return result.stdout
+
+    def copy_file(self, source, destination):
+        encoded = self.command(f"base64 {source}")
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        destination.write_bytes(base64.b64decode("".join(encoded.split())))
+
+
+def host_tool(k3, name):
+    tool = shutil.which(name)
+    if tool:
+        return tool
+    for directory in (k3.output / "host/bin", k3.output / "host/sbin"):
+        candidate = directory / name
+        if candidate.is_file():
+            return str(candidate)
+    raise RuntimeError(f"missing host tool: {name}")
+
+
+def partition_size(value):
+    units = {"K": 1024, "M": 1024 ** 2, "G": 1024 ** 3}
+    return int(value[:-1]) * units[value[-1]]
+
+
+def check_partition_table(images):
+    table = json.loads((images / "partition_universal.json").read_text())
+    previous_end = 0
+    partitions = sorted(table["partitions"], key=lambda item: partition_size(item["offset"]))
+    for partition in partitions:
+        offset = partition_size(partition["offset"])
+        image = images / partition["image"]
+        if not image.is_file() or image.stat().st_size == 0:
+            raise AssertionError(f"missing partition image: {image}")
+        if partition["size"] == "-":
+            if partition is not partitions[-1] or offset < previous_end:
+                raise AssertionError(f"invalid remaining-space partition: {partition['name']}")
+            previous_end = offset
+            continue
+        size = partition_size(partition["size"])
+        if offset < previous_end or size == 0:
+            raise AssertionError(f"invalid partition layout: {partition['name']}")
+        if image.stat().st_size > size:
+            raise AssertionError(f"partition image is too large: {image}")
+        previous_end = offset + size
+
+
+def check_architecture(k3, images):
+    readelf = host_tool(k3, "riscv64-buildroot-linux-gnu-readelf")
+    for name in ("bin/busybox", "lib/libsystemd.so.0", "lib/libdrm.so.2", "bin/weston"):
+        binary = images / "image-staging/usr" / name
+        result = subprocess.run([readelf, "-A", binary], check=True, capture_output=True, text=True).stdout
+        architecture = next(line for line in result.splitlines() if "Tag_RISCV_arch" in line)
+        if "_x" in architecture:
+            raise AssertionError(f"board-specific userspace architecture in {binary}: {architecture}")
+
+
+def check_verity(k3, images):
+    veritysetup = host_tool(k3, "veritysetup")
+    certificate = k3.output / "build/k3-keys/verity.crt"
+    der = subprocess.run(["openssl", "x509", "-in", certificate, "-outform", "DER"], check=True, capture_output=True).stdout
+    fingerprint = hashlib.sha256(der).hexdigest()
+    with tempfile.TemporaryDirectory() as temporary:
+        temporary = Path(temporary)
+        for slot in ("a", "b"):
+            root_hash_file = images / f"usr-{slot}.roothash"
+            if slot == "b":
+                root_hash_file = images / "usr-a.roothash"
+            root_hash = root_hash_file.read_text().strip()
+            subprocess.run([veritysetup, "verify", images / f"usr-{slot}.erofs", images / f"usr-{slot}.verity", root_hash], check=True, capture_output=True)
+            signature_file = images / f"usr-{slot}.verity-sig"
+            document = json.loads(signature_file.read_bytes().rstrip(b"\0"))
+            if document["rootHash"] != root_hash or document["certificateFingerprint"] != fingerprint:
+                raise AssertionError(f"invalid verity signature metadata: {signature_file}")
+            cms = temporary / f"usr-{slot}.cms"
+            verified = temporary / f"usr-{slot}.roothash"
+            cms.write_bytes(base64.b64decode(document["signature"]))
+            subprocess.run(["openssl", "cms", "-verify", "-inform", "DER", "-noverify", "-in", cms, "-content", root_hash_file, "-out", verified], check=True, capture_output=True)
+            if verified.read_text().strip() != root_hash:
+                raise AssertionError(f"invalid verity root hash signature: {signature_file}")
+
+
+def image(k3):
+    images = k3.output / "images"
+    required = (
+        "bootfs.img", "rootfs.ext4", "usr-a.erofs", "usr-b.erofs",
+        "usr-a.verity", "usr-b.verity", "usr-a.verity-sig", "usr-b.verity-sig",
+        "usr-a.roothash", "partition_universal.json", "k3-uefi-pushrod.zip",
+        "edk2.itb", "fw_dynamic.itb", "podman_1.raw", "k3s_1.raw",
+        "graphics_1.raw", "debug_1.raw",
+    )
+    for name in required:
+        path = images / name
+        if not path.is_file() or path.stat().st_size == 0:
+            raise AssertionError(f"missing or empty image artifact: {path}")
+    config = (k3.output / ".config").read_text()
+    for setting in ('BR2_REPRODUCIBLE=y', 'BR2_PER_PACKAGE_DIRECTORIES=y', 'BR2_TARGET_OPTIMIZATION="-march=rva23u64"'):
+        if setting not in config:
+            raise AssertionError(f"missing build configuration: {setting}")
+    check_partition_table(images)
+    check_architecture(k3, images)
+    if not filecmp.cmp(images / "usr-a.erofs", images / "usr-b.erofs", shallow=False):
+        raise AssertionError("initial A/B EROFS images differ")
+    subprocess.run([host_tool(k3, "fsck.erofs"), images / "usr-a.erofs"], check=True, capture_output=True)
+    subprocess.run([host_tool(k3, "e2fsck"), "-fn", images / "rootfs.ext4"], check=True, capture_output=True)
+    check_verity(k3, images)
+    print("PASS: K3 images have generic userspace, valid filesystems, matching A/B slots, and verified verity signatures")
+
+
+def firmware(k3):
+    images = k3.output / "images"
+    opensbi = subprocess.run(["strings", str(images / "fw_dynamic.itb")], check=True, capture_output=True, text=True).stdout
+    if "OpenSBI" not in opensbi:
+        raise AssertionError("source-built OpenSBI is missing from fw_dynamic.itb")
+    edk2 = subprocess.run(["strings", str(images / "edk2.itb")], check=True, capture_output=True, text=True).stdout
+    if "MUSE-Pico" not in edk2:
+        raise AssertionError("MUSE-Pico firmware is missing from edk2.itb")
+    mtype = shutil.which("mtype") or str(k3.output / "host/bin/mtype")
+    entry = subprocess.run([mtype, "-i", str(images / "bootfs.img"), "::/loader/entries/k3.conf"], check=True, capture_output=True, text=True).stdout
+    if "rva23_1+3-0.efi" not in entry or "devicetree /k3-pico-itx.dtb" not in entry:
+        raise AssertionError(entry)
+    print("PASS: source OpenSBI, MUSE-Pico EDK2, and the K3 ESP entry are present")
+
+
+def base(k3):
+    k3.command("systemctl is-active --quiet --wait graphical.target weston.service")
+    k3.command("systemctl is-inactive --quiet swtpm.service")
+    k3.command("test ! -e /dev/tpm0")
+    result = k3.command("PVR_I_WANT_A_BROKEN_VULKAN_DRIVER=1 vulkaninfo --summary")
+    if "Imagination open-source Mesa driver" not in result:
+        raise AssertionError(result)
+    print("PASS: the base K3 image reaches Weston without swtpm or attestation")
+
+
+def attestation(k3):
+    k3.command("systemctl enable --now swtpm.service")
+    k3.command("for i in $(seq 1 30); do test -e /dev/tpm0 && break; sleep 1; done; test -e /dev/tpm0")
+    guest = "/var/lib/rva23-attestation"
+    k3.command(f"mkdir -p {guest}")
+    nonce = secrets.token_hex(32)
+    k3.command(f"tpm2_createek -c {guest}/ek.ctx -G rsa -u {guest}/ek.pub", 180)
+    k3.command(f"tpm2_createak -C {guest}/ek.ctx -c {guest}/ak.ctx -G rsa -g sha256 -s rsassa -u {guest}/ak.pub -f pem -n {guest}/ak.name", 180)
+    k3.command(f"tpm2_quote -c {guest}/ak.ctx -l sha256:11 -q {nonce} -m {guest}/quote.msg -s {guest}/quote.sig -o {guest}/quote.pcrs -g sha256", 180)
+    destination = k3.output / "attestation"
+    for name in ("ak.pub", "quote.msg", "quote.sig", "quote.pcrs"):
+        k3.copy_file(f"{guest}/{name}", destination / name)
+    verifier = shutil.which("tpm2_checkquote")
+    if not verifier:
+        raise RuntimeError("tpm2_checkquote is required on the host")
+    subprocess.run([verifier, "-u", str(destination / "ak.pub"), "-m", str(destination / "quote.msg"), "-s", str(destination / "quote.sig"), "-f", str(destination / "quote.pcrs"), "-g", "sha256", "-q", nonce], check=True)
+    (destination / "reference.json").write_text(f'{{"nonce":"{nonce}"}}\n')
+    print("PASS: a software TPM AK signs a quote with a fresh nonce")
+
+
+def report(k3):
+    url = os.environ.get("K3_REPORT_URL", "http://[::1]:8080/reports")
+    k3.command(f"/usr/lib/systemd/systemd-report upload --url={url} --sign=require-one", 300)
+    print("PASS: systemd-report uploads a signed report")
+
+
+def update(k3):
+    registry = k3.output / "registry"
+    handler = functools.partial(http.server.SimpleHTTPRequestHandler, directory=str(registry))
+    server = http.server.ThreadingHTTPServer(("::", 8000), handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    try:
+        url = os.environ.get("K3_UPDATE_URL", "http://[::1]:8000/")
+        k3.command(f"mkdir -p /etc/sysupdate.d; printf '[Source]\\nPath={url}\\n' > /etc/sysupdate.d/99-native.conf")
+        k3.command("/usr/lib/systemd/systemd-sysupdate update", 300)
+        k3.command("/usr/lib/systemd/systemd-sysupdate --component=extensions update", 300)
+    finally:
