+    k3.command("podman info --format '{{.Host.OCIRuntime.Name}}' | grep crun >/dev/null")
+    print("PASS: Podman runs the offline RISC-V OCI image with crun")
+
+
+def k3s(k3):
+    k3.command("systemd-sysext status | grep k3s_ >/dev/null")
+    k3.command("systemd-sysext unmerge")
+    k3.command("image=$(find /var/lib/extensions -maxdepth 1 -name 'k3s_*.raw' -not -name '*.backup' -print -quit); cp \"$image\" \"$image.backup\"; printf X | dd of=\"$image\" bs=1 seek=1048576 conv=notrunc 2>/dev/null")
+    k3.command("if systemd-sysext --image-policy=root=signed+absent:usr=signed+absent refresh; then false; else true; fi", 120)
