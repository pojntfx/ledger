+    k3.command("image=$(ls -1 /var/lib/extensions/podman_*.raw | sort -V | tail -n1); cp \"$image\" \"$image.backup\"; printf X | dd of=\"$image\" bs=1 seek=1048576 conv=notrunc 2>/dev/null")
+    k3.command("if systemd-sysext --image-policy=root=signed+absent:usr=signed+absent refresh; then false; else true; fi", 120)
+    k3.command("image=$(ls -1 /var/lib/extensions/podman_*.raw | sort -V | tail -n1); mv \"$image.backup\" \"$image\"; systemd-sysext --image-policy=root=signed+absent:usr=signed+absent refresh", 120)
+    k3.command("podman image rm -f localhost/rva23-podman-test:latest || true")
+    k3.command("podman load -i /usr/share/rva23/podman-test-image.tar", 300)
+    result = k3.command("podman run --rm --network=none localhost/rva23-podman-test:latest", 300)
+    if "podman-works" not in result:
