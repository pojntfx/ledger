diff --git a/buildroot/Makefile b/buildroot/Makefile
new file mode 100644
index 0000000000000000000000000000000000000000..52ac1dc5b728e80507a3bbc3dc63b1a938bb1eaf
--- /dev/null
+++ b/buildroot/Makefile
@@ -0,0 +1,148 @@
+.SUFFIXES:
+
+THIS_EXTERNAL_PATH := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
+-include $(THIS_EXTERNAL_PATH)/local.mk
+BUILDROOT_DIR ?= $(THIS_EXTERNAL_PATH)/buildroot
+OUTPUT_DIR ?= $(THIS_EXTERNAL_PATH)/output/rva23
+K3_OUTPUT_DIR ?= $(THIS_EXTERNAL_PATH)/output/k3-uefi
+BR2_DL_DIR ?= $(THIS_EXTERNAL_PATH)/dl
+BR2_CCACHE_DIR ?= $(THIS_EXTERNAL_PATH)/ccache
+K3_SOURCE_DIR ?= $(THIS_EXTERNAL_PATH)/src
+K3_LINUX_FIRMWARE_DIR ?= $(K3_SOURCE_DIR)/linux-firmware/powervr
+RVA23_KEY_DIR ?= $(THIS_EXTERNAL_PATH)/qemu-keys
+HOST_DIR ?= $(THIS_EXTERNAL_PATH)/output/host
+export RVA23_TPM_STATE := $(OUTPUT_DIR)/swtpm
+
+COMMON_TOOLCHAIN_OVERRIDES = BINUTILS_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/binutils HOST_BINUTILS_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/binutils HOST_GCC_INITIAL_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/gcc HOST_GCC_FINAL_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/gcc GCC_FINAL_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/gcc
+MAKE_BUILDROOT = $(MAKE) -C $(BUILDROOT_DIR) O=$(OUTPUT_DIR) BR2_HOST_DIR=$(HOST_DIR) BR2_EXTERNAL=$(THIS_EXTERNAL_PATH) BR2_DL_DIR=$(BR2_DL_DIR) BR2_CCACHE_DIR=$(BR2_CCACHE_DIR) $(COMMON_TOOLCHAIN_OVERRIDES) UBOOT_OVERRIDE_SRCDIR=$(UBOOT_OVERRIDE_SRCDIR) RVA23_KEY_DIR=$(RVA23_KEY_DIR)
+MAKE_BUILDROOT_K3 = $(MAKE) -C $(BUILDROOT_DIR) O=$(K3_OUTPUT_DIR) BR2_HOST_DIR=$(HOST_DIR) BR2_EXTERNAL=$(THIS_EXTERNAL_PATH) BR2_DL_DIR=$(BR2_DL_DIR) BR2_CCACHE_DIR=$(BR2_CCACHE_DIR) $(COMMON_TOOLCHAIN_OVERRIDES) LINUX_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/linux OPENSBI_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/opensbi-vendor EDK2_SPACEMIT_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/edk2-spacemit K3_LINUX_FIRMWARE_DIR=$(K3_LINUX_FIRMWARE_DIR)
+BUILDROOT_PATCHES = $(sort $(wildcard $(THIS_EXTERNAL_PATH)/patches/buildroot/*.patch))
+
+.PHONY: all configure build clean k3-configure k3-build k3-clean k3-registry share-k3-to-qemu k3-verify-image k3-verify-firmware k3-verify-base k3-verify-attestation k3-verify-report k3-verify-update k3-verify-hardening k3-verify-podman k3-verify-k3s k3-verify-wallet k3-verify-migration k3-verify-mutual-migration k3-verify registry verify verify-image verify-boot verify-firmware verify-attestation verify-report verify-update verify-security verify-hardening verify-podman verify-k3s verify-attested-app verify-wallet verify-migration verify-mutual-migration demo-servers boot boot-display boot-firmware
+
+all: build k3-build
+
+configure:
+	for patch in $(BUILDROOT_PATCHES); do git -C $(BUILDROOT_DIR) apply --reverse --check "$$patch" || exit 1; done
+	$(MAKE_BUILDROOT) rva23_defconfig
+	$(MAKE_BUILDROOT) rva23-refresh-toolchain-wrapper
+
+build: configure share-k3-to-qemu
+	$(MAKE_BUILDROOT)
+
+k3-configure:
+	for patch in $(BUILDROOT_PATCHES); do git -C $(BUILDROOT_DIR) apply --reverse --check "$$patch" || exit 1; done
+	$(MAKE_BUILDROOT_K3) k3_uefi_defconfig
+	$(MAKE_BUILDROOT_K3) rva23-refresh-toolchain-wrapper
+
+k3-build: k3-configure
+	$(MAKE_BUILDROOT_K3) -j14
+
+clean:
+	$(MAKE_BUILDROOT) clean
+
+k3-clean:
+	$(MAKE_BUILDROOT_K3) clean
+
+k3-verify-image:
+	python3 scripts/verify-k3.py $(K3_OUTPUT_DIR) image
+
+k3-verify-firmware:
+	python3 scripts/verify-k3.py $(K3_OUTPUT_DIR) firmware
+
+k3-verify-base:
+	python3 scripts/verify-k3.py $(K3_OUTPUT_DIR) base
+
+k3-verify-attestation:
+	python3 scripts/verify-k3.py $(K3_OUTPUT_DIR) attestation
+
+k3-verify-report:
+	python3 scripts/verify-k3.py $(K3_OUTPUT_DIR) report
+
+k3-registry: k3-build
+	RVA23_BOARD=k3-uefi python3 scripts/build-registry.py $(K3_OUTPUT_DIR) $(K3_OUTPUT_DIR)/build/k3-keys 2
+
+k3-verify-update: k3-registry
+	python3 scripts/verify-k3.py $(K3_OUTPUT_DIR) update
+
+k3-verify-hardening:
+	python3 scripts/verify-k3.py $(K3_OUTPUT_DIR) hardening
+
+k3-verify-podman:
+	python3 scripts/verify-k3.py $(K3_OUTPUT_DIR) podman
+
+k3-verify-k3s:
+	python3 scripts/verify-k3.py $(K3_OUTPUT_DIR) k3s
+
+k3-verify-wallet:
+	python3 scripts/verify-k3.py $(K3_OUTPUT_DIR) wallet
+
+k3-verify-migration:
+	python3 scripts/verify-k3.py $(K3_OUTPUT_DIR) migration
+
+k3-verify-mutual-migration:
+	python3 scripts/verify-k3.py $(K3_OUTPUT_DIR) mutual
+
+k3-verify: k3-verify-image k3-verify-base k3-verify-attestation k3-verify-report k3-verify-update k3-verify-hardening k3-verify-podman k3-verify-k3s k3-verify-wallet k3-verify-migration k3-verify-mutual-migration
+
+share-k3-to-qemu: k3-build
+	python3 scripts/share-target-package.py $(K3_OUTPUT_DIR) $(OUTPUT_DIR) llvm mesa3d systemd libdrm wayland weston podman crun k3s rva23-criu tpm2-tss host-llvm host-binutils host-gcc-initial host-gcc-final
+
+verify-image: build
+	python3 scripts/verify-image.py $(OUTPUT_DIR) $(BR2_DL_DIR) $(BR2_CCACHE_DIR) $(RVA23_KEY_DIR)
+
+verify-boot: build
+	python3 scripts/verify-boot.py $(OUTPUT_DIR)
+
+verify-firmware: build
+	python3 scripts/verify-firmware.py $(OUTPUT_DIR)
+
+registry: build
+	python3 scripts/build-registry.py $(OUTPUT_DIR) $(RVA23_KEY_DIR) 2
+
+verify-attestation: build
+	python3 scripts/verify-attestation.py $(OUTPUT_DIR) $(RVA23_KEY_DIR)
+
+verify-update: registry
+	python3 scripts/verify-update.py $(OUTPUT_DIR) $(RVA23_KEY_DIR)
+
+verify-security: build
+	python3 scripts/verify-security.py $(OUTPUT_DIR) $(RVA23_KEY_DIR)
+
+verify-hardening: build
+	python3 scripts/verify-hardening.py $(OUTPUT_DIR)
+
+verify-podman: build
+	python3 scripts/verify-podman.py $(OUTPUT_DIR)
+
+verify-k3s: build
+	python3 scripts/verify-k3s.py $(OUTPUT_DIR)
+
+verify-report: verify-attestation
+	python3 scripts/verify-report.py $(OUTPUT_DIR)
+
+verify-attested-app: verify-report
+	python3 scripts/verify-attested-app.py $(OUTPUT_DIR)
+
+verify-wallet: verify-attested-app
+	python3 scripts/verify-wallet.py $(OUTPUT_DIR)
+
+verify-migration: verify-wallet
+	python3 scripts/verify-migration.py $(OUTPUT_DIR)
+
+verify-mutual-migration: verify-migration
+	python3 scripts/verify-mutual-migration.py $(OUTPUT_DIR)
+
+verify: verify-image verify-boot verify-firmware verify-security verify-attestation verify-update verify-hardening verify-podman verify-k3s verify-report verify-attested-app verify-wallet verify-migration verify-mutual-migration
+
+demo-servers:
+	python3 scripts/run-demo-servers.py
+
+boot: build
+	$(THIS_EXTERNAL_PATH)/board/rva23-qemu/run-qemu.sh $(OUTPUT_DIR)/images
+
+boot-display: build
+	QEMU_VNC=1 $(THIS_EXTERNAL_PATH)/board/rva23-qemu/run-qemu.sh $(OUTPUT_DIR)/images
+
+boot-firmware: build
+	$(THIS_EXTERNAL_PATH)/board/rva23-qemu/run-firmware.sh $(OUTPUT_DIR)/images
