diff --git a/buildroot/external.mk b/buildroot/external.mk
new file mode 100644
index 0000000000000000000000000000000000000000..b33ac4569d411373d669f72b7bcfb68ed87a911c
--- /dev/null
+++ b/buildroot/external.mk
@@ -0,0 +1,107 @@
+ifeq ($(BR2_PACKAGE_EDK2_SPACEMIT),y)
+LINUX_OVERRIDE_SRCDIR = $(abspath $(BR2_EXTERNAL_RVA23_PATH)/src/linux)
+OPENSBI_OVERRIDE_SRCDIR = $(abspath $(BR2_EXTERNAL_RVA23_PATH)/src/opensbi-vendor)
+SYSTEMD_CONF_OPTS += -Dc_args=-isystem../src/include/override
+HOST_UTIL_LINUX_CONF_OPTS += LDFLAGS="-Wl,-rpath,$(HOST_DIR)/lib"
+LINUX_CFLAGS += -mcpu=spacemit-x100
+OPENSBI_DEPENDENCIES += host-uboot-tools
+
+define LINUX_APPLY_CUSTOM_DIR_PATCHES
+	@for p in $(call qstrip,$(BR2_LINUX_KERNEL_PATCH)); do \
+		[ -d "$$p" ] || continue; \
+		for f in $$p/*.patch; do \
+			[ -f "$$f" ] || continue; \
+			if patch -p1 -N --dry-run -d $(@D) < "$$f" >/dev/null 2>&1; then \
+				patch -p1 -N -d $(@D) < "$$f" || exit 1; \
+			fi; \
+		done; \
+	done
+endef
+LINUX_POST_RSYNC_HOOKS += LINUX_APPLY_CUSTOM_DIR_PATCHES
+
+MESA3D_DEPENDENCIES += host-mesa3d spirv-llvm-translator spirv-tools
+MESA3D_CONF_OPTS += -Dcpp_rtti=true -Dmesa-clc=system -Dprecomp-compiler=system -Dimagination-srv=false
+HOST_CLANG_POST_INSTALL_HOOKS += K3_USE_REAL_CLANG
+define K3_USE_REAL_CLANG
+	ln -sf clang.br_real $(HOST_DIR)/bin/clang
+	ln -sf clang.br_real $(HOST_DIR)/bin/clang-22
+	ln -sf clang++.br_real $(HOST_DIR)/bin/clang++
+	ln -sf clang-cpp.br_real $(HOST_DIR)/bin/clang-cpp
+endef
+HOST_MESA3D_DEPENDENCIES += host-spirv-llvm-translator
+HOST_MESA3D_CONF_OPTS += -Dcpp_rtti=true
+HOST_MESA3D_POST_INSTALL_HOOKS += K3_INSTALL_PCO_CLC
+define K3_INSTALL_PCO_CLC
+	$(INSTALL) -D -m 0755 $(@D)/buildroot-build/src/imagination/pco/uscgen/pco_clc $(HOST_DIR)/bin/pco_clc
+endef
+HOST_GCC_INITIAL_POST_INSTALL_HOOKS += K3_GCC_INITIAL_ATOMIC_ASNEEDED
+define K3_GCC_INITIAL_ATOMIC_ASNEEDED
+	$(HOST_DIR)/bin/$(GNU_TARGET_NAME)-ar rcs $(HOST_DIR)/lib/gcc/$(GNU_TARGET_NAME)/17.0.0/libatomic_asneeded.a
+endef
+
+include $(BR2_EXTERNAL_RVA23_PATH)/package/edk2-spacemit/edk2-spacemit.mk
+include $(BR2_EXTERNAL_RVA23_PATH)/package/k3-libtpms/k3-libtpms.mk
+include $(BR2_EXTERNAL_RVA23_PATH)/package/k3-swtpm/k3-swtpm.mk
+else
+define RVA23_APPLY_UBOOT_PATCHES
+	for patch in $(BR2_EXTERNAL_RVA23_PATH)/patches/uboot/*.patch; do \
+		patch -p1 -d $(@D) < "$$patch" || exit 1; \
+	done
+endef
+UBOOT_POST_RSYNC_HOOKS += RVA23_APPLY_UBOOT_PATCHES
+
+define RVA23_PROVISION_EDK2_KEYS
+	$(HOST_DIR)/bin/python3 $(BR2_EXTERNAL_RVA23_PATH)/scripts/provision-keys.py $(RVA23_KEY_DIR) $(@D)
+	$(HOST_DIR)/bin/python3 $(BR2_EXTERNAL_RVA23_PATH)/scripts/provision-edk2.py $(@D)
+endef
+EDK2_PRE_BUILD_HOOKS += RVA23_PROVISION_EDK2_KEYS
+
+define RVA23_PROVISION_LINUX_KEYS
+	$(HOST_DIR)/bin/python3 $(BR2_EXTERNAL_RVA23_PATH)/scripts/provision-keys.py $(RVA23_KEY_DIR)
+	$(@D)/scripts/config --file $(@D)/.config --set-str SYSTEM_TRUSTED_KEYS "$(RVA23_KEY_DIR)/trusted.pem"
+	$(@D)/scripts/config --file $(@D)/.config --set-str IPE_BOOT_POLICY "$(BR2_EXTERNAL_RVA23_PATH)/board/rva23-qemu/ipe-boot.policy"
+endef
+LINUX_PRE_BUILD_HOOKS += RVA23_PROVISION_LINUX_KEYS
+
+SYSTEMD_CONF_OPTS += -Dsysupdated=enabled
+HOST_SYSTEMD_CONF_OPTS += -Dsysupdate=enabled -Dsysupdated=enabled -Dimportd=enabled -Dfdisk=enabled -Dlibcurl=enabled -Dopenssl=enabled -Dtpm2=enabled -Dzlib=enabled -Dxz=enabled -Defi=true -Dbootloader=enabled -Dblkid=enabled
+HOST_SYSTEMD_DEPENDENCIES += host-libcurl host-openssl host-tpm2-tss
+HOST_LIBCURL_CONF_OPTS += --without-brotli
+HOST_QEMU_OPTS += --enable-u2f --enable-smartcard
+LIBNL_MAKE = $(MAKE) -j1
+endif
+
+PIXMAN_CONF_OPTS += -Drvv=disabled
+define HOST_DRACUT_APPLY_SHARED_PATCHES
+	for patch in $(BR2_EXTERNAL_RVA23_PATH)/package/dracut/*.patch; do \
+		patch -p1 -d $(@D) < "$$patch" || exit 1; \
+	done
+endef
+HOST_DRACUT_POST_PATCH_HOOKS += HOST_DRACUT_APPLY_SHARED_PATCHES
+
+define RVA23_REFRESH_TOOLCHAIN_WRAPPER
+	if [ -d "$($(1)_DIR)" ] && [ -x "$(HOST_DIR)/bin/$(GNU_TARGET_NAME)-gcc" ]; then \
+		$(HOSTCC) $(HOST_CFLAGS) $(TOOLCHAIN_WRAPPER_ARGS) \
+			-s -Wl,--hash-style=$(TOOLCHAIN_WRAPPER_HASH_STYLE) \
+			toolchain/toolchain-wrapper.c \
+			-o $($(1)_DIR)/toolchain-wrapper || exit 1; \
+		$(INSTALL) -D -m 0755 $($(1)_DIR)/toolchain-wrapper \
+			$(HOST_DIR)/bin/toolchain-wrapper || exit 1; \
+		printf 'int rva23;\n' | $(HOST_DIR)/bin/$(GNU_TARGET_NAME)-gcc \
+			-c -x c - -o /dev/null || exit 1; \
+	fi
+endef
+
+.PHONY: rva23-refresh-toolchain-wrapper rva23-refresh-toolchain-wrapper-initial rva23-refresh-toolchain-wrapper-final
+rva23-refresh-toolchain-wrapper: rva23-refresh-toolchain-wrapper-initial rva23-refresh-toolchain-wrapper-final
+rva23-refresh-toolchain-wrapper-initial: PKG = HOST_GCC_INITIAL
+rva23-refresh-toolchain-wrapper-initial:
+	$(call RVA23_REFRESH_TOOLCHAIN_WRAPPER,HOST_GCC_INITIAL)
+rva23-refresh-toolchain-wrapper-final: PKG = HOST_GCC_FINAL
+rva23-refresh-toolchain-wrapper-final:
+	$(call RVA23_REFRESH_TOOLCHAIN_WRAPPER,HOST_GCC_FINAL)
+
+include $(BR2_EXTERNAL_RVA23_PATH)/package/sbsigntools/sbsigntools.mk
+include $(BR2_EXTERNAL_RVA23_PATH)/package/tpm2-tss/tpm2-tss.mk
+include $(BR2_EXTERNAL_RVA23_PATH)/package/k3s/k3s.mk
+include $(BR2_EXTERNAL_RVA23_PATH)/package/rva23-criu/criu.mk
