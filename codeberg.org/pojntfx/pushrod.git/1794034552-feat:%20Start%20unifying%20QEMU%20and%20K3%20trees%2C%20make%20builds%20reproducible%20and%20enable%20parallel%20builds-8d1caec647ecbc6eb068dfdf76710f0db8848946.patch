+#!/usr/bin/env python3
+import json
+import os
+from pathlib import Path
+import signal
+import subprocess
+import sys
+
+
+def main():
+    scripts = Path(__file__).parent.resolve()
+    root = Path(os.environ.get("RVA23_DEMO_DIR", scripts.parent / "output/demo")).resolve()
+    root.mkdir(parents=True, exist_ok=True)
+    go = os.environ.get("RVA23_GO", "go")
+    environment = os.environ.copy()
+    environment["GOWORK"] = "off"
+    key_dir = root / "keys"
+    subprocess.run([sys.executable, scripts / "provision-keys.py", key_dir], env=environment, check=True)
+    environment["RVA23_KEY_DIR"] = str(key_dir)
+    binaries = {}
+    for name, source, directory in (
+        ("report-receiver", "report-receiver.go", scripts),
+        ("wallet-server", "wallet-server.go", scripts),
+        ("migration-server", "./cmd/migration-server", scripts / "migration"),
+    ):
+        output = root / name
+        subprocess.run([go, "build", "-o", output, source], cwd=directory, env=environment, check=True)
+        binaries[name] = output
+    pcr = os.environ.get("RVA23_DEMO_PCR11", "0" * 64)
+    (root / "wallet").mkdir(parents=True, exist_ok=True)
+    (root / "wallet/profiles.json").write_text(json.dumps({"development": pcr, "production": pcr}) + "\n")
+    environment.update({
+        "RVA23_ATTESTATION_DIR": str(root / "attestation"),
+        "RVA23_WALLET_PROFILE_FILE": str(root / "wallet/profiles.json"),
+        "RVA23_MIGRATION_PRODUCTION_PCR11": pcr,
+        "RVA23_WALLET_DIR": str(root / "wallet"),
+        "RVA23_MIGRATION_CHECKPOINT_DIR": str(root / "migration/checkpoints"),
+        "RVA23_REPORT_LISTEN": "[::]:8080",
+        "RVA23_WALLET_LISTEN": "[::]:8081",
+        "RVA23_MIGRATION_LISTEN": "[::]:8083",
+        "RVA23_WALLET_ATTESTATION_URL": "http://[::1]:8080/v1/attest",
+        "RVA23_MIGRATION_ATTESTATION_URL": "http://[::1]:8080/v1/attest",
+        "RVA23_MIGRATION_VM1_KEY_FILE": str(key_dir / "pcr-public.pem"),
+        "RVA23_MIGRATION_VM2_KEY_FILE": str(key_dir / "pcr-public.pem"),
+        "RVA23_WALLET_KEY_FILE": str(root / "attestation/public-key.pem"),
+    })
+    processes = []
+    try:
+        for name in ("report-receiver", "wallet-server", "migration-server"):
+            processes.append(subprocess.Popen([binaries[name]], cwd=scripts, env=environment))
+        print("Demo servers listen on [::]:8080, [::]:8081, and [::]:8083")
+        for process in processes:
+            process.wait()
+    except KeyboardInterrupt:
+        pass
+    finally:
+        for process in processes:
+            process.send_signal(signal.SIGTERM)
+        for process in processes:
+            process.wait()
+
+
+if __name__ == "__main__":
+    main()
