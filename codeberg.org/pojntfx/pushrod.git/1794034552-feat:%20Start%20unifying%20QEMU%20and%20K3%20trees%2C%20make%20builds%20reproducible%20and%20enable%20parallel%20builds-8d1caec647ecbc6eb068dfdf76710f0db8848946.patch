+    if "gitVersion" not in result:
+        raise AssertionError(result)
+    k3.command("systemctl stop rva23-k3s-test")
+    print("PASS: k3s starts an API server and kubectl reads its version")
+
+
+def main():
+    output = Path(sys.argv[1]).resolve()
+    mode = sys.argv[2] if len(sys.argv) > 2 else "base"
+    k3 = K3(output)
+    if mode == "image":
+        image(k3)
+    elif mode == "firmware":
+        firmware(k3)
+    elif mode == "base":
+        base(k3)
+    elif mode == "attestation":
+        attestation(k3)
+    elif mode == "podman":
+        podman(k3)
+    elif mode == "k3s":
+        k3s(k3)
+    elif mode == "report":
+        report(k3)
+    elif mode == "update":
+        update(k3)
+    elif mode == "hardening":
+        hardening(k3)
+    elif mode == "wallet":
+        wallet(k3)
+    elif mode == "migration":
+        migration(k3)
+    elif mode == "mutual":
+        mutual(k3)
+    else:
+        raise ValueError(f"Unknown validation mode: {mode}")
+
