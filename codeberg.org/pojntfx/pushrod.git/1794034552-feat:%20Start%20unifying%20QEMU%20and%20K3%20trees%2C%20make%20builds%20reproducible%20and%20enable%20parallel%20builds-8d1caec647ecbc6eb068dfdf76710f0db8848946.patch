diff --git a/buildroot/board/rva23-qemu/run-qemu.sh b/buildroot/board/rva23-qemu/run-qemu.sh
new file mode 100755
index 0000000000000000000000000000000000000000..a7dafd38849d8eba8c94f7502cc50295c7b56afd
--- /dev/null
+++ b/buildroot/board/rva23-qemu/run-qemu.sh
@@ -0,0 +1,64 @@
+#!/bin/sh
+
+set -eu
+
+IMAGES_DIR=$(realpath "${1}")
+QEMU=${QEMU:-"${IMAGES_DIR}/../host/bin/qemu-system-riscv64"}
+DISK_IMAGE=${RVA23_DISK:-"${IMAGES_DIR}/disk.img"}
+EDK2_VARS=${RVA23_EDK2_VARS:-"${IMAGES_DIR}/RISCV_VIRT_VARS.fd"}
+SWTPM=${SWTPM:-"${IMAGES_DIR}/../host/bin/swtpm"}
+TPM_STATE=${RVA23_TPM_STATE:-"${IMAGES_DIR}/../swtpm"}
+mkdir -p "${TPM_STATE}"
+rm -f "${TPM_STATE}/swtpm.sock" "${TPM_STATE}/swtpm.lock" "${TPM_STATE}/.lock"
+"${SWTPM}" socket --tpm2 --tpmstate dir="${TPM_STATE}",mode=0600,lock \
+	--ctrl type=unixio,path="${TPM_STATE}/swtpm.sock",mode=0600,terminate \
+	--flags not-need-init,startup-clear --log file="${TPM_STATE}/swtpm.log" &
+SWTPM_PID=$!
+trap 'kill "${SWTPM_PID}" 2>/dev/null || true; wait "${SWTPM_PID}" 2>/dev/null || true' EXIT INT TERM
+while [ ! -S "${TPM_STATE}/swtpm.sock" ]; do
+	sleep 0.1
+done
+
+if [ -f "${IMAGES_DIR}/secure-boot-oem.txt" ]; then
+	set -- -smbios "type=11,value=$(cat "${IMAGES_DIR}/secure-boot-oem.txt")"
+fi
+if [ "${QEMU_VNC:-0}" = 1 ]; then
+	set -- -vnc [::1]:0
+else
+	set -- -display none
+fi
+if [ -n "${RVA23_UPDATE_IMAGE:-}" ]; then
+	set -- "$@" -drive file="${RVA23_UPDATE_IMAGE}",format=raw,if=virtio
+fi
+if [ -n "${RVA23_UI_HOST_PORT:-}" ]; then
+	set -- "$@" -netdev "user,id=net0,hostfwd=tcp:[::1]:${RVA23_UI_HOST_PORT}-:8084"
+else
+	set -- "$@" -netdev user,id=net0
+fi
+if [ -n "${RVA23_FIDO2_DIR:-}" ]; then
+	set -- "$@" -device "u2f-emulated,dir=${RVA23_FIDO2_DIR}"
+fi
+if [ -n "${RVA23_SMARTCARD_DIR:-}" ]; then
+	set -- "$@" -device "usb-ccid,attached=on" -device "ccid-card-emulated,backend=certificates,db=sql:${RVA23_SMARTCARD_DIR},cert1=id-cert,cert2=signing-cert,cert3=encryption-cert"
+fi
+
+exec "${QEMU}" \
+	-M virt,pflash0=pflash0,pflash1=pflash1,acpi=off \
+	-accel tcg \
+	-cpu rva23s64 \
+	-smp 4 \
+	-m 2048 \
+	-bios "${IMAGES_DIR}/fw_dynamic.bin" \
+	-blockdev node-name=pflash0,driver=file,read-only=on,filename="${IMAGES_DIR}/RISCV_VIRT_CODE.fd" \
+	-blockdev node-name=pflash1,driver=file,filename="${EDK2_VARS}" \
+	-drive file="${DISK_IMAGE}",format=raw,if=virtio \
+	-device virtio-net-pci,netdev=net0 \
+	-device virtio-gpu-pci \
+	-device qemu-xhci \
+	-device usb-kbd \
+	-device usb-tablet \
+	-chardev socket,id=chrtpm,path="${TPM_STATE}/swtpm.sock" \
+	-tpmdev emulator,id=tpm0,chardev=chrtpm \
+	-device tpm-tis-device,tpmdev=tpm0 \
+	"$@" \
+	-serial stdio
