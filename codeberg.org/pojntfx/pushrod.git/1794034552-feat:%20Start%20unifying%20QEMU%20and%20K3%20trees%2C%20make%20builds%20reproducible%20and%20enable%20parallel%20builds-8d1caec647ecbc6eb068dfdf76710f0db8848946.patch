+#!/usr/bin/env python3
+import hashlib
+import lzma
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+
+
+def uuid(hex_value):
+    return f"{hex_value[:8]}-{hex_value[8:12]}-{hex_value[12:16]}-{hex_value[16:20]}-{hex_value[20:32]}"
+
+
+def compress(source, destination):
+    with source.open("rb") as input_file, lzma.open(destination, "wb", preset=6) as output_file:
+        shutil.copyfileobj(input_file, output_file)
+
+
+def main():
+    output = Path(sys.argv[1]).resolve()
+    key_dir = Path(sys.argv[2]).resolve()
+    version = sys.argv[3] if len(sys.argv) > 3 else "2"
+    images = output / "images"
+    update = output / f"update-v{version}"
+    if update.exists():
+        shutil.rmtree(update)
+    update.mkdir(parents=True)
+    for name in ("Image", "rootfs.cpio.gz"):
+        shutil.copyfile(images / name, update / name)
+    bootloader = update / "efi-part/EFI/BOOT"
+    bootloader.mkdir(parents=True)
+    shutil.copyfile(output / "build/systemd-262.1/buildroot-build/src/boot/systemd-bootriscv64.efi", bootloader / "bootriscv64.efi")
+    environment = os.environ.copy()
+    environment.update({
+        "BINARIES_DIR": str(update),
+        "TARGET_DIR": str(output / "target"),
+        "HOST_DIR": str(output / "host"),
+        "RVA23_KEY_DIR": str(key_dir),
+        "K3_KEY_DIR": str(key_dir),
+        "RVA23_VERSION": version,
+    })
+    board = os.environ.get("RVA23_BOARD", "rva23-qemu")
+    if board == "k3-uefi":
+        environment["RVA23_UNAME"] = "6.18.3"
+    builder = "k3-build-os-images.py" if board == "k3-uefi" else "build-os-images.py"
+    subprocess.run([output / "host/bin/fakeroot", "--", output.parent.parent / "scripts" / builder], check=True, env=environment)
+    registry = output / "registry"
+    if registry.exists():
+        shutil.rmtree(registry)
+    registry.mkdir()
+    root_hash = (update / f"usr-{version}.roothash").read_text().strip()
+    partition_uuids = {
+        "usr.erofs.xz": uuid(root_hash[:32]),
+        "usr.verity.xz": uuid(root_hash[32:]),
+        "usr.verity-sig.xz": None,
+    }
+    for suffix, partition_uuid in partition_uuids.items():
+        source_suffix = suffix.removesuffix(".xz").removeprefix("usr.")
+        discriminator = f"_{partition_uuid}" if partition_uuid else ""
+        compress(update / f"usr-{version}.{source_suffix}", registry / f"rva23_{version}{discriminator}.{suffix}")
+    shutil.copyfile(update / f"efi-part/EFI/Linux/rva23_{version}+3-0.efi", registry / f"rva23_{version}.efi")
+    shutil.copyfile(update / f"efi-part/EFI/Linux/rva23-recovery_{version}.efi", registry / f"rva23-recovery_{version}.efi")
+    shutil.copyfile(update / f"efi-part/EFI/Linux/rva23-debug_{version}.efi", registry / f"rva23-debug_{version}.efi")
+    shutil.copyfile(update / "efi-part/EFI/BOOT/bootriscv64.efi", registry / f"systemd-boot_{version}.efi")
+    compress(update / f"graphics_{version}.raw", registry / f"graphics_{version}.raw.xz")
+    compress(update / f"debug_{version}.raw", registry / f"debug_{version}.raw.xz")
+    compress(update / f"podman_{version}.raw", registry / f"podman_{version}.raw.xz")
+    compress(update / f"k3s_{version}.raw", registry / f"k3s_{version}.raw.xz")
+    lines = []
+    for path in sorted(registry.iterdir()):
+        lines.append(f"{hashlib.sha256(path.read_bytes()).hexdigest()}  {path.name}")
+    (registry / "SHA256SUMS").write_text("\n".join(lines) + "\n")
+    subprocess.run(
+        [
+            "gpg", "--batch", "--yes", "--homedir", key_dir / "gnupg",
+            "--local-user", "RVA23 development update", "--detach-sign",
+            "--output", registry / "SHA256SUMS.gpg", registry / "SHA256SUMS",
+        ],
+        check=True,
+    )
+    print(registry)
+
+
+if __name__ == "__main__":
+    main()
