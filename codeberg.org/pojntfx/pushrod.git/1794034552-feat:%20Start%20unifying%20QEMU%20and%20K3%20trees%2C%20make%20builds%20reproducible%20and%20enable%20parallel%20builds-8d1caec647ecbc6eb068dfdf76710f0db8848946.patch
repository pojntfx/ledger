-func DecodeJSONSequence(body io.Reader) (DecodedReport, error) {
-	var decoded DecodedReport
-	data, err := io.ReadAll(io.LimitReader(body, MaxReportBytes+1))
-	if err != nil {
-		return decoded, err
-	}
-	if len(data) > MaxReportBytes {
-		return decoded, errors.New("signed report exceeds the size limit")
-	}
-	parts := bytes.Split(data, []byte{0x1e})
-	if len(parts) < 2 {
-		return decoded, errors.New("signed report requires JSON-SEQ records")
-	}
-	decoded.Raw = data
-	decoded.JSON = append([]byte(nil), parts[1]...)
-	if !json.Valid(decoded.JSON) {
-		return DecodedReport{}, errors.New("signed report contains invalid report JSON")
-	}
-	for _, part := range parts[2:] {
-		part = bytes.TrimSpace(part)
-		if len(part) == 0 {
-			continue
-		}
-		var signature ReportSignature
-		if err := json.Unmarshal(part, &signature); err != nil {
-			return DecodedReport{}, err
-		}
-		decoded.Signatures = append(decoded.Signatures, signature)
-	}
-	return decoded, nil
-}
