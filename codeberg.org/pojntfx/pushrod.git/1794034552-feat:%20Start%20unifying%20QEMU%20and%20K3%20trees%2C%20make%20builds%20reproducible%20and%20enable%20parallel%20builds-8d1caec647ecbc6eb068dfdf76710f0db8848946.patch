+#!/usr/bin/env python3
+import base64
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+
+
+def run(*args):
+    subprocess.run([str(arg) for arg in args], check=True)
+
+
+def ensure_key(key_dir, name):
+    key = key_dir / f"{name}.key"
+    cert = key_dir / f"{name}.crt"
+    if not key.exists():
+        run("openssl", "genpkey", "-algorithm", "RSA", "-out", key, "-pkeyopt", "rsa_keygen_bits:3072", "-pkeyopt", "rsa_keygen_pubexp:65537")
+        key.chmod(0o600)
+    if not cert.exists():
+        run("openssl", "req", "-batch", "-new", "-x509", "-sha256", "-days", "3650", "-subj", f"/CN=RVA23 development {name}/", "-key", key, "-out", cert)
+    return key, cert
+
+
+def sign_verity(key_dir, root_hash_file, output):
+    key, cert = ensure_key(key_dir, "verity")
+    result = subprocess.run(
+        ["openssl", "cms", "-sign", "-noattr", "-signer", str(cert), "-inkey", str(key), "-binary", "-in", str(root_hash_file), "-outform", "PEM"],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    signature = "".join(line for line in result.stdout.splitlines() if not line.startswith("-----"))
+    der = subprocess.run(["openssl", "x509", "-in", str(cert), "-outform", "DER"], check=True, capture_output=True).stdout
+    document = {
+        "rootHash": root_hash_file.read_text().strip(),
+        "certificateFingerprint": hashlib.sha256(der).hexdigest(),
+        "signature": signature,
+    }
+    payload = json.dumps(document, separators=(",", ":")).encode()
+    padded = (len(payload) + 4095) // 4096 * 4096
+    output.write_bytes(payload.ljust(padded, b"\0"))
+    output.with_suffix(".sig-size").write_text(f"{padded}\n")
+    return cert
+
+
+def sign_pe(host, key_dir, path):
+    key, cert = ensure_key(key_dir, "secure-boot")
+    temporary = path.with_suffix(path.suffix + ".signed")
+    run(host / "bin/sbsign", "--key", key, "--cert", cert, "--output", temporary, path)
+    temporary.replace(path)
+
+
+def build_uki(host, images, usr, stub, name, cmdline, key_dir):
+    output = images / "efi-part/EFI/Linux" / name
+    (images / f"{name}.cmdline").write_text(cmdline + "\n")
+    base = images / "efi-part/EFI/Linux" / f".{name}.base"
+    result = subprocess.run(
+        [
+            str(host / "bin/python3"),
+            str(host / "bin/ukify"),
+            "build",
+            "--linux", str(images / "Image"),
+            "--initrd", str(images / "rootfs.cpio.gz"),
+            "--stub", str(stub),
+            "--efi-arch", "riscv64",
+            "--uname", os.environ.get("RVA23_UNAME", "7.3.1"),
+            "--cmdline", cmdline,
+            "--os-release", f"@{usr / 'lib/os-release'}",
+            "--pcr-public-key", str(key_dir / "pcr-public.pem"),
+            "--pcr-banks", "sha256",
+            "--policy-digest",
+            "--json=short",
+            "--output", str(base),
+        ],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    policies = json.loads(result.stdout)
+    for bank, entries in policies.items():
+        for entry in entries:
+            digest = base64.b16decode(entry["pol"].upper())
+            signature = subprocess.run(
+                ["openssl", "dgst", f"-{bank}", "-sign", str(key_dir / "pcr.key")],
+                input=digest,
+                check=True,
+                capture_output=True,
+            ).stdout
+            entry["sig"] = base64.b64encode(signature).decode()
+    policy_file = images / f"{name}.pcrs.json"
+    policy_file.write_text(json.dumps(policies))
+    run(host / "bin/python3", host / "bin/ukify", "build", "--join-pcrsig", base, "--pcrsig", f"@{policy_file}", "--json=short", "--output", output)
+    base.unlink()
+
+
+def build_k3_images(host, binaries, target):
+    key_dir = Path(os.environ.get("K3_KEY_DIR", binaries / "k3-keys")).resolve()
+    version = os.environ.get("RVA23_VERSION", "1")
+    key_dir.mkdir(parents=True, exist_ok=True)
+    os.environ["RVA23_KEY_DIR"] = str(key_dir)
+    run(Path(__file__).with_name("provision-keys.py"), key_dir)
+    staging = binaries / "image-staging"
+    if staging.exists():
+        shutil.rmtree(staging)
+    usr = staging / "usr"
+    shutil.copytree(target / "usr", usr, symlinks=True)
+    os_release = usr / "lib/os-release"
+    retained = [line for line in os_release.read_text().splitlines() if line.split("=", 1)[0] not in {"IMAGE_VERSION", "VERSION_ID"}]
+    retained.extend([f'IMAGE_VERSION="{version}"', f'VERSION_ID="{version}"'])
+    os_release.write_text("\n".join(retained) + "\n")
+    _, verity_cert = ensure_key(key_dir, "verity")
+    cert_destination = usr / "share/rva23/verity.crt"
+    cert_destination.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copyfile(verity_cert, cert_destination)
+    verity_config = usr / "lib/verity.d/00-rva23.crt"
+    verity_config.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copyfile(verity_cert, verity_config)
+    import_ring = usr / "lib/systemd/import-pubring.pgp"
+    shutil.copyfile(key_dir / "update-public.pgp", import_ring)
+    run(Path(__file__).with_name("build-extensions.py"))
+    build_attested_client(host, binaries, usr, include_smartcard=False)
+    artifact = "usr-a" if version == "1" else f"usr-{version}"
+    usr_image = binaries / f"{artifact}.erofs"
+    run(host / "bin/mkfs.erofs", "-zlz4hc,9", "-T", "0", "-U", "00000000-0000-0000-0000-000000000000", usr_image, usr)
+    with usr_image.open("r+b") as stream:
+        stream.truncate(512 * 1024 * 1024)
+    root_hash_file = binaries / f"{artifact}.roothash"
+    run(host / "sbin/veritysetup", "format", "--root-hash-file", root_hash_file, usr_image, binaries / f"{artifact}.verity")
+    with (binaries / f"{artifact}.verity").open("r+b") as stream:
+        stream.truncate(64 * 1024 * 1024)
+    sign_verity(key_dir, root_hash_file, binaries / f"{artifact}.verity-sig")
+    with (binaries / f"{artifact}.verity-sig").open("r+b") as stream:
+        stream.truncate(16 * 1024)
+    if version == "1":
+        shutil.copyfile(usr_image, binaries / "usr-b.erofs")
+        shutil.copyfile(binaries / "usr-a.verity", binaries / "usr-b.verity")
+        shutil.copyfile(binaries / "usr-a.verity-sig", binaries / "usr-b.verity-sig")
+    root_hash = root_hash_file.read_text().strip()
+    linux = binaries / "efi-part/EFI/Linux"
+    linux.mkdir(parents=True, exist_ok=True)
+    for old in linux.glob("*.efi"):
+        old.unlink()
+    base = f"console=ttyS0,115200 root=dissect mount.usr=dissect usrhash={root_hash} rw"
+    policy = "systemd.image_policy=usr=signed+read-only-on:root=unprotected+encrypted+absent+read-only-off:home=unprotected+encrypted+absent:swap=unprotected+encrypted+absent:esp=unprotected+unused:=unused+absent"
+    stub = target / "usr/lib/systemd/boot/efi/linuxriscv64.efi.stub"
+    profiles = {
+        f"rva23_{version}+3-0.efi": f"{base} {policy} ipe.enforce=0",
+        f"rva23-recovery_{version}.efi": f"{base} {policy} systemd.unit=rescue.target ipe.enforce=0",
+        f"rva23-debug_{version}.efi": f"{base} {policy} rd.debug SYSTEMD_SULOGIN_FORCE=1 systemd.log_level=info systemd.log_target=console ipe.enforce=0",
+    }
+    if version == "1":
+        profiles.update({
+            "rva23-factory-reset.efi": "console=ttyS0,115200 root=off mount.usr=off systemd.factory_reset=yes rd.systemd.unit=rva23-factory-reset.service rd.debug SYSTEMD_SULOGIN_FORCE=1",
+            "rva23-emergency.efi": f"{base} {policy} systemd.unit=emergency.target ipe.enforce=0",
+        })
+    for name, cmdline in profiles.items():
+        build_uki(host, binaries, usr, stub, name, cmdline, key_dir)
+    loader = binaries / "efi-part/loader"
+    loader.mkdir(parents=True, exist_ok=True)
+    entries = loader / "entries"
+    if entries.exists():
+        shutil.rmtree(entries)
+    entries.mkdir()
+    (entries / "k3.conf").write_text(f"title K3\nefi /EFI/Linux/rva23_{version}+3-0.efi\ndevicetree /k3-pico-itx.dtb\n")
+    (loader / "loader.conf").write_text("default k3.conf\ntimeout 0\neditor no\n")
+    sidecars = loader / "extensions"
+    sidecars.mkdir(exist_ok=True)
+    shutil.copyfile(binaries / f"podman_{version}.raw", sidecars / f"podman_{version}.raw")
+    shutil.copyfile(binaries / f"k3s_{version}.raw", sidecars / f"k3s_{version}.raw")
+    shutil.copyfile(binaries / "k3-pico-itx.dtb", binaries / "efi-part/k3-pico-itx.dtb")
+    (binaries / "rva23-version").write_text(f"{version}\n")
+
+
+def build_attested_client(host, binaries, usr, include_smartcard=True):
+    environment = os.environ.copy()
+    environment.update({"GOOS": "linux", "GOARCH": "riscv64", "CGO_ENABLED": "0", "GOTOOLCHAIN": "local", "GOWORK": "off"})
+    scripts = Path(__file__).parent
+    output = binaries / "attested-client"
+    subprocess.run([host / "bin/go", "build", "-o", output, Path(__file__).with_name("attested-client.go")], check=True, env=environment, cwd=scripts)
+    (usr / "bin").mkdir(exist_ok=True)
+    shutil.copy2(output, usr / "bin/attested-client")
+    wallet_output = binaries / "wallet-client"
+    subprocess.run([host / "bin/go", "build", "-o", wallet_output, Path(__file__).with_name("wallet-client.go"), Path(__file__).with_name("u2f.go")], check=True, env=environment, cwd=scripts)
+    shutil.copy2(wallet_output, usr / "bin/wallet-client")
+    migration_output = binaries / "migration-client"
+    subprocess.run([host / "bin/go", "build", "-o", migration_output, "./cmd/migration-client"], check=True, env=environment, cwd=Path(__file__).with_name("migration"))
+    shutil.copy2(migration_output, usr / "bin/migration-client")
+    for command in ("mutual-migration-client", "mutual-migration-server"):
+        mutual_output = binaries / command
+        subprocess.run([host / "bin/go", "build", "-o", mutual_output, f"./cmd/{command}"], check=True, env=environment, cwd=Path(__file__).with_name("migration"))
+        shutil.copy2(mutual_output, usr / f"bin/{command}")
+    if include_smartcard:
+        smartcard_include = host / "riscv64-buildroot-linux-gnu/sysroot/usr/include/PCSC"
+        subprocess.run([host / "bin/riscv64-linux-gcc", "-O2", f"-I{smartcard_include}", "-o", usr / "bin/smartcard-sign", Path(__file__).with_name("smartcard-sign.c"), "-lpcsclite", "-lcrypto"], check=True)
+
+
+def main():
+    binaries = Path(os.environ["BINARIES_DIR"]).resolve()
+    target = Path(os.environ["TARGET_DIR"]).resolve()
+    host = Path(os.environ["HOST_DIR"]).resolve()
+    if os.environ.get("RVA23_BOARD") == "k3-uefi":
+        if os.environ.get("K3_CLIENTS_ONLY") == "1":
+            build_attested_client(host, binaries, target / "usr", include_smartcard=False)
+        else:
+            build_k3_images(host, binaries, target)
+        return
+    key_dir = Path(os.environ["RVA23_KEY_DIR"]).resolve()
+    version = os.environ.get("RVA23_VERSION", "1")
+    key_dir.mkdir(parents=True, exist_ok=True)
+    run(Path(__file__).with_name("provision-keys.py"), key_dir)
+    pk_der = subprocess.run(["openssl", "x509", "-in", key_dir / "PK.crt", "-outform", "DER"], check=True, capture_output=True).stdout
+    oem = "4e32566d-8e9e-4f52-81d3-5bb9715f9727:" + base64.b64encode(pk_der).decode()
+    (binaries / "secure-boot-oem.txt").write_text(oem + "\n")
+    staging = binaries / "image-staging"
+    if staging.exists():
+        shutil.rmtree(staging)
+    usr = staging / "usr"
+    shutil.copytree(target / "usr", usr, symlinks=True)
+    os_release = usr / "lib/os-release"
+    retained = [line for line in os_release.read_text().splitlines() if line.split("=", 1)[0] not in {"IMAGE_VERSION", "VERSION_ID"}]
+    retained.extend([f'IMAGE_VERSION="{version}"', f'VERSION_ID="{version}"'])
+    os_release.write_text("\n".join(retained) + "\n")
+    _, verity_cert = ensure_key(key_dir, "verity")
+    cert_destination = usr / "share/rva23/verity.crt"
+    cert_destination.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copyfile(verity_cert, cert_destination)
+    verity_config = usr / "lib/verity.d/00-rva23.crt"
+    verity_config.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copyfile(verity_cert, verity_config)
+    import_ring = usr / "lib/systemd/import-pubring.pgp"
+    shutil.copyfile(key_dir / "update-public.pgp", import_ring)
+    run(Path(__file__).with_name("build-extensions.py"))
+    build_attested_client(host, binaries, usr)
+    artifact = "usr-a" if version == "1" else f"usr-{version}"
+    usr_image = binaries / f"{artifact}.erofs"
+    run(host / "bin/mkfs.erofs", "-zlz4hc,9", "-T", "0", "-U", "00000000-0000-0000-0000-000000000000", usr_image, usr)
+    with usr_image.open("r+b") as stream:
+        stream.truncate(512 * 1024 * 1024)
+    root_hash_file = binaries / f"{artifact}.roothash"
+    run(host / "sbin/veritysetup", "format", "--root-hash-file", root_hash_file, usr_image, binaries / f"{artifact}.verity")
+    with (binaries / f"{artifact}.verity").open("r+b") as stream:
+        stream.truncate(64 * 1024 * 1024)
+    sign_verity(key_dir, root_hash_file, binaries / f"{artifact}.verity-sig")
+    with (binaries / f"{artifact}.verity-sig").open("r+b") as stream:
+        stream.truncate(16 * 1024)
+    root_hash = root_hash_file.read_text().strip()
+    linux = binaries / "efi-part/EFI/Linux"
+    linux.mkdir(parents=True, exist_ok=True)
+    for old in linux.glob("*.efi"):
+        old.unlink()
+    base = f"console=ttyS0,115200 earlycon=sbi root=dissect mount.usr=dissect usrhash={root_hash} rw"
+    device_timeout = os.environ.get("RVA23_BOOT_DEVICE_TIMEOUT", "300")
+    if device_timeout:
+        if not device_timeout.isdigit() or int(device_timeout) < 90:
+            raise ValueError("RVA23_BOOT_DEVICE_TIMEOUT must contain at least 90 seconds")
+        base += f" systemd.default_device_timeout_sec={device_timeout}"
+    policy = "systemd.image_policy=usr=signed+read-only-on:root=unprotected+encrypted+absent+read-only-off:home=unprotected+encrypted+absent:swap=unprotected+encrypted+absent:esp=unprotected+unused:=unused+absent"
+    stub = target / "usr/lib/systemd/boot/efi/linuxriscv64.efi.stub"
+    fail_boot = " systemd.unit=emergency.target ipe.enforce=0" if os.environ.get("RVA23_FAIL_BOOT") == "1" else " ipe.enforce=1"
+    profiles = {
+        f"rva23_{version}+3-0.efi": f"{base} {policy}{fail_boot}",
+        f"rva23-recovery_{version}.efi": f"{base} {policy} systemd.unit=rescue.target ipe.enforce=0",
+        f"rva23-debug_{version}.efi": f"{base} {policy} rd.debug SYSTEMD_SULOGIN_FORCE=1 systemd.log_level=info systemd.log_target=console ipe.enforce=0",
+    }
+    if version == "1":
+        profiles.update({
+            "rva23-factory-reset.efi": "console=ttyS0,115200 earlycon=sbi root=off mount.usr=off systemd.factory_reset=yes rd.systemd.unit=rva23-factory-reset.service rd.debug SYSTEMD_SULOGIN_FORCE=1",
+            "rva23-emergency.efi": f"{base} {policy} systemd.unit=emergency.target ipe.enforce=0",
+        })
+    for name, cmdline in profiles.items():
+        build_uki(host, binaries, usr, stub, name, cmdline, key_dir)
+        sign_pe(host, key_dir, linux / name)
+    bootloader = binaries / "efi-part/EFI/BOOT/bootriscv64.efi"
+    if bootloader.exists():
+        sign_pe(host, key_dir, bootloader)
+    loader = binaries / "efi-part/loader"
+    loader.mkdir(parents=True, exist_ok=True)
+    sidecars = loader / "extensions"
+    sidecars.mkdir(exist_ok=True)
+    shutil.copyfile(binaries / f"podman_{version}.raw", sidecars / f"podman_{version}.raw")
+    shutil.copyfile(binaries / f"k3s_{version}.raw", sidecars / f"k3s_{version}.raw")
+    (loader / "loader.conf").write_text("default rva23_?.efi\ntimeout 0\neditor no\n")
+    (binaries / "rva23-version").write_text(f"{version}\n")
+
+
+if __name__ == "__main__":
+    main()
