diff --git a/buildroot/qemu/board/spacemit/k3-uefi/patches/linux/0001-k3-hardware-bringup.patch b/buildroot/qemu/board/spacemit/k3-uefi/patches/linux/0001-k3-hardware-bringup.patch
new file mode 100644
index 0000000000000000000000000000000000000000..4e58bb391e865530ca3b2655163596ba8e0e218e
--- /dev/null
+++ b/buildroot/qemu/board/spacemit/k3-uefi/patches/linux/0001-k3-hardware-bringup.patch
@@ -0,0 +1,289 @@
+--- a/arch/riscv/boot/dts/spacemit/k3.dtsi
++++ b/arch/riscv/boot/dts/spacemit/k3.dtsi
+@@ -127,13 +127,13 @@
+ 
+ 		/* used for rcpu0 code & data & bss space */
+ 		rcpu0_pwr: rcpu0_pwr@100200000 {
+-			reg = <0x1 0x200000 0x0 0x200000>;
++			reg = <0x1 0x200000 0x0 0x300000>;
+ 			no-map;
+ 		};
+ 
+ 		/* rcpu0's heap */
+-		rcpu0_heap: rcpu0_heap@100400000 {
+-			reg = <0x1 0x400000 0x0 0x200000>;
++		rcpu0_heap: rcpu0_heap@100500000 {
++			reg = <0x1 0x500000 0x0 0x200000>;
+ 			no-map;
+ 		};
+ 
+@@ -149,35 +149,35 @@
+ 			no-map;
+ 		};
+ 
+-		/* rcpu0 misc-used */
+-		rcpu0_misc_used: rcpu0_misc-used@c087c000 {
+-			reg = <0x0 0xc087c000 0x0 0x4000>;
++		/* vring2 */
++		rcpu0_vdev0vring2: vdev0vring2@c087c000 {
++			reg = <0x0 0xc087c000 0x0 0x1000>;
+ 			no-map;
+ 		};
+ 
+ 		/* the rcpu0's share memory buffer */
+-		rcpu0_vdev0buffer: vdev0buffer@100600000 {
++		rcpu0_vdev0buffer: vdev0buffer@100700000 {
+ 			compatible = "shared-dma-pool";
+-			reg = <0x1 0x600000 0x0 0xfc000>;
++			reg = <0x1 0x700000 0x0 0xfc000>;
+ 			no-map;
+ 		};
+ 
+ 		/* the rcpu0's resource table */
+-		rcpu0_rsc_table: rcpu0_rsc_table@1006fc000 {
+-			reg = <0x1 0x6fc000 0x0 0x4000>;
++		rcpu0_rsc_table: rcpu0_rsc_table@1007fc000 {
++			reg = <0x1 0x7fc000 0x0 0x4000>;
+ 			no-map;
+ 		};
+ 
+ 		/*****************rcpu1**********************/
+ 		/* used for rcp1 code & data & bss space */
+ 		rcpu1_runtime: rcpu1_runtime@100800000 {
+-			reg = <0x1 0x800000 0x0 0x200000>;
++			reg = <0x1 0x800000 0x0 0x300000>;
+ 			no-map;
+ 		};
+ 
+ 		/* rcpu1's heap */
+-		rcpu1_heap: rcpu1_heap@100a00000 {
+-			reg = <0x1 0xa00000 0x0 0x200000>;
++		rcpu1_heap: rcpu1_heap@100B00000 {
++			reg = <0x1 0xb00000 0x0 0x200000>;
+ 			no-map;
+ 		};
+ 
+@@ -193,27 +193,16 @@
+ 			no-map;
+ 		};
+ 
+-		/* rcpu1 misc-used */
+-		rcpu1_misc_used: rcpu1_misc-used@c0872000 {
+-			reg = <0x0 0xc0872000 0x0 0x4000>;
+-			no-map;
+-		};
+-
+-		sram_for_tcm: sram_for_tcm@c0868000 {
+-			reg = <0x0 0xc0868000 0x0 0x4000>;
+-			no-map;
+-		};
+-
+ 		/* the rcpu1's share memory buffer */
+-		rcpu1_vdev0buffer: vdev0buffer@100c00000 {
++		rcpu1_vdev0buffer: vdev0buffer@100d00000 {
+ 			compatible = "shared-dma-pool";
+-			reg = <0x1 0xc00000 0x0 0xfc000>;
++			reg = <0x1 0xd00000 0x0 0xfc000>;
+ 			no-map;
+ 		};
+ 
+ 		/* the rcpu1's resource table */
+-		rcpu1_rsc_table: rcpu1_rsc_table@100cfc000 {
+-			reg = <0x1 0xcfc000 0x0 0x4000>;
++		rcpu1_rsc_table: rcpu1_rsc_table@100dfc000 {
++			reg = <0x1 0xdfc000 0x0 0x4000>;
+ 			no-map;
+ 		};
+ 
+@@ -225,37 +214,9 @@
+ 
+ 		/* reseved rpmi for feture use */
+ 
+-		/* reserve 1M for rcpu's dtb space */
+-		rcpu_dtb_table: rcpu_dtb_table@100d00000 {
+-			reg = <0x1 0xd00000 0x0 0x100000>;
+-			no-map;
+-		};
+-
+-		/*
+-		 * Merged no-map region for rcpu hibernation misc state.
+-		 * Owner: k3-rproc driver (rcpu1 probe path), referenced via
+-		 * hibernation_snap[0] and rcpu1 memory-region.
+-		 * Firmware ABI (must stay in sync with OpenSBI and rcpu firmware):
+-		 *   +0x000000 (0x000400): rcpu_hiber_rtsp — rcpu hibernate runtime stack pointer
+-		 *   +0x000400 (0x001000): hiber_apuse     — AP persistent state (survives image restore)
+-		 *   +0x001400 (0x084000): snap_srrpi      — SRAM + RPMI snapshots
+-		 */
+-		hibernation_nomap: hibernation_nomap@100700000 {
+-			reg = <0x1 0x700000 0x0 0x85400>;
+-			no-map;
+-		};
+-
+-		/*
+-		 * Contiguous snapshot storage for rcpu DRAM and OpenSBI.
+-		 * Owner: k3-rproc driver (rcpu1 probe path), referenced via
+-		 * hibernation_snap[1] and rcpu1 memory-region.
+-		 * Firmware ABI (must stay in sync with rcpu firmware):
+-		 *   +0x000000 (0x500000): rcpu0 DRAM snapshot — 5 MiB
+-		 *   +0x500000 (0x500000): rcpu1 DRAM snapshot — 5 MiB
+-		 *   +0xa00000 (0x200000): OpenSBI snapshot     — 2 MiB
+-		 */
+-		hibernation_snap_rcpu: hibernation_snap_rcpu@100f00000 {
+-			reg = <0x1 0xf00000 0x0 0xc00000>;
++		/* reserve 3M for rcpu's dtb space */
++		rcpu_dtb_table: rcpu_dtb_table@100f00000 {
++			reg = <0x1 0xf00000 0x0 0x300000>;
+ 			no-map;
+ 		};
+ 
+@@ -1316,7 +1277,6 @@
+ 			firmware-name = "rt24_os1_rcpu.elf";
+ 			memory-region = <&rcpu1_runtime>, <&rcpu1_heap>, <&rcpu1_vdev0vring0>, <&rcpu1_vdev0buffer>,
+ 					<&rcpu1_vdev0vring1>, <&rcpu1_rsc_table>;
+-			hibernation_snap = <&hibernation_nomap>, <&hibernation_snap_rcpu>;
+ 			status = "okay";
+ 		};
+ 
+@@ -1360,6 +1320,7 @@
+ 			#address-cells = <2>;
+ 			#size-cells = <2>;
+ 			ranges;
++			status = "disabled";
+ 
+ 			power: power-controller {
+ 				compatible = "spacemit,power-controller";
+@@ -1367,7 +1328,7 @@
+ 				#power-domain-cells = <1>;
+ 				#address-cells = <1>;
+ 				#size-cells = <0>;
+-				status = "okay";
++				status = "disabled";
+ 
