+def build_k3_images(host, binaries, target):
+    linux = binaries / "efi-part/EFI/Linux"
+    linux.mkdir(parents=True, exist_ok=True)
+    for old in linux.glob("*.efi"):
+        old.unlink()
+    output = linux / "k3_1.efi"
+    cmdline = "console=ttyS0,115200 root=/dev/sda2 rootwait rw"
+    (binaries / "k3_1.efi.cmdline").write_text(cmdline + "\n")
+    run(
+        host / "bin/python3",
+        host / "bin/ukify",
+        "build",
+        "--linux", binaries / "Image",
+        "--stub", target / "usr/lib/systemd/boot/efi/linuxriscv64.efi.stub",
+        "--efi-arch", "riscv64",
+        "--uname", "6.18.3",
+        "--cmdline", cmdline,
+        "--os-release", f"@{target / 'usr/lib/os-release'}",
+        "--output", output,
+    )
+    loader = binaries / "efi-part/loader"
+    loader.mkdir(parents=True, exist_ok=True)
+    (loader / "loader.conf").write_text("default k3_1.efi\ntimeout 0\neditor no\n")
+
