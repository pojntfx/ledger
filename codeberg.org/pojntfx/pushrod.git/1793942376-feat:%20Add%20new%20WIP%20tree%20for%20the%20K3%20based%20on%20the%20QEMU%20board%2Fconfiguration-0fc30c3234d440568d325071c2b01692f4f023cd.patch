+#!/bin/sh
+set -eu
+DRM_DEVICE=card1
+for status in /sys/class/drm/card*-*/status; do
+	[ -e "$status" ] || continue
+	if [ "$(cat "$status" 2>/dev/null)" = connected ]; then
+		DRM_DEVICE=$(basename "$(dirname "$status")" | cut -d- -f1)
+		break
+	fi
+done
+exec /usr/bin/weston --config=/etc/weston.ini --drm-device="$DRM_DEVICE" --renderer=vulkan --idle-time=0 --continue-without-input --log=/run/weston/weston.log
