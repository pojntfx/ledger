@@ -0,0 +1,24 @@
+/dts-v1/;
+/ {
+	description = "K3 OpenSBI firmware";
+	#address-cells = <2>;
+	images {
+		fw_dynamic {
+			description = "OpenSBI fw_dynamic";
+			data = /incbin/("fw_dynamic.bin");
+			type = "firmware";
+			arch = "riscv";
+			os = "opensbi";
+			compression = "none";
+			load = <0x1 0x00000000>;
+			entry = <0x1 0x00000000>;
+		};
+	};
+	configurations {
+		default = "conf";
+		conf {
+			description = "K3 OpenSBI";
+			firmware = "fw_dynamic";
+		};
+	};
+};
