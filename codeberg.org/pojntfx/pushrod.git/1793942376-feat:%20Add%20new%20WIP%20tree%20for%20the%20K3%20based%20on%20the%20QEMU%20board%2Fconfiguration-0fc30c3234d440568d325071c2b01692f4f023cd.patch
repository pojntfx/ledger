From 0fc30c3234d440568d325071c2b01692f4f023cd Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Thu, 05 Nov 2026 22:19:36 -0700
Subject: [PATCH] feat: Add new WIP tree for the K3 based on the QEMU board/configuration
---
diff --git a/buildroot/qemu/Config.in b/buildroot/qemu/Config.in
index b5fbb19de22a64fe270a4a247cc4448f041158a5..dd6b7aceb894fd8b33ea4aa7f08648ecc70e4217 100644
--- a/buildroot/qemu/Config.in
+++ b/buildroot/qemu/Config.in
@@ -2,3 +2,4 @@ source "$BR2_EXTERNAL_RVA23_QEMU_PATH/package/sbsigntools/Config.in.host"
 source "$BR2_EXTERNAL_RVA23_QEMU_PATH/package/tpm2-tss/Config.in.host"
 source "$BR2_EXTERNAL_RVA23_QEMU_PATH/package/k3s/Config.in"
 source "$BR2_EXTERNAL_RVA23_QEMU_PATH/package/rva23-criu/Config.in"
+source "$BR2_EXTERNAL_RVA23_QEMU_PATH/package/edk2-spacemit/Config.in"
diff --git a/buildroot/qemu/Makefile b/buildroot/qemu/Makefile
index bb3324cf127524517d51c6338ad646746661b962..83ba2a6890185b6496d92279e39f334b62167c52 100644
--- a/buildroot/qemu/Makefile
+++ b/buildroot/qemu/Makefile
@@ -10,9 +10,13 @@ RVA23_KEY_DIR ?= $(abspath $(THIS_EXTERNAL_PATH)/../buildroot-qemu-keys)
 export RVA23_TPM_STATE := $(OUTPUT_DIR)/swtpm
 
 MAKE_BUILDROOT = $(MAKE) -C $(BUILDROOT_DIR) O=$(OUTPUT_DIR) BR2_EXTERNAL=$(THIS_EXTERNAL_PATH) BR2_DL_DIR=$(BR2_DL_DIR) BR2_CCACHE_DIR=$(BR2_CCACHE_DIR) UBOOT_OVERRIDE_SRCDIR=$(UBOOT_OVERRIDE_SRCDIR) RVA23_KEY_DIR=$(RVA23_KEY_DIR)
+K3_OUTPUT_DIR ?= $(abspath $(THIS_EXTERNAL_PATH)/../buildroot-k3-clean/build)
+K3_SOURCE_DIR ?= $(abspath $(THIS_EXTERNAL_PATH)/../buildroot-k3-clean/src)
+K3_LINUX_FIRMWARE_DIR ?= $(K3_SOURCE_DIR)/linux-firmware/powervr
+MAKE_BUILDROOT_K3 = $(MAKE) -C $(BUILDROOT_DIR) O=$(K3_OUTPUT_DIR) BR2_EXTERNAL=$(THIS_EXTERNAL_PATH) BR2_DL_DIR=$(BR2_DL_DIR) BR2_CCACHE_DIR=$(BR2_CCACHE_DIR) LINUX_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/linux OPENSBI_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/opensbi EDK2_SPACEMIT_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/edk2-spacemit BINUTILS_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/binutils HOST_GCC_INITIAL_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/gcc HOST_GCC_FINAL_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/gcc K3_LINUX_FIRMWARE_DIR=$(K3_LINUX_FIRMWARE_DIR)
 BUILDROOT_PATCHES = $(sort $(wildcard $(THIS_EXTERNAL_PATH)/patches/buildroot/*.patch))
 
-.PHONY: all configure build clean registry verify verify-image verify-boot verify-firmware verify-attestation verify-report verify-update verify-security verify-hardening verify-podman verify-k3s verify-attested-app verify-wallet verify-migration verify-mutual-migration boot boot-display boot-firmware
+.PHONY: all configure build clean registry verify verify-image verify-boot verify-firmware verify-attestation verify-report verify-update verify-security verify-hardening verify-podman verify-k3s verify-attested-app verify-wallet verify-migration verify-mutual-migration boot boot-display boot-firmware k3-configure k3-build
 
 all: build
 
@@ -22,6 +26,13 @@ 	$(MAKE_BUILDROOT) rva23_defconfig
 
 build: configure
 	$(MAKE_BUILDROOT)
+
+k3-configure:
+	for patch in $(BUILDROOT_PATCHES); do git -C $(BUILDROOT_DIR) apply --reverse --check "$$patch" || exit 1; done
+	$(MAKE_BUILDROOT_K3) k3_uefi_defconfig
+
+k3-build: k3-configure
+	$(MAKE_BUILDROOT_K3) -j14
 
 clean:
 	$(MAKE_BUILDROOT) clean
