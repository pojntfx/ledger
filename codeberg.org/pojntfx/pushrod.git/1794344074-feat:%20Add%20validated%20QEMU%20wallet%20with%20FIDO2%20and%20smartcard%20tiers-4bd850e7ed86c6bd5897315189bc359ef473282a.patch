@@ -0,0 +1,91 @@
+#!/usr/bin/env python3
+import json
+from pathlib import Path
+import re
+import sys
+
+sys.path.insert(0, str(Path(__file__).parent))
+
+import demo_lib
+import demo_qemu_warm as warm
+
+
+def enroll(demo, guest):
+    demo.step("Enroll the guest with a fresh quote")
+    warm.run(demo, guest, "systemctl restart systemd-report-sign-tpm2.socket", lines=0)
+    output = warm.run(demo, guest, "/usr/lib/systemd/systemd-report upload --url=http://10.0.2.2:8080/reports --sign=require-one", 300, lines=6)
+    if "accepted" not in output:
+        raise demo_lib.DemoError(output[-1500:])
+    demo.result("the receiver accepted the guest quote")
+
+
+def pay(demo, guest, contract, consent):
+    demo.step(f"Tier: {contract} with {consent} consent")
+    command = (
+        f"RVA23_WALLET_URL=http://10.0.2.2:8081 RVA23_ATTESTATION_URL=http://10.0.2.2:8080 "
+        f"wallet-client --contract={contract} --consent={consent} --approve"
+    )
+    output = warm.run(demo, guest, command, 300, lines=6)
+    body = None
+    for line in output.splitlines():
+        if line.strip().startswith("{"):
+            body = json.loads(line)
+    if not body:
+        raise demo_lib.DemoError(output[-1500:])
+    demo.result(f"status={body.get('status')} tier={body.get('tier')} amountCents={body.get('amountCents')}")
+
+
+def main():
+    demo = demo_lib.Demo(
+        "Demo 5b: the wallet on QEMU",
+        "The guest proves the host, the TPM signs the payment, and the wallet accepts it",
+    )
+    demo.banner()
+    demo.cue(f"Watch the wallet UI: {demo_lib.WALLET_UI}")
+    demo.ui("wallet", demo_lib.WALLET_UI)
+    demo.ui("event view", demo_lib.EVENT_UI)
+
+    demo.step("Attach to the warm guest")
+    guest, cold = warm.ensure("firmware")
+    if cold:
+        demo.note("the guest booted cold; pre-start it with make demo-qemu-warm to skip this wait")
+    demo.result("the guest is at a root shell")
+
+    demo.step("Read the measured PCR 11 from the guest")
+    output = warm.run(demo, guest, "cat /sys/class/tpm/tpm0/pcr-sha256/11", lines=1)
+    match = re.search(r"[0-9a-fA-F]{64}", output)
+    if not match:
+        raise demo_lib.DemoError(f"could not read PCR 11: {output[-400:]}")
+    pcr11 = match.group(0)
+    demo.result(f"PCR 11 = {pcr11}")
+
+    demo.step("Restart the verifier services with that profile")
+    demo_lib.restart_demo_servers("QEMU", pcr11=pcr11)
+    demo.result("the receiver and the wallet are up")
+
+    demo.step("Check the emulated consent devices")
+    warm.run(demo, guest, "systemctl restart pcscd", lines=0)
+    warm.run(demo, guest, "ls /dev/hidraw* /dev/ccid* 2>/dev/null; systemctl is-active pcscd", lines=3, check=False)
+    demo.result("the guest has the emulated U2F and CCID devices")
+
+    enroll(demo, guest)
+    pay(demo, guest, "small-payment", "host")
+    pay(demo, guest, "development-payment", "host")
+    pay(demo, guest, "development-payment", "fido2")
+    try:
+        pay(demo, guest, "development-payment", "smartcard")
+    except demo_lib.DemoError as error:
+        demo.note(f"smartcard consent needs a card reader in the guest: {str(error).splitlines()[0][:120]}")
+    pay(demo, guest, "mortgage", "host")
+    pay(demo, guest, "mortgage", "fido2")
+
+    demo.step("Read the wallet receipts in the unified view")
+    state = demo_lib.event_state()
+    demo.result(f"{len(state.get('events', []))} receipts in the view")
+
+    demo.payoff("The guest proved the host, and both payments were accepted")
+    return demo.finish()
+
+
+if __name__ == "__main__":
+    demo_lib.run(main)
