+def consent_devices():
+    import importlib.util
+
+    spec = importlib.util.spec_from_file_location("wallet_test", Path(__file__).with_name("verify-wallet.py"))
+    wallet = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(wallet)
+    root = Path(__file__).parent.parent / "output/demo/wallet"
+    root.mkdir(parents=True, exist_ok=True)
+    fido2 = root / "u2f"
+    smartcard = root / "smartcard"
+    if not (fido2 / "certificate.pem").exists():
+        wallet.create_fido2(fido2)
+    if not (smartcard / "smartcard-public.pem").exists():
+        wallet.create_smartcard(smartcard)
+    (root / "smartcard-public.pem").write_bytes((smartcard / "smartcard-public.pem").read_bytes())
+    return fido2, smartcard
+
+
 def start(name, script):
     WARM.mkdir(parents=True, exist_ok=True)
     disk = WARM / f"{name}.img"
@@ -167,6 +185,10 @@     socket_path = WARM / f"{name}.sock"
