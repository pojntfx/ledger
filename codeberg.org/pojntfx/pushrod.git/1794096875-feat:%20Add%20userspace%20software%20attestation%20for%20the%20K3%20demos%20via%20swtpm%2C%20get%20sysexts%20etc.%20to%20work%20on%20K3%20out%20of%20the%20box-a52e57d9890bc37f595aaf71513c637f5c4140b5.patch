+func softwareFido2Consent(challenge, application []byte, directory string) (U2FConsent, error) {
+	if len(challenge) != 32 || len(application) != 32 {
+		return U2FConsent{}, errors.New("U2F challenge and application must contain 32 bytes")
+	}
+	privateDER, err := os.ReadFile(filepath.Join(directory, "private-key.pem"))
+	if err != nil {
+		return U2FConsent{}, err
+	}
+	privateBlock, _ := pem.Decode(privateDER)
+	if privateBlock == nil {
+		return U2FConsent{}, errors.New("invalid FIDO2 private key PEM")
+	}
+	privateKey, err := x509.ParseECPrivateKey(privateBlock.Bytes)
+	if err != nil {
+		return U2FConsent{}, err
+	}
+	certificateDER, err := os.ReadFile(filepath.Join(directory, "certificate.pem"))
+	if err != nil {
+		return U2FConsent{}, err
+	}
+	certificateBlock, _ := pem.Decode(certificateDER)
+	if certificateBlock == nil {
+		return U2FConsent{}, errors.New("invalid FIDO2 certificate PEM")
+	}
+	certificate, err := x509.ParseCertificate(certificateBlock.Bytes)
+	if err != nil {
+		return U2FConsent{}, err
+	}
+	counterBytes, err := os.ReadFile(filepath.Join(directory, "counter"))
+	if err != nil || len(counterBytes) != 4 {
+		return U2FConsent{}, errors.New("invalid FIDO2 counter")
+	}
+	counter := binary.BigEndian.Uint32(counterBytes)
+	keyHandle := sha256.Sum256(append(application, certificate.Raw...))
+	publicDER, err := x509.MarshalPKIXPublicKey(&privateKey.PublicKey)
+	if err != nil {
+		return U2FConsent{}, err
+	}
+	publicBytes := make([]byte, 65)
+	publicBytes[0] = 4
+	privateKey.PublicKey.X.FillBytes(publicBytes[1:33])
+	privateKey.PublicKey.Y.FillBytes(publicBytes[33:65])
+	registrationMessage := make([]byte, 0, 1+32+32+len(keyHandle)+len(publicBytes))
+	registrationMessage = append(registrationMessage, 0)
+	registrationMessage = append(registrationMessage, application...)
+	registrationMessage = append(registrationMessage, challenge...)
+	registrationMessage = append(registrationMessage, keyHandle[:]...)
+	registrationMessage = append(registrationMessage, publicBytes...)
+	registrationDigest := sha256.Sum256(registrationMessage)
+	registrationSignature, err := ecdsa.SignASN1(rand.Reader, privateKey, registrationDigest[:])
+	if err != nil {
+		return U2FConsent{}, err
+	}
+	consentMessage := make([]byte, 0, 32+1+4+32)
+	consentMessage = append(consentMessage, application...)
+	consentMessage = append(consentMessage, 1)
+	consentCounter := make([]byte, 4)
+	binary.BigEndian.PutUint32(consentCounter, counter)
+	consentMessage = append(consentMessage, consentCounter...)
+	consentMessage = append(consentMessage, challenge...)
+	consentDigest := sha256.Sum256(consentMessage)
+	consentSignature, err := ecdsa.SignASN1(rand.Reader, privateKey, consentDigest[:])
+	if err != nil {
+		return U2FConsent{}, err
+	}
+	binary.BigEndian.PutUint32(counterBytes, counter+1)
+	if err := os.WriteFile(filepath.Join(directory, "counter"), counterBytes, 0o600); err != nil {
+		return U2FConsent{}, err
+	}
+	return U2FConsent{
+		PublicKey:             string(pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: publicDER})),
+		Certificate:           base64.RawURLEncoding.EncodeToString(certificate.Raw),
+		KeyHandle:             base64.RawURLEncoding.EncodeToString(keyHandle[:]),
+		RegistrationChallenge: base64.RawURLEncoding.EncodeToString(challenge),
+		RegistrationSignature: base64.RawURLEncoding.EncodeToString(registrationSignature),
+		Signature:             base64.RawURLEncoding.EncodeToString(consentSignature),
 		Counter:               counter,
 	}, nil
 }
