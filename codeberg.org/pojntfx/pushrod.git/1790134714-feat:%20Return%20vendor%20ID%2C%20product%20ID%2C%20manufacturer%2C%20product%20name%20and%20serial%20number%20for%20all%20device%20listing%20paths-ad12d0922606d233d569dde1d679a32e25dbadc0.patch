diff --git a/pkg/svc/usb.go b/pkg/svc/usb.go
new file mode 100644
index 0000000000000000000000000000000000000000..41fec106f65f12125190725790af603612321e97
--- /dev/null
+++ b/pkg/svc/usb.go
@@ -0,0 +1,31 @@
+package svc
+
+import (
+	"fmt"
+	"strings"
+
+	"go.bug.st/serial/enumerator"
+)
+
+type USBIdentity struct {
+	VendorID     string `json:"vendorId" jsonschema:"USB vendor ID as a four-digit hex string"`
+	ProductID    string `json:"productId" jsonschema:"USB product ID as a four-digit hex string"`
+	Manufacturer string `json:"manufacturer" jsonschema:"manufacturer that the device reports for itself"`
+	Product      string `json:"product" jsonschema:"product name that the device reports for itself"`
+	SerialNumber string `json:"serialNumber" jsonschema:"serial number that the device reports, if any"`
+}
+
+func usbIdentityFromPort(port *enumerator.PortDetails) USBIdentity {
+	return USBIdentity{
+		VendorID:     strings.ToLower(port.VID),
+		ProductID:    strings.ToLower(port.PID),
+		Manufacturer: port.Manufacturer,
+		Product:      port.Product,
+		SerialNumber: port.SerialNumber,
+	}
+}
+
+func formatUSBID(id uint16) string {
+	// There isn't really a better way to do this that avoids `fmt`
+	return fmt.Sprintf("%04x", id)
+}

