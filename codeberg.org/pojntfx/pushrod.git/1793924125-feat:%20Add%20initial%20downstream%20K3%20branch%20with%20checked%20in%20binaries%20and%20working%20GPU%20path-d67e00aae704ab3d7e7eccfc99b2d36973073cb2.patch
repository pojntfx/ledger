++	cJSON_ArrayForEach(entry, partitions) {
++		struct spacemit_partition *part;
++		const char *name;
++		const char *offset;
++		const char *size;
++		char item[PART_NAME_LEN + 96];
++		int item_len;
++
++		if (index >= SPACEMIT_MAX_PARTITIONS || !cJSON_IsObject(entry)) {
++			ret = -E2BIG;
++			goto out;
++		}
++		part = &parsed.partitions[index];
++		if (spacemit_json_string(entry, "name", &name) || !*name ||
++		    strlen(name) >= sizeof(part->name) ||
++		    spacemit_json_string(entry, "offset", &offset) ||
++		    spacemit_json_string(entry, "size", &size))
++			goto out;
++
++		strlcpy(part->name, name, sizeof(part->name));
++		part->hidden = spacemit_json_hidden(entry);
++		if (spacemit_parse_size(offset, capacity, 0, &part->offset) ||
++		    spacemit_parse_size(size, capacity, part->offset, &part->size) ||
++		    !part->size || part->offset > capacity ||
++		    part->size > capacity - part->offset)
++			goto out;
++
++		if (!strcmp(cmd, "gpt") && part->hidden)
++			goto next;
++
++		if (!strcmp(cmd, "gpt"))
++			item_len = snprintf(item, sizeof(item), "name=%s,start=%s,size=%s;",
++					    name, offset, size);
++		else
++			item_len = snprintf(item, sizeof(item), "%s@%s(%s)", size,
++					    offset, name);
++		if (item_len < 0 || (size_t)item_len >= sizeof(item))
++			goto out;
++
++		if (*table && spacemit_append_text(table, download_bytes + 128,
++						   parsed.format == SPACEMIT_FORMAT_GPT ? "" : ","))
++			goto out;
++		if (spacemit_append_text(table, download_bytes + 128, item))
++			goto out;
++next:
++		index++;
++	}
++
++	parsed.count = index;
++	if (!parsed.count)
++		goto out;
