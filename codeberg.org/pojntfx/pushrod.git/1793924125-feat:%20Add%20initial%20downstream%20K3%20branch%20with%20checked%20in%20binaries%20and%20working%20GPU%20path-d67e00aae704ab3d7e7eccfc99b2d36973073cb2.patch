++	if (!found) {
++		fastboot_fail("unknown partition", response);
++		return -ENOENT;
++	}
++
++	memset(info, 0, sizeof(*info));
++	strlcpy((char *)info->name, name, sizeof(info->name));
++	*part = found;
++	*desc = NULL;
++
++	if (layout.format == SPACEMIT_FORMAT_MTD) {
++		info->start = found->offset;
++		info->size = found->size;
++		info->blksz = 1;
++		return 0;
++	}
++
++	block = spacemit_blk_desc();
++	if (!block) {
++		fastboot_fail("no block device", response);
++		return -ENODEV;
++	}
++
++	if (!found->hidden) {
++		int ret = part_get_info_by_name(block, name, info);
++
++		if (ret < 0) {
++			fastboot_fail("failed to get partition info", response);
++			return ret;
++		}
++	} else {
++		if (found->offset % block->blksz || found->size % block->blksz) {
++			fastboot_fail("unaligned hidden partition", response);
++			return -EINVAL;
++		}
++		info->start = found->offset / block->blksz;
++		info->size = found->size / block->blksz;
++		info->blksz = block->blksz;
++	}
++
++	*desc = block;
++	return 0;
++}
