diff --git a/buildroot/k3/external.mk b/buildroot/k3/external.mk
new file mode 100644
index 0000000000000000000000000000000000000000..2663f701324b4b78f56ad6d1aebabceebd01e8ed
--- /dev/null
+++ b/buildroot/k3/external.mk
@@ -0,0 +1,30 @@
+LINUX_OVERRIDE_SRCDIR = $(abspath $(BR2_EXTERNAL_K3_PATH)/../src/linux)
+UBOOT_OVERRIDE_SRCDIR = $(abspath $(BR2_EXTERNAL_K3_PATH)/../src/u-boot)
+OPENSBI_OVERRIDE_SRCDIR = $(abspath $(BR2_EXTERNAL_K3_PATH)/../src/opensbi)
+define LINUX_APPLY_CUSTOM_DIR_PATCHES
+	@for p in $(call qstrip,$(BR2_LINUX_KERNEL_PATCH)); do \
+		[ -d "$$p" ] || continue; \
+		for f in $$p/*.patch; do \
+			[ -f "$$f" ] || continue; \
+			if patch -p1 -N --dry-run -d $(@D) < "$$f" >/dev/null 2>&1; then \
+				patch -p1 -N -d $(@D) < "$$f" || exit 1; \
+			fi; \
+		done; \
+	done
+endef
+LINUX_POST_RSYNC_HOOKS += LINUX_APPLY_CUSTOM_DIR_PATCHES
+MESA3D_DEPENDENCIES += spirv-llvm-translator spirv-tools clang
+MESA3D_CONF_OPTS += -Dcpp_rtti=true
+HOST_CLANG_POST_INSTALL_HOOKS += K3_USE_REAL_CLANG
+define K3_USE_REAL_CLANG
+	ln -sf clang.br_real $(HOST_DIR)/bin/clang
+	ln -sf clang.br_real $(HOST_DIR)/bin/clang-22
+	ln -sf clang++.br_real $(HOST_DIR)/bin/clang++
+	ln -sf clang-cpp.br_real $(HOST_DIR)/bin/clang-cpp
+endef
+HOST_MESA3D_DEPENDENCIES += host-spirv-llvm-translator
+HOST_MESA3D_CONF_OPTS += -Dcpp_rtti=true
+HOST_GCC_INITIAL_POST_INSTALL_HOOKS += K3_GCC_INITIAL_ATOMIC_ASNEEDED
+define K3_GCC_INITIAL_ATOMIC_ASNEEDED
+	$(HOST_DIR)/bin/$(GNU_TARGET_NAME)-ar rcs $(HOST_DIR)/lib/gcc/$(GNU_TARGET_NAME)/17.0.0/libatomic_asneeded.a
+endef
