++static int spacemit_mtd_erase(struct spacemit_partition *part, char *response)
++{
++	struct mtd_info *mtd = spacemit_mtd_master();
++	struct erase_info erase = { 0 };
++	int ret;
++
++	if (!mtd) {
++		fastboot_fail("no MTD device", response);
++		return -ENODEV;
++	}
++	if (part->offset % mtd->erasesize || part->size % mtd->erasesize) {
++		fastboot_fail("unaligned MTD partition", response);
++		return -EINVAL;
++	}
++
++	erase.mtd = mtd;
++	erase.addr = part->offset;
++	erase.len = part->size;
++	ret = mtd_erase(mtd, &erase);
++	if (ret) {
++		fastboot_fail("failed to erase MTD partition", response);
++		return ret;
++	}
++
++	part->erased = true;
++	fastboot_okay(NULL, response);
++	return 0;
++}
