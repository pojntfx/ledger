diff --git a/buildroot/k3/board/spacemit/k3/post-build.sh b/buildroot/k3/board/spacemit/k3/post-build.sh
new file mode 100755
index 0000000000000000000000000000000000000000..0175f1a73ad953e45bb7eb17ba12c0c65e6db062
--- /dev/null
+++ b/buildroot/k3/board/spacemit/k3/post-build.sh
@@ -0,0 +1,17 @@
+#!/bin/sh
+set -eu
+TARGET_DIR="$1"
+BOARD_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
+KEY_DIR="$BUILD_DIR/k3-keys"
+FIRMWARE_DIR="$BOARD_DIR/../../../../src/linux-firmware/powervr"
+mkdir -p "$KEY_DIR"
+if [ ! -f "$KEY_DIR/root_ed25519" ]; then
+	ssh-keygen -q -t ed25519 -N '' -C 'k3-root' -f "$KEY_DIR/root_ed25519"
+fi
+install -d -m 0700 "$TARGET_DIR/root/.ssh"
+install -m 0600 "$KEY_DIR/root_ed25519.pub" "$TARGET_DIR/root/.ssh/authorized_keys"
+install -d -m 0755 "$TARGET_DIR/lib/firmware/powervr"
+install -m 0644 "$FIRMWARE_DIR"/*.fw "$TARGET_DIR/lib/firmware/powervr/"
+if ! grep -q '^tty1:' "$TARGET_DIR/etc/inittab"; then
+	printf '%s\n' 'tty1::respawn:/sbin/getty -L 0 tty1 vt100' >> "$TARGET_DIR/etc/inittab"
+fi
diff --git a/buildroot/k3/board/spacemit/k3/post-image.sh b/buildroot/k3/board/spacemit/k3/post-image.sh
new file mode 100755
index 0000000000000000000000000000000000000000..12caede45b3bf605c5b3ed55eee5d3b9a8b3577f
--- /dev/null
+++ b/buildroot/k3/board/spacemit/k3/post-image.sh
@@ -0,0 +1,33 @@
+#!/bin/sh
+set -eu
+: "${BUILD_DIR:?}"
+: "${HOST_DIR:?}"
+BINARIES_DIR="$1"
+BOARD_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
+BOOTFS_DIR="$BUILD_DIR/k3-bootfs"
+rm -rf "$BOOTFS_DIR"
+mkdir -p "$BOOTFS_DIR/extlinux"
+install -m 0644 "$BINARIES_DIR/Image" "$BOOTFS_DIR/Image"
+install -m 0644 "$BINARIES_DIR/k3-pico-itx.dtb" "$BOOTFS_DIR/k3-pico-itx.dtb"
+install -m 0644 "$BOARD_DIR/env_k3.txt" "$BOOTFS_DIR/env_k3.txt"
+install -m 0644 "$BOARD_DIR/extlinux.conf" "$BOOTFS_DIR/extlinux/extlinux.conf"
+rm -f "$BINARIES_DIR/bootfs.img"
+truncate -s 256M "$BINARIES_DIR/bootfs.img"
+"$HOST_DIR/sbin/mkfs.vfat" -F 16 -S 4096 -n BOOTFS "$BINARIES_DIR/bootfs.img"
+"$HOST_DIR/bin/mcopy" -s -i "$BINARIES_DIR/bootfs.img" "$BOOTFS_DIR"/* ::
+cd "$BINARIES_DIR"
+install -m 0644 "$BOARD_DIR/fw_dynamic.its" fw_dynamic.its
+"$HOST_DIR/bin/mkimage" -f fw_dynamic.its fw_dynamic.itb
+install -m 0644 "$BOARD_DIR/env.bin" env.bin
+install -m 0644 "$BOARD_DIR/esos.itb" esos.itb
+install -d -m 0755 factory
+install -m 0644 "$BOARD_DIR/factory/FSBL.bin" factory/FSBL.bin
+install -m 0644 "$BOARD_DIR/factory/bootinfo_block.bin" factory/bootinfo_block.bin
+install -m 0644 "$BOARD_DIR/factory/bootinfo_spinor.bin" factory/bootinfo_spinor.bin
+install -m 0644 "$BOARD_DIR/factory/bootinfo_spinand.bin" factory/bootinfo_spinand.bin
+install -m 0644 "$BOARD_DIR/partition_universal.json" partition_universal.json
+install -m 0644 "$BOARD_DIR/partition_4M.json" partition_4M.json
+install -m 0644 "$BOARD_DIR/partition_8M.json" partition_8M.json
+install -m 0644 "$BOARD_DIR/partition_64M.json" partition_64M.json
+rm -f k3-pushrod.zip
+python3 -m zipfile -c k3-pushrod.zip partition_universal.json partition_4M.json partition_8M.json partition_64M.json env.bin factory/FSBL.bin factory/bootinfo_block.bin factory/bootinfo_spinor.bin factory/bootinfo_spinand.bin esos.itb fw_dynamic.itb u-boot.itb bootfs.img rootfs.ext4
diff --git a/buildroot/k3/board/spacemit/k3/rootfs-overlay/etc/init.d/S99weston b/buildroot/k3/board/spacemit/k3/rootfs-overlay/etc/init.d/S99weston
new file mode 100755
index 0000000000000000000000000000000000000000..8d52d2eaecb36dab947aeeab99cbdc2d4836e695
--- /dev/null
+++ b/buildroot/k3/board/spacemit/k3/rootfs-overlay/etc/init.d/S99weston
@@ -0,0 +1,44 @@
+#!/bin/sh
+case "$1" in
+start)
+	MODULE_DIR=/lib/modules/6.18.3/kernel/drivers/gpu/drm
+	insmod "$MODULE_DIR/drm_buddy.ko.zst" 2>/dev/null || true
+	insmod "$MODULE_DIR/ttm/ttm.ko.zst" 2>/dev/null || true
+	insmod "$MODULE_DIR/drm_exec.ko.zst" 2>/dev/null || true
+	insmod "$MODULE_DIR/drm_gpuvm.ko.zst" 2>/dev/null || true
+	insmod "$MODULE_DIR/scheduler/gpu-sched.ko.zst" 2>/dev/null || true
+	insmod "$MODULE_DIR/drm_shmem_helper.ko.zst" 2>/dev/null || true
+	insmod "$MODULE_DIR/drm_ttm_helper.ko.zst" 2>/dev/null || true
+	insmod "$MODULE_DIR/imagination/powervr.ko.zst" 2>/dev/null || true
+	mkdir -p /run/weston
+	chmod 0700 /run/weston
+	export XDG_RUNTIME_DIR=/run/weston
+	export PVR_I_WANT_A_BROKEN_VULKAN_DRIVER=1
+	export MESA_LOADER_DRIVER_OVERRIDE=zink
+	export GALLIUM_DRIVER=zink
+	DRM_DEVICE=card1
+	for status in /sys/class/drm/card*-*/status; do
+		[ -e "$status" ] || continue
+		if [ "$(cat "$status" 2>/dev/null)" = connected ]; then
+			DRM_DEVICE=$(basename "$(dirname "$status")" | cut -d- -f1)
+			break
+		fi
+	done
+	/usr/bin/weston --config=/etc/weston.ini --drm-device="$DRM_DEVICE" --renderer=vulkan --idle-time=0 >/var/log/weston.log 2>&1 &
+	echo $! >/run/weston.pid
+	;;
+stop)
+	if [ -f /run/weston.pid ]; then
+		kill "$(cat /run/weston.pid)"
+		rm -f /run/weston.pid
+	fi
+	;;
+restart)
+	"$0" stop
+	"$0" start
+	;;
+*)
+	printf '%s\n' "Usage: $0 {start|stop|restart}"
+	exit 1
+	;;
+esac
