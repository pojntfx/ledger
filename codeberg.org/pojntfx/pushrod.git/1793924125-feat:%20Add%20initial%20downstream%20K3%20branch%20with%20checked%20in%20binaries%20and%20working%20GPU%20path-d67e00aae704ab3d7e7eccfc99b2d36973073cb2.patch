++static void spacemit_parse_table(const char *cmd, void *download_buffer,
++				 u32 download_bytes, char *response)
++{
++	struct spacemit_layout parsed = { 0 };
++	struct mtd_info *mtd = NULL;
++	struct blk_desc *desc = NULL;
++	cJSON *root = NULL;
++	cJSON *partitions;
++	cJSON *entry;
++	char *json = NULL;
++	char *table = NULL;
++	const char *format;
++	u64 capacity;
++	int ret = -EINVAL;
++	unsigned int index = 0;
++
