++static int spacemit_mtd_write(struct spacemit_partition *part, void *buffer,
++			      u32 bytes, bool append, char *response)
++{
++	struct mtd_info *mtd = spacemit_mtd_master();
++	size_t written = 0;
++	u64 offset = append ? part->written : 0;
++	int ret;
++
++	if (!mtd) {
++		fastboot_fail("no MTD device", response);
++		return -ENODEV;
++	}
++	if (offset > part->size || bytes > part->size - offset) {
++		fastboot_fail("image exceeds MTD partition", response);
++		return -EFBIG;
++	}
++	if (!part->erased) {
++		ret = spacemit_mtd_erase(part, response);
++		if (ret)
++			return ret;
++	}
++
++	ret = mtd_write(mtd, part->offset + offset, bytes, &written, buffer);
++	if (ret || written != bytes) {
++		fastboot_fail("failed to write MTD partition", response);
++		return ret ? ret : -EIO;
++	}
++
++	part->written = append ? offset + bytes : 0;
++	fastboot_okay(NULL, response);
++	return 0;
++}
