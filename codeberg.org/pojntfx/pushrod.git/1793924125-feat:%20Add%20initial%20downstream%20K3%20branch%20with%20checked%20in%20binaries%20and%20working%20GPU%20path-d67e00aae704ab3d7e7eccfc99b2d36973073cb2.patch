++static cJSON_bool add_item_to_array(cJSON *array, cJSON *item)
++{
++    cJSON *child = NULL;
++
++    if ((item == NULL) || (array == NULL))
++    {
++        return false;
++    }
++
++    child = array->child;
++
++    if (child == NULL)
++    {
++        /* list is empty, start new one */
++        array->child = item;
++    }
++    else
++    {
++        /* append to the end */
++        while (child->next)
++        {
++            child = child->next;
++        }
