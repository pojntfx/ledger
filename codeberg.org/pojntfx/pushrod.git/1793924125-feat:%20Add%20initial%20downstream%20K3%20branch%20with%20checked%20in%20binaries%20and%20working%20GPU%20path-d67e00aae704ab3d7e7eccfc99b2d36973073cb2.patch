++
++static int spacemit_k3_ufs_wait_mphy_pll_lock(struct ufs_hba *hba)
++{
++	u32 value = 0;
++	int timeout = 10000;
++
++	while (timeout-- > 0) {
++		value = ufshcd_readl(hba, UFS_ARASAN_PHY_MNG_BASE +
++				     UFS_MPHY_PU_CTRL);
++		if (value & UFS_MPHY_PU_PLL_LOCK)
++			return 0;
++		udelay(1);
++	}
++
++	dev_err(hba->dev, "M-PHY PLL lock timeout: 0x%08x\n", value);
++
++	return -ETIMEDOUT;
++}
++
++static void spacemit_k3_ufs_phy_shutdown(struct ufs_hba *hba)
++{
++	ufshcd_writel(hba, 0, UFS_ARASAN_PHY_MNG_BASE + UFS_DEVICE_IO_CTRL);
++	udelay(20);
++	ufshcd_writel(hba, 0, UFS_ARASAN_PHY_MNG_BASE + UFS_MPHY_RST_CTRL);
++	udelay(20);
++	ufshcd_writel(hba, 0, UFS_ARASAN_PHY_MNG_BASE + UFS_MPHY_PU_CTRL);
++	udelay(20);
++}
++
++static int spacemit_k3_ufs_mphy_init(struct ufs_hba *hba)
++{
++	int ret;
++
++	ufshcd_writel(hba, 0x003, UFS_ARASAN_PHY_MNG_BASE + UFS_MPHY_RST_CTRL);
++	mdelay(1);
++	ufshcd_writel(hba, 0x87f, UFS_ARASAN_PHY_MNG_BASE + UFS_MPHY_PU_CTRL);
++	mdelay(1);
++	ufshcd_writel(hba, 0xb7f, UFS_ARASAN_PHY_MNG_BASE + UFS_MPHY_PU_CTRL);
++	mdelay(1);
++	ufshcd_writel(hba, 0x87f, UFS_ARASAN_PHY_MNG_BASE + UFS_MPHY_PU_CTRL);
++	mdelay(1);
++	ufshcd_writel(hba, 0x101, UFS_ARASAN_PHY_MNG_BASE + UFS_DEVICE_IO_CTRL);
++	mdelay(1);
++
++	ret = spacemit_k3_ufs_wait_mphy_pll_lock(hba);
++	if (ret)
++		return ret;
++
++	ufshcd_writel(hba, 1, UFS_ARASAN_PHY_MNG_BASE + UFS_MPHY_BKDR_CTRL);
++	udelay(20);
++	ufshcd_writel(hba, 0, UFS_ARASAN_TOP_BASE +
++		      (ANA_HSGEAR_CTRL_ATTR << 2));
++	ufshcd_writel(hba, 0, UFS_ARASAN_TOP_BASE + (0xc2 << 2));
++	udelay(20);
++	ufshcd_writel(hba, 0, UFS_ARASAN_PHY_MNG_BASE + UFS_MPHY_BKDR_CTRL);
++	udelay(20);
++	mdelay(5);
++
++	return 0;
++}
++
++static int spacemit_k3_ufs_unipro_init(struct ufs_hba *hba)
++{
++	u32 sys1clk_1us;
++	u32 tx_symbol_clk_ns_us;
++	u32 reg_val;
++	int ret;
++	int i;
++
++	for (i = 0; i < ARRAY_SIZE(spacemit_k3_ufs_attrs); i++) {
++		ret = ufshcd_dme_set(hba, spacemit_k3_ufs_attrs[i].attr,
++				     spacemit_k3_ufs_attrs[i].value);
++		if (ret)
++			dev_warn(hba->dev, "failed to set UniPro attribute 0x%x: %d\n",
++				 UIC_GET_ATTR_ID(spacemit_k3_ufs_attrs[i].attr), ret);
++	}
++
++	ret = spacemit_k3_ufs_get_sys1clk_1us(hba, &sys1clk_1us);
++	if (ret) {
++		dev_err(hba->dev, "failed to derive SYS1CLK_1US: %d\n", ret);
++		return ret;
++	}
++
++	ufshcd_writel(hba, sys1clk_1us, UFS_SYS1CLK_1US_REG);
++
++	tx_symbol_clk_ns_us = DIV_ROUND_CLOSEST(1000U, sys1clk_1us);
++	if (!tx_symbol_clk_ns_us)
++		tx_symbol_clk_ns_us = 1;
++	ufshcd_writel(hba, tx_symbol_clk_ns_us << 10,
++		      UFS_TX_SYMBOL_CLK_NS_US_REG);
++
++	reg_val = sys1clk_1us * 100000;
++	reg_val &= ~0xfU;
++	ufshcd_writel(hba, reg_val, UFS_PA_LINK_STARTUP_TIMER_REG);
++	mdelay(5);
++
++	return 0;
++}
++
++static int spacemit_k3_ufs_device_reset(struct ufs_hba *hba)
++{
++	ufshcd_writel(hba, CONTROLLER_DISABLE, REG_CONTROLLER_ENABLE);
++	mdelay(10);
++	spacemit_k3_ufs_phy_shutdown(hba);
++
++	return 0;
++}
++
++void spacemit_k3_ufs_prepare_boot(struct udevice *dev)
++{
++	struct ufs_hba *hba = dev_get_uclass_priv(dev);
++	struct spacemit_k3_ufs_priv *priv = dev_get_priv(dev);
++
++	ufshcd_writel(hba, CONTROLLER_DISABLE, REG_CONTROLLER_ENABLE);
++	mdelay(100);
++	spacemit_k3_ufs_phy_shutdown(hba);
++	reset_assert(&priv->reset);
++}
++
++static int spacemit_k3_ufs_hce_enable_notify(struct ufs_hba *hba,
++					     enum ufs_notify_change_status status)
++{
++	int ret;
++
++	if (status == PRE_CHANGE)
++		return 0;
++
++	ret = spacemit_k3_ufs_mphy_init(hba);
++	if (ret)
++		return ret;
++
++	ret = spacemit_k3_ufs_unipro_init(hba);
++	if (ret)
++		return ret;
++
++	ufshcd_writel(hba, 0, REG_AUTO_HIBERNATE_IDLE_TIMER);
++
++	return 0;
++}
++
++static int spacemit_k3_ufs_link_startup_notify(struct ufs_hba *hba,
++					       enum ufs_notify_change_status status)
++{
++	u32 reg_val;
++
++	if (status == PRE_CHANGE)
++		return 0;
++
++	reg_val = ufshcd_readl(hba, REG_CONTROLLER_STATUS);
++	if (!(reg_val & DEVICE_PRESENT)) {
++		dev_err(hba->dev, "UFS device is not present: 0x%x\n", reg_val);
++		return -ENODEV;
++	}
++
++	reg_val = ufshcd_readl(hba, REG_INTERRUPT_STATUS);
++	if (reg_val & (UIC_LINK_STARTUP | UIC_ERROR))
++		ufshcd_writel(hba, reg_val & (UIC_LINK_STARTUP | UIC_ERROR),
++			      REG_INTERRUPT_STATUS);
++
++	ufshcd_readl(hba, REG_UIC_ERROR_CODE_PHY_ADAPTER_LAYER);
++	mdelay(5);
++	ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(SPACEMIT_K3_UFS_TX_TIMING_ATTR,
++					  UIC_ARG_MPHY_TX_GEN_SEL_INDEX(0)), 0x97);
++	mdelay(1);
++	ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(SPACEMIT_K3_UFS_TX_TIMING_ATTR,
++					  UIC_ARG_MPHY_TX_GEN_SEL_INDEX(0)), 0xd7);
++	mdelay(1);
++	ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(SPACEMIT_K3_UFS_TX_TIMING_ATTR,
++					  UIC_ARG_MPHY_TX_GEN_SEL_INDEX(0)), 0x17);
++
++	ufshcd_dme_set(hba, UIC_ARG_MIB(DL_AFC0REQTIMEOUTVAL),
++		       UFS_DL_AFC0REQTIMEOUTVAL_MAX);
++	mdelay(5);
++	ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(TX_LCC_ENABLE,
++					  UIC_ARG_MPHY_TX_GEN_SEL_INDEX(0)), 0);
++	mdelay(1);
++	ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(TX_LCC_ENABLE,
++					  UIC_ARG_MPHY_TX_GEN_SEL_INDEX(1)), 0);
++	mdelay(1);
++	ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(TX_MIN_ACTIVATETIME,
++					  UIC_ARG_MPHY_TX_GEN_SEL_INDEX(0)), 0);
++	mdelay(1);
++	ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(TX_MIN_ACTIVATETIME,
++					  UIC_ARG_MPHY_TX_GEN_SEL_INDEX(1)), 0);
++	mdelay(10);
++	ufshcd_dme_set(hba, UIC_ARG_MIB(ANA_HSGEAR_CTRL_ATTR), 0x25);
++	mdelay(10);
++
++	return spacemit_k3_ufs_wait_mphy_pll_lock(hba);
++}
++
++static int spacemit_k3_ufs_init(struct ufs_hba *hba)
++{
++	hba->quirks |= UFSHCD_QUIRK_BROKEN_LCC;
++
++	return 0;
++}
++
++static const struct ufs_hba_ops spacemit_k3_ufs_ops = {
++	.init = spacemit_k3_ufs_init,
++	.hce_enable_notify = spacemit_k3_ufs_hce_enable_notify,
++	.link_startup_notify = spacemit_k3_ufs_link_startup_notify,
++	.device_reset = spacemit_k3_ufs_device_reset,
++};
++
++static int spacemit_k3_ufs_of_to_plat(struct udevice *dev)
++{
++	struct spacemit_k3_ufs_priv *priv = dev_get_priv(dev);
++	int ret;
++
++	ret = clk_get_by_name(dev, "refclk", &priv->refclk);
++	if (ret == -ENODATA || ret == -ENOENT || ret == -ENOSYS) {
++		memset(&priv->refclk, 0, sizeof(priv->refclk));
++	} else if (ret) {
++		dev_err(dev, "failed to get UFS reference clock: %d\n", ret);
++		return ret;
++	}
++
++	priv->clock_freq_hz = dev_read_u32_default(dev, "clock-freq", 0);
++
++	ret = clk_get_by_name(dev, "aclk", &priv->aclk);
++	if (ret)
++		ret = clk_get_by_index(dev, 0, &priv->aclk);
++	if (ret) {
++		dev_err(dev, "failed to get UFS ACLK: %d\n", ret);
++		return ret;
++	}
++
++	ret = reset_get_by_name(dev, "aclk_reset", &priv->reset);
++	if (ret)
++		ret = reset_get_by_index(dev, 0, &priv->reset);
++	if (ret) {
++		dev_err(dev, "failed to get UFS reset: %d\n", ret);
++		return ret;
++	}
++
++	return 0;
++}
++
++static int spacemit_k3_ufs_probe(struct udevice *dev)
++{
++	struct spacemit_k3_ufs_priv *priv = dev_get_priv(dev);
++	struct ufs_hba *hba = dev_get_uclass_priv(dev);
++	struct ufs_hba_ops *ops = (struct ufs_hba_ops *)dev_get_driver_data(dev);
++	int retries = 3;
++	int ret;
++
++	ret = spacemit_k3_ufs_clk_enable(dev);
++	if (ret)
++		return ret;
++
++	hba->dev = dev;
++	hba->ops = ops;
++	hba->mmio_base = (void *)dev_read_addr(dev);
++	spacemit_k3_ufs_device_reset(hba);
++
++	do {
++		ret = ufshcd_probe(dev, ops);
++		if (!ret)
++			return 0;
++		spacemit_k3_ufs_device_reset(hba);
++	} while (--retries);
++
++	spacemit_k3_ufs_phy_shutdown(hba);
++	spacemit_k3_ufs_clk_disable(priv);
++	dev_err(dev, "UFS host probe failed: %d\n", ret);
++
++	return ret;
++}
++
++static int spacemit_k3_ufs_remove(struct udevice *dev)
++{
++	struct spacemit_k3_ufs_priv *priv = dev_get_priv(dev);
++
++	spacemit_k3_ufs_clk_disable(priv);
++
++	return 0;
++}
++
++static const struct udevice_id spacemit_k3_ufs_ids[] = {
++	{
++		.compatible = "spacemit,k3-ufshci",
++		.data = (ulong)&spacemit_k3_ufs_ops,
++	},
++	{}
++};
++
++U_BOOT_DRIVER(spacemit_k3_ufs) = {
++	.name = "ufs-spacemit-k3",
++	.id = UCLASS_UFS,
++	.of_match = spacemit_k3_ufs_ids,
++	.of_to_plat = spacemit_k3_ufs_of_to_plat,
++	.probe = spacemit_k3_ufs_probe,
++	.remove = spacemit_k3_ufs_remove,
++	.priv_auto = sizeof(struct spacemit_k3_ufs_priv),
++};
