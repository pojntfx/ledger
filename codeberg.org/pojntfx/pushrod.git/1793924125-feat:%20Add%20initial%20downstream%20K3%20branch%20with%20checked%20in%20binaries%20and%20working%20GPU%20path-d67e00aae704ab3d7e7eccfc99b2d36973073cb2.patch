++
++        case cJSON_False:
++            output = ensure(output_buffer, 6);
++            if (output == NULL)
++            {
++                return false;
++            }
++            strcpy((char*)output, "false");
++            return true;
++
++        case cJSON_True:
++            output = ensure(output_buffer, 5);
++            if (output == NULL)
++            {
++                return false;
++            }
++            strcpy((char*)output, "true");
++            return true;
