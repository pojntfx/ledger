++static int spacemit_parse_size(const char *text, u64 capacity, u64 offset,
++			       u64 *value)
++{
++	u64 number;
++	u64 multiplier = 1;
++	char *end;
++
++	if (!text || !*text)
++		return -EINVAL;
++
++	if (!strcmp(text, "-")) {
++		if (offset > capacity)
++			return -EINVAL;
++		*value = capacity - offset;
++		return 0;
++	}
++
++	number = simple_strtoull(text, &end, 10);
++	if (end == text)
++		return -EINVAL;
++
++	switch (*end) {
++	case 'k':
++	case 'K':
++		multiplier = SZ_1K;
++		end++;
++		break;
++	case 'm':
++	case 'M':
++		multiplier = SZ_1M;
++		end++;
++		break;
++	case 'g':
++	case 'G':
++		multiplier = SZ_1G;
++		end++;
++		break;
++	case '\0':
++		break;
++	default:
++		return -EINVAL;
++	}
++
++	if (*end == 'i')
++		end++;
++	if (*end == 'B')
++		end++;
++	if (*end || (number && multiplier > U64_MAX / number))
++		return -EINVAL;
++
++	*value = number * multiplier;
++	return 0;
++}
