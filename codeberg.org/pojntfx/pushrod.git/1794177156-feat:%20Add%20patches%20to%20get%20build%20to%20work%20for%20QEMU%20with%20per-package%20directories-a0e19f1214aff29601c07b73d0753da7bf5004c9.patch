diff --git a/buildroot/scripts/verify-ccache.sh b/buildroot/scripts/verify-ccache.sh
new file mode 100755
index 0000000000000000000000000000000000000000..5255ce8d975207d983af400764cf88524f8aa9f8
--- /dev/null
+++ b/buildroot/scripts/verify-ccache.sh
@@ -0,0 +1,27 @@
+#!/bin/sh
+set -eu
+
+root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+cache="$root/ccache"
+ccache_bin="$root/output/rva23/per-package/host-gcc-final/host/bin/ccache"
+token=$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')
+
+probe() {
+	tree=$1
+	dir="$root/output/$tree/ccache-probe"
+	compiler="$root/output/$tree/per-package/host-gcc-final/host/bin/riscv64-buildroot-linux-gnu-gcc"
+	mkdir -p "$dir"
+	printf 'int probe_%s(void){return 42;}\n' "$token" > "$dir/probe.c"
+	(
+		cd "$dir" || exit 1
+		BR2_USE_CCACHE=1 CCACHE_DIR="$cache" "$compiler" -O2 -c probe.c -o probe.o
+	)
+}
+
+CCACHE_DIR="$cache" "$ccache_bin" -z >/dev/null
+probe rva23
+probe k3-uefi
+hits=$(CCACHE_DIR="$cache" "$ccache_bin" -s | awk '/^ +Hits:/{print $2; exit}')
+misses=$(CCACHE_DIR="$cache" "$ccache_bin" -s | awk '/^ +Misses:/{print $2; exit}')
+printf 'hits=%s misses=%s\n' "$hits" "$misses"
+[ "$hits" = 1 ] && [ "$misses" = 1 ]

