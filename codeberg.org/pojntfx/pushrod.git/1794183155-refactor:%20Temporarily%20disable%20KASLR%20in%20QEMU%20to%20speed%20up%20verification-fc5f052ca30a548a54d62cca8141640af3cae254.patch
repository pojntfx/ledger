From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Sun, 08 Nov 2026 17:12:35 -0700
Subject: [PATCH] refactor: Temporarily disable KASLR in QEMU to speed up verification
---
diff --git a/buildroot/scripts/build-os-images.py b/buildroot/scripts/build-os-images.py
index 49447cab0a8101263de20078a61c88cf2fc955d7..bf839d7a27b2f897871816e2868a17fcf656c4b6 100755
--- a/buildroot/scripts/build-os-images.py
+++ b/buildroot/scripts/build-os-images.py
@@ -164,7 +164,7 @@     linux = binaries / "efi-part/EFI/Linux"
     linux.mkdir(parents=True, exist_ok=True)
     for old in linux.glob("*.efi"):
         old.unlink()
-    base = f"console=ttyS0,115200 earlycon=sbi root=dissect mount.usr=dissect usrhash={root_hash} rw"
+    base = f"console=ttyS0,115200 earlycon=sbi root=dissect mount.usr=dissect usrhash={root_hash} rw nokaslr"
     device_timeout = os.environ.get("RVA23_BOOT_DEVICE_TIMEOUT", "300")
     if device_timeout:
         if not device_timeout.isdigit() or int(device_timeout) < 90:

