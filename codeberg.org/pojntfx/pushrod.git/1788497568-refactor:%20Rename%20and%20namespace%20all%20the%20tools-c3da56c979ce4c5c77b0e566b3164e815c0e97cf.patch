+	Relays []RelayStatus `json:"relays" jsonschema:"statuses of the board's relays"`
 }
 
 func (s *Service) relayOn(state byte, n uint) (bool, time.Duration) {
@@ -50,7 +50,7 @@
 	return report[len(report)-1], nil // Last byte of the report is the bitmask
 }
 
-func (s *Service) GetRelaysStatus(ctx context.Context, req *mcp.CallToolRequest, input GetRelaysStatusInput) (*mcp.CallToolResult, *GetRelaysStatusOutput, error) {
+func (s *Service) GetStatuses(ctx context.Context, req *mcp.CallToolRequest, input GetStatusesInput) (*mcp.CallToolResult, *GetStatusesOutput, error) {
 	device, err := usbhid.Get(func(d *usbhid.Device) bool {
 		return isBoardRelay(d) && d.Path() == input.Path
 	}, true, false)
@@ -75,7 +75,7 @@ 			RemainingOnRelayCycleDuration: remainingOnRelayCycleDuration,
 		}
 	}
 
-	return nil, &GetRelaysStatusOutput{
+	return nil, &GetStatusesOutput{
 		Relays: relays,
 	}, nil
 }
