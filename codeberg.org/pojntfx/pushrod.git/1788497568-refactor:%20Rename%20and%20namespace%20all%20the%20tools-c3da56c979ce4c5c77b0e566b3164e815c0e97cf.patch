+	mcp.AddTool(handler, relay.EnterFDLTool, service.EnterFDL)
 	mcp.AddTool(handler, relay.ResetTool, service.Reset)
 
 	log.Println("Listening on", *laddr)
diff --git a/pkg/relay/get_connected_boards.go b/pkg/relay/get_boards.go
rename from pkg/relay/get_connected_boards.go
rename to pkg/relay/get_boards.go
index c6ae260e94a6484f55581335bc4a10698d5df9d8..2d38bb31a80522128079532179f6bf6745c0d9bb 100644
--- a/pkg/relay/get_connected_boards.go
+++ b/pkg/relay/get_boards.go
@@ -9,10 +9,10 @@ 	"rafaelmartins.com/p/usbhid"
 )
 
 var (
-	GetConnectedBoardsTool = &mcp.Tool{
-		Name:        "getConnectedBoards",
-		Title:       "Get connected boards",
-		Description: "Get all currently connected boards",
+	GetBoardsTool = &mcp.Tool{
+		Name:        "relay.getBoards",
+		Title:       "Get relay boards",
+		Description: "Get all currently connected relay boards",
 	}
 )
 
@@ -23,15 +23,15 @@ 	TotalRelayCycleDuration time.Duration `json:"totalRelayCycleDuration" jsonschema:"cycle duration after which the relay on time resets"`
 	OnRelayCycleDuration    time.Duration `json:"onRelayCycleDuration" jsonschema:"how long a relay can be on during the total cycle"`
 }
 
-type GetConnectedBoardsOutput struct {
-	Boards []Board `json:"devices" jsonschema:"connected boards"`
+type GetBoardsOutput struct {
+	Boards []Board `json:"boards" jsonschema:"connected relay boards"`
 }
 
 func isBoardRelay(d *usbhid.Device) bool {
 	return d.VendorId() == USB_RELAY_4_VENDOR_ID && d.ProductId() == USB_RELAY_4_PRODUCT_ID
 }
 
-func (s *Service) GetConnectedBoards(ctx context.Context, req *mcp.CallToolRequest, input struct{}) (*mcp.CallToolResult, *GetConnectedBoardsOutput, error) {
+func (s *Service) GetBoards(ctx context.Context, req *mcp.CallToolRequest, input struct{}) (*mcp.CallToolResult, *GetBoardsOutput, error) {
 	devices, err := usbhid.Enumerate(isBoardRelay)
 	if err != nil {
 		return nil, nil, err
@@ -47,7 +47,7 @@ 			OnRelayCycleDuration:    s.onRelayCycleDuration,
 		}
 	}
 
-	return nil, &GetConnectedBoardsOutput{
+	return nil, &GetBoardsOutput{
 		Boards: boards,
 	}, nil
 }
