+BR2_PACKAGE_OPENSC=y
+BR2_PACKAGE_CCID=y
+BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
+BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RVA23_QEMU_PATH)/board/rva23-qemu/rootfs-overlay"
+BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_RVA23_QEMU_PATH)/scripts/prepare-target.py"
