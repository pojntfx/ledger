+name: RVA23_QEMU
+desc: RVA23 QEMU support
diff --git a/buildroot/qemu/external.mk b/buildroot/qemu/external.mk
new file mode 100644
index 0000000000000000000000000000000000000000..f90afd71b945e682a23589c01b7d82d8307f4591
--- /dev/null
+++ b/buildroot/qemu/external.mk
@@ -0,0 +1,29 @@
+define RVA23_APPLY_UBOOT_PATCHES
+	for patch in $(BR2_EXTERNAL_RVA23_QEMU_PATH)/patches/uboot/*.patch; do \
+		patch -p1 -d $(@D) < "$$patch" || exit 1; \
+	done
+endef
+UBOOT_POST_RSYNC_HOOKS += RVA23_APPLY_UBOOT_PATCHES
+
+include $(BR2_EXTERNAL_RVA23_QEMU_PATH)/package/sbsigntools/sbsigntools.mk
+include $(BR2_EXTERNAL_RVA23_QEMU_PATH)/package/tpm2-tss/tpm2-tss.mk
+include $(BR2_EXTERNAL_RVA23_QEMU_PATH)/package/k3s/k3s.mk
+
+define RVA23_PROVISION_EDK2_KEYS
+	$(HOST_DIR)/bin/python3 $(BR2_EXTERNAL_RVA23_QEMU_PATH)/scripts/provision-keys.py $(RVA23_KEY_DIR) $(@D)
+	$(HOST_DIR)/bin/python3 $(BR2_EXTERNAL_RVA23_QEMU_PATH)/scripts/provision-edk2.py $(@D)
+endef
+EDK2_PRE_BUILD_HOOKS += RVA23_PROVISION_EDK2_KEYS
+
+define RVA23_PROVISION_LINUX_KEYS
+	$(HOST_DIR)/bin/python3 $(BR2_EXTERNAL_RVA23_QEMU_PATH)/scripts/provision-keys.py $(RVA23_KEY_DIR)
+	$(@D)/scripts/config --file $(@D)/.config --set-str SYSTEM_TRUSTED_KEYS "$(RVA23_KEY_DIR)/trusted.pem"
+	$(@D)/scripts/config --file $(@D)/.config --set-str IPE_BOOT_POLICY "$(BR2_EXTERNAL_RVA23_QEMU_PATH)/board/rva23-qemu/ipe-boot.policy"
+endef
+LINUX_PRE_BUILD_HOOKS += RVA23_PROVISION_LINUX_KEYS
+
+SYSTEMD_CONF_OPTS += -Dsysupdated=enabled
+HOST_SYSTEMD_CONF_OPTS += -Dsysupdate=enabled -Dsysupdated=enabled -Dimportd=enabled -Dfdisk=enabled -Dlibcurl=enabled -Dopenssl=enabled -Dtpm2=enabled -Dzlib=enabled -Dxz=enabled -Defi=true -Dbootloader=enabled -Dblkid=enabled
+HOST_SYSTEMD_DEPENDENCIES += host-libcurl host-openssl host-tpm2-tss
+HOST_LIBCURL_CONF_OPTS += --without-brotli
+HOST_QEMU_OPTS += --enable-u2f --enable-smartcard
