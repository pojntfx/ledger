+source "$BR2_EXTERNAL_RVA23_QEMU_PATH/package/sbsigntools/Config.in.host"
+source "$BR2_EXTERNAL_RVA23_QEMU_PATH/package/tpm2-tss/Config.in.host"
+source "$BR2_EXTERNAL_RVA23_QEMU_PATH/package/k3s/Config.in"
diff --git a/buildroot/qemu/Makefile b/buildroot/qemu/Makefile
new file mode 100644
index 0000000000000000000000000000000000000000..142f3f3ffa5fdce4b63e6b4e1dcfc1a085e627d4
--- /dev/null
+++ b/buildroot/qemu/Makefile
@@ -0,0 +1,77 @@
+.SUFFIXES:
+
+THIS_EXTERNAL_PATH := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
+-include $(THIS_EXTERNAL_PATH)/local.mk
+BUILDROOT_DIR ?= $(abspath $(THIS_EXTERNAL_PATH)/../buildroot-k3-clean/buildroot)
+OUTPUT_DIR ?= $(THIS_EXTERNAL_PATH)/output/rva23
+BR2_DL_DIR ?= $(abspath $(THIS_EXTERNAL_PATH)/../buildroot-k3-clean/buildroot/dl)
+BR2_CCACHE_DIR ?= $(abspath $(THIS_EXTERNAL_PATH)/../buildroot-k3-clean/ccache)
+RVA23_KEY_DIR ?= $(abspath $(THIS_EXTERNAL_PATH)/../buildroot-qemu-keys)
+export RVA23_TPM_STATE := $(OUTPUT_DIR)/swtpm
+
+MAKE_BUILDROOT = $(MAKE) -C $(BUILDROOT_DIR) O=$(OUTPUT_DIR) BR2_EXTERNAL=$(THIS_EXTERNAL_PATH) BR2_DL_DIR=$(BR2_DL_DIR) BR2_CCACHE_DIR=$(BR2_CCACHE_DIR) UBOOT_OVERRIDE_SRCDIR=$(UBOOT_OVERRIDE_SRCDIR) RVA23_KEY_DIR=$(RVA23_KEY_DIR)
+BUILDROOT_PATCHES = $(sort $(wildcard $(THIS_EXTERNAL_PATH)/patches/buildroot/*.patch))
+
+.PHONY: all configure build clean registry verify verify-image verify-boot verify-firmware verify-attestation verify-report verify-update verify-security verify-hardening verify-podman verify-k3s verify-attested-app verify-wallet boot boot-display boot-firmware
+
+all: build
+
+configure:
+	for patch in $(BUILDROOT_PATCHES); do git -C $(BUILDROOT_DIR) apply --reverse --check "$$patch" || exit 1; done
+	$(MAKE_BUILDROOT) rva23_defconfig
+
+build: configure
+	$(MAKE_BUILDROOT)
+
+clean:
+	$(MAKE_BUILDROOT) clean
+
+verify-image: build
+	python3 scripts/verify-image.py $(OUTPUT_DIR) $(BR2_DL_DIR) $(BR2_CCACHE_DIR) $(RVA23_KEY_DIR)
+
+verify-boot: build
+	python3 scripts/verify-boot.py $(OUTPUT_DIR)
+
+verify-firmware: build
+	python3 scripts/verify-firmware.py $(OUTPUT_DIR)
+
+registry: build
+	python3 scripts/build-registry.py $(OUTPUT_DIR) $(RVA23_KEY_DIR) 2
+
+verify-attestation: build
+	python3 scripts/verify-attestation.py $(OUTPUT_DIR) $(RVA23_KEY_DIR)
+
+verify-update: registry
+	python3 scripts/verify-update.py $(OUTPUT_DIR) $(RVA23_KEY_DIR)
+
+verify-security: build
+	python3 scripts/verify-security.py $(OUTPUT_DIR) $(RVA23_KEY_DIR)
+
+verify-hardening: build
+	python3 scripts/verify-hardening.py $(OUTPUT_DIR)
+
+verify-podman: build
+	python3 scripts/verify-podman.py $(OUTPUT_DIR)
+
+verify-k3s: build
+	python3 scripts/verify-k3s.py $(OUTPUT_DIR)
+
+verify-report: verify-attestation
+	python3 scripts/verify-report.py $(OUTPUT_DIR)
+
+verify-attested-app: verify-report
+	python3 scripts/verify-attested-app.py $(OUTPUT_DIR)
+
+verify-wallet: verify-attested-app
+	python3 scripts/verify-wallet.py $(OUTPUT_DIR)
+
+verify: verify-image verify-boot verify-firmware verify-security verify-attestation verify-update verify-hardening verify-podman verify-k3s verify-report verify-attested-app verify-wallet
+
+boot: build
+	$(THIS_EXTERNAL_PATH)/board/rva23-qemu/run-qemu.sh $(OUTPUT_DIR)/images
+
+boot-display: build
+	QEMU_VNC=1 $(THIS_EXTERNAL_PATH)/board/rva23-qemu/run-qemu.sh $(OUTPUT_DIR)/images
+
+boot-firmware: build
+	$(THIS_EXTERNAL_PATH)/board/rva23-qemu/run-firmware.sh $(OUTPUT_DIR)/images
