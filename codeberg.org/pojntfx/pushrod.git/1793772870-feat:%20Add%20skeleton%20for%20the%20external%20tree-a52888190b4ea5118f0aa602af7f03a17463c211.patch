+BR2_PACKAGE_COREUTILS=y
+BR2_PACKAGE_SYSTEMD_BOOT=y
+BR2_PACKAGE_SYSTEMD_COREDUMP=y
+BR2_PACKAGE_SYSTEMD_INITRD=y
+BR2_PACKAGE_SYSTEMD_IMPORTD=y
+BR2_PACKAGE_SYSTEMD_REPART=y
+BR2_PACKAGE_SYSTEMD_SYSEXT=y
+BR2_PACKAGE_SYSTEMD_SYSUPDATE=y
+BR2_PACKAGE_SYSTEMD_SYSUSERS=y
+BR2_PACKAGE_TPM2_TOOLS=y
+BR2_PACKAGE_HOST_TPM2_TSS=y
+BR2_PACKAGE_UTIL_LINUX_BINARIES=y
+BR2_TARGET_ROOTFS_CPIO=y
+BR2_TARGET_ROOTFS_CPIO_DRACUT=y
+BR2_TARGET_ROOTFS_CPIO_DRACUT_MODULES="$(BR2_EXTERNAL_RVA23_QEMU_PATH)/board/rva23-qemu/dracut"
