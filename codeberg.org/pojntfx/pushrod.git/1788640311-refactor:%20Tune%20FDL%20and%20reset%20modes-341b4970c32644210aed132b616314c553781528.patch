--- a/pkg/svc/target_enter_fdl.go
+++ b/pkg/svc/target_enter_fdl.go
@@ -63,7 +63,7 @@ 	}); err != nil {
 		return nil, nil, err
 	}
 
-	time.Sleep(time.Millisecond * 500)
+	time.Sleep(time.Millisecond * 150)
 
 	// Press the FDL and RST button
 	if err := s.setStatusesLocked(device, []SetRelayStatus{
@@ -79,7 +79,23 @@ 	}); err != nil {
 		return nil, nil, err
 	}
 
-	time.Sleep(time.Millisecond * 500)
+	time.Sleep(time.Millisecond * 150)
+
+	// Release the RST button but not the FDL button
+	if err := s.setStatusesLocked(device, []SetRelayStatus{
+		{
+			Relay: 1,
+			On:    true,
+		},
+		{
+			Relay: 2,
+			On:    false,
+		},
+	}); err != nil {
+		return nil, nil, err
+	}
+
+	time.Sleep(time.Millisecond * 150)
 
 	// Release the RST and FDL buttons
 	if err := s.setStatusesLocked(device, []SetRelayStatus{
