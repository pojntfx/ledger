+++static void spacemit_sw_rx_set_delaycode(struct sdhci_host *host, u32 delay)
+++{
+++	spacemit_sdhci_clrsetbits(host, SDHC_RX_DLINE_CODE,
+++				  FIELD_PREP(SDHC_RX_DLINE_CODE, delay),
+++				  SPACEMIT_SDHC_DLINE_CTRL_REG);
+++}
