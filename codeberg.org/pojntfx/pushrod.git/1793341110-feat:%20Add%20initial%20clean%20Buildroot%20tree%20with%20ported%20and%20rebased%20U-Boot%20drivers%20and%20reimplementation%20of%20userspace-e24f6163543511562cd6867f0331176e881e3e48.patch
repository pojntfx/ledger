+++	tx_symbol_clk_ns_us = DIV_ROUND_CLOSEST(1000U, sys1clk_1us);
+++	if (!tx_symbol_clk_ns_us)
+++		tx_symbol_clk_ns_us = 1;
+++	ufshcd_writel(hba, tx_symbol_clk_ns_us << 10,
