+++    {
+++        /* parse digit */
+++        if ((input[i] >= '0') && (input[i] <= '9'))
+++        {
+++            h += (unsigned int) input[i] - '0';
+++        }
+++        else if ((input[i] >= 'A') && (input[i] <= 'F'))
+++        {
+++            h += (unsigned int) 10 + input[i] - 'A';
+++        }
+++        else if ((input[i] >= 'a') && (input[i] <= 'f'))
+++        {
+++            h += (unsigned int) 10 + input[i] - 'a';
+++        }
+++        else /* invalid */
+++        {
+++            return 0;
+++        }
