+++	ret = spacemit_k3_ufs_wait_mphy_pll_lock(hba);
+++	if (ret)
+++		return ret;
+++
+++	ufshcd_writel(hba, 1, UFS_ARASAN_PHY_MNG_BASE + UFS_MPHY_BKDR_CTRL);
