 	"cmp"
 	"context"
 	"errors"
-	"log/slog"
 	"slices"
 	"time"
 
@@ -67,14 +66,14 @@ 				}
 
 				device, err := s.openBoard(path)
 				if err != nil {
-					slog.Error("Could not open device to power off relay, giving up", "err", err)
+					s.log.Error("Could not open device to power off relay, giving up", "err", err)
 
 					return
 				}
 				defer device.Close()
 
-				if err := relay.PowerOffWithRetry(device, time.Second, 5, slog.Default()); err != nil {
