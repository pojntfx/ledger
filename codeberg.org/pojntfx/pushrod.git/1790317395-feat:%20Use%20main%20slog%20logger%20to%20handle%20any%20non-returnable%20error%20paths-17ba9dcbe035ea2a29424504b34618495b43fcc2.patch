Subject: [PATCH] feat: Use main slog logger to handle any non-returnable error paths
---
diff --git a/main.go b/main.go
index 34cb8709167237b982b5070204b5589944d269dd..338cbfb40a03ed868b05fb31a215f20fd6f46b4f 100644
--- a/main.go
+++ b/main.go
@@ -5,6 +5,7 @@ 	"context"
 	"errors"
 	"flag"
 	"log"
+	"log/slog"
 	"net"
 	"net/http"
 	"os"
@@ -26,7 +27,7 @@
 	ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
 	defer cancel()
 
-	service := svc.NewService(ctx, time.Second*10, time.Minute, time.Second*5)
+	service := svc.NewService(ctx, logger, time.Second*10, time.Minute, time.Second*5)
 
 	handler := mcp.NewServer(
 		&mcp.Implementation{
diff --git a/pkg/svc/kvm_get_video_capture_devices.go b/pkg/svc/kvm_get_video_capture_devices.go
index 51329e1937ee8561eaf29d2734ae5981693cce55..495959f3048e3ac2d7dbbcccfc4d1b870c865983 100644
--- a/pkg/svc/kvm_get_video_capture_devices.go
+++ b/pkg/svc/kvm_get_video_capture_devices.go
@@ -3,7 +3,6 @@
 import (
 	"context"
 	"errors"
-	"log/slog"
 	"os"
 	"path/filepath"
 	"strings"
@@ -126,7 +125,7 @@ 		USBIdentity: identity,
 	}, true, nil
 }
 
-func listVideoCaptureDevices() ([]VideoCaptureDevice, error) {
+func (s *Service) listVideoCaptureDevices() ([]VideoCaptureDevice, error) {
 	paths, err := filepath.Glob(videoDeviceGlob)
 	if err != nil {
 		return nil, err
@@ -136,7 +135,7 @@ 	videoCaptureDevices := []VideoCaptureDevice{}
 	for _, path := range paths {
 		videoCaptureDevice, ok, err := videoCaptureDeviceAt(path)
 		if err != nil {
-			slog.Error("Could not get video capture device, skipping", "path", path, "err", err)
+			s.log.Error("Could not get video capture device, skipping", "path", path, "err", err)
 
 			continue
 		}
@@ -165,7 +164,7 @@ 	return &videoCaptureDevice, nil
 }
 
 func (s *Service) GetVideoCaptureDevices(ctx context.Context, req *mcp.CallToolRequest, input struct{}) (*mcp.CallToolResult, *GetVideoCaptureDevicesOutput, error) {
-	videoCaptureDevices, err := listVideoCaptureDevices()
+	videoCaptureDevices, err := s.listVideoCaptureDevices()
 	if err != nil {
 		return nil, nil, err
 	}
diff --git a/pkg/svc/relay_set_statuses.go b/pkg/svc/relay_set_statuses.go
index 33738104ed4f997981d5d4d1a1b59a571bbd6091..1564ac88f862d4e501aa8cfedfea56e78289fc74 100644
