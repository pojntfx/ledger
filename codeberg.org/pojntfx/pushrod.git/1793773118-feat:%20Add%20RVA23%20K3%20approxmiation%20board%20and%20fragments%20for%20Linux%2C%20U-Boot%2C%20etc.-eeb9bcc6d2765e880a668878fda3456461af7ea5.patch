diff --git a/buildroot/qemu/board/rva23-qemu/uboot.fragment b/buildroot/qemu/board/rva23-qemu/uboot.fragment
new file mode 100644
index 0000000000000000000000000000000000000000..4f96c41c9520cc909cdbc7e1a4dcd0660c285805
--- /dev/null
+++ b/buildroot/qemu/board/rva23-qemu/uboot.fragment
@@ -0,0 +1,29 @@
+CONFIG_SPL_LOAD_FIT=y
+CONFIG_SPL_OPENSBI=y
+CONFIG_SPL_RISCV_MMODE=y
+CONFIG_SPL_OPENSBI_LOAD_ADDR=0x80100000
+CONFIG_SPL_OPENSBI_SCRATCH_OPTIONS=0x0
+CONFIG_SPL_FIT_SIGNATURE=y
+CONFIG_SPL_FIT_SIGNATURE_MAX_SIZE=0x10000000
+CONFIG_FIT_SIGNATURE_MAX_SIZE=0x10000000
+CONFIG_RSA=y
+CONFIG_RSA_VERIFY=y
+CONFIG_SPL_RSA=y
+CONFIG_SPL_RSA_VERIFY=y
+CONFIG_RSA_SOFTWARE_EXP=y
+CONFIG_SHA256=y
+CONFIG_SPL_SHA256=y
+# CONFIG_SPL_RAW_IMAGE_SUPPORT is not set
+# CONFIG_SPL_LEGACY_IMAGE_FORMAT is not set
+# CONFIG_LEGACY_IMAGE_FORMAT is not set
+# CONFIG_SPL_LOAD_FIT_OPENSBI_OS_BOOT is not set
+CONFIG_TPM=y
+CONFIG_SPL_TPM=y
+CONFIG_TPM_V2=y
+CONFIG_TPM2_MMIO=y
+CONFIG_TPM2_EVENT_LOG_SIZE=1048576
+# CONFIG_TPM_RNG is not set
+CONFIG_SPL_MEASURED_BOOT=y
+CONFIG_SPL_OF_TRANSLATE=y
+CONFIG_MEASURED_BOOT=y
+CONFIG_MEASURE_IGNORE_LOG=y

