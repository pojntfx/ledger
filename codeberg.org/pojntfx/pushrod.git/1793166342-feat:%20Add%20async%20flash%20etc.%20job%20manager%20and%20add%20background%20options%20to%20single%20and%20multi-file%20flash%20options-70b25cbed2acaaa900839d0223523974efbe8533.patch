diff --git a/pkg/svc/flash_jobs.go b/pkg/svc/flash_jobs.go
new file mode 100644
index 0000000000000000000000000000000000000000..48cf9152c11e07d5b6cf6c18f860ea1f7507a97f
--- /dev/null
+++ b/pkg/svc/flash_jobs.go
@@ -0,0 +1,176 @@
+package svc
+
+import (
+	"context"
+	"slices"
+	"time"
+
+	"uuid"
+
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+const flashJobHistorySize = 16
+
+type flashJobState string
+
+const (
+	flashJobQueued    flashJobState = "queued"
+	flashJobRunning   flashJobState = "running"
+	flashJobSucceeded flashJobState = "succeeded"
+	flashJobFailed    flashJobState = "failed"
+)
+
+type flashJob struct {
+	id         string
+	kind       string
+	input      any
+	status     flashJobState
+	err        string
+	partition  string
+	sent       int64
+	totalBytes int64
+	result     any
+	created    time.Time
+	ended      time.Time
+}
+
+type FlashJobStatus struct {
+	ID         string `json:"id" jsonschema:"ID of the job"`
+	Kind       string `json:"kind" jsonschema:"operation that started the job, like flash.flashFile or flash.multiFlash"`
+	Input      any    `json:"input" jsonschema:"original input that started the job"`
+	Status     string `json:"status" jsonschema:"queued, running, succeeded or failed"`
+	Error      string `json:"error,omitempty" jsonschema:"why the job failed, if it did"`
+	Partition  string `json:"partition,omitempty" jsonschema:"partition currently being flashed"`
+	SentBytes  int64  `json:"sentBytes" jsonschema:"uncompressed bytes flashed so far, across the whole job"`
+	TotalBytes int64  `json:"totalBytes" jsonschema:"total uncompressed bytes the job will flash"`
+	Result     any    `json:"result,omitempty" jsonschema:"operation result after success, with the same fields as the synchronous call"`
+	CreatedAt  int64  `json:"createdAt" jsonschema:"when the job was created, in milliseconds since the epoch"`
+	DurationMs int64  `json:"durationMs" jsonschema:"how long the job has existed, in milliseconds"`
+}
+
+type GetFlashJobsOutput struct {
+	Jobs []FlashJobStatus `json:"jobs" jsonschema:"background flash jobs, oldest first"`
+}
+
+var (
+	GetFlashJobsTool = &mcp.Tool{
+		Name:        "flash.getJobs",
+		Title:       "Get flash jobs",
+		Description: "Get background flashing jobs and their progress and results",
+		Annotations: &mcp.ToolAnnotations{ReadOnlyHint: true},
+	}
+)
+
+type flashJobRun func(context.Context, func(string, int64)) (any, error)
+
+func (s *Service) startFlashJob(kind string, input any, totalBytes int64, run flashJobRun, cleanup func()) string {
+	job := &flashJob{
+		id:         uuid.New().String(),
+		kind:       kind,
+		input:      input,
+		status:     flashJobQueued,
+		totalBytes: totalBytes,
+		created:    time.Now(),
+	}
+
+	s.flashJobsLock.Lock()
+	s.flashJobs = append(s.flashJobs, job)
+	s.pruneFlashJobsLocked()
+	s.flashJobsLock.Unlock()
+
+	s.wg.Go(func() {
+		if err := s.flashLock.Acquire(s.baseCtx, 1); err != nil {
+			s.finishFlashJob(job, nil, err)
+			cleanup()
+
+			return
+		}
+		defer s.flashLock.Release(1)
+
+		s.flashJobsLock.Lock()
+		job.status = flashJobRunning
+		s.flashJobsLock.Unlock()
+
+		result, err := run(s.baseCtx, func(partition string, sent int64) {
+			s.flashJobsLock.Lock()
+			defer s.flashJobsLock.Unlock()
+
+			job.partition = partition
+			job.sent = sent
+		})
+		s.finishFlashJob(job, result, err)
+	})
+
+	return job.id
+}
+
+func (s *Service) finishFlashJob(job *flashJob, result any, err error) {
+	s.flashJobsLock.Lock()
+	defer s.flashJobsLock.Unlock()
+
+	job.ended = time.Now()
+	if err != nil {
+		job.status = flashJobFailed
+		job.err = err.Error()
+
+		return
+	}
+
+	job.status = flashJobSucceeded
+	job.result = result
+}
+
+func (s *Service) pruneFlashJobsLocked() {
+	finished := 0
+	for _, job := range s.flashJobs {
+		if flashJobFinished(job.status) {
+			finished++
+		}
+	}
+
+	for finished > flashJobHistorySize {
+		for i, job := range s.flashJobs {
+			if flashJobFinished(job.status) {
+				s.flashJobs = slices.Delete(s.flashJobs, i, i+1)
+				finished--
+
+				break
+			}
+		}
+	}
+}
+
+func flashJobFinished(status flashJobState) bool {
+	return status == flashJobSucceeded || status == flashJobFailed
+}
+
+func (s *Service) GetFlashJobs(ctx context.Context, req *mcp.CallToolRequest, input struct{}) (*mcp.CallToolResult, *GetFlashJobsOutput, error) {
+	s.flashJobsLock.Lock()
+	defer s.flashJobsLock.Unlock()
+
+	now := time.Now()
+	jobs := make([]FlashJobStatus, 0, len(s.flashJobs))
+	for _, job := range s.flashJobs {
+		end := job.ended
+		if end.IsZero() {
+			end = now
+		}
+
+		jobs = append(jobs, FlashJobStatus{
+			ID:         job.id,
+			Kind:       job.kind,
+			Input:      job.input,
+			Status:     string(job.status),
+			Error:      job.err,
+			Partition:  job.partition,
+			SentBytes:  job.sent,
+			TotalBytes: job.totalBytes,
+			Result:     job.result,
+			CreatedAt:  job.created.UnixMilli(),
+			DurationMs: end.Sub(job.created).Milliseconds(),
+		})
+	}
+
+	return nil, &GetFlashJobsOutput{Jobs: jobs}, nil
+}
