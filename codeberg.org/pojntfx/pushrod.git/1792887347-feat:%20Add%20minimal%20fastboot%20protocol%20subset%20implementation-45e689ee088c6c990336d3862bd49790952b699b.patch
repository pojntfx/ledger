diff --git a/pkg/titanflasher/protocol.go b/pkg/titanflasher/protocol.go
new file mode 100644
index 0000000000000000000000000000000000000000..a9fd5f670f3cb97fda2e9c013bc484d31702dae3
--- /dev/null
+++ b/pkg/titanflasher/protocol.go
@@ -0,0 +1,115 @@
+package titanflasher
+
+import (
+	"context"
+	"errors"
+	"io"
+	"strings"
+)
+
+const (
+	// See https://github.com/u-boot/u-boot/blob/master/include/fastboot.h#L29-L31
+	responsePacketSize = 64
+
+	// See https://android.googlesource.com/platform/system/core/+/refs/heads/main/fastboot/README.md#transport-and-framing
+	responseStatusSize = 4
+)
+
+var (
+	errInvalidResponse    = errors.New("invalid fastboot response")
+	errUnexpectedResponse = errors.New("unexpected fastboot response")
+	errCommandFailed      = errors.New("fastboot command failed")
+)
+
+type responseStatus string
+
+const (
+	// See https://android.googlesource.com/platform/system/core/+/refs/heads/main/fastboot/README.md#transport-and-framing
+	statusInfo responseStatus = "INFO"
+	statusOKAY responseStatus = "OKAY"
+	statusData responseStatus = "DATA"
+	statusFail responseStatus = "FAIL"
+)
+
+type response struct {
+	status  responseStatus
+	payload string
+}
+
+type transport interface {
+	ReadContext(context.Context, []byte) (int, error)
+	WriteContext(context.Context, []byte) (int, error)
+}
+
+type protocol struct {
+	transport transport
+}
+
+func (p *protocol) command(ctx context.Context, command string, expected responseStatus) (response, error) {
+	if err := p.writeCommand(ctx, command); err != nil {
+		return response{}, err
+	}
+
+	return p.accept(ctx, expected)
+}
+
+func (p *protocol) writeCommand(ctx context.Context, command string) error {
+	data := []byte(command)
+	n, err := p.transport.WriteContext(ctx, data)
+	if err != nil {
+		return err
+	}
+
+	if n != len(data) {
+		return io.ErrShortWrite
+	}
+
+	return nil
+}
+
+func (p *protocol) accept(ctx context.Context, expected responseStatus) (response, error) {
+	for {
+		r, err := p.readResponse(ctx)
+		if err != nil {
+			return response{}, err
+		}
+
+		switch r.status {
+		case statusInfo:
+			continue
+
+		case statusFail:
+			return response{}, errCommandFailed
+
+		case expected:
+			return r, nil
+
+		default:
+			return response{}, errUnexpectedResponse
+		}
+	}
+}
+
+func (p *protocol) readResponse(ctx context.Context) (response, error) {
+	data := make([]byte, responsePacketSize)
+	n, err := p.transport.ReadContext(ctx, data)
+	if err != nil {
+		return response{}, err
+	}
+
+	if n < responseStatusSize {
+		return response{}, errInvalidResponse
+	}
+
+	status := responseStatus(string(data[:responseStatusSize]))
+	switch status {
+	case statusInfo, statusOKAY, statusData, statusFail:
+	default:
+		return response{}, errInvalidResponse
+	}
+
+	return response{
+		status:  status,
+		payload: strings.TrimRight(string(data[responseStatusSize:n]), "\x00"),
+	}, nil
+}
diff --git a/pkg/titanflasher/session.go b/pkg/titanflasher/session.go
new file mode 100644
index 0000000000000000000000000000000000000000..97e047ff33fea9fb81fb81f18dc505ea3a6e7efd
--- /dev/null
+++ b/pkg/titanflasher/session.go
@@ -0,0 +1,167 @@
+package titanflasher
+
+import (
+	"context"
+	"errors"
+
+	"github.com/google/gousb"
+)
+
+var ErrDeviceNotFound = errors.New("fastboot device not found")
+
+type Session struct {
+	usbContext    *gousb.Context
+	device        *gousb.Device
+	configuration *gousb.Config
+	iface         *gousb.Interface
+	protocol      *protocol
+}
+
+func OpenSession(path string) (*Session, error) {
+	usbContext := gousb.NewContext()
+	devices, err := usbContext.OpenDevices(func(desc *gousb.DeviceDesc) bool {
+		return isFastboot(desc) && formatDevicePath(desc) == path
+	})
+	if err != nil {
+		closeDevices(devices)
+		usbContext.Close()
+
+		return nil, err
+	}
+
+	if len(devices) == 0 {
+		usbContext.Close()
+
+		return nil, ErrDeviceNotFound
+	}
+
+	closeDevices(devices[1:])
+
+	return newSession(usbContext, devices[0])
+}
+
+func newSession(usbContext *gousb.Context, device *gousb.Device) (_ *Session, err error) {
+	s := &Session{
+		usbContext: usbContext,
+		device:     device,
+	}
+	defer func() {
+		if err != nil {
+			err = errors.Join(err, s.Close())
+		}
+	}()
+
+	configurationNumber, setting, ok := findFastbootInterface(device.Desc)
+	if !ok {
+		return nil, errors.New("fastboot interface not found")
+	}
+
+	inNumber, outNumber, err := bulkEndpointNumbers(setting)
+	if err != nil {
+		return nil, err
+	}
+
+	if err := device.SetAutoDetach(true); err != nil {
+		return nil, err
+	}
+
+	s.configuration, err = device.Config(configurationNumber)
+	if err != nil {
+		return nil, err
+	}
+
+	s.iface, err = s.configuration.Interface(setting.Number, setting.Alternate)
+	if err != nil {
+		return nil, err
+	}
+
+	in, err := s.iface.InEndpoint(inNumber)
+	if err != nil {
+		return nil, err
+	}
+
+	out, err := s.iface.OutEndpoint(outNumber)
+	if err != nil {
+		return nil, err
+	}
+
+	s.protocol = &protocol{
+		transport: &usbTransport{in: in, out: out},
+	}
+
+	return s, nil
+}
+
+func (s *Session) Close() error {
+	var errs []error
+
+	if s.iface != nil {
+		s.iface.Close()
+		s.iface = nil
+	}
+
+	if s.configuration != nil {
+		errs = append(errs, s.configuration.Close())
+		s.configuration = nil
+	}
+
+	if s.device != nil {
+		errs = append(errs, s.device.Close())
+		s.device = nil
+	}
+
+	if s.usbContext != nil {
+		errs = append(errs, s.usbContext.Close())
+		s.usbContext = nil
+	}
+
+	s.protocol = nil
+
+	return errors.Join(errs...)
+}
+
+func bulkEndpointNumbers(setting gousb.InterfaceSetting) (int, int, error) {
+	inNumber := -1
+	outNumber := -1
+
+	for _, endpoint := range setting.Endpoints {
+		if endpoint.TransferType != gousb.TransferTypeBulk {
+			continue
+		}
+
+		switch endpoint.Direction {
+		case gousb.EndpointDirectionIn:
+			if inNumber >= 0 {
+				return 0, 0, errors.New("multiple fastboot bulk IN endpoints")
+			}
+
+			inNumber = endpoint.Number
+
+		case gousb.EndpointDirectionOut:
+			if outNumber >= 0 {
+				return 0, 0, errors.New("multiple fastboot bulk OUT endpoints")
+			}
+
+			outNumber = endpoint.Number
+		}
+	}
+
+	if inNumber < 0 || outNumber < 0 {
+		return 0, 0, errors.New("fastboot interface requires bulk IN and OUT endpoints")
+	}
+
+	return inNumber, outNumber, nil
+}
+
+type usbTransport struct {
+	in  *gousb.InEndpoint
+	out *gousb.OutEndpoint
+}
+
+func (t *usbTransport) ReadContext(ctx context.Context, data []byte) (int, error) {
+	return t.in.ReadContext(ctx, data)
+}
+
+func (t *usbTransport) WriteContext(ctx context.Context, data []byte) (int, error) {
+	return t.out.WriteContext(ctx, data)
+}
