diff --git a/pkg/relay/relay.go b/pkg/relay/relay.go
new file mode 100644
index 0000000000000000000000000000000000000000..dd015d6834e9cc21e97f305531dfb211bdffbd7b
--- /dev/null
+++ b/pkg/relay/relay.go
@@ -0,0 +1,50 @@
+package relay
+
+import (
+	"log/slog"
+	"sync"
+	"time"
+
+	"rafaelmartins.com/p/usbhid"
+)
+
+type relayCommand byte
+
+const (
+	relayCommandOn  relayCommand = 0xFF
+	relayCommandOff relayCommand = 0xFD
+)
+
+type relayCycle struct {
+	lock                          *sync.Mutex
+	remainingOnRelayCycleDuration time.Duration
+	index                         byte
+}
+
+func (r *relayCycle) PowerOn(d *usbhid.Device) error {
+	return d.SetFeatureReport(byte(relayCommandOff), []byte{r.index})
+}
+
+func (r *relayCycle) PowerOff(d *usbhid.Device) error {
+	return d.SetFeatureReport(byte(relayCommandOff), []byte{r.index})
+}
+
+// PowerOffWithRetry tries powering off the relay until the max relay attempts are exceeded to work around intermittent relay failures
+func (r *relayCycle) PowerOffWithRetry(d *usbhid.Device, sleepBetweenRetries time.Duration, maxRetryAttempts int, log *slog.Logger) error {
+	r.lock.Lock()
+	defer r.lock.Unlock()
+
+	for range maxRetryAttempts {
+		if err := r.PowerOff(d); err != nil {
+			log.Error("Could not turn off relay, retrying", "err", err, "sleep", sleepBetweenRetries)
+
+			time.Sleep(sleepBetweenRetries)
+
+			continue
+		}
+
+		return nil
+	}
+
+	return nil
+}
