+}
+
+func (server *walletServer) profileMatches(tier int, currentEvidence *evidence) bool {
+	expected := server.profiles["development"]
+	if tier == 2 {
+		expected = server.profiles["production"]
+	}
+	return currentEvidence != nil && strings.EqualFold(currentEvidence.PCR11, expected)
+}
+
+func writeJSON(writer http.ResponseWriter, status int, value any) {
+	writer.Header().Set("Content-Type", "application/json")
+	writer.WriteHeader(status)
+	_ = json.NewEncoder(writer).Encode(value)
+}
+
+func methodNotAllowed(writer http.ResponseWriter, method string) {
+	writer.Header().Set("Allow", method)
+	writeJSON(writer, http.StatusMethodNotAllowed, map[string]string{"error": "method not allowed"})
+}
+
+func verifySignature(publicKey string, message, signature []byte) error {
+	directory, err := os.MkdirTemp("", "rva23-wallet-verify-")
+	if err != nil {
+		return err
+	}
+	defer os.RemoveAll(directory)
+	messagePath := filepath.Join(directory, "message.bin")
+	signaturePath := filepath.Join(directory, "sig.bin")
+	if err := os.WriteFile(messagePath, message, 0o600); err != nil {
+		return err
+	}
+	if err := os.WriteFile(signaturePath, signature, 0o600); err != nil {
+		return err
+	}
+	command := exec.Command("openssl", "dgst", "-sha256", "-verify", publicKey, "-signature", signaturePath, messagePath)
+	output, err := command.CombinedOutput()
+	if err != nil {
+		if text := strings.TrimSpace(string(output)); text != "" {
+			return fmt.Errorf("signature verification failed: %s", text)
+		}
+		return fmt.Errorf("signature verification failed: %w", err)
+	}
+	return nil
+}
+
+func (server *walletServer) record(record requestRecord) {
+	server.stateMutex.Lock()
+	defer server.stateMutex.Unlock()
+	latest := record
+	server.latest = &latest
+	server.history = append([]requestRecord{record}, server.history...)
+	if len(server.history) > 32 {
+		server.history = server.history[:32]
+	}
+}
+
+func (server *walletServer) reject(writer http.ResponseWriter, record requestRecord, status int, err error) {
+	record.Error = err.Error()
+	server.record(record)
+	writeJSON(writer, status, map[string]string{"error": err.Error()})
+}
+
+func (server *walletServer) validNonce(nonce string, now time.Time) bool {
+	server.mutex.Lock()
+	defer server.mutex.Unlock()
+	expiresAt, ok := server.nonces[nonce]
+	return ok && now.Before(expiresAt)
+}
+
+func (server *walletServer) contractsHandler(writer http.ResponseWriter, request *http.Request) {
+	if request.Method != http.MethodGet {
+		methodNotAllowed(writer, http.MethodGet)
+		return
+	}
+	writeJSON(writer, http.StatusOK, contracts)
+}
+
+func (server *walletServer) challengeHandler(writer http.ResponseWriter, request *http.Request) {
+	if request.Method != http.MethodGet {
+		methodNotAllowed(writer, http.MethodGet)
+		return
+	}
+	nonce := make([]byte, 32)
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		writeJSON(writer, http.StatusInternalServerError, map[string]string{"error": err.Error()})
+		return
+	}
+	now := time.Now().UTC()
+	response := challengeResponse{
+		Nonce:     base64.RawURLEncoding.EncodeToString(nonce),
+		ExpiresAt: now.Add(time.Minute),
+	}
+	server.mutex.Lock()
+	for value, expiresAt := range server.nonces {
+		if !now.Before(expiresAt) {
+			delete(server.nonces, value)
+		}
+	}
+	if len(server.nonces) >= 1024 {
+		server.mutex.Unlock()
+		writeJSON(writer, http.StatusServiceUnavailable, map[string]string{"error": "too many outstanding challenges"})
+		return
+	}
+	server.nonces[response.Nonce] = response.ExpiresAt
+	server.mutex.Unlock()
+	writeJSON(writer, http.StatusOK, response)
+}
+
+func (server *walletServer) forwardReport(report []byte, currentEvidence *evidence) error {
+	request, err := http.NewRequest(http.MethodPost, server.attestationURL, bytes.NewReader(report))
+	if err != nil {
+		return err
+	}
+	request.Header.Set("Content-Type", "application/json")
+	request.Header.Set("X-Attestation-Nonce", currentEvidence.Nonce)
+	request.Header.Set("X-Attestation-Token", currentEvidence.Token)
+	response, err := server.client.Do(request)
+	if err != nil {
+		return fmt.Errorf("attestation request failed: %w", err)
+	}
+	defer response.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(response.Body, 64*1024))
+	if err != nil {
+		return fmt.Errorf("attestation response failed: %w", err)
+	}
+	if response.StatusCode < 200 || response.StatusCode >= 300 {
+		return fmt.Errorf("attestation service returned %s: %s", response.Status, strings.TrimSpace(string(body)))
+	}
+	return nil
+}
+
+func (server *walletServer) saveResponse(response signResponse) error {
+	if err := os.MkdirAll(server.walletDir, 0o700); err != nil {
+		return err
+	}
+	encoded, err := json.Marshal(response)
+	if err != nil {
+		return err
+	}
+	return os.WriteFile(filepath.Join(server.walletDir, "response.json"), append(encoded, '\n'), 0o600)
+}
+
+func (server *walletServer) signHandler(writer http.ResponseWriter, request *http.Request) {
+	if request.Method != http.MethodPost {
+		methodNotAllowed(writer, http.MethodPost)
+		return
+	}
+	raw, readErr := io.ReadAll(http.MaxBytesReader(writer, request.Body, 16*1024*1024))
+	record := requestRecord{
+		At:         time.Now().UTC(),
+		BodyBase64: base64.StdEncoding.EncodeToString(raw),
+	}
+	if readErr != nil {
+		server.reject(writer, record, http.StatusBadRequest, fmt.Errorf("invalid request body: %w", readErr))
+		return
+	}
+	var input signRequest
+	if err := json.Unmarshal(raw, &input); err != nil {
+		server.reject(writer, record, http.StatusBadRequest, fmt.Errorf("invalid request JSON: %w", err))
+		return
+	}
+	record.Consent = input.Consent
+	record.Device = input.Device
+	record.Evidence = input.Evidence
+	selected := findContract(input.ContractID)
+	record.Contract = selected
+	if selected == nil {
+		server.reject(writer, record, http.StatusBadRequest, errors.New("unknown contract"))
+		return
+	}
+	if !input.Approved {
+		server.reject(writer, record, http.StatusForbidden, errors.New("approval is required"))
+		return
+	}
+	if input.Consent != "host" && input.Consent != "smartcard" && input.Consent != "fido2" {
+		server.reject(writer, record, http.StatusBadRequest, errors.New("unknown consent method"))
+		return
+	}
+	if !server.validNonce(input.Nonce, time.Now().UTC()) {
+		server.reject(writer, record, http.StatusForbidden, errors.New("challenge nonce is expired or unknown"))
+		return
+	}
+	canonicalContract, err := json.Marshal(selected)
+	if err != nil {
+		server.reject(writer, record, http.StatusInternalServerError, err)
+		return
+	}
+	contractDigest := sha256Hex(canonicalContract)
+	if input.Consent == "host" {
+		if input.ConsentProof != "" {
+			server.reject(writer, record, http.StatusForbidden, errors.New("host consent requires an empty consent proof"))
+			return
+		}
+	} else if input.Consent == "fido2" {
+		message, err := json.Marshal(consentMessage{Nonce: input.Nonce, ContractID: input.ContractID, ContractSHA256: contractDigest, Method: input.Consent})
+		if err != nil {
+			server.reject(writer, record, http.StatusInternalServerError, err)
+			return
+		}
+		if err := server.verifyFido2Consent(input, message, contractDigest); err != nil {
+			server.reject(writer, record, http.StatusForbidden, err)
+			return
+		}
+	} else {
+		proof, err := base64.RawURLEncoding.DecodeString(input.ConsentProof)
+		if err != nil || len(proof) == 0 {
+			server.reject(writer, record, http.StatusForbidden, errors.New("invalid external consent proof"))
+			return
+		}
+		message, err := json.Marshal(consentMessage{Nonce: input.Nonce, ContractID: input.ContractID, ContractSHA256: contractDigest, Method: input.Consent})
+		if err != nil {
+			server.reject(writer, record, http.StatusInternalServerError, err)
+			return
+		}
+		publicKey := filepath.Join(server.consentDir, input.Consent+"-public.pem")
+		if err := verifySignature(publicKey, message, proof); err != nil {
+			server.reject(writer, record, http.StatusForbidden, err)
+			return
+		}
+	}
+	requiresEvidence := selected.Tier == 1 || (selected.Tier == 2 && input.Consent == "host")
+	attestationNonce := ""
+	attestationToken := ""
+	reportDigest := ""
+	pcr11Value := ""
+	var report []byte
+	if requiresEvidence {
+		if input.Evidence == nil || input.Evidence.Nonce == "" || input.Evidence.Token == "" || input.Evidence.Report == "" || input.Evidence.PCR11 == "" {
+			server.reject(writer, record, http.StatusForbidden, errors.New("full OS evidence is required"))
+			return
+		}
+		report, err = base64.RawURLEncoding.DecodeString(input.Evidence.Report)
+		if err != nil || len(report) == 0 {
+			server.reject(writer, record, http.StatusBadRequest, errors.New("invalid OS report encoding"))
+			return
+		}
+		attestationNonce = input.Evidence.Nonce
+		attestationToken = input.Evidence.Token
+		reportDigest = sha256Hex(report)
+	}
+	if input.Evidence != nil {
+		pcr11Value = input.Evidence.PCR11
+	}
+	message, err := json.Marshal(signatureMessage{
+		Nonce:            input.Nonce,
+		ContractID:       input.ContractID,
+		ContractSHA256:   contractDigest,
+		ConsentMethod:    input.Consent,
+		ConsentProof:     input.ConsentProof,
+		AttestationNonce: attestationNonce,
+		AttestationToken: attestationToken,
+		ReportSHA256:     reportDigest,
+		PCR11:            pcr11Value,
+	})
+	if err != nil {
+		server.reject(writer, record, http.StatusInternalServerError, err)
+		return
+	}
+	signature, err := base64.RawURLEncoding.DecodeString(input.Signature)
+	if err != nil || len(signature) != 256 {
+		server.reject(writer, record, http.StatusForbidden, errors.New("invalid AK signature encoding or length"))
+		return
+	}
+	if err := verifySignature(server.keyFile, message, signature); err != nil {
+		server.reject(writer, record, http.StatusForbidden, err)
+		return
+	}
+	if requiresEvidence {
+		if err := server.forwardReport(report, input.Evidence); err != nil {
+			server.reject(writer, record, http.StatusForbidden, err)
+			return
+		}
+		if !server.profileMatches(selected.Tier, input.Evidence) {
+			server.reject(writer, record, http.StatusForbidden, errors.New("OS report PCR 11 does not match the required profile"))
+			return
+		}
+	}
+	now := time.Now().UTC()
+	day := now.Format("2006-01-02")
+	usageKey := selected.ID + "\x00" + day
+	server.mutex.Lock()
+	expiresAt, ok := server.nonces[input.Nonce]
+	if !ok || !now.Before(expiresAt) {
+		server.mutex.Unlock()
+		server.reject(writer, record, http.StatusForbidden, errors.New("challenge nonce is expired or already used"))
+		return
+	}
+	used := server.usage[usageKey]
+	if selected.DailyLimitCents > 0 && used+selected.AmountCents > selected.DailyLimitCents {
+		server.mutex.Unlock()
+		server.reject(writer, record, http.StatusConflict, fmt.Errorf("daily limit exceeded with %d cents used", used))
+		return
+	}
+	response := signResponse{
+		Status:         "accepted",
+		ContractID:     selected.ID,
+		Tier:           selected.Tier,
+		AmountCents:    selected.AmountCents,
+		DailyUsedCents: used + selected.AmountCents,
+		Consent:        input.Consent,
+	}
+	if err := server.saveResponse(response); err != nil {
+		server.mutex.Unlock()
+		server.reject(writer, record, http.StatusInternalServerError, err)
+		return
+	}
+	server.usage[usageKey] = response.DailyUsedCents
+	delete(server.nonces, input.Nonce)
+	server.mutex.Unlock()
+	record.Response = &response
+	server.record(record)
+	writeJSON(writer, http.StatusOK, response)
+}
+
+func (server *walletServer) stateHandler(writer http.ResponseWriter, request *http.Request) {
+	if request.Method != http.MethodGet {
+		methodNotAllowed(writer, http.MethodGet)
+		return
+	}
+	server.stateMutex.RLock()
+	response := stateResponse{History: append([]requestRecord(nil), server.history...)}
+	if server.latest != nil {
+		latest := *server.latest
+		response.Latest = &latest
+	}
+	server.stateMutex.RUnlock()
+	if response.History == nil {
+		response.History = []requestRecord{}
+	}
+	writeJSON(writer, http.StatusOK, response)
+}
+
+func uiHandler(writer http.ResponseWriter, request *http.Request) {
+	if request.URL.Path != "/" {
+		http.NotFound(writer, request)
+		return
+	}
+	if request.Method != http.MethodGet {
+		methodNotAllowed(writer, http.MethodGet)
+		return
+	}
+	writer.Header().Set("Content-Type", "text/html; charset=utf-8")
+	_, _ = io.WriteString(writer, `<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Wallet contract signing</title></head>
+<body><h1>Wallet contract signing</h1><p><button id="refresh" type="button">Refresh</button> <a href="/api/state">JSON state</a></p>
+<details open><summary>Latest sign request</summary><div id="latest">No sign requests</div></details>
+<details open><summary>Sign-request history</summary><div id="history">No sign requests</div></details>
+<script>
+function fill(parent,item){parent.replaceChildren();function add(name,value){const label=document.createElement('p');label.textContent=name;const body=document.createElement('pre');body.textContent=value;parent.append(label,body)}add('Raw request body base64',item.bodyBase64||'');add('Contract',JSON.stringify(item.contract||null,null,2));add('Contract body',item.contract?item.contract.body:'');add('Consent',item.consent||'');add('Device',item.device||'');add('Evidence',JSON.stringify(item.evidence||null,null,2));add('Response',JSON.stringify(item.response||null,null,2));add('Error',item.error||'');const raw=document.createElement('details');const summary=document.createElement('summary');summary.textContent='Raw JSON';const pre=document.createElement('pre');pre.textContent=JSON.stringify(item,null,2);raw.append(summary,pre);parent.append(raw)}
+function historyEntry(item){const details=document.createElement('details');const summary=document.createElement('summary');summary.textContent=(item.at||'Unknown time')+' '+((item.contract&&item.contract.id)||'Unknown contract')+' '+((item.response&&item.response.status)||item.error||'rejected');fill(details,item);details.prepend(summary);return details}
+async function refresh(){const data=await fetch('/api/state').then(response=>response.json());const latest=document.getElementById('latest');if(data.latest){fill(latest,data.latest)}else{latest.textContent='No sign requests'}const history=document.getElementById('history');if((data.history||[]).length){history.replaceChildren(...data.history.map(historyEntry))}else{history.textContent='No sign requests'}}
+document.getElementById('refresh').onclick=refresh;refresh()
+</script></body></html>`)
+}
+
+func main() {
+	profiles, err := loadProfiles(environment("RVA23_WALLET_PROFILE_FILE", "output/rva23/wallet/profiles.json"))
+	if err != nil {
+		panic(err)
+	}
+	server := &walletServer{
+		walletDir:      environment("RVA23_WALLET_DIR", "output/rva23/wallet"),
+		attestationURL: environment("RVA23_WALLET_ATTESTATION_URL", "http://127.0.0.1:8080/v1/attest"),
+		keyFile:        environment("RVA23_WALLET_KEY_FILE", "output/rva23/host-attestation/public-key.pem"),
+		consentDir:     environment("RVA23_WALLET_CONSENT_DIR", "output/rva23/wallet"),
+		profiles:       profiles,
+		client:         &http.Client{Timeout: 60 * time.Second},
+		nonces:         make(map[string]time.Time),
+		usage:          make(map[string]int64),
+		history:        make([]requestRecord, 0),
+	}
+	mux := http.NewServeMux()
+	mux.HandleFunc("/v1/contracts", server.contractsHandler)
+	mux.HandleFunc("/v1/challenge", server.challengeHandler)
+	mux.HandleFunc("/v1/sign", server.signHandler)
+	mux.HandleFunc("/api/state", server.stateHandler)
+	mux.HandleFunc("/", uiHandler)
+	httpServer := &http.Server{
+		Addr:              "127.0.0.1:8081",
+		Handler:           mux,
+		ReadHeaderTimeout: 5 * time.Second,
+		ReadTimeout:       60 * time.Second,
+		WriteTimeout:      60 * time.Second,
+		IdleTimeout:       60 * time.Second,
+		MaxHeaderBytes:    64 * 1024,
+	}
+	if err := httpServer.ListenAndServe(); err != nil {
+		panic(err)
+	}
+}

