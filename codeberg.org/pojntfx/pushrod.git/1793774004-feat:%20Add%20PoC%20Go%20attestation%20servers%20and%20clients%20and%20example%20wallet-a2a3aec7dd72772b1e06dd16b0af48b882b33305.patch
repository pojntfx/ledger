diff --git a/buildroot/qemu/scripts/report-receiver.go b/buildroot/qemu/scripts/report-receiver.go
new file mode 100644
index 0000000000000000000000000000000000000000..8cf611b3a95c6081e9ef3fe61ed4328269e19984
--- /dev/null
+++ b/buildroot/qemu/scripts/report-receiver.go
@@ -0,0 +1,668 @@
+package main
+
+import (
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+	"unicode/utf16"
+)
+
+type clockInfo struct {
+	Clock        uint64 `json:"clock"`
+	ResetCount   uint32 `json:"resetCount"`
+	RestartCount uint32 `json:"restartCount"`
+	Safe         string `json:"safe"`
+}
+
+type pcrSelection struct {
+	Hash      string   `json:"hash"`
+	PCRSelect []uint32 `json:"pcrSelect"`
+}
+
+type attestedFields struct {
+	PCRSelect        []pcrSelection `json:"pcrSelect"`
+	PCRDigest        string         `json:"pcrDigest"`
+	IndexName        string         `json:"indexName"`
+	Offset           uint16         `json:"offset"`
+	NVContents       string         `json:"nvContents"`
+	ExclusiveSession string         `json:"exclusiveSession"`
+	SessionDigest    string         `json:"sessionDigest"`
+}
+
+type attestation struct {
+	Magic           string         `json:"magic"`
+	Type            string         `json:"type"`
+	QualifiedSigner string         `json:"qualifiedSigner"`
+	ExtraData       string         `json:"extraData"`
+	ClockInfo       clockInfo      `json:"clockInfo"`
+	FirmwareVersion uint64         `json:"firmwareVersion"`
+	Attested        attestedFields `json:"attested"`
+}
+
+type attestInfo struct {
+	Scheme json.RawMessage `json:"sig_scheme"`
+	Attest attestation     `json:"attest"`
+}
+
+type signatureData struct {
+	SigAlg string `json:"sigAlg"`
+	Inner  struct {
+		Sig string `json:"sig"`
+	} `json:"signature"`
+}
+
+type component struct {
+	Type      string        `json:"type"`
+	Attest    attestInfo    `json:"attestInfo"`
+	Signature signatureData `json:"signature"`
+}
+
+type reportSignature struct {
+	MediaType string `json:"mediaType"`
+	Mechanism string `json:"mechanism"`
+	SHA256    string `json:"sha256"`
+	Data      struct {
+		EventLog     []json.RawMessage `json:"eventLog"`
+		PublicKeyPEM string            `json:"publicKeyPEM"`
+		Components   []component       `json:"components"`
+	} `json:"data"`
+}
+
+type uploadResponse struct {
+	Status             string `json:"status"`
+	ComponentsVerified int    `json:"componentsVerified"`
+	EventLogRecords    int    `json:"eventLogRecords"`
+}
+
+type tokenFile struct {
+	KeyID  string `json:"keyId"`
+	Secret string `json:"secret"`
+}
+
+type tokenStore struct {
+	KeyID  string
+	Secret []byte
+	Nonces map[string]time.Time
+	Mutex  sync.Mutex
+}
+
+type requestSnapshot struct {
+	At         time.Time         `json:"at"`
+	Path       string            `json:"path"`
+	Headers    map[string]string `json:"headers"`
+	Body       string            `json:"bodyBase64"`
+	Nonce      string            `json:"nonce"`
+	Token      string            `json:"token"`
+	Report     json.RawMessage   `json:"report"`
+	Signatures json.RawMessage   `json:"signatures"`
+	Response   json.RawMessage   `json:"response"`
+	Sysext     []json.RawMessage `json:"sysext"`
+	Error      string            `json:"error"`
+}
+
+type receiverState struct {
+	Mutex    sync.RWMutex
+	Snapshot requestSnapshot
+	History  []requestSnapshot
+}
+
+var state receiverState
+
+func sysextRecords(signatures []reportSignature) []json.RawMessage {
+	if len(signatures) == 0 {
+		return nil
+	}
+	var records []json.RawMessage
+	for _, encoded := range signatures[0].Data.EventLog {
+		var record struct {
+			PCR         int    `json:"pcr"`
+			ContentType string `json:"content_type"`
+			Content     struct {
+				EventData string `json:"event_data"`
+			} `json:"content"`
+		}
+		if err := json.Unmarshal(encoded, &record); err != nil || record.PCR != 13 || record.ContentType != "pcclient_std" {
+			continue
+		}
+		data, err := hex.DecodeString(record.Content.EventData)
+		if err != nil || len(data)%2 != 0 {
+			continue
+		}
+		units := make([]uint16, len(data)/2)
+		for index := range units {
+			units[index] = binary.LittleEndian.Uint16(data[index*2:])
+		}
+		if strings.Contains(string(utf16.Decode(units)), "Global system extension initrd") {
+			records = append(records, encoded)
+		}
+	}
+	return records
+}
+
+func recordRequest(request *http.Request, raw, report []byte, signatures []reportSignature) {
+	encodedSignatures, _ := json.Marshal(signatures)
+	headers := make(map[string]string)
+	for key, values := range request.Header {
+		headers[key] = strings.Join(values, ", ")
+	}
+	state.Mutex.Lock()
+	state.Snapshot = requestSnapshot{
+		At: time.Now(), Path: request.URL.Path, Headers: headers,
+		Body:       base64.StdEncoding.EncodeToString(raw),
+		Nonce:      request.Header.Get("X-Attestation-Nonce"),
+		Token:      request.Header.Get("X-Attestation-Token"),
+		Report:     append(json.RawMessage(nil), report...),
+		Signatures: encodedSignatures,
+		Sysext:     sysextRecords(signatures),
+	}
+	state.History = append([]requestSnapshot{state.Snapshot}, state.History...)
+	if len(state.History) > 32 {
+		state.History = state.History[:32]
+	}
+	state.Mutex.Unlock()
+}
+
+func recordResult(response uploadResponse, err error) {
+	state.Mutex.Lock()
+	defer state.Mutex.Unlock()
+	if err != nil {
+		state.Snapshot.Error = err.Error()
+	} else {
+		state.Snapshot.Response, _ = json.Marshal(response)
+		state.Snapshot.Error = ""
+	}
+	if len(state.History) > 0 {
+		state.History[0].Response = state.Snapshot.Response
+		state.History[0].Error = state.Snapshot.Error
+	}
+}
+
+func stateHandler(writer http.ResponseWriter, request *http.Request) {
+	state.Mutex.RLock()
+	response := struct {
+		Latest  requestSnapshot   `json:"latest"`
+		History []requestSnapshot `json:"history"`
+	}{state.Snapshot, append([]requestSnapshot(nil), state.History...)}
+	state.Mutex.RUnlock()
+	writer.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(writer).Encode(response)
+}
+
+type challengeResponse struct {
+	Nonce     string    `json:"nonce"`
+	ExpiresAt time.Time `json:"expiresAt"`
+}
+
+func loadTokenStore(path string) (*tokenStore, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	var document tokenFile
+	if err := json.Unmarshal(data, &document); err != nil {
+		return nil, err
+	}
+	secret, err := base64.StdEncoding.DecodeString(document.Secret)
+	if err != nil {
+		return nil, err
+	}
+	if len(secret) != 32 {
+		return nil, errors.New("attestation token secret must contain 32 bytes")
+	}
+	return &tokenStore{KeyID: document.KeyID, Secret: secret, Nonces: make(map[string]time.Time)}, nil
+}
+
+func newNonce(store *tokenStore) (challengeResponse, error) {
+	var response challengeResponse
+	var nonce [32]byte
+	if _, err := rand.Read(nonce[:]); err != nil {
+		return response, err
+	}
+	encoded := base64.RawURLEncoding.EncodeToString(nonce[:])
+	store.Mutex.Lock()
+	defer store.Mutex.Unlock()
+	now := time.Now()
+	for key, expiry := range store.Nonces {
+		if now.After(expiry) {
+			delete(store.Nonces, key)
+		}
+	}
+	if len(store.Nonces) >= 128 {
+		return response, errors.New("too many outstanding attestation challenges")
+	}
+	response.Nonce = encoded
+	response.ExpiresAt = now.Add(60 * time.Second)
+	store.Nonces[encoded] = response.ExpiresAt
+	return response, nil
+}
+
+func verifyTokenSignature(publicKeyPath, messagePath, signaturePath string) error {
+	result, err := exec.Command("openssl", "dgst", "-sha256", "-verify", publicKeyPath, "-signature", signaturePath, messagePath).CombinedOutput()
+	if err != nil {
+		return fmt.Errorf("token signature verification failed: %s", strings.TrimSpace(string(result)))
+	}
+	return nil
+}
+
+func putU16(buf []byte, value uint16) []byte {
+	var b [2]byte
+	binary.BigEndian.PutUint16(b[:], value)
+	return append(buf, b[:]...)
+}
+
+func putU32(buf []byte, value uint32) []byte {
+	var b [4]byte
+	binary.BigEndian.PutUint32(b[:], value)
+	return append(buf, b[:]...)
+}
+
+func putU64(buf []byte, value uint64) []byte {
+	var b [8]byte
+	binary.BigEndian.PutUint64(b[:], value)
+	return append(buf, b[:]...)
+}
+
+func putBytes(buf []byte, value string) ([]byte, error) {
+	decoded, err := hex.DecodeString(value)
+	if err != nil {
+		return nil, err
+	}
+	if len(decoded) > 65535 {
+		return nil, errors.New("TPM2B value is too long")
+	}
+	buf = putU16(buf, uint16(len(decoded)))
+	return append(buf, decoded...), nil
+}
+
+func attestType(value string) (uint16, error) {
+	switch value {
+	case "ATTEST_NV":
+		return 0x8014, nil
+	case "ATTEST_SESSION_AUDIT":
+		return 0x8016, nil
+	case "ATTEST_QUOTE":
+		return 0x8018, nil
+	default:
+		return 0, fmt.Errorf("unsupported attestation type %q", value)
+	}
+}
+
+func hashAlgorithm(value string) (uint16, error) {
+	switch value {
+	case "SHA1":
+		return 0x0004, nil
+	case "SHA256":
+		return 0x000b, nil
+	case "SHA384":
+		return 0x000c, nil
+	case "SHA512":
+		return 0x000d, nil
+	default:
+		return 0, fmt.Errorf("unsupported hash algorithm %q", value)
+	}
+}
+
+func marshalAttestation(value attestation) ([]byte, error) {
+	typeID, err := attestType(value.Type)
+	if err != nil {
+		return nil, err
+	}
+	buf := putU32(nil, 0xff544347)
+	buf = putU16(buf, typeID)
+	if buf, err = putBytes(buf, value.QualifiedSigner); err != nil {
+		return nil, err
+	}
+	if buf, err = putBytes(buf, value.ExtraData); err != nil {
+		return nil, err
+	}
+	buf = putU64(buf, value.ClockInfo.Clock)
+	buf = putU32(buf, value.ClockInfo.ResetCount)
+	buf = putU32(buf, value.ClockInfo.RestartCount)
+	if value.ClockInfo.Safe == "YES" {
+		buf = append(buf, 1)
+	} else {
+		buf = append(buf, 0)
+	}
+	buf = putU64(buf, value.FirmwareVersion)
+
+	switch typeID {
+	case 0x8018:
+		buf = putU32(buf, uint32(len(value.Attested.PCRSelect)))
+		for _, selection := range value.Attested.PCRSelect {
+			algorithm, err := hashAlgorithm(selection.Hash)
+			if err != nil {
+				return nil, err
+			}
+			buf = putU16(buf, algorithm)
+			const size = 3
+			for _, pcr := range selection.PCRSelect {
+				if pcr >= size*8 {
+					return nil, errors.New("PCR index is out of range")
+				}
+			}
+			buf = append(buf, byte(size))
+			bitmap := make([]byte, size)
+			for _, pcr := range selection.PCRSelect {
+				bitmap[pcr/8] |= 1 << (pcr % 8)
+			}
+			buf = append(buf, bitmap...)
+		}
+		if buf, err = putBytes(buf, value.Attested.PCRDigest); err != nil {
+			return nil, err
+		}
+	case 0x8014:
+		if buf, err = putBytes(buf, value.Attested.IndexName); err != nil {
+			return nil, err
+		}
+		buf = putU16(buf, value.Attested.Offset)
+		if buf, err = putBytes(buf, value.Attested.NVContents); err != nil {
+			return nil, err
+		}
+	case 0x8016:
+		if value.Attested.ExclusiveSession == "YES" {
+			buf = append(buf, 1)
+		} else {
+			buf = append(buf, 0)
+		}
+		if buf, err = putBytes(buf, value.Attested.SessionDigest); err != nil {
+			return nil, err
+		}
+	}
+	return buf, nil
+}
+
+func decodeRecords(body io.Reader) ([]byte, []byte, []reportSignature, error) {
+	data, err := io.ReadAll(io.LimitReader(body, 16*1024*1024))
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	parts := strings.Split(string(data), "\x1e")
+	if len(parts) < 2 {
+		return nil, nil, nil, errors.New("signed report requires JSON-SEQ records")
+	}
+	report := []byte(parts[1])
+	var signatures []reportSignature
+	for _, part := range parts[2:] {
+		part = strings.TrimSpace(part)
+		if part == "" {
+			continue
+		}
+		var signature reportSignature
+		if err := json.Unmarshal([]byte(part), &signature); err != nil {
+			return nil, nil, nil, err
+		}
+		signatures = append(signatures, signature)
+	}
+	return data, report, signatures, nil
+}
+
+func verifySignatures(report []byte, signatures []reportSignature, output string) (uploadResponse, error) {
+	var response uploadResponse
+	if len(signatures) == 0 {
+		return response, errors.New("report contains no signatures")
+	}
+	if err := os.MkdirAll(output, 0o700); err != nil {
+		return response, err
+	}
+	if err := os.WriteFile(filepath.Join(output, "report.json"), report, 0o600); err != nil {
+		return response, err
+	}
+	encodedSignature, err := json.Marshal(signatures[0])
+	if err != nil {
+		return response, err
+	}
+	if err := os.WriteFile(filepath.Join(output, "signature.json"), encodedSignature, 0o600); err != nil {
+		return response, err
+	}
+	digest := fmt.Sprintf("%x", sha256.Sum256(append([]byte{0x1e}, report...)))
+	if digest != signatures[0].SHA256 {
+		return response, fmt.Errorf("report digest %s does not match signature %s", digest, signatures[0].SHA256)
+	}
+	if signatures[0].Mechanism != "tpm2" {
+		return response, fmt.Errorf("unsupported signing mechanism %q", signatures[0].Mechanism)
+	}
+	if len(signatures[0].Data.Components) == 0 {
+		return response, errors.New("TPM report contains no components")
+	}
+	if err := os.MkdirAll(output, 0o700); err != nil {
+		return response, err
+	}
+	publicKey := filepath.Join(output, "public-key.pem")
+	if err := os.WriteFile(publicKey, []byte(signatures[0].Data.PublicKeyPEM), 0o600); err != nil {
+		return response, err
+	}
+	for index, component := range signatures[0].Data.Components {
+		if component.Signature.SigAlg != "RSASSA" {
+			return response, fmt.Errorf("unsupported signature algorithm %q", component.Signature.SigAlg)
+		}
+		message, err := marshalAttestation(component.Attest.Attest)
+		if err != nil {
+			return response, err
+		}
+		messagePath := filepath.Join(output, fmt.Sprintf("component-%d-attest.bin", index))
+		if err := os.WriteFile(messagePath, message, 0o600); err != nil {
+			return response, err
+		}
+		signature, err := hex.DecodeString(component.Signature.Inner.Sig)
+		if err != nil {
+			return response, err
+		}
+		signaturePath := filepath.Join(output, fmt.Sprintf("component-%d-signature.bin", index))
+		if err := os.WriteFile(signaturePath, signature, 0o600); err != nil {
+			return response, err
+		}
+		result, err := exec.Command("openssl", "dgst", "-sha256", "-verify", publicKey, "-signature", signaturePath, messagePath).CombinedOutput()
+		if err != nil {
+			return response, fmt.Errorf("TPM signature %d failed: %s", index, strings.TrimSpace(string(result)))
+		}
+		response.ComponentsVerified++
+	}
+	response.EventLogRecords = len(signatures[0].Data.EventLog)
+	if response.EventLogRecords == 0 {
+		return response, errors.New("TPM event log is empty")
+	}
+	for index, record := range signatures[0].Data.EventLog {
+		if len(record) == 0 || string(record) == "null" {
+			return response, fmt.Errorf("event log record %d is empty", index)
+		}
+	}
+	response.Status = "accepted"
+	return response, nil
+}
+
+func handler(output string) http.HandlerFunc {
+	return func(writer http.ResponseWriter, request *http.Request) {
+		writer.Header().Set("Content-Type", "application/json")
+		if request.Method != http.MethodPost && request.Method != http.MethodPut {
+			writer.WriteHeader(http.StatusMethodNotAllowed)
+			return
+		}
+		raw, report, signatures, err := decodeRecords(request.Body)
+		if err != nil {
+			writer.WriteHeader(http.StatusBadRequest)
+			_ = json.NewEncoder(writer).Encode(map[string]string{"error": err.Error()})
+			return
+		}
+		recordRequest(request, raw, report, signatures)
+		response, err := verifySignatures(report, signatures, output)
+		recordResult(response, err)
+		if err != nil {
+			writer.WriteHeader(http.StatusForbidden)
+			_ = json.NewEncoder(writer).Encode(map[string]string{"error": err.Error()})
+			return
+		}
+		if err := os.WriteFile(filepath.Join(output, "report.json"), report, 0o600); err != nil {
+			writer.WriteHeader(http.StatusInternalServerError)
+			return
+		}
+		encodedResponse, err := json.Marshal(response)
+		if err != nil {
+			writer.WriteHeader(http.StatusInternalServerError)
+			return
+		}
+		if err := os.WriteFile(filepath.Join(output, "response.json"), append(encodedResponse, '\n'), 0o600); err != nil {
+			writer.WriteHeader(http.StatusInternalServerError)
+			return
+		}
+		writer.WriteHeader(http.StatusOK)
+		_ = json.NewEncoder(writer).Encode(response)
+	}
+}
+
+func challengeHandler(store *tokenStore) http.HandlerFunc {
+	return func(writer http.ResponseWriter, request *http.Request) {
+		writer.Header().Set("Content-Type", "application/json")
+		if request.Method != http.MethodGet {
+			writer.WriteHeader(http.StatusMethodNotAllowed)
+			return
+		}
+		if store == nil {
+			writer.WriteHeader(http.StatusServiceUnavailable)
+			return
+		}
+		response, err := newNonce(store)
+		if err != nil {
+			writer.WriteHeader(http.StatusInternalServerError)
+			_ = json.NewEncoder(writer).Encode(map[string]string{"error": err.Error()})
+			return
+		}
+		_ = json.NewEncoder(writer).Encode(response)
+	}
+}
+
+func attestHandler(output string, store *tokenStore) http.HandlerFunc {
+	return func(writer http.ResponseWriter, request *http.Request) {
+		writer.Header().Set("Content-Type", "application/json")
+		if request.Method != http.MethodPost {
+			writer.WriteHeader(http.StatusMethodNotAllowed)
+			return
+		}
+		if store == nil {
+			writer.WriteHeader(http.StatusServiceUnavailable)
+			return
+		}
+		raw, report, signatures, err := decodeRecords(request.Body)
+		if err != nil {
+			writer.WriteHeader(http.StatusBadRequest)
+			_ = json.NewEncoder(writer).Encode(map[string]string{"error": err.Error()})
+			return
+		}
+		recordRequest(request, raw, report, signatures)
+		response, err := verifySignatures(report, signatures, output)
+		recordResult(response, err)
+		if err != nil {
+			writer.WriteHeader(http.StatusForbidden)
+			_ = json.NewEncoder(writer).Encode(map[string]string{"error": err.Error()})
+			return
+		}
+		nonce := request.Header.Get("X-Attestation-Nonce")
+		nonceBytes, err := base64.RawURLEncoding.DecodeString(nonce)
+		if err != nil || len(nonceBytes) != 32 {
+			writer.WriteHeader(http.StatusForbidden)
+			_ = json.NewEncoder(writer).Encode(map[string]string{"error": "invalid attestation nonce"})
+			return
+		}
+		provided, err := base64.RawURLEncoding.DecodeString(request.Header.Get("X-Attestation-Token"))
+		if err != nil || len(provided) != 256 {
+			writer.WriteHeader(http.StatusForbidden)
+			_ = json.NewEncoder(writer).Encode(map[string]string{"error": "invalid attestation token"})
+			return
+		}
+		store.Mutex.Lock()
+		defer store.Mutex.Unlock()
+		expires, ok := store.Nonces[nonce]
+		if !ok || time.Now().After(expires) {
+			writer.WriteHeader(http.StatusForbidden)
+			_ = json.NewEncoder(writer).Encode(map[string]string{"error": "attestation nonce is expired or already used"})
+			return
+		}
+		messagePath := filepath.Join(output, "attestation-message.bin")
+		message := append(nonceBytes, raw...)
+		if err := os.WriteFile(messagePath, message, 0o600); err != nil {
+			writer.WriteHeader(http.StatusInternalServerError)
+			return
+		}
+		signaturePath := filepath.Join(output, "attestation-token.bin")
+		if err := os.WriteFile(signaturePath, provided, 0o600); err != nil {
+			writer.WriteHeader(http.StatusInternalServerError)
+			return
+		}
+		publicKey := filepath.Join(output, "public-key.pem")
+		if err := verifyTokenSignature(publicKey, messagePath, signaturePath); err != nil {
+			recordResult(uploadResponse{}, err)
+			writer.WriteHeader(http.StatusForbidden)
+			_ = json.NewEncoder(writer).Encode(map[string]string{"error": err.Error()})
+			return
+		}
+		delete(store.Nonces, nonce)
+		encodedResponse, err := json.Marshal(response)
+		if err != nil {
+			writer.WriteHeader(http.StatusInternalServerError)
+			return
+		}
+		if err := os.WriteFile(filepath.Join(output, "response.json"), append(encodedResponse, '\n'), 0o600); err != nil {
+			writer.WriteHeader(http.StatusInternalServerError)
+			return
+		}
+		writer.WriteHeader(http.StatusOK)
+		_ = json.NewEncoder(writer).Encode(response)
+	}
+}
+
+func main() {
+	output := os.Getenv("RVA23_ATTESTATION_DIR")
+	if output == "" {
+		output = "output/rva23/host-attestation"
+	}
+	var store *tokenStore
+	if tokenPath := os.Getenv("RVA23_TOKEN_FILE"); tokenPath != "" {
+		var err error
+		store, err = loadTokenStore(tokenPath)
+		if err != nil {
+			panic(err)
+		}
+	}
+	server := &http.Server{
+		Addr:              "127.0.0.1:8080",
+		ReadHeaderTimeout: 5 * time.Second,
+		ReadTimeout:       30 * time.Second,
+		WriteTimeout:      30 * time.Second,
+		IdleTimeout:       60 * time.Second,
+		MaxHeaderBytes:    64 * 1024,
+	}
+	mux := http.NewServeMux()
+	mux.HandleFunc("/reports", handler(output))
+	mux.HandleFunc("/v1/challenge", challengeHandler(store))
+	mux.HandleFunc("/v1/attest", attestHandler(output, store))
+	mux.HandleFunc("/api/state", stateHandler)
+	mux.HandleFunc("/", func(writer http.ResponseWriter, request *http.Request) {
+		writer.Header().Set("Content-Type", "text/html; charset=utf-8")
+		_, _ = io.WriteString(writer, `<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Attestation receiver</title></head>
+<body><h1>Attestation receiver</h1><p>Latest request: <span id="updated">No request yet</span>. <a href="/api/state">JSON state</a>. <button id="refresh" type="button">Refresh</button></p>
+<p>The Go client in the VM sends <code>POST /v1/attest</code> through its local upload proxy. Expand a <code>/v1/attest</code> history entry to see its headers, nonce, token, and full JSON-SEQ body.</p>
+<p>systemd measures signed system extensions into PCR 13 as <code>Global system extension initrd</code>. Expand Sysext attestation to see those records. The history retains both <code>/reports</code> and <code>/v1/attest</code> requests in server memory.</p>
+<p><a href="https://www.freedesktop.org/software/systemd/man/latest/systemd-sysext.html">systemd-sysext documentation</a>. <a href="https://www.freedesktop.org/software/systemd/man/latest/systemd-report.html">systemd-report documentation</a>.</p>
+<details open><summary>Latest request</summary><div id="state">Loading…</div></details>
+<details open><summary>Sysext attestation</summary><div id="sysext">Loading…</div></details>
+<details open><summary>Request history</summary><div id="history">Loading…</div></details>
+<script>function render(item){const fragment=document.createDocumentFragment();for(const [name,value] of Object.entries(item||{}){const details=document.createElement('details');const summary=document.createElement('summary');summary.textContent=name;const pre=document.createElement('pre');pre.textContent=JSON.stringify(value,null,2);details.append(summary,pre);fragment.append(details)}const raw=document.createElement('details');const summary=document.createElement('summary');summary.textContent='Raw JSON';const pre=document.createElement('pre');pre.textContent=JSON.stringify(item,null,2);raw.append(summary,pre);fragment.append(raw);return fragment}async function refresh(){const data=await fetch('/api/state').then(response=>response.json());const latest=data.latest||{};document.getElementById('updated').textContent=latest.at||'No request yet';document.getElementById('state').replaceChildren(render(latest));document.getElementById('sysext').replaceChildren(render({records:latest.sysext||[]}));document.getElementById('history').replaceChildren(...(data.history||[]).map(item=>{const details=document.createElement('details');const summary=document.createElement('summary');summary.textContent=(item.at||'Unknown time')+' '+item.path+' '+((item.response&&item.response.status)||item.error||'pending');details.append(summary,render(item));return details}))}document.getElementById('refresh').onclick=refresh;refresh()</script></body></html>`)
+	})
+	server.Handler = mux
+	if err := server.ListenAndServe(); err != nil {
+		panic(err)
+	}
+}
