+
+type u2fConsent struct {
+	PublicKey   string `json:"publicKey"`
+	Certificate string `json:"certificate"`
+	Signature   string `json:"signature"`
+	Counter     uint32 `json:"counter"`
+}
+
+func (server *walletServer) verifyFido2Consent(input signRequest, message []byte, contractDigest string) error {
+	encoded, err := base64.RawURLEncoding.DecodeString(input.ConsentProof)
+	if err != nil {
+		return errors.New("invalid U2F consent encoding")
+	}
+	var proof u2fConsent
+	if err := json.Unmarshal(encoded, &proof); err != nil {
+		return errors.New("invalid U2F consent JSON")
+	}
+	certificate, err := base64.RawURLEncoding.DecodeString(proof.Certificate)
+	if err != nil {
+		return errors.New("invalid U2F certificate encoding")
+	}
+	expected, err := os.ReadFile(filepath.Join(server.consentDir, "u2f", "certificate.pem"))
+	if err != nil {
+		return err
+	}
+	block, _ := pem.Decode(expected)
+	if block == nil || !bytes.Equal(block.Bytes, certificate) {
+		return errors.New("U2F attestation certificate is not allowlisted")
+	}
+	signature, err := base64.RawURLEncoding.DecodeString(proof.Signature)
+	if err != nil {
+		return errors.New("invalid U2F signature encoding")
+	}
+	directory, err := os.MkdirTemp("", "rva23-u2f-public-")
+	if err != nil {
+		return err
+	}
+	defer os.RemoveAll(directory)
+	publicKey := filepath.Join(directory, "public.pem")
+	if err := os.WriteFile(publicKey, []byte(proof.PublicKey), 0o600); err != nil {
+		return err
+	}
+	application, err := hex.DecodeString(contractDigest)
+	if err != nil {
+		return err
+	}
+	nonce, err := base64.RawURLEncoding.DecodeString(input.Nonce)
+	if err != nil {
+		return err
+	}
+	counter := make([]byte, 4)
+	binary.BigEndian.PutUint32(counter, proof.Counter)
+	signed := append(application, 1)
+	signed = append(signed, counter...)
+	signed = append(signed, nonce...)
+	return verifySignature(publicKey, signed, signature)
+}
+
+type signatureMessage struct {
+	Nonce            string `json:"nonce"`
+	ContractID       string `json:"contractId"`
+	ContractSHA256   string `json:"contractSha256"`
+	ConsentMethod    string `json:"consentMethod"`
+	ConsentProof     string `json:"consentProof"`
+	AttestationNonce string `json:"attestationNonce"`
+	AttestationToken string `json:"attestationToken"`
+	ReportSHA256     string `json:"reportSha256"`
+	PCR11            string `json:"pcr11"`
+}
+
+type signResponse struct {
+	Status         string `json:"status"`
+	ContractID     string `json:"contractId"`
+	Tier           int    `json:"tier"`
+	AmountCents    int64  `json:"amountCents"`
+	DailyUsedCents int64  `json:"dailyUsedCents"`
+	Consent        string `json:"consent"`
+}
+
+type requestRecord struct {
+	At         time.Time     `json:"at"`
+	BodyBase64 string        `json:"bodyBase64"`
+	Contract   *contract     `json:"contract"`
+	Consent    string        `json:"consent"`
+	Device     string        `json:"device"`
+	Evidence   *evidence     `json:"evidence"`
+	Response   *signResponse `json:"response"`
+	Error      string        `json:"error"`
+}
+
+type stateResponse struct {
+	Latest  *requestRecord  `json:"latest"`
+	History []requestRecord `json:"history"`
+}
+
+type walletServer struct {
+	walletDir      string
+	attestationURL string
+	keyFile        string
+	consentDir     string
+	profiles       map[string]string
+	client         *http.Client
+	mutex          sync.Mutex
+	nonces         map[string]time.Time
+	usage          map[string]int64
+	stateMutex     sync.RWMutex
+	latest         *requestRecord
+	history        []requestRecord
+}
+
+var contracts = []contract{
+	{
+		ID:              "small-payment",
+		Tier:            0,
+		Title:           "Small payment",
+		Body:            "Authorize a payment of 20000 cents with a daily limit of 25000 cents.",
+		AmountCents:     20000,
+		DailyLimitCents: 25000,
+	},
+	{
+		ID:              "development-payment",
+		Tier:            1,
+		Title:           "Development payment",
+		Body:            "Authorize a payment of 30000 cents with a daily limit of 100000 cents.",
+		AmountCents:     30000,
+		DailyLimitCents: 100000,
+	},
+	{
+		ID:              "mortgage",
+		Tier:            2,
+		Title:           "Mortgage",
+		Body:            "Authorize the mortgage agreement without a payment or a daily limit.",
+		AmountCents:     0,
+		DailyLimitCents: 0,
+	},
+}
+
+func environment(name, fallback string) string {
+	if value := os.Getenv(name); value != "" {
+		return value
+	}
+	return fallback
+}
+
+func sha256Hex(data []byte) string {
+	digest := sha256.Sum256(data)
+	return hex.EncodeToString(digest[:])
+}
+
+func findContract(id string) *contract {
+	for index := range contracts {
+		if contracts[index].ID == id {
+			selected := contracts[index]
+			return &selected
+		}
+	}
+	return nil
+}
+
+func loadProfiles(path string) (map[string]string, error) {
