From a2a3aec7dd72772b1e06dd16b0af48b882b33305 Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Tue, 03 Nov 2026 23:33:24 -0700
Subject: [PATCH] feat: Add PoC Go attestation servers and clients and example wallet
---
diff --git a/buildroot/qemu/scripts/attested-client.go b/buildroot/qemu/scripts/attested-client.go
new file mode 100644
index 0000000000000000000000000000000000000000..9bdbb997e363f587b92c6f3aae2ecc30c7efae03
--- /dev/null
+++ b/buildroot/qemu/scripts/attested-client.go
@@ -0,0 +1,212 @@
+package main
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/exec"
+	"strings"
+	"time"
+)
+
+type challengeResponse struct {
+	Nonce     string    `json:"nonce"`
+	ExpiresAt time.Time `json:"expiresAt"`
+}
+
+func readBody(path string) ([]byte, error) {
+	return os.ReadFile(path)
+}
+
+func getChallenge(client *http.Client, baseURL string) (challengeResponse, error) {
+	var response challengeResponse
+	request, err := http.NewRequest(http.MethodGet, baseURL+"/v1/challenge", nil)
+	if err != nil {
+		return response, err
+	}
+	result, err := client.Do(request)
+	if err != nil {
+		return response, err
+	}
+	defer result.Body.Close()
+	if result.StatusCode != http.StatusOK {
+		return response, fmt.Errorf("challenge failed with %s", result.Status)
+	}
+	if err := json.NewDecoder(result.Body).Decode(&response); err != nil {
+		return response, err
+	}
+	return response, nil
+}
+
+func uploadReport(client *http.Client, baseURL string, challenge challengeResponse) error {
+	nonce, err := base64.RawURLEncoding.DecodeString(challenge.Nonce)
+	if err != nil {
+		return err
+	}
+	handler := func(writer http.ResponseWriter, request *http.Request) {
+		report, err := io.ReadAll(request.Body)
+		if err != nil {
+			http.Error(writer, err.Error(), http.StatusBadRequest)
+			return
+		}
+		token, err := tokenFor(nonce, report)
+		if err != nil {
+			http.Error(writer, err.Error(), http.StatusInternalServerError)
+			return
+		}
+		if err := os.WriteFile("/tmp/rva23-attested-body", report, 0o600); err != nil {
+			http.Error(writer, err.Error(), http.StatusInternalServerError)
+			return
+		}
+		if err := os.WriteFile("/tmp/rva23-attested-nonce", []byte(challenge.Nonce), 0o600); err != nil {
+			http.Error(writer, err.Error(), http.StatusInternalServerError)
+			return
+		}
+		if err := os.WriteFile("/tmp/rva23-attested-token", []byte(token), 0o600); err != nil {
+			http.Error(writer, err.Error(), http.StatusInternalServerError)
+			return
+		}
+		if os.Getenv("RVA23_ATTESTATION_CAPTURE") == "1" {
+			writer.WriteHeader(http.StatusOK)
+			return
+		}
+		if err := postAttestation(client, baseURL, challenge.Nonce, token, report); err != nil {
+			http.Error(writer, err.Error(), http.StatusForbidden)
+			return
+		}
+		writer.WriteHeader(http.StatusOK)
+	}
+	server := &http.Server{Addr: "127.0.0.1:18080", Handler: http.HandlerFunc(handler)}
+	go func() {
+		_ = server.ListenAndServe()
+	}()
+	defer server.Close()
+	time.Sleep(100 * time.Millisecond)
+	command := exec.Command("/usr/lib/systemd/systemd-report", "upload", "--url=http://127.0.0.1:18080/v1/attest", "--sign=require-one")
+	if result, err := command.CombinedOutput(); err != nil {
+		return fmt.Errorf("upload report: %s", result)
+	}
+	return nil
+}
+
+func tokenFor(nonce, report []byte) (string, error) {
+	input, err := os.CreateTemp("", "rva23-attestation-")
+	if err != nil {
+		return "", err
+	}
+	path := input.Name()
+	defer os.Remove(path)
+	if _, err := input.Write(nonce); err != nil {
+		input.Close()
+		return "", err
+	}
+	if _, err := input.Write(report); err != nil {
+		input.Close()
+		return "", err
+	}
+	if err := input.Close(); err != nil {
+		return "", err
+	}
+	handle, err := os.ReadFile("/var/lib/systemd/report.sign.tpm2/default.key")
+	if err != nil {
+		return "", err
+	}
+	var keyData struct {
+		Handle string `json:"handle"`
+	}
+	if err := json.Unmarshal(handle, &keyData); err != nil {
+		return "", err
+	}
+	serialized, err := base64.StdEncoding.DecodeString(keyData.Handle)
+	if err != nil || len(serialized) < 4 {
+		return "", errors.New("invalid persistent AK handle")
+	}
+	handleID := fmt.Sprintf("0x%08x", binary.BigEndian.Uint32(serialized[:4]))
+	output, err := os.CreateTemp("", "rva23-token-")
+	if err != nil {
+		return "", err
+	}
+	tokenPath := output.Name()
+	output.Close()
+	defer os.Remove(tokenPath)
+	command := exec.Command("tpm2_sign", "-c", handleID, "-g", "sha256", "-s", "rsassa", "-o", tokenPath, path)
+	if result, err := command.CombinedOutput(); err != nil {
+		return "", fmt.Errorf("tpm2_sign: %s", result)
+	}
+	token, err := os.ReadFile(tokenPath)
+	if err != nil {
+		return "", err
+	}
+	if len(token) < 256 {
+		return "", errors.New("short TPM token signature")
+	}
+	return base64.RawURLEncoding.EncodeToString(token[len(token)-256:]), nil
+}
+
+func postAttestation(client *http.Client, baseURL, nonce, token string, report []byte) error {
+	request, err := http.NewRequest(http.MethodPost, baseURL+"/v1/attest", bytes.NewReader(report))
+	if err != nil {
+		return err
+	}
+	request.Header.Set("Content-Type", "application/json")
+	request.Header.Set("X-Attestation-Nonce", nonce)
+	request.Header.Set("X-Attestation-Token", token)
+	result, err := client.Do(request)
+	if err != nil {
+		return err
+	}
+	defer result.Body.Close()
+	body, err := io.ReadAll(result.Body)
+	if err != nil {
+		return err
+	}
+	if result.StatusCode < 200 || result.StatusCode >= 300 {
+		return fmt.Errorf("attestation failed with %s: %s", result.Status, body)
+	}
+	fmt.Println(string(body))
+	return nil
+}
+
+func run() error {
+	baseURL := os.Getenv("RVA23_ATTESTATION_URL")
+	if baseURL == "" {
+		baseURL = "http://10.0.2.2:8080"
+	}
+	client := &http.Client{Timeout: 30 * time.Second}
+	if len(os.Args) > 1 && os.Args[1] == "--replay" {
+		report, err := readBody("/tmp/rva23-attested-body")
+		if err != nil {
+			return err
+		}
+		nonce, err := readBody("/tmp/rva23-attested-nonce")
+		if err != nil {
+			return err
+		}
+		token, err := readBody("/tmp/rva23-attested-token")
+		if err != nil {
+			return err
+		}
+		return postAttestation(client, baseURL, strings.TrimSpace(string(nonce)), strings.TrimSpace(string(token)), report)
+	}
+	challenge, err := getChallenge(client, baseURL)
+	if err != nil {
+		return fmt.Errorf("challenge: %w", err)
+	}
+	if time.Now().After(challenge.ExpiresAt) {
+		return errors.New("attestation challenge expired")
+	}
+	return uploadReport(client, baseURL, challenge)
+}
+
+func main() {
+	if err := run(); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
diff --git a/buildroot/qemu/scripts/consent-emulator.go b/buildroot/qemu/scripts/consent-emulator.go
new file mode 100644
index 0000000000000000000000000000000000000000..15d1769848bba0cf3566f038fb4c56c66c6a28ef
--- /dev/null
+++ b/buildroot/qemu/scripts/consent-emulator.go
@@ -0,0 +1,221 @@
+package main
+
+import (
+	"crypto"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/json"
+	"encoding/pem"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"log"
+	"net/http"
+	"os"
+	"sync"
+	"time"
+)
+
+type signRequest struct {
+	Nonce          string `json:"nonce"`
+	ContractID     string `json:"contractId"`
+	ContractSHA256 string `json:"contractSha256"`
+	Method         string `json:"method"`
+}
+
+type lastRequest struct {
+	Method         string `json:"method"`
+	Nonce          string `json:"nonce"`
+	ContractID     string `json:"contractId"`
+	ContractSHA256 string `json:"contractSha256"`
+	Time           string `json:"time"`
+}
+
+type requestState struct {
+	mu   sync.RWMutex
+	last lastRequest
+}
+
+func main() {
+	listen := flag.String("listen", "127.0.0.1:8082", "HTTP listen address")
+	keyPath := flag.String("key", "", "private RSA PEM path")
+	publicPath := flag.String("public", "", "public RSA PEM path")
+	kind := flag.String("kind", "smartcard", "consent method kind")
+	flag.Parse()
+	if *keyPath == "" {
+		log.Fatal("cannot sign request without a private RSA PEM path")
+	}
+	if *kind != "smartcard" && *kind != "fido2" {
+		log.Fatal("-kind must be smartcard or fido2")
+	}
+	privateKey, err := readPrivateKey(*keyPath)
+	if err != nil {
+		log.Fatal(err)
+	}
+	publicKey := &privateKey.PublicKey
+	if *publicPath != "" {
+		publicKey, err = readPublicKey(*publicPath)
+		if err != nil {
+			log.Fatal(err)
+		}
+		if publicKey.N.Cmp(privateKey.PublicKey.N) != 0 || publicKey.E != privateKey.PublicKey.E {
+			log.Fatal("public and private RSA keys do not match")
+		}
+	}
+	encodedPublic, err := x509.MarshalPKIXPublicKey(publicKey)
+	if err != nil {
+		log.Fatal(err)
+	}
+	publicPEM := pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: encodedPublic})
+	state := &requestState{}
+	mux := http.NewServeMux()
+	mux.HandleFunc("/public-key", func(writer http.ResponseWriter, request *http.Request) {
+		if request.Method != http.MethodGet {
+			writer.Header().Set("Allow", http.MethodGet)
+			writeJSON(writer, http.StatusMethodNotAllowed, map[string]string{"error": "method not allowed"})
+			return
+		}
+		writer.Header().Set("Content-Type", "application/x-pem-file")
+		_, _ = writer.Write(publicPEM)
+	})
+	mux.HandleFunc("/", func(writer http.ResponseWriter, request *http.Request) {
+		if request.URL.Path != "/" {
+			writeJSON(writer, http.StatusNotFound, map[string]string{"error": "not found"})
+			return
+		}
+		if request.Method != http.MethodGet {
+			writer.Header().Set("Allow", http.MethodGet)
+			writeJSON(writer, http.StatusMethodNotAllowed, map[string]string{"error": "method not allowed"})
+			return
+		}
+		writeJSON(writer, http.StatusOK, map[string]string{"kind": *kind, "status": "ok"})
+	})
+	mux.HandleFunc("/sign", func(writer http.ResponseWriter, request *http.Request) {
+		if request.Method != http.MethodPost {
+			writer.Header().Set("Allow", http.MethodPost)
+			writeJSON(writer, http.StatusMethodNotAllowed, map[string]string{"error": "method not allowed"})
+			return
+		}
+		decoder := json.NewDecoder(http.MaxBytesReader(writer, request.Body, 1024*1024))
+		decoder.DisallowUnknownFields()
+		var input signRequest
+		if err := decoder.Decode(&input); err != nil {
+			writeJSON(writer, http.StatusBadRequest, map[string]string{"error": "invalid JSON request"})
+			return
+		}
+		if err := decoder.Decode(&struct{}{}); err != io.EOF {
+			writeJSON(writer, http.StatusBadRequest, map[string]string{"error": "multiple JSON values are not allowed"})
+			return
+		}
+		if input.Nonce == "" || input.ContractID == "" || input.ContractSHA256 == "" || input.Method == "" {
+			writeJSON(writer, http.StatusBadRequest, map[string]string{"error": "nonce, contractId, contractSha256, and method are required"})
+			return
+		}
+		message, err := json.Marshal(input)
+		if err != nil {
+			writeJSON(writer, http.StatusInternalServerError, map[string]string{"error": "cannot sign request"})
+			return
+		}
+		digest := sha256.Sum256(message)
+		signature, err := rsa.SignPKCS1v15(rand.Reader, privateKey, crypto.SHA256, digest[:])
+		if err != nil {
+			writeJSON(writer, http.StatusInternalServerError, map[string]string{"error": "cannot sign request"})
+			return
+		}
+		state.mu.Lock()
+		state.last = lastRequest{
+			Method:         input.Method,
+			Nonce:          input.Nonce,
+			ContractID:     input.ContractID,
+			ContractSHA256: input.ContractSHA256,
+			Time:           time.Now().UTC().Format(time.RFC3339Nano),
+		}
+		state.mu.Unlock()
+		writeJSON(writer, http.StatusOK, map[string]string{"signature": base64.RawURLEncoding.EncodeToString(signature)})
+	})
+	mux.HandleFunc("/status", func(writer http.ResponseWriter, request *http.Request) {
+		if request.Method != http.MethodGet {
+			writer.Header().Set("Allow", http.MethodGet)
+			writeJSON(writer, http.StatusMethodNotAllowed, map[string]string{"error": "method not allowed"})
+			return
+		}
+		state.mu.RLock()
+		last := state.last
+		state.mu.RUnlock()
+		writeJSON(writer, http.StatusOK, last)
+	})
+	server := &http.Server{
+		Addr:              *listen,
+		Handler:           mux,
+		ReadHeaderTimeout: 5 * time.Second,
+		ReadTimeout:       10 * time.Second,
+		WriteTimeout:      10 * time.Second,
+		IdleTimeout:       60 * time.Second,
+	}
+	log.Printf("consent emulator listening on %s", *listen)
+	log.Fatal(server.ListenAndServe())
+}
+
+func readPrivateKey(path string) (*rsa.PrivateKey, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("read private key: %w", err)
+	}
+	block, _ := pem.Decode(data)
+	if block == nil {
+		return nil, errors.New("private key is not PEM")
+	}
+	privateKey, err := x509.ParsePKCS1PrivateKey(block.Bytes)
+	if err == nil {
+		if err := privateKey.Validate(); err != nil {
+			return nil, fmt.Errorf("validate private key: %w", err)
+		}
+		return privateKey, nil
+	}
+	parsed, err := x509.ParsePKCS8PrivateKey(block.Bytes)
+	if err != nil {
+		return nil, fmt.Errorf("parse private key: %w", err)
+	}
+	privateKey, ok := parsed.(*rsa.PrivateKey)
+	if !ok {
+		return nil, errors.New("private key is not RSA")
+	}
+	if err := privateKey.Validate(); err != nil {
+		return nil, fmt.Errorf("validate private key: %w", err)
+	}
+	return privateKey, nil
+}
+
+func readPublicKey(path string) (*rsa.PublicKey, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("read public key: %w", err)
+	}
+	block, _ := pem.Decode(data)
+	if block == nil {
+		return nil, errors.New("public key is not PEM")
+	}
+	publicKey, err := x509.ParsePKCS1PublicKey(block.Bytes)
+	if err == nil {
+		return publicKey, nil
+	}
+	parsed, err := x509.ParsePKIXPublicKey(block.Bytes)
+	if err != nil {
+		return nil, fmt.Errorf("parse public key: %w", err)
+	}
+	publicKey, ok := parsed.(*rsa.PublicKey)
+	if !ok {
+		return nil, errors.New("public key is not RSA")
+	}
+	return publicKey, nil
+}
+
+func writeJSON(writer http.ResponseWriter, status int, value any) {
+	writer.Header().Set("Content-Type", "application/json")
+	writer.WriteHeader(status)
+	_ = json.NewEncoder(writer).Encode(value)
+}
