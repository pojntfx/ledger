 package svc
 
 import (
+	"context"
 	"crypto/sha256"
 	"encoding/hex"
 	"encoding/json"
 	"errors"
+	"fmt"
 	"io"
 	"net/http"
 	"os"
@@ -28,6 +30,54 @@
 var (
 	ErrInvalidFileName = errors.New(`file name must be usable as a bare file name like "image.img", without any directories and without a leading dash`)
 )
+
+// baseURLContextKey carries the base URL a request came in on, so that a tool
+// can advertise an upload command that points back at the same server
+type baseURLContextKey struct{}
+
+// RequestBaseURL derives the scheme and host that a request reached the server
+// on, honoring a reverse proxy's X-Forwarded-* headers
+func RequestBaseURL(r *http.Request) string {
+	scheme := "http"
+	if r.TLS != nil {
+		scheme = "https"
+	}
+	// A proxy can forward several hops as a comma-separated list; the first is
+	// the one closest to the client
+	if proto := r.Header.Get("X-Forwarded-Proto"); proto != "" {
+		scheme = strings.TrimSpace(strings.Split(proto, ",")[0])
+	}
+
+	host := r.Host
+	if forwarded := r.Header.Get("X-Forwarded-Host"); forwarded != "" {
+		host = strings.TrimSpace(strings.Split(forwarded, ",")[0])
+	}
+
+	if host == "" {
+		return ""
+	}
+
+	return scheme + "://" + host
+}
+
+// WithRequestBaseURL stashes the request's base URL for the tool handlers to
+// read back with uploadCommand
+func WithRequestBaseURL(ctx context.Context, baseURL string) context.Context {
+	return context.WithValue(ctx, baseURLContextKey{}, baseURL)
+}
+
+// uploadCommand builds the ready-to-run command that uploads a file to this
+// server; LOCAL_PATH and NAME are the only placeholders the caller fills in. It
+// prefers the configured public URL and falls back to the URL the request came
+// in on
+func (s *Service) uploadCommand(ctx context.Context) string {
+	baseURL := s.publicURL
+	if baseURL == "" {
+		baseURL, _ = ctx.Value(baseURLContextKey{}).(string)
+	}
+
+	return fmt.Sprintf("curl --fail --upload-file LOCAL_PATH %s%sNAME", baseURL, FilesUploadPath)
+}
 
