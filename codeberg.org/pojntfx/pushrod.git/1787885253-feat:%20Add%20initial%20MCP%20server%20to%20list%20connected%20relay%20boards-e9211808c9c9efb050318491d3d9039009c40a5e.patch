--- /dev/null
+++ b/main.go
@@ -0,0 +1,41 @@
+package main
+
+import (
+	"flag"
+	"log"
+	"net/http"
+
+	"codeberg.org/pojntfx/pushrod/pkg/relay"
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+func main() {
+	laddr := flag.String("laddr", ":1337", "Listen address")
+
+	flag.Parse()
+
+	server := mcp.NewServer(
+		&mcp.Implementation{
+			Name:        "pushrod",
+			Title:       "Pushrod",
+			Description: "Hands-off hardware enablement for SpacemiT K3-based systems.",
+			Version:     "1.0.0",
+			WebsiteURL:  "https://codeberg.org/pojntfx/pushrod",
+		},
+		nil,
+	)
+	mcp.AddTool(server, relay.GetConnectedBoardsTool, relay.GetConnectedBoards)
+
+	log.Println("Listening on", *laddr)
+
+	// TODO: Run defer handlers in server (ctx listener) to release any open relays and make sure to power them all off
+
+	panic(
+		http.ListenAndServe(
+			*laddr,
+			mcp.NewStreamableHTTPHandler(func(r *http.Request) *mcp.Server {
+				return server
+			}, nil),
+		),
+	)
+}
