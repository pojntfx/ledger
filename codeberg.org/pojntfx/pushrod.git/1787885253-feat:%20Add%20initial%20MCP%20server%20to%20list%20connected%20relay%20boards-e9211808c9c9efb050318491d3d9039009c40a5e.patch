+package relay
+
+const (
+	// See https://the-sz.com/products/usbid/index.php?v=0x16c0&p=0x05df&n=
+	// and https://opentracelab.github.io/website/hardware/multiplexer/dcttech-usbrelay/
+	USB_RELAY_4_VENDOR_ID  = 0x16c0
+	USB_RELAY_4_PRODUCT_ID = 0x05df
+)
diff --git a/pkg/relay/server.go b/pkg/relay/server.go
new file mode 100644
index 0000000000000000000000000000000000000000..6671d9eead38a4adec8effb0d05c8a1d63502683
--- /dev/null
+++ b/pkg/relay/server.go
@@ -0,0 +1,44 @@
+package relay
+
+import (
+	"context"
+
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+	"rafaelmartins.com/p/usbhid"
+)
+
+type Board struct {
+	Path    string `json:"path" jsonschema:"path that uniquely identifies the board until it gets unplugged"`
+	IsInUse bool   `json:"isInUse" jsonschema:"whether the board is currently in use or not"`
+}
+
+type Output struct {
+	Boards []Board `json:"devices" jsonschema:"connected boards"`
+}
+
+var (
+	GetConnectedBoardsTool = &mcp.Tool{
+		Name:        "getConnectedBoards",
+		Title:       "Get connected boards",
+		Description: "Get all currently connected boards",
+	}
+)
+
+func GetConnectedBoards(ctx context.Context, req *mcp.CallToolRequest, input struct{}) (*mcp.CallToolResult, []Board, error) {
+	devices, err := usbhid.Enumerate(func(d *usbhid.Device) bool {
+		return d.VendorId() == USB_RELAY_4_VENDOR_ID && d.ProductId() == USB_RELAY_4_PRODUCT_ID
+	})
+	if err != nil {
+		return nil, []Board{}, err
+	}
+
+	boards := make([]Board, len(devices))
+	for i, device := range devices {
+		boards[i] = Board{
+			Path:    device.Path(),
+			IsInUse: device.IsOpen(),
+		}
+	}
+
+	return nil, boards, nil
+}

