--- /dev/null
+++ b/cmd/pushrodctl/main.go
@@ -0,0 +1,51 @@
+package main
+
+import (
+	"context"
+	"flag"
+	"log"
+	"os"
+
+	"codeberg.org/pojntfx/pushrod/pkg/relay"
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+	"go.yaml.in/yaml/v4"
+)
+
+func main() {
+	rurl := flag.String("rurl", "http://localhost:1337", "Remote URL")
+
+	flag.Parse()
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	client := mcp.NewClient(
+		&mcp.Implementation{},
+		nil,
+	)
+
+	session, err := client.Connect(
+		ctx,
+		&mcp.StreamableClientTransport{
+			Endpoint: *rurl,
+		},
+		nil,
+	)
+	if err != nil {
+		panic(err)
+	}
+	defer session.Close()
+
+	log.Println("Connected to", *rurl, "with session", session.ID())
+
+	res, err := session.CallTool(ctx, &mcp.CallToolParams{
+		Name: relay.GetConnectedBoardsTool.Name,
+	})
+	if err != nil {
+		panic(err)
+	}
+
+	if err := yaml.NewEncoder(os.Stdout).Encode(res); err != nil {
+		panic(err)
+	}
+}
