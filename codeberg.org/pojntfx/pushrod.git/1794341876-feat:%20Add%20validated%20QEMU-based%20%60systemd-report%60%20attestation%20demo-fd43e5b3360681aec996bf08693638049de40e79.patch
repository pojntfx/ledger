diff --git a/buildroot/scripts/4-demo-attestation-qemu.py b/buildroot/scripts/4-demo-attestation-qemu.py
new file mode 100755
index 0000000000000000000000000000000000000000..4087d47060d1e6a083ab3c2eb42756c66789a8ab
--- /dev/null
+++ b/buildroot/scripts/4-demo-attestation-qemu.py
@@ -0,0 +1,50 @@
+#!/usr/bin/env python3
+from pathlib import Path
+import re
+import sys
+
+sys.path.insert(0, str(Path(__file__).parent))
+
+import demo_lib
+import demo_qemu_warm as warm
+
+
+def main():
+    demo = demo_lib.Demo(
+        "Demo 4b: the QEMU chain",
+        "SPL boots only a signed FIT, systemd-boot measures the UKI, and the guest sends a quote",
+    )
+    demo.banner()
+    demo.cue(f"Watch the event view: {demo_lib.EVENT_UI}")
+    demo.ui("event view", demo_lib.EVENT_UI)
+    demo.ui("report receiver", demo_lib.REPORT_UI)
+
+    demo.step("Attach to the warm guest")
+    guest, cold = warm.ensure("firmware")
+    if cold:
+        demo.note("the guest booted cold; pre-start it with make demo-qemu-warm to skip this wait")
+    demo.result("the guest is at a root shell")
+
+    demo.step("Restart the userspace signer inside the guest")
+    warm.run(demo, guest, "systemctl restart systemd-pcrlock.socket")
+    warm.run(demo, guest, "systemctl restart systemd-report-sign-tpm2.socket", lines=0)
+    demo.result("the signer is up")
+
+    demo.step("Upload a signed report to the verifier")
+    output = warm.run(demo, guest, "/usr/lib/systemd/systemd-report upload --url=http://10.0.2.2:8080/reports --sign=require-one", 300, lines=6)
+    match = re.search(r"finished successfully with code (\d+): (\{.*\})", output)
+    if not match:
+        raise demo_lib.DemoError(output[-1500:])
+    code, body = match.group(1), match.group(2)
+    demo.result(f"receiver answered {code}: {body}")
+
+    demo.step("Read the receipt in the unified view")
+    state = demo_lib.event_state()
+    demo.result(f"{len(state.get('events', []))} receipts in the view")
+
+    demo.payoff("The guest proved a firmware-measured boot chain and the receiver accepted it")
+    return demo.finish()
+
+
+if __name__ == "__main__":
+    demo_lib.run(main)
diff --git a/buildroot/scripts/demo_lib.py b/buildroot/scripts/demo_lib.py
