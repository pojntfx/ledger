+func (s *Service) listConsoles() ([]Console, error) {
 	ports, err := enumerator.GetDetailedPortsList()
 	if err != nil {
-		return nil, nil, err
+		return nil, err
 	}
 
 	consoles := []Console{}
+	enumerated := map[string]bool{}
 	for _, port := range ports {
 		if !port.IsUSB || isKVMInput(port) {
 			continue
 		}
 
-		consoles = append(consoles, Console{
-			Path:        port.Name,
-			USBIdentity: usbIdentityFromPort(port),
-		})
+		enumerated[port.Name] = true
+
+		console := s.getConsole(port)
+
+		console.lock.Lock()
+		state := console.state()
+		console.lock.Unlock()
+
+		consoles = append(consoles, state)
+	}
+
+	s.pruneConsoles(enumerated)
+
+	return consoles, nil
+}
+
+func (s *Service) pruneConsoles(enumerated map[string]bool) {
+	s.consolesLock.Lock()
+	defer s.consolesLock.Unlock()
+
+	for path, console := range s.consoles {
+		if enumerated[path] {
+			continue
+		}
+
+		console.lock.Lock()
+		stopped := console.port == nil
+		console.lock.Unlock()
+
+		if stopped {
+			delete(s.consoles, path)
+		}
+	}
+}
+
+func (s *Service) findConsole(path string) (*serialConsole, error) {
+	ports, err := enumerator.GetDetailedPortsList()
+	if err != nil {
+		return nil, err
+	}
+
+	for _, port := range ports {
+		if !port.IsUSB || isKVMInput(port) || port.Name != path {
+			continue
+		}
+
+		return s.getConsole(port), nil
+	}
+
+	return nil, ErrCouldNotFindConsole
+}
+
+func (s *Service) GetConsoles(ctx context.Context, req *mcp.CallToolRequest, input struct{}) (*mcp.CallToolResult, *GetConsolesOutput, error) {
+	consoles, err := s.listConsoles()
+	if err != nil {
+		return nil, nil, err
 	}
 
 	return nil, &GetConsolesOutput{
diff --git a/pkg/svc/serial_start_buffering.go b/pkg/svc/serial_start_buffering.go
new file mode 100644
index 0000000000000000000000000000000000000000..a76fca8bbe70497feb0fb1b85ec1a9ae7cbf0954
--- /dev/null
+++ b/pkg/svc/serial_start_buffering.go
@@ -0,0 +1,38 @@
+package svc
+
+import (
+	"context"
+
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+var (
+	StartBufferingTool = &mcp.Tool{
+		Name:        "serial.startBuffering",
+		Title:       "Start buffering serial console",
+		Description: "Start capturing a serial console's output, opening the console if needed; call this before resetting or powering on the target so that its boot log is captured. Consoles keep buffering until serial.stopBuffering is called or the server exits",
+		Annotations: &mcp.ToolAnnotations{DestructiveHint: &[]bool{false}[0]},
+	}
+)
+
+type StartBufferingInput struct {
+	Path string `json:"path" jsonschema:"path that uniquely identifies the serial console until it gets unplugged"`
+}
+
+func (s *Service) StartBuffering(ctx context.Context, req *mcp.CallToolRequest, input StartBufferingInput) (*mcp.CallToolResult, *GetConsolesOutput, error) {
+	console, err := s.findConsole(input.Path)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	console.lock.Lock()
+	defer console.lock.Unlock()
+
+	if err := s.openConsoleLocked(console); err != nil {
+		return nil, nil, err
+	}
+
+	return nil, &GetConsolesOutput{
+		Consoles: []Console{console.state()},
+	}, nil
+}
diff --git a/pkg/svc/serial_stop_buffering.go b/pkg/svc/serial_stop_buffering.go
new file mode 100644
index 0000000000000000000000000000000000000000..2ea4d92c85bc9ce8c010afef2341cef0cae1c1ed
--- /dev/null
+++ b/pkg/svc/serial_stop_buffering.go
@@ -0,0 +1,39 @@
+package svc
+
+import (
+	"context"
+
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+var (
+	StopBufferingTool = &mcp.Tool{
+		Name:        "serial.stopBuffering",
+		Title:       "Stop buffering serial console",
+		Description: "Stop capturing a serial console's output and close the console; the output captured so far stays available",
+		Annotations: &mcp.ToolAnnotations{DestructiveHint: &[]bool{false}[0]},
+	}
+)
+
+type StopBufferingInput struct {
+	Path string `json:"path" jsonschema:"path that uniquely identifies the serial console until it gets unplugged"`
+}
+
+func (s *Service) StopBuffering(ctx context.Context, req *mcp.CallToolRequest, input StopBufferingInput) (*mcp.CallToolResult, *GetConsolesOutput, error) {
+	console, err := s.findConsole(input.Path)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	console.lock.Lock()
+	defer console.lock.Unlock()
+
+	if console.port != nil {
+		console.port.Close()
+		console.port = nil
+	}
+
+	return nil, &GetConsolesOutput{
+		Consoles: []Console{console.state()},
+	}, nil
+}

