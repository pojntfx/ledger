diff --git a/pkg/svc/serial.go b/pkg/svc/serial.go
new file mode 100644
index 0000000000000000000000000000000000000000..5dd099e8e560f728eb8e0b6b8120d79db262d22f
--- /dev/null
+++ b/pkg/svc/serial.go
@@ -0,0 +1,108 @@
+package svc
+
+import (
+	"io"
+	"log/slog"
+	"slices"
+	"sync"
+
+	"go.bug.st/serial"
+	"go.bug.st/serial/enumerator"
+)
+
+const (
+	consoleBaudRate = 115200
+
+	maxConsoleBuffer = 1 << 20
+)
+
+type serialConsole struct {
+	path     string
+	identity USBIdentity
+
+	port serial.Port
+
+	buffer []byte
+
+	lock *sync.Mutex
+}
+
+func newSerialConsole(port *enumerator.PortDetails) *serialConsole {
+	return &serialConsole{
+		path:     port.Name,
+		identity: usbIdentityFromPort(port),
+		lock:     &sync.Mutex{},
+	}
+}
+
+func (c *serialConsole) Write(data []byte) (int, error) {
+	c.lock.Lock()
+	defer c.lock.Unlock()
+
+	c.buffer = append(c.buffer, data...)
+
+	if len(c.buffer) > maxConsoleBuffer {
+		c.buffer = slices.Clone(c.buffer[len(c.buffer)-maxConsoleBuffer/2:])
+	}
+
+	return len(data), nil
+}
+
+func (c *serialConsole) state() Console {
+	return Console{
+		Path:          c.path,
+		USBIdentity:   c.identity,
+		IsBuffering:   c.port != nil,
+		BufferedBytes: len(c.buffer),
+	}
+}
+
+func (s *Service) getConsole(port *enumerator.PortDetails) *serialConsole {
+	s.consolesLock.Lock()
+	defer s.consolesLock.Unlock()
+
+	console, ok := s.consoles[port.Name]
+	if !ok {
+		console = newSerialConsole(port)
+		s.consoles[port.Name] = console
+	}
+
+	return console
+}
+
+func (s *Service) openConsoleLocked(console *serialConsole) error {
+	if console.port != nil {
+		return nil
+	}
+
+	port, err := serial.Open(console.path, &serial.Mode{BaudRate: consoleBaudRate, DataBits: 8})
+	if err != nil {
+		return err
+	}
+
+	console.port = port
+
+	s.wg.Go(func() {
+		readLoop(console, port)
+	})
+
+	return nil
+}
+
+func readLoop(console *serialConsole, port serial.Port) {
+	defer port.Close()
+
+	_, err := io.Copy(console, port)
+
+	console.lock.Lock()
+	if console.port != port {
+		console.lock.Unlock()
+
+		return
+	}
+
+	console.port = nil
+	console.lock.Unlock()
+
+	slog.Error("Could not read from serial console, stopping buffering", "path", console.path, "err", err)
+}
diff --git a/pkg/svc/serial_clear_buffer.go b/pkg/svc/serial_clear_buffer.go
new file mode 100644
index 0000000000000000000000000000000000000000..e7afa391badb33e108f495477dd0c0070fef5f69
--- /dev/null
+++ b/pkg/svc/serial_clear_buffer.go
@@ -0,0 +1,36 @@
+package svc
+
+import (
+	"context"
+
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+var (
+	ClearBufferTool = &mcp.Tool{
+		Name:        "serial.clearBuffer",
+		Title:       "Clear serial console buffer",
+		Description: "Discard the captured output history of a serial console",
+		Annotations: &mcp.ToolAnnotations{DestructiveHint: &[]bool{true}[0]},
+	}
+)
+
+type ClearBufferInput struct {
+	Path string `json:"path" jsonschema:"path that uniquely identifies the serial console until it gets unplugged"`
+}
+
+func (s *Service) ClearBuffer(ctx context.Context, req *mcp.CallToolRequest, input ClearBufferInput) (*mcp.CallToolResult, *GetConsolesOutput, error) {
+	console, err := s.findConsole(input.Path)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	console.lock.Lock()
+	defer console.lock.Unlock()
+
+	console.buffer = nil
+
+	return nil, &GetConsolesOutput{
+		Consoles: []Console{console.state()},
+	}, nil
+}
