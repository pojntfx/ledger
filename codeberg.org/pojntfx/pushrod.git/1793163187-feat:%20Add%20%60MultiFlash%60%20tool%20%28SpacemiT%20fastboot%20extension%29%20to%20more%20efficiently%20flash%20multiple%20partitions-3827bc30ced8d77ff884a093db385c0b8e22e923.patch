+
+func flashWithCompression(ctx context.Context, session *fastboot.Session, partition string, source io.Reader, size int64, compression titanflasher.Compression, gzipLevel titanflasher.GzipLevel, progress fastboot.ProgressCallback) error {
+	if compression == titanflasher.CompressionRaw {
