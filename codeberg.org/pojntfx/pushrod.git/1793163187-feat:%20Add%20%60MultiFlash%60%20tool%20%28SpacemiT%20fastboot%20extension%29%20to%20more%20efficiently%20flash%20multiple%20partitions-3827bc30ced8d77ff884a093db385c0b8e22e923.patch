 )
 
+type Compression string
+
+const (
+	CompressionRaw   Compression = ""
+	CompressionGzip0 Compression = "gzip-0"
+	CompressionGzip1 Compression = "gzip-1"
+	CompressionGzip2 Compression = "gzip-2"
+	CompressionGzip3 Compression = "gzip-3"
+	CompressionGzip4 Compression = "gzip-4"
+	CompressionGzip5 Compression = "gzip-5"
+	CompressionGzip6 Compression = "gzip-6"
+	CompressionGzip7 Compression = "gzip-7"
+	CompressionGzip8 Compression = "gzip-8"
+	CompressionGzip9 Compression = "gzip-9"
+)
+
+var CompressionEnum = []any{
+	CompressionRaw,
+	CompressionGzip0,
+	CompressionGzip1,
+	CompressionGzip2,
+	CompressionGzip3,
+	CompressionGzip4,
+	CompressionGzip5,
+	CompressionGzip6,
+	CompressionGzip7,
+	CompressionGzip8,
+	CompressionGzip9,
+}
+
+var compressionLevels = map[Compression]GzipLevel{
+	CompressionGzip0: GzipLevel0,
+	CompressionGzip1: GzipLevel1,
+	CompressionGzip2: GzipLevel2,
+	CompressionGzip3: GzipLevel3,
+	CompressionGzip4: GzipLevel4,
+	CompressionGzip5: GzipLevel5,
+	CompressionGzip6: GzipLevel6,
+	CompressionGzip7: GzipLevel7,
+	CompressionGzip8: GzipLevel8,
+	CompressionGzip9: GzipLevel9,
+}
+
+func (c Compression) GzipLevel() (GzipLevel, bool) {
+	level, ok := compressionLevels[c]
+
+	return level, ok
+}
+
