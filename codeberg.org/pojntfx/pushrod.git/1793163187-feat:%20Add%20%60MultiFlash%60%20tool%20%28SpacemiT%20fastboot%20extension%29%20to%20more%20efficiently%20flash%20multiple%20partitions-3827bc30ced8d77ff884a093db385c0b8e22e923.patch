diff --git a/pkg/svc/flash_multi_flash.go b/pkg/svc/flash_multi_flash.go
new file mode 100644
index 0000000000000000000000000000000000000000..07ae440d147fc2d94bbb2cb58e2d4aaaf91a417a
--- /dev/null
+++ b/pkg/svc/flash_multi_flash.go
@@ -0,0 +1,246 @@
+package svc
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"path"
+	"time"
+
+	"codeberg.org/pojntfx/pushrod/pkg/fastboot"
+	"codeberg.org/pojntfx/pushrod/pkg/titanflasher"
+	"github.com/google/jsonschema-go/jsonschema"
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+var (
+	MultiFlashTool = &mcp.Tool{
+		Name:        "flash.multiFlash",
+		Title:       "Flash partition layout",
+		Description: "Flash partition tables and their referenced images to a device in fastboot mode",
+		Annotations: &mcp.ToolAnnotations{DestructiveHint: new(true)},
+		InputSchema: multiFlashSchema(),
+	}
+
+	ErrNoPartitionTables = errors.New("no partition tables given")
+	ErrNoFormatPartition = errors.New("partition table has no format field")
+	ErrImagesNotUploaded = errors.New("images referenced by the partition tables are not uploaded")
+)
+
+func multiFlashSchema() *jsonschema.Schema {
+	schema, err := jsonschema.For[MultiFlashInput](nil)
+	if err != nil {
+		panic(err)
+	}
+
+	schema.Properties["partitionTables"].Items.Properties["partitions"].Items.Properties["compress"].Enum = titanflasher.CompressionEnum
+
+	return schema
+}
+
+type MultiFlashInput struct {
+	Path            string                        `json:"path" jsonschema:"path that uniquely identifies the fastboot device until it gets unplugged, in BUS-PORT form like 1-2-3"`
+	PartitionTables []titanflasher.PartitionTable `json:"partitionTables" jsonschema:"partition tables to apply in order"`
+	Reboot          bool                          `json:"reboot" jsonschema:"whether to reboot the device after flashing"`
+}
+
+type FlashedPartition struct {
+	Partition  string `json:"partition" jsonschema:"partition that was flashed"`
+	File       string `json:"file" jsonschema:"name of the file that was flashed to the partition"`
+	DurationMs int64  `json:"durationMs" jsonschema:"how long the partition took to flash, in milliseconds"`
+}
+
+type MultiFlashOutput struct {
+	FormatPartitions  []string           `json:"formatPartitions" jsonschema:"partitions that the tables were written to, in the same order"`
+	FlashedPartitions []FlashedPartition `json:"flashedPartitions" jsonschema:"partitions that were flashed, in the order the tables list them"`
+	Rebooted          bool               `json:"rebooted" jsonschema:"whether the device was rebooted afterwards"`
+	DurationMs        int64              `json:"durationMs" jsonschema:"how long the whole flash took, in milliseconds"`
+}
+
+type preparedPartitionImage struct {
+	partition string
+	name      string
+	file      *os.File
+	size      int64
+	compress  titanflasher.Compression
+	gzipLevel titanflasher.GzipLevel
+}
+
+type parsedPartitionTable struct {
+	format string
+	data   []byte
+	images []preparedPartitionImage
+}
+
+func newParsedPartitionTable(format string, data []byte) *parsedPartitionTable {
+	return &parsedPartitionTable{
+		format: format,
+		data:   data,
+	}
+}
+
+func (t *parsedPartitionTable) close() {
+	for _, image := range t.images {
+		if image.file != nil {
+			image.file.Close()
+		}
+	}
+}
+
+func (s *Service) preparePartitionTable(definition titanflasher.PartitionTable) (_ *parsedPartitionTable, _ []string, err error) {
+	if definition.Format == "" {
+		return nil, nil, ErrNoFormatPartition
+	}
+
+	contents, err := json.Marshal(definition)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	parsed := newParsedPartitionTable(definition.Format, contents)
+	defer func() {
+		if err != nil {
+			parsed.close()
+		}
+	}()
+
+	missing := []string{}
+	for _, partition := range definition.Partitions {
+		if partition.Name == "" || partition.Image == "" {
+			continue
+		}
+
+		gzipLevel, ok := partition.Compress.GzipLevel()
+		if partition.Compress != titanflasher.CompressionRaw && !ok {
+			return nil, nil, ErrInvalidCompression
+		}
+
+		imageName := path.Base(partition.Image)
+		imageFile, err := s.openUploadedFile(imageName)
+		if err != nil {
+			if errors.Is(err, os.ErrNotExist) {
+				missing = append(missing, imageName)
+
+				continue
+			}
+
+			return nil, nil, err
+		}
+
+		imageInfo, err := imageFile.Stat()
+		if err != nil {
+			imageFile.Close()
+
+			return nil, nil, err
+		}
+
+		parsed.images = append(parsed.images, preparedPartitionImage{
+			partition: partition.Name,
+			name:      imageName,
+			file:      imageFile,
+			size:      imageInfo.Size(),
+			compress:  partition.Compress,
+			gzipLevel: gzipLevel,
+		})
+	}
+
+	return parsed, missing, nil
+}
+
+func (s *Service) MultiFlash(ctx context.Context, req *mcp.CallToolRequest, input MultiFlashInput) (*mcp.CallToolResult, *MultiFlashOutput, error) {
+	if len(input.PartitionTables) == 0 {
+		return nil, nil, ErrNoPartitionTables
+	}
+
+	partitionTables := make([]*parsedPartitionTable, 0, len(input.PartitionTables))
+	defer func() {
+		for _, table := range partitionTables {
+			table.close()
+		}
+	}()
+
+	missing := []string{}
+	var totalBytes int64
+	for _, definition := range input.PartitionTables {
+		table, missingImages, err := s.preparePartitionTable(definition)
+		if err != nil {
+			return nil, nil, err
+		}
+
+		partitionTables = append(partitionTables, table)
+		missing = append(missing, missingImages...)
+		totalBytes += int64(len(table.data))
+		for _, image := range table.images {
+			totalBytes += image.size
+		}
+	}
+
+	if len(missing) > 0 {
+		return nil, nil, ErrImagesNotUploaded
+	}
+
+	if err := s.flashLock.Acquire(ctx, 1); err != nil {
+		return nil, nil, err
+	}
+	defer s.flashLock.Release(1)
+
+	session, err := fastboot.OpenSession(input.Path)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer session.Close()
+
+	start := time.Now()
+	progress := notifyProgress(ctx, req, totalBytes)
+	var sentBase int64
+	flash := func(partition string, source io.Reader, size int64, compression titanflasher.Compression, gzipLevel titanflasher.GzipLevel) error {
+		if progress == nil {
+			return flashWithCompression(ctx, session, partition, source, size, compression, gzipLevel, nil)
+		}
+
+		return flashWithCompression(ctx, session, partition, source, size, compression, gzipLevel, func(sent int64) {
+			progress(sentBase + sent)
+		})
+	}
+
+	formatPartitions := make([]string, 0, len(partitionTables))
+	flashedPartitions := []FlashedPartition{}
+	for _, table := range partitionTables {
+		tableSize := int64(len(table.data))
+		if err := flash(table.format, bytes.NewReader(table.data), tableSize, titanflasher.CompressionRaw, titanflasher.GzipLevel0); err != nil {
+			return nil, nil, err
+		}
+		sentBase += tableSize
+		formatPartitions = append(formatPartitions, table.format)
+
+		for _, image := range table.images {
+			partitionStart := time.Now()
+			if err := flash(image.partition, image.file, image.size, image.compress, image.gzipLevel); err != nil {
+				return nil, nil, err
+			}
+			sentBase += image.size
+
+			flashedPartitions = append(flashedPartitions, FlashedPartition{
+				Partition:  image.partition,
+				File:       image.name,
+				DurationMs: time.Since(partitionStart).Milliseconds(),
+			})
+		}
+	}
+
+	if input.Reboot {
+		if _, err := session.Reboot(ctx); err != nil {
+			return nil, nil, err
+		}
+	}
+
+	return nil, &MultiFlashOutput{
+		FormatPartitions:  formatPartitions,
+		FlashedPartitions: flashedPartitions,
+		Rebooted:          input.Reboot,
+		DurationMs:        time.Since(start).Milliseconds(),
+	}, nil
+}
