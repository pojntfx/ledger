diff --git a/pkg/svc/flash_oem.go b/pkg/svc/flash_oem.go
new file mode 100644
index 0000000000000000000000000000000000000000..35baae9ef5198ff96ce1c33b67a4da51ede07dd9
--- /dev/null
+++ b/pkg/svc/flash_oem.go
@@ -0,0 +1,48 @@
+package svc
+
+import (
+	"context"
+
+	"codeberg.org/pojntfx/pushrod/pkg/fastboot"
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+var (
+	OEMTool = &mcp.Tool{
+		Name:        "flash.oem",
+		Title:       "Run OEM command",
+		Description: "Run an OEM command on a device in fastboot mode",
+		Annotations: &mcp.ToolAnnotations{DestructiveHint: new(true)},
+	}
+)
+
+type OEMInput struct {
+	Path    string `json:"path" jsonschema:"path that uniquely identifies the fastboot device until it gets unplugged, in BUS-PORT form like 1-2-3"`
+	Command string `json:"command" jsonschema:"OEM command to run, without the leading oem, like ec:flash or speed:super-speed"`
+}
+
+type OEMOutput struct {
+	Response string `json:"response" jsonschema:"text that the device returned, if any"`
+}
+
+func (s *Service) OEM(ctx context.Context, req *mcp.CallToolRequest, input OEMInput) (*mcp.CallToolResult, *OEMOutput, error) {
+	if err := s.flashLock.Acquire(ctx, 1); err != nil {
+		return nil, nil, err
+	}
+	defer s.flashLock.Release(1)
+
+	session, err := fastboot.OpenSession(input.Path)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer session.Close()
+
+	response, err := session.OEM(ctx, input.Command)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	return nil, &OEMOutput{
+		Response: response,
+	}, nil
+}

