diff --git a/buildroot/qemu/scripts/migration/protocol.go b/buildroot/qemu/scripts/migration/protocol.go
new file mode 100644
index 0000000000000000000000000000000000000000..91eb688beedf0150bff0099ce5c82bf83b46fc3e
--- /dev/null
+++ b/buildroot/qemu/scripts/migration/protocol.go
@@ -0,0 +1,180 @@
+package migration
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"strings"
+	"time"
+)
+
+const (
+	ProtocolVersion = "rva23-migration/v1"
+	PhaseBefore     = "before"
+	PhaseAfter      = "after"
+	ActionUpload    = "checkpoint-upload"
+	ActionDownload  = "checkpoint-download"
+)
+
+type ChallengeRequest struct {
+	InstanceID string `json:"instanceId"`
+	Phase      string `json:"phase"`
+}
+
+type ChallengeResponse struct {
+	Nonce     string    `json:"nonce"`
+	ExpiresAt time.Time `json:"expiresAt"`
+}
+
+type Evidence struct {
+	Report          string `json:"report"`
+	Nonce           string `json:"nonce"`
+	Token           string `json:"token"`
+	PCR11           string `json:"pcr11"`
+	PCR11Quote      string `json:"pcr11Quote"`
+	PCR11Signature  string `json:"pcr11Signature"`
+	PCR11Selections string `json:"pcr11Selections"`
+}
+
+type AttestationRequest struct {
+	InstanceID string   `json:"instanceId"`
+	PID        int      `json:"pid"`
+	Counter    uint64   `json:"counter"`
+	Phase      string   `json:"phase"`
+	Nonce      string   `json:"nonce"`
+	Evidence   Evidence `json:"evidence"`
+	Signature  string   `json:"signature"`
+}
+
+type AttestationResponse struct {
+	Status     string `json:"status"`
+	UserID     int    `json:"userId"`
+	InstanceID string `json:"instanceId"`
+	PID        int    `json:"pid"`
+	Counter    uint64 `json:"counter"`
+	Phase      string `json:"phase"`
+}
+
+type CheckpointAuthorization struct {
+	Action           string `json:"action"`
+	InstanceID       string `json:"instanceId"`
+	PID              int    `json:"pid"`
+	Counter          uint64 `json:"counter"`
+	Phase            string `json:"phase"`
+	Nonce            string `json:"nonce"`
+	CheckpointSHA256 string `json:"checkpointSha256"`
+	CheckpointSize   int64  `json:"checkpointSize"`
+}
+
+type CheckpointMetadata struct {
+	InstanceID string    `json:"instanceId"`
+	SHA256     string    `json:"sha256"`
+	Size       int64     `json:"size"`
+	UploadedAt time.Time `json:"uploadedAt"`
+}
+
+type attestationMessage struct {
+	Protocol         string `json:"protocol"`
+	InstanceID       string `json:"instanceId"`
+	PID              int    `json:"pid"`
+	Counter          uint64 `json:"counter"`
+	Phase            string `json:"phase"`
+	Nonce            string `json:"nonce"`
+	AttestationNonce string `json:"attestationNonce"`
+	AttestationToken string `json:"attestationToken"`
+	ReportSHA256     string `json:"reportSha256"`
+	PCR11            string `json:"pcr11"`
+}
+
+type checkpointMessage struct {
+	Protocol         string `json:"protocol"`
+	Action           string `json:"action"`
+	InstanceID       string `json:"instanceId"`
+	PID              int    `json:"pid"`
+	Counter          uint64 `json:"counter"`
+	Phase            string `json:"phase"`
+	Nonce            string `json:"nonce"`
+	CheckpointSHA256 string `json:"checkpointSha256"`
+	CheckpointSize   int64  `json:"checkpointSize"`
+}
+
+func ValidatePhase(phase string) error {
+	if phase != PhaseBefore && phase != PhaseAfter {
+		return errors.New("phase must be before or after")
+	}
+	return nil
+}
+
+func ValidateInstanceID(instanceID string) error {
+	decoded, err := hex.DecodeString(instanceID)
+	if err != nil || len(decoded) != 16 || strings.ToLower(instanceID) != instanceID {
+		return errors.New("instance ID must contain 32 lowercase hexadecimal characters")
+	}
+	return nil
+}
+
+func ExpectedUserID(phase string) (int, error) {
+	switch phase {
+	case PhaseBefore:
+		return 1, nil
+	case PhaseAfter:
+		return 2, nil
+	default:
+		return 0, errors.New("phase must be before or after")
+	}
+}
+
+func ExpectedCheckpointPhase(action string) (string, error) {
+	switch action {
+	case ActionUpload:
+		return PhaseBefore, nil
+	case ActionDownload:
+		return PhaseAfter, nil
+	default:
+		return "", errors.New("unknown checkpoint action")
+	}
+}
+
+func AttestationMessage(input AttestationRequest) ([]byte, error) {
+	report, err := base64.RawURLEncoding.DecodeString(input.Evidence.Report)
+	if err != nil || len(report) == 0 {
+		return nil, errors.New("invalid OS report encoding")
+	}
+	digest := sha256.Sum256(report)
+	return json.Marshal(attestationMessage{
+		Protocol:         ProtocolVersion,
+		InstanceID:       input.InstanceID,
+		PID:              input.PID,
+		Counter:          input.Counter,
+		Phase:            input.Phase,
+		Nonce:            input.Nonce,
+		AttestationNonce: input.Evidence.Nonce,
+		AttestationToken: input.Evidence.Token,
+		ReportSHA256:     hex.EncodeToString(digest[:]),
+		PCR11:            strings.ToLower(input.Evidence.PCR11),
+	})
+}
+
+func CheckpointMessage(input CheckpointAuthorization) ([]byte, error) {
+	return json.Marshal(checkpointMessage{
+		Protocol:         ProtocolVersion,
+		Action:           input.Action,
+		InstanceID:       input.InstanceID,
+		PID:              input.PID,
+		Counter:          input.Counter,
+		Phase:            input.Phase,
+		Nonce:            input.Nonce,
+		CheckpointSHA256: input.CheckpointSHA256,
+		CheckpointSize:   input.CheckpointSize,
+	})
+}
+
+func DecodeSignature(encoded string) ([]byte, error) {
+	signature, err := base64.RawURLEncoding.DecodeString(encoded)
+	if err != nil || len(signature) == 0 {
+		return nil, errors.New("invalid AK signature encoding")
+	}
+	return signature, nil
+}
diff --git a/buildroot/qemu/scripts/verify-migration.py b/buildroot/qemu/scripts/verify-migration.py
new file mode 100644
index 0000000000000000000000000000000000000000..ac4ff7e10321486abd30c71f48f66731ccb122bd
--- /dev/null
+++ b/buildroot/qemu/scripts/verify-migration.py
@@ -0,0 +1,226 @@
+#!/usr/bin/env python3
+import base64
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import re
+import secrets
+import shutil
+import subprocess
+import sys
+import time
+import urllib.request
+
+from verify_boot import Console
+
+
+spec = importlib.util.spec_from_file_location("wallet", Path(__file__).with_name("verify-wallet.py"))
+wallet = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(wallet)
+predict_profile = wallet.predict_profile
+
+
+def copy_disk(source, destination):
+    subprocess.run(["cp", "--reflink=auto", "--sparse=always", source, destination], check=True)
+
+
+def copy_guest_file(console, source, destination):
+    text = console.capture(f"printf '__BEGIN__\\n'; base64 {source}; printf '__END__\\n'", 120)
+    match = re.search(r"__BEGIN__\r?\n(.*?)\r?\n__END__", text, re.DOTALL)
+    assert match, text[-2000:]
+    destination.write_bytes(base64.b64decode(re.sub(r"\s", "", match.group(1))))
+
+
+def login(console):
+    console.expect(b"rva23 login:", 600)
+    console.sendline("root")
+    console.expect(b"# ", 30)
+    console.command("systemctl is-active --quiet --wait graphical.target")
+    console.command("systemctl start systemd-pcrlock.socket")
+    console.command("systemctl restart systemd-report-sign-tpm2.socket")
+    console.command("sleep 2")
+
+
+def start_receiver(output):
+    receiver_dir = output / "host-attestation"
+    public_key = (receiver_dir / "public-key.pem").read_bytes()
+    token_path = receiver_dir / "migration-token.json"
+    token_path.write_text(json.dumps({"keyId": hashlib.sha256(public_key).hexdigest(), "secret": base64.b64encode(secrets.token_bytes(32)).decode()}) + "\n")
+    token_path.chmod(0o600)
+    subprocess.run(["go", "build", "-o", receiver_dir / "report-receiver", "scripts/report-receiver.go"], check=True)
+    environment = os.environ.copy()
+    environment["RVA23_TOKEN_FILE"] = str(token_path)
+    environment["RVA23_ATTESTATION_DIR"] = str(receiver_dir)
+    receiver = subprocess.Popen([receiver_dir / "report-receiver"], stdout=(receiver_dir / "migration-receiver.log").open("w"), stderr=subprocess.STDOUT, env=environment)
+    wait_http("http://127.0.0.1:8080/api/state")
+    return receiver
+
+
+def start_migration_server(output, production_pcr11):
+    directory = output / "migration"
+    subprocess.run(["go", "build", "-o", directory / "migration-server", "./cmd/migration-server"], check=True, cwd=Path("scripts/migration"))
+    environment = os.environ.copy()
+    environment["RVA23_MIGRATION_VM1_KEY_FILE"] = str(directory / "vm1-ak-public.pem")
+    environment["RVA23_MIGRATION_VM2_KEY_FILE"] = str(directory / "vm2-ak-public.pem")
+    environment["RVA23_MIGRATION_PRODUCTION_PCR11"] = production_pcr11
+    environment["RVA23_MIGRATION_CHECKPOINT_DIR"] = str(directory / "checkpoints")
+    environment["RVA23_MIGRATION_ATTESTATION_URL"] = "http://127.0.0.1:8080/v1/attest"
+    server = subprocess.Popen([directory / "migration-server"], stdout=(directory / "migration-server.log").open("w"), stderr=subprocess.STDOUT, env=environment)
+    wait_http("http://127.0.0.1:8083/api/state")
+    if server.poll() is not None:
+        raise RuntimeError("migration server exited during startup")
+    if read_state("http://127.0.0.1:8083/api/state")["history"]:
+        raise RuntimeError("migration server returned stale request history")
+    return server
+
+
+def wait_http(url):
+    last_error = None
+    for _ in range(100):
+        try:
+            with urllib.request.urlopen(url, timeout=1) as response:
+                if response.status == 200:
+                    return
+        except Exception as error:
+            last_error = error
+        time.sleep(0.1)
+    raise RuntimeError(f"HTTP service did not start: {url}: {last_error}")
+
+
+def prepare_images(output):
+    images = output / "images"
+    directory = output / "migration"
+    directory.mkdir(exist_ok=True)
+    environment = os.environ.copy()
+    environment.update({
+        "BINARIES_DIR": str(images), "TARGET_DIR": str(output / "target"),
+        "HOST_DIR": str(output / "host"), "RVA23_KEY_DIR": str(Path("../buildroot-qemu-keys").resolve()),
+    })
+    with (output / "migration" / "build.log").open("w") as log:
+        subprocess.run(["python3", "scripts/build-os-images.py"], check=True, env=environment, stdout=log, stderr=subprocess.STDOUT)
+    subprocess.run([
+        output / "host/bin/genimage", "--rootpath", output / "target", "--inputpath", images,
+        "--outputpath", images, "--config", Path("board/rva23-qemu/genimage.cfg").resolve(),
+    ], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    environment = os.environ.copy()
+    environment["BINARIES_DIR"] = str(images)
+    subprocess.run(["python3", "scripts/finalize-disk.py"], check=True, env=environment, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    loader = output / "migration" / "loader.conf"
+    loader.write_text("default rva23-debug_1.efi\ntimeout 0\neditor no\n")
+    subprocess.run([output / "host/bin/mcopy", "-o", "-i", images / "efi-part.vfat", loader, "::/loader/loader.conf"], check=True)
+    initial = output / "build/edk2-edk2-stable202602/Build/RiscVVirtQemu/RELEASE_GCC5/FV/RISCV_VIRT_VARS.fd"
+    variables = images / "RISCV_VIRT_VARS.fd"
+    shutil.copyfile(initial, variables)
+    variables.write_bytes(variables.read_bytes().ljust(32 * 1024 * 1024, b"\0"))
+    directory = output / "migration"
+    directory.mkdir(exist_ok=True)
+    for name in ("vm1", "vm2"):
+        copy_disk(images / "disk.img", directory / f"{name}.img")
+        shutil.copyfile(variables, directory / f"{name}-vars.fd")
+
+
+def vm_console(output, name, host_port):
+    directory = output / "migration"
+    os.environ["RVA23_DISK"] = str(directory / f"{name}.img")
+    os.environ["RVA23_EDK2_VARS"] = str(directory / f"{name}-vars.fd")
+    os.environ["RVA23_TPM_STATE"] = str(directory / f"{name}-swtpm")
+    os.environ["RVA23_UI_HOST_PORT"] = str(host_port)
+    os.environ["QEMU"] = str(output / "build/host-qemu-11.0.0/build/qemu-system-riscv64")
+    return Console(output, f"migration-{name}.log", firmware=True)
+
+
+def enroll(console, output, name):
+    login(console)
+    console.command("bootctl set-default rva23-debug_1.efi")
+    console.sendline("reboot")
+    login(console)
+    console.command("attested-client", 300)
+    console.command("tpm2_readpublic -c /var/lib/systemd/report.sign.tpm2/ak.ctx -f pem -o /tmp/ak-public.pem")
+    copy_guest_file(console, "/tmp/ak-public.pem", output / "migration" / f"{name}-ak-public.pem")
+    console.command("criu check", 300)
+
+
+def start_workload(console):
+    output = console.capture("migration-client serve </dev/null >/tmp/migration-client.log 2>&1 & printf '%s\\n' $!")
+    match = re.search(r"(?:^|\r?\n)(\d+)\r?\n", output)
+    assert match, output[-2000:]
+    wait_http("http://127.0.0.1:18084/api/state")
+    return int(match.group(1))
+
+
+def read_state(url):
+    with urllib.request.urlopen(url, timeout=5) as response:
+        return json.load(response)
+
+
+def main():
+    output = Path(sys.argv[1]).resolve()
+    directory = output / "migration"
+    keep = os.environ.get("RVA23_MIGRATION_KEEP_SERVICES") == "1"
+    succeeded = False
+    prepare_images(output)
+    receiver = start_receiver(output)
+    server = None
+    first = None
+    second = None
+    try:
+        first = vm_console(output, "vm1", 18084)
+        enroll(first, output, "vm1")
+        second = vm_console(output, "vm2", 18085)
+        enroll(second, output, "vm2")
+        development = predict_profile(output, "rva23-debug_1.efi")
+        server = start_migration_server(output, development)
+        pid = start_workload(first)
+        first.command("migration-client attest -phase before", 300)
+        state = read_state("http://127.0.0.1:18084/api/state")
+        assert state["pid"] == pid
+        instance = state["instanceId"]
+        first.command("rm -rf /tmp/criu-dump /tmp/migration.tar.gz; mkdir -p /tmp/criu-dump")
+        first.command(f"CRIU_FAULT=129 criu dump -t {pid} -D /tmp/criu-dump --shell-job --tcp-close", 300)
+        first.command("migration-client archive -source /tmp/criu-dump -output /tmp/migration.tar.gz", 300)
+        first.command("migration-client upload -archive /tmp/migration.tar.gz", 300)
+        copy_guest_file(first, "/var/lib/rva23-migration/state.json", directory / "state.json")
+        first.sendline("poweroff")
+        first.process.wait(timeout=90)
+        first.close()
+        first = None
+        encoded_state = base64.b64encode((directory / "state.json").read_bytes()).decode()
+        second.command(f"mkdir -p /var/lib/rva23-migration; printf '%s' '{encoded_state}' | base64 -d > /var/lib/rva23-migration/state.json")
+        second.command("migration-client download -output /tmp/migration.tar.gz", 300)
+        second.command("rm -rf /tmp/criu-restore; migration-client extract -archive /tmp/migration.tar.gz -destination /tmp/criu-restore", 300)
+        second.command("touch /tmp/migration-client.log")
+        second.command("criu restore -D /tmp/criu-restore --shell-job --tcp-close -d", 300)
+        second.command("migration-client attest -phase after", 300)
+        restored = read_state("http://127.0.0.1:18085/api/state")
+        assert restored["pid"] == pid
+        assert restored["instanceId"] == instance
+        history = read_state("http://127.0.0.1:8083/api/state")["history"]
+        accepted = [item for item in history if item["operation"] == "attestation" and item.get("response", {}).get("status") == "accepted"]
+        assert [item["response"]["userId"] for item in accepted] == [2, 1]
+        for item in accepted:
+            assert item["attestation"]["instanceId"] == instance, (instance, item["attestation"]["instanceId"])
+            assert item["attestation"]["pid"] == pid, (pid, item["attestation"]["pid"])
+            assert item["validation"]["identityBinding"] in {"accepted for user 1", "accepted for user 2"}
+            assert item["validation"]["pcr11Quote"] == "accepted"
+            assert item["validation"]["hostOsReport"] == "accepted"
+        assert accepted[1]["response"]["counter"] < accepted[0]["response"]["counter"]
+        print("PASS: CRIU preserves instance ID and PID while the enrolled AK changes from user 1 to user 2", flush=True)
+        print("PASS: PCR 11 quotes, signed checkpoints, monotonic counters, and both migration UIs validate", flush=True)
+        succeeded = True
+    finally:
+        if first is not None:
+            first.close()
+        if second is not None and (not keep or not succeeded):
+            second.close()
+        if not keep or not succeeded:
+            receiver.terminate()
+            receiver.wait(timeout=15)
+            if server is not None:
+                server.terminate()
+                server.wait(timeout=15)
+
+
+if __name__ == "__main__":
+    main()

