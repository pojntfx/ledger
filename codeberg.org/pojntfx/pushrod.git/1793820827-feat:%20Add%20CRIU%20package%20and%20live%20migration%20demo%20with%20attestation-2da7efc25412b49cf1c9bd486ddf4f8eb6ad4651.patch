+package main
+
+import (
+	"bytes"
+	"crypto"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	migration "rva23/scripts/migration"
+)
+
+type testIdentity struct {
+	private *rsa.PrivateKey
+}
+
+func newTestIdentity(t *testing.T) testIdentity {
+	t.Helper()
+	private, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return testIdentity{private: private}
+}
+
+func (identity testIdentity) sign(t *testing.T, message []byte) string {
+	t.Helper()
+	digest := sha256.Sum256(message)
+	signature, err := rsa.SignPKCS1v15(rand.Reader, identity.private, crypto.SHA256, digest[:])
+	if err != nil {
+		t.Fatal(err)
+	}
+	return base64.RawURLEncoding.EncodeToString(signature)
+}
+
+func newTestServer(t *testing.T, vm1, vm2 testIdentity) (*migrationServer, *httptest.Server, *atomic.Int64) {
+	t.Helper()
+	var reports atomic.Int64
+	upstream := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+		reports.Add(1)
+		writer.Header().Set("Content-Type", "application/json")
+		_, _ = io.WriteString(writer, `{"status":"accepted"}`)
+	}))
+	t.Cleanup(upstream.Close)
+	server := &migrationServer{
+		keys:            map[int]*rsa.PublicKey{1: &vm1.private.PublicKey, 2: &vm2.private.PublicKey},
+		quoteVerifier:   func(userID int, nonce string, evidence migration.Evidence) error { return nil },
+		productionPCR11: strings.Repeat("11", sha256.Size), attestationURL: upstream.URL,
+		checkpointDir: t.TempDir(), client: upstream.Client(), maxCheckpoint: migration.DefaultMaxCheckpointBytes,
+		now:    func() time.Time { return time.Date(2026, 11, 4, 0, 0, 0, 0, time.UTC) },
+		nonces: make(map[string]challengeRecord), counters: make(map[string]uint64),
+		checkpoints: make(map[string]migration.CheckpointMetadata), history: make([]requestRecord, 0),
+	}
+	return server, upstream, &reports
+}
+
+func issueChallenge(t *testing.T, handler http.Handler, instanceID, phase string) string {
+	t.Helper()
+	body, err := json.Marshal(migration.ChallengeRequest{InstanceID: instanceID, Phase: phase})
+	if err != nil {
+		t.Fatal(err)
+	}
+	request := httptest.NewRequest(http.MethodPost, "/v1/challenge", bytes.NewReader(body))
+	response := httptest.NewRecorder()
+	handler.ServeHTTP(response, request)
+	if response.Code != http.StatusOK {
+		t.Fatalf("challenge returned %d: %s", response.Code, response.Body.String())
+	}
+	var challenge migration.ChallengeResponse
+	if err := json.Unmarshal(response.Body.Bytes(), &challenge); err != nil {
+		t.Fatal(err)
+	}
+	return challenge.Nonce
+}
+
+func testAttestation(instanceID, phase, nonce string, counter uint64) migration.AttestationRequest {
+	return migration.AttestationRequest{
+		InstanceID: instanceID, PID: 4242, Counter: counter, Phase: phase, Nonce: nonce,
+		Evidence: migration.Evidence{
+			Report: base64.RawURLEncoding.EncodeToString([]byte(`{"report":true}`)),
+			Nonce:  "attestation-nonce", Token: "attestation-token", PCR11: strings.Repeat("11", sha256.Size),
+			PCR11Quote: "quote", PCR11Signature: "signature", PCR11Selections: "selections",
+		},
+	}
+}
+
+func postAttestation(t *testing.T, handler http.Handler, input migration.AttestationRequest) *httptest.ResponseRecorder {
+	t.Helper()
+	body, err := json.Marshal(input)
+	if err != nil {
+		t.Fatal(err)
+	}
+	request := httptest.NewRequest(http.MethodPost, "/v1/attestations", bytes.NewReader(body))
+	response := httptest.NewRecorder()
+	handler.ServeHTTP(response, request)
+	return response
+}
+
+func signAttestation(t *testing.T, identity testIdentity, input *migration.AttestationRequest) {
+	t.Helper()
+	message, err := migration.AttestationMessage(*input)
+	if err != nil {
+		t.Fatal(err)
+	}
+	input.Signature = identity.sign(t, message)
+}
+
+func TestIdentityBinding(t *testing.T) {
+	vm1 := newTestIdentity(t)
+	vm2 := newTestIdentity(t)
+	server, _, reports := newTestServer(t, vm1, vm2)
+	handler := newHTTPHandler(server)
+	instanceID := strings.Repeat("a", 32)
+	nonce := issueChallenge(t, handler, instanceID, migration.PhaseBefore)
+	input := testAttestation(instanceID, migration.PhaseBefore, nonce, 1)
+	signAttestation(t, vm2, &input)
+	response := postAttestation(t, handler, input)
+	if response.Code != http.StatusForbidden {
+		t.Fatalf("wrong VM key returned %d: %s", response.Code, response.Body.String())
+	}
+	if reports.Load() != 0 {
+		t.Fatal("wrong VM key reached report forwarding")
+	}
+	signAttestation(t, vm1, &input)
+	response = postAttestation(t, handler, input)
+	if response.Code != http.StatusOK {
+		t.Fatalf("enrolled VM1 key returned %d: %s", response.Code, response.Body.String())
+	}
+	var accepted migration.AttestationResponse
+	if err := json.Unmarshal(response.Body.Bytes(), &accepted); err != nil {
+		t.Fatal(err)
+	}
+	if accepted.UserID != 1 {
+		t.Fatalf("before phase mapped to user %d", accepted.UserID)
+	}
+	if reports.Load() != 1 {
+		t.Fatalf("forwarded %d reports", reports.Load())
+	}
+}
+
+func TestNonceReplay(t *testing.T) {
+	vm1 := newTestIdentity(t)
+	vm2 := newTestIdentity(t)
+	server, _, reports := newTestServer(t, vm1, vm2)
+	handler := newHTTPHandler(server)
+	instanceID := strings.Repeat("b", 32)
+	nonce := issueChallenge(t, handler, instanceID, migration.PhaseBefore)
+	input := testAttestation(instanceID, migration.PhaseBefore, nonce, 1)
+	signAttestation(t, vm1, &input)
+	if response := postAttestation(t, handler, input); response.Code != http.StatusOK {
+		t.Fatalf("first request returned %d: %s", response.Code, response.Body.String())
+	}
+	response := postAttestation(t, handler, input)
+	if response.Code != http.StatusForbidden || !strings.Contains(response.Body.String(), "nonce") {
+		t.Fatalf("replay returned %d: %s", response.Code, response.Body.String())
+	}
+	if reports.Load() != 1 {
+		t.Fatalf("replay forwarded another report, total %d", reports.Load())
+	}
+}
+
+func TestWrongPhase(t *testing.T) {
+	vm1 := newTestIdentity(t)
+	vm2 := newTestIdentity(t)
+	server, _, reports := newTestServer(t, vm1, vm2)
+	handler := newHTTPHandler(server)
+	instanceID := strings.Repeat("c", 32)
+	nonce := issueChallenge(t, handler, instanceID, migration.PhaseBefore)
+	input := testAttestation(instanceID, migration.PhaseAfter, nonce, 1)
+	signAttestation(t, vm2, &input)
+	response := postAttestation(t, handler, input)
+	if response.Code != http.StatusForbidden || !strings.Contains(response.Body.String(), "bound to another request") {
+		t.Fatalf("wrong phase returned %d: %s", response.Code, response.Body.String())
+	}
+	if reports.Load() != 0 {
+		t.Fatal("wrong phase reached report forwarding")
+	}
+	afterNonce := issueChallenge(t, handler, instanceID, migration.PhaseAfter)
+	afterInput := testAttestation(instanceID, migration.PhaseAfter, afterNonce, 2)
+	signAttestation(t, vm1, &afterInput)
+	response = postAttestation(t, handler, afterInput)
+	if response.Code != http.StatusForbidden || !strings.Contains(response.Body.String(), "enrolled identity") {
+		t.Fatalf("after phase accepted VM1 key with %d: %s", response.Code, response.Body.String())
+	}
+}
+
+func signedCheckpointRequest(t *testing.T, handler http.Handler, identity testIdentity, method, path string, input migration.CheckpointAuthorization, body []byte) *httptest.ResponseRecorder {
+	t.Helper()
+	message, err := migration.CheckpointMessage(input)
+	if err != nil {
+		t.Fatal(err)
+	}
+	signature := identity.sign(t, message)
+	request := httptest.NewRequest(method, path, bytes.NewReader(body))
+	request.Header.Set("X-Migration-Action", input.Action)
+	request.Header.Set("X-Migration-Instance-ID", input.InstanceID)
+	request.Header.Set("X-Migration-PID", fmt.Sprint(input.PID))
+	request.Header.Set("X-Migration-Counter", fmt.Sprint(input.Counter))
+	request.Header.Set("X-Migration-Phase", input.Phase)
+	request.Header.Set("X-Migration-Nonce", input.Nonce)
+	request.Header.Set("X-Migration-Checkpoint-SHA256", input.CheckpointSHA256)
+	request.Header.Set("X-Migration-Checkpoint-Size", fmt.Sprint(input.CheckpointSize))
+	request.Header.Set("X-Migration-Signature", signature)
+	response := httptest.NewRecorder()
+	handler.ServeHTTP(response, request)
+	return response
+}
+
+func TestCheckpointUploadDownload(t *testing.T) {
+	vm1 := newTestIdentity(t)
+	vm2 := newTestIdentity(t)
+	server, _, _ := newTestServer(t, vm1, vm2)
+	handler := newHTTPHandler(server)
+	instanceID := strings.Repeat("d", 32)
+	archive := []byte("checkpoint archive bytes")
+	digest := sha256.Sum256(archive)
+	upload := migration.CheckpointAuthorization{
+		Action: migration.ActionUpload, InstanceID: instanceID, PID: 4242, Counter: 1,
+		Phase: migration.PhaseBefore, Nonce: issueChallenge(t, handler, instanceID, migration.PhaseBefore),
+		CheckpointSHA256: hex.EncodeToString(digest[:]), CheckpointSize: int64(len(archive)),
+	}
+	response := signedCheckpointRequest(t, handler, vm1, http.MethodPut, "/v1/checkpoints/"+instanceID, upload, archive)
+	if response.Code != http.StatusCreated {
+		t.Fatalf("upload returned %d: %s", response.Code, response.Body.String())
+	}
+	download := migration.CheckpointAuthorization{
+		Action: migration.ActionDownload, InstanceID: instanceID, PID: 4242, Counter: 2,
+		Phase: migration.PhaseAfter, Nonce: issueChallenge(t, handler, instanceID, migration.PhaseAfter),
+	}
+	response = signedCheckpointRequest(t, handler, vm2, http.MethodPost, "/v1/checkpoints/"+instanceID+"/download", download, nil)
+	if response.Code != http.StatusOK {
+		t.Fatalf("download returned %d: %s", response.Code, response.Body.String())
+	}
+	if !bytes.Equal(response.Body.Bytes(), archive) {
+		t.Fatal("download changed checkpoint bytes")
+	}
+	if response.Header().Get("X-Checkpoint-SHA256") != upload.CheckpointSHA256 {
+		t.Fatal("download returned the wrong digest")
+	}
+}
+
+func TestInvalidCheckpointPaths(t *testing.T) {
+	vm1 := newTestIdentity(t)
+	vm2 := newTestIdentity(t)
+	server, _, _ := newTestServer(t, vm1, vm2)
+	handler := newHTTPHandler(server)
+	paths := []string{
+		"/v1/checkpoints/%2e%2e/escape",
+		"/v1/checkpoints/" + strings.Repeat("e", 32) + "/escape",
+		"/v1/checkpoints/" + strings.Repeat("E", 32),
+		"/v1/checkpoints/not-an-instance",
+	}
+	for _, path := range paths {
+		request := httptest.NewRequest(http.MethodPut, path, strings.NewReader("data"))
+		response := httptest.NewRecorder()
+		handler.ServeHTTP(response, request)
+		if response.Code != http.StatusBadRequest {
+			t.Fatalf("path %q returned %d: %s", path, response.Code, response.Body.String())
+		}
+	}
+}
+
+func TestCheckpointLimit(t *testing.T) {
+	vm1 := newTestIdentity(t)
+	vm2 := newTestIdentity(t)
+	server, _, _ := newTestServer(t, vm1, vm2)
+	server.maxCheckpoint = 4
+	handler := newHTTPHandler(server)
+	instanceID := strings.Repeat("f", 32)
+	archive := []byte("12345")
+	digest := sha256.Sum256(archive)
+	upload := migration.CheckpointAuthorization{
+		Action: migration.ActionUpload, InstanceID: instanceID, PID: 4242, Counter: 1,
+		Phase: migration.PhaseBefore, Nonce: issueChallenge(t, handler, instanceID, migration.PhaseBefore),
+		CheckpointSHA256: hex.EncodeToString(digest[:]), CheckpointSize: int64(len(archive)),
+	}
+	response := signedCheckpointRequest(t, handler, vm1, http.MethodPut, "/v1/checkpoints/"+instanceID, upload, archive)
+	if response.Code != http.StatusBadRequest || !strings.Contains(response.Body.String(), "size") {
+		t.Fatalf("oversized upload returned %d: %s", response.Code, response.Body.String())
+	}
+}
