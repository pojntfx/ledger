diff --git a/buildroot/qemu/scripts/migration/checkpoint.go b/buildroot/qemu/scripts/migration/checkpoint.go
new file mode 100644
index 0000000000000000000000000000000000000000..2fef574290b721e6a6a13eb10646f32110f17e40
--- /dev/null
+++ b/buildroot/qemu/scripts/migration/checkpoint.go
@@ -0,0 +1,263 @@
+package migration
+
+import (
+	"archive/tar"
+	"compress/gzip"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+const (
+	DefaultMaxCheckpointBytes = 64 * 1024 * 1024
+	DefaultMaxCheckpointFiles = 4096
+)
+
+type ArchiveDigest struct {
+	SHA256 string `json:"sha256"`
+	Size   int64  `json:"size"`
+}
+
+type limitedWriter struct {
+	writer io.Writer
+	remain int64
+}
+
+func (writer *limitedWriter) Write(data []byte) (int, error) {
+	if writer.remain <= 0 {
+		return 0, io.ErrShortWrite
+	}
+	if int64(len(data)) > writer.remain {
+		data = data[:writer.remain]
+	}
+	written, err := writer.writer.Write(data)
+	writer.remain -= int64(written)
+	return written, err
+}
+
+func safeArchivePath(name string) (string, error) {
+	if name == "" || strings.ContainsRune(name, '\x00') || strings.Contains(name, "\\") {
+		return "", errors.New("invalid checkpoint path")
+	}
+	clean := filepath.Clean(filepath.FromSlash(name))
+	if filepath.IsAbs(clean) || clean == "." || clean == ".." || strings.HasPrefix(clean, ".."+string(filepath.Separator)) {
+		return "", errors.New("invalid checkpoint path")
+	}
+	return clean, nil
+}
+
+func ArchiveCheckpoint(source, destination string, maxBytes int64) (ArchiveDigest, error) {
+	var digest ArchiveDigest
+	info, err := os.Stat(source)
+	if err != nil {
+		return digest, err
+	}
+	if !info.IsDir() {
+		return digest, errors.New("checkpoint source must be a directory")
+	}
+	output, err := os.OpenFile(destination, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+	if err != nil {
+		return digest, err
+	}
+	completed := false
+	defer func() {
+		output.Close()
+		if !completed {
+			os.Remove(destination)
+		}
+	}()
+	hash := sha256.New()
+	limited := &limitedWriter{writer: io.MultiWriter(output, hash), remain: maxBytes + 1}
+	gzipWriter := gzip.NewWriter(limited)
+	tarWriter := tar.NewWriter(gzipWriter)
+	files := 0
+	err = filepath.WalkDir(source, func(path string, entry os.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if path == source {
+			return nil
+		}
+		files++
+		if files > DefaultMaxCheckpointFiles {
+			return errors.New("too many checkpoint files")
+		}
+		info, err := entry.Info()
+		if err != nil {
+			return err
+		}
+		if !info.Mode().IsRegular() && !info.IsDir() {
+			return fmt.Errorf("unsupported checkpoint file type at %s", path)
+		}
+		relative, err := filepath.Rel(source, path)
+		if err != nil {
+			return err
+		}
+		name := filepath.ToSlash(relative)
+		if info.IsDir() {
+			name += "/"
+		}
+		header, err := tar.FileInfoHeader(info, "")
+		if err != nil {
+			return err
+		}
+		header.Name = name
+		header.Uid = 0
+		header.Gid = 0
+		header.Uname = ""
+		header.Gname = ""
+		if err := tarWriter.WriteHeader(header); err != nil {
+			return err
+		}
+		if info.Mode().IsRegular() {
+			input, err := os.Open(path)
+			if err != nil {
+				return err
+			}
+			_, copyErr := io.Copy(tarWriter, input)
+			closeErr := input.Close()
+			if copyErr != nil {
+				return copyErr
+			}
+			if closeErr != nil {
+				return closeErr
+			}
+		}
+		return nil
+	})
+	if err == nil {
+		err = tarWriter.Close()
+	} else {
+		tarWriter.Close()
+	}
+	if err == nil {
+		err = gzipWriter.Close()
+	} else {
+		gzipWriter.Close()
+	}
+	if err != nil {
+		return digest, err
+	}
+	if limited.remain <= 0 {
+		return digest, errors.New("checkpoint archive exceeds the size limit")
+	}
+	if err := output.Sync(); err != nil {
+		return digest, err
+	}
+	info, err = output.Stat()
+	if err != nil {
+		return digest, err
+	}
+	if err := output.Close(); err != nil {
+		return digest, err
+	}
+	digest.Size = info.Size()
+	digest.SHA256 = hex.EncodeToString(hash.Sum(nil))
+	completed = true
+	return digest, nil
+}
+
+func ExtractCheckpoint(archive, destination string, maxBytes int64) error {
+	input, err := os.Open(archive)
+	if err != nil {
+		return err
+	}
+	defer input.Close()
+	if err := os.Mkdir(destination, 0o700); err != nil {
+		return err
+	}
+	completed := false
+	defer func() {
+		if !completed {
+			os.RemoveAll(destination)
+		}
+	}()
+	gzipReader, err := gzip.NewReader(input)
+	if err != nil {
+		return err
+	}
+	defer gzipReader.Close()
+	tarReader := tar.NewReader(gzipReader)
+	var total int64
+	files := 0
+	for {
+		header, err := tarReader.Next()
+		if errors.Is(err, io.EOF) {
+			break
+		}
+		if err != nil {
+			return err
+		}
+		files++
+		if files > DefaultMaxCheckpointFiles {
+			return errors.New("too many checkpoint files")
+		}
+		relative, err := safeArchivePath(header.Name)
+		if err != nil {
+			return err
+		}
+		target := filepath.Join(destination, relative)
+		if target != destination && !strings.HasPrefix(target, destination+string(filepath.Separator)) {
+			return errors.New("checkpoint path escapes the destination")
+		}
+		switch header.Typeflag {
+		case tar.TypeDir:
+			if err := os.MkdirAll(target, 0o700); err != nil {
+				return err
+			}
+		case tar.TypeReg, tar.TypeRegA:
+			if header.Size < 0 || header.Size > maxBytes || total > maxBytes-header.Size {
+				return errors.New("checkpoint contents exceed the size limit")
+			}
+			total += header.Size
+			if err := os.MkdirAll(filepath.Dir(target), 0o700); err != nil {
+				return err
+			}
+			output, err := os.OpenFile(target, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+			if err != nil {
+				return err
+			}
+			_, copyErr := io.CopyN(output, tarReader, header.Size)
+			closeErr := output.Close()
+			if copyErr != nil {
+				return copyErr
+			}
+			if closeErr != nil {
+				return closeErr
+			}
+		default:
+			return fmt.Errorf("unsupported checkpoint entry type at %s", header.Name)
+		}
+	}
+	if err := os.Chtimes(destination, time.Now(), time.Now()); err != nil {
+		return err
+	}
+	completed = true
+	return nil
+}
+
+func DigestFile(path string, maxBytes int64) (ArchiveDigest, error) {
+	var result ArchiveDigest
+	input, err := os.Open(path)
+	if err != nil {
+		return result, err
+	}
+	defer input.Close()
+	hash := sha256.New()
+	written, err := io.Copy(hash, io.LimitReader(input, maxBytes+1))
+	if err != nil {
+		return result, err
+	}
+	if written > maxBytes {
+		return result, errors.New("checkpoint archive exceeds the size limit")
+	}
+	result.Size = written
+	result.SHA256 = hex.EncodeToString(hash.Sum(nil))
+	return result, nil
+}
diff --git a/buildroot/qemu/scripts/migration/checkpoint_test.go b/buildroot/qemu/scripts/migration/checkpoint_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..419a422884982091efff5e7cc3acb02de97efe3b
--- /dev/null
+++ b/buildroot/qemu/scripts/migration/checkpoint_test.go
@@ -0,0 +1,116 @@
+package migration
+
+import (
+	"archive/tar"
+	"bytes"
+	"compress/gzip"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func maliciousArchive(t *testing.T, name string, typeflag byte) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "checkpoint.tar.gz")
+	output, err := os.Create(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	gzipWriter := gzip.NewWriter(output)
+	tarWriter := tar.NewWriter(gzipWriter)
+	header := &tar.Header{Name: name, Typeflag: typeflag, Mode: 0o600}
+	if typeflag == tar.TypeReg || typeflag == tar.TypeRegA {
+		header.Size = 4
+	}
+	if err := tarWriter.WriteHeader(header); err != nil {
+		t.Fatal(err)
+	}
+	if header.Size > 0 {
+		if _, err := tarWriter.Write([]byte("data")); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if typeflag == tar.TypeSymlink {
+		header.Linkname = "escape"
+	}
+	if err := tarWriter.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := gzipWriter.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := output.Close(); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func TestExtractRejectsInvalidCheckpointPaths(t *testing.T) {
+	tests := []struct {
+		name     string
+		entry    string
+		typeflag byte
+	}{
+		{name: "parent traversal", entry: "../escape", typeflag: tar.TypeReg},
+		{name: "nested traversal", entry: "images/../../escape", typeflag: tar.TypeReg},
+		{name: "absolute", entry: "/tmp/escape", typeflag: tar.TypeReg},
+		{name: "backslash", entry: "..\\escape", typeflag: tar.TypeReg},
+		{name: "symlink", entry: "image-link", typeflag: tar.TypeSymlink},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			archive := maliciousArchive(t, test.entry, test.typeflag)
+			destination := filepath.Join(t.TempDir(), "restore")
+			if err := ExtractCheckpoint(archive, destination, DefaultMaxCheckpointBytes); err == nil {
+				t.Fatal("malicious checkpoint passed extraction")
+			}
+			if _, err := os.Stat(destination); !os.IsNotExist(err) {
+				t.Fatal("failed extraction left its destination behind")
+			}
+		})
+	}
+}
+
+func TestCheckpointArchiveRoundTrip(t *testing.T) {
+	source := t.TempDir()
+	if err := os.Mkdir(filepath.Join(source, "images"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	contents := []byte("criu image data")
+	if err := os.WriteFile(filepath.Join(source, "images", "pages-1.img"), contents, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	archive := filepath.Join(t.TempDir(), "checkpoint.tar.gz")
+	digest, err := ArchiveCheckpoint(source, archive, DefaultMaxCheckpointBytes)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if digest.Size <= 0 || len(digest.SHA256) != 64 {
+		t.Fatalf("invalid archive digest %+v", digest)
+	}
+	destination := filepath.Join(t.TempDir(), "restore")
+	if err := ExtractCheckpoint(archive, destination, DefaultMaxCheckpointBytes); err != nil {
+		t.Fatal(err)
+	}
+	restored, err := os.ReadFile(filepath.Join(destination, "images", "pages-1.img"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(restored, contents) {
+		t.Fatal("round trip changed checkpoint contents")
+	}
+}
+
+func TestArchiveRejectsUnsupportedFiles(t *testing.T) {
+	source := t.TempDir()
+	if err := os.Symlink("outside", filepath.Join(source, "link")); err != nil {
+		t.Fatal(err)
+	}
+	archive := filepath.Join(t.TempDir(), "checkpoint.tar.gz")
+	if _, err := ArchiveCheckpoint(source, archive, DefaultMaxCheckpointBytes); err == nil {
+		t.Fatal("checkpoint symlink passed archiving")
+	}
+	if _, err := os.Stat(archive); !os.IsNotExist(err) {
+		t.Fatal("failed archive left its output behind")
+	}
+}
diff --git a/buildroot/qemu/scripts/migration/cmd/migration-client/migration-client.go b/buildroot/qemu/scripts/migration/cmd/migration-client/migration-client.go
new file mode 100644
index 0000000000000000000000000000000000000000..294956a6d1605fd2d7820d8aff9ac30df785283e
--- /dev/null
+++ b/buildroot/qemu/scripts/migration/cmd/migration-client/migration-client.go
@@ -0,0 +1,686 @@
+package main
+
+import (
+	"bytes"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	migration "rva23/scripts/migration"
+)
+
+const maxClientResponseBytes = 64 * 1024
+
+type messageSigner interface {
+	Sign(message []byte) (string, error)
+}
+
+type tpmSigner struct {
+	keyFile string
+}
+
+type clientState struct {
+	InstanceID    string    `json:"instanceId"`
+	PID           int       `json:"pid"`
+	Counter       uint64    `json:"counter"`
+	LastPhase     string    `json:"lastPhase,omitempty"`
+	LastOperation string    `json:"lastOperation,omitempty"`
+	LastError     string    `json:"lastError,omitempty"`
+	UpdatedAt     time.Time `json:"updatedAt"`
+}
+
+type migrationClient struct {
+	baseURL       string
+	statePath     string
+	httpClient    *http.Client
+	signer        messageSigner
+	maxCheckpoint int64
+	mutex         sync.Mutex
+	state         clientState
+}
+
+func environment(name, fallback string) string {
+	if value := os.Getenv(name); value != "" {
+		return value
+	}
+	return fallback
+}
+
+func saveClientState(path string, state clientState) error {
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return err
+	}
+	encoded, err := json.Marshal(state)
+	if err != nil {
+		return err
+	}
+	temporary, err := os.CreateTemp(filepath.Dir(path), ".state-*")
+	if err != nil {
+		return err
+	}
+	temporaryPath := temporary.Name()
+	completed := false
+	defer func() {
+		temporary.Close()
+		if !completed {
+			os.Remove(temporaryPath)
+		}
+	}()
+	if err := temporary.Chmod(0o600); err != nil {
+		return err
+	}
+	if _, err := temporary.Write(append(encoded, '\n')); err != nil {
+		return err
+	}
+	if err := temporary.Sync(); err != nil {
+		return err
+	}
+	if err := temporary.Close(); err != nil {
+		return err
+	}
+	if err := os.Rename(temporaryPath, path); err != nil {
+		return err
+	}
+	completed = true
+	return nil
+}
+
+func loadClientState(path string, pid int) (clientState, error) {
+	var state clientState
+	encoded, err := os.ReadFile(path)
+	if errors.Is(err, os.ErrNotExist) {
+		instanceID := make([]byte, 16)
+		if _, err := io.ReadFull(rand.Reader, instanceID); err != nil {
+			return state, err
+		}
+		state = clientState{InstanceID: hex.EncodeToString(instanceID), PID: pid, UpdatedAt: time.Now().UTC()}
+		if err := saveClientState(path, state); err != nil {
+			return state, err
+		}
+		return state, nil
+	}
+	if err != nil {
+		return state, err
+	}
+	decoder := json.NewDecoder(bytes.NewReader(encoded))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&state); err != nil {
+		return state, err
+	}
+	if err := migration.ValidateInstanceID(state.InstanceID); err != nil {
+		return state, err
+	}
+	if state.PID <= 0 {
+		return state, errors.New("saved PID must be positive")
+	}
+	return state, nil
+}
+
+func newMigrationClient() (*migrationClient, error) {
+	statePath := environment("RVA23_MIGRATION_CLIENT_STATE", "/var/lib/rva23-migration/state.json")
+	state, err := loadClientState(statePath, os.Getpid())
+	if err != nil {
+		return nil, err
+	}
+	return &migrationClient{
+		baseURL:   strings.TrimRight(environment("RVA23_MIGRATION_URL", "http://10.0.2.2:8083"), "/"),
+		statePath: statePath, httpClient: &http.Client{Timeout: 120 * time.Second},
+		signer:        &tpmSigner{keyFile: "/var/lib/systemd/report.sign.tpm2/default.key"},
+		maxCheckpoint: migration.DefaultMaxCheckpointBytes, state: state,
+	}, nil
+}
+
+func (client *migrationClient) nextCounter() (uint64, error) {
+	client.mutex.Lock()
+	defer client.mutex.Unlock()
+	if client.state.Counter == ^uint64(0) {
+		return 0, errors.New("migration counter exhausted")
+	}
+	client.state.Counter++
+	client.state.UpdatedAt = time.Now().UTC()
+	if err := saveClientState(client.statePath, client.state); err != nil {
+		client.state.Counter--
+		return 0, err
+	}
+	return client.state.Counter, nil
+}
+
+func (client *migrationClient) finish(operation, phase string, err error) {
+	client.mutex.Lock()
+	defer client.mutex.Unlock()
+	client.state.LastOperation = operation
+	client.state.LastPhase = phase
+	client.state.LastError = ""
+	if err != nil {
+		client.state.LastError = err.Error()
+	}
+	client.state.UpdatedAt = time.Now().UTC()
+	_ = saveClientState(client.statePath, client.state)
+}
+
+func (client *migrationClient) snapshot() clientState {
+	client.mutex.Lock()
+	defer client.mutex.Unlock()
+	return client.state
+}
+
+func postJSON(client *http.Client, url string, input any) ([]byte, int, error) {
+	body, err := json.Marshal(input)
+	if err != nil {
+		return nil, 0, err
+	}
+	request, err := http.NewRequest(http.MethodPost, url, bytes.NewReader(body))
+	if err != nil {
+		return nil, 0, err
+	}
+	request.Header.Set("Content-Type", "application/json")
+	response, err := client.Do(request)
+	if err != nil {
+		return nil, 0, err
+	}
+	defer response.Body.Close()
+	result, err := io.ReadAll(io.LimitReader(response.Body, maxClientResponseBytes))
+	return result, response.StatusCode, err
+}
+
+func responseError(operation string, status int, body []byte) error {
+	if status >= 200 && status < 300 {
+		return nil
+	}
+	return fmt.Errorf("%s failed with status %d: %s", operation, status, strings.TrimSpace(string(body)))
+}
+
+func (client *migrationClient) challenge(phase string) (migration.ChallengeResponse, error) {
+	var challenge migration.ChallengeResponse
+	body, status, err := postJSON(client.httpClient, client.baseURL+"/v1/challenge", migration.ChallengeRequest{InstanceID: client.state.InstanceID, Phase: phase})
+	if err != nil {
+		return challenge, err
+	}
+	if err := responseError("challenge", status, body); err != nil {
+		return challenge, err
+	}
+	if err := json.Unmarshal(body, &challenge); err != nil {
+		return challenge, err
+	}
+	nonce, err := base64.RawURLEncoding.DecodeString(challenge.Nonce)
+	if err != nil || len(nonce) != 32 || !time.Now().Before(challenge.ExpiresAt) {
+		return challenge, errors.New("server returned an invalid challenge")
+	}
+	return challenge, nil
+}
+
+func (signer *tpmSigner) Sign(message []byte) (string, error) {
+	directory, err := os.MkdirTemp("", "rva23-migration-sign-*")
+	if err != nil {
+		return "", err
+	}
+	defer os.RemoveAll(directory)
+	messagePath := filepath.Join(directory, "message.bin")
+	signaturePath := filepath.Join(directory, "signature.bin")
+	if err := os.WriteFile(messagePath, message, 0o600); err != nil {
+		return "", err
+	}
+	handle, err := os.ReadFile(signer.keyFile)
+	if err != nil || len(handle) == 0 {
+		if result, provisionErr := exec.Command("/usr/libexec/rva23-report-provision").CombinedOutput(); provisionErr != nil {
+			return "", fmt.Errorf("provision TPM AK: %s", result)
+		}
+		handle, err = os.ReadFile(signer.keyFile)
+	}
+	if err != nil {
+		return "", err
+	}
+	var keyData struct {
+		Handle string `json:"handle"`
+	}
+	if err := json.Unmarshal(handle, &keyData); err != nil {
+		return "", err
+	}
+	serialized, err := base64.StdEncoding.DecodeString(keyData.Handle)
+	if err != nil || len(serialized) < 4 {
+		return "", errors.New("invalid persistent AK handle")
+	}
+	handleID := fmt.Sprintf("0x%08x", binary.BigEndian.Uint32(serialized[:4]))
+	command := exec.Command("tpm2_sign", "-c", handleID, "-g", "sha256", "-s", "rsassa", "-o", signaturePath, messagePath)
+	if result, err := command.CombinedOutput(); err != nil {
+		return "", fmt.Errorf("tpm2_sign: %s", result)
+	}
+	signature, err := os.ReadFile(signaturePath)
+	if err != nil {
+		return "", err
+	}
+	if len(signature) < 256 {
+		return "", errors.New("TPM AK signature is too short")
+	}
+	return base64.RawURLEncoding.EncodeToString(signature[len(signature)-256:]), nil
+}
+
+func attest(challengeNonce string) (migration.Evidence, error) {
+	var evidence migration.Evidence
+	if result, err := exec.Command("systemctl", "start", "systemd-pcrlock.socket").CombinedOutput(); err != nil {
+		return evidence, fmt.Errorf("systemd-pcrlock.socket: %s", result)
+	}
+	if result, err := exec.Command("systemctl", "restart", "systemd-report-sign-tpm2.socket").CombinedOutput(); err != nil {
+		return evidence, fmt.Errorf("systemd-report-sign-tpm2.socket: %s", result)
+	}
+	command := exec.Command("attested-client")
+	command.Env = append(os.Environ(), "RVA23_ATTESTATION_CAPTURE=1")
+	if result, err := command.CombinedOutput(); err != nil {
+		return evidence, fmt.Errorf("attested-client: %s", result)
+	}
+	report, err := os.ReadFile("/tmp/rva23-attested-body")
+	if err != nil {
+		return evidence, err
+	}
+	nonce, err := os.ReadFile("/tmp/rva23-attested-nonce")
+	if err != nil {
+		return evidence, err
+	}
+	token, err := os.ReadFile("/tmp/rva23-attested-token")
+	if err != nil {
+		return evidence, err
+	}
+	directory, err := os.MkdirTemp("", "rva23-migration-pcr-*")
+	if err != nil {
+		return evidence, err
+	}
+	defer os.RemoveAll(directory)
+	pcrPath := filepath.Join(directory, "pcr11.bin")
+	if result, err := exec.Command("tpm2_pcrread", "sha256:11", "-o", pcrPath).CombinedOutput(); err != nil {
+		return evidence, fmt.Errorf("tpm2_pcrread: %s", result)
+	}
+	pcr11, err := os.ReadFile(pcrPath)
+	if err != nil {
+		return evidence, err
+	}
+	if len(pcr11) != sha256.Size {
+		return evidence, errors.New("TPM PCR 11 must contain one SHA-256 value")
+	}
+	handle, err := os.ReadFile("/var/lib/systemd/report.sign.tpm2/default.key")
+	if err != nil {
+		return evidence, err
+	}
+	var keyData struct {
+		Handle string `json:"handle"`
+	}
+	if err := json.Unmarshal(handle, &keyData); err != nil {
+		return evidence, err
+	}
+	serialized, err := base64.StdEncoding.DecodeString(keyData.Handle)
+	if err != nil || len(serialized) < 4 {
+		return evidence, errors.New("invalid persistent AK handle")
+	}
+	handleID := fmt.Sprintf("0x%08x", binary.BigEndian.Uint32(serialized[:4]))
+	nonceBytes, err := base64.RawURLEncoding.DecodeString(challengeNonce)
+	if err != nil || len(nonceBytes) != 32 {
+		return evidence, errors.New("invalid migration challenge nonce")
+	}
+	quotePath := filepath.Join(directory, "quote.msg")
+	signaturePath := filepath.Join(directory, "quote.sig")
+	selectionsPath := filepath.Join(directory, "quote.pcrs")
+	if result, err := exec.Command("tpm2_quote", "-c", handleID, "-l", "sha256:11", "-q", hex.EncodeToString(nonceBytes), "-m", quotePath, "-s", signaturePath, "-o", selectionsPath, "-g", "sha256").CombinedOutput(); err != nil {
+		return evidence, fmt.Errorf("tpm2_quote: %s", result)
+	}
+	quote, err := os.ReadFile(quotePath)
+	if err != nil {
+		return evidence, err
+	}
+	quoteSignature, err := os.ReadFile(signaturePath)
+	if err != nil {
+		return evidence, err
+	}
+	selections, err := os.ReadFile(selectionsPath)
+	if err != nil {
+		return evidence, err
+	}
+	return migration.Evidence{
+		Report: base64.RawURLEncoding.EncodeToString(report), Nonce: strings.TrimSpace(string(nonce)),
+		Token: strings.TrimSpace(string(token)), PCR11: hex.EncodeToString(pcr11),
+		PCR11Quote: base64.RawURLEncoding.EncodeToString(quote), PCR11Signature: base64.RawURLEncoding.EncodeToString(quoteSignature),
+		PCR11Selections: base64.RawURLEncoding.EncodeToString(selections),
+	}, nil
+}
+
+func (client *migrationClient) attest(phase string) (response migration.AttestationResponse, err error) {
+	defer func() {
+		client.finish("attestation", phase, err)
+	}()
+	if err = migration.ValidatePhase(phase); err != nil {
+		return response, err
+	}
+	challenge, err := client.challenge(phase)
+	if err != nil {
+		return response, err
+	}
+	evidence, err := attest(challenge.Nonce)
+	if err != nil {
+		return response, err
+	}
+	counter, err := client.nextCounter()
+	if err != nil {
+		return response, err
+	}
+	input := migration.AttestationRequest{
+		InstanceID: client.state.InstanceID, PID: client.state.PID, Counter: counter,
+		Phase: phase, Nonce: challenge.Nonce, Evidence: evidence,
+	}
+	message, err := migration.AttestationMessage(input)
+	if err != nil {
+		return response, err
+	}
+	input.Signature, err = client.signer.Sign(message)
+	if err != nil {
+		return response, err
+	}
+	body, status, err := postJSON(client.httpClient, client.baseURL+"/v1/attestations", input)
+	if err != nil {
+		return response, err
+	}
+	if err = responseError("attestation", status, body); err != nil {
+		return response, err
+	}
+	if err = json.Unmarshal(body, &response); err != nil {
+		return response, err
+	}
+	return response, nil
+}
+
+func setCheckpointHeaders(request *http.Request, input migration.CheckpointAuthorization, signature string) {
+	request.Header.Set("X-Migration-Action", input.Action)
+	request.Header.Set("X-Migration-Instance-ID", input.InstanceID)
+	request.Header.Set("X-Migration-PID", strconv.Itoa(input.PID))
+	request.Header.Set("X-Migration-Counter", strconv.FormatUint(input.Counter, 10))
+	request.Header.Set("X-Migration-Phase", input.Phase)
+	request.Header.Set("X-Migration-Nonce", input.Nonce)
+	request.Header.Set("X-Migration-Checkpoint-SHA256", input.CheckpointSHA256)
+	request.Header.Set("X-Migration-Checkpoint-Size", strconv.FormatInt(input.CheckpointSize, 10))
+	request.Header.Set("X-Migration-Signature", signature)
+}
+
+func (client *migrationClient) upload(path string) (digest migration.ArchiveDigest, err error) {
+	defer func() {
+		client.finish(migration.ActionUpload, migration.PhaseBefore, err)
+	}()
+	digest, err = migration.DigestFile(path, client.maxCheckpoint)
+	if err != nil {
+		return digest, err
+	}
+	challenge, err := client.challenge(migration.PhaseBefore)
+	if err != nil {
+		return digest, err
+	}
+	counter, err := client.nextCounter()
+	if err != nil {
+		return digest, err
+	}
+	input := migration.CheckpointAuthorization{
+		Action: migration.ActionUpload, InstanceID: client.state.InstanceID, PID: client.state.PID,
+		Counter: counter, Phase: migration.PhaseBefore, Nonce: challenge.Nonce,
+		CheckpointSHA256: digest.SHA256, CheckpointSize: digest.Size,
+	}
+	message, err := migration.CheckpointMessage(input)
+	if err != nil {
+		return digest, err
+	}
+	signature, err := client.signer.Sign(message)
+	if err != nil {
+		return digest, err
+	}
+	archive, err := os.Open(path)
+	if err != nil {
+		return digest, err
+	}
+	defer archive.Close()
+	request, err := http.NewRequest(http.MethodPut, client.baseURL+"/v1/checkpoints/"+client.state.InstanceID, archive)
+	if err != nil {
+		return digest, err
+	}
+	request.ContentLength = digest.Size
+	request.Header.Set("Content-Type", "application/gzip")
+	setCheckpointHeaders(request, input, signature)
+	response, err := client.httpClient.Do(request)
+	if err != nil {
+		return digest, err
+	}
+	defer response.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(response.Body, maxClientResponseBytes))
+	if err != nil {
+		return digest, err
+	}
+	if err = responseError("checkpoint upload", response.StatusCode, body); err != nil {
+		return digest, err
+	}
+	return digest, nil
+}
+
+func (client *migrationClient) download(path string) (digest migration.ArchiveDigest, err error) {
+	defer func() {
+		client.finish(migration.ActionDownload, migration.PhaseAfter, err)
+	}()
+	challenge, err := client.challenge(migration.PhaseAfter)
+	if err != nil {
+		return digest, err
+	}
+	counter, err := client.nextCounter()
+	if err != nil {
+		return digest, err
+	}
+	input := migration.CheckpointAuthorization{
+		Action: migration.ActionDownload, InstanceID: client.state.InstanceID, PID: client.state.PID,
+		Counter: counter, Phase: migration.PhaseAfter, Nonce: challenge.Nonce,
+	}
+	message, err := migration.CheckpointMessage(input)
+	if err != nil {
+		return digest, err
+	}
+	signature, err := client.signer.Sign(message)
+	if err != nil {
+		return digest, err
+	}
+	request, err := http.NewRequest(http.MethodPost, client.baseURL+"/v1/checkpoints/"+client.state.InstanceID+"/download", nil)
+	if err != nil {
+		return digest, err
+	}
+	setCheckpointHeaders(request, input, signature)
+	response, err := client.httpClient.Do(request)
+	if err != nil {
+		return digest, err
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		body, _ := io.ReadAll(io.LimitReader(response.Body, maxClientResponseBytes))
+		return digest, responseError("checkpoint download", response.StatusCode, body)
+	}
+	if response.ContentLength < 0 || response.ContentLength > client.maxCheckpoint {
+		return digest, errors.New("download exceeds the checkpoint size limit")
+	}
+	expectedDigest := response.Header.Get("X-Checkpoint-SHA256")
+	decodedDigest, err := hex.DecodeString(expectedDigest)
+	if err != nil || len(decodedDigest) != sha256.Size {
+		return digest, errors.New("server returned an invalid checkpoint digest")
+	}
+	output, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+	if err != nil {
+		return digest, err
+	}
+	completed := false
+	defer func() {
+		output.Close()
+		if !completed {
+			os.Remove(path)
+		}
+	}()
+	hash := sha256.New()
+	written, err := io.Copy(io.MultiWriter(output, hash), io.LimitReader(response.Body, client.maxCheckpoint+1))
+	if err != nil {
+		return digest, err
+	}
+	if written != response.ContentLength || written > client.maxCheckpoint {
+		return digest, errors.New("download size does not match the response")
+	}
+	if !strings.EqualFold(hex.EncodeToString(hash.Sum(nil)), expectedDigest) {
+		return digest, errors.New("download digest does not match the response")
+	}
+	if err := output.Sync(); err != nil {
+		return digest, err
+	}
+	if err := output.Close(); err != nil {
+		return digest, err
+	}
+	digest.Size = written
+	digest.SHA256 = expectedDigest
+	completed = true
+	return digest, nil
+}
+
+func clientUIHandler(client *migrationClient) http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("/api/state", func(writer http.ResponseWriter, request *http.Request) {
+		if request.Method != http.MethodGet {
+			writer.Header().Set("Allow", http.MethodGet)
+			http.Error(writer, "method not allowed", http.StatusMethodNotAllowed)
+			return
+		}
+		writer.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(writer).Encode(client.snapshot())
+	})
+	mux.HandleFunc("/", func(writer http.ResponseWriter, request *http.Request) {
+		if request.URL.Path != "/" {
+			http.NotFound(writer, request)
+			return
+		}
+		if request.Method != http.MethodGet {
+			writer.Header().Set("Allow", http.MethodGet)
+			http.Error(writer, "method not allowed", http.StatusMethodNotAllowed)
+			return
+		}
+		writer.Header().Set("Content-Type", "text/html; charset=utf-8")
+		_, _ = io.WriteString(writer, `<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CRIU migration client</title></head>
+<body><h1>CRIU migration client</h1><p><button id="refresh" type="button">Refresh</button> <span id="status">Loading</span></p><div id="state">Loading</div>
+<script>
+function label(key){const names={instanceId:'Instance ID',pid:'PID',lastPhase:'Last phase',lastOperation:'Last operation',lastError:'Last error',updatedAt:'Updated at'};return names[key]||key}
+function render(value){const table=document.createElement('table');const body=document.createElement('tbody');for(const [key,entry] of Object.entries(value||{})){const row=document.createElement('tr');const heading=document.createElement('th');heading.scope='row';heading.textContent=label(key);const cell=document.createElement('td');cell.textContent=entry===null||entry===undefined||entry===''?'None':String(entry);row.append(heading,cell);body.append(row)}table.append(body);return table}
+function raw(value){const details=document.createElement('details');const summary=document.createElement('summary');summary.textContent='Raw JSON';const pre=document.createElement('pre');pre.textContent=JSON.stringify(value,null,2);details.append(summary,pre);return details}
+async function refresh(){const status=document.getElementById('status');try{const response=await fetch('/api/state');if(!response.ok)throw new Error(response.statusText);const data=await response.json();document.getElementById('state').replaceChildren(render(data),raw(data));status.textContent='Updated '+data.updatedAt}catch(error){status.textContent='Refresh failed: '+error.message}}
+document.getElementById('refresh').onclick=refresh;refresh()
+</script></body></html>`)
+	})
+	return mux
+}
+
+func printJSON(value any) error {
+	encoded, err := json.MarshalIndent(value, "", "  ")
+	if err != nil {
+		return err
+	}
+	fmt.Println(string(encoded))
+	return nil
+}
+
+func run() error {
+	if len(os.Args) > 1 && os.Args[1] == "archive" {
+		flags := flag.NewFlagSet("archive", flag.ContinueOnError)
+		source := flags.String("source", "", "checkpoint image directory")
+		output := flags.String("output", "", "new checkpoint archive")
+		if err := flags.Parse(os.Args[2:]); err != nil {
+			return err
+		}
+		if *source == "" || *output == "" {
+			return errors.New("archive requires -source and -output")
+		}
+		digest, err := migration.ArchiveCheckpoint(*source, *output, migration.DefaultMaxCheckpointBytes)
+		if err != nil {
+			return err
+		}
+		return printJSON(digest)
+	}
+	if len(os.Args) > 1 && os.Args[1] == "extract" {
+		flags := flag.NewFlagSet("extract", flag.ContinueOnError)
+		archive := flags.String("archive", "", "checkpoint archive")
+		destination := flags.String("destination", "", "new extraction directory")
+		if err := flags.Parse(os.Args[2:]); err != nil {
+			return err
+		}
+		if *archive == "" || *destination == "" {
+			return errors.New("extract requires -archive and -destination")
+		}
+		return migration.ExtractCheckpoint(*archive, *destination, migration.DefaultMaxCheckpointBytes)
+	}
+	client, err := newMigrationClient()
+	if err != nil {
+		return err
+	}
+	if len(os.Args) == 1 || os.Args[1] == "serve" {
+		httpServer := &http.Server{
+			Addr: "0.0.0.0:8084", Handler: clientUIHandler(client), ReadHeaderTimeout: 5 * time.Second,
+			ReadTimeout: 30 * time.Second, WriteTimeout: 30 * time.Second, IdleTimeout: 60 * time.Second, MaxHeaderBytes: 64 * 1024,
+		}
+		return httpServer.ListenAndServe()
+	}
+	switch os.Args[1] {
+	case "attest":
+		flags := flag.NewFlagSet("attest", flag.ContinueOnError)
+		phase := flags.String("phase", "", "before or after")
+		if err := flags.Parse(os.Args[2:]); err != nil {
+			return err
+		}
+		response, err := client.attest(*phase)
+		if err != nil {
+			return err
+		}
+		return printJSON(response)
+	case "upload":
+		flags := flag.NewFlagSet("upload", flag.ContinueOnError)
+		archive := flags.String("archive", "", "checkpoint archive")
+		if err := flags.Parse(os.Args[2:]); err != nil {
+			return err
+		}
+		if *archive == "" {
+			return errors.New("upload requires -archive")
+		}
+		digest, err := client.upload(*archive)
+		if err != nil {
+			return err
+		}
+		return printJSON(digest)
+	case "download":
+		flags := flag.NewFlagSet("download", flag.ContinueOnError)
+		output := flags.String("output", "", "new checkpoint archive")
+		if err := flags.Parse(os.Args[2:]); err != nil {
+			return err
+		}
+		if *output == "" {
+			return errors.New("download requires -output")
+		}
+		digest, err := client.download(*output)
+		if err != nil {
+			return err
+		}
+		return printJSON(digest)
+	default:
+		return errors.New("use serve, attest, archive, upload, download, or extract")
+	}
+}
+
+func main() {
+	if err := run(); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
