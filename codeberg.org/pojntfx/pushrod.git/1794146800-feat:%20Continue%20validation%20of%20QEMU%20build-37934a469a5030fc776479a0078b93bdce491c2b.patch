diff --git a/buildroot/Makefile b/buildroot/Makefile
index 942a90f8240f53b473014c5a12afccf3a0781c24..bb95e40780ea13d983350efee4bbb86473a2dd6a 100644
--- a/buildroot/Makefile
+++ b/buildroot/Makefile
@@ -18,25 +18,30 @@ MAKE_BUILDROOT = $(MAKE) -C $(BUILDROOT_DIR) O=$(OUTPUT_DIR) BR2_HOST_DIR=$(HOST_DIR) BR2_EXTERNAL=$(THIS_EXTERNAL_PATH) BR2_DL_DIR=$(BR2_DL_DIR) BR2_CCACHE_DIR=$(BR2_CCACHE_DIR) CCACHE_DIR=$(BR2_CCACHE_DIR) CCACHE_BASEDIR=$(OUTPUT_DIR) $(COMMON_TOOLCHAIN_OVERRIDES) UBOOT_OVERRIDE_SRCDIR=$(UBOOT_OVERRIDE_SRCDIR) RVA23_KEY_DIR=$(RVA23_KEY_DIR)
 MAKE_BUILDROOT_K3 = $(MAKE) -C $(BUILDROOT_DIR) O=$(K3_OUTPUT_DIR) BR2_HOST_DIR=$(HOST_DIR) BR2_EXTERNAL=$(THIS_EXTERNAL_PATH) BR2_DL_DIR=$(BR2_DL_DIR) BR2_CCACHE_DIR=$(BR2_CCACHE_DIR) CCACHE_DIR=$(BR2_CCACHE_DIR) CCACHE_BASEDIR=$(K3_OUTPUT_DIR) $(COMMON_TOOLCHAIN_OVERRIDES) LINUX_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/linux OPENSBI_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/opensbi-vendor EDK2_SPACEMIT_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/edk2-spacemit K3_LINUX_FIRMWARE_DIR=$(K3_LINUX_FIRMWARE_DIR)
 BUILDROOT_PATCHES = $(sort $(wildcard $(THIS_EXTERNAL_PATH)/patches/buildroot/*.patch))
 
-.PHONY: all configure build clean k3-configure k3-build k3-clean k3-registry share-k3-to-qemu k3-verify-image k3-verify-firmware k3-verify-base k3-verify-attestation k3-verify-report k3-verify-update k3-verify-hardening k3-verify-podman k3-verify-k3s k3-verify-wallet k3-verify-migration k3-verify-mutual-migration k3-verify registry verify verify-image verify-boot verify-firmware verify-attestation verify-report verify-update verify-security verify-hardening verify-podman verify-k3s verify-attested-app verify-wallet verify-migration verify-mutual-migration demo-servers boot boot-display boot-firmware
+.PHONY: all configure build clean rva23-fix-host-rpaths k3-configure k3-build k3-clean k3-registry share-k3-to-qemu k3-verify-image k3-verify-firmware k3-verify-base k3-verify-attestation k3-verify-report k3-verify-update k3-verify-hardening k3-verify-podman k3-verify-k3s k3-verify-wallet k3-verify-migration k3-verify-mutual-migration k3-verify registry verify verify-image verify-boot verify-firmware verify-attestation verify-report verify-update verify-security verify-hardening verify-podman verify-k3s verify-attested-app verify-wallet verify-migration verify-mutual-migration demo-servers boot boot-display boot-firmware
 
 all: build k3-build
 
+rva23-fix-host-rpaths:
+	python3 scripts/fix-host-rpaths.py $(HOST_DIR)
+
 configure:
 	for patch in $(BUILDROOT_PATCHES); do git -C $(BUILDROOT_DIR) apply --reverse --check "$$patch" || exit 1; done
 	$(MAKE_BUILDROOT) rva23_defconfig
 	$(MAKE_BUILDROOT) rva23-refresh-toolchain-wrapper
 
-build: configure share-k3-to-qemu
+build: rva23-fix-host-rpaths configure share-k3-to-qemu
 	$(MAKE_BUILDROOT)
+	$(MAKE) rva23-fix-host-rpaths
 
 k3-configure:
 	for patch in $(BUILDROOT_PATCHES); do git -C $(BUILDROOT_DIR) apply --reverse --check "$$patch" || exit 1; done
 	$(MAKE_BUILDROOT_K3) k3_uefi_defconfig
 	$(MAKE_BUILDROOT_K3) rva23-refresh-toolchain-wrapper
 
-k3-build: k3-configure
+k3-build: rva23-fix-host-rpaths k3-configure
 	$(MAKE_BUILDROOT_K3) -j14
+	$(MAKE) rva23-fix-host-rpaths
 
 clean:
 	$(MAKE_BUILDROOT) clean
