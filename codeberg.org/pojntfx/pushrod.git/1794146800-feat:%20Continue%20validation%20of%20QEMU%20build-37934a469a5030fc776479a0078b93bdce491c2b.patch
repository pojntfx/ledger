+def trim_tcg2(path):
+    data = path.read_bytes()
+    if len(data) < 32:
+        raise ValueError(f"short TPM log: {path}")
+    event_type = struct.unpack_from("<I", data, 4)[0]
+    if event_type == 3:
+        offset = 32 + struct.unpack_from("<I", data, 28)[0]
+    else:
+        offset = 0
+    while offset + 16 <= len(data):
+        _, event_type, count = struct.unpack_from("<III", data, offset)
+        if event_type == 0:
+            break
+        pos = offset + 12
+        for _ in range(count):
+            algorithm = struct.unpack_from("<H", data, pos)[0]
+            digest_size = {0x0004: 20, 0x000b: 32, 0x000c: 48, 0x000d: 64, 0x0012: 32}.get(algorithm)
+            if digest_size is None:
+                raise ValueError(f"unknown TPM digest algorithm {algorithm:#x}")
+            pos += 2 + digest_size
+        event_size = struct.unpack_from("<I", data, pos)[0]
+        pos += 4 + event_size
+        if pos > len(data):
+            raise ValueError(f"invalid TPM event at {offset:x}")
+        offset = pos
+    path.write_bytes(data[:offset])
+
