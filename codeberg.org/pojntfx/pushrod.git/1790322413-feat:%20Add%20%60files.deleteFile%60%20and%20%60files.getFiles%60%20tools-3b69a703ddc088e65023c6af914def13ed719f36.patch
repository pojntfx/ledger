diff --git a/pkg/svc/files_delete_file.go b/pkg/svc/files_delete_file.go
new file mode 100644
index 0000000000000000000000000000000000000000..2dc152251bfca44f45f474bf2bcccf37a701d72c
--- /dev/null
+++ b/pkg/svc/files_delete_file.go
@@ -0,0 +1,42 @@
+package svc
+
+import (
+	"context"
+	"os"
+
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+var (
+	DeleteFileTool = &mcp.Tool{
+		Name:        "files.deleteFile",
+		Title:       "Delete file",
+		Description: "Delete a file from the server",
+		Annotations: &mcp.ToolAnnotations{DestructiveHint: new(true)},
+	}
+)
+
+type DeleteFileInput struct {
+	Name string `json:"name" jsonschema:"name of the file to delete"`
+}
+
+func (s *Service) DeleteFile(ctx context.Context, req *mcp.CallToolRequest, input DeleteFileInput) (*mcp.CallToolResult, *GetFilesOutput, error) {
+	root, err := os.OpenRoot(s.filesDir)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer root.Close()
+
+	if err := root.Remove(input.Name); err != nil {
+		return nil, nil, err
+	}
+
+	files, err := s.listFiles()
+	if err != nil {
+		return nil, nil, err
+	}
+
+	return nil, &GetFilesOutput{
+		Files: files,
+	}, nil
+}
diff --git a/pkg/svc/files_get_files.go b/pkg/svc/files_get_files.go
new file mode 100644
index 0000000000000000000000000000000000000000..da5b3f536ee912ff2939584411561eb5333be293
--- /dev/null
+++ b/pkg/svc/files_get_files.go
@@ -0,0 +1,46 @@
+package svc
+
+import (
+	"context"
+	"os"
+
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+var (
+	GetFilesTool = &mcp.Tool{
+		Name:        "files.getFiles",
+		Title:       "Get files",
+		Description: "Get all files on the server that other tools can reference by name",
+		Annotations: &mcp.ToolAnnotations{ReadOnlyHint: true},
+	}
+)
+
+type GetFilesOutput struct {
+	Files []string `json:"files" jsonschema:"names of the files on the server"`
+}
+
+func (s *Service) listFiles() ([]string, error) {
+	entries, err := os.ReadDir(s.filesDir)
+	if err != nil {
+		return nil, err
+	}
+
+	files := []string{}
+	for _, entry := range entries {
+		files = append(files, entry.Name())
+	}
+
+	return files, nil
+}
+
+func (s *Service) GetFiles(ctx context.Context, req *mcp.CallToolRequest, input struct{}) (*mcp.CallToolResult, *GetFilesOutput, error) {
+	files, err := s.listFiles()
+	if err != nil {
+		return nil, nil, err
+	}
+
+	return nil, &GetFilesOutput{
+		Files: files,
+	}, nil
+}
