From 4c1d5866c27141e69d3a80c7dad28b2f0360486a Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Mon, 21 Sep 2026 22:48:12 -0700
Subject: [PATCH] feat: Add filter based on vendor and product ID

Signed-off-by: Felicitas Pojtinger <felicitas@pojtinger.com>
---
diff --git a/pkg/svc/kvm_get_input_devices.go b/pkg/svc/kvm_get_input_devices.go
index 7c17c818ea2ebd586794ac6fdbc1128423051a5a..b0db2e9394bb4ea3f9be1875688d19c0b8ca08a2 100644
--- a/pkg/svc/kvm_get_input_devices.go
+++ b/pkg/svc/kvm_get_input_devices.go
@@ -25,6 +25,10 @@ type GetInputDevicesOutput struct {
 	InputDevices []InputDevice `json:"inputDevices" jsonschema:"connected input devices"`
 }
 
+func isKVMInput(port *enumerator.PortDetails) bool {
+	return strings.EqualFold(port.VID, KVM_INPUT_VENDOR_ID) && strings.EqualFold(port.PID, KVM_INPUT_PRODUCT_ID)
+}
+
 func (s *Service) GetInputDevices(ctx context.Context, req *mcp.CallToolRequest, input struct{}) (*mcp.CallToolResult, *GetInputDevicesOutput, error) {
 	ports, err := enumerator.GetDetailedPortsList()
 	if err != nil {
@@ -33,10 +37,7 @@ 	}
 
 	inputDevices := []InputDevice{}
 	for _, port := range ports {
-		if !port.IsUSB ||
-			!strings.EqualFold(port.VID, KVM_INPUT_VENDOR_ID) ||
-			!strings.EqualFold(port.PID, KVM_INPUT_PRODUCT_ID) {
-
+		if !port.IsUSB || !isKVMInput(port) {
 			continue
 		}
 
diff --git a/pkg/svc/kvm_get_video_capture_devices.go b/pkg/svc/kvm_get_video_capture_devices.go
index 925b3764aa76a5c97ad6f6ff7fc534f018523c8f..1fcdaf7a7c4a3a6adf95e1a9a369bfc07aa267c2 100644
--- a/pkg/svc/kvm_get_video_capture_devices.go
+++ b/pkg/svc/kvm_get_video_capture_devices.go
@@ -3,7 +3,9 @@
 import (
 	"context"
 	"log/slog"
+	"os"
 	"path/filepath"
+	"strings"
 
 	"github.com/blackjack/webcam"
 	"github.com/modelcontextprotocol/go-sdk/mcp"
@@ -13,50 +15,93 @@ var (
 	GetVideoCaptureDevicesTool = &mcp.Tool{
 		Name:        "kvm.getVideoCaptureDevices",
 		Title:       "Get video capture devices",
-		Description: "Get all currently connected video capture devices",
+		Description: "Get all currently connected KVM video capture devices",
 		Annotations: &mcp.ToolAnnotations{ReadOnlyHint: true},
 	}
 )
 
+const (
+	video4linuxClassPath = "/sys/class/video4linux"
+	videoDeviceGlob      = "/dev/video*"
+)
+
 type VideoCaptureDevice struct {
 	Path string `json:"path" jsonschema:"path that uniquely identifies the video capture device until it gets unplugged"`
+	Name string `json:"name" jsonschema:"name that the video capture device reports for itself"`
 }
 
 type GetVideoCaptureDevicesOutput struct {
 	VideoCaptureDevices []VideoCaptureDevice `json:"videoCaptureDevices" jsonschema:"connected video capture devices"`
 }
 
-func isVideoCaptureDevice(path string) (bool, error) {
+func isKVMVideo(vendorID, productID string) bool {
+	return strings.EqualFold(vendorID, KVM_VIDEO_VENDOR_ID) && strings.EqualFold(productID, KVM_VIDEO_PRODUCT_ID)
+}
+
+func usbIDs(path string) (string, string, error) {
+	devicePath, err := filepath.EvalSymlinks(filepath.Join(video4linuxClassPath, filepath.Base(path), "device"))
+	if err != nil {
+		return "", "", err
+	}
+
+	// The node belongs to a USB interface, so walk up to the USB device that has the IDs
+	for dir := devicePath; dir != "/"; dir = filepath.Dir(dir) {
+		vendorID, err := os.ReadFile(filepath.Join(dir, "idVendor"))
+		if err != nil {
+			continue
+		}
+
+		productID, err := os.ReadFile(filepath.Join(dir, "idProduct"))
+		if err != nil {
+			continue
+		}
+
+		return strings.TrimSpace(string(vendorID)), strings.TrimSpace(string(productID)), nil
+	}
+
+	return "", "", nil
+}
+
+func videoCaptureDeviceName(path string) (string, error) {
 	device, err := webcam.Open(path)
 	if err != nil {
-		return false, err
+		return "", err
 	}
 	defer device.Close()
 
-	return len(device.GetSupportedFormats()) > 0, nil
+	return device.GetName()
 }
 
 func (s *Service) GetVideoCaptureDevices(ctx context.Context, req *mcp.CallToolRequest, input struct{}) (*mcp.CallToolResult, *GetVideoCaptureDevicesOutput, error) {
-	paths, err := filepath.Glob("/dev/video*")
+	paths, err := filepath.Glob(videoDeviceGlob)
 	if err != nil {
 		return nil, nil, err
 	}
 
 	videoCaptureDevices := []VideoCaptureDevice{}
 	for _, path := range paths {
-		isCaptureDevice, err := isVideoCaptureDevice(path)
+		vendorID, productID, err := usbIDs(path)
 		if err != nil {
-			slog.Error("Could not check whether device is a video capture device, skipping", "path", path, "err", err)
+			slog.Error("Could not resolve USB IDs of video capture device, skipping", "path", path, "err", err)
 
 			continue
 		}
 
-		if !isCaptureDevice {
+		// Skip regular webcams and other video devices
+		if !isKVMVideo(vendorID, productID) {
+			continue
+		}
+
+		name, err := videoCaptureDeviceName(path)
+		if err != nil {
+			slog.Error("Could not get name of video capture device, skipping", "path", path, "err", err)
+
 			continue
 		}
 
 		videoCaptureDevices = append(videoCaptureDevices, VideoCaptureDevice{
 			Path: path,
+			Name: name,
 		})
 	}
 
diff --git a/pkg/svc/root.go b/pkg/svc/root.go
index 103cb400b5ae524b41b257f2fd4b4398708e0b57..a6fbf1aa954f423fca6c238117dd19f211f443ab 100644
--- a/pkg/svc/root.go
+++ b/pkg/svc/root.go
@@ -20,6 +20,12 @@ 	// See https://the-sz.com/products/usbid/index.php?v=0x1a86&p=0x55d3&n=
 	// CH343 USB-serial bridge
 	KVM_INPUT_VENDOR_ID  = "1a86"
 	KVM_INPUT_PRODUCT_ID = "55d3"
+
+	// See https://linux-hardware.org/?id=usb:345f-2131
+	// and https://wiki.sipeed.com/hardware/en/kvm/NanoKVM_USB/faq.html for the MS2131 firmware
+	// The NanoKVM-USB's HDMI capture device
+	KVM_VIDEO_VENDOR_ID  = "345f"
+	KVM_VIDEO_PRODUCT_ID = "2131"
 )
 
 type Service struct {

