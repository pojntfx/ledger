diff --git a/buildroot/scripts/prepare-target.py b/buildroot/scripts/prepare-target.py
index c8c45c60d4230c6e1d99d5a2c2e8449207b09d1f..cb763eb1a59abdbcb3869da43c453d6b8ccecb96 100755
--- a/buildroot/scripts/prepare-target.py
+++ b/buildroot/scripts/prepare-target.py
@@ -25,6 +25,7 @@         (101, "systemd-network", "/var/lib/systemd/network"),
         (102, "systemd-resolve", "/var/lib/systemd/resolve"),
         (103, "systemd-timesync", "/var/lib/systemd/timesync"),
         (104, "tss", "/var/lib/tss"),
+        (105, "sshd", "/var/empty"),
     ]
     passwd = target / "usr/share/factory/etc/passwd"
     group = target / "usr/share/factory/etc/group"
@@ -37,6 +38,14 @@         if not any(line.startswith(f"{name}:") for line in group_lines):
             group_lines.append(f"{name}:x:{uid}:")
     passwd.write_text("\n".join(passwd_lines) + "\n")
     group.write_text("\n".join(group_lines) + "\n")
+    target_passwd = target / "etc/passwd"
+    target_group = target / "etc/group"
+    if not any(line.startswith("sshd:") for line in target_passwd.read_text().splitlines()):
+        with target_passwd.open("a") as stream:
+            stream.write("sshd:x:105:105:sshd:/var/empty:/usr/bin/false\n")
+    if not any(line.startswith("sshd:") for line in target_group.read_text().splitlines()):
+        with target_group.open("a") as stream:
+            stream.write("sshd:x:105:\n")
 
 
 def ensure_ssh_host_keys(target):
diff --git a/buildroot/scripts/share-host-packages.py b/buildroot/scripts/share-host-packages.py
index 3f1bd47ebb58fcfc7772db8d8632e28c6a810f5e..16faffdba338a28c4860f75f64a832029217c467 100644
--- a/buildroot/scripts/share-host-packages.py
+++ b/buildroot/scripts/share-host-packages.py
@@ -43,6 +43,12 @@     patchelf = destination_output.parent / "host/bin/patchelf"
     for directory, _, files in os.walk(destination_output / "per-package"):
         for name in files:
             path = os.path.join(directory, name)
+            try:
+                with open(path, "rb") as stream:
+                    if stream.read(4) != b"\x7fELF":
+                        continue
+            except OSError:
+                continue
             result = subprocess.run([patchelf, "--print-rpath", path], capture_output=True, text=True, check=False)
             if result.returncode != 0:
                 continue

