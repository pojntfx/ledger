index 0000000000000000000000000000000000000000..6ac9efd3e20655e6ce6644b2075b8fc528b57272
--- /dev/null
+++ b/buildroot/qemu/scripts/verify-attestation.py
@@ -0,0 +1,163 @@
+#!/usr/bin/env python3
+import base64
+import json
+from pathlib import Path
+import re
+import secrets
+import shutil
+import struct
+import subprocess
+import sys
+
+from verify_boot import Console
+
+
+def copy_guest_file(console, source, destination):
+    text = console.capture(f"printf '__BEGIN__\\n'; base64 {source}; printf '__END__\\n'", 120)
+    match = re.search(r"__BEGIN__\r?\n(.*?)\r?\n__END__", text, re.DOTALL)
+    assert match, text[-2000:]
+    destination.write_bytes(base64.b64decode(re.sub(r"\s", "", match.group(1))))
+
+
+def trim_tcg2(path):
+    data = path.read_bytes()
+    if len(data) < 32:
+        raise ValueError(f"short TPM log: {path}")
+    event_type = struct.unpack_from("<I", data, 4)[0]
+    if event_type == 3:
+        offset = 32 + struct.unpack_from("<I", data, 28)[0]
+    else:
+        offset = 0
+    while offset + 16 <= len(data):
+        _, event_type, count = struct.unpack_from("<III", data, offset)
+        if event_type == 0:
+            break
+        pos = offset + 12
+        for _ in range(count):
+            algorithm = struct.unpack_from("<H", data, pos)[0]
+            digest_size = {0x0004: 20, 0x000b: 32, 0x000c: 48, 0x000d: 64, 0x0012: 32}.get(algorithm)
+            if digest_size is None:
+                raise ValueError(f"unknown TPM digest algorithm {algorithm:#x}")
+            pos += 2 + digest_size
+        event_size = struct.unpack_from("<I", data, pos)[0]
+        pos += 4 + event_size
+        if pos > len(data):
+            raise ValueError(f"invalid TPM event at {offset:x}")
+        offset = pos
+    path.write_bytes(data[:offset])
+
+
+def first_event_end(data):
+    if len(data) < 32 or struct.unpack_from("<I", data, 4)[0] != 3:
+        raise ValueError("missing TCG2 log header")
+    return 32 + struct.unpack_from("<I", data, 28)[0]
+
+
+def main():
+    output = Path(sys.argv[1]).resolve()
+    key_dir = Path(sys.argv[2]).resolve()
+    images = output / "images"
+    destination = output / "attestation"
+    destination.mkdir(exist_ok=True)
+    initial_variables = output / "build/edk2-edk2-stable202602/Build/RiscVVirtQemu/RELEASE_GCC5/FV/RISCV_VIRT_VARS.fd"
+    shutil.copyfile(initial_variables, images / "RISCV_VIRT_VARS.fd")
+    (images / "RISCV_VIRT_VARS.fd").write_bytes((images / "RISCV_VIRT_VARS.fd").read_bytes().ljust(32 * 1024 * 1024, b"\0"))
+    console = Console(output, "attestation.log", firmware=True)
+    nonce = secrets.token_hex(32)
+    try:
+        console.expect(b"rva23 login:", 300)
+        console.sendline("root")
+        console.expect(b"# ", 30)
+        console.command("systemctl is-active --quiet --wait graphical.target")
+        guest = "/var/lib/rva23-attestation"
+        console.command(f"mkdir -p {guest}")
+        console.command(f"cp /sys/kernel/security/tpm0/binary_bios_measurements {guest}/firmware.tcglog")
+        console.command(f"cp /sys/kernel/security/tpm0/binary_early_measurements {guest}/early.tcglog")
+        console.command(f"if [ -f /run/log/systemd/tpm2-measure.log ]; then cp /run/log/systemd/tpm2-measure.log {guest}/userspace.json; else printf '{{}}' > {guest}/userspace.json; fi")
+        console.command(f"tpm2_createek -c {guest}/ek.ctx -G rsa -u {guest}/ek.pub", 180)
+        console.command(f"tpm2_createak -C {guest}/ek.ctx -c {guest}/ak.ctx -G rsa -g sha256 -s rsassa -u {guest}/ak.pub -f pem -n {guest}/ak.name", 180)
+        console.command(f"tpm2_quote -c {guest}/ak.ctx -l sha256:11 -q {nonce} -m {guest}/quote.msg -s {guest}/quote.sig -o {guest}/quote.pcrs -g sha256", 180)
+        console.command(f"tpm2_pcrread sha256:11 -o {guest}/pcr11.bin")
+        stub_pcr = console.capture("od -An -t u1 /sys/firmware/efi/efivars/StubPcrKernelImage-*")
+        assert re.search(r"49\s+0\s+49\s+0", stub_pcr), stub_pcr
+        for name in ("firmware.tcglog", "early.tcglog", "userspace.json", "ak.pub", "quote.msg", "quote.sig", "quote.pcrs", "pcr11.bin"):
+            copy_guest_file(console, f"{guest}/{name}", destination / name)
+        supported = console.capture("/usr/lib/systemd/systemd-pcrlock is-supported || true")
+        (destination / "pcrlock-support.txt").write_text(supported)
+        log = console.capture("/usr/lib/systemd/systemd-pcrlock --no-pager log --pcr=11 || true", 120)
+        (destination / "pcrlock-log.txt").write_text(log)
+        console.sendline("poweroff")
+        console.process.wait(timeout=90)
+    finally:
+        console.close()
+    trim_tcg2(destination / "firmware.tcglog")
+    trim_tcg2(destination / "early.tcglog")
+    firmware_data = (destination / "firmware.tcglog").read_bytes()
+    early_data = (destination / "early.tcglog").read_bytes()
+    (destination / "complete.tcglog").write_bytes(early_data + firmware_data[first_event_end(firmware_data):])
+    subprocess.run(["tpm2_eventlog", destination / "firmware.tcglog"], check=True, stdout=(destination / "firmware-events.txt").open("w"))
+    subprocess.run(["tpm2_eventlog", destination / "early.tcglog"], check=True, stdout=(destination / "early-events.txt").open("w"))
+    subprocess.run(["tpm2_eventlog", destination / "complete.tcglog"], check=True, stdout=(destination / "complete-events.txt").open("w"))
+    subprocess.run(
+        [
+            "tpm2_checkquote", "-u", destination / "ak.pub", "-m", destination / "quote.msg",
+            "-s", destination / "quote.sig", "-f", destination / "quote.pcrs", "-g", "sha256", "-q", nonce,
+        ],
+        check=True,
+    )
+    cmdline = destination / "prediction.cmdline"
+    cmdline.write_text((images / "rva23_1+3-0.efi.cmdline").read_text().rstrip("\n"))
+    uname = destination / "prediction.uname"
+    uname.write_text(next(output.glob("build/linux-*/include/config/kernel.release")).read_text().rstrip("\n"))
+    sbat = destination / "prediction.sbat"
+    subprocess.run(
+        [
+            output / "host/bin/riscv64-linux-objcopy", "-O", "binary", "--only-section=.sbat",
+            images / "efi-part/EFI/Linux/rva23_1+3-0.efi", sbat,
+        ],
+        check=True,
+    )
+    result = subprocess.run(
+        [
+            "/usr/lib/systemd/systemd-measure", "calculate",
+            "--linux", images / "Image",
+            "--initrd", images / "rootfs.cpio.gz",
+            "--osrel", images / "image-staging/usr/lib/os-release",
+            "--cmdline", cmdline,
+            "--uname", uname,
+            "--sbat", sbat,
+            "--pcrpkey", key_dir / "pcr-public.pem",
+            "--bank", "sha256",
+            "--phase", "enter-initrd:leave-initrd:sysinit:ready",
+        ],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    (destination / "pcr11-prediction.txt").write_text(result.stdout)
+    match = re.search(r"11:sha256=([0-9a-f]{64})", result.stdout)
+    assert match, result.stdout
+    predicted = bytes.fromhex(match.group(1))
+    actual = (destination / "pcr11.bin").read_bytes()
+    assert len(actual) == 32, len(actual)
+    assert actual == predicted, f"PCR 11 mismatch: predicted {predicted.hex()}, actual {actual.hex()}"
+    assert (destination / "firmware.tcglog").stat().st_size > 0
+    early_events = (destination / "early-events.txt").read_text()
+    complete_data = (destination / "complete.tcglog").read_bytes()
+    assert "U-Boot SPL" in early_events
+    assert "/fit-images/opensbi" in early_events
+    assert "/fit-images/edk2" in early_events
+    assert ".linux".encode("utf-16-le") in firmware_data
+    assert ".initrd".encode("utf-16-le") in firmware_data
+    assert b"U-Boot SPL" in complete_data
+    assert ".linux".encode("utf-16-le") in complete_data
+    userspace_records = [json.loads(line.lstrip("\x1e")) for line in (destination / "userspace.json").read_text().splitlines() if line.strip()]
+    assert any(record.get("pcr") == 11 for record in userspace_records)
+    (destination / "reference.json").write_text(json.dumps({"pcr11": actual.hex(), "nonce": nonce}, indent=2) + "\n")
+    print("PASS: PCR 11 matches the build prediction")
+    print("PASS: TPM quote binds PCR 11 to a fresh nonce and the enrolled attestation key")
+    print("PASS: SPL, EDK2, and systemd event logs are readable")
+
+
+if __name__ == "__main__":
