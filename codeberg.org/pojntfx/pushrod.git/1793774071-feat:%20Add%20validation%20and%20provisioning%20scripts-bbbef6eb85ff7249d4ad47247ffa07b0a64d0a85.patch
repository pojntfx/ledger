index 0000000000000000000000000000000000000000..df5abd9f1b4a5c1e05b8a0536976a2dc301b0ada
--- /dev/null
+++ b/buildroot/qemu/scripts/verify-hardening.py
@@ -0,0 +1,83 @@
+#!/usr/bin/env python3
+from pathlib import Path
+import re
+import sys
+
+from verify_boot import Console
+
+
+def login(console, timeout=300):
+    console.expect(b"rva23 login:", timeout)
+    console.sendline("root")
+    console.expect(b"# ", 30)
+
+
+def os_version(console):
+    text = console.capture("sed -n 's/^IMAGE_VERSION=[\\\"]*\\([0-9][0-9]*\\)[\\\"].*/\\1/p' /usr/lib/os-release")
+    match = re.search(r"(?:^|\r?\n)(\d+)\r?\n", text)
+    assert match, text
+    return match.group(1)
+
+
+def extension_checks(console, version, include_confext):
+    policy = "root=signed+absent:usr=signed+absent"
+    console.command(f"systemd-sysext status | grep -q graphics_{version}")
+    if include_confext:
+        console.command(f"systemd-confext status | grep -q debug_{version}")
+    console.command("XDG_RUNTIME_DIR=/run/weston WAYLAND_DISPLAY=wayland-1 wayland-info >/dev/null")
+    graphics = f"/var/lib/extensions/graphics_{version}.raw"
+    console.command("systemd-sysext unmerge")
+    console.command(f"cp {graphics} {graphics}.backup")
+    console.command(f"printf X | dd of={graphics} bs=1 seek=1048576 conv=notrunc 2>/dev/null")
+    console.command(f"systemd-sysext --image-policy={policy} refresh", 120)
+    console.command("device=$(lsblk -ln -o NAME,TYPE | awk '$1 ~ /-verity$/ && $2 == \"crypt\" {print $1; exit}'); if dd if=/dev/$device of=/dev/null bs=1M status=none; then false; else true; fi", 120)
+    console.command(f"mv {graphics}.backup {graphics}")
+    console.command(f"systemd-sysext --image-policy={policy} refresh", 120)
+    if include_confext:
+        debug = f"debug_{version}.raw"
+        console.command("systemd-confext unmerge")
+        console.command("mkdir -p /etc/confexts")
+        console.command(f"cp /usr/lib/confexts/{debug} /etc/confexts/{debug}")
+        console.command(f"printf X | dd of=/etc/confexts/{debug} bs=1 seek=4096 conv=notrunc 2>/dev/null")
+        console.command(f"systemd-confext --image-policy={policy} refresh", 120)
+        console.command("device=$(lsblk -ln -o NAME,TYPE | awk '$1 ~ /-verity$/ && $2 == \"crypt\" {print $1; exit}'); if dd if=/dev/$device of=/dev/null bs=1M status=none; then false; else true; fi", 120)
+        console.command("systemd-confext unmerge")
+        console.command(f"rm -f /etc/confexts/{debug}")
+        console.command(f"systemd-confext --image-policy={policy} refresh", 120)
+
+
+def main():
+    output = Path(sys.argv[1]).resolve()
+    console = Console(output, "hardening.log")
+    try:
+        login(console)
+        console.command("systemctl is-active --quiet --wait graphical.target weston.service")
+        console.command("bootctl set-default 'rva23-debug_*.efi'")
+        console.sendline("reboot")
+        login(console)
+        console.command("systemctl is-active --quiet --wait graphical.target weston.service")
+        console.command("test \"$(cat /sys/kernel/security/ipe/enforce)\" = 0")
+        extension_checks(console, os_version(console), include_confext=True)
+        console.command("cp /usr/bin/true /var/tmp/true && chmod 0755 /var/tmp/true")
+        console.command("/var/tmp/true")
+        console.command("journalctl -k -b --no-pager | grep -E 'type=1420|IPE' | grep -q 'enforcing=0'")
