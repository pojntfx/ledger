+        stream.seek(-1, 1)
+        stream.write(bytes([current[0] ^ 1]))
+    expect_boot_failure(output, disk, "bad-usr-boot", rb"verity|failed to mount|unable to mount|input/output error")
+    print("PASS: modified /usr data fails before login")
+    bad_uki.unlink(missing_ok=True)
+    (output / "bad-uki.img").unlink(missing_ok=True)
