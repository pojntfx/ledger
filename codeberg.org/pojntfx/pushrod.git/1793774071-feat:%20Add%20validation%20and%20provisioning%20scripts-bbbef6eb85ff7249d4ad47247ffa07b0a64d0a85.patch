diff --git a/buildroot/qemu/scripts/build-extensions.py b/buildroot/qemu/scripts/build-extensions.py
new file mode 100755
index 0000000000000000000000000000000000000000..afbcddba01522559ef96a0e728df289dc0b0f3f2
--- /dev/null
+++ b/buildroot/qemu/scripts/build-extensions.py
@@ -0,0 +1,218 @@
+#!/usr/bin/env python3
+import gzip
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tarfile
+
+
+def build_ddi(host, key_dir, kind, name, tree, output):
+    environment = os.environ.copy()
+    environment["PATH"] = f"{host / 'bin'}:{environment['PATH']}"
+    environment["SOURCE_DATE_EPOCH"] = "0"
+    output.unlink(missing_ok=True)
+    subprocess.run(
+        [
+            "/usr/bin/systemd-repart",
+            f"--make-ddi={kind}",
+            "--architecture=riscv64",
+            "--seed=00000000-0000-0000-0000-000000000000",
+            "--copy-source", str(tree),
+            "--private-key", str(key_dir / "verity.key"),
+            "--certificate", str(key_dir / "verity.crt"),
+            str(output),
+        ],
+        check=True,
+        env=environment,
+    )
+
+
+def release(tree, kind, name, version):
+    if kind == "sysext":
+        directory = tree / "usr/lib/extension-release.d"
+    else:
+        directory = tree / "etc/extension-release.d"
+    directory.mkdir(parents=True, exist_ok=True)
+    (directory / f"extension-release.{name}").write_text(f"ID=buildroot\nVERSION_ID={version}\nIMAGE_ID=rva23\nIMAGE_VERSION={version}\n")
+
+
+def move_path(source, destination):
+    if not source.exists() and not source.is_symlink():
+        return
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    shutil.move(str(source), str(destination))
+
+
+def move_contents(source, destination):
+    if not source.exists():
+        return
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copytree(source, destination, symlinks=True, dirs_exist_ok=True)
+    shutil.rmtree(source)
+
+
+def copy_dependencies(host, usr, podman):
+    readelf = host / "bin/riscv64-linux-readelf"
+    queue = [path for path in podman.rglob("*") if path.is_file() and not path.is_symlink()]
+    copied = set()
+    excluded = {"libc.so.6", "libm.so.6", "libresolv.so.2", "libsystemd.so.0", "libgcc_s.so.1", "libpthread.so.0", "libdl.so.2"}
+    while queue:
+        path = queue.pop()
+        result = subprocess.run([readelf, "-d", path], capture_output=True, text=True)
+        if result.returncode != 0:
+            continue
+        for name in re.findall(r"Shared library: \[(.*?)\]", result.stdout):
+            if name in copied or name in excluded:
+                continue
+            for directory in (usr / "lib", usr / "lib64"):
+                source = directory / name
+                if source.exists():
+                    destination = podman / "usr/lib" / name
+                    destination.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(source, destination)
+                    copied.add(name)
+                    queue.append(destination)
+                    break
+
+
+def make_oci_image(host, usr, staging, destination):
+    root = staging / "rootfs"
+    (root / "bin").mkdir(parents=True)
+    source = staging / "test.c"
+    source.write_text('#include <stdio.h>\nint main(void) { puts("podman-works"); return 0; }\n')
+    subprocess.run([host / "bin/riscv64-linux-gcc", "-static", "-O2", "-o", root / "bin/test", source], check=True)
+    uncompressed_layer = staging / "layer.tar"
+    with tarfile.open(uncompressed_layer, "w", dereference=True) as archive:
+        seen = set()
+        for path in sorted(root.rglob("*")):
+            name = str(path.relative_to(root))
+            if name in seen:
+                continue
+            seen.add(name)
+            archive.add(path, arcname=name, recursive=False)
+    diff_id = hashlib.sha256(uncompressed_layer.read_bytes()).hexdigest()
+    layer = staging / "layer.tar.gz"
+    with gzip.open(layer, "wb") as stream:
+        stream.write(uncompressed_layer.read_bytes())
+    blobs = staging / "oci/blobs/sha256"
+    blobs.mkdir(parents=True)
+
+    def add_blob(data):
+        digest = hashlib.sha256(data).hexdigest()
+        (blobs / digest).write_bytes(data)
+        return digest, len(data)
+
+    config = json.dumps({
+        "architecture": "riscv64",
+        "os": "linux",
+        "config": {"Cmd": ["/bin/test"], "WorkingDir": "/"},
+        "rootfs": {"type": "layers", "diff_ids": [f"sha256:{diff_id}"]},
+    }, separators=(",", ":")).encode()
+    config_digest, config_size = add_blob(config)
+    layer_digest, layer_size = add_blob(layer.read_bytes())
+    manifest = json.dumps({
+        "schemaVersion": 2,
+        "mediaType": "application/vnd.oci.image.manifest.v1+json",
+        "config": {
+            "mediaType": "application/vnd.oci.image.config.v1+json",
+            "digest": f"sha256:{config_digest}",
+            "size": config_size,
+        },
+        "layers": [{
+            "mediaType": "application/vnd.oci.image.layer.v1.tar+gzip",
+            "digest": f"sha256:{layer_digest}",
+            "size": layer_size,
+        }],
+    }, separators=(",", ":")).encode()
+    manifest_digest, manifest_size = add_blob(manifest)
+    index = json.dumps({
+        "schemaVersion": 2,
+        "manifests": [{
+            "mediaType": "application/vnd.oci.image.manifest.v1+json",
+            "digest": f"sha256:{manifest_digest}",
+            "size": manifest_size,
+            "annotations": {"org.opencontainers.image.ref.name": "localhost/rva23-podman-test:latest"},
+        }],
+    }, separators=(",", ":")).encode()
+    (staging / "oci/index.json").write_bytes(index)
+    (staging / "oci/oci-layout").write_text('{"imageLayoutVersion":"1.0.0"}\n')
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    with tarfile.open(destination, "w") as archive:
+        archive.add(staging / "oci", arcname=".")
+
+
+def main(host, key_dir, binaries, usr):
+    version = os.environ.get("RVA23_VERSION", "1")
+    graphics = binaries / "extension-staging/graphics"
+    if graphics.parent.exists():
+        shutil.rmtree(graphics.parent)
+    (graphics / "usr/bin").mkdir(parents=True)
+    for source in sorted((usr / "bin").glob("weston-*")):
+        shutil.move(str(source), graphics / "usr/bin" / source.name)
+    shutil.move(str(usr / "bin/wayland-info"), graphics / "usr/bin/wayland-info")
+    release(graphics, "sysext", f"graphics_{version}", version)
+    graphics_image = binaries / f"graphics_{version}.raw"
+    build_ddi(host, key_dir, "sysext", f"graphics_{version}", graphics, graphics_image)
+    graphics_destination = usr / f"share/factory/var/lib/extensions/graphics_{version}.raw"
+    graphics_destination.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copyfile(graphics_image, graphics_destination)
+    debug = binaries / "extension-staging/debug"
+    (debug / "etc/systemd/journald.conf.d").mkdir(parents=True)
+    (debug / "etc/systemd/journald.conf.d/10-debug.conf").write_text("[Journal]\nMaxLevelStore=debug\n")
+    release(debug, "confext", f"debug_{version}", version)
+    debug_image = binaries / f"debug_{version}.raw"
+    build_ddi(host, key_dir, "confext", f"debug_{version}", debug, debug_image)
+    debug_destination = usr / f"lib/confexts/debug_{version}.raw"
+    debug_destination.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copyfile(debug_image, debug_destination)
+    target = Path(os.environ["TARGET_DIR"])
+    podman = binaries / "extension-staging/podman"
+    for relative in (
+        "usr/bin/podman",
+        "usr/bin/conmon",
+        "usr/bin/crun",
+        "usr/bin/runc",
+        "usr/bin/netavark",
+        "usr/bin/aardvark-dns",
+        "usr/bin/catatonit",
+        "usr/bin/slirp4netns",
+        "usr/bin/pasta",
+    ):
+        move_path(usr / relative.removeprefix("usr/"), podman / relative)
+    move_contents(usr / "libexec/podman", podman / "usr/libexec/podman")
+    move_contents(usr / "share/containers", podman / "usr/share/containers")
+    shutil.copytree(target / "etc/containers", podman / "usr/share/containers", dirs_exist_ok=True)
+    helpers = podman / "usr/libexec/podman"
+    helpers.mkdir(parents=True, exist_ok=True)
+    for name in ("aardvark-dns", "netavark", "catatonit", "slirp4netns"):
+        (helpers / name).unlink(missing_ok=True)
+        (helpers / name).symlink_to(f"../../bin/{name}")
+    configuration = podman / "usr/share/containers/containers.conf.d"
+    configuration.mkdir(parents=True, exist_ok=True)
+    (configuration / "50-rva23.conf").write_text('[containers]\ninit_path = "/usr/libexec/podman/catatonit"\n[network]\ndefault_rootless_network_cmd = "slirp4netns"\n')
+    copy_dependencies(host, usr, podman)
+    make_oci_image(host, usr, binaries / "extension-staging/oci", podman / "usr/share/rva23/podman-test-image.tar")
+    release(podman, "sysext", f"podman_{version}", version)
+    podman_image = binaries / f"podman_{version}.raw"
+    build_ddi(host, key_dir, "sysext", f"podman_{version}", podman, podman_image)
+    podman_destination = usr / f"share/factory/var/lib/extensions/podman_{version}.raw"
+    podman_destination.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copyfile(podman_image, podman_destination)
+    k3s = binaries / "extension-staging/k3s"
+    for name in ("k3s", "kubectl", "crictl", "ctr", "containerd", "runc", "cni", "check-config"):
+        move_path(usr / "bin" / name, k3s / "usr/bin" / name)
+    copy_dependencies(host, usr, k3s)
+    release(k3s, "sysext", f"k3s_{version}", version)
+    k3s_image = binaries / f"k3s_{version}.raw"
+    build_ddi(host, key_dir, "sysext", f"k3s_{version}", k3s, k3s_image)
+    k3s_destination = usr / f"share/factory/var/lib/extensions/k3s_{version}.raw"
+    k3s_destination.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copyfile(k3s_image, k3s_destination)
+
+
+if __name__ == "__main__":
+    main(Path(os.environ["HOST_DIR"]), Path(os.environ["RVA23_KEY_DIR"]), Path(os.environ["BINARIES_DIR"]), Path(os.environ["BINARIES_DIR"]) / "image-staging/usr")
diff --git a/buildroot/qemu/scripts/build-os-images.py b/buildroot/qemu/scripts/build-os-images.py
new file mode 100755
index 0000000000000000000000000000000000000000..9f524af9b2b225e7851112bc327d27ef12be11c1
--- /dev/null
+++ b/buildroot/qemu/scripts/build-os-images.py
@@ -0,0 +1,189 @@
+#!/usr/bin/env python3
+import base64
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+
+
+def run(*args):
+    subprocess.run([str(arg) for arg in args], check=True)
+
+
+def ensure_key(key_dir, name):
+    key = key_dir / f"{name}.key"
+    cert = key_dir / f"{name}.crt"
+    if not key.exists():
+        run("openssl", "genpkey", "-algorithm", "RSA", "-out", key, "-pkeyopt", "rsa_keygen_bits:3072", "-pkeyopt", "rsa_keygen_pubexp:65537")
+        key.chmod(0o600)
+    if not cert.exists():
+        run("openssl", "req", "-batch", "-new", "-x509", "-sha256", "-days", "3650", "-subj", f"/CN=RVA23 development {name}/", "-key", key, "-out", cert)
+    return key, cert
+
+
+def sign_verity(key_dir, root_hash_file, output):
+    key, cert = ensure_key(key_dir, "verity")
+    result = subprocess.run(
+        ["openssl", "cms", "-sign", "-noattr", "-signer", str(cert), "-inkey", str(key), "-binary", "-in", str(root_hash_file), "-outform", "PEM"],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    signature = "".join(line for line in result.stdout.splitlines() if not line.startswith("-----"))
+    der = subprocess.run(["openssl", "x509", "-in", str(cert), "-outform", "DER"], check=True, capture_output=True).stdout
+    document = {
+        "rootHash": root_hash_file.read_text().strip(),
+        "certificateFingerprint": hashlib.sha256(der).hexdigest(),
+        "signature": signature,
+    }
+    payload = json.dumps(document, separators=(",", ":")).encode()
+    padded = (len(payload) + 4095) // 4096 * 4096
+    output.write_bytes(payload.ljust(padded, b"\0"))
+    output.with_suffix(".sig-size").write_text(f"{padded}\n")
+    return cert
+
+
+def sign_pe(host, key_dir, path):
+    key, cert = ensure_key(key_dir, "secure-boot")
+    temporary = path.with_suffix(path.suffix + ".signed")
+    run(host / "bin/sbsign", "--key", key, "--cert", cert, "--output", temporary, path)
+    temporary.replace(path)
+
+
+def build_uki(host, images, usr, stub, name, cmdline, key_dir):
+    output = images / "efi-part/EFI/Linux" / name
+    (images / f"{name}.cmdline").write_text(cmdline + "\n")
+    base = images / "efi-part/EFI/Linux" / f".{name}.base"
+    result = subprocess.run(
+        [
+            str(host / "bin/python3"),
+            str(host / "bin/ukify"),
+            "build",
+            "--linux", str(images / "Image"),
+            "--initrd", str(images / "rootfs.cpio.gz"),
+            "--stub", str(stub),
+            "--efi-arch", "riscv64",
+            "--uname", "7.3.1",
+            "--cmdline", cmdline,
+            "--os-release", f"@{usr / 'lib/os-release'}",
+            "--pcr-public-key", str(key_dir / "pcr-public.pem"),
+            "--pcr-banks", "sha256",
+            "--policy-digest",
+            "--json=short",
+            "--output", str(base),
+        ],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    policies = json.loads(result.stdout)
+    for bank, entries in policies.items():
+        for entry in entries:
+            digest = base64.b16decode(entry["pol"].upper())
+            signature = subprocess.run(
+                ["openssl", "dgst", f"-{bank}", "-sign", str(key_dir / "pcr.key")],
+                input=digest,
+                check=True,
+                capture_output=True,
+            ).stdout
+            entry["sig"] = base64.b64encode(signature).decode()
+    policy_file = images / f"{name}.pcrs.json"
+    policy_file.write_text(json.dumps(policies))
+    run(host / "bin/python3", host / "bin/ukify", "build", "--join-pcrsig", base, "--pcrsig", f"@{policy_file}", "--json=short", "--output", output)
+    base.unlink()
+
+
+def build_attested_client(host, binaries, usr):
+    environment = os.environ.copy()
+    environment.update({"GOOS": "linux", "GOARCH": "riscv64", "CGO_ENABLED": "0", "GOTOOLCHAIN": "local"})
+    output = binaries / "attested-client"
+    subprocess.run([host / "bin/go", "build", "-o", output, Path(__file__).with_name("attested-client.go")], check=True, env=environment)
+    (usr / "bin").mkdir(exist_ok=True)
+    shutil.copy2(output, usr / "bin/attested-client")
+    wallet_output = binaries / "wallet-client"
+    subprocess.run([host / "bin/go", "build", "-o", wallet_output, Path(__file__).with_name("wallet-client.go"), Path(__file__).with_name("u2f.go")], check=True, env=environment)
+    shutil.copy2(wallet_output, usr / "bin/wallet-client")
+
+
+def main():
+    binaries = Path(os.environ["BINARIES_DIR"]).resolve()
+    target = Path(os.environ["TARGET_DIR"]).resolve()
+    host = Path(os.environ["HOST_DIR"]).resolve()
+    key_dir = Path(os.environ["RVA23_KEY_DIR"]).resolve()
+    version = os.environ.get("RVA23_VERSION", "1")
+    key_dir.mkdir(parents=True, exist_ok=True)
+    run(Path(__file__).with_name("provision-keys.py"), key_dir)
+    pk_der = subprocess.run(["openssl", "x509", "-in", key_dir / "PK.crt", "-outform", "DER"], check=True, capture_output=True).stdout
+    oem = "4e32566d-8e9e-4f52-81d3-5bb9715f9727:" + base64.b64encode(pk_der).decode()
+    (binaries / "secure-boot-oem.txt").write_text(oem + "\n")
+    staging = binaries / "image-staging"
+    if staging.exists():
+        shutil.rmtree(staging)
+    usr = staging / "usr"
+    shutil.copytree(target / "usr", usr, symlinks=True)
+    os_release = usr / "lib/os-release"
+    retained = [line for line in os_release.read_text().splitlines() if line.split("=", 1)[0] not in {"IMAGE_VERSION", "VERSION_ID"}]
+    retained.extend([f'IMAGE_VERSION="{version}"', f'VERSION_ID="{version}"'])
+    os_release.write_text("\n".join(retained) + "\n")
+    _, verity_cert = ensure_key(key_dir, "verity")
+    cert_destination = usr / "share/rva23/verity.crt"
+    cert_destination.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copyfile(verity_cert, cert_destination)
+    verity_config = usr / "lib/verity.d/00-rva23.crt"
+    verity_config.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copyfile(verity_cert, verity_config)
+    import_ring = usr / "lib/systemd/import-pubring.pgp"
+    shutil.copyfile(key_dir / "update-public.pgp", import_ring)
+    run(Path(__file__).with_name("build-extensions.py"))
+    build_attested_client(host, binaries, usr)
+    artifact = "usr-a" if version == "1" else f"usr-{version}"
+    usr_image = binaries / f"{artifact}.erofs"
+    run(host / "bin/mkfs.erofs", "-zlz4hc,9", "-T", "0", "-U", "00000000-0000-0000-0000-000000000000", usr_image, usr)
+    with usr_image.open("r+b") as stream:
+        stream.truncate(512 * 1024 * 1024)
+    root_hash_file = binaries / f"{artifact}.roothash"
+    run(host / "sbin/veritysetup", "format", "--root-hash-file", root_hash_file, usr_image, binaries / f"{artifact}.verity")
+    with (binaries / f"{artifact}.verity").open("r+b") as stream:
+        stream.truncate(64 * 1024 * 1024)
+    sign_verity(key_dir, root_hash_file, binaries / f"{artifact}.verity-sig")
+    with (binaries / f"{artifact}.verity-sig").open("r+b") as stream:
+        stream.truncate(16 * 1024)
+    root_hash = root_hash_file.read_text().strip()
+    linux = binaries / "efi-part/EFI/Linux"
+    linux.mkdir(parents=True, exist_ok=True)
+    for old in linux.glob("*.efi"):
+        old.unlink()
+    base = f"console=ttyS0,115200 earlycon=sbi root=dissect mount.usr=dissect usrhash={root_hash} rw"
+    policy = "systemd.image_policy=usr=signed+read-only-on:root=unprotected+encrypted+absent+read-only-off:home=unprotected+encrypted+absent:swap=unprotected+encrypted+absent:esp=unprotected+unused:=unused+absent"
+    stub = target / "usr/lib/systemd/boot/efi/linuxriscv64.efi.stub"
+    fail_boot = " systemd.unit=emergency.target ipe.enforce=0" if os.environ.get("RVA23_FAIL_BOOT") == "1" else " ipe.enforce=1"
+    profiles = {
+        f"rva23_{version}+3-0.efi": f"{base} {policy}{fail_boot}",
+        f"rva23-recovery_{version}.efi": f"{base} {policy} systemd.unit=rescue.target ipe.enforce=0",
+        f"rva23-debug_{version}.efi": f"{base} {policy} rd.debug SYSTEMD_SULOGIN_FORCE=1 systemd.log_level=info systemd.log_target=console ipe.enforce=0",
+    }
+    if version == "1":
+        profiles.update({
+            "rva23-factory-reset.efi": "console=ttyS0,115200 earlycon=sbi root=off mount.usr=off systemd.factory_reset=yes rd.systemd.unit=rva23-factory-reset.service rd.debug SYSTEMD_SULOGIN_FORCE=1",
+            "rva23-emergency.efi": f"{base} {policy} systemd.unit=emergency.target ipe.enforce=0",
+        })
+    for name, cmdline in profiles.items():
+        build_uki(host, binaries, usr, stub, name, cmdline, key_dir)
+        sign_pe(host, key_dir, linux / name)
+    bootloader = binaries / "efi-part/EFI/BOOT/bootriscv64.efi"
+    if bootloader.exists():
+        sign_pe(host, key_dir, bootloader)
+    loader = binaries / "efi-part/loader"
+    loader.mkdir(parents=True, exist_ok=True)
+    sidecars = loader / "extensions"
+    sidecars.mkdir(exist_ok=True)
+    shutil.copyfile(binaries / f"podman_{version}.raw", sidecars / f"podman_{version}.raw")
+    shutil.copyfile(binaries / f"k3s_{version}.raw", sidecars / f"k3s_{version}.raw")
+    (loader / "loader.conf").write_text("default rva23_?.efi\ntimeout 0\neditor no\n")
+    (binaries / "rva23-version").write_text(f"{version}\n")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/buildroot/qemu/scripts/build-registry.py b/buildroot/qemu/scripts/build-registry.py
new file mode 100755
index 0000000000000000000000000000000000000000..a0cd5c8e58c44101c478fd94196c1b73f0136cf2
--- /dev/null
+++ b/buildroot/qemu/scripts/build-registry.py
@@ -0,0 +1,81 @@
+#!/usr/bin/env python3
+import hashlib
+import lzma
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+
+
+def uuid(hex_value):
+    return f"{hex_value[:8]}-{hex_value[8:12]}-{hex_value[12:16]}-{hex_value[16:20]}-{hex_value[20:32]}"
+
+
+def compress(source, destination):
+    with source.open("rb") as input_file, lzma.open(destination, "wb", preset=6) as output_file:
+        shutil.copyfileobj(input_file, output_file)
+
+
+def main():
+    output = Path(sys.argv[1]).resolve()
+    key_dir = Path(sys.argv[2]).resolve()
+    version = sys.argv[3] if len(sys.argv) > 3 else "2"
+    images = output / "images"
+    update = output / f"update-v{version}"
+    if update.exists():
+        shutil.rmtree(update)
+    update.mkdir(parents=True)
+    for name in ("Image", "rootfs.cpio.gz"):
+        shutil.copyfile(images / name, update / name)
