+    bad_uki.write_bytes(original_data[:1024] + bytes([original_data[1024] ^ 1]) + original_data[1025:])
+    result = subprocess.run([images.parent / "host/bin/sbverify", "--cert", key_dir / "secure-boot.crt", bad_uki], capture_output=True)
+    assert result.returncode != 0
+    disk = output / "bad-uki.img"
+    copy_disk(images / "disk.img", disk)
+    subprocess.run([images.parent / "host/bin/mcopy", "-o", "-i", f"{disk}@@{esp_offset}", bad_uki, "::/EFI/Linux/rva23_1.efi"], check=True)
+    expect_boot_failure(output, disk, "bad-uki-boot", rb"security violation|access denied|failed to load|startimage failed")
+    print("PASS: a modified UKI fails signature verification and Secure Boot")
+    disk = output / "bad-usr.img"
+    copy_disk(images / "disk.img", disk)
+    with disk.open("r+b") as stream:
+        stream.seek(int(parts["rva23_1"]["start"]) * 512 + 1024)
