+#!/usr/bin/env python3
+import base64
+from datetime import datetime, timedelta, timezone
+import json
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+from cryptography import x509
+from cryptography.hazmat.primitives import hashes
+from cryptography.hazmat.primitives.serialization import load_pem_public_key
+from cryptography.x509.oid import NameOID
+
+from verify_boot import Console
+
+
+def der_length(length):
+    if length < 128:
+        return bytes([length])
+    encoded = length.to_bytes((length.bit_length() + 7) // 8, "big")
+    return bytes([128 | len(encoded)]) + encoded
+
+
+def der_sequence(*parts):
+    payload = b"".join(parts)
+    return b"\x30" + der_length(len(payload)) + payload
+
+
+def guest_base64(console, path):
+    output = console.capture(f"base64 -w 0 {path}")
+    encoded = "".join(line.strip() for line in output.splitlines() if re.fullmatch(r"[A-Za-z0-9+/=]+", line.strip()))
+    return base64.b64decode(encoded)
+
+
+def provision_ek(console):
+    key_dir = "/var/lib/systemd/report.sign.tpm2"
+    console.command(f"mkdir -p {key_dir}")
+    console.command(f"tpm2_createek -c {key_dir}/ek.ctx -G rsa -u {key_dir}/ek.pub")
+    console.command(f"tpm2_readpublic -c {key_dir}/ek.ctx -f pem -o {key_dir}/ek.pem")
+    public_key = load_pem_public_key(guest_base64(console, f"{key_dir}/ek.pem"))
+    name = x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, "RVA23 EK")])
+    now = datetime.now(timezone.utc)
+    builder = (
+        x509.CertificateBuilder()
+        .subject_name(name)
+        .issuer_name(name)
+        .public_key(public_key)
+        .serial_number(1)
+        .not_valid_before(now - timedelta(days=1))
+        .not_valid_after(now + timedelta(days=3650))
+        .add_extension(x509.BasicConstraints(ca=False, path_length=None), critical=True)
+    )
+    tbs_certificate = builder.create_unsigned().tbs_certificate_bytes
+    console.command(f"echo {base64.b64encode(tbs_certificate).decode()} | base64 -d > /tmp/rva23-ek-tbs.der")
+    console.command("tpm2_hash -C o -g sha256 -o /tmp/rva23-ek-tbs.digest -t /tmp/rva23-ek-tbs.ticket /tmp/rva23-ek-tbs.der")
+    console.command(f"tpm2_createak -C {key_dir}/ek.ctx -G rsa -g sha256 -s rsassa -c {key_dir}/ak.ctx -u {key_dir}/ak.pub -r {key_dir}/ak.priv")
+    console.command(f"tpm2_sign -c {key_dir}/ak.ctx -g sha256 -d /tmp/rva23-ek-tbs.digest -t /tmp/rva23-ek-tbs.ticket -o /tmp/rva23-ek-tbs.sig")
+    signature = guest_base64(console, "/tmp/rva23-ek-tbs.sig")[-256:]
+    algorithm = der_sequence(b"\x06\x09\x2a\x86\x48\x86\xf7\x0d\x01\x01\x0b", b"\x05\x00")
+    certificate = der_sequence(tbs_certificate, algorithm, b"\x03" + der_length(len(signature) + 1) + b"\x00" + signature)
+    x509.load_der_x509_certificate(certificate)
+    console.command(f"echo {base64.b64encode(certificate).decode()} | base64 -d > /tmp/rva23-ek.crt")
+    console.command("tpm2_nvundefine 0x1c00012 -C p || true")
+    console.command("tpm2_changeauth -C p -P '' -p ''")
+    console.command("tpm2_nvdefine 0x1c00012 -C p -s 1024 -a 'authread|ppwrite|platformcreate' || true")
+    console.command("tpm2_nvsetbits 0x1c00012 -C p -a no_da")
+    console.command("tpm2_nvwrite 0x1c00012 -C p -i /tmp/rva23-ek.crt")
+    console.command("tpm2_nvundefine 0x1c00002 -C p || true")
+    console.command("tpm2_nvdefine 0x1c00002 -C p -s 1024 -a 'authread|ppwrite|platformcreate' || true")
+    console.command("tpm2_nvsetbits 0x1c00002 -C p -a no_da")
+    console.command("tpm2_nvwrite 0x1c00002 -C p -i /tmp/rva23-ek.crt")
+    console.command(f"rm -f {key_dir}/default.key")
+
+
+def main():
+    output = Path(sys.argv[1]).resolve()
+    receiver_dir = output / "host-attestation"
+    receiver_dir.mkdir(exist_ok=True)
+    subprocess.run(["go", "build", "-o", receiver_dir / "report-receiver", "scripts/report-receiver.go"], check=True)
+    receiver = subprocess.Popen(
+        [receiver_dir / "report-receiver"],
+        stdout=(receiver_dir / "receiver.log").open("w"),
+        stderr=subprocess.STDOUT,
+    )
+    console = Console(output, "report-upload.log", firmware=True)
+    try:
+        console.expect(b"rva23 login:", 300)
+        console.sendline("root")
+        console.expect(b"# ", 30)
+        console.command("systemctl is-active --quiet --wait graphical.target")
+        console.command("mkdir -p /var/lib/rva23-attestation")
+        console.command("mountpoint -q /sys/kernel/security || mount -t securityfs securityfs /sys/kernel/security")
+        console.command("systemctl start systemd-pcrlock.socket")
+        console.command("ip link set dev $(ip -o link show | awk -F': ' '$2 != \"lo\" {print $2; exit}') up")
+        console.command("ip addr replace 10.0.2.15/24 dev $(ip -o link show | awk -F': ' '$2 != \"lo\" {print $2; exit}')")
+        console.command("ip route replace default via 10.0.2.2")
+        console.command("ping -c 1 10.0.2.2")
+        console.command("systemctl start systemd-report-sign-tpm2.socket")
+        console.command("/usr/lib/systemd/systemd-report upload --url=http://10.0.2.2:8080/reports --sign=require-one", 300)
+        console.sendline("poweroff")
+        console.process.wait(timeout=90)
+    finally:
+        console.close()
+        receiver.terminate()
+        receiver.wait(timeout=15)
+    response = json.loads((receiver_dir / "response.json").read_text())
+    assert response["status"] == "accepted", response
+    assert response["componentsVerified"] > 0, response
+    assert response["eventLogRecords"] > 0, response
+    signature = json.loads((receiver_dir / "signature.json").read_text())
+    assert any(record.get("pcr") == 13 and record.get("content_type") == "pcclient_std" and "Global system extension initrd" in bytes.fromhex(record["content"].get("event_data", "")).decode("utf-16le") for record in signature["data"]["eventLog"]), "Podman sysext is absent from the attested event log"
+    print(f"PASS: Go receiver accepted {response['componentsVerified']} TPM signatures and {response['eventLogRecords']} event-log records")
+    print("PASS: the attested event log includes the Podman sysext")
+
+
+if __name__ == "__main__":
+    main()
