@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+from pathlib import Path
+import shutil
+import sys
+
+
+def copy_factory(target, name):
+    source = target / name
+    destination = target / "usr/share/factory" / name
+    if destination.exists() or destination.is_symlink():
+        if destination.is_dir() and not destination.is_symlink():
+            shutil.rmtree(destination)
+        else:
+            destination.unlink()
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copytree(source, destination, symlinks=True)
+
+
+def ensure_factory_accounts(target):
+    accounts = [
+        (100, "dbus", "/run/dbus"),
+        (101, "systemd-network", "/var/lib/systemd/network"),
+        (102, "systemd-resolve", "/var/lib/systemd/resolve"),
+        (103, "systemd-timesync", "/var/lib/systemd/timesync"),
+        (104, "tss", "/var/lib/tss"),
+    ]
+    passwd = target / "usr/share/factory/etc/passwd"
+    group = target / "usr/share/factory/etc/group"
+    passwd_lines = passwd.read_text().splitlines()
+    group_lines = group.read_text().splitlines()
+    for uid, name, home in accounts:
+        if not any(line.startswith(f"{name}:") for line in passwd_lines):
+            passwd_lines.append(f"{name}:x:{uid}:{uid}:{name}:{home}:/usr/bin/false")
+        if not any(line.startswith(f"{name}:") for line in group_lines):
+            group_lines.append(f"{name}:x:{uid}:")
+    passwd.write_text("\n".join(passwd_lines) + "\n")
+    group.write_text("\n".join(group_lines) + "\n")
+
+
+def main():
+    target = Path(sys.argv[1]).resolve()
+    copy_factory(target, "etc")
+    copy_factory(target, "var")
+    ensure_factory_accounts(target)
+    lines = []
+    for name in ("etc", "var"):
+        for source in sorted((target / name).iterdir()):
+            if source.is_symlink():
+                continue
+            lines.append(f"C! /{name}/{source.name} - - - - /usr/share/factory/{name}/{source.name}")
+    (target / "usr/lib/tmpfiles.d/rva23-factory.conf").write_text("\n".join(lines) + "\n")
+    os_release = target / "usr/lib/os-release"
+    fields = {
+        "IMAGE_ID": "rva23",
+        "IMAGE_VERSION": "1",
+        "VERSION_ID": "1",
+    }
+    retained = [line for line in os_release.read_text().splitlines() if line.split("=", 1)[0] not in fields]
+    retained.extend(f'{key}="{value}"' for key, value in fields.items())
+    os_release.write_text("\n".join(retained) + "\n")
+
+
+if __name__ == "__main__":
+    main()
