@@ -0,0 +1,186 @@
+#!/usr/bin/env python3
+from contextlib import contextmanager
+import functools
+import hashlib
+import http.server
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import threading
+import time
+import urllib.request
+
+from verify_boot import Console
+
+
+class InterruptingHandler(http.server.SimpleHTTPRequestHandler):
+    def do_GET(self):
+        if self.path.startswith("/rva23_2_") and self.path.endswith(".usr.erofs.xz"):
+            data = (Path(self.directory) / self.path.lstrip("/")).read_bytes()
+            self.send_response(200)
+            self.send_header("Content-Length", str(len(data)))
+            self.end_headers()
+            self.wfile.write(data[: len(data) // 2])
+            self.wfile.flush()
+            self.close_connection = True
+            return
+        super().do_GET()
+
+    def log_message(self, format, *args):
+        pass
+
+
+@contextmanager
+def registry_server(path, interrupt=False):
+    handler = InterruptingHandler if interrupt else http.server.SimpleHTTPRequestHandler
+    server = http.server.ThreadingHTTPServer(("127.0.0.1", 8000), functools.partial(handler, directory=str(path)))
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    try:
+        deadline = time.monotonic() + 15
+        while True:
+            try:
+                urllib.request.urlopen("http://127.0.0.1:8000/SHA256SUMS", timeout=1).close()
+                break
+            except Exception:
+                if not thread.is_alive() or time.monotonic() > deadline:
+                    raise
+                time.sleep(0.1)
+        yield
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join(timeout=10)
+
+
+def clone(source, destination):
+    if destination.exists():
+        shutil.rmtree(destination)
+    shutil.copytree(source, destination)
+
+
+def make_offline_image(output, offline):
+    for component, directory in (("os", "sysupdate.d"), ("extensions", "sysupdate.extensions.d"), ("bootloader", "sysupdate.bootloader.d")):
+        for source in (output / "target/usr/lib" / directory).glob("*.transfer"):
+            text = source.read_text()
+            text = text.replace("Type=url-file", "Type=regular-file")
+            text = text.replace("Path=http://10.0.2.2:8000/", "Path=/")
+            text = text.replace("[Source]\n", "[Source]\nPathRelativeTo=explicit\n")
+            destination = offline / "definitions" / component / source.name
+            destination.parent.mkdir(parents=True, exist_ok=True)
+            destination.write_text(text)
+    image = output / "offline-registry.img"
+    payload = sum(path.stat().st_size for path in offline.rglob("*") if path.is_file())
+    size = max(512 * 1024 * 1024, ((payload + 128 * 1024 * 1024 - 1) // (64 * 1024 * 1024)) * (64 * 1024 * 1024))
+    subprocess.run(["truncate", "-s", str(size), image], check=True)
+    subprocess.run(["mkfs.ext2", "-F", "-d", offline, image], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    return image
+
+
+def update_failure(console, component=None):
+    option = f" --component={component}" if component else ""
+    console.command(f"if /usr/lib/systemd/systemd-sysupdate{option} update; then false; else true; fi", 300)
+    console.command("test ! -e /boot/EFI/Linux/rva23_2+3-0.efi")
+    console.command("if lsblk -ln -o PARTLABEL | grep -q rva23_2_verity; then false; else true; fi")
+
+
+def main():
+    output = Path(sys.argv[1]).resolve()
+    key_dir = Path(sys.argv[2]).resolve()
+    registry = output / "registry"
+    registry_v2 = output / "registry-v2"
+    clone(registry, registry_v2)
+    bad = output / "registry-bad"
+    clone(registry_v2, bad)
+    with (bad / "SHA256SUMS.gpg").open("ab") as stream:
+        stream.write(b"bad")
+    interrupted = output / "registry-interrupted"
+    clone(registry_v2, interrupted)
+    offline = output / "offline-registry"
+    clone(registry_v2, offline)
+    subprocess.run(["gpg", "--batch", "--homedir", key_dir / "gnupg", "--verify", offline / "SHA256SUMS.gpg", offline / "SHA256SUMS"], check=True)
+    subprocess.run(["sha256sum", "-c", "SHA256SUMS"], cwd=offline, check=True, stdout=subprocess.DEVNULL)
+    os.environ["RVA23_UPDATE_IMAGE"] = str(make_offline_image(output, offline))
+    console = Console(output, "update.log")
+    try:
+        console.expect(b"rva23 login:", 300)
+        console.sendline("root")
+        console.expect(b"# ", 30)
+        console.command("systemctl is-active --quiet --wait graphical.target")
+        console.command("systemctl start systemd-networkd.service")
+        console.command("/usr/lib/systemd/systemd-networkd-wait-online --timeout=60", 90)
+        console.command("ping -c 1 -W 5 10.0.2.2")
+        with registry_server(bad):
+            update_failure(console)
+        print("PASS: a bad manifest signature stops installation")
+        with registry_server(interrupted, interrupt=True):
+            update_failure(console)
+        console.command("/usr/lib/systemd/systemd-sysupdate vacuum")
+        console.command("udevadm settle")
+        console.command("if lsblk -ln -o PARTLABEL | grep -q rva23_2; then false; else true; fi")
+        print("PASS: an interrupted payload leaves no bootable installation and vacuum removes it")
+        console.command("printf persistent > /var/lib/rva23-update-persistent")
+        console.command("mkdir -p /mnt/offline")
+        console.command("mount -t ext2 -o ro /dev/vdb /mnt/offline")
+        console.command("gpgv --keyring /usr/lib/systemd/import-pubring.pgp /mnt/offline/SHA256SUMS.gpg /mnt/offline/SHA256SUMS")
+        console.command("ip link set dev enp0s1 down")
+        console.command("/usr/lib/systemd/systemd-sysupdate --definitions=/mnt/offline/definitions/os --transfer-source=/mnt/offline update", 600)
+        console.command("/usr/lib/systemd/systemd-sysupdate --definitions=/mnt/offline/definitions/extensions --transfer-source=/mnt/offline update", 600)
+        console.command("/usr/lib/systemd/systemd-sysupdate --definitions=/mnt/offline/definitions/bootloader --transfer-source=/mnt/offline update", 600)
+        expected_bootloader = hashlib.sha256((offline / "systemd-boot_2.efi").read_bytes()).hexdigest()
+        console.command("install -m 0644 /var/lib/sysupdate/bootloader/systemd-boot_2.efi /boot/EFI/BOOT/bootriscv64.efi.new")
+        console.command("mv /boot/EFI/BOOT/bootriscv64.efi.new /boot/EFI/BOOT/bootriscv64.efi")
+        console.command("sync")
+        console.command(f"test \"$(sha256sum /boot/EFI/BOOT/bootriscv64.efi | cut -d ' ' -f 1)\" = {expected_bootloader}")
+        print("PASS: offline acquisition installs signed OS, extension, and bootloader components")
+        console.sendline("reboot")
+        console.expect(b"rva23 login:", 300)
+        console.sendline("root")
+        console.expect(b"# ", 30)
+        console.command("systemctl is-active --quiet --wait graphical.target weston.service")
+        console.command("grep -q 'IMAGE_VERSION=\"2\"' /usr/lib/os-release")
+        console.command("test \"$(cat /var/lib/rva23-update-persistent)\" = persistent")
+        console.command("find /boot/EFI/Linux -name 'rva23_1*.efi' | grep -q . && find /boot/EFI/Linux -name 'rva23_2*.efi' | grep -q .")
+        console.command("test -e /boot/EFI/Linux/rva23-recovery_2.efi")
+        console.command("XDG_RUNTIME_DIR=/run/weston WAYLAND_DISPLAY=wayland-1 wayland-info >/dev/null")
+        print("PASS: the A/B update boots version 2 with persistent state and two retained UKIs")
+        console.command("ip link set dev enp0s1 up")
+        console.command("/usr/lib/systemd/systemd-networkd-wait-online --timeout=60", 90)
+        environment = os.environ.copy()
+        environment["RVA23_FAIL_BOOT"] = "1"
+        subprocess.run([output.parent.parent / "scripts/build-registry.py", output, key_dir, "3"], check=True, env=environment)
+        with registry_server(registry):
+            console.command("/usr/lib/systemd/systemd-sysupdate update", 600)
+            console.command("/usr/lib/systemd/systemd-sysupdate --component=extensions update", 600)
+        for attempt in range(3):
+            console.sendline("reboot")
+            console.expect(b"(or press Control-D to continue):", 300)
+            console.sendline("")
+            console.expect(b"# ", 30)
+            console.command("systemctl is-active --quiet emergency.target")
+            print(f"PASS: failed boot attempt {attempt + 1} consumes one boot counter")
+        console.sendline("reboot")
+        console.expect(b"rva23 login:", 300)
+        console.sendline("root")
+        console.expect(b"# ", 30)
+        console.command("systemctl is-active --quiet --wait graphical.target weston.service")
+        console.command("grep -q 'IMAGE_VERSION=\"2\"' /usr/lib/os-release")
+        print("PASS: three failed boots return to the previous slot")
+        console.command("bootctl set-default rva23-recovery_2.efi")
+        console.sendline("reboot")
+        console.expect(b"(or press Control-D to continue):", 300)
+        console.sendline("")
+        console.expect(b"# ", 30)
+        console.command("systemctl is-active --quiet rescue.target")
+        print("PASS: recovery remains available after updates and rollback")
+        console.command("bootctl set-default 'rva23_?.efi'")
+        console.sendline("poweroff")
+        console.process.wait(timeout=90)
+    finally:
+        console.close()
+
+
+if __name__ == "__main__":
+    main()
