index 0000000000000000000000000000000000000000..a8e3be06fdfaf0b2a4fa5de00d287372eca62ec9
--- /dev/null
+++ b/buildroot/qemu/scripts/verify-boot.py
@@ -0,0 +1,154 @@
+#!/usr/bin/env python3
+import os
+from pathlib import Path
+import re
+import select
+import subprocess
+import sys
+import time
+
+
+class Console:
+    def __init__(self, output, log_name="boot.log", firmware=False):
+        self.output = output
+        self.log = (output / log_name).open("wb")
+        self.buffer = b""
+        self.last_consumed = b""
+        self.command_id = 0
+        script_name = "run-firmware.sh" if firmware else "run-qemu.sh"
+        script = output.parent.parent / "board/rva23-qemu" / script_name
+        self.process = subprocess.Popen(
+            [script, output / "images"],
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            bufsize=0,
+        )
+
+    def expect(self, pattern, timeout):
+        if isinstance(pattern, bytes):
+            pattern = re.compile(re.escape(pattern))
+        deadline = time.monotonic() + timeout
+        while True:
+            match = pattern.search(self.buffer)
+            if match:
+                self.last_consumed = self.buffer[:match.end()]
+                self.buffer = self.buffer[match.end():]
+                return match
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                tail = self.buffer[-12000:].decode(errors="replace")
+                raise TimeoutError(f"QEMU console timeout\n{tail}")
+            ready, _, _ = select.select([self.process.stdout], [], [], remaining)
+            if not ready:
+                continue
+            data = os.read(self.process.stdout.fileno(), 65536)
+            if not data:
+                tail = self.buffer[-12000:].decode(errors="replace")
+                raise RuntimeError(f"QEMU exited with {self.process.poll()}\n{tail}")
+            self.log.write(data)
+            self.log.flush()
+            self.buffer += data
+
+    def sendline(self, line):
+        self.process.stdin.write(line.encode() + b"\n")
+        self.process.stdin.flush()
+
+    def command(self, command, timeout=60):
+        self.command_id += 1
+        token = f"__RVA23_RC_{self.command_id}__"
+        self.sendline(f"{command}; printf '\\n{token}:%s\\n' \"$?\"")
+        match = self.expect(re.compile(token.encode() + rb":(\d+)"), timeout)
+        status = int(match.group(1))
+        assert status == 0, f"Guest command failed with {status}: {command}"
+
+    def capture(self, command, timeout=60):
+        self.command_id += 1
+        token = f"__RVA23_RC_{self.command_id}__"
+        self.sendline(f"{command}; printf '\\n{token}:%s\\n' \"$?\"")
+        match = self.expect(re.compile(token.encode() + rb":(\d+)"), timeout)
+        status = int(match.group(1))
+        assert status == 0, f"Guest command failed with {status}: {command}"
+        return self.last_consumed[:match.start()].decode(errors="replace")
+
+    def close(self):
+        if self.process.poll() is None:
+            self.process.terminate()
+            try:
+                self.process.wait(timeout=10)
+            except subprocess.TimeoutExpired:
+                self.process.kill()
+                self.process.wait()
+        self.log.close()
+
+
+def main():
+    output = Path(sys.argv[1]).resolve()
+    console = Console(output)
+    try:
+        console.expect(b"rva23 login:", 300)
+        console.sendline("root")
+        console.expect(b"# ", 30)
+        console.command("systemctl --no-pager --full status graphical.target weston.service || true")
+        console.command("journalctl -b --no-pager -u weston.service || true")
+        console.command("ls -la /run/weston")
+        checks = [
+            ("systemctl is-active --quiet --wait graphical.target", "systemd reaches graphical.target"),
+            ("systemctl is-active --quiet --wait weston.service", "systemd starts Weston"),
+            ("test -S /run/weston/wayland-1", "Weston creates its Wayland socket"),
+            ("XDG_RUNTIME_DIR=/run/weston WAYLAND_DISPLAY=wayland-1 wayland-info >/dev/null", "a Wayland client connects to Weston"),
+            ("test -e /dev/dri/card0", "the guest exposes a DRM device"),
+            ("test -d /sys/module/virtio_gpu", "the DRM device uses virtio graphics"),
+            ("grep -q 'root=dissect' /proc/cmdline", "the UKI selects discoverable root storage"),
+            ("grep -q 'mount.usr=dissect' /proc/cmdline", "the UKI selects discoverable /usr storage"),
+            ("findmnt -ln -o FSTYPE | grep -q '^erofs$'", "the storage chain mounts EROFS"),
+            ("findmnt -n -o OPTIONS /usr | grep -Eq '(^|,)ro(,|$)'", "/usr stays read-only"),
+            ("touch /etc/rva23-write-test /var/lib/rva23-write-test && rm /etc/rva23-write-test /var/lib/rva23-write-test", "/etc and /var stay writable"),
+            ("test -f /usr/share/factory/etc/passwd", "factory configuration lives below /usr/share/factory"),
+            ("id rva23-state >/dev/null", "sysusers instantiates the service identity"),
+            ("test \"$(lsblk -ln -o PARTLABEL | grep -c _empty)\" -eq 3", "first boot creates three empty B slots"),
+            ("test -b /dev/disk/by-designator/root && test -b /dev/disk/by-designator/home", "first boot creates root and home"),
+            ("swapon --show | grep -q '/dev/'", "first boot activates swap"),
+            ("test -c /dev/tpmrm0", "QEMU exposes the persistent TPM"),
+            ("dmsetup table root | grep -q crypt", "root uses a LUKS2 mapping"),
+            ("dmsetup table home | grep -q crypt", "home uses a LUKS2 mapping"),
+            ("dmsetup table swap | grep -q crypt", "swap uses a LUKS2 mapping"),
+            ("cryptsetup luksDump /dev/vda8 | grep -q tpm2", "root has a TPM2 token"),
+            ("cryptsetup luksDump /dev/vda9 | grep -q tpm2", "home has a TPM2 token"),
+            ("cryptsetup luksDump /dev/vda10 | grep -q tpm2", "swap has a TPM2 token"),
+        ]
+        for command, description in checks:
+            console.command(command)
+            print(f"PASS: {description}")
+        console.command("printf persistent > /var/lib/rva23-persistent")
+        console.sendline("reboot")
+        console.expect(b"rva23 login:", 300)
+        console.sendline("root")
+        console.expect(b"# ", 30)
+        console.command("test \"$(cat /var/lib/rva23-persistent)\" = persistent")
+        print("PASS: local storage survives reboot")
+        console.command("bootctl set-default rva23-recovery_1.efi")
+        console.sendline("reboot")
+        console.expect(b"(or press Control-D to continue):", 300)
+        console.sendline("")
+        console.expect(b"# ", 30)
+        console.command("systemctl is-active --quiet rescue.target")
+        console.command("findmnt -n -o OPTIONS /usr | grep -Eq '(^|,)ro(,|$)'")
+        print("PASS: recovery boots with read-only /usr and writable local state")
+        console.command("bootctl set-default rva23-factory-reset.efi")
+        console.sendline("reboot")
+        console.expect(b"rva23 login:", 600)
+        console.sendline("root")
+        console.expect(b"# ", 30)
+        console.command("test ! -e /var/lib/rva23-persistent")
+        console.command("test \"$(lsblk -ln -o PARTLABEL | grep -c _empty)\" -eq 3")
+        print("PASS: factory reset recreates local state and preserves empty B slots")
+        console.sendline("poweroff")
+        console.process.wait(timeout=90)
+        print(f"PASS: QEMU shuts down cleanly; console log: {output / 'boot.log'}")
+    finally:
+        console.close()
+
+
+if __name__ == "__main__":
+    main()
