@@ -0,0 +1,77 @@
+#!/usr/bin/env python3
+import os
+from pathlib import Path
+import select
+import subprocess
+import sys
+import time
+
+
+def capture(output, fit, timeout):
+    log_path = output / ("firmware-boot.log" if fit.name == "firmware.itb" else "firmware-bad-boot.log")
+    process = subprocess.Popen(
+        [output.parent.parent / "board/rva23-qemu/run-firmware.sh", output / "images"],
+        env={**os.environ, "FIRMWARE_FIT": fit},
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        bufsize=0,
+    )
+    data = b""
+    deadline = time.monotonic() + timeout
+    try:
+        while time.monotonic() < deadline:
+            ready, _, _ = select.select([process.stdout], [], [], max(0, deadline - time.monotonic()))
+            if not ready:
+                break
+            chunk = os.read(process.stdout.fileno(), 65536)
+            if not chunk:
+                break
+            data += chunk
+            if b"RISC-V EDK2 firmware version 2.7" in data or b"Signature check Bad" in data:
+                break
+        log_path.write_bytes(data)
+        return data
+    finally:
+        process.terminate()
+        try:
+            process.wait(timeout=10)
+        except subprocess.TimeoutExpired:
+            process.kill()
+            process.wait()
+
+
+def main():
+    output = Path(sys.argv[1]).resolve()
+    images = output / "images"
+    fit = images / "firmware.itb"
+    key = images / "qemu-control.dtb"
+    checker = output / "host/bin/fit_check_sign"
+    for path in [images / "u-boot-spl.bin", images / "fw_dynamic.bin", fit, key]:
+        assert path.is_file() and path.stat().st_size > 0, path
+    print("PASS: SPL, OpenSBI, signed FIT, and signed QEMU control DTB exist")
+    subprocess.run([checker, "-f", fit, "-k", key, "-c", "conf"], check=True, capture_output=True)
+    print("PASS: the development key authenticates the firmware configuration")
+    bad = images / "firmware-bad.itb"
+    offset = int(subprocess.check_output(
+        [output / "host/bin/fdtget", "-t", "x", fit, "/images/edk2", "data-position"],
+        text=True,
+    ), 16)
+    content = bytearray(fit.read_bytes())
+    content[offset] ^= 1
+    bad.write_bytes(content)
+    result = subprocess.run([checker, "-f", bad, "-k", key, "-c", "conf"], capture_output=True)
+    assert result.returncode != 0, "the modified FIT passed host verification"
+    print("PASS: the modified FIT fails host verification")
+    log = capture(output, fit, 90)
+    assert b"OpenSBI v1.8" in log, log[-4000:]
+    assert b"RISC-V EDK2 firmware version 2.7" in log, log[-4000:]
+    assert b"U-Boot 202" not in log, log[-4000:]
+    print("PASS: SPL reaches EDK2 without U-Boot proper")
+    log = capture(output, bad, 45)
+    assert b"RISC-V EDK2 firmware version 2.7" not in log, log[-4000:]
+    assert b"signature" in log.lower() or b"verify" in log.lower(), log[-4000:]
+    print("PASS: SPL rejects the modified FIT before EDK2")
+
+
+if __name__ == "__main__":
+    main()
