@@ -0,0 +1,119 @@
+#!/usr/bin/env python3
+import json
+import os
+from pathlib import Path
+import re
+import select
+import subprocess
+import sys
+import time
+
+from verify_boot import Console
+
+
+def partitions(disk):
+    result = subprocess.run(["sfdisk", "--json", disk], check=True, capture_output=True, text=True)
+    return {entry.get("name"): entry for entry in json.loads(result.stdout)["partitiontable"]["partitions"]}
+
+
+def copy_disk(source, destination):
+    subprocess.run(["cp", "--reflink=auto", "--sparse=always", source, destination], check=True)
+
+
+def expect_boot_failure(output, disk, name, pattern):
+    environment = os.environ.copy()
+    environment["RVA23_DISK"] = str(disk)
+    environment["RVA23_TPM_STATE"] = str(output / f"swtpm-{name}")
+    log = (output / f"{name}.log").open("wb")
+    process = subprocess.Popen(
+        [output.parent.parent / "board/rva23-qemu/run-qemu.sh", output / "images"],
+        env=environment,
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        bufsize=0,
+    )
+    buffer = b""
+    deadline = time.monotonic() + 180
+    try:
+        expression = re.compile(pattern, re.IGNORECASE)
+        while time.monotonic() < deadline:
+            match = expression.search(buffer)
+            if match:
+                return
+            assert b"rva23 login:" not in buffer, buffer[-12000:].decode(errors="replace")
+            ready, _, _ = select.select([process.stdout], [], [], max(0, deadline - time.monotonic()))
+            if not ready:
+                continue
+            data = os.read(process.stdout.fileno(), 65536)
+            if not data:
+                break
+            log.write(data)
+            log.flush()
+            buffer += data
+        raise AssertionError(buffer[-12000:].decode(errors="replace"))
+    finally:
+        process.terminate()
+        try:
+            process.wait(timeout=10)
+        except subprocess.TimeoutExpired:
+            process.kill()
+            process.wait()
+        log.close()
+
+
+def main():
