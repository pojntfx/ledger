+++ b/buildroot/qemu/scripts/verify-wallet.py
@@ -0,0 +1,152 @@
+#!/usr/bin/env python3
+import base64
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import secrets
+import struct
+import subprocess
+import sys
+
+from verify_boot import Console
+
+
+def login(console):
+    console.expect(b"rva23 login:", 300)
+    console.sendline("root")
+    console.expect(b"# ", 30)
+    console.command("systemctl is-active --quiet --wait graphical.target")
+    console.command("systemctl start systemd-pcrlock.socket")
+    console.command("systemctl restart systemd-report-sign-tpm2.socket")
+    console.command("sleep 2")
+
+
+def reboot_to(console, output, profile):
+    console.command(f"bootctl set-default '{profile}'")
+    console.sendline("poweroff")
+    console.process.wait(timeout=90)
+    console.close()
+    return Console(output, "wallet.log", firmware=True)
+
+
+def create_key(directory, name):
+    private = directory / f"{name}-private.pem"
+    public = directory / f"{name}-public.pem"
+    subprocess.run(["openssl", "genpkey", "-algorithm", "RSA", "-pkeyopt", "rsa_keygen_bits:2048", "-out", private], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    subprocess.run(["openssl", "pkey", "-in", private, "-pubout", "-out", public], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    private.chmod(0o600)
+
+
+def create_fido2(directory):
+    directory.mkdir(exist_ok=True)
+    subprocess.run(["openssl", "ecparam", "-name", "prime256v1", "-genkey", "-noout", "-out", directory / "private-key.pem"], check=True)
+    subprocess.run(["openssl", "req", "-new", "-x509", "-key", directory / "private-key.pem", "-out", directory / "certificate.pem", "-subj", "/CN=RVA23 U2F Test", "-days", "365"], check=True)
+    (directory / "counter").write_bytes(struct.pack(">I", 1))
+    (directory / "entropy").write_bytes(secrets.token_bytes(48))
+
+
+def create_smartcard(directory):
+    directory.mkdir(exist_ok=True)
+    noise = directory / "noise"
+    noise.write_bytes(secrets.token_bytes(64))
+    subprocess.run(["certutil", "-N", "-d", f"sql:{directory}", "--empty-password"], check=True)
+    subprocess.run(["certutil", "-S", "-d", f"sql:{directory}", "-z", noise, "-s", "CN=RVA23 Smartcard CA", "-x", "-t", "TC,TC,TC", "-n", "fake-smartcard-ca", "-m", "1"], check=True)
+    subprocess.run(["certutil", "-S", "-d", f"sql:{directory}", "-z", noise, "-t", ",,", "-s", "CN=RVA23 User", "-n", "id-cert", "-c", "fake-smartcard-ca", "-m", "2"], check=True)
+    subprocess.run(["certutil", "-S", "-d", f"sql:{directory}", "-z", noise, "-t", ",,", "-s", "CN=RVA23 User (signing)", "--nsCertType", "smime", "-n", "signing-cert", "-c", "fake-smartcard-ca", "-m", "3"], check=True)
+    subprocess.run(["certutil", "-S", "-d", f"sql:{directory}", "-z", noise, "-t", ",,", "-s", "CN=RVA23 User (encryption)", "--nsCertType", "sslClient", "-n", "encryption-cert", "-c", "fake-smartcard-ca", "-m", "4"], check=True)
+    certificate = directory / "signing-cert.cer"
+    subprocess.run(["certutil", "-L", "-r", "-d", f"sql:{directory}", "-o", certificate, "-n", "signing-cert"], check=True)
+    public_key = directory / "smartcard-public.pem"
+    subprocess.run(["openssl", "x509", "-inform", "DER", "-in", certificate, "-pubkey", "-noout"], check=True, stdout=public_key.open("w"))
+
+
+def predict_profile(output, filename):
+    images = output / "images"
+    key_dir = output.parent.parent.parent / "buildroot-qemu-keys"
+    cmdline = output / "wallet" / f"{filename}.cmdline"
+    cmdline.write_text((images / f"{filename}.cmdline").read_text().rstrip("\n"))
+    uname = output / "wallet" / f"{filename}.uname"
+    uname.write_text(next(output.glob("build/linux-*/include/config/kernel.release")).read_text().rstrip("\n"))
+    sbat = output / "wallet" / f"{filename}.sbat"
+    subprocess.run([output / "host/bin/riscv64-linux-objcopy", "-O", "binary", "--only-section=.sbat", images / "efi-part/EFI/Linux" / filename, sbat], check=True)
+    result = subprocess.run([
+        "/usr/lib/systemd/systemd-measure", "calculate", "--linux", images / "Image", "--initrd", images / "rootfs.cpio.gz",
+        "--osrel", images / "image-staging/usr/lib/os-release", "--cmdline", cmdline, "--uname", uname,
+        "--sbat", sbat, "--pcrpkey", key_dir / "pcr-public.pem", "--bank", "sha256", "--phase", "enter-initrd:leave-initrd:sysinit:ready",
+    ], check=True, capture_output=True, text=True)
+    match = re.search(r"11:sha256=([0-9a-f]{64})", result.stdout)
+    assert match, result.stdout
+    return match.group(1)
+
+
+def start_services(output, receiver_dir, wallet_dir):
+    secret = secrets.token_bytes(32)
+    public_key = (receiver_dir / "public-key.pem").read_bytes()
+    token_path = receiver_dir / "token.json"
+    token_path.write_text(json.dumps({"keyId": hashlib.sha256(public_key).hexdigest(), "secret": base64.b64encode(secret).decode()}) + "\n")
+    token_path.chmod(0o600)
+    subprocess.run(["go", "build", "-o", receiver_dir / "report-receiver", "scripts/report-receiver.go"], check=True)
+    subprocess.run(["go", "build", "-o", wallet_dir / "wallet-server", "scripts/wallet-server.go"], check=True)
+    subprocess.run(["go", "build", "-o", wallet_dir / "consent-emulator", "scripts/consent-emulator.go"], check=True)
+    environment = os.environ.copy()
+    environment["RVA23_TOKEN_FILE"] = str(token_path)
+    environment["RVA23_ATTESTATION_DIR"] = str(receiver_dir)
+    receiver = subprocess.Popen([receiver_dir / "report-receiver"], stdout=(receiver_dir / "wallet-report-receiver.log").open("w"), stderr=subprocess.STDOUT, env=environment)
+    smartcard = subprocess.Popen([wallet_dir / "consent-emulator", "-listen", "127.0.0.1:8082", "-kind", "smartcard", "-key", wallet_dir / "smartcard-private.pem", "-public", wallet_dir / "smartcard-public.pem"], stdout=(wallet_dir / "smartcard.log").open("w"), stderr=subprocess.STDOUT)
+    wallet_environment = environment.copy()
+    wallet_environment["RVA23_WALLET_DIR"] = str(wallet_dir)
+    wallet_environment["RVA23_WALLET_KEY_FILE"] = str(receiver_dir / "public-key.pem")
+    wallet_environment["RVA23_WALLET_CONSENT_DIR"] = str(wallet_dir)
+    wallet_environment["RVA23_WALLET_ATTESTATION_URL"] = "http://127.0.0.1:8080/v1/attest"
+    wallet = subprocess.Popen([wallet_dir / "wallet-server"], stdout=(wallet_dir / "wallet-server.log").open("w"), stderr=subprocess.STDOUT, env=wallet_environment)
+    return [receiver, smartcard, wallet]
+
+
+def main():
+    output = Path(sys.argv[1]).resolve()
+    receiver_dir = output / "host-attestation"
+    wallet_dir = output / "wallet"
+    wallet_dir.mkdir(exist_ok=True)
+    create_key(wallet_dir, "smartcard")
+    create_key(wallet_dir, "fido2")
+    create_fido2(wallet_dir / "u2f")
+    os.environ["RVA23_FIDO2_DIR"] = str(wallet_dir / "u2f")
+    os.environ["QEMU"] = str(output / "build/host-qemu-11.0.0/build/qemu-system-riscv64")
+    profiles = {"development": predict_profile(output, "rva23-debug_1.efi"), "production": predict_profile(output, "rva23_1+3-0.efi")}
+    (wallet_dir / "profiles.json").write_text(json.dumps(profiles) + "\n")
+    processes = start_services(output, receiver_dir, wallet_dir)
+    console = Console(output, "wallet.log", firmware=True)
+    try:
+        login(console)
+        console.command("wallet-client --contract=small-payment --consent=host --approve", 300)
+        console.command("if wallet-client --replay; then false; else true; fi", 300)
+        console.command("if wallet-client --contract=small-payment --consent=host --approve; then false; else true; fi", 300)
+        print("PASS: tier 0 accepts a TPM-signed small payment and enforces its daily limit and replay protection")
+
+        console = reboot_to(console, output, "rva23-debug_*.efi")
+        login(console)
+        for method in ("host", "fido2"):
+            console.command(f"wallet-client --contract=development-payment --consent={method} --approve", 300)
+        console.command("if wallet-client --contract=development-payment --consent=host --approve; then false; else true; fi", 300)
+        print("PASS: tier 1 development payments accept host and FIDO2 consent within the daily limit")
+
+        console = reboot_to(console, output, "rva23_?.efi")
+        login(console)
+        for method in ("host", "fido2"):
+            console.command(f"wallet-client --contract=mortgage --consent={method} --approve", 300)
+        print("PASS: tier 2 accepts the example mortgage with production host consent and external consent without an OS report")
+
+        console.sendline("poweroff")
+        console.process.wait(timeout=90)
+    finally:
+        console.close()
+        for process in processes:
+            process.terminate()
+        for process in processes:
+            process.wait(timeout=15)
+
+
+if __name__ == "__main__":
+    main()
