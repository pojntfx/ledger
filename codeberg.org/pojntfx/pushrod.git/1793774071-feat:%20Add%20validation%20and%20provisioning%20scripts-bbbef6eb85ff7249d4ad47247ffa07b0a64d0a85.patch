+        console.expect(b"rva23 login:", 300)
+        console.sendline("root")
+        console.expect(b"# ", 30)
+        print(console.capture("od -An -tu1 -j4 -N1 /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c", 30))
+        console.command("test \"$(od -An -tu1 -j4 -N1 /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c | tr -d '[:space:]')\" = 1")
+        console.command("test \"$(cat /sys/kernel/security/ipe/enforce)\" = 1")
+        console.sendline("poweroff")
