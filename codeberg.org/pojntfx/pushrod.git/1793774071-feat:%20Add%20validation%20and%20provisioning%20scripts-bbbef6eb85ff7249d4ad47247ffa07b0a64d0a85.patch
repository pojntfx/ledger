+#!/usr/bin/env python3
+from pathlib import Path
+import subprocess
+import sys
+
+
+def run(*args):
+    subprocess.run([str(arg) for arg in args], check=True)
+
+
+def ensure_key(key_dir, name):
+    key = key_dir / f"{name}.key"
+    cert = key_dir / f"{name}.crt"
+    if not key.exists():
+        run("openssl", "genpkey", "-algorithm", "RSA", "-out", key, "-pkeyopt", "rsa_keygen_bits:3072", "-pkeyopt", "rsa_keygen_pubexp:65537")
+        key.chmod(0o600)
+    if not cert.exists():
+        run("openssl", "req", "-batch", "-new", "-x509", "-sha256", "-days", "3650", "-subj", f"/CN=RVA23 development {name}/", "-key", key, "-out", cert)
+    return key, cert
+
+
+def main():
+    key_dir = Path(sys.argv[1]).resolve()
+    key_dir.mkdir(parents=True, exist_ok=True)
+    for name in ("PK", "KEK", "secure-boot", "verity", "pcr", "update", "ipe"):
+        ensure_key(key_dir, name)
+    run("openssl", "pkey", "-in", key_dir / "pcr.key", "-pubout", "-out", key_dir / "pcr-public.pem")
+    (key_dir / "trusted.pem").write_bytes((key_dir / "verity.crt").read_bytes() + (key_dir / "ipe.crt").read_bytes())
+    gnupg_home = key_dir / "gnupg"
+    gnupg_home.mkdir(mode=0o700, exist_ok=True)
+    gnupg_home.chmod(0o700)
+    if not (key_dir / "update-public.pgp").exists():
+        run("gpg", "--batch", "--homedir", gnupg_home, "--pinentry-mode", "loopback", "--passphrase", "", "--quick-generate-key", "RVA23 development update", "rsa3072", "sign", "never")
+        run("gpg", "--batch", "--homedir", gnupg_home, "--export", "--output", key_dir / "update-public.pgp", "RVA23 development update")
+    if len(sys.argv) > 2:
+        source = Path(sys.argv[2]).resolve()
+        fdf = source / "OvmfPkg/RiscVVirt/RiscVVirtQemu.fdf"
+        replacements = {
+            b"OvmfPkg/RiscVVirt/Feature/SecureBoot/SecureBootKeys/PK/PK.cer": b"Build/Buildroot/SecureBootKeys/PK.cer",
+            b"OvmfPkg/RiscVVirt/Feature/SecureBoot/SecureBootKeys/KEK/MicCorKEKCA2011_2011-06-24.crt": b"Build/Buildroot/SecureBootKeys/KEK.cer",
+            b"OvmfPkg/RiscVVirt/Feature/SecureBoot/SecureBootKeys/db/MicWinProPCA2011_2011-10-19.crt": b"Build/Buildroot/SecureBootKeys/db.cer",
+        }
+        content = fdf.read_bytes()
+        for old, new in replacements.items():
+            if old not in content and new not in content:
+                raise RuntimeError(f"Missing EDK2 key path: {old.decode()}")
+            content = content.replace(old, new)
+        content = content.replace(b"    SECTION RAW = OvmfPkg/RiscVVirt/Feature/SecureBoot/SecureBootKeys/db/MicCorUEFCA2011_2011-06-27.crt\r\n", b"")
+        dbx = b"  FILE FREEFORM = 5740766a-718e-4dc0-9935-c36f7d3f884f {\r\n    SECTION RAW = OvmfPkg/RiscVVirt/Feature/SecureBoot/SecureBootKeys/dbx/dbxupdate_x64.bin\r\n  }\r\n"
+        content = content.replace(dbx, b"")
+        fdf.write_bytes(content)
+        destination = source / "Build/Buildroot/SecureBootKeys"
+        destination.mkdir(parents=True, exist_ok=True)
+        for name in ("PK", "KEK", "secure-boot"):
+            output = "db.cer" if name == "secure-boot" else f"{name}.cer"
+            run("openssl", "x509", "-in", key_dir / f"{name}.crt", "-outform", "DER", "-out", destination / output)
+
+
+if __name__ == "__main__":
+    main()
