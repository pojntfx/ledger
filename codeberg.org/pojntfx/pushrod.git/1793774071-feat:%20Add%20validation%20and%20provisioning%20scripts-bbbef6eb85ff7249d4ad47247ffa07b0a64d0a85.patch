+++ b/buildroot/qemu/scripts/verify-attested-app.py
@@ -0,0 +1,67 @@
+#!/usr/bin/env python3
+import base64
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import secrets
+import subprocess
+import sys
+
+from verify_boot import Console
+
+
+def copy_guest_file(console, source, destination):
+    text = console.capture(f"printf '__BEGIN__\\n'; base64 {source}; printf '__END__\\n'", 120)
+    match = re.search(r"__BEGIN__\r?\n(.*?)\r?\n__END__", text, re.DOTALL)
+    assert match, text[-2000:]
+    destination.write_bytes(base64.b64decode(re.sub(r"\s", "", match.group(1))))
+
+
+def main():
+    output = Path(sys.argv[1]).resolve()
+    receiver_dir = output / "host-attestation"
+    public_key = (receiver_dir / "public-key.pem").read_bytes()
+    key_id = hashlib.sha256(public_key).hexdigest()
+    secret = secrets.token_bytes(32)
+    token_document = {"keyId": key_id, "secret": base64.b64encode(secret).decode()}
+    token_path = receiver_dir / "token.json"
+    token_path.write_text(json.dumps(token_document) + "\n")
+    token_path.chmod(0o600)
+    environment = os.environ.copy()
+    environment["RVA23_TOKEN_FILE"] = str(token_path)
+    subprocess.run(["go", "build", "-o", receiver_dir / "report-receiver", "scripts/report-receiver.go"], check=True)
+    receiver = subprocess.Popen(
+        [receiver_dir / "report-receiver"],
+        stdout=(receiver_dir / "app-receiver.log").open("w"),
+        stderr=subprocess.STDOUT,
+        env=environment,
+    )
+    console = Console(output, "attested-app.log", firmware=True)
+    try:
+        console.expect(b"rva23 login:", 300)
+        console.sendline("root")
+        console.expect(b"# ", 30)
+        console.command("systemctl is-active --quiet --wait graphical.target")
+        console.command("systemctl start systemd-pcrlock.socket")
+        console.command("systemctl restart systemd-report-sign-tpm2.socket")
+        console.command("sleep 2")
+        console.command("attested-client", 300)
+        copy_guest_file(console, "/tmp/rva23-attested-body", receiver_dir / "guest-report.json")
+        console.command("if attested-client --replay; then false; else true; fi", 300)
+        console.sendline("poweroff")
+        console.process.wait(timeout=90)
+    finally:
+        console.close()
+        receiver.terminate()
+        receiver.wait(timeout=15)
+    response = json.loads((receiver_dir / "response.json").read_text())
+    assert response["status"] == "accepted", response
+    assert response["componentsVerified"] > 0, response
+    assert response["eventLogRecords"] > 0, response
+    print("PASS: the Go server accepts a TPM-bound attestation and rejects replay")
+
+
+if __name__ == "__main__":
+    main()
