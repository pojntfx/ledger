diff --git a/buildroot/scripts/7-demo-kubernetes.py b/buildroot/scripts/7-demo-kubernetes.py
new file mode 100755
index 0000000000000000000000000000000000000000..dcd1997d556d36ee80d85f4bcb19c78aa90f76cb
--- /dev/null
+++ b/buildroot/scripts/7-demo-kubernetes.py
@@ -0,0 +1,101 @@
+#!/usr/bin/env python3
+import importlib.util
+import json
+from pathlib import Path
+import sys
+import time
+
+sys.path.insert(0, str(Path(__file__).parent))
+
+import demo_lib
+
+OUTPUT = Path(__file__).parent.parent / "output/k3-uefi"
+KUBECONFIG = "/var/lib/k3s-demo/server/cred/admin.kubeconfig"
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+valkey = load("valkey_test", Path(__file__).with_name("verify-valkey.py"))
+
+MANIFEST = {
+    "apiVersion": "v1",
+    "kind": "Pod",
+    "metadata": {"name": "valkey-k3s"},
+    "spec": {
+        "hostNetwork": True,
+        "containers": [
+            {
+                "name": "valkey",
+                "image": "docker.io/library/valkey-local:latest",
+                "imagePullPolicy": "Never",
+                "command": ["/lib/ld-linux-riscv64-lp64d.so.1", "--library-path", "/lib", "/valkey-server", "/etc/valkey.conf"],
+                "args": ["--port", "6380"],
+            }
+        ],
+    },
+}
+
+
+def main():
+    demo = demo_lib.Demo(
+        "Demo 7: a signed Kubernetes workload",
+        "k3s runs from a signed extension, Valkey runs on the pod, and a tampered extension is rejected",
+    )
+    demo.banner()
+    demo.cue("Watch the board: k3s and the pod run on the real hardware")
+
+    demo.step("Check the cluster on the board")
+    state = demo.run_command("systemctl is-active rva23-k3s-demo", check=False).stdout.strip()
+    if state != "active":
+        demo.note("k3s is not running; run make demo-kubernetes-warm after demo 3 to pre-warm it")
+    demo.run_command("systemctl reset-failed rva23-k3s-demo 2>/dev/null || true", check=False)
+    nodes = ""
+    for _ in range(90):
+        nodes = demo.run_command(f"kubectl --kubeconfig={KUBECONFIG} get nodes 2>/dev/null || true", 60, check=False, lines=2).stdout
+        if "Ready" in nodes:
+            break
+        time.sleep(2)
+    if "Ready" not in nodes:
+        raise demo_lib.DemoError("the k3s node is not ready")
+    demo.result("the node is ready")
+
+    demo.step("Run the signed Valkey pod")
+    document = "/tmp/valkey-k3s.yaml"
+    demo.note(f"pod valkey-k3s: image {MANIFEST['spec']['containers'][0]['image']}, port 6380, hostNetwork")
+    demo.k3.run(f"cat > {document} <<'EOF2'\n{json.dumps(MANIFEST, indent=2)}\nEOF2\n")
+    demo.run_command(f"kubectl --kubeconfig={KUBECONFIG} apply -f {document}", 120)
+    result = demo.run_command(f"kubectl --kubeconfig={KUBECONFIG} wait --for=condition=Ready pod/valkey-k3s --timeout=120s", 180, check=False)
+    if "condition met" not in result.stdout:
+        raise demo_lib.DemoError(result.stdout[-800:])
+    demo.result("the pod is ready")
+
+    demo.step("Reach Valkey over IPv6")
+    valkey.resp(demo_lib.board_link_local(), 6380, demo_lib.host_interface())
+    demo.result("PING, SET, and GET answer on port 6380")
+
+    demo.step("Tamper with the signed k3s extension")
+    demo.run_command("systemd-sysext unmerge", 120)
+    demo.run_command("image=$(find /var/lib/extensions -maxdepth 1 -name 'k3s_*.raw' -not -name '*.backup' -print -quit); cp \"$image\" \"$image.backup\"; printf X | dd of=\"$image\" bs=1 seek=1048576 conv=notrunc 2>/dev/null", 120, lines=0)
+    demo.note("one byte changed inside the signed k3s extension")
+    check = demo.run_command("if systemd-sysext --image-policy=root=signed+absent:usr=signed+absent refresh; then false; else true; fi", 120, check=False)
+    if check.returncode != 0:
+        raise demo_lib.DemoError("the tampered extension was accepted")
+    demo.result("the tampered extension is rejected")
+    demo.run_command("image=$(find /var/lib/extensions -maxdepth 1 -name 'k3s_*.raw' -not -name '*.backup' -print -quit); mv \"$image.backup\" \"$image\"", 120, lines=0)
+    demo.run_command("systemd-sysext --image-policy=root=signed+absent:usr=signed+absent refresh", 120, lines=2)
+    demo.result("the original extension merges again")
+
+    demo.step("Read the cluster state")
+    demo.run_command(f"kubectl --kubeconfig={KUBECONFIG} get pods -o wide", 60, check=False, lines=4)
+
+    demo.payoff("The cluster runs a signed workload, and a tampered extension never reaches it")
+    return demo.finish()
+
+
+if __name__ == "__main__":
+    demo_lib.run(main)
diff --git a/buildroot/scripts/demo-kubernetes-warm.py b/buildroot/scripts/demo-kubernetes-warm.py
new file mode 100755
index 0000000000000000000000000000000000000000..787b7b43b7fed3e78b4b56dd75433579939cf4a6
--- /dev/null
+++ b/buildroot/scripts/demo-kubernetes-warm.py
@@ -0,0 +1,85 @@
+#!/usr/bin/env python3
+import importlib.util
+import os
+from pathlib import Path
+import sys
+import time
+
+sys.path.insert(0, str(Path(__file__).parent))
+
+import demo_lib
+
+OUTPUT = Path(__file__).parent.parent / "output/k3-uefi"
+KUBECONFIG = "/var/lib/k3s-demo/server/cred/admin.kubeconfig"
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+valkey = load("valkey_test", Path(__file__).with_name("verify-valkey.py"))
+
+os.environ.setdefault("K3_SSH", demo_lib.K3_HOST)
+os.environ.setdefault("K3_SSH_KEY", demo_lib.K3_KEY)
+
+
+def run(k3, command, timeout=300, lines=2):
+    print(f"$ {command}", flush=True)
+    output = k3.command(command, timeout)
+    for line in (output or "").strip().splitlines()[:lines]:
+        print(f"  {line}", flush=True)
+    return output
+
+
+def ready(k3):
+    archives = k3.command("test -f /tmp/valkey-local.tar && test -f /tmp/pause-image.tar && echo yes || echo no", 60).strip()
+    if archives != "yes":
+        return False
+    nodes = k3.command(f"kubectl --kubeconfig={KUBECONFIG} get nodes 2>/dev/null || true", 60)
+    return "Ready" in nodes
+
+
+def warm():
+    k3 = valkey.K3(OUTPUT)
+    if ready(k3):
+        print("warm: already ready", flush=True)
+        return
+    print("warm: building the images", flush=True)
+    rootfs = valkey.rootfs_tar(OUTPUT, valkey.valkey_source(OUTPUT))
+    pause = valkey.pause_tar()
+    print(f"$ upload {rootfs}", flush=True)
+    k3.upload(rootfs, "/tmp/valkey-rootfs.tar")
+    print(f"$ upload {pause}", flush=True)
+    k3.upload(pause, "/tmp/pause.tar")
+    print("warm: importing the podman image", flush=True)
+    run(k3, "podman import /tmp/valkey-rootfs.tar valkey-local >/dev/null; rm -f /tmp/valkey-local.tar; podman save -o /tmp/valkey-local.tar valkey-local >/dev/null", 600)
+    run(k3, "podman import --change 'ENTRYPOINT [\"/pause\"]' /tmp/pause.tar docker.io/rancher/mirrored-pause:3.10.2 >/dev/null; rm -f /tmp/pause-image.tar; podman save -o /tmp/pause-image.tar docker.io/rancher/mirrored-pause:3.10.2 >/dev/null", 600)
+    print("warm: starting k3s", flush=True)
+    state = run(k3, "systemctl is-active rva23-k3s-demo || true", 30, lines=1).strip()
+    if state != "active":
+        run(k3, "systemctl reset-failed rva23-k3s-demo 2>/dev/null || true", 60)
+        run(k3, "systemctl stop rva23-k3s-demo 2>/dev/null || true", 120)
+        run(k3, "rm -rf /var/lib/k3s-demo", 120)
+        run(k3, "systemd-run --unit=rva23-k3s-demo --property=Type=simple k3s server --disable=metrics-server --disable=traefik --data-dir=/var/lib/k3s-demo --write-kubeconfig-mode=0644", 120)
+    for _ in range(60):
+        nodes = run(k3, f"kubectl --kubeconfig={KUBECONFIG} get nodes 2>/dev/null || true", 30, lines=2)
+        if "Ready" in nodes:
+            break
+        time.sleep(2)
+    else:
+        raise demo_lib.DemoError("k3s did not become ready")
+    print("warm: importing the k3s images", flush=True)
+    run(k3, "k3s ctr -n k8s.io images import /tmp/valkey-local.tar >/dev/null; k3s ctr -n k8s.io images tag localhost/valkey-local:latest docker.io/library/valkey-local:latest >/dev/null", 600)
+    run(k3, "k3s ctr -n k8s.io images import /tmp/pause-image.tar >/dev/null", 600)
+    print("warm: ready", flush=True)
+
+
+if __name__ == "__main__":
+    try:
+        warm()
+    except Exception as error:
+        print(f"warm: failed: {error}", flush=True)
+        raise SystemExit(1)
