diff --git a/buildroot/qemu/board/rva23-qemu/build-firmware.sh b/buildroot/qemu/board/rva23-qemu/build-firmware.sh
new file mode 100755
index 0000000000000000000000000000000000000000..8bb929e0a1b61fdbf65ad5f06ffb8c707ee876d6
--- /dev/null
+++ b/buildroot/qemu/board/rva23-qemu/build-firmware.sh
@@ -0,0 +1,53 @@
+#!/bin/sh
+
+set -eu
+
+BOARD_DIR=$(dirname "$0")
+KEY_DIR=${RVA23_KEY_DIR:?}
+
+mkdir -p "${KEY_DIR}"
+if [ ! -f "${KEY_DIR}/dev.key" ]; then
+	openssl genpkey -algorithm RSA -out "${KEY_DIR}/dev.key" \
+		-pkeyopt rsa_keygen_bits:2048 -pkeyopt rsa_keygen_pubexp:65537
+fi
+if [ ! -f "${KEY_DIR}/dev.crt" ]; then
+	openssl req -batch -new -x509 -key "${KEY_DIR}/dev.key" -out "${KEY_DIR}/dev.crt"
+fi
+chmod 600 "${KEY_DIR}/dev.key"
+
+TPM_STATE="${BINARIES_DIR}/firmware-swtpm"
+mkdir -p "${TPM_STATE}"
+rm -f "${TPM_STATE}/swtpm.sock"
+"${HOST_DIR}/bin/swtpm" socket --tpm2 --tpmstate dir="${TPM_STATE}",mode=0600,lock \
+	--ctrl type=unixio,path="${TPM_STATE}/swtpm.sock",mode=0600,terminate \
+	--flags not-need-init,startup-clear --log file="${TPM_STATE}/swtpm.log" &
+SWTPM_PID=$!
+trap 'kill "${SWTPM_PID}" 2>/dev/null || true; wait "${SWTPM_PID}" 2>/dev/null || true' EXIT INT TERM
+while [ ! -S "${TPM_STATE}/swtpm.sock" ]; do
+	sleep 0.1
+done
+
+"${HOST_DIR}/bin/qemu-system-riscv64" \
+	-M virt,pflash0=pflash0,pflash1=pflash1,acpi=off,dumpdtb="${BINARIES_DIR}/qemu-control-base.dtb" \
+	-accel tcg \
+	-cpu rva23s64 \
+	-smp 4 \
+	-m 2048 \
+	-blockdev node-name=pflash0,driver=file,read-only=on,filename="${BINARIES_DIR}/RISCV_VIRT_CODE.fd" \
+	-blockdev node-name=pflash1,driver=file,filename="${BINARIES_DIR}/RISCV_VIRT_VARS.fd" \
+	-device virtio-gpu-pci \
+	-device qemu-xhci \
+	-device usb-kbd \
+	-device usb-tablet \
+	-chardev socket,id=chrtpm,path="${TPM_STATE}/swtpm.sock" \
+	-tpmdev emulator,id=tpm0,chardev=chrtpm \
+	-device tpm-tis-device,tpmdev=tpm0 \
+	-display none
+
+cd "${BINARIES_DIR}"
+"${HOST_DIR}/bin/dtc" -@ -I dts -O dtb -o early-tpm-overlay.dtbo "${BOARD_DIR}/early-tpm-overlay.dts"
+"${HOST_DIR}/bin/fdtoverlay" -i qemu-control-base.dtb -o qemu-control-measured.dtb early-tpm-overlay.dtbo
+cp qemu-control-measured.dtb qemu-control.dtb
+"${HOST_DIR}/bin/mkimage" -f "${BOARD_DIR}/firmware.its" -E -p 0x10000 \
+	-D "-I dts -O dtb -p 0x1000 -i ${BINARIES_DIR}" \
+	-K qemu-control.dtb -k "${KEY_DIR}" -r firmware.itb
diff --git a/buildroot/qemu/board/rva23-qemu/dracut/99rva23/module-setup.sh b/buildroot/qemu/board/rva23-qemu/dracut/99rva23/module-setup.sh
new file mode 100755
index 0000000000000000000000000000000000000000..6cbfe3a2e9c2bf58f2f2b96475571ef33f6b5e60
--- /dev/null
+++ b/buildroot/qemu/board/rva23-qemu/dracut/99rva23/module-setup.sh
@@ -0,0 +1,22 @@
+#!/bin/bash
+check() {
+    require_binaries systemd-repart mkswap || return 1
+    return 0
+}
+depends() {
+    echo systemd-repart
+    return 0
+}
+install() {
+    inst_multiple mkswap bootctl
+    mkdir -p "${initdir}/etc"
+    printf 'root::::::::\n' > "${initdir}/etc/shadow"
+    ln_r /usr/bin/busybox /usr/bin/stat
+    ln_r /usr/bin/busybox /usr/bin/timeout
+    rm -f "$initdir/usr/bin/dracut-util"
+    inst_script "$moddir/rva23-dracut-util.sh" /usr/bin/dracut-util
+    inst_simple "$moddir/rva23-factory-reset.service" "$systemdsystemunitdir/rva23-factory-reset.service"
+    mkdir -p "$initdir/usr/share/factory"
+    cp -a "$dracutsysrootdir/usr/share/factory/." "$initdir/usr/share/factory/"
+    $SYSTEMCTL -q --root "$initdir" add-wants initrd.target dracut-initqueue.service
+}
diff --git a/buildroot/qemu/board/rva23-qemu/dracut/99rva23/rva23-dracut-util.sh b/buildroot/qemu/board/rva23-qemu/dracut/99rva23/rva23-dracut-util.sh
new file mode 100755
index 0000000000000000000000000000000000000000..7460e6bb8ff8b311cc88fd303f7c9405aa53f481
--- /dev/null
+++ b/buildroot/qemu/board/rva23-qemu/dracut/99rva23/rva23-dracut-util.sh
@@ -0,0 +1,31 @@
+#!/bin/bash
+key=${1:?}
+prefix=${key%=}
+all=0
+case $0 in
+    *getargs) all=1 ;;
+esac
+found=0
+value=
+for argument in $(cat /proc/cmdline); do
+    case $argument in
+        "$prefix"=*)
+            found=1
+            value=${argument#*=}
+            if [ "$all" = 1 ]; then
+                printf '%s\n' "$value"
+            fi
+            ;;
+        "$prefix")
+            found=1
+            value=
+            if [ "$all" = 1 ]; then
+                printf '\n'
+            fi
+            ;;
+    esac
+done
+if [ "$all" = 0 ] && [ "$found" = 1 ]; then
+    printf '%s\n' "$value"
+fi
+exit $((1 - found))
diff --git a/buildroot/qemu/board/rva23-qemu/dracut/99rva23/rva23-factory-reset.service b/buildroot/qemu/board/rva23-qemu/dracut/99rva23/rva23-factory-reset.service
new file mode 100644
index 0000000000000000000000000000000000000000..4b5a350bacbceb7210f5d3f2e3ce20b2b8c203ce
--- /dev/null
+++ b/buildroot/qemu/board/rva23-qemu/dracut/99rva23/rva23-factory-reset.service
@@ -0,0 +1,17 @@
+[Unit]
+Description=Reset RVA23 local storage and reboot
+DefaultDependencies=no
+After=systemd-udevd.service systemd-tpm2-setup-early.service
+Wants=systemd-udevd.service systemd-tpm2-setup-early.service
+
+[Service]
+Type=oneshot
+StandardOutput=console
+StandardError=console
+ExecStartPre=/usr/bin/mkdir -p /boot /sysroot/usr
+ExecStartPre=/usr/bin/mount -t vfat /dev/vda1 /boot
+ExecStartPre=/usr/bin/mount -t erofs -o ro /dev/vda2 /sysroot/usr
+ExecStart=/usr/bin/sh -c '/usr/bin/systemd-repart --dry-run=no --tpm2-pcrs= --tpm2-public-key-pcrs= --factory-reset=yes --definitions=/usr/lib/repart.d /dev/vda > /dev/ttyS0 2>&1'
+ExecStartPost=/usr/bin/bootctl set-default 'rva23_?.efi'
+ExecStartPost=/usr/bin/sh -c 'printf "default rva23_?.efi\ntimeout 0\neditor no\n" > /boot/loader/loader.conf'
+ExecStartPost=/usr/bin/systemctl reboot
diff --git a/buildroot/qemu/board/rva23-qemu/edk2/PlatformTpm.c b/buildroot/qemu/board/rva23-qemu/edk2/PlatformTpm.c
new file mode 100644
index 0000000000000000000000000000000000000000..87296e3c6afb1f89ea528d89968fdefc2c4a2541
--- /dev/null
+++ b/buildroot/qemu/board/rva23-qemu/edk2/PlatformTpm.c
@@ -0,0 +1,89 @@
+#include "PlatformSecLib.h"
+
+VOID
+SecSetupTpmResources (
+  VOID  *FdtBase
+  )
+{
+  INT32         Node, Prev;
+  INT32         Parent, Depth;
+  CONST CHAR8   *Compatible;
+  CONST CHAR8   *CompItem;
+  INT32         Len;
+  INT32         RangesLen;
+  CONST UINT8   *RegProp;
+  CONST UINT32  *RangesProp;
+  UINT64        TpmBase;
+  UINT64        TpmBaseSize;
+
+  Parent = 0;
+  TpmBase = 0;
+  TpmBaseSize = 0;
+
+  for (Prev = Depth = 0; ; Prev = Node) {
+    Node = FdtNextNode (FdtBase, Prev, &Depth);
+    if (Node < 0) {
+      break;
+    }
+
+    if (Depth == 1) {
+      Parent = Node;
+    }
+
+    Compatible = FdtGetProp (FdtBase, Node, "compatible", &Len);
+    for (CompItem = Compatible; CompItem != NULL && CompItem < Compatible + Len;
+         CompItem += 1 + AsciiStrLen (CompItem))
+    {
+      if (AsciiStrCmp (CompItem, "tcg,tpm-tis-mmio") == 0) {
+        RegProp = FdtGetProp (FdtBase, Node, "reg", &Len);
+        ASSERT (Len == 8 || Len == 16);
+        if (Len == 8) {
+          TpmBase     = Fdt32ToCpu (*(UINT32 *)RegProp);
+          TpmBaseSize = Fdt32ToCpu (*(UINT32 *)((UINT8 *)RegProp + 4));
+        } else if (Len == 16) {
+          TpmBase     = Fdt64ToCpu (ReadUnaligned64 ((UINT64 *)RegProp));
+          TpmBaseSize = Fdt64ToCpu (ReadUnaligned64 ((UINT64 *)((UINT8 *)RegProp + 8)));
+        }
+
+        if (Depth > 1) {
+          RangesProp = FdtGetProp (FdtBase, Parent, "ranges", &RangesLen);
+          ASSERT (RangesProp != NULL);
+          if (RangesLen != 0) {
+            if (RangesLen != Len + 2 * sizeof (UINT32)) {
+              DEBUG ((
+                DEBUG_WARN,
+                "%a: 'ranges' property has unexpected size %d\n",
+                __func__,
+                RangesLen
+                ));
+              break;
+            }
+
+            if (Len == 8) {
+              TpmBase -= Fdt32ToCpu (RangesProp[0]);
+            } else {
+              TpmBase -= Fdt64ToCpu (ReadUnaligned64 ((UINT64 *)RangesProp));
+            }
+
+            RangesProp = (UINT32 *)((UINT8 *)RangesProp + Len / 2);
+            TpmBase   += Fdt64ToCpu (ReadUnaligned64 ((UINT64 *)RangesProp));
+          }
+        }
+
+        break;
+      }
+    }
+  }
+
+  if (TpmBase) {
+    BuildResourceDescriptorHob (
+      EFI_RESOURCE_MEMORY_MAPPED_IO,
+      EFI_RESOURCE_ATTRIBUTE_PRESENT     |
+      EFI_RESOURCE_ATTRIBUTE_INITIALIZED |
+      EFI_RESOURCE_ATTRIBUTE_UNCACHEABLE |
+      EFI_RESOURCE_ATTRIBUTE_TESTED,
+      TpmBase,
+      ALIGN_VALUE (TpmBaseSize, EFI_PAGE_SIZE)
+      );
+  }
+}
diff --git a/buildroot/qemu/board/rva23-qemu/edk2/Rva23SecureBootEnroll/Rva23SecureBootEnroll.c b/buildroot/qemu/board/rva23-qemu/edk2/Rva23SecureBootEnroll/Rva23SecureBootEnroll.c
