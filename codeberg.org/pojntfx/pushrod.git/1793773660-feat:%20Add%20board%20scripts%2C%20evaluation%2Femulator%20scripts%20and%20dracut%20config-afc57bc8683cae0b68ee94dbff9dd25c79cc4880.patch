diff --git a/buildroot/qemu/board/rva23-qemu/run-firmware.sh b/buildroot/qemu/board/rva23-qemu/run-firmware.sh
new file mode 100755
index 0000000000000000000000000000000000000000..46c9135c082ab5f1c439d1a4036c436db566e108
--- /dev/null
+++ b/buildroot/qemu/board/rva23-qemu/run-firmware.sh
@@ -0,0 +1,64 @@
+#!/bin/sh
+
+set -eu
+
+IMAGES_DIR=$(realpath "${1}")
+QEMU=${QEMU:-"${IMAGES_DIR}/../host/bin/qemu-system-riscv64"}
+FIRMWARE_FIT=${FIRMWARE_FIT:-"${IMAGES_DIR}/firmware.itb"}
+FIRMWARE_DTB=${FIRMWARE_DTB:-"${IMAGES_DIR}/qemu-control.dtb"}
+SWTPM=${SWTPM:-"${IMAGES_DIR}/../host/bin/swtpm"}
+TPM_STATE=${RVA23_TPM_STATE:-"${IMAGES_DIR}/../firmware-swtpm"}
+mkdir -p "${TPM_STATE}"
+rm -f "${TPM_STATE}/swtpm.sock" "${TPM_STATE}/swtpm.lock" "${TPM_STATE}/.lock" "${IMAGES_DIR}/firmware-monitor.sock"
+"${SWTPM}" socket --tpm2 --tpmstate dir="${TPM_STATE}",mode=0600,lock \
+	--ctrl type=unixio,path="${TPM_STATE}/swtpm.sock",mode=0600,terminate \
+	--flags not-need-init,startup-clear --log file="${TPM_STATE}/swtpm.log" &
+SWTPM_PID=$!
+trap 'kill "${SWTPM_PID}" 2>/dev/null || true; wait "${SWTPM_PID}" 2>/dev/null || true' EXIT INT TERM
+while [ ! -S "${TPM_STATE}/swtpm.sock" ]; do
+	sleep 0.1
+done
+
+if [ -f "${IMAGES_DIR}/secure-boot-oem.txt" ]; then
+	set -- -smbios "type=11,value=$(cat "${IMAGES_DIR}/secure-boot-oem.txt")"
+fi
+if [ "${QEMU_VNC:-0}" = 1 ]; then
+	set -- -vnc 127.0.0.1:0
+else
+	set -- -display none
+fi
+if [ -n "${RVA23_UPDATE_IMAGE:-}" ]; then
+	set -- "$@" -drive file="${RVA23_UPDATE_IMAGE}",format=raw,if=virtio
+fi
+if [ -n "${RVA23_FIDO2_DIR:-}" ]; then
+	set -- "$@" -device "u2f-emulated,dir=${RVA23_FIDO2_DIR}"
+fi
+if [ -n "${RVA23_SMARTCARD_DIR:-}" ]; then
+	set -- "$@" -device "usb-ccid" -device "ccid-card-emulated,debug=3,backend=certificates,db=sql:${RVA23_SMARTCARD_DIR},cert1=id-cert,cert2=signing-cert,cert3=encryption-cert"
+fi
+
+exec "${QEMU}" \
+	-M virt,pflash0=pflash0,pflash1=pflash1,acpi=off \
+	-accel tcg \
+	-cpu rva23s64 \
+	-smp 4 \
+	-m 2048 \
+	-bios "${IMAGES_DIR}/u-boot-spl.bin" \
+	-dtb "${FIRMWARE_DTB}" \
+	-device loader,file="${FIRMWARE_FIT}",addr=0x80200000 \
+	-device loader,file="${FIRMWARE_FIT}",addr=0x90000000 \
+	-blockdev node-name=pflash0,driver=file,read-only=on,filename="${IMAGES_DIR}/RISCV_VIRT_CODE.fd" \
+	-blockdev node-name=pflash1,driver=file,filename="${IMAGES_DIR}/RISCV_VIRT_VARS.fd" \
+	-drive file="${IMAGES_DIR}/disk.img",format=raw,if=virtio \
+	-device virtio-gpu-pci \
+	-device qemu-xhci \
+	-device usb-kbd \
+	-device usb-tablet \
+	-chardev socket,id=chrtpm,path="${TPM_STATE}/swtpm.sock" \
+	-tpmdev emulator,id=tpm0,chardev=chrtpm \
+	-device tpm-tis-device,tpmdev=tpm0 \
+	-netdev user,id=net0 \
+	-device virtio-net-pci,netdev=net0 \
+	-monitor unix:"${IMAGES_DIR}/firmware-monitor.sock",server=on,wait=off \
+	"$@" \
+	-serial stdio
