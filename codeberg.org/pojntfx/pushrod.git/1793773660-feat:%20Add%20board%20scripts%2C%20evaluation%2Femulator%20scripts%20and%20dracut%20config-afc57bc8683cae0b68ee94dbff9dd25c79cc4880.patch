--- /dev/null
+++ b/buildroot/qemu/board/rva23-qemu/edk2/Rva23SecureBootEnroll/Rva23SecureBootEnroll.c
@@ -0,0 +1,63 @@
+#include <Uefi.h>
+#include <Uefi/UefiMultiPhase.h>
+#include <UefiSecureBoot.h>
+#include <Guid/GlobalVariable.h>
+#include <Guid/ImageAuthentication.h>
+#include <Guid/AuthenticatedVariableFormat.h>
+#include <Library/DebugLib.h>
+#include <Library/SecureBootVariableLib.h>
+#include <Library/SecureBootVariableProvisionLib.h>
+#include <Library/UefiLib.h>
+#include <Library/UefiRuntimeServicesTableLib.h>
+
+EFI_STATUS
+EFIAPI
+Rva23SecureBootEnrollEntry (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  EFI_STATUS  Status;
+  UINT8       SetupMode;
+  UINT8       Enable;
+
+  Status = GetSetupMode (&SetupMode);
+  if (EFI_ERROR (Status) || (SetupMode == USER_MODE)) {
+    return Status;
+  }
+
+  Status = SetSecureBootMode (CUSTOM_SECURE_BOOT_MODE);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Status = EnrollDbFromDefault ();
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Status = EnrollKEKFromDefault ();
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Status = EnrollPKFromDefault ();
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Status = SetSecureBootMode (STANDARD_SECURE_BOOT_MODE);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Enable = SECURE_BOOT_ENABLE;
+  return gRT->SetVariable (
+                EFI_SECURE_BOOT_ENABLE_NAME,
+                &gEfiSecureBootEnableDisableGuid,
+                EFI_VARIABLE_NON_VOLATILE |
+                EFI_VARIABLE_BOOTSERVICE_ACCESS,
+                sizeof Enable,
+                &Enable
+                );
+}
