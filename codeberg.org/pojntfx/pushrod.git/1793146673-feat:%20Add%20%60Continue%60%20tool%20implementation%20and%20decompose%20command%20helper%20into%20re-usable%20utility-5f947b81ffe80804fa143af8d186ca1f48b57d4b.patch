diff --git a/pkg/fastboot/protocol.go b/pkg/fastboot/protocol.go
index 451c3c26e025a2c39138b80577dcd65c23fc0dfb..def8b47cbba148f64404ecce9ec88bdc0579d912 100644
--- a/pkg/fastboot/protocol.go
+++ b/pkg/fastboot/protocol.go
@@ -63,6 +63,40 @@
 	return p.accept(ctx, expected, timeout)
 }
 
+func (p *protocol) commandResponses(ctx context.Context, command string, timeout time.Duration) ([]string, error) {
+	if err := p.writeCommand(ctx, command, timeout); err != nil {
+		return nil, err
+	}
+
+	responses := []string{}
+	for {
+		r, err := p.readResponse(ctx, timeout)
+		if err != nil {
+			return nil, err
+		}
+
+		switch r.status {
+		case statusInfo:
+			if r.payload != "" {
+				responses = append(responses, r.payload)
+			}
+
+		case statusOKAY:
+			if r.payload != "" {
+				responses = append(responses, r.payload)
+			}
+
+			return responses, nil
+
+		case statusFail:
+			return nil, errCommandFailed
+
+		default:
+			return nil, errUnexpectedResponse
+		}
+	}
+}
+
 func (p *protocol) writeCommand(ctx context.Context, command string, timeout time.Duration) error {
 	return p.write(ctx, []byte(command), timeout)
 }
diff --git a/pkg/svc/flash_continue.go b/pkg/svc/flash_continue.go
new file mode 100644
index 0000000000000000000000000000000000000000..bf69225940148e82a76b9d6eb67621c3280e524c
--- /dev/null
+++ b/pkg/svc/flash_continue.go
@@ -0,0 +1,47 @@
+package svc
+
+import (
+	"context"
+
+	"codeberg.org/pojntfx/pushrod/pkg/fastboot"
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+var (
+	ContinueTool = &mcp.Tool{
+		Name:        "flash.continue",
+		Title:       "Continue",
+		Description: "Continue booting a device with the image last staged into its memory",
+		Annotations: &mcp.ToolAnnotations{DestructiveHint: new(false)},
+	}
+)
+
+type ContinueInput struct {
+	Path string `json:"path" jsonschema:"path that uniquely identifies the fastboot device until it gets unplugged, in BUS-PORT form like 1-2-3"`
+}
+
+type ContinueOutput struct {
+	Response string `json:"response" jsonschema:"text that the device returned, if any"`
+}
+
+func (s *Service) Continue(ctx context.Context, req *mcp.CallToolRequest, input ContinueInput) (*mcp.CallToolResult, *ContinueOutput, error) {
+	if err := s.flashLock.Acquire(ctx, 1); err != nil {
+		return nil, nil, err
+	}
+	defer s.flashLock.Release(1)
+
+	session, err := fastboot.OpenSession(input.Path)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer session.Close()
+
+	response, err := session.Continue(ctx)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	return nil, &ContinueOutput{
+		Response: response,
+	}, nil
+}

