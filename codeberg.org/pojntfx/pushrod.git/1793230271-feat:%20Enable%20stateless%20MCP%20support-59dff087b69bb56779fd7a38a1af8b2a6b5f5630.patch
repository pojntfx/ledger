From 59dff087b69bb56779fd7a38a1af8b2a6b5f5630 Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Wed, 28 Oct 2026 16:31:11 -0700
Subject: [PATCH] feat: Enable stateless MCP support

Signed-off-by: Felicitas Pojtinger <felicitas@pojtinger.com>
---
diff --git a/main.go b/main.go
index 9815e98eb029bd42c4e98181e0fb14f949f16bd9..8d044a37da6be6f3a8bedc532215e0da0f9a458c 100644
--- a/main.go
+++ b/main.go
@@ -94,6 +94,7 @@ 		func(r *http.Request) *mcp.Server {
 			return handler
 		},
 		&mcp.StreamableHTTPOptions{
+			Stateless:                  true,
 			DisableLocalhostProtection: *publicURL != "",
 		},
 	)

