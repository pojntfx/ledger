diff --git a/pkg/svc/flash_flash_file.go b/pkg/svc/flash_flash_file.go
new file mode 100644
index 0000000000000000000000000000000000000000..c0574ecfb7e14115a9385b11b8d312be1aaa1682
--- /dev/null
+++ b/pkg/svc/flash_flash_file.go
@@ -0,0 +1,85 @@
+package svc
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"codeberg.org/pojntfx/pushrod/pkg/fastboot"
+	"codeberg.org/pojntfx/pushrod/pkg/fastboot/usb"
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+var (
+	FlashFileTool = &mcp.Tool{
+		Name:        "flash.flashFile",
+		Title:       "Flash file",
+		Description: "Flash an uploaded file to a partition on a device in fastboot mode, then optionally reboot it; take the file from files.getFiles and the port from flash.getDevices. Pass a progress token to stream progress while it runs",
+		Annotations: &mcp.ToolAnnotations{DestructiveHint: &[]bool{true}[0]},
+	}
+)
+
+type FlashFileInput struct {
+	File      string `json:"file" jsonschema:"name of the uploaded file to flash, like image.img from files.getFiles"`
+	Partition string `json:"partition" jsonschema:"partition to flash the file to, like boot or rootfs"`
+	Port      string `json:"port" jsonschema:"port of the device to flash, in BUS-PORT form (e.g. 1-2-3) from flash.getDevices"`
+	Reboot    bool   `json:"reboot" jsonschema:"whether to reboot the device after flashing so it boots the freshly flashed image"`
+}
+
+type FlashFileOutput struct {
+	File       string `json:"file" jsonschema:"name of the file that was flashed"`
+	Partition  string `json:"partition" jsonschema:"partition the file was flashed to"`
+	Rebooted   bool   `json:"rebooted" jsonschema:"whether the device was rebooted afterwards"`
+	DurationMs int64  `json:"durationMs" jsonschema:"how long the flash took, in milliseconds"`
+}
+
+func (s *Service) FlashFile(ctx context.Context, req *mcp.CallToolRequest, input FlashFileInput) (*mcp.CallToolResult, *FlashFileOutput, error) {
+	// Only a flat file that was uploaded to the files directory can be flashed
+	path, name, err := s.resolveUploadedFile(input.File)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	portPath, err := usb.ParsePortPath(input.Port)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	s.flashLock.Lock()
+	defer s.flashLock.Unlock()
+
+	// The flash reports every chunk, so only notify the client when the whole
+	// percentage changes, and only when it asked for progress
+	progressToken := req.Params.GetProgressToken()
+	lastPercent := -1
+	progress := func(sent, total int64) {
+		if progressToken == nil || total <= 0 {
+			return
+		}
+
+		percent := int(sent * 100 / total)
+		if percent == lastPercent {
+			return
+		}
+		lastPercent = percent
+
+		_ = req.Session.NotifyProgress(ctx, &mcp.ProgressNotificationParams{
+			ProgressToken: progressToken,
+			Progress:      float64(sent),
+			Total:         float64(total),
+			Message:       fmt.Sprintf("%d%%", percent),
+		})
+	}
+
+	start := time.Now()
+	if err := fastboot.Flash(portPath, input.Partition, path, input.Reboot, progress); err != nil {
+		return nil, nil, err
+	}
+
+	return nil, &FlashFileOutput{
+		File:       name,
+		Partition:  input.Partition,
+		Rebooted:   input.Reboot,
+		DurationMs: time.Since(start).Milliseconds(),
+	}, nil
+}
