@@ -107,6 +108,32 @@ 		return "", "", err
 	}
 
 	return filepath.Join(s.filesDir, sanitized), sanitized, nil
+}
+
+// resolveUploadedFile resolves a bare file name to an existing regular file in
+// the files directory, so that a tool can only ever open a flat file that was
+// uploaded there. filePath already rejects directories and traversal; the Lstat
+// additionally rules out a symlink or directory being flashed in its place
+func (s *Service) resolveUploadedFile(name string) (string, string, error) {
+	path, sanitized, err := s.filePath(name)
+	if err != nil {
+		return "", "", err
+	}
+
+	info, err := os.Lstat(path)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return "", "", fmt.Errorf("%w: %v", ErrFileNotFound, sanitized)
+		}
+
+		return "", "", err
+	}
+
+	if !info.Mode().IsRegular() {
+		return "", "", fmt.Errorf("%w: %v", ErrNotRegularFile, sanitized)
+	}
+
+	return path, sanitized, nil
 }
 
