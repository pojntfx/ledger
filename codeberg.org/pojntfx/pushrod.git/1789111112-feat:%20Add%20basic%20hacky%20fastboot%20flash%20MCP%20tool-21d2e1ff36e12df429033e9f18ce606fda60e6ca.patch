+// ParsePortPath reverses PortPathString, turning a BUS-PORT string like "1-2-3"
+// back into the port path a matcher compares against
+func ParsePortPath(s string) ([]int, error) {
+	parts := strings.Split(s, "-")
+	out := make([]int, 0, len(parts))
+	for _, part := range parts {
+		n, err := strconv.Atoi(part)
+		if err != nil {
+			return nil, fmt.Errorf("invalid port path %q: %w", s, err)
+		}
+		out = append(out, n)
+	}
+	return out, nil
+}
