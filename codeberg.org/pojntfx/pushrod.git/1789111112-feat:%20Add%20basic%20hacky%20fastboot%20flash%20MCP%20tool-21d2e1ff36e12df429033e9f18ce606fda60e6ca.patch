diff --git a/pkg/fastboot/flash.go b/pkg/fastboot/flash.go
new file mode 100644
index 0000000000000000000000000000000000000000..a92592c9b163e0e7b3763158e7f416d941df19fe
--- /dev/null
+++ b/pkg/fastboot/flash.go
@@ -0,0 +1,241 @@
+package fastboot
+
+import (
+	"encoding/binary"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"os"
+	"strconv"
+	"strings"
+
+	"codeberg.org/pojntfx/pushrod/pkg/fastboot/usb"
+)
+
+const (
+	// The device is asked for its max-download-size, but fall back to fastboot's
+	// conventional default and hard cap if it does not report a usable one
+	defaultMaxDownloadSize = 268435456  // 256 MiB
+	maxDownloadSize        = 1073741824 // 1 GiB
+
+	// Bulk transfers are written in 1 MiB chunks, matching flashserver
+	protocolChunkKB = 1024
+
+	connectTimeoutMs = 30000
+	commandTimeoutMs = 10000
+	flashTimeoutMs   = 60000
+)
+
+// ProgressCallback reports how many bytes of the image have been sent so far out
+// of its total size
+type ProgressCallback func(sent, total int64)
+
+type RemoteFailure struct{ Msg string }
+
+func (e *RemoteFailure) Error() string { return e.Msg }
+
+type TransferError struct{ Msg string }
+
+func (e *TransferError) Error() string { return e.Msg }
+
+type StateMismatch struct{ Expected, Got string }
+
+func (e *StateMismatch) Error() string {
+	return fmt.Sprintf("expected %s response, got %s", e.Expected, e.Got)
+}
+
+type InvalidResponse struct{ Msg string }
+
+func (e *InvalidResponse) Error() string { return e.Msg }
+
+// protocol speaks the fastboot wire protocol over a USB bulk handle
+type protocol struct {
+	handle  *usb.Handle
+	chunkKB int
+}
+
+// sendCommand writes a fastboot command, appending its argument after a colon
+func (p *protocol) sendCommand(command, arg string, timeoutMs int) error {
+	if arg != "" {
+		command = command + ":" + arg
+	}
+
+	_, err := p.handle.BulkWrite([]byte(command), timeoutMs)
+
+	return err
+}
+
+// accept reads responses until it sees the expected header, forwarding INFO log
+// lines and turning FAIL into an error
+func (p *protocol) accept(expected string, timeoutMs int) ([]byte, error) {
+	for {
+		response, err := p.handle.BulkRead(65, timeoutMs)
+		if err != nil {
+			return nil, err
+		}
+
+		if len(response) < 4 {
+			continue
+		}
+
+		header, remaining := string(response[:4]), response[4:]
+		switch header {
+		case "INFO":
+			continue
+
+		case "OKAY", "DATA":
+			if header != expected {
+				return nil, &StateMismatch{Expected: expected, Got: header}
+			}
+
+			return remaining, nil
+
+		case "FAIL":
+			return nil, &RemoteFailure{Msg: "FAIL: " + string(remaining)}
+		}
+	}
+}
+
+// sendData performs the data phase of a download: the device acknowledges the
+// size with DATA, then the bytes are streamed and an OKAY is awaited
+func (p *protocol) sendData(r io.Reader, sourceLen int64, progress ProgressCallback, timeoutMs int) error {
+	accepted, err := p.accept("DATA", timeoutMs)
+	if err != nil {
+		return err
+	}
+
+	if len(accepted) < 8 {
+		return &InvalidResponse{Msg: fmt.Sprintf("invalid DATA response %q", accepted)}
+	}
+
+	raw, err := hex.DecodeString(string(accepted[:8]))
+	if err != nil || len(raw) < 4 {
+		return &InvalidResponse{Msg: fmt.Sprintf("invalid DATA response %q", accepted)}
+	}
+
+	if acceptedSize := int64(binary.BigEndian.Uint32(raw[:4])); acceptedSize != sourceLen {
+		return &TransferError{Msg: fmt.Sprintf("device refused to download %d bytes (accepts %d)", sourceLen, acceptedSize)}
+	}
+
+	if err := p.writeData(r, sourceLen, progress, timeoutMs); err != nil {
+		return err
+	}
+
+	_, err = p.accept("OKAY", timeoutMs)
+
+	return err
+}
+
+// writeData streams the image in fixed-size chunks, reporting progress after each
+func (p *protocol) writeData(r io.Reader, length int64, progress ProgressCallback, timeoutMs int) error {
+	chunk := int64(p.chunkKB) * 1024
+
+	var sent int64
+	for remaining := length; remaining > 0; {
+		n := chunk
+		if remaining < n {
+			n = remaining
+		}
+
+		buf := make([]byte, n)
+		if _, err := io.ReadFull(r, buf); err != nil {
+			return err
+		}
+
+		if _, err := p.handle.BulkWrite(buf, timeoutMs); err != nil {
+			return err
+		}
+
+		remaining -= n
+		sent += n
+
+		if progress != nil {
+			progress(sent, length)
+		}
+	}
+
+	return nil
+}
+
+// maxDownloadSize asks the device how many bytes it accepts per download, falling
+// back to the conventional default if it does not answer with a usable value
+func (p *protocol) maxDownloadSize() int64 {
+	if err := p.sendCommand("getvar", "max-download-size", commandTimeoutMs); err != nil {
+		return defaultMaxDownloadSize
+	}
+
+	value, err := p.accept("OKAY", commandTimeoutMs)
+	if err != nil {
+		return defaultMaxDownloadSize
+	}
+
+	// The device reports the size as bare hex, sometimes with an 0x prefix
+	n, err := strconv.ParseInt(strings.TrimPrefix(strings.TrimSpace(string(value)), "0x"), 16, 64)
+	if err != nil || n <= 0 {
+		return defaultMaxDownloadSize
+	}
+
+	if n > maxDownloadSize {
+		n = maxDownloadSize
+	}
+
+	return n
+}
+
+// Flash downloads sourceFile to the device at portPath, flashes it to partition
+// and optionally reboots. progress may be nil. Images larger than the device's
+// max-download-size need sparse or gzip splitting, which is not implemented yet,
+// so they are rejected up front rather than left to stall mid-transfer.
+func Flash(portPath []int, partition, sourceFile string, reboot bool, progress ProgressCallback) error {
+	info, err := os.Stat(sourceFile)
+	if err != nil {
+		return err
+	}
+	size := info.Size()
+
+	handle, err := usb.FindAndOpen(DeviceIsAvailable, portPath, "", connectTimeoutMs)
+	if err != nil {
+		return err
+	}
+	defer handle.Close()
+
+	p := &protocol{handle: handle, chunkKB: protocolChunkKB}
+
+	if limit := p.maxDownloadSize(); size > limit {
+		return fmt.Errorf("file is %d bytes but the device only accepts %d bytes per download, and sparse/gzip splitting is not implemented yet", size, limit)
+	}
+
+	f, err := os.Open(sourceFile)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+
+	if err := p.sendCommand("download", fmt.Sprintf("%08x", size), flashTimeoutMs); err != nil {
+		return err
+	}
+
+	if err := p.sendData(f, size, progress, flashTimeoutMs); err != nil {
+		return err
+	}
+
+	if err := p.sendCommand("flash", partition, flashTimeoutMs); err != nil {
+		return err
+	}
+
+	if _, err := p.accept("OKAY", flashTimeoutMs); err != nil {
+		return err
+	}
+
+	if reboot {
+		if err := p.sendCommand("reboot", "", commandTimeoutMs); err != nil {
+			return err
+		}
+
+		if _, err := p.accept("OKAY", commandTimeoutMs); err != nil {
+			return err
+		}
+	}
+
+	return nil
+}
