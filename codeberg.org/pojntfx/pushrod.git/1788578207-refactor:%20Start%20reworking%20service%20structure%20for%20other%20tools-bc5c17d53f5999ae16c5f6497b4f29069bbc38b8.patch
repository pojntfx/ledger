From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Fri, 04 Sep 2026 20:16:47 -0700
Subject: [PATCH] refactor: Start reworking service structure for other tools

Signed-off-by: Felicitas Pojtinger <felicitas@pojtinger.com>
---
diff --git a/main.go b/main.go
index b37c4a87ab133ad87ff44cce282b6820545cafeb..384ef0d9db2b8bbf92325c52d6b0b5944089947a 100644
--- a/main.go
+++ b/main.go
@@ -12,7 +12,7 @@ 	"os/signal"
 	"syscall"
 	"time"
 
-	"codeberg.org/pojntfx/pushrod/pkg/relay"
+	"codeberg.org/pojntfx/pushrod/pkg/svc"
 	"github.com/modelcontextprotocol/go-sdk/mcp"
 )
 
@@ -24,7 +24,7 @@
 	ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
 	defer cancel()
 
-	service := relay.NewService(ctx, time.Second*10, time.Minute, time.Second*5)
+	service := svc.NewService(ctx, time.Second*10, time.Minute, time.Second*5)
 
 	handler := mcp.NewServer(
 		&mcp.Implementation{
@@ -36,11 +36,11 @@ 			WebsiteURL:  "https://codeberg.org/pojntfx/pushrod",
 		},
 		nil,
 	)
-	mcp.AddTool(handler, relay.GetBoardsTool, service.GetBoards)
-	mcp.AddTool(handler, relay.GetStatusesTool, service.GetStatuses)
-	mcp.AddTool(handler, relay.SetStatusesTool, service.SetStatuses)
-	mcp.AddTool(handler, relay.EnterFDLTool, service.EnterFDL)
-	mcp.AddTool(handler, relay.ResetTool, service.Reset)
+	mcp.AddTool(handler, svc.GetBoardsTool, service.GetBoards)
+	mcp.AddTool(handler, svc.GetStatusesTool, service.GetStatuses)
+	mcp.AddTool(handler, svc.SetStatusesTool, service.SetStatuses)
+	mcp.AddTool(handler, svc.EnterFDLTool, service.EnterFDL)
+	mcp.AddTool(handler, svc.ResetTool, service.Reset)
 
 	log.Println("Listening on", *laddr)
 
