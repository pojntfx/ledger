index 0000000000000000000000000000000000000000..599448d7307563abcb7062aaa893c759407fe592
--- /dev/null
+++ b/buildroot/qemu/board/rva23-qemu/rootfs-overlay/etc/systemd/system/weston.service
@@ -0,0 +1,13 @@
+[Unit]
+Description=Weston
+After=systemd-udevd.service
+RequiresMountsFor=/run
+
+[Service]
+Type=simple
+Environment=XDG_RUNTIME_DIR=/run/weston
+RuntimeDirectory=weston
+ExecStart=/usr/bin/weston --backend=drm-backend.so --shell=desktop-shell.so --renderer=pixman --idle-time=0 --continue-without-input --log=/run/weston/weston.log
+
+[Install]
+WantedBy=graphical.target
