@@ -0,0 +1,17 @@
+#!/bin/sh
+
+set -eu
+
+mkdir -p "${BINARIES_DIR}/efi-part/EFI/Linux"
+"${HOST_DIR}/bin/ukify" build \
+	--linux="${BINARIES_DIR}/Image" \
+	--initrd="${BINARIES_DIR}/rootfs.cpio.gz" \
+	--stub="${TARGET_DIR}/usr/lib/systemd/boot/efi/linuxriscv64.efi.stub" \
+	--efi-arch=riscv64 \
+	--uname=6.18.7 \
+	--cmdline="console=ttyS0,115200 earlycon=sbi" \
+	--os-release=@"${TARGET_DIR}/usr/lib/os-release" \
+	--output="${BINARIES_DIR}/efi-part/EFI/Linux/rva23.efi"
+rm -rf "${BINARIES_DIR}/efi-part/loader"
+truncate -s 32M "${BINARIES_DIR}/RISCV_VIRT_CODE.fd"
+truncate -s 32M "${BINARIES_DIR}/RISCV_VIRT_VARS.fd"
