diff --git a/scripts/verify-boot.py b/scripts/verify-boot.py
new file mode 100755
index 0000000000000000000000000000000000000000..7c1440dccae6887152043f91a5cfc1016ec44bc8
--- /dev/null
+++ b/scripts/verify-boot.py
@@ -0,0 +1,102 @@
+#!/usr/bin/env python3
+import os
+from pathlib import Path
+import re
+import select
+import subprocess
+import sys
+import time
+
+
+class Console:
+    def __init__(self, output):
+        self.output = output
+        self.log = (output / "boot.log").open("wb")
+        self.buffer = b""
+        self.command_id = 0
+        script = output.parent.parent / "board/rva23-qemu/run-qemu.sh"
+        self.process = subprocess.Popen(
+            [script, output / "images"],
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            bufsize=0,
+        )
+
+    def expect(self, pattern, timeout):
+        if isinstance(pattern, bytes):
+            pattern = re.compile(re.escape(pattern))
+        deadline = time.monotonic() + timeout
+        while True:
+            match = pattern.search(self.buffer)
+            if match:
+                self.buffer = self.buffer[match.end():]
+                return match
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                tail = self.buffer[-12000:].decode(errors="replace")
+                raise TimeoutError(f"QEMU console timeout\n{tail}")
+            ready, _, _ = select.select([self.process.stdout], [], [], remaining)
+            if not ready:
+                continue
+            data = os.read(self.process.stdout.fileno(), 65536)
+            if not data:
+                tail = self.buffer[-12000:].decode(errors="replace")
+                raise RuntimeError(f"QEMU exited with {self.process.poll()}\n{tail}")
+            self.log.write(data)
+            self.log.flush()
+            self.buffer += data
+
+    def sendline(self, line):
+        self.process.stdin.write(line.encode() + b"\n")
+        self.process.stdin.flush()
+
+    def command(self, command, timeout=60):
+        self.command_id += 1
+        token = f"__RVA23_RC_{self.command_id}__"
+        self.sendline(f"{command}; printf '\\n{token}:%s\\n' \"$?\"")
+        match = self.expect(re.compile(token.encode() + rb":(\d+)"), timeout)
+        status = int(match.group(1))
+        assert status == 0, f"Guest command failed with {status}: {command}"
+
+    def close(self):
+        if self.process.poll() is None:
+            self.process.terminate()
+            try:
+                self.process.wait(timeout=10)
+            except subprocess.TimeoutExpired:
+                self.process.kill()
+                self.process.wait()
+        self.log.close()
+
+
+def main():
+    output = Path(sys.argv[1]).resolve()
+    console = Console(output)
+    try:
+        console.expect(b"rva23 login:", 300)
+        console.sendline("root")
+        console.expect(b"# ", 30)
+        console.command("systemctl --no-pager --full status graphical.target weston.service || true")
+        console.command("journalctl -b --no-pager -u weston.service || true")
+        console.command("ls -la /run/weston")
+        checks = [
+            ("systemctl is-active --quiet --wait graphical.target", "systemd reaches graphical.target"),
+            ("systemctl is-active --quiet --wait weston.service", "systemd starts Weston"),
+            ("test -S /run/weston/wayland-1", "Weston creates its Wayland socket"),
+            ("XDG_RUNTIME_DIR=/run/weston WAYLAND_DISPLAY=wayland-1 wayland-info >/dev/null", "a Wayland client connects to Weston"),
+            ("test -e /dev/dri/card0", "the guest exposes a DRM device"),
+            ("test -d /sys/module/virtio_gpu", "the DRM device uses virtio graphics"),
+        ]
+        for command, description in checks:
+            console.command(command)
+            print(f"PASS: {description}")
+        console.sendline("poweroff")
+        console.process.wait(timeout=90)
+        print(f"PASS: QEMU shuts down cleanly; console log: {output / 'boot.log'}")
+    finally:
+        console.close()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/verify-image.py b/scripts/verify-image.py
new file mode 100755
index 0000000000000000000000000000000000000000..80d69c12a4253060aebb2bf2e6519d1a2d968215
--- /dev/null
+++ b/scripts/verify-image.py
@@ -0,0 +1,101 @@
+#!/usr/bin/env python3
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+
+def main():
+    output = Path(sys.argv[1]).resolve()
+    download_dir = Path(sys.argv[2]).resolve()
+    ccache_dir = Path(sys.argv[3]).resolve()
+    images = output / "images"
+    config = (output / ".config").read_text().splitlines()
+    required = {
+        "BR2_riscv=y",
+        "BR2_RISCV_64=y",
+        "BR2_INIT_SYSTEMD=y",
+        "BR2_PACKAGE_SYSTEMD=y",
+        "BR2_PACKAGE_SYSTEMD_BOOT=y",
+        'BR2_PACKAGE_SYSTEMD_BOOT_EFI_ARCH="riscv64"',
+        "BR2_CCACHE=y",
+        "BR2_CCACHE_USE_BASEDIR=y",
+        "BR2_TARGET_OPENSBI=y",
+        "BR2_TARGET_EDK2=y",
+        "BR2_PACKAGE_WESTON=y",
+        "BR2_PACKAGE_HOST_QEMU=y",
+    }
+    forbidden = {
+        "BR2_TARGET_GRUB2=y",
+        "BR2_TARGET_GRUB2_RISCV64_EFI=y",
+        "BR2_TARGET_EXTLINUX=y",
+    }
+    assert required <= set(config), sorted(required - set(config))
+    assert not forbidden & set(config), sorted(forbidden & set(config))
+    result = subprocess.run(
+        [
+            "make",
+            "-s",
+            "-C",
+            output,
+            f"BR2_DL_DIR={download_dir}",
+            f"BR2_CCACHE_DIR={ccache_dir}",
+            "printvars",
+            "VARS=BR2_DL_DIR BR2_CCACHE_DIR",
+        ],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    cache_lines = set(result.stdout.splitlines())
+    assert f"BR2_DL_DIR={download_dir}" in cache_lines, result.stdout
+    assert f"BR2_CCACHE_DIR={ccache_dir}" in cache_lines, result.stdout
+    print("PASS: configuration uses RISC-V systemd-boot, shared caches, and no GRUB or extlinux")
+    artifacts = [
+        "fw_dynamic.bin",
+        "RISCV_VIRT_CODE.fd",
+        "RISCV_VIRT_VARS.fd",
+        "Image",
+        "rootfs.cpio.gz",
+        "disk.img",
+        "efi-part.vfat",
+        "efi-part/EFI/BOOT/bootriscv64.efi",
+        "efi-part/EFI/Linux/rva23.efi",
+    ]
+    for name in artifacts:
+        path = images / name
+        assert path.is_file() and path.stat().st_size > 0, path
+    for name in ["RISCV_VIRT_CODE.fd", "RISCV_VIRT_VARS.fd"]:
+        assert (images / name).stat().st_size == 32 * 1024 * 1024, name
+    print("PASS: firmware, kernel, root filesystem, bootloader, UKI, and disk artifacts exist")
+    host_bin = output / "host" / "bin"
+    env = os.environ.copy()
+    env["PATH"] = f"{host_bin}:{env['PATH']}"
+    result = subprocess.run(
+        [host_bin / "ukify", "--json=short", "inspect", images / "efi-part/EFI/Linux/rva23.efi"],
+        check=True,
+        capture_output=True,
+        text=True,
+        env=env,
+    )
+    sections = set(json.loads(result.stdout))
+    assert {".linux", ".initrd", ".osrel", ".cmdline"} <= sections, sections
+    print("PASS: UKI contains kernel, initramfs, OS metadata, and command line sections")
+    result = subprocess.run(
+        [host_bin / "mdir", "-i", images / "efi-part.vfat", "::/EFI/Linux"],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    assert "RVA23" in result.stdout.upper(), result.stdout
+    result = subprocess.run(
+        [host_bin / "mdir", "-i", images / "efi-part.vfat", "::/loader/entries"],
+        capture_output=True,
+    )
+    assert result.returncode != 0, result.stdout
+    print("PASS: ESP contains a Type 2 UKI and no Type 1 entries")
+
+
+if __name__ == "__main__":
+    main()

