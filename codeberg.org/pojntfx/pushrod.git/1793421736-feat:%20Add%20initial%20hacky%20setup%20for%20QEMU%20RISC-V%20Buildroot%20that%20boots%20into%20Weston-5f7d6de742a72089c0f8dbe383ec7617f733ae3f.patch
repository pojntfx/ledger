diff --git a/Makefile b/Makefile
new file mode 100644
index 0000000000000000000000000000000000000000..25779165e8fffce2097e0eef75aa41e1439fc655
--- /dev/null
+++ b/Makefile
@@ -0,0 +1,39 @@
+.SUFFIXES:
+
+THIS_EXTERNAL_PATH := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
+-include $(THIS_EXTERNAL_PATH)/local.mk
+BUILDROOT_DIR ?= $(abspath $(THIS_EXTERNAL_PATH)/../buildroot-k3-clean/buildroot)
+OUTPUT_DIR ?= $(THIS_EXTERNAL_PATH)/output/rva23
+BR2_DL_DIR ?= $(abspath $(THIS_EXTERNAL_PATH)/../buildroot-k3-clean/buildroot/dl)
+BR2_CCACHE_DIR ?= $(abspath $(THIS_EXTERNAL_PATH)/../buildroot-k3-clean/ccache)
+
+MAKE_BUILDROOT = $(MAKE) -C $(BUILDROOT_DIR) O=$(OUTPUT_DIR) BR2_EXTERNAL=$(THIS_EXTERNAL_PATH) BR2_DL_DIR=$(BR2_DL_DIR) BR2_CCACHE_DIR=$(BR2_CCACHE_DIR)
+BUILDROOT_PATCH = $(THIS_EXTERNAL_PATH)/patches/buildroot/0001-Enable-systemd-boot-on-64-bit-RISC-V.patch
+
+.PHONY: all configure build clean verify verify-image verify-boot boot boot-display
+
+all: build
+
+configure:
+	git -C $(BUILDROOT_DIR) apply --reverse --check $(BUILDROOT_PATCH)
+	$(MAKE_BUILDROOT) rva23_defconfig
+
+build: configure
+	$(MAKE_BUILDROOT)
+
+clean:
+	$(MAKE_BUILDROOT) clean
+
+verify-image: build
+	python3 scripts/verify-image.py $(OUTPUT_DIR) $(BR2_DL_DIR) $(BR2_CCACHE_DIR)
+
+verify-boot: build
+	python3 scripts/verify-boot.py $(OUTPUT_DIR)
+
+verify: verify-image verify-boot
+
+boot: build
+	$(THIS_EXTERNAL_PATH)/board/rva23-qemu/run-qemu.sh $(OUTPUT_DIR)/images
+
+boot-display: build
+	QEMU_VNC=1 $(THIS_EXTERNAL_PATH)/board/rva23-qemu/run-qemu.sh $(OUTPUT_DIR)/images
diff --git a/README.md b/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..49c073ede232bebda9615fee7ec2cfccee5684b6
--- /dev/null
+++ b/README.md
@@ -0,0 +1,55 @@
+# RVA23 QEMU Buildroot
+
+## Start
+
+If the shared Buildroot checkout lacks the RISC-V patch, apply it:
+
+```sh
+git -C /home/pojntfx/Projets/buildroot-k3-clean/buildroot apply /home/pojntfx/Projets/buildroot-qemu/patches/buildroot/0001-Enable-systemd-boot-on-64-bit-RISC-V.patch
+```
+
+Copy the local configuration, then build and test:
+
+```sh
+cp local.mk.tpl local.mk
+make configure
+make build
+make verify
+```
+
+## Develop
+
+Run `make clean` before a clean rebuild. If `BR2_DL_DIR` is shared, do not run `distclean`, because it removes that directory.
+
+Save a minimal defconfig after configuration changes:
+
+```sh
+make -C output/rva23 savedefconfig BR2_DEFCONFIG=$PWD/configs/rva23_defconfig
+```
+
+Run individual acceptance tests:
+
+```sh
+make verify-image
+make verify-boot
+```
+
+## Run
+
+Use the serial console:
+
+```sh
+make boot
+```
+
+Use the graphical console:
+
+```sh
+make boot-display
+```
+
+Connect a VNC client:
+
+```sh
+vncviewer 127.0.0.1:5900
+```
