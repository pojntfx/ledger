diff --git a/board/rva23-qemu/run-qemu.sh b/board/rva23-qemu/run-qemu.sh
new file mode 100755
index 0000000000000000000000000000000000000000..4b58c378b53d64051c91d549837e1f23a4bb619c
--- /dev/null
+++ b/board/rva23-qemu/run-qemu.sh
@@ -0,0 +1,29 @@
+#!/bin/sh
+
+set -eu
+
+IMAGES_DIR=$(realpath "${1}")
+QEMU=${QEMU:-"${IMAGES_DIR}/../host/bin/qemu-system-riscv64"}
+
+if [ "${QEMU_VNC:-0}" = 1 ]; then
+	set -- -vnc 127.0.0.1:0
+else
+	set -- -display none
+fi
+
+exec "${QEMU}" \
+	-M virt,pflash0=pflash0,pflash1=pflash1,acpi=off \
+	-accel tcg \
+	-cpu rva23s64 \
+	-smp 4 \
+	-m 2048 \
+	-bios "${IMAGES_DIR}/fw_dynamic.bin" \
+	-blockdev node-name=pflash0,driver=file,read-only=on,filename="${IMAGES_DIR}/RISCV_VIRT_CODE.fd" \
+	-blockdev node-name=pflash1,driver=file,filename="${IMAGES_DIR}/RISCV_VIRT_VARS.fd" \
+	-drive file="${IMAGES_DIR}/disk.img",format=raw,if=virtio \
+	-device virtio-gpu-pci \
+	-device qemu-xhci \
+	-device usb-kbd \
+	-device usb-tablet \
+	"$@" \
+	-serial stdio
