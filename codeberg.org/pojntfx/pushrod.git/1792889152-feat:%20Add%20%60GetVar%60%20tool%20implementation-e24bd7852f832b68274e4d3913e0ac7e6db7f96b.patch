diff --git a/pkg/fastboot/commands.go b/pkg/fastboot/commands.go
new file mode 100644
index 0000000000000000000000000000000000000000..384a83be8afef3e0a276f4b7953834544e4e7190
--- /dev/null
+++ b/pkg/fastboot/commands.go
@@ -0,0 +1,49 @@
+package fastboot
+
+import (
+	"context"
+	"time"
+)
+
+const commandTimeout = 10 * time.Second
+
+func (s *Session) GetVar(ctx context.Context, variable string) (string, error) {
+	if s.protocol == nil {
+		return "", ErrSessionClosed
+	}
+
+	ctx, cancel := context.WithTimeout(ctx, commandTimeout)
+	defer cancel()
+
+	if err := s.protocol.writeCommand(ctx, "getvar:"+variable); err != nil {
+		return "", err
+	}
+
+	value := ""
+	for {
+		r, err := s.protocol.readResponse(ctx)
+		if err != nil {
+			return "", err
+		}
+
+		switch r.status {
+		case statusInfo:
+			if r.payload != "" {
+				value = r.payload
+			}
+
+		case statusOKAY:
+			if r.payload != "" {
+				value = r.payload
+			}
+
+			return value, nil
+
+		case statusFail:
+			return "", errCommandFailed
+
+		default:
+			return "", errUnexpectedResponse
+		}
+	}
+}
