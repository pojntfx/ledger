diff --git a/pkg/svc/flash_get_var.go b/pkg/svc/flash_get_var.go
new file mode 100644
index 0000000000000000000000000000000000000000..5d1e441926d3b4c581e4c9b1134c93591ef1cb8b
--- /dev/null
+++ b/pkg/svc/flash_get_var.go
@@ -0,0 +1,50 @@
+package svc
+
+import (
+	"context"
+
+	"codeberg.org/pojntfx/pushrod/pkg/fastboot"
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+var (
+	GetVarTool = &mcp.Tool{
+		Name:        "flash.getVar",
+		Title:       "Get fastboot variable",
+		Description: "Get the value of a fastboot variable from a device",
+		Annotations: &mcp.ToolAnnotations{ReadOnlyHint: true},
+	}
+)
+
+type GetVarInput struct {
+	Path     string `json:"path" jsonschema:"path that uniquely identifies the fastboot device until it gets unplugged, in BUS-PORT form like 1-2-3"`
+	Variable string `json:"variable" jsonschema:"fastboot variable to read, like mtd-size, blk-size or max-download-size"`
+}
+
+type GetVarOutput struct {
+	Variable string `json:"variable" jsonschema:"fastboot variable that was read"`
+	Value    string `json:"value" jsonschema:"value that the device reported for the variable"`
+}
+
+func (s *Service) GetVar(ctx context.Context, req *mcp.CallToolRequest, input GetVarInput) (*mcp.CallToolResult, *GetVarOutput, error) {
+	if err := s.flashLock.Acquire(ctx, 1); err != nil {
+		return nil, nil, err
+	}
+	defer s.flashLock.Release(1)
+
+	session, err := fastboot.OpenSession(input.Path)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer session.Close()
+
+	value, err := session.GetVar(ctx, input.Variable)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	return nil, &GetVarOutput{
+		Variable: input.Variable,
+		Value:    value,
+	}, nil
+}
