diff --git a/buildroot/scripts/verify-cluster.py b/buildroot/scripts/verify-cluster.py
new file mode 100644
index 0000000000000000000000000000000000000000..ea8aaf43afd403e85e565e5994a3ab33dadc4bf7
--- /dev/null
+++ b/buildroot/scripts/verify-cluster.py
@@ -0,0 +1,201 @@
+#!/usr/bin/env python3
+import json
+import os
+from pathlib import Path
+import re
+import socket
+import subprocess
+import sys
+import threading
+import time
+
+from verify_boot import Console
+
+
+class K3:
+    def __init__(self):
+        self.host = os.environ.get("K3_SSH", "")
+        if self.host and not self.host.startswith("root@"):
+            self.host = f"root@{self.host}"
+        self.key = Path(os.environ.get("K3_SSH_KEY", "output/k3-uefi/build/k3-keys/root_ed25519"))
+
+    def command(self, command, timeout=300):
+        if not self.host:
+            raise ValueError("Set K3_SSH to the board address")
+        result = subprocess.run(
+            ["ssh", "-6", "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=10", "-i", str(self.key), self.host, command],
+            check=True,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+        return result.stdout
+
+    def host_part(self):
+        user, _, address = self.host.partition("@")
+        return f"{user}@[{address}]"
+
+    def upload_file(self, source, destination):
+        subprocess.run(
+            ["scp", "-6", "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=10", "-i", str(self.key), str(source), f"{self.host_part()}:{destination}"],
+            check=True,
+            capture_output=True,
+            timeout=300,
+        )
+
+    def download(self, source, destination):
+        subprocess.run(
+            ["scp", "-6", "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=10", "-i", str(self.key), f"{self.host_part()}:{source}", str(destination)],
+            check=True,
+            capture_output=True,
+            timeout=600,
+        )
+
+
+def interface(k3):
+    if "%" in k3.host:
+        return k3.host.split("%", 1)[1]
+    return "wlp0s20f3"
+
+
+def host_ip(k3):
+    output = subprocess.run(["ip", "-4", "-o", "addr", "show", "dev", interface(k3)], capture_output=True, text=True, check=True).stdout
+    match = re.search(r"inet (\d+\.\d+\.\d+\.\d+)", output)
+    return match.group(1)
+
+
+def board_ip(k3):
+    return k3.command("ip -4 -o addr show dev wlP4p1s0 | awk '{print $4}' | cut -d/ -f1 | head -1").strip()
+
+
+def resp(host, port, timeout=8):
+    sock = socket.create_connection((host, port), timeout=timeout)
+    try:
+        sock.sendall(b"PING\r\n")
+        if b"+PONG" not in sock.recv(100):
+            raise RuntimeError(f"no PONG from {host}:{port}")
+        sock.sendall(b"SET cluster:demo ok\r\n")
+        if b"+OK" not in sock.recv(100):
+            raise RuntimeError(f"SET failed on {host}:{port}")
+        sock.sendall(b"GET cluster:demo\r\n")
+        if b"ok" not in sock.recv(100):
+            raise RuntimeError(f"GET failed on {host}:{port}")
+    finally:
+        sock.close()
+
+
+def main():
+    output = Path(sys.argv[1] if len(sys.argv) > 1 else "output/rva23").resolve()
+    k3 = K3()
+    zone = interface(k3)
+    host = host_ip(k3)
+    board = board_ip(k3)
+    state = k3.command("systemctl is-active rva23-k3s-demo || true").strip()
+    if state != "active":
+        k3.command("systemctl reset-failed rva23-k3s-demo 2>/dev/null || true")
+        k3.command("systemctl stop rva23-k3s-demo 2>/dev/null || true")
+        k3.command("systemd-run --unit=rva23-k3s-demo --property=Type=simple k3s server --disable=metrics-server --disable=traefik --data-dir=/var/lib/k3s-demo --write-kubeconfig-mode=0644")
+        time.sleep(15)
+    token = ""
+    for _ in range(60):
+        token = k3.command("cat /var/lib/k3s-demo/server/node-token 2>/dev/null || true").strip()
+        if token:
+            break
+        time.sleep(2)
+    if not token:
+        raise RuntimeError("the k3s server did not write a node token")
+    server_url = f"https://{board}:6443"
+    k3_output = Path(__file__).resolve().parents[1] / "output" / "k3-uefi"
+    subprocess.run([sys.executable, str(Path(__file__).with_name("verify-valkey.py")), str(k3_output)], check=True)
+    k3.download("/tmp/valkey-local.tar", "/tmp/cluster-valkey.tar")
+    k3.download("/tmp/pause-image.tar", "/tmp/cluster-pause.tar")
+    http = subprocess.Popen([sys.executable, "-m", "http.server", "18000", "--bind", "127.0.0.1", "--directory", "/tmp"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    relays = [
+        subprocess.Popen(["socat", "UDP4-LISTEN:8472,fork,reuseaddr", "UDP4:127.0.0.1:18472"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL),
+        subprocess.Popen(["socat", "TCP4-LISTEN:10250,fork,reuseaddr", "TCP4:127.0.0.1:12500"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL),
+    ]
+    os.environ["RVA23_EXTRA_HOSTFWD"] = "udp:127.0.0.1:18472-:8472 tcp:127.0.0.1:12500-:10250 tcp:127.0.0.1:16390-:6390"
+    console = Console(output, "cluster.log")
+    try:
+        console.expect(b"rva23 login:", 1800)
+        console.sendline("root")
+        console.expect(b"# ", 120)
+        console.command("systemctl is-active --quiet --wait graphical.target")
+        console.command("systemd-sysext status | grep -q k3s_")
+        console.command("k3s --version")
+        console.command("profile=$(ls /boot/EFI/Linux/rva23-debug_*.efi | sort -V | tail -n1); bootctl set-default \"$(basename \"$profile\")\"")
+        console.sendline("reboot")
+        console.expect(b"rva23 login:", 1800)
+        console.sendline("root")
+        console.expect(b"# ", 120)
+        console.command("systemctl is-active --quiet --wait graphical.target")
+        console.command("grep -q ipe.enforce=0 /proc/cmdline")
+        console.command("wget -q -O /tmp/valkey-local.tar http://10.0.2.2:18000/cluster-valkey.tar", 300)
+        console.command("wget -q -O /tmp/pause-image.tar http://10.0.2.2:18000/cluster-pause.tar", 120)
+        console.command(f"systemd-run --unit=rva23-k3s-agent --property=Type=simple k3s agent --server {server_url} --token {token} --node-ip {host} --node-external-ip {host} --data-dir=/var/lib/k3s-agent", 120)
+        console.sendline("for i in $(seq 1 120); do [ -S /run/k3s/containerd/containerd.sock ] && break; sleep 1; done")
+        console.expect(b"# ", 180)
+        console.command("k3s ctr -n k8s.io images import /tmp/valkey-local.tar >/dev/null 2>&1; k3s ctr -n k8s.io images tag localhost/valkey-local:latest docker.io/library/valkey-local:latest", 300)
+        console.command("k3s ctr -n k8s.io images import /tmp/pause-image.tar >/dev/null 2>&1", 120)
+        deadline = time.time() + 300
+        nodes = ""
+        while time.time() < deadline:
+            nodes = k3.command("kubectl --kubeconfig=/var/lib/k3s-demo/server/cred/admin.kubeconfig get nodes 2>/dev/null || true")
+            if nodes.count(" Ready ") >= 2:
+                break
+            time.sleep(5)
+        if nodes.count(" Ready ") < 2:
+            raise RuntimeError(f"nodes did not join: {nodes}")
+        print(nodes)
+        manifest = {
+            "apiVersion": "apps/v1",
+            "kind": "DaemonSet",
