new file mode 100644
index 0000000000000000000000000000000000000000..5f341a89b0dcabb627b0a4f967318a2f60e3051d
--- /dev/null
+++ b/buildroot/scripts/verify-valkey.py
@@ -0,0 +1,213 @@
+#!/usr/bin/env python3
+import json
+import os
+from pathlib import Path
+import socket
+import subprocess
+import sys
+import time
+
+
+VALKEY_VERSION = "8.1.0"
+VALKEY_SOURCE = Path(f"/tmp/valkey-{VALKEY_VERSION}")
+
+
+class K3:
+    def __init__(self, output):
+        self.output = output
+        self.host = os.environ.get("K3_SSH", "")
+        if self.host and not self.host.startswith("root@"):
+            self.host = f"root@{self.host}"
+        self.key = Path(os.environ.get("K3_SSH_KEY", output / "build/k3-keys/root_ed25519"))
+
+    def command(self, command, timeout=300):
+        if not self.host:
+            raise ValueError("Set K3_SSH to the board address, for example root@fe80::1%wlan0")
+        result = subprocess.run(
+            ["ssh", "-6", "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=10", "-i", str(self.key), self.host, command],
+            check=True,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+        return result.stdout
+
+    def host_part(self):
+        user, _, address = self.host.partition("@")
+        return f"{user}@[{address}]"
+
+    def upload(self, source, destination):
+        subprocess.run(
+            ["scp", "-6", "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=10", "-i", str(self.key), str(source), f"{self.host_part()}:{destination}"],
+            check=True,
+            capture_output=True,
+            timeout=300,
+        )
+
+
+def host_address(k3):
+    output = k3.command("ip -4 -o addr show dev wlP4p1s0 | awk '{print $4}' | cut -d/ -f1 | head -1")
+    return output.strip()
+
+
+def zone(k3):
+    output = k3.command("ip -6 -o addr show dev wlP4p1s0 | awk '{print $4}' | cut -d/ -f1 | head -1")
+    address = output.strip()
+    if not address:
+        raise RuntimeError("no IPv6 address on wlP4p1s0")
+    return address
+
+
+def host_interface(k3):
+    if "%" in k3.host:
+        return k3.host.split("%", 1)[1]
+    return os.environ.get("K3_ZONE", "wlp0s20f3")
+
+
+def valkey_source(output):
+    host = output / "host"
+    if not host.is_dir():
+        host = Path(os.environ.get("K3_HOST_DIR", "/home/pojntfx/Projets/pushrod/buildroot/output/k3-uefi/host"))
+    compiler = host / "bin" / "riscv64-buildroot-linux-gnu-gcc"
+    if not compiler.is_file():
+        raise RuntimeError(f"missing cross compiler: {compiler}")
+    if not (VALKEY_SOURCE / "src" / "valkey-server").is_file():
+        archive = Path(f"/tmp/valkey-{VALKEY_VERSION}.tar.gz")
+        if not archive.is_file():
+            subprocess.run(["curl", "-sL", "-o", str(archive), f"https://github.com/valkey-io/valkey/archive/refs/tags/{VALKEY_VERSION}.tar.gz"], check=True, timeout=300)
+        subprocess.run(["tar", "-xzf", str(archive), "-C", "/tmp"], check=True)
+        zmalloc = VALKEY_SOURCE / "src" / "zmalloc.c"
+        text = zmalloc.read_text()
+        if "defined(__riscv)" not in text:
+            zmalloc.write_text(text.replace("    defined(__arm64__)\n", "    defined(__arm64__) || defined(__riscv)\n", 1))
+        subprocess.run(
+            ["make", "-C", str(VALKEY_SOURCE / "src"), f"CC={compiler}", "MALLOC=libc", "BUILD_TLS=no", "USE_SYSTEMD=no", "-j8"],
+            check=True,
+            capture_output=True,
+            text=True,
+            timeout=900,
+        )
+    return VALKEY_SOURCE / "src" / "valkey-server"
+
+
+def rootfs_tar(output, binary):
+    directory = Path("/tmp/valkey-rootfs")
+    subprocess.run(["rm", "-rf", str(directory)], check=True)
+    subprocess.run(["mkdir", "-p", str(directory / "lib"), str(directory / "etc"), str(directory / "data")], check=True)
+    subprocess.run(["cp", str(binary), str(directory / "valkey-server")], check=True)
+    for name in ("ld-linux-riscv64-lp64d.so.1", "libc.so.6", "libm.so.6"):
+        subprocess.run(["cp", str(output / "target" / "lib" / name), str(directory / "lib" / name)], check=True)
+    (directory / "etc" / "valkey.conf").write_text("bind * -::*\nprotected-mode no\nport 6379\ndir /data\nsave 60 1\nappendonly no\n")
+    tar = Path("/tmp/valkey-rootfs.tar")
+    subprocess.run(["tar", "-C", str(directory), "-cf", str(tar), "."], check=True)
+    return tar
+
+
+def pause_tar():
+    source = Path("/tmp/pause.c")
+    source.write_text(
+        "struct timespec { long tv_sec; long tv_nsec; };\n"
+        "static struct timespec ts = {3600, 0};\n"
+        "void _start(void) {\n"
+        "    register long a7 asm(\"a7\") = 101;\n"
+        "    register long a0 asm(\"a0\") = (long)&ts;\n"
+        "    register long a1 asm(\"a1\") = 0;\n"
