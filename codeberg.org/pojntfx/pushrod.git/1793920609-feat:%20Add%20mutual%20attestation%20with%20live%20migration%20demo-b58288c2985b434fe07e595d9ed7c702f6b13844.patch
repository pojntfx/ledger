+func (fixture *mutualTestFixture) authorize(t *testing.T, binding migration.OperationBinding) (migration.MutualGrant, migration.MutualOperationRequest) {
+	t.Helper()
+	challenge := fixture.issueChallenge(t, binding)
+	key, device := fixture.identity(binding.Role)
+	input := fixture.buildOperation(t, challenge, key, device)
+	body := fixture.sendOperation(t, input, http.StatusOK)
+	var grant migration.MutualGrant
+	if err := json.Unmarshal(body, &grant); err != nil {
+		t.Fatal(err)
+	}
+	if grant.Status != "accepted" || grant.Binding != binding {
+		t.Fatalf("unexpected grant %+v", grant)
