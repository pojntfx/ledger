diff --git a/buildroot/qemu/scripts/verify-mutual-migration.py b/buildroot/qemu/scripts/verify-mutual-migration.py
new file mode 100644
index 0000000000000000000000000000000000000000..baa681b3b66a3b17c1f6354f3ba12d68aab45abc
--- /dev/null
+++ b/buildroot/qemu/scripts/verify-mutual-migration.py
@@ -0,0 +1,299 @@
+#!/usr/bin/env python3
+import base64
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import socket
+import subprocess
+import sys
+import time
+import urllib.request
+
+from verify_boot import Console
+
+
+migration_spec = importlib.util.spec_from_file_location("migration_test", Path(__file__).with_name("verify-migration.py"))
+migration_test = importlib.util.module_from_spec(migration_spec)
+migration_spec.loader.exec_module(migration_test)
+copy_disk = migration_test.copy_disk
+copy_guest_file = migration_test.copy_guest_file
+read_state = migration_test.read_state
+wait_http = migration_test.wait_http
+
+spec = importlib.util.spec_from_file_location("wallet", Path(__file__).with_name("verify-wallet.py"))
+wallet = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(wallet)
+predict_profile = wallet.predict_profile
+create_fido2 = wallet.create_fido2
+
+
+def login(console):
+    console.expect(b"rva23 login:", 1800)
+    console.sendline("root")
+    console.expect(b"# ", 30)
+    console.command("systemctl is-active --quiet --wait graphical.target")
+    console.command("systemctl start systemd-pcrlock.socket")
+    console.command("systemctl restart systemd-report-sign-tpm2.socket")
+    console.command("sleep 2")
+
+
+def put_guest_file(console, source, destination):
+    encoded = base64.b64encode(Path(source).read_bytes()).decode()
+    console.command(f"mkdir -p $(dirname {destination}); : > {destination}")
+    for offset in range(0, len(encoded), 160):
+        chunk = encoded[offset:offset + 160]
+        console.command(f"printf '%s' '{chunk}' >> {destination}")
+    console.command(f"base64 -d {destination} > {destination}.decoded; mv {destination}.decoded {destination}; chmod 600 {destination}", 120)
+
+
+def prepare_images(output):
+    images = output / "images"
+    directory = output / "mutual-migration"
+    if directory.exists():
+        shutil.rmtree(directory)
+    directory.mkdir()
+    environment = os.environ.copy()
+    environment.update({
+        "BINARIES_DIR": str(images), "TARGET_DIR": str(output / "target"),
+        "HOST_DIR": str(output / "host"), "RVA23_KEY_DIR": str(Path("../buildroot-qemu-keys").resolve()),
+        "RVA23_BOOT_DEVICE_TIMEOUT": "300",
+    })
+    with (directory / "build.log").open("w") as log:
+        subprocess.run(["python3", "scripts/build-os-images.py"], check=True, env=environment, stdout=log, stderr=subprocess.STDOUT)
+    subprocess.run([
+        output / "host/bin/genimage", "--rootpath", output / "target", "--inputpath", images,
+        "--outputpath", images, "--config", Path("board/rva23-qemu/genimage.cfg").resolve(),
+    ], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    environment = os.environ.copy()
+    environment["BINARIES_DIR"] = str(images)
+    subprocess.run(["python3", "scripts/finalize-disk.py"], check=True, env=environment, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    loader = directory / "loader.conf"
+    loader.write_text("default rva23-debug_1.efi\ntimeout 0\neditor no\n")
+    subprocess.run([output / "host/bin/mcopy", "-o", "-i", images / "efi-part.vfat", loader, "::/loader/loader.conf"], check=True)
+    initial = output / "build/edk2-edk2-stable202602/Build/RiscVVirtQemu/RELEASE_GCC5/FV/RISCV_VIRT_VARS.fd"
+    variables = images / "RISCV_VIRT_VARS.fd"
+    shutil.copyfile(initial, variables)
+    variables.write_bytes(variables.read_bytes().ljust(32 * 1024 * 1024, b"\0"))
+    for name in ("server", "source", "destination"):
+        copy_disk(images / "disk.img", directory / f"{name}.img")
+        shutil.copyfile(variables, directory / f"{name}-vars.fd")
+        create_fido2(directory / f"{name}-u2f")
+    return directory
+
+
+def vm_console(output, name, host_port, network_port, server=False, destination_network_port=None):
+    directory = output / "mutual-migration"
+    os.environ["RVA23_DISK"] = str(directory / f"{name}.img")
+    os.environ["RVA23_EDK2_VARS"] = str(directory / f"{name}-vars.fd")
+    os.environ["RVA23_TPM_STATE"] = str(directory / f"{name}-swtpm")
+    os.environ["RVA23_QEMU_MONITOR"] = str(directory / f"{name}-monitor.sock")
+    os.environ["QEMU"] = str(output / "build/host-qemu-11.0.0/build/qemu-system-riscv64")
+    os.environ.pop("RVA23_UI_HOST_PORT", None)
+    os.environ.pop("RVA23_SERVER_UI_HOST_PORT", None)
+    os.environ.pop("RVA23_MUTUAL_NET_LISTEN", None)
+    os.environ.pop("RVA23_MUTUAL_NET_LISTEN_DESTINATION", None)
+    os.environ.pop("RVA23_MUTUAL_NET_CONNECT", None)
+    if server:
+        os.environ["RVA23_SERVER_UI_HOST_PORT"] = str(host_port)
+        os.environ["RVA23_MUTUAL_NET_LISTEN"] = str(network_port)
+        os.environ["RVA23_MUTUAL_NET_LISTEN_DESTINATION"] = str(destination_network_port)
+        os.environ["RVA23_MUTUAL_MAC"] = "52:54:00:00:00:11"
+        os.environ["RVA23_MUTUAL_MAC_DESTINATION"] = "52:54:00:00:00:12"
+        os.environ.pop("RVA23_FIDO2_DIR", None)
+    else:
+        os.environ["RVA23_UI_HOST_PORT"] = str(host_port)
+        os.environ["RVA23_MUTUAL_NET_CONNECT"] = str(network_port)
+        os.environ["RVA23_MUTUAL_MAC"] = "52:54:00:00:00:20" if name == "source" else "52:54:00:00:00:30"
+        os.environ["RVA23_FIDO2_DIR"] = str(directory / f"{name}-u2f")
+    return Console(output, f"mutual-migration-{name}.log", firmware=True)
+
+
+def enroll(console, output, name, production=False):
+    login(console)
+    console.command("/usr/libexec/rva23-report-provision", 300)
+    console.command("tpm2_readpublic -c /var/lib/systemd/report.sign.tpm2/ak.ctx -f pem -o /tmp/ak-public.pem")
+    copy_guest_file(console, "/tmp/ak-public.pem", output / "mutual-migration" / f"{name}-ak-public.pem")
+    if production:
+        console.command("bootctl set-default rva23_1+3-0.efi")
+        console.sendline("reboot")
+        login(console)
+    else:
+        console.command("bootctl set-default rva23-debug_1.efi")
+        console.sendline("reboot")
+        login(console)
+        console.command("criu check", 300)
+
+
+def initialize_guest(console, output, name, production, resume):
+    if resume:
+        login(console)
+    else:
+        enroll(console, output, name, production=production)
+
+
+def configure_link(console, mac, address):
+    command = f"iface=; for path in /sys/class/net/*; do if [ \"$(cat $path/address)\" = '{mac}' ]; then iface=$(basename $path); fi; done; test -n \"$iface\"; ip link set dev \"$iface\" up; ip addr replace {address}/24 dev \"$iface\""
+    console.command(command, 120)
+    console.command(f"ip addr show | grep -q '{address}/24'")
+
+
+def configure_network(console, name):
+    if name == "server":
+        configure_link(console, "52:54:00:00:00:11", "192.0.2.10")
+        configure_link(console, "52:54:00:00:00:12", "192.0.3.10")
+    elif name == "source":
+        configure_link(console, "52:54:00:00:00:20", "192.0.2.20")
+    else:
+        configure_link(console, "52:54:00:00:00:30", "192.0.3.30")
+
+
+def install_identities(server, source, destination, output):
+    directory = output / "mutual-migration"
+    for guest in (server, source, destination):
+        put_guest_file(guest, directory / "server-ak-public.pem", "/var/lib/rva23-mutual/server-ak-public.pem")
+    for name in ("server", "source", "destination"):
+        put_guest_file(server, directory / f"{name}-ak-public.pem", f"/var/lib/rva23-mutual/{name}-ak-public.pem")
+    for name in ("source", "destination"):
+        put_guest_file(server, directory / f"{name}-u2f/certificate.pem", f"/var/lib/rva23-mutual/{name}-u2f-certificate.pem")
+
+
+def start_workload(console):
+    output = console.capture("mutual-migration-client serve </dev/null >/tmp/mutual-migration-client.log 2>&1 & printf '%s\\n' $!")
+    match = re.search(r"(?:^|\r?\n)(\d+)\r?\n", output)
+    assert match, output[-2000:]
+    wait_http("http://127.0.0.1:18086/api/state")
+    return int(match.group(1))
+
+
+def free_port():
+    with socket.socket() as listener:
+        listener.bind(("127.0.0.1", 0))
+        return listener.getsockname()[1]
+
+
+def run_focused_tests(output):
+    directory = output / "mutual-migration"
+    directory.mkdir(exist_ok=True)
+    with (directory / "protocol-tests.log").open("w") as log:
+        subprocess.run(["go", "test", "-count=1", "-v", "./attestation"], check=True, cwd="scripts", stdout=log, stderr=subprocess.STDOUT)
+        subprocess.run(["go", "test", "-count=1", "-v", "report-receiver.go", "report-receiver_test.go"], check=True, cwd="scripts", stdout=log, stderr=subprocess.STDOUT)
+        subprocess.run(["go", "test", "-count=1", "-v", "wallet-server.go", "wallet-server_test.go"], check=True, cwd="scripts", stdout=log, stderr=subprocess.STDOUT)
+        subprocess.run(["go", "test", "-count=1", "-v", "./..."], check=True, cwd="scripts/migration", stdout=log, stderr=subprocess.STDOUT)
+    subprocess.run(["go", "build", "-o", directory / "mutual-migration-server-host", "./cmd/mutual-migration-server"], check=True, cwd="scripts/migration")
+    result = subprocess.run([directory / "mutual-migration-server-host"], capture_output=True, text=True, timeout=15)
+    assert result.returncode != 0, "host-only migration server started"
+    assert "dedicated QEMU guest" in result.stderr, result.stderr
+    (directory / "host-only-rejection.log").write_text(result.stdout + result.stderr)
+    print("PASS: focused valid, forgery, stale nonce, replay, and transfer-blocking tests", flush=True)
+    print("PASS: host-only migration server is rejected before it can transfer checkpoints", flush=True)
+
+
+def capture_screenshots(output):
+    targets = [
+        ("http://127.0.0.1:8085", "#summary table", "mutual-migration-server-ui.png"),
+        ("http://127.0.0.1:18086", "#state table", "mutual-migration-source-ui.png"),
+        ("http://127.0.0.1:18087", "#state table", "mutual-migration-destination-ui.png"),
+    ]
+    digests = set()
+    for url, selector, name in targets:
+        subprocess.run(["npx", "--yes", "playwright@latest", "screenshot", "--viewport-size=1600,1400", "--wait-for-selector", selector, "--full-page", url, output / name], check=True, timeout=180)
+        digests.add(hashlib.sha256((output / name).read_bytes()).hexdigest())
+    assert len(digests) == len(targets), "mutual migration screenshots must contain distinct guest state"
+
+
+def main():
+    output = Path(sys.argv[1]).resolve()
+    keep = os.environ.get("RVA23_MUTUAL_KEEP_SERVICES") == "1"
+    resume = os.environ.get("RVA23_MUTUAL_RESUME") == "1"
+    succeeded = False
+    directory = output / "mutual-migration"
+    directory.mkdir(exist_ok=True)
+    if not resume:
+        prepare_images(output)
+    run_focused_tests(output)
+    production = predict_profile(output, "rva23_1+3-0.efi")
+    (directory / "profiles.json").write_text(json.dumps({"production": production}) + "\n")
+    network_port = free_port()
+    destination_network_port = free_port()
+    assert destination_network_port != network_port
+    server = None
+    source = None
+    destination = None
+    try:
+        server = vm_console(output, "server", 8085, network_port, server=True, destination_network_port=destination_network_port)
+        initialize_guest(server, output, "server", True, resume)
+        configure_network(server, "server")
+        source = vm_console(output, "source", 18086, network_port)
+        initialize_guest(source, output, "source", False, resume)
+        configure_network(source, "source")
+        destination = vm_console(output, "destination", 18087, destination_network_port)
+        initialize_guest(destination, output, "destination", False, resume)
+        configure_network(destination, "destination")
+        install_identities(server, source, destination, output)
+        server.capture(f"RVA23_MUTUAL_PRODUCTION_PCR11={production} mutual-migration-server </dev/null >/tmp/mutual-migration-server.log 2>&1 & printf '%s\\n' $!")
+        wait_http("http://127.0.0.1:8085/api/state")
+        source.command(f"ping -c 1 -W 5 192.0.2.10")
+        destination.command(f"ping -c 1 -W 5 192.0.3.10")
+        pid = start_workload(source)
+        source.command("mutual-migration-client open", 300)
+        source.command(f"RVA23_MUTUAL_PRODUCTION_PCR11={production} mutual-migration-client attest", 600)
+        source_state = read_state("http://127.0.0.1:18086/api/state")
+        assert source_state["serverVerification"]["hostOsReport"] == "accepted"
+        assert source_state["serverVerification"]["pcr11Quote"] == "accepted"
+        assert source_state["clientTier2"]["hostOsReport"] == "not required for Tier 2"
