+	"rva23/scripts/attestation"
+	"rva23/scripts/fido2"
+	migration "rva23/scripts/migration"
+)
+
+const maxMutualResponseBytes = 16 * 1024 * 1024
+
+type mutualClientState struct {
+	InstanceID         string              `json:"instanceId"`
+	PID                int                 `json:"pid"`
+	SessionID          string              `json:"sessionId,omitempty"`
+	Role               string              `json:"role"`
+	Counter            uint64              `json:"counter"`
+	Operation          string              `json:"operation,omitempty"`
+	Phase              string              `json:"phase"`
+	CheckpointSHA256   string              `json:"checkpointSha256,omitempty"`
+	CheckpointSize     int64               `json:"checkpointSize,omitempty"`
+	ServerIdentity     string              `json:"serverIdentity,omitempty"`
+	ServerPCR11        string              `json:"serverPcr11,omitempty"`
+	ServerVerification map[string]string   `json:"serverVerification"`
+	ClientTier2        map[string]string   `json:"clientTier2"`
+	ServerEvidence     *migration.Evidence `json:"-"`
+	LastServerNonce    string              `json:"lastServerNonce,omitempty"`
+	LastClientNonce    string              `json:"lastClientNonce,omitempty"`
+	UsedServerNonces   []string            `json:"usedServerNonces,omitempty"`
+	LastError          string              `json:"lastError,omitempty"`
+	UpdatedAt          time.Time           `json:"updatedAt"`
+}
+
+type mutualClientSnapshot struct {
+	mutualClientState
+	ServerEvidence *migration.Evidence `json:"serverEvidence,omitempty"`
+}
+
+type mutualClient struct {
+	baseURL         string
+	statePath       string
+	serverKeyFile   string
+	productionPCR11 string
+	httpClient      *http.Client
+	maxCheckpoint   int64
+	quoteVerifier   func(string, string, migration.Evidence) error
+	reportVerifier  func([]byte, attestation.Options) (attestation.Result, error)
+	serverVerifier  func(migration.MutualChallengeResponse) (map[string]string, error)
+	mutex           sync.Mutex
+	state           mutualClientState
+}
+
+func mutualEnvironment(name, fallback string) string {
+	if value := os.Getenv(name); value != "" {
+		return value
+	}
+	return fallback
+}
+
+func saveMutualState(path string, state mutualClientState) error {
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return err
+	}
+	encoded, err := json.Marshal(state)
+	if err != nil {
+		return err
+	}
+	temporary, err := os.CreateTemp(filepath.Dir(path), ".mutual-state-")
+	if err != nil {
+		return err
+	}
+	temporaryPath := temporary.Name()
+	completed := false
+	defer func() {
+		temporary.Close()
+		if !completed {
+			os.Remove(temporaryPath)
+		}
+	}()
+	if err := temporary.Chmod(0o600); err != nil {
+		return err
+	}
+	if _, err := temporary.Write(append(encoded, '\n')); err != nil {
+		return err
+	}
+	if err := temporary.Sync(); err != nil {
+		return err
+	}
+	if err := temporary.Close(); err != nil {
+		return err
+	}
+	if err := os.Rename(temporaryPath, path); err != nil {
+		return err
+	}
+	completed = true
+	return nil
+}
+
+func loadMutualState(path string, pid int, role string) (mutualClientState, error) {
+	state := mutualClientState{Role: role, ServerVerification: map[string]string{}, ClientTier2: map[string]string{"hostOsReport": "not required for Tier 2"}}
+	encoded, err := os.ReadFile(path)
+	if errors.Is(err, os.ErrNotExist) {
+		instanceID, err := migration.RandomID()
+		if err != nil {
+			return state, err
+		}
+		state.InstanceID = instanceID
+		state.PID = pid
+		state.Phase = "initialized"
+		state.UpdatedAt = time.Now().UTC()
+		return state, saveMutualState(path, state)
+	}
+	if err != nil {
+		return state, err
+	}
+	decoder := json.NewDecoder(bytes.NewReader(encoded))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&state); err != nil {
+		return state, err
+	}
+	if err := migration.ValidateInstanceID(state.InstanceID); err != nil {
+		return state, err
+	}
+	if state.PID <= 0 {
+		return state, errors.New("saved PID must be positive")
+	}
+	if state.ServerVerification == nil {
+		state.ServerVerification = map[string]string{}
+	}
+	if state.ClientTier2 == nil {
+		state.ClientTier2 = map[string]string{}
+	}
+	state.ClientTier2["hostOsReport"] = "not required for Tier 2"
+	if encodedEvidence, err := os.ReadFile(path + ".server-evidence.json"); err == nil {
+		var evidence migration.Evidence
+		if err := json.Unmarshal(encodedEvidence, &evidence); err == nil {
+			state.ServerEvidence = &evidence
+		}
+	}
+	return state, nil
+}
+
+func newMutualClient() (*mutualClient, error) {
+	statePath := mutualEnvironment("RVA23_MUTUAL_CLIENT_STATE", "/var/lib/rva23-mutual/state.json")
+	role := mutualEnvironment("RVA23_MUTUAL_ROLE", migration.RoleSource)
+	state, err := loadMutualState(statePath, os.Getpid(), role)
+	if err != nil {
+		return nil, err
+	}
+	state.Role = role
+	client := &mutualClient{
+		baseURL:   strings.TrimRight(mutualEnvironment("RVA23_MUTUAL_URL", "http://192.0.2.10:8083"), "/"),
+		statePath: statePath, serverKeyFile: mutualEnvironment("RVA23_MUTUAL_SERVER_KEY_FILE", "/var/lib/rva23-mutual/server-ak-public.pem"),
+		productionPCR11: strings.ToLower(os.Getenv("RVA23_MUTUAL_PRODUCTION_PCR11")), httpClient: &http.Client{Timeout: 5 * time.Minute},
+		maxCheckpoint: migration.DefaultMaxCheckpointBytes, state: state,
+	}
+	client.quoteVerifier = migration.VerifyPCR11Quote
+	client.reportVerifier = attestation.Verify
+	client.serverVerifier = client.verifyServer
+	return client, nil
+}
+
+func (client *mutualClient) persist() error {
+	client.state.UpdatedAt = time.Now().UTC()
+	if err := saveMutualState(client.statePath, client.state); err != nil {
+		return err
+	}
+	if client.state.ServerEvidence != nil {
+		encoded, err := json.Marshal(client.state.ServerEvidence)
+		if err != nil {
+			return err
+		}
+		return os.WriteFile(client.statePath+".server-evidence.json", append(encoded, '\n'), 0o600)
+	}
+	return nil
+}
+
+func (client *mutualClient) finish(operation string, err error) {
+	client.mutex.Lock()
+	defer client.mutex.Unlock()
+	client.state.Operation = operation
+	client.state.LastError = ""
+	if err != nil {
+		client.state.LastError = err.Error()
+	}
+	_ = client.persist()
+}
+
+func (client *mutualClient) snapshot() mutualClientSnapshot {
+	client.mutex.Lock()
+	defer client.mutex.Unlock()
+	if state, err := loadMutualState(client.statePath, client.state.PID, client.state.Role); err == nil {
+		client.state = state
+	}
+	return mutualClientSnapshot{mutualClientState: client.state, ServerEvidence: client.state.ServerEvidence}
+}
+
+func mutualPostJSON(httpClient *http.Client, url string, input any) ([]byte, int, error) {
+	body, err := json.Marshal(input)
+	if err != nil {
+		return nil, 0, err
+	}
+	request, err := http.NewRequest(http.MethodPost, url, bytes.NewReader(body))
+	if err != nil {
+		return nil, 0, err
+	}
+	request.Header.Set("Content-Type", "application/json")
+	response, err := httpClient.Do(request)
+	if err != nil {
+		return nil, 0, err
+	}
+	defer response.Body.Close()
+	result, err := io.ReadAll(io.LimitReader(response.Body, maxMutualResponseBytes))
+	return result, response.StatusCode, err
+}
+
+func mutualResponseError(operation string, status int, body []byte) error {
+	if status >= 200 && status < 300 {
+		return nil
+	}
+	return fmt.Errorf("%s failed with status %d: %s", operation, status, strings.TrimSpace(string(body)))
+}
+
+func (client *mutualClient) open() (response migration.MutualSessionResponse, err error) {
+	defer func() { client.finish("open-session", err) }()
+	if client.state.Role != migration.RoleSource || client.state.Counter != 0 {
+		return response, errors.New("only a new source client can open a migration session")
+	}
+	body, status, err := mutualPostJSON(client.httpClient, client.baseURL+"/v1/mutual/sessions", migration.MutualSessionRequest{InstanceID: client.state.InstanceID, PID: client.state.PID})
+	if err != nil {
+		return response, err
+	}
+	if err := mutualResponseError("open session", status, body); err != nil {
+		return response, err
+	}
+	if err := json.Unmarshal(body, &response); err != nil {
+		return response, err
+	}
+	if err := migration.ValidateSessionID(response.SessionID); err != nil {
+		return response, err
+	}
+	client.mutex.Lock()
+	client.state.SessionID = response.SessionID
+	client.state.Phase = "session-opened"
+	err = client.persist()
+	client.mutex.Unlock()
+	return response, err
+}
+
+func (client *mutualClient) nextBinding() (migration.OperationBinding, error) {
+	client.mutex.Lock()
+	defer client.mutex.Unlock()
+	if client.state.SessionID == "" {
+		return migration.OperationBinding{}, errors.New("migration session is not open")
+	}
+	operation, err := migration.ExpectedOperation(client.state.Role, client.state.Counter+1)
+	if err != nil {
+		return migration.OperationBinding{}, err
+	}
+	binding := migration.OperationBinding{
+		SessionID: client.state.SessionID, Role: client.state.Role, Operation: operation,
+		InstanceID: client.state.InstanceID, PID: client.state.PID, Counter: client.state.Counter + 1,
+	}
+	if migration.RequiresCheckpoint(operation) {
+		binding.CheckpointSHA256 = client.state.CheckpointSHA256
+		binding.CheckpointSize = client.state.CheckpointSize
+	}
+	if err := migration.ValidateBinding(binding); err != nil {
+		return binding, err
+	}
+	client.state.Counter++
+	client.state.Operation = operation
+	client.state.Phase = "challenging-" + operation
+	if err := client.persist(); err != nil {
+		client.state.Counter--
+		return binding, err
+	}
+	return binding, nil
+}
+
+func (client *mutualClient) authorize() (grant migration.MutualGrant, err error) {
+	binding, err := client.nextBinding()
+	if err != nil {
+		return grant, err
+	}
+	defer func() { client.finish(binding.Operation, err) }()
+	body, status, err := mutualPostJSON(client.httpClient, client.baseURL+"/v1/mutual/challenges", migration.MutualChallengeRequest{Binding: binding})
+	if err != nil {
+		return grant, err
+	}
+	if err := mutualResponseError("mutual challenge", status, body); err != nil {
+		return grant, err
+	}
+	var challenge migration.MutualChallengeResponse
+	if err := json.Unmarshal(body, &challenge); err != nil {
+		return grant, err
+	}
+	if challenge.Binding != binding {
+		return grant, errors.New("server changed the signed operation, checkpoint, or session binding")
+	}
+	verifier := client.serverVerifier
+	if verifier == nil {
+		verifier = client.verifyServer
+	}
+	verification, err := verifier(challenge)
+	client.mutex.Lock()
+	client.state.ServerVerification = verification
+	client.state.ServerEvidence = &challenge.ServerEvidence
+	client.state.ServerPCR11 = challenge.ServerEvidence.PCR11
+	client.state.LastServerNonce = challenge.ServerNonce
+	client.state.LastClientNonce = challenge.ClientNonce
+	client.state.Phase = "server-verified-" + binding.Operation
+	client.mutex.Unlock()
+	if err != nil {
+		return grant, err
+	}
+	messageInput := migration.MutualOperationRequest{Binding: binding, ServerNonce: challenge.ServerNonce, ClientNonce: challenge.ClientNonce}
+	consentMessage, err := migration.MutualConsentMessage(messageInput)
+	if err != nil {
+		return grant, err
+	}
+	application, err := migration.MutualApplication(binding.SessionID)
+	if err != nil {
+		return grant, err
+	}
+	proof, err := fido2.Fido2Consent(migration.MutualConsentChallenge(consentMessage), application)
+	if err != nil {
+		return grant, err
+	}
+	encodedProof, err := json.Marshal(proof)
+	if err != nil {
+		return grant, err
+	}
+	messageInput.ConsentProof = base64.RawURLEncoding.EncodeToString(encodedProof)
+	message, err := migration.MutualClientMessage(messageInput)
+	if err != nil {
+		return grant, err
+	}
+	messageInput.Signature, err = migration.SignWithTPMAK(message)
+	if err != nil {
+		return grant, err
+	}
+	body, status, err = mutualPostJSON(client.httpClient, client.baseURL+"/v1/mutual/operations", messageInput)
+	if err != nil {
+		return grant, err
+	}
+	if err := mutualResponseError("Tier 2 authorization", status, body); err != nil {
+		return grant, err
+	}
+	if err := json.Unmarshal(body, &grant); err != nil {
+		return grant, err
+	}
+	client.mutex.Lock()
+	client.state.ClientTier2 = map[string]string{
+		"tpmAkSignature": "accepted", "fido2RegistrationAttestation": "accepted", "fido2Consent": "accepted",
+		"hostOsReport": "not required for Tier 2", "freshNonce": "accepted", "singleUseNonce": "consumed", "counter": "accepted",
+	}
+	client.state.Phase = "authorized-" + binding.Operation
+	err = client.persist()
+	client.mutex.Unlock()
+	return grant, err
+}
+
+func (client *mutualClient) attest() (response migration.MutualGrant, err error) {
+	response, err = client.authorize()
+	return response, err
+}
+
+func (client *mutualClient) upload(path string) (digest migration.ArchiveDigest, err error) {
+	digest, err = migration.DigestFile(path, client.maxCheckpoint)
+	if err != nil {
+		return digest, err
+	}
+	client.mutex.Lock()
+	client.state.CheckpointSHA256 = digest.SHA256
+	client.state.CheckpointSize = digest.Size
+	if err := client.persist(); err != nil {
+		client.mutex.Unlock()
+		return digest, err
+	}
+	client.mutex.Unlock()
+	grant, err := client.authorize()
+	if err != nil {
+		return digest, err
+	}
+	defer func() { client.finish(migration.OperationUpload, err) }()
+	archive, err := os.Open(path)
+	if err != nil {
+		return digest, err
+	}
+	defer archive.Close()
+	request, err := http.NewRequest(http.MethodPut, client.baseURL+"/v1/mutual/transfers/"+grant.GrantID, archive)
+	if err != nil {
+		return digest, err
+	}
+	request.ContentLength = digest.Size
+	request.Header.Set("Content-Type", "application/gzip")
+	response, err := client.httpClient.Do(request)
+	if err != nil {
+		return digest, err
+	}
+	defer response.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(response.Body, maxMutualResponseBytes))
+	if err != nil {
+		return digest, err
+	}
+	if err := mutualResponseError("checkpoint upload", response.StatusCode, body); err != nil {
+		return digest, err
+	}
+	client.mutex.Lock()
+	client.state.Phase = "checkpoint-uploaded"
+	err = client.persist()
+	client.mutex.Unlock()
+	return digest, err
+}
+
+func (client *mutualClient) download(path string) (digest migration.ArchiveDigest, err error) {
+	client.mutex.Lock()
+	client.state.Role = migration.RoleDestination
+	if err := client.persist(); err != nil {
+		client.mutex.Unlock()
+		return digest, err
+	}
+	client.mutex.Unlock()
+	grant, err := client.authorize()
+	if err != nil {
+		return digest, err
+	}
+	defer func() { client.finish(migration.OperationDownload, err) }()
+	request, err := http.NewRequest(http.MethodPost, client.baseURL+"/v1/mutual/transfers/"+grant.GrantID, nil)
+	if err != nil {
+		return digest, err
+	}
+	response, err := client.httpClient.Do(request)
+	if err != nil {
+		return digest, err
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		body, _ := io.ReadAll(io.LimitReader(response.Body, maxMutualResponseBytes))
+		return digest, mutualResponseError("checkpoint download", response.StatusCode, body)
+	}
+	if response.ContentLength <= 0 || response.ContentLength > client.maxCheckpoint || response.ContentLength != client.state.CheckpointSize {
+		return digest, errors.New("download size does not match the signed authorization")
+	}
+	output, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+	if err != nil {
+		return digest, err
+	}
+	completed := false
+	defer func() {
+		output.Close()
+		if !completed {
+			os.Remove(path)
+		}
+	}()
+	hash := sha256.New()
+	written, err := io.Copy(io.MultiWriter(output, hash), io.LimitReader(response.Body, client.maxCheckpoint+1))
+	if err != nil {
+		return digest, err
+	}
+	if written != response.ContentLength || hex.EncodeToString(hash.Sum(nil)) != client.state.CheckpointSHA256 {
+		return digest, errors.New("download does not match the signed checkpoint digest and size")
+	}
+	if err := output.Sync(); err != nil {
+		return digest, err
+	}
+	if err := output.Close(); err != nil {
+		return digest, err
+	}
+	digest.Size = written
+	digest.SHA256 = client.state.CheckpointSHA256
+	completed = true
+	client.mutex.Lock()
+	client.state.Phase = "checkpoint-downloaded"
+	err = client.persist()
+	client.mutex.Unlock()
+	return digest, err
+}
+
+func (client *mutualClient) complete() (response migration.MutualGrant, err error) {
+	client.mutex.Lock()
+	client.state.Role = migration.RoleDestination
+	if err := client.persist(); err != nil {
+		client.mutex.Unlock()
+		return response, err
+	}
+	client.mutex.Unlock()
+	response, err = client.authorize()
+	if err == nil {
+		client.mutex.Lock()
+		client.state.Phase = "completed"
+		err = client.persist()
+		client.mutex.Unlock()
+	}
+	return response, err
+}
+
+func (client *mutualClient) observe() error {
+	if client.state.SessionID == "" {
+		return errors.New("migration session is not open")
+	}
+	response, err := client.httpClient.Get(client.baseURL + "/v1/mutual/sessions/" + client.state.SessionID)
+	if err != nil {
+		return err
+	}
+	defer response.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(response.Body, maxMutualResponseBytes))
+	if err != nil {
+		return err
+	}
+	if err := mutualResponseError("session observation", response.StatusCode, body); err != nil {
+		return err
+	}
+	var session struct {
+		Phase string `json:"phase"`
+	}
+	if err := json.Unmarshal(body, &session); err != nil {
+		return err
+	}
+	client.mutex.Lock()
+	defer client.mutex.Unlock()
+	client.state.Phase = session.Phase
+	return client.persist()
+}
+
+func mutualClientUIHandler(client *mutualClient) http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("/api/state", func(writer http.ResponseWriter, request *http.Request) {
+		if request.Method != http.MethodGet {
+			writer.Header().Set("Allow", http.MethodGet)
+			http.Error(writer, "method not allowed", http.StatusMethodNotAllowed)
+			return
+		}
+		writer.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(writer).Encode(client.snapshot())
+	})
+	mux.HandleFunc("/", func(writer http.ResponseWriter, request *http.Request) {
+		if request.URL.Path != "/" {
+			http.NotFound(writer, request)
+			return
+		}
+		if request.Method != http.MethodGet {
+			writer.Header().Set("Allow", http.MethodGet)
+			http.Error(writer, "method not allowed", http.StatusMethodNotAllowed)
+			return
+		}
+		writer.Header().Set("Content-Type", "text/html; charset=utf-8")
+		_, _ = io.WriteString(writer, mutualClientHTML)
+	})
+	return mux
+}
+
+const mutualClientHTML = `<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Mutual migration client</title></head>
+<body><h1>Mutual migration client</h1><p><button id="refresh" type="button">Refresh</button> <span id="status">Loading</span></p><div id="state">Loading</div>
+<script>
+function label(key){const names={instanceId:'Instance ID',pid:'PID',sessionId:'Session ID',checkpointSha256:'Checkpoint SHA-256',checkpointSize:'Checkpoint size',serverIdentity:'Server AK identity',serverPcr11:'Server production PCR 11',serverVerification:'Server full host verification',clientTier2:'Client Tier 2 TPM and FIDO2',serverEvidence:'Server full OS evidence',lastServerNonce:'Server challenge',lastClientNonce:'Client challenge',lastError:'Last error',updatedAt:'Updated at'};if(names[key])return names[key];const text=key.replace(/([a-z0-9])([A-Z])/g,'$1 $2');return text.charAt(0).toUpperCase()+text.slice(1)}
+function scalar(value){if(value===null||value===undefined||value==='')return 'None';return String(value)}
+function render(name,value){if(value===null||typeof value!=='object'){const content=scalar(value);if(content.length>160){const details=document.createElement('details');const summary=document.createElement('summary');summary.textContent=name+' ('+content.length+' characters)';const pre=document.createElement('pre');pre.textContent=content;details.append(summary,pre);return details}return document.createTextNode(content)}const entries=Array.isArray(value)?value.map((entry,index)=>['Item '+(index+1),entry]):Object.entries(value);const table=document.createElement('table');const body=document.createElement('tbody');for(const [key,entry] of entries){const row=document.createElement('tr');const heading=document.createElement('th');heading.scope='row';heading.textContent=key;const cell=document.createElement('td');cell.append(render(key,entry));row.append(heading,cell);body.append(row)}table.append(body);return table}
+function raw(value){const details=document.createElement('details');const summary=document.createElement('summary');summary.textContent='Raw JSON';const pre=document.createElement('pre');pre.textContent=JSON.stringify(value,null,2);details.append(summary,pre);return details}
+async function refresh(){const status=document.getElementById('status');try{const response=await fetch('/api/state');if(!response.ok)throw new Error(response.statusText);const data=await response.json();document.getElementById('state').replaceChildren(render('State',data),raw(data));status.textContent='Updated '+data.updatedAt}catch(error){status.textContent='Refresh failed: '+error.message}}
+document.getElementById('refresh').onclick=refresh;refresh()
