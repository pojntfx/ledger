+func TestMutualMigrationServerFiveOperationFlow(t *testing.T) {
+	fixture := newMutualTestFixture(t)
+	if fixture.sourceAK.private.PublicKey.N.Cmp(fixture.destinationAK.private.PublicKey.N) == 0 {
+		t.Fatal("source and destination AKs are not distinct")
+	}
+	if bytes.Equal(fixture.sourceFIDO2.certificateDER, fixture.destinationFIDO2.certificateDER) {
+		t.Fatal("source and destination FIDO2 certificates are not distinct")
+	}
+	sessionID := fixture.openSession(t)
+
+	sourceGrant, _ := fixture.authorize(t, fixture.binding(t, sessionID, 1))
+	if sourceGrant.GrantID != "" {
+		t.Fatal("source attestation issued a transfer grant")
+	}
+	uploadGrant, _ := fixture.authorize(t, fixture.binding(t, sessionID, 2))
+	if uploadGrant.GrantID == "" || !uploadGrant.ExpiresAt.Equal(fixture.now.Add(migration.MutualChallengeLifetime)) {
+		t.Fatalf("invalid upload grant %+v", uploadGrant)
+	}
+	body, _ := fixture.transfer(t, http.MethodPut, uploadGrant.GrantID, fixture.archive, http.StatusCreated)
+	if !bytes.Contains(body, []byte(`"status":"uploaded"`)) {
+		t.Fatalf("unexpected upload response %s", body)
+	}
+	stored, err := os.ReadFile(fixture.checkpointPath(sessionID))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(stored, fixture.archive) {
+		t.Fatal("stored checkpoint differs from uploaded bytes")
+	}
+
+	destinationGrant, _ := fixture.authorize(t, fixture.binding(t, sessionID, 3))
+	if destinationGrant.GrantID != "" {
+		t.Fatal("destination attestation issued a transfer grant")
+	}
+	downloadGrant, _ := fixture.authorize(t, fixture.binding(t, sessionID, 4))
+	if downloadGrant.GrantID == "" {
+		t.Fatal("download authorization did not issue a grant")
+	}
+	downloaded, header := fixture.transfer(t, http.MethodPost, downloadGrant.GrantID, nil, http.StatusOK)
+	if !bytes.Equal(downloaded, fixture.archive) {
+		t.Fatal("download changed checkpoint bytes")
+	}
+	if header.Get("X-Checkpoint-SHA256") != fixture.digest || header.Get("Content-Length") != strconv.Itoa(len(fixture.archive)) {
+		t.Fatalf("download returned incorrect checkpoint metadata: %+v", header)
+	}
+	completionGrant, _ := fixture.authorize(t, fixture.binding(t, sessionID, 5))
+	if completionGrant.GrantID != "" {
+		t.Fatal("completion issued a transfer grant")
+	}
+
+	fixture.server.mutex.Lock()
+	session := fixture.server.sessions[sessionID]
+	if session.Counter != 5 || session.Phase != "completed" {
+		t.Fatalf("flow ended at counter %d in phase %q", session.Counter, session.Phase)
+	}
+	if session.Checkpoint == nil || session.Checkpoint.SHA256 != fixture.digest || session.Checkpoint.Size != int64(len(fixture.archive)) {
+		t.Fatalf("flow retained incorrect checkpoint metadata %+v", session.Checkpoint)
+	}
+	if session.SourceTier2["tpmAkSignature"] != "accepted" || session.SourceTier2["fido2Consent"] != "accepted" {
+		t.Fatalf("source Tier 2 validation is incomplete %+v", session.SourceTier2)
+	}
+	if session.DestinationTier2["tpmAkSignature"] != "accepted" || session.DestinationTier2["fido2Consent"] != "accepted" {
+		t.Fatalf("destination Tier 2 validation is incomplete %+v", session.DestinationTier2)
+	}
+	if len(fixture.server.grants) != 0 || len(fixture.server.challenges) != 0 {
+		t.Fatalf("flow left %d grants and %d challenges", len(fixture.server.grants), len(fixture.server.challenges))
+	}
+	fixture.server.mutex.Unlock()
+}
