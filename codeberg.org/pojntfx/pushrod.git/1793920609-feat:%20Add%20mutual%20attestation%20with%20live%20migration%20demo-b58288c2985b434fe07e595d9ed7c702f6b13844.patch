diff --git a/buildroot/qemu/scripts/attestation/fido2.go b/buildroot/qemu/scripts/attestation/fido2.go
new file mode 100644
index 0000000000000000000000000000000000000000..85242709a82b5183f51f8118239e91693e2ec2d9
--- /dev/null
+++ b/buildroot/qemu/scripts/attestation/fido2.go
@@ -0,0 +1,83 @@
+package attestation
+
+import (
+	"bytes"
+	"crypto/ecdsa"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/binary"
+	"errors"
+)
+
+type Proof struct {
+	Identity              string
+	CertificateDER        []byte
+	ConsentPublicKeyDER   []byte
+	KeyHandle             []byte
+	RegistrationChallenge [32]byte
+	RegistrationSignature []byte
+	UserPresence          byte
+	Counter               uint32
+	ConsentSignature      []byte
+}
+
+type VerificationInput struct {
+	AllowlistedCertificates map[string][]byte
+	ApplicationDigest       [32]byte
+	OperationChallenge      [32]byte
+}
+
+func VerifyProof(proof Proof, input VerificationInput) error {
+	expected, ok := input.AllowlistedCertificates[proof.Identity]
+	if !ok || !bytes.Equal(expected, proof.CertificateDER) {
+		return errors.New("U2F attestation certificate is not allowlisted")
+	}
+	attestationCertificate, err := x509.ParseCertificate(proof.CertificateDER)
+	if err != nil {
+		return errors.New("invalid U2F attestation certificate")
+	}
+	attestationKey, ok := attestationCertificate.PublicKey.(*ecdsa.PublicKey)
+	if !ok || attestationKey.Curve.Params().Name != "P-256" {
+		return errors.New("U2F attestation certificate does not contain a P-256 key")
+	}
+	if len(proof.KeyHandle) == 0 || len(proof.KeyHandle) > 255 {
+		return errors.New("invalid U2F key handle")
+	}
+	parsedPublicKey, err := x509.ParsePKIXPublicKey(proof.ConsentPublicKeyDER)
+	if err != nil {
+		return errors.New("invalid U2F public key")
+	}
+	consentKey, ok := parsedPublicKey.(*ecdsa.PublicKey)
+	if !ok || consentKey.Curve.Params().Name != "P-256" {
+		return errors.New("U2F consent key is not P-256")
+	}
+	publicKeyBytes := make([]byte, 65)
+	publicKeyBytes[0] = 4
+	consentKey.X.FillBytes(publicKeyBytes[1:33])
+	consentKey.Y.FillBytes(publicKeyBytes[33:65])
+	registrationMessage := make([]byte, 0, 1+32+32+len(proof.KeyHandle)+len(publicKeyBytes))
+	registrationMessage = append(registrationMessage, 0)
+	registrationMessage = append(registrationMessage, input.ApplicationDigest[:]...)
+	registrationMessage = append(registrationMessage, proof.RegistrationChallenge[:]...)
+	registrationMessage = append(registrationMessage, proof.KeyHandle...)
+	registrationMessage = append(registrationMessage, publicKeyBytes...)
+	registrationDigest := sha256.Sum256(registrationMessage)
+	if !ecdsa.VerifyASN1(attestationKey, registrationDigest[:], proof.RegistrationSignature) {
+		return errors.New("U2F registration attestation signature is invalid")
+	}
+	if proof.UserPresence != 1 {
+		return errors.New("invalid U2F user presence")
+	}
+	counter := make([]byte, 4)
+	binary.BigEndian.PutUint32(counter, proof.Counter)
+	signed := make([]byte, 0, 32+1+4+32)
+	signed = append(signed, input.ApplicationDigest[:]...)
+	signed = append(signed, proof.UserPresence)
+	signed = append(signed, counter...)
+	signed = append(signed, input.OperationChallenge[:]...)
+	consentDigest := sha256.Sum256(signed)
+	if !ecdsa.VerifyASN1(consentKey, consentDigest[:], proof.ConsentSignature) {
+		return errors.New("U2F consent signature is invalid")
+	}
+	return nil
+}
diff --git a/buildroot/qemu/scripts/attestation/fido2_test.go b/buildroot/qemu/scripts/attestation/fido2_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..6a6860314aa7495adb8ec02a33c5e2d9dc9874ff
--- /dev/null
+++ b/buildroot/qemu/scripts/attestation/fido2_test.go
@@ -0,0 +1,124 @@
+package attestation
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/sha256"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/binary"
+	"math/big"
+	"testing"
+	"time"
+)
+
+func validProof(t *testing.T) (Proof, VerificationInput) {
+	t.Helper()
+	attestationKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	consentKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now()
+	template := &x509.Certificate{
+		SerialNumber: big.NewInt(1),
+		Subject:      pkix.Name{CommonName: "U2F test"},
+		NotBefore:    now.Add(-time.Hour),
+		NotAfter:     now.Add(time.Hour),
+	}
+	certificateDER, err := x509.CreateCertificate(rand.Reader, template, template, &attestationKey.PublicKey, attestationKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	consentPublicKeyDER, err := x509.MarshalPKIXPublicKey(&consentKey.PublicKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var applicationDigest [32]byte
+	var registrationChallenge [32]byte
+	var operationChallenge [32]byte
+	for index := 0; index < 32; index++ {
+		applicationDigest[index] = byte(index)
+		registrationChallenge[index] = byte(32 + index)
+		operationChallenge[index] = byte(64 + index)
+	}
+	keyHandle := []byte{1, 2, 3, 4}
+	publicKeyBytes := make([]byte, 65)
+	publicKeyBytes[0] = 4
+	consentKey.X.FillBytes(publicKeyBytes[1:33])
+	consentKey.Y.FillBytes(publicKeyBytes[33:65])
+	registrationMessage := []byte{0}
+	registrationMessage = append(registrationMessage, applicationDigest[:]...)
+	registrationMessage = append(registrationMessage, registrationChallenge[:]...)
+	registrationMessage = append(registrationMessage, keyHandle...)
+	registrationMessage = append(registrationMessage, publicKeyBytes...)
+	registrationDigest := sha256.Sum256(registrationMessage)
+	registrationSignature, err := ecdsa.SignASN1(rand.Reader, attestationKey, registrationDigest[:])
+	if err != nil {
+		t.Fatal(err)
+	}
+	counterValue := uint32(7)
+	counter := make([]byte, 4)
+	binary.BigEndian.PutUint32(counter, counterValue)
+	consentMessage := append([]byte{}, applicationDigest[:]...)
+	consentMessage = append(consentMessage, 1)
+	consentMessage = append(consentMessage, counter...)
+	consentMessage = append(consentMessage, operationChallenge[:]...)
+	consentDigest := sha256.Sum256(consentMessage)
+	consentSignature, err := ecdsa.SignASN1(rand.Reader, consentKey, consentDigest[:])
+	if err != nil {
+		t.Fatal(err)
+	}
+	proof := Proof{
+		Identity:              "wallet",
+		CertificateDER:        certificateDER,
+		ConsentPublicKeyDER:   consentPublicKeyDER,
+		KeyHandle:             keyHandle,
+		RegistrationChallenge: registrationChallenge,
+		RegistrationSignature: registrationSignature,
+		UserPresence:          1,
+		Counter:               counterValue,
+		ConsentSignature:      consentSignature,
+	}
+	input := VerificationInput{
+		AllowlistedCertificates: map[string][]byte{"wallet": certificateDER},
+		ApplicationDigest:       applicationDigest,
+		OperationChallenge:      operationChallenge,
+	}
+	return proof, input
+}
+
+func TestVerifyProofValid(t *testing.T) {
+	proof, input := validProof(t)
+	if err := VerifyProof(proof, input); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestVerifyProofRejectsUnallowlistedCertificate(t *testing.T) {
+	proof, input := validProof(t)
+	proof.Identity = "unknown"
+	if err := VerifyProof(proof, input); err == nil || err.Error() != "U2F attestation certificate is not allowlisted" {
+		t.Fatalf("unexpected error: %v", err)
+	}
+}
+
+func TestVerifyProofRejectsForgedRegistrationAttestation(t *testing.T) {
+	proof, input := validProof(t)
+	proof.RegistrationSignature[len(proof.RegistrationSignature)-1] ^= 1
+	if err := VerifyProof(proof, input); err == nil || err.Error() != "U2F registration attestation signature is invalid" {
+		t.Fatalf("unexpected error: %v", err)
+	}
+}
+
+func TestVerifyProofRejectsForgedConsent(t *testing.T) {
+	proof, input := validProof(t)
+	proof.ConsentSignature[len(proof.ConsentSignature)-1] ^= 1
+	if err := VerifyProof(proof, input); err == nil || err.Error() != "U2F consent signature is invalid" {
+		t.Fatalf("unexpected error: %v", err)
+	}
+}
diff --git a/buildroot/qemu/scripts/attestation/report.go b/buildroot/qemu/scripts/attestation/report.go
new file mode 100644
index 0000000000000000000000000000000000000000..3ca5cbeef6c0d7052e41a3bfb5365af6c66ba3fa
--- /dev/null
+++ b/buildroot/qemu/scripts/attestation/report.go
@@ -0,0 +1,520 @@
+package attestation
+
+import (
+	"bytes"
+	"crypto"
+	"crypto/rsa"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"encoding/pem"
+	"errors"
+	"fmt"
+	"io"
+	"strings"
+	"unicode/utf16"
+)
+
+const MaxReportBytes = 16 * 1024 * 1024
+
+type ClockInfo struct {
+	Clock        uint64 `json:"clock"`
+	ResetCount   uint32 `json:"resetCount"`
+	RestartCount uint32 `json:"restartCount"`
+	Safe         string `json:"safe"`
+}
+
+type PCRSelection struct {
+	Hash      string   `json:"hash"`
+	PCRSelect []uint32 `json:"pcrSelect"`
+}
+
+type AttestedFields struct {
+	PCRSelect        []PCRSelection `json:"pcrSelect"`
+	PCRDigest        string         `json:"pcrDigest"`
+	IndexName        string         `json:"indexName"`
+	Offset           uint16         `json:"offset"`
+	NVContents       string         `json:"nvContents"`
+	ExclusiveSession string         `json:"exclusiveSession"`
+	SessionDigest    string         `json:"sessionDigest"`
+}
+
+type Attestation struct {
+	Magic           string         `json:"magic"`
+	Type            string         `json:"type"`
+	QualifiedSigner string         `json:"qualifiedSigner"`
+	ExtraData       string         `json:"extraData"`
+	ClockInfo       ClockInfo      `json:"clockInfo"`
+	FirmwareVersion uint64         `json:"firmwareVersion"`
+	Attested        AttestedFields `json:"attested"`
+}
+
+type AttestInfo struct {
+	Scheme json.RawMessage `json:"sig_scheme"`
+	Attest Attestation     `json:"attest"`
+}
+
+type Signature struct {
+	Sig string `json:"sig"`
+}
+
+type SignatureData struct {
+	SigAlg string    `json:"sigAlg"`
+	Inner  Signature `json:"signature"`
+}
+
+type Component struct {
+	Type      string        `json:"type"`
+	Attest    AttestInfo    `json:"attestInfo"`
+	Signature SignatureData `json:"signature"`
+}
+
+type ReportData struct {
+	EventLog     []json.RawMessage `json:"eventLog"`
+	PublicKeyPEM string            `json:"publicKeyPEM"`
+	Components   []Component       `json:"components"`
+}
+
+type ReportSignature struct {
+	MediaType string     `json:"mediaType"`
+	Mechanism string     `json:"mechanism"`
+	SHA256    string     `json:"sha256"`
+	Data      ReportData `json:"data"`
+}
+
+type DecodedReport struct {
+	Raw        []byte
+	JSON       []byte
+	Signatures []ReportSignature
+}
+
+type Options struct {
+	StrictMutual       bool
+	RequireAKAllowlist bool
+	RequireToken       bool
+	RequirePCR11       bool
+	RequireSysext      bool
+	AllowedAKs         []*rsa.PublicKey
+	Nonce              []byte
+	Token              []byte
+	ConsumeNonce       func([]byte) error
+}
+
+type Result struct {
+	Status             string           `json:"status"`
+	SignaturesVerified int              `json:"signaturesVerified"`
+	ComponentsVerified int              `json:"componentsVerified"`
+	EventLogRecords    int              `json:"eventLogRecords"`
+	PCR11Records       int              `json:"pcr11Records"`
+	SysextRecords      int              `json:"sysextRecords"`
+	AKFingerprints     []string         `json:"akFingerprints"`
+	TokenVerified      bool             `json:"tokenVerified"`
+	NonceConsumed      bool             `json:"nonceConsumed"`
+	PublicKeys         []*rsa.PublicKey `json:"-"`
+}
+
+func DecodeJSONSequence(body io.Reader) (DecodedReport, error) {
+	var decoded DecodedReport
+	data, err := io.ReadAll(io.LimitReader(body, MaxReportBytes+1))
+	if err != nil {
+		return decoded, err
+	}
+	if len(data) > MaxReportBytes {
+		return decoded, errors.New("signed report exceeds the size limit")
+	}
+	parts := bytes.Split(data, []byte{0x1e})
+	if len(parts) < 2 {
+		return decoded, errors.New("signed report requires JSON-SEQ records")
+	}
+	decoded.Raw = data
+	decoded.JSON = append([]byte(nil), parts[1]...)
+	if !json.Valid(decoded.JSON) {
+		return DecodedReport{}, errors.New("signed report contains invalid report JSON")
+	}
+	for _, part := range parts[2:] {
+		part = bytes.TrimSpace(part)
+		if len(part) == 0 {
+			continue
+		}
+		var signature ReportSignature
+		if err := json.Unmarshal(part, &signature); err != nil {
+			return DecodedReport{}, err
+		}
+		decoded.Signatures = append(decoded.Signatures, signature)
+	}
+	return decoded, nil
+}
+
+func Decode(data []byte) (DecodedReport, error) {
+	return DecodeJSONSequence(bytes.NewReader(data))
+}
+
+func putU16(buf []byte, value uint16) []byte {
+	var encoded [2]byte
+	binary.BigEndian.PutUint16(encoded[:], value)
+	return append(buf, encoded[:]...)
+}
+
+func putU32(buf []byte, value uint32) []byte {
+	var encoded [4]byte
+	binary.BigEndian.PutUint32(encoded[:], value)
+	return append(buf, encoded[:]...)
+}
+
+func putU64(buf []byte, value uint64) []byte {
+	var encoded [8]byte
+	binary.BigEndian.PutUint64(encoded[:], value)
+	return append(buf, encoded[:]...)
+}
+
+func putBytes(buf []byte, value string) ([]byte, error) {
+	decoded, err := hex.DecodeString(value)
+	if err != nil {
+		return nil, err
+	}
+	if len(decoded) > 65535 {
+		return nil, errors.New("TPM2B value is too long")
+	}
+	buf = putU16(buf, uint16(len(decoded)))
+	return append(buf, decoded...), nil
+}
+
+func attestType(value string) (uint16, error) {
+	switch value {
+	case "ATTEST_NV":
+		return 0x8014, nil
+	case "ATTEST_SESSION_AUDIT":
+		return 0x8016, nil
+	case "ATTEST_QUOTE":
+		return 0x8018, nil
+	default:
+		return 0, fmt.Errorf("unsupported attestation type %q", value)
+	}
+}
+
+func hashAlgorithm(value string) (uint16, error) {
+	switch value {
+	case "SHA1":
+		return 0x0004, nil
+	case "SHA256":
+		return 0x000b, nil
+	case "SHA384":
+		return 0x000c, nil
+	case "SHA512":
+		return 0x000d, nil
+	default:
+		return 0, fmt.Errorf("unsupported hash algorithm %q", value)
+	}
+}
+
+func MarshalAttestation(value Attestation) ([]byte, error) {
+	typeID, err := attestType(value.Type)
+	if err != nil {
+		return nil, err
+	}
+	buf := putU32(nil, 0xff544347)
+	buf = putU16(buf, typeID)
+	if buf, err = putBytes(buf, value.QualifiedSigner); err != nil {
+		return nil, err
+	}
+	if buf, err = putBytes(buf, value.ExtraData); err != nil {
+		return nil, err
+	}
+	buf = putU64(buf, value.ClockInfo.Clock)
+	buf = putU32(buf, value.ClockInfo.ResetCount)
+	buf = putU32(buf, value.ClockInfo.RestartCount)
+	if value.ClockInfo.Safe == "YES" {
+		buf = append(buf, 1)
+	} else {
+		buf = append(buf, 0)
+	}
+	buf = putU64(buf, value.FirmwareVersion)
+	switch typeID {
+	case 0x8018:
+		buf = putU32(buf, uint32(len(value.Attested.PCRSelect)))
+		for _, selection := range value.Attested.PCRSelect {
+			algorithm, err := hashAlgorithm(selection.Hash)
+			if err != nil {
+				return nil, err
+			}
+			buf = putU16(buf, algorithm)
+			const size = 3
+			for _, pcr := range selection.PCRSelect {
+				if pcr >= size*8 {
+					return nil, errors.New("PCR index is out of range")
+				}
+			}
+			buf = append(buf, byte(size))
+			bitmap := make([]byte, size)
+			for _, pcr := range selection.PCRSelect {
+				bitmap[pcr/8] |= 1 << (pcr % 8)
+			}
+			buf = append(buf, bitmap...)
+		}
+		if buf, err = putBytes(buf, value.Attested.PCRDigest); err != nil {
+			return nil, err
+		}
+	case 0x8014:
+		if buf, err = putBytes(buf, value.Attested.IndexName); err != nil {
+			return nil, err
+		}
+		buf = putU16(buf, value.Attested.Offset)
+		if buf, err = putBytes(buf, value.Attested.NVContents); err != nil {
+			return nil, err
+		}
+	case 0x8016:
+		if value.Attested.ExclusiveSession == "YES" {
+			buf = append(buf, 1)
+		} else {
+			buf = append(buf, 0)
+		}
+		if buf, err = putBytes(buf, value.Attested.SessionDigest); err != nil {
+			return nil, err
+		}
+	}
+	return buf, nil
+}
+
+func ParseRSAPublicKeyPEM(data []byte) (*rsa.PublicKey, error) {
+	block, rest := pem.Decode(data)
+	if block == nil || len(bytes.TrimSpace(rest)) != 0 {
+		return nil, errors.New("invalid RSA public key PEM")
+	}
+	var key *rsa.PublicKey
+	switch block.Type {
+	case "PUBLIC KEY":
+		parsed, err := x509.ParsePKIXPublicKey(block.Bytes)
+		if err != nil {
+			return nil, err
+		}
+		var ok bool
+		key, ok = parsed.(*rsa.PublicKey)
+		if !ok {
+			return nil, errors.New("TPM public key must be RSA")
+		}
+	case "RSA PUBLIC KEY":
+		parsed, err := x509.ParsePKCS1PublicKey(block.Bytes)
+		if err != nil {
+			return nil, err
+		}
+		key = parsed
+	default:
+		return nil, errors.New("unsupported RSA public key PEM type")
+	}
+	if key.N == nil || key.N.Sign() <= 0 || key.N.BitLen() < 2048 || key.E < 3 || key.E%2 == 0 {
+		return nil, errors.New("TPM public key must be RSA with at least 2048 bits")
+	}
+	return key, nil
+}
+
+func PublicKeyFingerprint(key *rsa.PublicKey) (string, error) {
+	if key == nil {
+		return "", errors.New("RSA public key is nil")
+	}
+	encoded, err := x509.MarshalPKIXPublicKey(key)
+	if err != nil {
+		return "", err
+	}
+	digest := sha256.Sum256(encoded)
+	return hex.EncodeToString(digest[:]), nil
+}
+
+func allowlisted(key *rsa.PublicKey, allowed []*rsa.PublicKey) bool {
+	for _, candidate := range allowed {
+		if candidate != nil && candidate.E == key.E && candidate.N != nil && candidate.N.Cmp(key.N) == 0 {
+			return true
+		}
+	}
+	return false
+}
+
+func eventText(record json.RawMessage) (string, bool) {
+	var parsed struct {
+		Content struct {
+			EventData string `json:"event_data"`
+		} `json:"content"`
+	}
+	if err := json.Unmarshal(record, &parsed); err != nil {
+		return "", false
+	}
+	data, err := hex.DecodeString(parsed.Content.EventData)
+	if err != nil || len(data)%2 != 0 {
+		return "", false
+	}
+	units := make([]uint16, len(data)/2)
+	for index := range units {
+		units[index] = binary.LittleEndian.Uint16(data[index*2:])
+	}
+	return string(utf16.Decode(units)), true
+}
+
+func PCR11Records(signatures []ReportSignature) []json.RawMessage {
+	var records []json.RawMessage
+	for _, signature := range signatures {
+		for _, encoded := range signature.Data.EventLog {
+			var record struct {
+				PCR int `json:"pcr"`
+			}
+			if err := json.Unmarshal(encoded, &record); err == nil && record.PCR == 11 {
+				records = append(records, encoded)
+			}
+		}
+	}
+	return records
+}
+
+func SysextRecords(signatures []ReportSignature) []json.RawMessage {
+	var records []json.RawMessage
+	for _, signature := range signatures {
+		for _, encoded := range signature.Data.EventLog {
+			var record struct {
+				PCR         int    `json:"pcr"`
+				ContentType string `json:"content_type"`
+			}
+			if err := json.Unmarshal(encoded, &record); err != nil || record.PCR != 13 || record.ContentType != "pcclient_std" {
+				continue
+			}
+			text, ok := eventText(encoded)
+			if ok && strings.Contains(text, "Global system extension initrd") {
+				records = append(records, encoded)
+			}
+		}
+	}
+	return records
+}
+
+func VerifyToken(publicKey *rsa.PublicKey, raw, nonce, token []byte) error {
+	if publicKey == nil {
+		return errors.New("token verification requires an RSA public key")
+	}
+	if len(nonce) != 32 {
+		return errors.New("invalid attestation nonce")
+	}
+	if len(token) != publicKey.Size() {
+		return errors.New("invalid attestation token")
+	}
+	message := make([]byte, 0, len(nonce)+len(raw))
+	message = append(message, nonce...)
+	message = append(message, raw...)
+	digest := sha256.Sum256(message)
+	if err := rsa.VerifyPKCS1v15(publicKey, crypto.SHA256, digest[:], token); err != nil {
+		return errors.New("token signature verification failed")
+	}
+	return nil
+}
+
+func Verify(raw []byte, options Options) (Result, error) {
+	decoded, err := Decode(raw)
+	if err != nil {
+		return Result{}, err
+	}
+	return verify(decoded.JSON, decoded.Raw, decoded.Signatures, options)
+}
+
+func VerifyReport(report []byte, signatures []ReportSignature, options Options) (Result, error) {
+	if options.StrictMutual || options.RequireToken || len(options.Nonce) != 0 || len(options.Token) != 0 || options.ConsumeNonce != nil {
+		return Result{}, errors.New("token verification requires the raw JSON-SEQ report")
+	}
+	return verify(report, nil, signatures, options)
+}
+
+func verify(report, raw []byte, signatures []ReportSignature, options Options) (Result, error) {
+	var result Result
+	if len(signatures) == 0 {
+		return result, errors.New("report contains no signatures")
+	}
+	requireAKAllowlist := options.StrictMutual || options.RequireAKAllowlist || len(options.AllowedAKs) != 0
+	if requireAKAllowlist && len(options.AllowedAKs) == 0 {
+		return result, errors.New("enrolled RSA AK allowlist is empty")
+	}
+	digest := fmt.Sprintf("%x", sha256.Sum256(append([]byte{0x1e}, report...)))
+	componentIndex := 0
+	for _, signature := range signatures {
+		if digest != signature.SHA256 {
+			return result, fmt.Errorf("report digest %s does not match signature %s", digest, signature.SHA256)
+		}
+		if signature.Mechanism != "tpm2" {
+			return result, fmt.Errorf("unsupported signing mechanism %q", signature.Mechanism)
+		}
+		if len(signature.Data.Components) == 0 {
+			return result, errors.New("TPM report contains no components")
+		}
+		publicKey, err := ParseRSAPublicKeyPEM([]byte(signature.Data.PublicKeyPEM))
+		if err != nil {
+			return result, err
+		}
+		if requireAKAllowlist && !allowlisted(publicKey, options.AllowedAKs) {
+			return result, errors.New("TPM public key is not in the enrolled RSA AK allowlist")
+		}
+		fingerprint, err := PublicKeyFingerprint(publicKey)
+		if err != nil {
+			return result, err
+		}
+		result.PublicKeys = append(result.PublicKeys, publicKey)
+		result.AKFingerprints = append(result.AKFingerprints, fingerprint)
+		for _, component := range signature.Data.Components {
+			if component.Signature.SigAlg != "RSASSA" {
+				return result, fmt.Errorf("unsupported signature algorithm %q", component.Signature.SigAlg)
+			}
+			if component.Attest.Attest.Magic != "VALUE" {
+				return result, fmt.Errorf("TPM component %d has invalid magic %q", componentIndex, component.Attest.Attest.Magic)
+			}
+			message, err := MarshalAttestation(component.Attest.Attest)
+			if err != nil {
+				return result, err
+			}
+			signatureBytes, err := hex.DecodeString(component.Signature.Inner.Sig)
+			if err != nil {
+				return result, err
+			}
+			messageDigest := sha256.Sum256(message)
+			if err := rsa.VerifyPKCS1v15(publicKey, crypto.SHA256, messageDigest[:], signatureBytes); err != nil {
+				return result, fmt.Errorf("TPM signature %d failed", componentIndex)
+			}
+			result.ComponentsVerified++
+			componentIndex++
+		}
+		if len(signature.Data.EventLog) == 0 {
+			return result, errors.New("TPM event log is empty")
+		}
+		for index, record := range signature.Data.EventLog {
+			if len(bytes.TrimSpace(record)) == 0 || bytes.Equal(bytes.TrimSpace(record), []byte("null")) {
+				return result, fmt.Errorf("event log record %d is empty", index)
+			}
+		}
+		result.EventLogRecords += len(signature.Data.EventLog)
+		result.SignaturesVerified++
+	}
+	result.PCR11Records = len(PCR11Records(signatures))
+	if (options.StrictMutual || options.RequirePCR11) && result.PCR11Records == 0 {
+		return result, errors.New("TPM event log contains no PCR 11 records")
+	}
+	result.SysextRecords = len(SysextRecords(signatures))
+	if (options.StrictMutual || options.RequireSysext) && result.SysextRecords == 0 {
+		return result, errors.New("TPM event log contains no Global system extension initrd record")
+	}
+	requireToken := options.StrictMutual || options.RequireToken
+	verifyToken := requireToken || len(options.Nonce) != 0 || len(options.Token) != 0 || options.ConsumeNonce != nil
+	if verifyToken {
+		if len(raw) == 0 {
+			return result, errors.New("token verification requires the raw JSON-SEQ report")
+		}
+		if options.StrictMutual && options.ConsumeNonce == nil {
+			return result, errors.New("strict mutual verification requires nonce consumption")
+		}
+		if err := VerifyToken(result.PublicKeys[0], raw, options.Nonce, options.Token); err != nil {
+			return result, err
+		}
+		result.TokenVerified = true
+		if options.ConsumeNonce != nil {
+			if err := options.ConsumeNonce(append([]byte(nil), options.Nonce...)); err != nil {
+				return result, err
+			}
+			result.NonceConsumed = true
+		}
+	}
+	result.Status = "accepted"
+	return result, nil
+}
