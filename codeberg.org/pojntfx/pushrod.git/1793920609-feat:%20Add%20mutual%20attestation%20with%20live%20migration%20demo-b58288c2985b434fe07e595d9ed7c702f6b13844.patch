+		name      string
+		body      func([]byte) []byte
+		errorText string
+	}{
+		{
+			name: "digest",
+			body: func(archive []byte) []byte {
+				body := bytes.Clone(archive)
+				body[0] ^= 0xff
+				return body
+			},
+			errorText: "digest does not match",
+		},
+		{
+			name: "size",
+			body: func(archive []byte) []byte {
+				return append(bytes.Clone(archive), 0)
+			},
+			errorText: "size does not match",
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			fixture := newMutualTestFixture(t)
+			sessionID := fixture.openSession(t)
+			grant, _ := fixture.prepareUpload(t, sessionID)
+			body, _ := fixture.transfer(t, http.MethodPut, grant.GrantID, test.body(fixture.archive), http.StatusBadRequest)
+			if !bytes.Contains(body, []byte(test.errorText)) {
+				t.Fatalf("unexpected checkpoint rejection %s", body)
+			}
+			fixture.assertNoCheckpoint(t, sessionID)
+			fixture.server.mutex.Lock()
+			storedGrant, ok := fixture.server.grants[grant.GrantID]
