+func (fixture *mutualTestFixture) assertNoCheckpoint(t *testing.T, sessionID string) {
+	t.Helper()
+	fixture.server.mutex.Lock()
+	session := fixture.server.sessions[sessionID]
+	checkpoint := session.Checkpoint
+	fixture.server.mutex.Unlock()
+	if checkpoint != nil {
+		t.Fatalf("rejected request installed checkpoint metadata %+v", checkpoint)
+	}
+	if _, err := os.Stat(fixture.checkpointPath(sessionID)); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("rejected request left a checkpoint file: %v", err)
+	}
+	entries, err := os.ReadDir(fixture.server.checkpointDir)
+	if err != nil && !errors.Is(err, os.ErrNotExist) {
+		t.Fatal(err)
+	}
+	if len(entries) != 0 {
+		t.Fatalf("rejected request left %d checkpoint storage entries", len(entries))
+	}
+}
+
+func (fixture *mutualTestFixture) assertNoGrants(t *testing.T, sessionID string) {
+	t.Helper()
+	fixture.server.mutex.Lock()
+	defer fixture.server.mutex.Unlock()
+	if len(fixture.server.grants) != 0 {
+		t.Fatalf("rejected request left %d usable grants", len(fixture.server.grants))
+	}
+	session := fixture.server.sessions[sessionID]
+	if session == nil || session.Checkpoint != nil {
+		t.Fatalf("rejected request changed session checkpoint state %+v", session)
+	}
+}
+
+func forgeMutualConsent(t *testing.T, encoded string) string {
+	t.Helper()
+	raw, err := base64.RawURLEncoding.DecodeString(encoded)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var proof fido2.U2FConsent
+	if err := json.Unmarshal(raw, &proof); err != nil {
+		t.Fatal(err)
+	}
+	signature, err := base64.RawURLEncoding.DecodeString(proof.Signature)
+	if err != nil {
+		t.Fatal(err)
+	}
+	signature[len(signature)-1] ^= 1
+	proof.Signature = base64.RawURLEncoding.EncodeToString(signature)
+	raw, err = json.Marshal(proof)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return base64.RawURLEncoding.EncodeToString(raw)
+}
