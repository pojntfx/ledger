+
+func printMutualJSON(value any) error {
+	encoded, err := json.MarshalIndent(value, "", "  ")
+	if err != nil {
+		return err
+	}
+	fmt.Println(string(encoded))
+	return nil
+}
+
+func printMutualResult(value any, err error) error {
+	if err != nil {
+		return err
+	}
+	return printMutualJSON(value)
+}
+
+func runMutualClient() error {
+	client, err := newMutualClient()
+	if err != nil {
+		return err
+	}
+	if len(os.Args) == 1 || os.Args[1] == "serve" {
+		httpServer := &http.Server{
+			Addr: "0.0.0.0:8084", Handler: mutualClientUIHandler(client), ReadHeaderTimeout: 5 * time.Second,
+			ReadTimeout: 30 * time.Second, WriteTimeout: 30 * time.Second, IdleTimeout: 60 * time.Second, MaxHeaderBytes: 64 * 1024,
+		}
+		return httpServer.ListenAndServe()
+	}
+	switch os.Args[1] {
+	case "open":
+		return printMutualResult(client.open())
+	case "attest":
+		return printMutualResult(client.attest())
+	case "upload":
+		flags := flag.NewFlagSet("upload", flag.ContinueOnError)
+		archive := flags.String("archive", "", "checkpoint archive")
+		if err := flags.Parse(os.Args[2:]); err != nil {
+			return err
+		}
+		if *archive == "" {
+			return errors.New("upload requires -archive")
+		}
+		return printMutualResult(client.upload(*archive))
+	case "download":
+		flags := flag.NewFlagSet("download", flag.ContinueOnError)
+		output := flags.String("output", "", "new checkpoint archive")
+		if err := flags.Parse(os.Args[2:]); err != nil {
+			return err
+		}
+		if *output == "" {
+			return errors.New("download requires -output")
+		}
+		return printMutualResult(client.download(*output))
+	case "complete":
+		return printMutualResult(client.complete())
+	case "observe":
+		return client.observe()
+	default:
+		return errors.New("use serve, open, attest, upload, download, complete, or observe")
+	}
+}
+
+func main() {
+	if err := runMutualClient(); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
diff --git a/buildroot/qemu/scripts/migration/cmd/mutual-migration-client/server_verification.go b/buildroot/qemu/scripts/migration/cmd/mutual-migration-client/server_verification.go
new file mode 100644
index 0000000000000000000000000000000000000000..08ae9c6a4fcd797a5e649bd8d6e9124d6316429f
--- /dev/null
+++ b/buildroot/qemu/scripts/migration/cmd/mutual-migration-client/server_verification.go
@@ -0,0 +1,114 @@
+package main
+
+import (
+	"crypto/rsa"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"rva23/scripts/attestation"
+	migration "rva23/scripts/migration"
+)
+
+func decodeMutualNonce(value string) ([]byte, error) {
+	decoded, err := base64.RawURLEncoding.DecodeString(value)
+	if err != nil || len(decoded) != 32 {
+		return nil, errors.New("mutual challenge nonce must contain 32 bytes")
+	}
+	return decoded, nil
+}
+
+func (client *mutualClient) verifyServer(challenge migration.MutualChallengeResponse) (map[string]string, error) {
+	validation := map[string]string{
+		"serverBinding": "pending", "serverAkSignature": "pending", "hostOsReport": "pending",
+		"eventLog": "pending", "signedSystemExtensions": "pending", "pcr11Profile": "pending",
+		"pcr11Quote": "pending", "freshNonce": "pending", "singleUseNonce": "pending",
+	}
+	if challenge.Binding != (migration.OperationBinding{}) {
+		expected, err := migration.ExpectedOperation(challenge.Binding.Role, challenge.Binding.Counter)
+		if err != nil || challenge.Binding.Operation != expected {
+			return validation, errors.New("server returned an invalid operation binding")
+		}
+	}
+	if challenge.Binding.SessionID != client.state.SessionID || challenge.Binding.InstanceID != client.state.InstanceID || challenge.Binding.PID != client.state.PID || challenge.Binding.Counter != client.state.Counter {
+		return validation, errors.New("server evidence belongs to another session, workload, or counter")
+	}
+	serverNonce, err := decodeMutualNonce(challenge.ServerNonce)
+	if err != nil {
+		return validation, err
+	}
+	clientNonce, err := decodeMutualNonce(challenge.ClientNonce)
+	if err != nil || challenge.ServerNonce == challenge.ClientNonce {
+		return validation, errors.New("server and client challenges must be distinct fresh nonces")
+	}
+	if !time.Now().Before(challenge.ExpiresAt) || challenge.ServerEvidence.Nonce != challenge.ServerNonce {
+		return validation, errors.New("server evidence is expired or uses the wrong nonce")
+	}
+	validation["serverBinding"] = "accepted"
+	key, err := migration.LoadAKPublicKey(client.serverKeyFile)
+	if err != nil {
+		return validation, err
+	}
+	message, err := migration.MutualServerMessage(challenge)
+	if err != nil {
+		return validation, err
+	}
+	if err := migration.VerifyAKSignature(key, message, challenge.ServerSignature); err != nil {
+		return validation, err
+	}
+	validation["serverAkSignature"] = "accepted"
+	if client.productionPCR11 == "" || !strings.EqualFold(client.productionPCR11, challenge.ServerEvidence.PCR11) {
+		return validation, errors.New("server PCR 11 does not match the production profile")
+	}
+	validation["pcr11Profile"] = "accepted"
+	quoteVerifier := client.quoteVerifier
+	if quoteVerifier == nil {
+		quoteVerifier = migration.VerifyPCR11Quote
+	}
+	if err := quoteVerifier(client.serverKeyFile, challenge.ServerNonce, challenge.ServerEvidence); err != nil {
+		return validation, err
+	}
+	validation["pcr11Quote"] = "accepted"
+	rawReport, err := base64.RawURLEncoding.DecodeString(challenge.ServerEvidence.Report)
+	if err != nil || len(rawReport) == 0 {
+		return validation, errors.New("invalid server OS report encoding")
+	}
+	token, err := base64.RawURLEncoding.DecodeString(challenge.ServerEvidence.Token)
+	if err != nil || len(token) == 0 {
+		return validation, errors.New("invalid server report token")
+	}
+	reportVerifier := client.reportVerifier
+	if reportVerifier == nil {
+		reportVerifier = attestation.Verify
+	}
+	result, err := reportVerifier(rawReport, attestation.Options{
+		StrictMutual: true, AllowedAKs: []*rsa.PublicKey{key}, Nonce: serverNonce, Token: token,
+		ConsumeNonce: func(nonce []byte) error {
+			encoded := base64.RawURLEncoding.EncodeToString(nonce)
+			client.mutex.Lock()
+			defer client.mutex.Unlock()
+			for _, used := range client.state.UsedServerNonces {
+				if used == encoded {
+					return errors.New("server evidence nonce is already used")
+				}
+			}
+			client.state.UsedServerNonces = append(client.state.UsedServerNonces, encoded)
+			return client.persist()
+		},
+	})
+	if err != nil {
+		return validation, err
+	}
+	validation["hostOsReport"] = "accepted"
+	validation["eventLog"] = fmt.Sprintf("accepted with %d records and %d PCR 11 records", result.EventLogRecords, result.PCR11Records)
+	validation["signedSystemExtensions"] = fmt.Sprintf("accepted with %d records", result.SysextRecords)
+	validation["freshNonce"] = "accepted"
+	validation["singleUseNonce"] = "consumed"
+	client.mutex.Lock()
+	client.state.ServerIdentity = strings.Join(result.AKFingerprints, ",")
+	client.mutex.Unlock()
+	_ = clientNonce
+	return validation, nil
+}
diff --git a/buildroot/qemu/scripts/migration/cmd/mutual-migration-client/server_verification_test.go b/buildroot/qemu/scripts/migration/cmd/mutual-migration-client/server_verification_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..4014973bf400be73cda0eba1901aa2c020b077fc
--- /dev/null
+++ b/buildroot/qemu/scripts/migration/cmd/mutual-migration-client/server_verification_test.go
@@ -0,0 +1,205 @@
+package main
+
+import (
+	"crypto"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/json"
+	"encoding/pem"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"rva23/scripts/attestation"
+	migration "rva23/scripts/migration"
+)
+
+func signedTestChallenge(t *testing.T, key *rsa.PrivateKey, client *mutualClient) migration.MutualChallengeResponse {
+	t.Helper()
+	challenge := migration.MutualChallengeResponse{
+		Binding:     migration.OperationBinding{SessionID: client.state.SessionID, Role: migration.RoleSource, Operation: migration.OperationSourceAttest, InstanceID: client.state.InstanceID, PID: client.state.PID, Counter: 1},
+		ServerNonce: base64.RawURLEncoding.EncodeToString(bytesOf(31)), ClientNonce: base64.RawURLEncoding.EncodeToString(bytesOf(32)), ExpiresAt: time.Now().Add(time.Minute),
+		ServerEvidence: migration.Evidence{Report: base64.RawURLEncoding.EncodeToString([]byte("report")), Nonce: "", Token: base64.RawURLEncoding.EncodeToString([]byte("token")), PCR11: strings.Repeat("11", 32), PCR11Quote: base64.RawURLEncoding.EncodeToString([]byte("quote")), PCR11Signature: base64.RawURLEncoding.EncodeToString([]byte("quote-signature")), PCR11Selections: base64.RawURLEncoding.EncodeToString([]byte("selections"))},
+	}
+	challenge.ServerEvidence.Nonce = challenge.ServerNonce
+	message, err := migration.MutualServerMessage(challenge)
+	if err != nil {
+		t.Fatal(err)
+	}
+	digest := sha256.Sum256(message)
+	signature, err := rsa.SignPKCS1v15(rand.Reader, key, crypto.SHA256, digest[:])
+	if err != nil {
+		t.Fatal(err)
+	}
+	challenge.ServerSignature = base64.RawURLEncoding.EncodeToString(signature)
+	return challenge
+}
+
+func bytesOf(value byte) []byte {
+	result := make([]byte, 32)
+	for index := range result {
+		result[index] = value
+	}
+	return result
+}
+
+func newTestMutualClient(t *testing.T) (*mutualClient, *rsa.PrivateKey, *atomic.Int64) {
+	t.Helper()
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	directory := t.TempDir()
+	der, err := x509.MarshalPKIXPublicKey(&key.PublicKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	keyPath := filepath.Join(directory, "server.pem")
+	if err := writeTestFile(keyPath, pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: der})); err != nil {
+		t.Fatal(err)
+	}
+	statePath := filepath.Join(directory, "state.json")
+	state := mutualClientState{InstanceID: strings.Repeat("a", 32), PID: 4242, SessionID: strings.Repeat("b", 32), Role: migration.RoleSource, Counter: 1, Phase: "session-opened", ServerVerification: map[string]string{}, ClientTier2: map[string]string{}}
+	if err := saveMutualState(statePath, state); err != nil {
+		t.Fatal(err)
+	}
+	var reports atomic.Int64
+	client := &mutualClient{statePath: statePath, state: state, serverKeyFile: keyPath, productionPCR11: strings.Repeat("11", 32), maxCheckpoint: migration.DefaultMaxCheckpointBytes}
+	client.quoteVerifier = func(string, string, migration.Evidence) error { return nil }
+	client.reportVerifier = func(raw []byte, options attestation.Options) (attestation.Result, error) {
+		reports.Add(1)
+		if err := options.ConsumeNonce(options.Nonce); err != nil {
+			return attestation.Result{}, err
+		}
+		return attestation.Result{EventLogRecords: 1, PCR11Records: 1, SysextRecords: 1, AKFingerprints: []string{"server-ak"}}, nil
+	}
+	return client, key, &reports
+}
+
+func writeTestFile(path string, data []byte) error {
+	return os.WriteFile(path, data, 0o600)
+}
+
+func TestServerVerificationValid(t *testing.T) {
+	client, key, reports := newTestMutualClient(t)
+	challenge := signedTestChallenge(t, key, client)
+	validation, err := client.verifyServer(challenge)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if validation["hostOsReport"] != "accepted" || validation["pcr11Quote"] != "accepted" || validation["singleUseNonce"] != "consumed" {
+		t.Fatalf("unexpected validation: %+v", validation)
+	}
+	if reports.Load() != 1 || client.state.ServerIdentity != "server-ak" {
+		t.Fatal("full report verification did not run in the client")
+	}
+}
+
+func TestServerVerificationRejectsForgedAK(t *testing.T) {
+	client, key, reports := newTestMutualClient(t)
+	challenge := signedTestChallenge(t, key, client)
+	challenge.ServerSignature = base64.RawURLEncoding.EncodeToString(make([]byte, 256))
+	if _, err := client.verifyServer(challenge); err == nil || !strings.Contains(err.Error(), "signature") {
+		t.Fatalf("forged server AK returned %v", err)
+	}
+	if reports.Load() != 0 {
+		t.Fatal("forged server AK reached report verification")
+	}
+}
+
+func TestServerVerificationRejectsWrongPCR(t *testing.T) {
+	client, key, reports := newTestMutualClient(t)
+	challenge := signedTestChallenge(t, key, client)
+	challenge.ServerEvidence.PCR11 = strings.Repeat("22", 32)
+	message, err := migration.MutualServerMessage(challenge)
+	if err != nil {
+		t.Fatal(err)
+	}
+	digest := sha256.Sum256(message)
+	signature, err := rsa.SignPKCS1v15(rand.Reader, key, crypto.SHA256, digest[:])
+	if err != nil {
+		t.Fatal(err)
+	}
+	challenge.ServerSignature = base64.RawURLEncoding.EncodeToString(signature)
+	if _, err := client.verifyServer(challenge); err == nil || !strings.Contains(err.Error(), "production") {
+		t.Fatalf("wrong PCR returned %v", err)
+	}
+	if reports.Load() != 0 {
+		t.Fatal("wrong PCR reached report verification")
+	}
+}
+
+func TestServerVerificationRejectsMissingEventLog(t *testing.T) {
+	client, key, _ := newTestMutualClient(t)
+	client.reportVerifier = func([]byte, attestation.Options) (attestation.Result, error) {
+		return attestation.Result{}, errors.New("TPM event log is empty")
+	}
+	challenge := signedTestChallenge(t, key, client)
+	if _, err := client.verifyServer(challenge); err == nil || !strings.Contains(err.Error(), "event log") {
+		t.Fatalf("missing event log returned %v", err)
+	}
+}
+
+func TestServerVerificationRejectsReplay(t *testing.T) {
+	client, key, reports := newTestMutualClient(t)
+	challenge := signedTestChallenge(t, key, client)
+	if _, err := client.verifyServer(challenge); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := client.verifyServer(challenge); err == nil || !strings.Contains(err.Error(), "already used") {
+		t.Fatalf("replayed server evidence returned %v", err)
+	}
+	if reports.Load() != 2 {
+		t.Fatal("replay did not reach the single-use nonce guard")
+	}
+}
+
+func TestServerFailuresBlockProtectedOperation(t *testing.T) {
+	failures := []struct {
+		name  string
+		cause string
+	}{
+		{"forged-server-AK", "AK signature does not match the enrolled identity"},
+		{"wrong-server-PCR11", "server PCR 11 does not match the production profile"},
+		{"missing-server-event-log", "TPM event log is empty"},
+		{"replayed-server-evidence", "server evidence nonce is already used"},
+	}
+	for _, failure := range failures {
+		t.Run(failure.name, func(t *testing.T) {
+			client, key, _ := newTestMutualClient(t)
+			challenge := signedTestChallenge(t, key, client)
+			var operations atomic.Int64
+			upstream := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+				if request.URL.Path != "/v1/mutual/challenges" {
+					operations.Add(1)
+					writer.WriteHeader(http.StatusForbidden)
+					return
+				}
+				writer.Header().Set("Content-Type", "application/json")
+				_ = json.NewEncoder(writer).Encode(challenge)
+			}))
+			defer upstream.Close()
+			client.baseURL = upstream.URL
+			client.httpClient = upstream.Client()
+			client.serverVerifier = func(migration.MutualChallengeResponse) (map[string]string, error) {
+				return map[string]string{"hostOsReport": "rejected"}, errors.New(failure.cause)
+			}
+			client.state.Counter = 0
+			if _, err := client.authorize(); err == nil {
+				t.Fatal("failed server verification authorized a protected operation")
+			}
+			if operations.Load() != 0 {
+				t.Fatal("failed server verification reached a protected operation or transfer")
+			}
+		})
+	}
+}
diff --git a/buildroot/qemu/scripts/migration/cmd/mutual-migration-server/mutual-migration-server.go b/buildroot/qemu/scripts/migration/cmd/mutual-migration-server/mutual-migration-server.go
new file mode 100644
index 0000000000000000000000000000000000000000..98a3aaa3ecb605e774019118388d5e74f69e92fc
--- /dev/null
+++ b/buildroot/qemu/scripts/migration/cmd/mutual-migration-server/mutual-migration-server.go
@@ -0,0 +1,713 @@
+package main
+
+import (
+	"bytes"
+	"crypto/rsa"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"encoding/pem"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"rva23/scripts/attestation"
+	"rva23/scripts/fido2"
+	migration "rva23/scripts/migration"
+)
+
+const (
+	maxMutualChallengeBody = 64 * 1024
+	maxMutualOperationBody = 4 * 1024 * 1024
+	maxMutualHistory       = 64
+)
+
+type mutualChallenge struct {
+	Binding     migration.OperationBinding
+	ServerNonce string
+	ClientNonce string
+	ExpiresAt   time.Time
+}
+
+type mutualSession struct {
+	SessionID         string                        `json:"sessionId"`
+	InstanceID        string                        `json:"instanceId"`
+	PID               int                           `json:"pid"`
+	Counter           uint64                        `json:"counter"`
+	Phase             string                        `json:"phase"`
+	Checkpoint        *migration.CheckpointMetadata `json:"checkpoint,omitempty"`
+	SourceTier2       map[string]string             `json:"sourceTier2"`
+	DestinationTier2  map[string]string             `json:"destinationTier2"`
+	SourceUserID      int                           `json:"sourceUserId"`
+	DestinationUserID int                           `json:"destinationUserId"`
+	UpdatedAt         time.Time                     `json:"updatedAt"`
+}
+
+type mutualGrantRecord struct {
+	Binding   migration.OperationBinding
+	ExpiresAt time.Time
+}
+
+type mutualRequestRecord struct {
+	At             time.Time                     `json:"at"`
+	Direction      string                        `json:"direction"`
+	Operation      string                        `json:"operation"`
+	Binding        *migration.OperationBinding   `json:"binding,omitempty"`
+	ServerEvidence *migration.Evidence           `json:"serverEvidence,omitempty"`
+	Validation     map[string]string             `json:"validation"`
+	Checkpoint     *migration.CheckpointMetadata `json:"checkpoint,omitempty"`
+	Response       any                           `json:"response,omitempty"`
+	Error          string                        `json:"error,omitempty"`
+}
+
+type mutualServerState struct {
+	ServerGuest     string                `json:"serverGuest"`
+	ProductionPCR11 string                `json:"productionPcr11"`
+	ServerIdentity  string                `json:"serverIdentity"`
+	ServerEvidence  *migration.Evidence   `json:"serverEvidence,omitempty"`
+	Sessions        []mutualSession       `json:"sessions"`
+	Latest          *mutualRequestRecord  `json:"latest"`
+	History         []mutualRequestRecord `json:"history"`
+}
+
+type mutualMigrationServer struct {
+	serverKey        *rsa.PublicKey
+	serverKeyFile    string
+	clientKeys       map[string]*rsa.PublicKey
+	certificates     map[string][]byte
+	productionPCR11  string
+	checkpointDir    string
+	now              func() time.Time
+	generateEvidence func(string) (migration.Evidence, error)
+	sign             func([]byte) (string, error)
+	mutex            sync.Mutex
+	challengeMutex   sync.Mutex
+	sessions         map[string]*mutualSession
+	challenges       map[string]mutualChallenge
+	grants           map[string]mutualGrantRecord
+	stateMutex       sync.RWMutex
+	latest           *mutualRequestRecord
+	history          []mutualRequestRecord
+	serverEvidence   *migration.Evidence
+}
+
+func mutualServerEnvironment(name, fallback string) string {
+	if value := os.Getenv(name); value != "" {
+		return value
+	}
+	return fallback
+}
+
+func writeMutualJSON(writer http.ResponseWriter, status int, value any) {
+	writer.Header().Set("Content-Type", "application/json")
+	writer.WriteHeader(status)
+	_ = json.NewEncoder(writer).Encode(value)
+}
+
+func mutualMethodNotAllowed(writer http.ResponseWriter, method string) {
+	writer.Header().Set("Allow", method)
+	writeMutualJSON(writer, http.StatusMethodNotAllowed, map[string]string{"error": "method not allowed"})
+}
+
+func decodeMutualJSON(data []byte, output any) error {
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(output); err != nil {
+		return err
+	}
+	var extra any
+	if err := decoder.Decode(&extra); !errors.Is(err, io.EOF) {
+		return errors.New("request must contain one JSON value")
+	}
+	return nil
+}
+
+func (server *mutualMigrationServer) record(record mutualRequestRecord) {
+	server.stateMutex.Lock()
+	defer server.stateMutex.Unlock()
+	latest := record
+	server.latest = &latest
+	server.history = append([]mutualRequestRecord{record}, server.history...)
+	if len(server.history) > maxMutualHistory {
+		server.history = server.history[:maxMutualHistory]
+	}
+}
+
+func (server *mutualMigrationServer) reject(writer http.ResponseWriter, record mutualRequestRecord, status int, err error) {
+	record.Error = err.Error()
+	server.record(record)
+	writeMutualJSON(writer, status, map[string]string{"error": err.Error()})
+}
+
+func (server *mutualMigrationServer) sessionHandler(writer http.ResponseWriter, request *http.Request) {
+	if request.URL.Path == "/v1/mutual/sessions" {
+		if request.Method != http.MethodPost {
+			mutualMethodNotAllowed(writer, http.MethodPost)
+			return
+		}
+		raw, err := io.ReadAll(http.MaxBytesReader(writer, request.Body, maxMutualChallengeBody))
+		if err != nil {
+			writeMutualJSON(writer, http.StatusBadRequest, map[string]string{"error": "invalid session body"})
+			return
+		}
+		var input migration.MutualSessionRequest
+		if err := decodeMutualJSON(raw, &input); err != nil {
+			writeMutualJSON(writer, http.StatusBadRequest, map[string]string{"error": "invalid session JSON"})
+			return
+		}
+		if err := migration.ValidateInstanceID(input.InstanceID); err != nil || input.PID <= 0 {
+			writeMutualJSON(writer, http.StatusBadRequest, map[string]string{"error": "invalid workload identity or PID"})
+			return
+		}
+		sessionID, err := migration.RandomID()
+		if err != nil {
+			writeMutualJSON(writer, http.StatusInternalServerError, map[string]string{"error": err.Error()})
+			return
+		}
+		now := server.now().UTC()
+		session := &mutualSession{SessionID: sessionID, InstanceID: input.InstanceID, PID: input.PID, Phase: "session-opened", SourceTier2: map[string]string{}, DestinationTier2: map[string]string{}, SourceUserID: 1, DestinationUserID: 2, UpdatedAt: now}
+		server.mutex.Lock()
+		for _, existing := range server.sessions {
+			if existing.InstanceID == input.InstanceID && existing.Phase != "completed" {
+				server.mutex.Unlock()
+				writeMutualJSON(writer, http.StatusConflict, map[string]string{"error": "workload already has an active migration session"})
+				return
+			}
+		}
+		server.sessions[sessionID] = session
+		server.mutex.Unlock()
+		server.record(mutualRequestRecord{At: now, Direction: "session", Operation: "open-session", Validation: map[string]string{"dedicatedServerGuest": "accepted"}, Response: migration.MutualSessionResponse{SessionID: sessionID}})
+		writeMutualJSON(writer, http.StatusCreated, migration.MutualSessionResponse{SessionID: sessionID})
+		return
+	}
+	if request.Method != http.MethodGet {
+		mutualMethodNotAllowed(writer, http.MethodGet)
+		return
+	}
+	sessionID := strings.TrimPrefix(request.URL.Path, "/v1/mutual/sessions/")
+	if err := migration.ValidateSessionID(sessionID); err != nil {
+		writeMutualJSON(writer, http.StatusBadRequest, map[string]string{"error": err.Error()})
+		return
+	}
+	server.mutex.Lock()
+	defer server.mutex.Unlock()
+	session := server.sessions[sessionID]
+	if session == nil {
+		writeMutualJSON(writer, http.StatusNotFound, map[string]string{"error": "migration session not found"})
+		return
+	}
+	writeMutualJSON(writer, http.StatusOK, *session)
+}
+
+func (server *mutualMigrationServer) challengeHandler(writer http.ResponseWriter, request *http.Request) {
+	if request.Method != http.MethodPost {
+		mutualMethodNotAllowed(writer, http.MethodPost)
+		return
+	}
+	raw, readErr := io.ReadAll(http.MaxBytesReader(writer, request.Body, maxMutualChallengeBody))
+	record := mutualRequestRecord{At: server.now().UTC(), Direction: "server-to-client", Operation: "server-challenge", Validation: map[string]string{"serverGuest": "dedicated QEMU guest", "hostOsReport": "pending", "pcr11Profile": "pending", "freshNonce": "pending", "singleUseNonce": "outstanding"}}
+	if readErr != nil {
+		server.reject(writer, record, http.StatusBadRequest, errors.New("invalid mutual challenge body"))
+		return
+	}
+	var input migration.MutualChallengeRequest
+	if err := decodeMutualJSON(raw, &input); err != nil {
+		server.reject(writer, record, http.StatusBadRequest, fmt.Errorf("invalid mutual challenge JSON: %w", err))
+		return
+	}
+	record.Binding = &input.Binding
+	record.Operation = input.Binding.Operation
+	if err := migration.ValidateBinding(input.Binding); err != nil {
+		server.reject(writer, record, http.StatusBadRequest, err)
+		return
+	}
+	server.challengeMutex.Lock()
+	defer server.challengeMutex.Unlock()
+	server.mutex.Lock()
+	session := server.sessions[input.Binding.SessionID]
+	valid := session != nil && session.InstanceID == input.Binding.InstanceID && session.PID == input.Binding.PID && session.Counter+1 == input.Binding.Counter
+	if valid && migration.RequiresCheckpoint(input.Binding.Operation) && input.Binding.Operation != migration.OperationUpload {
+		valid = session.Checkpoint != nil && session.Checkpoint.SHA256 == input.Binding.CheckpointSHA256 && session.Checkpoint.Size == input.Binding.CheckpointSize
+	}
+	server.mutex.Unlock()
+	if !valid {
+		server.reject(writer, record, http.StatusForbidden, errors.New("operation does not match the migration session, counter, or signed checkpoint"))
+		return
+	}
+	serverNonce, err := migration.RandomNonce()
+	if err != nil {
+		server.reject(writer, record, http.StatusInternalServerError, err)
+		return
+	}
+	clientNonce, err := migration.RandomNonce()
+	if err != nil {
+		server.reject(writer, record, http.StatusInternalServerError, err)
+		return
+	}
+	evidence, err := server.generateEvidence(serverNonce)
+	if err != nil {
+		server.reject(writer, record, http.StatusInternalServerError, err)
+		return
+	}
+	record.ServerEvidence = &evidence
+	server.stateMutex.Lock()
+	server.serverEvidence = &evidence
+	server.stateMutex.Unlock()
+	record.Validation["hostOsReport"] = "generated inside migration server guest"
+	if !strings.EqualFold(evidence.PCR11, server.productionPCR11) {
+		server.reject(writer, record, http.StatusForbidden, errors.New("migration server is not running the production OS profile"))
+		return
+	}
+	record.Validation["pcr11Profile"] = "accepted"
+	response := migration.MutualChallengeResponse{Binding: input.Binding, ServerNonce: serverNonce, ClientNonce: clientNonce, ExpiresAt: server.now().Add(migration.MutualChallengeLifetime).UTC(), ServerEvidence: evidence}
+	message, err := migration.MutualServerMessage(response)
+	if err != nil {
+		server.reject(writer, record, http.StatusInternalServerError, err)
+		return
+	}
+	response.ServerSignature, err = server.sign(message)
+	if err != nil {
+		server.reject(writer, record, http.StatusInternalServerError, err)
+		return
+	}
+	server.mutex.Lock()
+	server.challenges[clientNonce] = mutualChallenge{Binding: input.Binding, ServerNonce: serverNonce, ClientNonce: clientNonce, ExpiresAt: response.ExpiresAt}
+	server.mutex.Unlock()
+	record.Validation["freshNonce"] = "separate fresh server and client challenges"
+	record.Response = map[string]string{"status": "challenged"}
+	server.record(record)
+	writeMutualJSON(writer, http.StatusOK, response)
+}
+
+func consentPublicDER(encoded string) ([]byte, error) {
+	block, rest := pem.Decode([]byte(encoded))
+	if block == nil || block.Type != "PUBLIC KEY" || len(rest) != 0 {
+		return nil, errors.New("invalid FIDO2 consent public key PEM")
+	}
+	return block.Bytes, nil
+}
+
+func decodeConsentProof(encoded, identity string) (attestation.Proof, error) {
+	var result attestation.Proof
+	raw, err := base64.RawURLEncoding.DecodeString(encoded)
+	if err != nil {
+		return result, errors.New("invalid FIDO2 consent encoding")
+	}
+	var proof fido2.U2FConsent
+	if err := json.Unmarshal(raw, &proof); err != nil {
+		return result, errors.New("invalid FIDO2 consent JSON")
+	}
+	certificate, err := base64.RawURLEncoding.DecodeString(proof.Certificate)
+	if err != nil {
+		return result, errors.New("invalid FIDO2 certificate encoding")
+	}
+	publicKey, err := consentPublicDER(proof.PublicKey)
+	if err != nil {
+		return result, err
+	}
+	keyHandle, err := base64.RawURLEncoding.DecodeString(proof.KeyHandle)
+	if err != nil {
+		return result, errors.New("invalid FIDO2 key handle")
+	}
+	registrationChallenge, err := base64.RawURLEncoding.DecodeString(proof.RegistrationChallenge)
+	if err != nil || len(registrationChallenge) != 32 {
+		return result, errors.New("invalid FIDO2 registration challenge")
+	}
+	registrationSignature, err := base64.RawURLEncoding.DecodeString(proof.RegistrationSignature)
+	if err != nil {
+		return result, errors.New("invalid FIDO2 registration signature")
+	}
+	consentSignature, err := base64.RawURLEncoding.DecodeString(proof.Signature)
+	if err != nil {
+		return result, errors.New("invalid FIDO2 consent signature")
+	}
+	result = attestation.Proof{Identity: identity, CertificateDER: certificate, ConsentPublicKeyDER: publicKey, KeyHandle: keyHandle, RegistrationSignature: registrationSignature, UserPresence: 1, Counter: proof.Counter, ConsentSignature: consentSignature}
+	copy(result.RegistrationChallenge[:], registrationChallenge)
+	return result, nil
+}
+
+func (server *mutualMigrationServer) operationHandler(writer http.ResponseWriter, request *http.Request) {
+	if request.Method != http.MethodPost {
+		mutualMethodNotAllowed(writer, http.MethodPost)
+		return
+	}
+	raw, readErr := io.ReadAll(http.MaxBytesReader(writer, request.Body, maxMutualOperationBody))
+	record := mutualRequestRecord{At: server.now().UTC(), Direction: "client-to-server", Operation: "Tier-2-authorization", Validation: map[string]string{"tpmAkSignature": "pending", "fido2Certificate": "pending", "fido2RegistrationAttestation": "pending", "fido2Consent": "pending", "hostOsReport": "not required for Tier 2", "freshNonce": "pending", "singleUseNonce": "pending", "counter": "pending", "checkpointDigest": "pending"}}
+	if readErr != nil {
+		server.reject(writer, record, http.StatusBadRequest, errors.New("invalid Tier 2 operation body"))
+		return
+	}
+	var input migration.MutualOperationRequest
+	if err := decodeMutualJSON(raw, &input); err != nil {
+		server.reject(writer, record, http.StatusBadRequest, fmt.Errorf("invalid Tier 2 operation JSON: %w", err))
+		return
+	}
+	record.Binding = &input.Binding
+	record.Operation = input.Binding.Operation
+	if err := migration.ValidateBinding(input.Binding); err != nil {
+		server.reject(writer, record, http.StatusBadRequest, err)
+		return
+	}
+	server.mutex.Lock()
+	challenge, ok := server.challenges[input.ClientNonce]
+	session := server.sessions[input.Binding.SessionID]
+	server.mutex.Unlock()
+	if !ok || challenge.Binding != input.Binding || challenge.ServerNonce != input.ServerNonce || !server.now().Before(challenge.ExpiresAt) || session == nil || session.Counter+1 != input.Binding.Counter {
+		server.reject(writer, record, http.StatusForbidden, errors.New("client challenge is expired, unknown, already used, or bound to another operation"))
+		return
+	}
+	record.Validation["freshNonce"] = "accepted"
+	message, err := migration.MutualClientMessage(input)
+	if err != nil {
+		server.reject(writer, record, http.StatusBadRequest, err)
+		return
+	}
+	if err := migration.VerifyAKSignature(server.clientKeys[input.Binding.Role], message, input.Signature); err != nil {
+		server.reject(writer, record, http.StatusForbidden, err)
+		return
+	}
+	record.Validation["tpmAkSignature"] = "accepted"
+	proof, err := decodeConsentProof(input.ConsentProof, input.Binding.Role)
+	if err != nil {
+		server.reject(writer, record, http.StatusForbidden, err)
+		return
+	}
+	application, err := migration.MutualApplication(input.Binding.SessionID)
+	if err != nil {
+		server.reject(writer, record, http.StatusBadRequest, err)
+		return
+	}
+	consentMessage, err := migration.MutualConsentMessage(input)
+	if err != nil {
+		server.reject(writer, record, http.StatusBadRequest, err)
+		return
+	}
+	var applicationDigest, operationChallenge [32]byte
+	copy(applicationDigest[:], application)
+	copy(operationChallenge[:], migration.MutualConsentChallenge(consentMessage))
+	if err := attestation.VerifyProof(proof, attestation.VerificationInput{AllowlistedCertificates: server.certificates, ApplicationDigest: applicationDigest, OperationChallenge: operationChallenge}); err != nil {
+		server.reject(writer, record, http.StatusForbidden, err)
+		return
+	}
+	record.Validation["fido2Certificate"] = "accepted"
+	record.Validation["fido2RegistrationAttestation"] = "accepted"
+	record.Validation["fido2Consent"] = "accepted"
+	if migration.RequiresCheckpoint(input.Binding.Operation) {
+		record.Validation["checkpointDigest"] = "accepted in signed authorization"
+	} else {
+		record.Validation["checkpointDigest"] = "not required before dump"
+	}
+	response := migration.MutualGrant{Status: "accepted", Binding: input.Binding}
+	if input.Binding.Operation == migration.OperationUpload || input.Binding.Operation == migration.OperationDownload {
+		response.GrantID, err = migration.RandomID()
+		if err != nil {
+			server.reject(writer, record, http.StatusInternalServerError, err)
+			return
+		}
+		response.ExpiresAt = server.now().Add(migration.MutualChallengeLifetime).UTC()
+	}
+	now := server.now().UTC()
+	server.mutex.Lock()
+	challenge, ok = server.challenges[input.ClientNonce]
+	session = server.sessions[input.Binding.SessionID]
+	if !ok || challenge.Binding != input.Binding || session == nil || session.Counter+1 != input.Binding.Counter {
+		server.mutex.Unlock()
+		server.reject(writer, record, http.StatusForbidden, errors.New("client challenge or counter changed during authorization"))
+		return
+	}
+	delete(server.challenges, input.ClientNonce)
+	session.Counter = input.Binding.Counter
+	session.UpdatedAt = now
+	record.Validation["singleUseNonce"] = "consumed"
+	record.Validation["counter"] = "accepted"
+	validation := make(map[string]string)
+	for key, value := range record.Validation {
+		validation[key] = value
+	}
+	if input.Binding.Role == migration.RoleSource {
+		session.SourceTier2 = validation
+	} else {
+		session.DestinationTier2 = validation
+	}
+	if input.Binding.Operation == migration.OperationComplete {
+		session.Phase = "completed"
+	} else {
+		session.Phase = "authorized-" + input.Binding.Operation
+	}
+	if response.GrantID != "" {
+		server.grants[response.GrantID] = mutualGrantRecord{Binding: input.Binding, ExpiresAt: response.ExpiresAt}
+	}
+	server.mutex.Unlock()
+	record.Response = response
+	server.record(record)
+	writeMutualJSON(writer, http.StatusOK, response)
+}
+
+func (server *mutualMigrationServer) transferHandler(writer http.ResponseWriter, request *http.Request) {
+	grantID := strings.TrimPrefix(request.URL.Path, "/v1/mutual/transfers/")
+	record := mutualRequestRecord{At: server.now().UTC(), Direction: "protected-transfer", Operation: "checkpoint-transfer", Validation: map[string]string{"attestationGrant": "pending", "checkpointDigest": "pending", "checkpointSize": "pending", "singleUseNonce": "pending"}}
+	if err := migration.ValidateSessionID(grantID); err != nil {
+		server.reject(writer, record, http.StatusBadRequest, errors.New("invalid transfer grant"))
+		return
+	}
+	server.mutex.Lock()
+	grant, ok := server.grants[grantID]
+	session := server.sessions[grant.Binding.SessionID]
+	server.mutex.Unlock()
+	record.Binding = &grant.Binding
+	record.Operation = grant.Binding.Operation
+	if !ok || !server.now().Before(grant.ExpiresAt) || session == nil {
+		server.reject(writer, record, http.StatusForbidden, errors.New("transfer grant is expired, unknown, or already used"))
+		return
+	}
+	record.Validation["attestationGrant"] = "accepted"
+	switch grant.Binding.Operation {
+	case migration.OperationUpload:
+		if request.Method != http.MethodPut {
+			mutualMethodNotAllowed(writer, http.MethodPut)
+			return
+		}
+		if err := os.MkdirAll(server.checkpointDir, 0o700); err != nil {
+			server.reject(writer, record, http.StatusInternalServerError, err)
+			return
+		}
+		temporary, err := os.CreateTemp(server.checkpointDir, ".mutual-upload-")
+		if err != nil {
+			server.reject(writer, record, http.StatusInternalServerError, err)
+			return
+		}
+		temporaryPath := temporary.Name()
+		completed := false
+		defer func() {
+			temporary.Close()
+			if !completed {
+				os.Remove(temporaryPath)
+			}
+		}()
+		hash := sha256.New()
+		written, err := io.Copy(io.MultiWriter(temporary, hash), io.LimitReader(request.Body, migration.DefaultMaxCheckpointBytes+1))
+		if err != nil {
+			server.reject(writer, record, http.StatusBadRequest, err)
+			return
+		}
+		if written != grant.Binding.CheckpointSize || written > migration.DefaultMaxCheckpointBytes {
+			server.reject(writer, record, http.StatusBadRequest, errors.New("checkpoint body size does not match the signed authorization"))
+			return
+		}
+		record.Validation["checkpointSize"] = "accepted"
+		digest := hex.EncodeToString(hash.Sum(nil))
+		if digest != grant.Binding.CheckpointSHA256 {
+			server.reject(writer, record, http.StatusBadRequest, errors.New("checkpoint body digest does not match the signed authorization"))
+			return
+		}
+		record.Validation["checkpointDigest"] = "accepted"
+		if err := temporary.Sync(); err != nil {
+			server.reject(writer, record, http.StatusInternalServerError, err)
+			return
+		}
+		if err := temporary.Close(); err != nil {
+			server.reject(writer, record, http.StatusInternalServerError, err)
+			return
+		}
+		metadata := migration.CheckpointMetadata{InstanceID: grant.Binding.InstanceID, SHA256: digest, Size: written, UploadedAt: server.now().UTC()}
+		server.mutex.Lock()
+		if _, ok := server.grants[grantID]; !ok {
+			server.mutex.Unlock()
+			server.reject(writer, record, http.StatusForbidden, errors.New("transfer grant is already used"))
+			return
+		}
+		delete(server.grants, grantID)
+		server.mutex.Unlock()
+		finalPath := filepath.Join(server.checkpointDir, grant.Binding.SessionID+".tar.gz")
+		if err := os.Rename(temporaryPath, finalPath); err != nil {
+			server.reject(writer, record, http.StatusInternalServerError, err)
+			return
+		}
+		completed = true
+		server.mutex.Lock()
+		session.Checkpoint = &metadata
+		session.Phase = "checkpoint-uploaded"
+		session.UpdatedAt = server.now().UTC()
+		server.mutex.Unlock()
+		record.Validation["singleUseNonce"] = "consumed"
+		record.Checkpoint = &metadata
+		record.Response = map[string]string{"status": "uploaded"}
+		server.record(record)
+		writeMutualJSON(writer, http.StatusCreated, record.Response)
+	case migration.OperationDownload:
+		if request.Method != http.MethodPost {
+			mutualMethodNotAllowed(writer, http.MethodPost)
+			return
+		}
+		server.mutex.Lock()
+		metadata := session.Checkpoint
+		valid := metadata != nil && metadata.SHA256 == grant.Binding.CheckpointSHA256 && metadata.Size == grant.Binding.CheckpointSize
+		if valid {
+			delete(server.grants, grantID)
+			session.Phase = "checkpoint-downloaded"
+			session.UpdatedAt = server.now().UTC()
+		}
+		server.mutex.Unlock()
+		if !valid {
+			server.reject(writer, record, http.StatusForbidden, errors.New("stored checkpoint does not match the signed download authorization"))
+			return
+		}
+		archive, err := os.Open(filepath.Join(server.checkpointDir, grant.Binding.SessionID+".tar.gz"))
+		if err != nil {
+			server.reject(writer, record, http.StatusInternalServerError, err)
+			return
+		}
+		defer archive.Close()
+		record.Validation["checkpointDigest"] = "accepted"
+		record.Validation["checkpointSize"] = "accepted"
+		record.Validation["singleUseNonce"] = "consumed"
+		record.Checkpoint = metadata
+		record.Response = map[string]string{"status": "downloaded"}
+		server.record(record)
+		writer.Header().Set("Content-Type", "application/gzip")
+		writer.Header().Set("Content-Length", fmt.Sprint(metadata.Size))
+		writer.Header().Set("X-Checkpoint-SHA256", metadata.SHA256)
+		writer.WriteHeader(http.StatusOK)
+		_, _ = io.CopyN(writer, archive, metadata.Size)
+	default:
+		server.reject(writer, record, http.StatusForbidden, errors.New("grant does not authorize a checkpoint transfer"))
+	}
+}
+
+func (server *mutualMigrationServer) stateHandler(writer http.ResponseWriter, request *http.Request) {
+	if request.Method != http.MethodGet {
+		mutualMethodNotAllowed(writer, http.MethodGet)
+		return
+	}
+	fingerprint, err := attestation.PublicKeyFingerprint(server.serverKey)
+	if err != nil {
+		writeMutualJSON(writer, http.StatusInternalServerError, map[string]string{"error": err.Error()})
+		return
+	}
+	server.stateMutex.RLock()
+	response := mutualServerState{ServerGuest: "dedicated QEMU migration server guest", ProductionPCR11: server.productionPCR11, ServerIdentity: fingerprint, History: append([]mutualRequestRecord(nil), server.history...)}
+	if server.latest != nil {
+		latest := *server.latest
+		response.Latest = &latest
+	}
+	if server.serverEvidence != nil {
+		evidence := *server.serverEvidence
+		response.ServerEvidence = &evidence
+	}
+	server.stateMutex.RUnlock()
+	server.mutex.Lock()
+	for _, session := range server.sessions {
+		response.Sessions = append(response.Sessions, *session)
+	}
+	server.mutex.Unlock()
+	if response.Sessions == nil {
+		response.Sessions = []mutualSession{}
+	}
+	if response.History == nil {
+		response.History = []mutualRequestRecord{}
+	}
+	writeMutualJSON(writer, http.StatusOK, response)
+}
+
+func mutualServerUIHandler(writer http.ResponseWriter, request *http.Request) {
+	if request.URL.Path != "/" {
+		http.NotFound(writer, request)
+		return
+	}
+	if request.Method != http.MethodGet {
+		mutualMethodNotAllowed(writer, http.MethodGet)
+		return
+	}
+	writer.Header().Set("Content-Type", "text/html; charset=utf-8")
+	_, _ = io.WriteString(writer, mutualServerHTML)
+}
+
+const mutualServerHTML = `<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Mutual migration server</title></head>
+<body><h1>Mutual migration server</h1><p><button id="refresh" type="button">Refresh</button> <span id="status">Loading</span></p><div id="summary">Loading</div><details open><summary>Attestation and migration records</summary><div id="history">Loading</div></details>
+<script>
+function label(key){const names={serverGuest:'Migration server location',productionPcr11:'Production PCR 11',serverIdentity:'Enrolled server AK fingerprint',serverEvidence:'Server full OS report and TPM evidence',sourceTier2:'Source Tier 2 result',destinationTier2:'Destination Tier 2 result',instanceId:'Instance ID',pid:'PID',sessionId:'Session ID',checkpointSha256:'Checkpoint SHA-256',freshNonce:'Fresh challenges',singleUseNonce:'Single-use challenges',tpmAkSignature:'TPM AK identity binding',hostOsReport:'Host OS report',fido2RegistrationAttestation:'FIDO2 registration attestation',fido2Consent:'FIDO2 consent'};if(names[key])return names[key];const text=key.replace(/([a-z0-9])([A-Z])/g,'$1 $2');return text.charAt(0).toUpperCase()+text.slice(1)}
+function scalar(value){if(value===null||value===undefined||value==='')return 'None';return String(value)}
+function render(name,value){if(value===null||typeof value!=='object'){const content=scalar(value);if(content.length>160){const details=document.createElement('details');const summary=document.createElement('summary');summary.textContent=name+' ('+content.length+' characters)';const pre=document.createElement('pre');pre.textContent=content;details.append(summary,pre);return details}return document.createTextNode(content)}const entries=Array.isArray(value)?value.map((entry,index)=>['Item '+(index+1),entry]):Object.entries(value);const table=document.createElement('table');const body=document.createElement('tbody');for(const [key,entry] of entries){const row=document.createElement('tr');const heading=document.createElement('th');heading.scope='row';heading.textContent=label(key);const cell=document.createElement('td');cell.append(render(label(key),entry));row.append(heading,cell);body.append(row)}table.append(body);return table}
+function raw(value){const details=document.createElement('details');const summary=document.createElement('summary');summary.textContent='Raw JSON';const pre=document.createElement('pre');pre.textContent=JSON.stringify(value,null,2);details.append(summary,pre);return details}
+function entry(item){const details=document.createElement('details');const summary=document.createElement('summary');summary.textContent=(item.at||'Unknown')+' | '+(item.direction||'Unknown')+' | '+(item.operation||'Unknown')+' | '+(item.error||'accepted');details.append(summary,render('Record',item),raw(item));return details}
+async function refresh(){const status=document.getElementById('status');try{const response=await fetch('/api/state');if(!response.ok)throw new Error(response.statusText);const data=await response.json();document.getElementById('summary').replaceChildren(render('Server and sessions',{serverGuest:data.serverGuest,serverIdentity:data.serverIdentity,productionPcr11:data.productionPcr11,serverEvidence:data.serverEvidence,sessions:data.sessions}),raw({serverEvidence:data.serverEvidence,sessions:data.sessions}));document.getElementById('history').replaceChildren(...(data.history||[]).map(entry));status.textContent=data.latest?'Updated '+data.latest.at:'No requests'}catch(error){status.textContent='Refresh failed: '+error.message}}
+document.getElementById('refresh').onclick=refresh;refresh()
+</script></body></html>`
+
+func newMutualHTTPHandler(server *mutualMigrationServer) http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("/v1/mutual/sessions", server.sessionHandler)
+	mux.HandleFunc("/v1/mutual/sessions/", server.sessionHandler)
+	mux.HandleFunc("/v1/mutual/challenges", server.challengeHandler)
+	mux.HandleFunc("/v1/mutual/operations", server.operationHandler)
+	mux.HandleFunc("/v1/mutual/transfers/", server.transferHandler)
+	mux.HandleFunc("/api/state", server.stateHandler)
+	mux.HandleFunc("/", mutualServerUIHandler)
+	return mux
+}
+
+func loadCertificate(path string) ([]byte, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	block, rest := pem.Decode(data)
+	if block == nil || block.Type != "CERTIFICATE" || len(rest) != 0 {
+		return nil, errors.New("invalid FIDO2 certificate PEM")
+	}
+	return block.Bytes, nil
+}
+
+func main() {
+	product, _ := os.ReadFile("/sys/class/dmi/id/product_name")
+	if !strings.Contains(strings.ToLower(string(product)), "qemu") {
+		panic("mutual migration server must run inside a dedicated QEMU guest")
+	}
+	if _, err := os.Stat("/dev/tpmrm0"); err != nil {
+		panic("mutual migration server requires a guest TPM")
+	}
+	serverKeyFile := mutualServerEnvironment("RVA23_MUTUAL_SERVER_KEY_FILE", "/var/lib/rva23-mutual/server-ak-public.pem")
+	serverKey, err := migration.LoadAKPublicKey(serverKeyFile)
+	if err != nil {
+		panic(err)
+	}
+	sourceKey, err := migration.LoadAKPublicKey(mutualServerEnvironment("RVA23_MUTUAL_SOURCE_KEY_FILE", "/var/lib/rva23-mutual/source-ak-public.pem"))
+	if err != nil {
+		panic(err)
+	}
+	destinationKey, err := migration.LoadAKPublicKey(mutualServerEnvironment("RVA23_MUTUAL_DESTINATION_KEY_FILE", "/var/lib/rva23-mutual/destination-ak-public.pem"))
+	if err != nil {
+		panic(err)
+	}
+	sourceCertificate, err := loadCertificate(mutualServerEnvironment("RVA23_MUTUAL_SOURCE_CERTIFICATE", "/var/lib/rva23-mutual/source-u2f-certificate.pem"))
+	if err != nil {
+		panic(err)
+	}
+	destinationCertificate, err := loadCertificate(mutualServerEnvironment("RVA23_MUTUAL_DESTINATION_CERTIFICATE", "/var/lib/rva23-mutual/destination-u2f-certificate.pem"))
+	if err != nil {
+		panic(err)
+	}
+	productionPCR11 := strings.ToLower(os.Getenv("RVA23_MUTUAL_PRODUCTION_PCR11"))
+	if !migration.ValidSHA256(productionPCR11) {
+		panic("RVA23_MUTUAL_PRODUCTION_PCR11 must contain one SHA-256 value")
+	}
+	server := &mutualMigrationServer{
+		serverKey: serverKey, serverKeyFile: serverKeyFile, clientKeys: map[string]*rsa.PublicKey{migration.RoleSource: sourceKey, migration.RoleDestination: destinationKey},
+		certificates: map[string][]byte{migration.RoleSource: sourceCertificate, migration.RoleDestination: destinationCertificate}, productionPCR11: productionPCR11,
+		checkpointDir: mutualServerEnvironment("RVA23_MUTUAL_CHECKPOINT_DIR", "/var/lib/rva23-mutual/checkpoints"), now: func() time.Time { return time.Now().UTC() },
+		generateEvidence: migration.GenerateServerEvidence, sign: migration.SignWithTPMAK,
+		sessions: make(map[string]*mutualSession), challenges: make(map[string]mutualChallenge), grants: make(map[string]mutualGrantRecord), history: make([]mutualRequestRecord, 0),
+	}
+	httpServer := &http.Server{Addr: "0.0.0.0:8083", Handler: newMutualHTTPHandler(server), ReadHeaderTimeout: 5 * time.Second, ReadTimeout: 5 * time.Minute, WriteTimeout: 5 * time.Minute, IdleTimeout: 60 * time.Second, MaxHeaderBytes: 64 * 1024}
+	if err := httpServer.ListenAndServe(); err != nil {
+		panic(err)
+	}
+}
