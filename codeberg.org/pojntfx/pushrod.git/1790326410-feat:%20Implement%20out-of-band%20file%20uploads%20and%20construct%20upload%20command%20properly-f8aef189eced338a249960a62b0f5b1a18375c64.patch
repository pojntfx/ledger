diff --git a/pkg/svc/files.go b/pkg/svc/files.go
new file mode 100644
index 0000000000000000000000000000000000000000..9a79e28f2f6721f83835d58b7bdce69f23cbb4bc
--- /dev/null
+++ b/pkg/svc/files.go
@@ -0,0 +1,85 @@
+package svc
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+
+	"al.essio.dev/pkg/shellescape"
+	"github.com/google/renameio/v2"
+)
+
+const FilesUploadPath = "/files/"
+
+var (
+	ErrInvalidFileName = errors.New("invalid file name")
+)
+
+type baseURLContextKey struct{}
+
+func (s *Service) WithRequestBaseURL(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		baseURL := s.publicURL
+		if baseURL.Host == "" {
+			// No proxy support or anything, the user is expected to
+			// set the public URL flag for complex deployments
+			baseURL = &url.URL{Scheme: "http", Host: r.Host}
+		}
+
+		next.ServeHTTP(w, r.WithContext(context.WithValue(r.Context(), baseURLContextKey{}, baseURL)))
+	})
+}
+
+func (s *Service) uploadCommand(ctx context.Context) string {
+	baseURL, ok := ctx.Value(baseURLContextKey{}).(*url.URL)
+	if !ok {
+		return ""
+	}
+
+	return fmt.Sprintf("curl --upload-file LOCAL_PATH %s", shellescape.Quote(baseURL.JoinPath(FilesUploadPath, "NAME").String()))
+}
+
+func (s *Service) HandleUpload(w http.ResponseWriter, r *http.Request) {
+	name := r.PathValue("name")
+	// Path traversal etc. is handled by `os.OpenRoot` below, this is
+	// just to prevent some additional patterns we'd like to avoid.
+	// Also see `files.getFiles` tool where we hide hidden files
+	if strings.Contains(name, "/") || strings.HasPrefix(name, ".") {
+		http.Error(w, ErrInvalidFileName.Error(), http.StatusBadRequest)
+
+		return
+	}
+
+	if err := s.storeUpload(name, r.Body); err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+
+		return
+	}
+
+	w.WriteHeader(http.StatusNoContent)
+}
+
+func (s *Service) storeUpload(name string, body io.Reader) error {
+	root, err := os.OpenRoot(s.filesDir)
+	if err != nil {
+		return err
+	}
+	defer root.Close()
+
+	pending, err := renameio.NewPendingFile(name, renameio.WithRoot(root))
+	if err != nil {
+		return err
+	}
+	defer pending.Cleanup()
+
+	if _, err := io.Copy(pending, body); err != nil {
+		return err
+	}
+
+	return pending.CloseAtomicallyReplace()
+}
