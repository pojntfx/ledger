diff --git a/buildroot/qemu/scripts/smartcard-sign.c b/buildroot/qemu/scripts/smartcard-sign.c
new file mode 100644
index 0000000000000000000000000000000000000000..b7cd39af9e85b463cdb67f91b7ce70fd7c322534
--- /dev/null
+++ b/buildroot/qemu/scripts/smartcard-sign.c
@@ -0,0 +1,170 @@
+#include <errno.h>
+#include <openssl/sha.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <winscard.h>
+
+static void print_hex(const unsigned char *data, size_t size)
+{
+    size_t i;
+    for (i = 0; i < size; i++)
+        printf("%02x", data[i]);
+    printf("\n");
+}
+
+static int transmit(SCARDHANDLE card, const unsigned char *command, size_t command_size,
+                    unsigned char *response, size_t *response_size)
+{
+    SCARD_IO_REQUEST protocol = {SCARD_PROTOCOL_T0, 0};
+    print_hex(command, command_size);
+    LONG result = SCardTransmit(card, &protocol, command, command_size, NULL,
+                                response, response_size);
+    if (result != SCARD_S_SUCCESS) {
+        fprintf(stderr, "SCardTransmit failed: 0x%08lx\n", result);
+        return -1;
+    }
+    if (*response_size >= 2 && response[*response_size - 2] == 0x61) {
+        unsigned char get_response[] = {0x00, 0xc0, 0x00, 0x00, response[*response_size - 1]};
+        *response_size = 1024;
+        result = SCardTransmit(card, &protocol, get_response, sizeof(get_response), NULL,
+                                response, response_size);
+        if (result != SCARD_S_SUCCESS) {
+            fprintf(stderr, "SCardTransmit GET RESPONSE failed: 0x%08lx\n", result);
+            return -1;
+        }
+    }
+    if (*response_size < 2 || response[*response_size - 2] != 0x90 || response[*response_size - 1] != 0x00) {
+        fprintf(stderr, "Card rejected APDU: ");
+        print_hex(response, *response_size);
+        return -1;
+    }
+    return 0;
+}
+
+static int read_file(const char *path, unsigned char **data, size_t *size)
+{
+    FILE *file = fopen(path, "rb");
+    long length;
+    if (!file) {
+        perror(path);
+        return -1;
+    }
+    if (fseek(file, 0, SEEK_END) != 0 || (length = ftell(file)) < 0 || fseek(file, 0, SEEK_SET) != 0) {
+        fclose(file);
+        return -1;
+    }
+    *data = malloc(length ? (size_t)length : 1);
+    if (!*data) {
+        fclose(file);
+        return -1;
+    }
+    *size = fread(*data, 1, (size_t)length, file);
+    fclose(file);
+    if (*size != (size_t)length) {
+        free(*data);
+        return -1;
+    }
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    SCARDCONTEXT context;
+    SCARDHANDLE card = 0;
+    LONG result;
+    char readers[4096];
+    DWORD readers_size = sizeof(readers);
+    DWORD protocol = SCARD_PROTOCOL_T0;
+    unsigned char *message = NULL;
+    size_t message_size = 0;
+    unsigned char digest[SHA256_DIGEST_LENGTH];
+    unsigned char padded[256];
+    unsigned char sign_command[263];
+    unsigned char response[1024];
+    size_t response_size;
+    static const unsigned char select_pki[] = {0x00, 0xa4, 0x04, 0x00, 0x07, 0xa0, 0x00, 0x00, 0x00, 0x79, 0x01, 0x02};
+    static const unsigned char verify_pin[] = {0x00, 0x20, 0x00, 0x00, 0x00};
+    static const unsigned char sign_prefix[] = {0x00, 0x42, 0x00, 0x00};
+    static const unsigned char digest_info[] = {
+        0x30, 0x31, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01,
+        0x65, 0x03, 0x04, 0x02, 0x01, 0x05, 0x00, 0x04, 0x20
+    };
+    FILE *output;
+
+    if (argc != 3) {
+        fprintf(stderr, "usage: smartcard-sign MESSAGE SIGNATURE\n");
+        return 2;
+    }
+    if (read_file(argv[1], &message, &message_size) != 0)
+        return 1;
+    SHA256(message, message_size, digest);
+    if (message_size > 256) {
+        fprintf(stderr, "message is too long\n");
+        return 1;
+    }
+    memset(padded, 0, sizeof(padded));
+    padded[0] = 0x00;
+    padded[1] = 0x01;
+    memset(padded + 2, 0xff, sizeof(padded) - 3 - sizeof(digest_info) - SHA256_DIGEST_LENGTH);
+    padded[sizeof(padded) - sizeof(digest_info) - SHA256_DIGEST_LENGTH - 1] = 0x00;
+    memcpy(padded + sizeof(padded) - sizeof(digest_info) - SHA256_DIGEST_LENGTH, digest_info, sizeof(digest_info));
+    memcpy(padded + sizeof(padded) - SHA256_DIGEST_LENGTH, digest, SHA256_DIGEST_LENGTH);
+    free(message);
+    result = SCardEstablishContext(SCARD_SCOPE_SYSTEM, NULL, NULL, &context);
+    if (result != SCARD_S_SUCCESS) {
+        fprintf(stderr, "SCardEstablishContext failed: 0x%08lx\n", result);
+        return 1;
+    }
+    result = SCardListReaders(context, NULL, readers, &readers_size);
+    if (result != SCARD_S_SUCCESS || readers_size < 2) {
+        fprintf(stderr, "SCardListReaders failed: 0x%08lx\n", result);
+        SCardReleaseContext(context);
+        return 1;
+    }
+    result = SCardConnect(context, readers, SCARD_SHARE_SHARED, SCARD_PROTOCOL_T0, &card, &protocol);
+    if (result != SCARD_S_SUCCESS) {
+        fprintf(stderr, "SCardConnect failed: 0x%08lx\n", result);
+        SCardReleaseContext(context);
+        return 1;
+    }
+    if (SCardBeginTransaction(card) != SCARD_S_SUCCESS) {
+        SCardDisconnect(card, SCARD_LEAVE_CARD);
+        SCardReleaseContext(context);
+        return 1;
+    }
+    response_size = sizeof(response);
+    if (transmit(card, select_pki, sizeof(select_pki), response, &response_size) != 0)
+        goto fail;
+    memcpy(sign_command, sign_prefix, sizeof(sign_prefix));
+    sign_command[sizeof(sign_prefix)] = 0x00;
+    sign_command[sizeof(sign_prefix) + 1] = 0x01;
+    sign_command[sizeof(sign_prefix) + 2] = 0x00;
+    memcpy(sign_command + sizeof(sign_prefix) + 3, padded, sizeof(padded));
+    response_size = sizeof(response);
+    if (transmit(card, sign_command, sizeof(sign_command), response, &response_size) != 0)
+        goto fail;
+    if (SCardEndTransaction(card, SCARD_LEAVE_CARD) != SCARD_S_SUCCESS)
+        goto disconnect;
+    output = fopen(argv[2], "wb");
+    if (!output) {
+        perror(argv[2]);
+        goto disconnect;
+    }
+    if (fwrite(response, 1, response_size - 2, output) != response_size - 2) {
+        fclose(output);
+        goto disconnect;
+    }
+    fclose(output);
+    print_hex(response, response_size - 2);
+    SCardDisconnect(card, SCARD_LEAVE_CARD);
+    SCardReleaseContext(context);
+    return 0;
+
+fail:
+    SCardEndTransaction(card, SCARD_LEAVE_CARD);
+disconnect:
+    SCardDisconnect(card, SCARD_LEAVE_CARD);
+    SCardReleaseContext(context);
+    return 1;
+}
