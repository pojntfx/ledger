+func reportEvents(config sourceConfig, state reportState) []Event {
+	events := []Event{}
+	for _, record := range reportRecords(state) {
+		verification := "OS report"
+		step := "Upload"
+		if record.Path == "/v1/attest" {
+			verification = "Freshness"
+			step = "Attest"
+			if record.Error != "" && strings.Contains(strings.ToLower(record.Error), "nonce") {
+				step = "Replay"
+			}
+		}
+		status := ""
+		if record.Response != nil {
+			status = record.Response.Status
+		}
+		result := record.Path
+		if record.Response != nil {
+			result = fmt.Sprintf("%d components / %d events", record.Response.ComponentsVerified, record.Response.EventLogRecords)
+		} else if record.Error != "" {
+			result = record.Error
+		}
+		checks := []Check{}
+		if record.Response != nil {
+			checks = append(checks, Check{Name: "Response", Result: checkResult(record.Response.Status), Detail: record.Response.Status})
+			checks = append(checks, Check{Name: "Components", Result: "Pass", Detail: fmt.Sprintf("%d", record.Response.ComponentsVerified)})
+			checks = append(checks, Check{Name: "Event log", Result: "Pass", Detail: fmt.Sprintf("%d records", record.Response.EventLogRecords)})
+		} else {
+			checks = append(checks, Check{Name: "Response", Result: "Fail", Detail: record.Error})
+		}
+		if len(record.Sysext) > 0 {
+			checks = append(checks, Check{Name: "Sysext", Result: "Pass", Detail: fmt.Sprintf("%d records", len(record.Sysext))})
+		}
+		if record.Nonce != "" {
+			checks = append(checks, Check{Name: "Nonce", Result: "Pass", Detail: record.Nonce})
+		}
+		if record.Token != "" {
+			checks = append(checks, Check{Name: "Token", Result: "Pass", Detail: "present"})
+		}
+		events = append(events, Event{
+			ID:           eventID(config.ID, record.At, record.Path+"\x00"+record.Nonce+"\x00"+record.Error),
+			At:           record.At,
+			Verification: verification,
+			Target:       config.Target,
+			Step:         step,
+			Outcome:      outcomeFrom(status, record.Error),
+			Result:       result,
+			Source:       config.Name,
+			Detail:       EventDetail{Reason: reasonFor(status, record.Error, "Pending"), Checks: sortChecks(checks)},
+			Data:         record,
+		})
+	}
+	return events
+}
+
+func walletEvents(config sourceConfig, state walletState) []Event {
+	events := []Event{}
+	for _, record := range walletRecords(state) {
+		status := ""
+		if record.Response != nil {
+			status = record.Response.Status
+		}
+		result := record.Consent
+		contractID := ""
+		if record.Contract != nil {
+			contractID = record.Contract.ID
+			result = fmt.Sprintf("%s / Tier %d / %s", record.Contract.ID, record.Contract.Tier, record.Consent)
+		}
+		if record.Error != "" {
+			result = record.Error
+		} else if status != "" {
+			result += " / " + status
+		}
+		events = append(events, Event{
+			ID:           eventID(config.ID, record.At, contractID+"\x00"+record.Consent+"\x00"+record.Error),
+			At:           record.At,
+			Verification: "Wallet",
+			Target:       config.Target,
+			Step:         "Sign",
+			Outcome:      outcomeFrom(status, record.Error),
+			Result:       result,
+			Source:       config.Name,
+			Detail:       EventDetail{Reason: reasonFor(status, record.Error, "Pending"), Checks: checksFromValidation(record.Validation), Validation: record.Validation},
+			Data:         record,
+		})
+	}
+	return events
+}
+
+func migrationEvents(config sourceConfig, state migrationState) []Event {
+	events := []Event{}
+	for _, record := range migrationRecords(state) {
+		status, userID := migrationStatus(record.Response)
+		phase := ""
+		instanceID := ""
+		counter := uint64(0)
+		if record.Attestation != nil {
+			phase = record.Attestation.Phase
+			instanceID = record.Attestation.InstanceID
+			counter = record.Attestation.Counter
+		}
+		if record.Authorization != nil {
+			phase = record.Authorization.Phase
+			instanceID = record.Authorization.InstanceID
+			counter = record.Authorization.Counter
+		}
+		step := "Attest"
+		switch record.Operation {
+		case "checkpoint-upload":
+			step = "Upload"
+		case "checkpoint-download":
+			step = "Download"
+		default:
+			if phase != "" {
+				step = titleCase(phase)
+			}
+		}
+		result := record.Operation
+		if phase != "" {
+			result += " / " + phase
+		}
+		if userID > 0 {
+			result += fmt.Sprintf(" / user %d", userID)
+		}
+		if record.Error != "" {
+			result = record.Error
+		} else if status != "" {
+			result += " / " + status
+		}
+		events = append(events, Event{
+			ID:           eventID(config.ID, record.At, record.Operation+"\x00"+instanceID+"\x00"+fmt.Sprint(counter)),
+			At:           record.At,
+			Verification: "Migration",
+			Target:       config.Target,
+			Step:         step,
+			Outcome:      outcomeFrom(status, record.Error),
+			Result:       result,
+			Source:       config.Name,
+			Detail:       EventDetail{Reason: reasonFor(status, record.Error, "Pending"), Checks: checksFromValidation(record.Validation), Validation: record.Validation},
+			Data:         record,
+		})
+	}
+	return events
+}
+
+func mutualEvents(config sourceConfig, state mutualState) []Event {
+	events := []Event{}
+	for _, record := range mutualRecords(state) {
+		status := mutualStatus(record.Response)
+		step := "Transfer"
+		switch record.Operation {
+		case "source-attestation", "destination-attestation":
+			step = "Attest"
+		case "checkpoint-upload":
+			step = "Upload"
+		case "checkpoint-download":
+			step = "Download"
+		case "migration-completion":
+			step = "Complete"
+		case "server-challenge":
+			step = "Challenge"
+		}
+		result := record.Operation
+		if record.Direction != "" {
+			result = record.Direction + " / " + record.Operation
+		}
+		if record.Error != "" {
+			result = record.Error
+		} else if status != "" {
+			result += " / " + status
+		}
+		events = append(events, Event{
+			ID:           eventID(config.ID, record.At, record.Operation+"\x00"+record.Direction),
+			At:           record.At,
+			Verification: "Mutual",
+			Target:       config.Target,
+			Step:         step,
+			Outcome:      outcomeFrom(status, record.Error),
+			Result:       result,
+			Source:       config.Name,
+			Detail:       EventDetail{Reason: reasonFor(status, record.Error, "Pending"), Checks: checksFromValidation(record.Validation), Validation: record.Validation},
+			Data:         record,
+		})
+	}
+	for _, session := range state.Sessions {
+		validation := map[string]string{}
+		for name, value := range session.SourceTier2 {
+			validation["source."+name] = value
+		}
+		for name, value := range session.DestinationTier2 {
+			validation["destination."+name] = value
+		}
+		outcome := "Open"
+		if strings.EqualFold(session.Phase, "completed") {
+			outcome = "Pass"
+		}
+		events = append(events, Event{
+			ID:           eventID(config.ID, session.UpdatedAt, session.SessionID),
+			At:           session.UpdatedAt,
+			Verification: "Mutual",
+			Target:       config.Target,
+			Step:         "Complete",
+			Outcome:      outcome,
+			Result:       fmt.Sprintf("source user %d / destination user %d / %s", session.SourceUserID, session.DestinationUserID, session.Phase),
+			Source:       config.Name,
+			Detail:       EventDetail{Reason: reasonFor(session.Phase, "", "Pending"), Checks: checksFromValidation(validation), Validation: validation},
+			Data:         session,
+		})
+	}
+	return events
+}
+
+func migrationClientEvents(config sourceConfig, state migrationClientState) []Event {
+	lastErrorResult := "Pass"
+	if state.LastError != "" {
+		lastErrorResult = "Fail"
+	}
+	checks := sortChecks([]Check{
+		{Name: "instanceId", Result: "Pass", Detail: state.InstanceID},
+		{Name: "pid", Result: "Pass", Detail: fmt.Sprint(state.PID)},
+		{Name: "counter", Result: "Pass", Detail: fmt.Sprint(state.Counter)},
+		{Name: "lastPhase", Result: checkResult(state.LastPhase), Detail: state.LastPhase},
+		{Name: "lastError", Result: lastErrorResult, Detail: state.LastError},
+	})
+	result := state.LastOperation
+	if state.LastPhase != "" {
+		result += " / " + state.LastPhase
+	}
+	if state.LastError != "" {
+		result = state.LastError
+	}
+	return []Event{{
+		ID:           eventID(config.ID, state.UpdatedAt, state.InstanceID),
+		At:           state.UpdatedAt,
+		Verification: "Migration",
+		Target:       config.Target,
+		Step:         titleCase(state.LastOperation),
+		Outcome:      outcomeFrom(state.LastPhase, state.LastError),
+		Result:       result,
+		Source:       config.Name,
+		Detail:       EventDetail{Reason: reasonFor(state.LastPhase, state.LastError, "Pending"), Checks: checks},
+		Data:         state,
+	}}
+}
+
+func mutualClientEvents(config sourceConfig, state mutualClientState) []Event {
+	validation := map[string]string{}
+	for name, value := range state.ServerVerification {
+		validation["server."+name] = value
+	}
+	for name, value := range state.ClientTier2 {
+		validation["client."+name] = value
+	}
+	step := "Attest"
+	switch state.Operation {
+	case "checkpoint-upload":
+		step = "Upload"
+	case "checkpoint-download":
+		step = "Download"
+	case "migration-completion":
+		step = "Complete"
+	}
+	result := fmt.Sprintf("%s / %s / counter %d", state.Role, state.Phase, state.Counter)
+	if state.LastError != "" {
+		result = state.LastError
+	}
+	return []Event{{
+		ID:           eventID(config.ID, state.UpdatedAt, state.SessionID),
+		At:           state.UpdatedAt,
+		Verification: "Mutual",
+		Target:       config.Target,
+		Step:         step,
+		Outcome:      outcomeFrom(state.Phase, state.LastError),
+		Result:       result,
+		Source:       config.Name,
+		Detail:       EventDetail{Reason: reasonFor(state.Phase, state.LastError, "Pending"), Checks: checksFromValidation(validation), Validation: validation},
+		Data:         state,
+	}}
+}
+
+func fetchSource(ctx context.Context, client *http.Client, config sourceConfig) ([]Event, sourceStatus) {
+	status := sourceStatus{ID: config.ID, Name: config.Name, Kind: config.Kind, URL: config.URL, Target: config.Target}
+	if config.URL == "" {
+		status.Error = "no URL"
+		return nil, status
+	}
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, strings.TrimRight(config.URL, "/")+"/api/state", nil)
+	if err != nil {
+		status.Error = err.Error()
+		return nil, status
+	}
+	response, err := client.Do(request)
+	if err != nil {
+		status.Error = err.Error()
+		return nil, status
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		status.Error = response.Status
+		return nil, status
+	}
+	body, err := io.ReadAll(io.LimitReader(response.Body, 16*1024*1024))
+	if err != nil {
+		status.Error = err.Error()
+		return nil, status
+	}
+	var events []Event
+	switch config.ID {
+	case "report":
+		var state reportState
+		if err := json.Unmarshal(body, &state); err != nil {
+			status.Error = err.Error()
+			return nil, status
+		}
+		events = reportEvents(config, state)
+	case "wallet":
+		var state walletState
+		if err := json.Unmarshal(body, &state); err != nil {
+			status.Error = err.Error()
+			return nil, status
+		}
+		events = walletEvents(config, state)
+	case "migration":
+		var state migrationState
+		if err := json.Unmarshal(body, &state); err != nil {
+			status.Error = err.Error()
+			return nil, status
+		}
+		events = migrationEvents(config, state)
+	case "mutual":
+		var state mutualState
+		if err := json.Unmarshal(body, &state); err != nil {
+			status.Error = err.Error()
+			return nil, status
+		}
+		events = mutualEvents(config, state)
+	case "migration-client":
+		var state migrationClientState
+		if err := json.Unmarshal(body, &state); err != nil {
+			status.Error = err.Error()
+			return nil, status
+		}
+		events = migrationClientEvents(config, state)
+	case "mutual-client":
+		var state mutualClientState
+		if err := json.Unmarshal(body, &state); err != nil {
+			status.Error = err.Error()
+			return nil, status
+		}
+		events = mutualClientEvents(config, state)
+	default:
+		status.Error = "unknown source"
+		return nil, status
+	}
+	status.OK = true
+	status.Count = len(events)
+	return events, status
+}
+
+func collectEvents(ctx context.Context) explorerState {
+	configs := sourceConfigs()
+	client := &http.Client{Timeout: 10 * time.Second}
+	events := []Event{}
+	sources := []sourceStatus{}
+	var mutex sync.Mutex
+	var group sync.WaitGroup
+	for _, config := range configs {
+		config := config
+		group.Add(1)
+		go func() {
+			defer group.Done()
+			sourceEvents, sourceStatus := fetchSource(ctx, client, config)
+			mutex.Lock()
+			events = append(events, sourceEvents...)
+			sources = append(sources, sourceStatus)
+			mutex.Unlock()
+		}()
+	}
+	group.Wait()
+	sort.Slice(events, func(left, right int) bool {
+		return events[left].At.After(events[right].At)
+	})
+	sort.Slice(sources, func(left, right int) bool {
+		return sources[left].ID < sources[right].ID
+	})
+	return explorerState{Events: events, Sources: sources}
+}
+
+func main() {
+	listen := env("RVA23_EVENT_LISTEN", "[::]:8086")
+	mux := http.NewServeMux()
+	mux.HandleFunc("/api/state", func(writer http.ResponseWriter, request *http.Request) {
+		if request.Method != http.MethodGet {
+			writer.Header().Set("Allow", http.MethodGet)
+			http.Error(writer, "method not allowed", http.StatusMethodNotAllowed)
+			return
+		}
+		writer.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(writer).Encode(collectEvents(request.Context()))
+	})
+	mux.HandleFunc("/", func(writer http.ResponseWriter, request *http.Request) {
+		if request.URL.Path != "/" {
+			http.NotFound(writer, request)
+			return
+		}
+		if request.Method != http.MethodGet {
+			writer.Header().Set("Allow", http.MethodGet)
+			http.Error(writer, "method not allowed", http.StatusMethodNotAllowed)
+			return
+		}
+		writer.Header().Set("Content-Type", "text/html; charset=utf-8")
+		_, _ = io.WriteString(writer, eventExplorerHTML)
+	})
+	server := &http.Server{
+		Addr:              listen,
+		Handler:           mux,
+		ReadHeaderTimeout: 5 * time.Second,
+		ReadTimeout:       30 * time.Second,
+		WriteTimeout:      30 * time.Second,
+		IdleTimeout:       60 * time.Second,
+		MaxHeaderBytes:    64 * 1024,
+	}
+	if err := server.ListenAndServe(); err != nil {
+		panic(err)
+	}
+}
diff --git a/buildroot/scripts/event-explorer.html b/buildroot/scripts/event-explorer.html
new file mode 100644
index 0000000000000000000000000000000000000000..a8651e8ea8f8d2bd553c5d8b9eaf15131b1abf10
--- /dev/null
+++ b/buildroot/scripts/event-explorer.html
@@ -0,0 +1,320 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Event Explorer</title>
+<style>
+body{max-width:100rem;margin:0 auto;padding:.75rem 1rem}
+header h1{margin:0}
+main{display:grid;grid-template-columns:minmax(0,2fr) minmax(22rem,1fr);gap:1rem;align-items:start}
+search,#error{grid-column:1/-1}
+search{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center}
+#requests{min-width:0;overflow-x:auto}
+#detail{min-width:0}
+footer{margin-top:1rem}
+h1,h2,h3,h4,p,dl,ul{margin:0}
+h2,h3{margin:.25rem 0}
+p{margin:.25rem 0}
+dl{display:grid;grid-template-columns:max-content 1fr;gap:.15rem 1rem;margin:.25rem 0}
+dt,dd{margin:0}
+table{border-collapse:collapse;width:100%}
+th,td{padding:.2rem .35rem;text-align:left;vertical-align:top}
+caption{text-align:left}
+thead th,time{white-space:nowrap}
+#detail > table td:nth-child(2),#detail > table th:nth-child(2){white-space:nowrap}
+details{margin:.25rem 0}
+@media(max-width:60rem){main{grid-template-columns:1fr}search,#error{grid-column:auto}dl{grid-template-columns:1fr}}
+</style>
+</head>
+<body>
+<header><h1>Event Explorer</h1></header>
+<main>
+<search>
+<label for="search">Search</label>
+<input id="search" type="search" placeholder="Search all fields" autofocus>
+</search>
+<p id="error" role="alert" hidden></p>
+<section id="requests">
+<table>
+<caption>Events. Selected event: <mark id="selected-id">ch-9a4b</mark>.</caption>
+<thead><tr>
+<th scope="col" aria-sort="none"><button type="button" data-sort="id" data-label="Request">Request</button></th>
+<th scope="col" aria-sort="descending"><button type="button" data-sort="at" data-label="Time">Time</button></th>
+<th scope="col" aria-sort="none"><button type="button" data-sort="verification" data-label="Verification">Verification</button></th>
+<th scope="col" aria-sort="none"><button type="button" data-sort="target" data-label="Target">Target</button></th>
+<th scope="col" aria-sort="none"><button type="button" data-sort="step" data-label="Step">Step</button></th>
+<th scope="col" aria-sort="none"><button type="button" data-sort="outcome" data-label="Outcome">Outcome</button></th>
+<th scope="col" aria-sort="none"><button type="button" data-sort="result" data-label="Result">Result</button></th>
+</tr></thead>
+<tbody id="events-body"></tbody>
+</table>
+</section>
+<aside id="detail"><h2>Selected event</h2><p>Loading</p></aside>
+</main>
+<footer><button id="download-all" type="button">See all events (JSON)</button></footer>
+<script>
+const searchInput = document.getElementById("search");
+const errorOutput = document.getElementById("error");
+const eventsBody = document.getElementById("events-body");
+const selectedId = document.getElementById("selected-id");
+const detail = document.getElementById("detail");
+const sortButtons = document.querySelectorAll("th button[data-sort]");
+let data = null;
+let selected = "ch-9a4b";
+let sortKey = "at";
+let sortDirection = "desc";
+
+function el(tag, text = "", attrs = {}) {
+  const node = document.createElement(tag);
+  if (text !== "") node.textContent = text;
+  for (const [key, value] of Object.entries(attrs)) node.setAttribute(key, value);
+  return node;
+}
+
+function code(value) {
+  return el("code", String(value ?? "—"));
+}
+
+function timeEl(value) {
+  const text = String(value ?? "—");
+  const label = text.replace("T", " ").slice(0, 19);
+  return el("time", label, { datetime: text });
+}
+
+function timeShort(value) {
+  const text = String(value ?? "—");
+  const label = text.slice(11, 19);
+  return el("time", label, { datetime: text });
+}
+
+function statusText(value) {
+  const text = String(value ?? "—");
+  const lower = text.toLowerCase();
+  if (lower.includes("reject") || lower.includes("fail") || lower.includes("error") || lower.includes("replay")) return "❌ " + text;
+  if (lower.includes("pass") || lower.includes("accept") || lower.includes("consum") || lower.includes("upload") || lower.includes("download") || lower.includes("complet") || lower.includes("generated")) return "✅ " + text;
+  if (lower.includes("pending") || lower.includes("outstanding") || lower.includes("waiting") || lower.includes("challenged") || lower.includes("authorized") || lower.includes("open")) return "⏳ " + text;
+  if (lower.includes("not required") || lower.includes("not covered") || lower.includes("skip")) return "➖ " + text;
+  return text;
+}
+
+function statusEl(value) {
+  const text = statusText(value);
+  return el("data", text, { value: String(value ?? "") });
+}
+
+function table(caption, headers, rows, rowHeader = false) {
+  const node = el("table");
+  node.append(el("caption", caption));
+  const thead = el("thead");
+  const headRow = el("tr");
+  for (const header of headers) {
+    const th = el("th", header);
+    th.setAttribute("scope", "col");
+    headRow.append(th);
+  }
+  thead.append(headRow);
+  node.append(thead);
+  const tbody = el("tbody");
+  for (const row of rows) {
+    const tr = el("tr");
+    row.forEach((cell, index) => {
+      const cellNode = rowHeader && index === 0 ? el("th") : el("td");
+      if (rowHeader && index === 0) cellNode.setAttribute("scope", "row");
+      if (cell instanceof Node) cellNode.append(cell);
+      else cellNode.append(document.createTextNode(String(cell ?? "—")));
+      tr.append(cellNode);
+    });
+    tbody.append(tr);
+  }
+  node.append(tbody);
+  return node;
+}
+
+function dl(pairs) {
+  const node = el("dl");
+  for (const [key, value] of pairs) {
+    const dt = el("dt");
+    if (key instanceof Node) dt.append(key);
+    else dt.textContent = String(key);
+    const dd = el("dd");
+    if (value instanceof Node) dd.append(value);
+    else dd.textContent = String(value ?? "—");
+    node.append(dt, dd);
+  }
+  return node;
+}
+
+function details(summary, ...children) {
+  const node = el("details");
+  node.append(el("summary", summary));
+  for (const child of children) node.append(child);
+  return node;
+}
+
+function explorer(name, value) {
+  if (value === null || value === undefined) return code("null");
+  if (Array.isArray(value)) {
+    const node = el("details");
+    node.append(el("summary", `${name} (${value.length})`));
+    const list = el("ol");
+    value.forEach((item, index) => {
+      const li = el("li");
+      li.append(explorer(String(index + 1), item));
+      list.append(li);
+    });
+    node.append(list);
+    return node;
+  }
+  if (typeof value === "object") {
+    const node = el("details");
+    node.append(el("summary", `${name} (${Object.keys(value).length})`));
+    const list = el("dl");
+    for (const [key, item] of Object.entries(value)) {
+      const dd = el("dd");
+      dd.append(explorer(key, item));
+      list.append(el("dt", key), dd);
+    }
+    node.append(list);
+    return node;
+  }
+  return code(String(value));
+}
+
+function downloadBlob(name, value) {
+  const blob = new Blob([JSON.stringify(value, null, 2)], { type: "application/json" });
+  const url = URL.createObjectURL(blob);
+  const anchor = el("a", "", { href: url, download: name });
+  anchor.click();
+  URL.revokeObjectURL(url);
+}
+
+function sortValue(event, key) {
+  return key === "at" ? event.at : String(event[key] ?? "");
+}
+
+function filteredEvents() {
+  const events = [...(data?.events || [])];
+  const search = searchInput.value.trim().toLowerCase();
+  const filtered = search ? events.filter(event => JSON.stringify(event).toLowerCase().includes(search)) : events;
+  filtered.sort((left, right) => {
+    const comparison = String(sortValue(left, sortKey)).localeCompare(String(sortValue(right, sortKey)));
+    return sortDirection === "asc" ? comparison : -comparison;
+  });
+  return filtered;
+}
+
+function updateSortHeaders() {
+  for (const button of sortButtons) {
+    const th = button.closest("th");
+    const active = button.dataset.sort === sortKey;
+    th.setAttribute("aria-sort", active ? (sortDirection === "asc" ? "ascending" : "descending") : "none");
+    button.textContent = button.dataset.label + (active ? (sortDirection === "asc" ? " ▲" : " ▼") : "");
+  }
+}
+
+function selectEvent(identifier) {
+  selected = identifier;
+  renderTable();
+}
+
+function renderTable() {
+  if (!data) return;
+  const events = filteredEvents();
+  if (!events.some(event => event.id === selected)) selected = events[0]?.id ?? null;
+  const rows = events.map(event => {
+    const request = el("button", event.id, { type: "button", "data-id": event.id });
+    if (event.id === selected) {
+      request.setAttribute("aria-current", "true");
+      const mark = el("mark");
+      mark.append(request);
+      return [mark, timeShort(event.at), event.verification, event.target, event.step, statusEl(event.outcome), event.result];
+    }
+    return [request, timeShort(event.at), event.verification, event.target, event.step, statusEl(event.outcome), event.result];
+  });
+  const tbody = el("tbody");
+  rows.forEach((row, rowIndex) => {
+    const tr = el("tr");
+    tr.addEventListener("click", () => selectEvent(events[rowIndex].id));
+    row.forEach((cell, index) => {
+      const cellNode = index === 0 ? el("th") : el("td");
+      if (index === 0) cellNode.setAttribute("scope", "row");
+      if (cell instanceof Node) cellNode.append(cell);
+      else cellNode.textContent = String(cell ?? "—");
+      tr.append(cellNode);
+    });
+    tbody.append(tr);
+  });
+  eventsBody.replaceChildren(...tbody.childNodes);
+  selectedId.textContent = selected || "—";
+  updateSortHeaders();
+  renderDetail();
+}
+
+function renderDetail() {
+  const event = data?.events?.find(item => item.id === selected);
+  if (!event) {
+    detail.replaceChildren(el("h2", "Selected event"), el("p", "No event selected."));
+    return;
+  }
+  const header = el("header");
+  const sub = el("p");
+  sub.append(code(event.id), document.createTextNode(" / "), timeEl(event.at), document.createTextNode(" / "), code(event.source));
+  header.append(el("h2", "Selected event"), sub);
+  const verdictText = event.outcome === "Pass" ? "✅ PASS" : event.outcome === "Fail" ? "❌ FAIL" : "⏳ OPEN";
+  const verdict = el("h3");
+  verdict.append(el("strong", verdictText), document.createTextNode(": " + (event.detail?.reason || event.result)));
+  const facts = dl([
+    ["Verification", event.verification],
+    ["Target", event.target],
+    ["Step", event.step],
+    ["Source", event.source],
+  ]);
+  const checks = table("Checks", ["Check", "Result", "Detail"], (event.detail?.checks || []).map(check => [check.name, statusEl(check.result), check.detail]), true);
+  const validationEntries = Object.entries(event.detail?.validation || {});
+  const validation = validationEntries.length ? details("Validation map", table("validation", ["Key", "Value"], validationEntries.map(([key, value]) => [code(key), statusEl(value)]), true)) : null;
+  const eventData = explorer("Event data", event.data);
+  const footer = el("footer");
+  footer.append(el("button", "Download event JSON", { type: "button" }));
+  footer.firstChild.addEventListener("click", () => downloadBlob(event.id + ".json", event));
+  const children = [header, verdict, facts, checks];
+  if (validation) children.push(validation);
+  children.push(eventData, footer);
+  detail.replaceChildren(...children);
+}
+
+async function load() {
+  errorOutput.hidden = true;
+  try {
+    const response = await fetch("api/state", { cache: "no-store" });
+    if (!response.ok) throw new Error(response.statusText);
+    data = await response.json();
+  } catch (error) {
+    errorOutput.hidden = false;
+    errorOutput.textContent = "Error: " + error.message;
+    return;
+  }
+  if (!data.events?.some(event => event.id === selected)) selected = data.events?.[0]?.id ?? null;
+  renderTable();
+}
+
+for (const button of sortButtons) {
+  button.addEventListener("click", () => {
+    const key = button.dataset.sort;
+    if (sortKey === key) sortDirection = sortDirection === "asc" ? "desc" : "asc";
+    else {
+      sortKey = key;
+      sortDirection = "asc";
+    }
+    renderTable();
+  });
+}
+
+searchInput.addEventListener("input", renderTable);
+document.getElementById("download-all").addEventListener("click", () => {
+  if (data) downloadBlob("attestation-events.json", data);
+});
+load();
+</script>
+</body>
+</html>
