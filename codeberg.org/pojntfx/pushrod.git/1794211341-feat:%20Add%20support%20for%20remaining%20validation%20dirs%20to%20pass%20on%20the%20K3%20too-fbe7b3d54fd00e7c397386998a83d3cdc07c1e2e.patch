+package main
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+)
+
+func TestOutcomeFrom(t *testing.T) {
+	tests := []struct {
+		status string
+		error  string
+		want   string
+	}{
+		{"accepted", "", "Pass"},
+		{"uploaded", "", "Pass"},
+		{"downloaded", "", "Pass"},
+		{"completed", "", "Pass"},
+		{"rejected", "", "Fail"},
+		{"accepted", "nonce already used", "Fail"},
+		{"pending", "", "Open"},
+		{"challenged", "", "Open"},
+		{"", "", "Open"},
+	}
+	for _, test := range tests {
+		if got := outcomeFrom(test.status, test.error); got != test.want {
+			t.Fatalf("outcomeFrom(%q, %q) = %q, want %q", test.status, test.error, got, test.want)
+		}
+	}
+}
+
+func TestCheckResult(t *testing.T) {
+	tests := map[string]string{
+		"accepted":            "Pass",
+		"consumed":            "Pass",
+		"rejected":            "Fail",
+		"replayed":            "Fail",
+		"not required":        "Skip",
+		"not covered":         "Skip",
+		"pending":             "Open",
+		"challenged":          "Open",
+		"accepted for user 2": "Pass",
+	}
+	for value, want := range tests {
+		if got := checkResult(value); got != want {
+			t.Fatalf("checkResult(%q) = %q, want %q", value, got, want)
+		}
+	}
+}
+
+func sourceServer(t *testing.T, value any) *httptest.Server {
+	t.Helper()
+	server := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+		if request.URL.Path != "/api/state" {
+			http.NotFound(writer, request)
+			return
+		}
+		writer.Header().Set("Content-Type", "application/json")
+		if err := json.NewEncoder(writer).Encode(value); err != nil {
+			t.Errorf("encode source state: %v", err)
+		}
+	}))
+	t.Cleanup(server.Close)
+	return server
+}
+
+func TestCollectEvents(t *testing.T) {
+	at := time.Date(2026, 11, 8, 19, 44, 12, 0, time.UTC)
+	reportServer := sourceServer(t, reportState{History: []reportRecord{{
+		At: at, Path: "/reports", Nonce: "9f0a3c7d",
+		Response: &reportResponse{Status: "accepted", ComponentsVerified: 1, EventLogRecords: 84},
+		Sysext:   []json.RawMessage{json.RawMessage(`{"pcr":13}`)},
+	}}})
+	walletServer := sourceServer(t, walletState{History: []walletRecord{{
+		At: at, Contract: &walletContract{ID: "mortgage", Tier: 2}, Consent: "host", Device: "trusted-host-os",
+		Validation: map[string]string{"tpmAkSignature": "accepted", "pcr11Profile": "accepted", "freshNonce": "accepted"},
+		Response:   &walletResponse{Status: "accepted", ContractID: "mortgage", Tier: 2, Consent: "host"},
+	}}})
+	migrationServer := sourceServer(t, migrationState{History: []migrationRecord{{
+		At: at, Operation: "attestation",
+		Attestation: &attestationRequest{InstanceID: "7a3c", PID: 4242, Counter: 4, Phase: "after"},
+		Validation:  map[string]string{"identityBinding": "accepted for user 2", "pcr11Profile": "accepted"},
+		Response:    json.RawMessage(`{"status":"accepted","userId":2}`),
+	}}})
+	mutualServer := sourceServer(t, mutualState{
+		History: []mutualRecord{{
+			At: at, Direction: "client-to-server", Operation: "destination-attestation",
+			Validation: map[string]string{"tpmAkSignature": "accepted", "fido2Consent": "accepted"},
+			Response:   json.RawMessage(`{"status":"accepted"}`),
+		}},
+		Sessions: []mutualSession{{
+			SessionID: "b8e1", InstanceID: "7a3c", PID: 4242, Counter: 5, Phase: "completed",
+			SourceTier2: map[string]string{"tpmAkSignature": "accepted"}, DestinationTier2: map[string]string{"fido2Consent": "accepted"},
+			SourceUserID: 1, DestinationUserID: 2, UpdatedAt: at,
+		}},
+	})
+	migrationClient := sourceServer(t, migrationClientState{InstanceID: "7a3c", PID: 4242, Counter: 4, LastPhase: "downloaded", LastOperation: "download", UpdatedAt: at})
+	mutualClient := sourceServer(t, mutualClientState{
+		InstanceID: "7a3c", PID: 4242, SessionID: "b8e1", Role: "destination", Counter: 5,
+		Operation: "migration-completion", Phase: "completed",
+		ServerVerification: map[string]string{"serverAkSignature": "accepted"}, ClientTier2: map[string]string{"fido2Consent": "accepted"},
+		UpdatedAt: at,
+	})
+	t.Setenv("RVA23_EVENT_TARGET", "QEMU")
+	t.Setenv("RVA23_EVENT_REPORT_URL", reportServer.URL)
+	t.Setenv("RVA23_EVENT_WALLET_URL", walletServer.URL)
+	t.Setenv("RVA23_EVENT_MIGRATION_URL", migrationServer.URL)
+	t.Setenv("RVA23_EVENT_MUTUAL_URL", mutualServer.URL)
+	t.Setenv("RVA23_EVENT_MIGRATION_CLIENT_URL", migrationClient.URL)
+	t.Setenv("RVA23_EVENT_MUTUAL_CLIENT_URL", mutualClient.URL)
+	state := collectEvents(context.Background())
+	if len(state.Sources) != 6 {
+		t.Fatalf("got %d sources, want 6", len(state.Sources))
+	}
+	for _, source := range state.Sources {
+		if !source.OK {
+			t.Fatalf("source %s failed: %s", source.ID, source.Error)
+		}
+	}
+	if len(state.Events) != 7 {
+		t.Fatalf("got %d events, want 7", len(state.Events))
+	}
+	for _, event := range state.Events {
+		if event.ID == "" || event.Source == "" || event.Verification == "" || event.Target != "QEMU" || event.Outcome == "" {
+			t.Fatalf("incomplete event: %+v", event)
+		}
+		if len(event.Detail.Checks) == 0 {
+			t.Fatalf("event has no checks: %+v", event)
+		}
+		if event.Data == nil {
+			t.Fatalf("event has no data: %+v", event)
+		}
+	}
+}
