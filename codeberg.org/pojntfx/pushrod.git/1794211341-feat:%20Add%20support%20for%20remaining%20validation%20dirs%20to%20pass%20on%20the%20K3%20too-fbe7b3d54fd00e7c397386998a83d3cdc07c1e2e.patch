+
+func eventID(source string, at time.Time, key string) string {
+	digest := sha256.Sum256([]byte(source + "\x00" + at.UTC().Format(time.RFC3339Nano) + "\x00" + key))
+	return source + "-" + hex.EncodeToString(digest[:4])
+}
+
+func outcomeFrom(status, errorText string) string {
+	if errorText != "" {
+		return "Fail"
+	}
+	switch strings.ToLower(status) {
+	case "accepted", "uploaded", "downloaded", "completed":
+		return "Pass"
+	case "rejected", "failed", "error":
+		return "Fail"
+	case "pending", "waiting", "challenged", "authorized", "open":
+		return "Open"
+	}
+	if status == "" {
+		return "Open"
+	}
+	return "Pass"
+}
+
+func checkResult(value string) string {
+	lower := strings.ToLower(value)
+	switch {
+	case strings.Contains(lower, "reject"), strings.Contains(lower, "fail"), strings.Contains(lower, "error"), strings.Contains(lower, "replay"), strings.Contains(lower, "invalid"), strings.Contains(lower, "timeout"), strings.Contains(lower, "missing"), strings.Contains(lower, "unavailable"), strings.Contains(lower, "expire"):
+		return "Fail"
+	case strings.Contains(lower, "pending"), strings.Contains(lower, "outstanding"), strings.Contains(lower, "waiting"), strings.Contains(lower, "challenged"), strings.Contains(lower, "authorized"), strings.Contains(lower, "open"):
+		return "Open"
+	case strings.Contains(lower, "not required"), strings.Contains(lower, "not covered"), strings.Contains(lower, "skip"):
+		return "Skip"
+	case strings.Contains(lower, "pass"), strings.Contains(lower, "accept"), strings.Contains(lower, "consum"), strings.Contains(lower, "upload"), strings.Contains(lower, "download"), strings.Contains(lower, "complet"), strings.Contains(lower, "generated"):
+		return "Pass"
+	default:
+		return "Pass"
+	}
+}
+
+func checkRank(result string) int {
+	switch result {
+	case "Fail":
+		return 0
+	case "Open":
+		return 1
+	case "Skip":
+		return 2
+	default:
+		return 3
+	}
+}
+
+func sortChecks(checks []Check) []Check {
+	sort.SliceStable(checks, func(left, right int) bool {
+		leftRank := checkRank(checks[left].Result)
+		rightRank := checkRank(checks[right].Result)
+		if leftRank != rightRank {
+			return leftRank < rightRank
+		}
+		return checks[left].Name < checks[right].Name
+	})
+	return checks
+}
+
+func checksFromValidation(validation map[string]string) []Check {
+	checks := make([]Check, 0, len(validation))
+	for name, value := range validation {
+		checks = append(checks, Check{Name: name, Result: checkResult(value), Detail: value})
+	}
+	return sortChecks(checks)
+}
+
+func titleCase(value string) string {
+	if value == "" {
+		return "—"
+	}
+	return strings.ToUpper(value[:1]) + value[1:]
+}
+
+func migrationStatus(raw json.RawMessage) (string, int) {
+	if len(raw) == 0 {
+		return "", 0
+	}
+	var response migrationResponse
+	if err := json.Unmarshal(raw, &response); err != nil {
+		return "", 0
+	}
+	return response.Status, response.UserID
+}
+
+func mutualStatus(raw json.RawMessage) string {
