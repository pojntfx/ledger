@@ -0,0 +1,211 @@
+package svc
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"fmt"
+	"time"
+
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+const (
+	flashJobQueued    = "queued"
+	flashJobRunning   = "running"
+	flashJobSucceeded = "succeeded"
+	flashJobFailed    = "failed"
+
+	// Finished jobs are kept so their results can be read back, but not forever
+	flashJobsKept = 16
+)
+
+// flashJob is one flashing operation running detached from the MCP request that
+// started it, so an operation that outlives the client's request timeout can
+// still be watched to completion
+type flashJob struct {
+	id      string
+	kind    string
+	detail  string
+	status  string
+	err     string
+	label   string
+	sent    int64
+	total   int64
+	result  any
+	started time.Time
+	ended   time.Time
+}
+
+type FlashJobStatus struct {
+	ID         string `json:"id" jsonschema:"ID of the job"`
+	Kind       string `json:"kind" jsonschema:"the operation the job runs, like flash.multiFlash or flash.flashFile"`
+	Detail     string `json:"detail" jsonschema:"what the job flashes, like the partition JSONs or the file and partition"`
+	Status     string `json:"status" jsonschema:"queued (another flash is still running), running, succeeded or failed"`
+	Error      string `json:"error,omitempty" jsonschema:"why the job failed, if it did"`
+	Label      string `json:"label,omitempty" jsonschema:"partition currently being flashed"`
+	SentBytes  int64  `json:"sentBytes" jsonschema:"bytes flashed so far, across the whole job"`
+	TotalBytes int64  `json:"totalBytes" jsonschema:"total bytes the job will flash"`
+	Result     any    `json:"result,omitempty" jsonschema:"the operation's result once it succeeded, with the same fields as the synchronous call"`
+	StartedAt  int64  `json:"startedAt" jsonschema:"when the job was started, in milliseconds since the epoch"`
+	DurationMs int64  `json:"durationMs" jsonschema:"how long the job has been running or took, in milliseconds"`
+}
+
+var (
+	GetFlashJobsTool = &mcp.Tool{
+		Name:        "flash.getJobs",
+		Title:       "Get flash jobs",
+		Description: "List the flashing jobs started with background:true on flash.multiFlash or flash.flashFile, with their progress and results; poll this while a job runs, and read the serial console for device-side details",
+		Annotations: &mcp.ToolAnnotations{ReadOnlyHint: true},
+	}
+)
+
+// notifyProgress returns a progress callback that notifies the client when the
+// whole percentage changes, and only when it asked for progress
+func notifyProgress(ctx context.Context, req *mcp.CallToolRequest, totalBytes int64) func(label string, sent, total int64) {
+	progressToken := req.Params.GetProgressToken()
+	lastPercent := -1
+
+	return func(label string, sent, total int64) {
+		if progressToken == nil || totalBytes <= 0 || ctx.Err() != nil {
+			return
+		}
+
+		percent := int(sent * 100 / totalBytes)
+		if percent == lastPercent {
+			return
+		}
+		lastPercent = percent
+
+		notifyCtx, cancel := context.WithTimeout(ctx, notifyProgressTimeout)
+
+		_ = req.Session.NotifyProgress(notifyCtx, &mcp.ProgressNotificationParams{
+			ProgressToken: progressToken,
+			Progress:      float64(sent),
+			Total:         float64(totalBytes),
+			Message:       fmt.Sprintf("%s: %d%%", label, percent),
+		})
+
+		cancel()
+	}
+}
+
+type GetFlashJobsInput struct{}
+
+type GetFlashJobsOutput struct {
+	Jobs []FlashJobStatus `json:"jobs" jsonschema:"all flash jobs, oldest first"`
+}
+
+// startFlashJob runs a flashing operation detached from the caller's request
+// context and returns the job's ID
+func (s *Service) startFlashJob(kind, detail string, run func(ctx context.Context, progress func(label string, sent, total int64)) (any, error)) string {
+	id := make([]byte, 4)
+	if _, err := rand.Read(id); err != nil {
+		panic(err)
+	}
+
+	job := &flashJob{
+		id:      hex.EncodeToString(id),
+		kind:    kind,
+		detail:  detail,
+		status:  flashJobQueued,
+		started: time.Now(),
+	}
+
+	s.flashJobsLock.Lock()
+	s.flashJobs = append(s.flashJobs, job)
+
+	// Drop the oldest finished jobs past the retention limit
+	finished := 0
+	for _, j := range s.flashJobs {
+		if j.status == flashJobSucceeded || j.status == flashJobFailed {
+			finished++
+		}
+	}
+	for finished > flashJobsKept {
+		for i, j := range s.flashJobs {
+			if j.status == flashJobSucceeded || j.status == flashJobFailed {
+				s.flashJobs = append(s.flashJobs[:i], s.flashJobs[i+1:]...)
+				finished--
+
+				break
+			}
+		}
+	}
+	s.flashJobsLock.Unlock()
+
+	s.wg.Add(1)
+	go func() {
+		defer s.wg.Done()
+
+		if err := s.lockFlash(s.baseCtx); err != nil {
+			s.finishFlashJob(job, nil, err)
+
+			return
+		}
+		defer s.flashLock.Unlock()
+
+		s.flashJobsLock.Lock()
+		job.status = flashJobRunning
+		s.flashJobsLock.Unlock()
+
+		result, err := run(s.baseCtx, func(label string, sent, total int64) {
+			s.flashJobsLock.Lock()
+			defer s.flashJobsLock.Unlock()
+
+			job.label = label
+			job.sent = sent
+			job.total = total
+		})
+
+		s.finishFlashJob(job, result, err)
+	}()
+
+	return job.id
+}
+
+func (s *Service) finishFlashJob(job *flashJob, result any, err error) {
+	s.flashJobsLock.Lock()
+	defer s.flashJobsLock.Unlock()
+
+	job.ended = time.Now()
+
+	if err != nil {
+		job.status = flashJobFailed
+		job.err = err.Error()
+
+		return
+	}
+
+	job.status = flashJobSucceeded
+	job.result = result
+}
+
+func (s *Service) GetFlashJobs(ctx context.Context, req *mcp.CallToolRequest, input GetFlashJobsInput) (*mcp.CallToolResult, *GetFlashJobsOutput, error) {
+	s.flashJobsLock.Lock()
+	defer s.flashJobsLock.Unlock()
+
+	jobs := []FlashJobStatus{}
+	for _, job := range s.flashJobs {
+		end := job.ended
+		if end.IsZero() {
+			end = time.Now()
+		}
+
+		jobs = append(jobs, FlashJobStatus{
+			ID:         job.id,
+			Kind:       job.kind,
+			Detail:     job.detail,
+			Status:     job.status,
+			Error:      job.err,
+			Label:      job.label,
+			SentBytes:  job.sent,
+			TotalBytes: job.total,
+			Result:     job.result,
+			StartedAt:  job.started.UnixMilli(),
+			DurationMs: end.Sub(job.started).Milliseconds(),
+		})
+	}
+
+	return nil, &GetFlashJobsOutput{Jobs: jobs}, nil
+}
diff --git a/pkg/svc/flash_multi_flash.go b/pkg/svc/flash_multi_flash.go
new file mode 100644
index 0000000000000000000000000000000000000000..c21c067eb1998a5ce2e74799c3af5e1d32297fb7
--- /dev/null
+++ b/pkg/svc/flash_multi_flash.go
@@ -0,0 +1,275 @@
+package svc
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+	"time"
+
+	"codeberg.org/pojntfx/pushrod/pkg/fastboot"
+	"codeberg.org/pojntfx/pushrod/pkg/fastboot/usb"
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+var (
+	MultiFlashTool = &mcp.Tool{
+		Name:        "flash.multiFlash",
+		Title:       "Flash partition layout",
+		Description: "Write whole partition layouts to a device in one session, like fastboot.yaml's multi_flash: apply each uploaded partition JSON in order — the MTD one for the device's mtd-size first (fall back to the next smaller power of two when no exact one exists, e.g. partition_4m.json for 8M), then the block one for its blk-size (e.g. partition_universal.json; read both via flash.getVar). For each JSON this writes the table it declares, then flashes every partition it lists, honoring each entry's compress. Upload every referenced image first (files.getFiles); a missing one fails before anything is flashed. The device keeps a layout only for one session, so flashing partitions with separate flash.flashFile calls does not work. Pass a progress token to stream progress while it runs",
+		Annotations: &mcp.ToolAnnotations{DestructiveHint: &[]bool{true}[0]},
+	}
+
+	ErrNoPartitionJSONs  = errors.New("no partition JSONs given")
+	ErrNoFormatPartition = errors.New(`partition JSON has no "format" field naming the partition to write the table to`)
+	ErrImagesNotUploaded = errors.New("images referenced by the partition JSON are not uploaded yet")
+)
+
+// partitionTable mirrors the SpacemiT partition JSON: the table is written by
+// flashing the JSON itself to the partition named in "format", and each entry
+// in "partitions" is then flashed individually
+type partitionTable struct {
+	Format     string `json:"format"`
+	Partitions []struct {
+		Name     string `json:"name"`
+		Image    string `json:"image"`
+		Compress string `json:"compress"`
+	} `json:"partitions"`
+}
+
+type MultiFlashInput struct {
+	Files  []string `json:"files" jsonschema:"names of the uploaded partition JSONs to apply in order, like [partition_4m.json, partition_universal.json] from files.getFiles"`
+	Port   string   `json:"port" jsonschema:"port of the device to flash, in BUS-PORT form (e.g. 1-2-3) from flash.getDevices"`
+	Reboot bool     `json:"reboot" jsonschema:"whether to reboot the device afterwards so it boots the freshly flashed images"`
+	// Flashing a whole layout takes minutes because the device erases and
+	// writes NOR itself, so the default is to run in the background
+	Background bool `json:"background,omitempty" jsonschema:"return a job ID immediately instead of waiting for the flash, then poll flash.getJobs for progress and the result; recommended, since a full layout flash outlives most clients' request timeouts"`
+}
+
+type FlashedPartition struct {
+	Partition  string `json:"partition" jsonschema:"partition that was flashed"`
+	File       string `json:"file" jsonschema:"uploaded file that was flashed to the partition"`
+	DurationMs int64  `json:"durationMs" jsonschema:"how long the partition took to flash, in milliseconds"`
+}
+
+type MultiFlashOutput struct {
+	JobID            string             `json:"jobId,omitempty" jsonschema:"ID of the background job, to poll with flash.getJobs; only set with background:true"`
+	Files            []string           `json:"files,omitempty" jsonschema:"names of the partition JSONs that were applied, in order"`
+	FormatPartitions []string           `json:"formatPartitions,omitempty" jsonschema:"partitions the tables were written to, in the same order"`
+	Flashed          []FlashedPartition `json:"flashed,omitempty" jsonschema:"partitions that were flashed, in the order the JSONs list them"`
+	Rebooted         bool               `json:"rebooted,omitempty" jsonschema:"whether the device was rebooted afterwards"`
+	DurationMs       int64              `json:"durationMs,omitempty" jsonschema:"how long the whole flash took, in milliseconds"`
+}
+
+// partitionImage is one partition from a JSON resolved to its uploaded file
+type partitionImage struct {
+	partition string
+	name      string
+	path      string
+	gzipLevel *int
+	size      int64
+}
+
+// parsedTable is a partition JSON resolved to its on-disk files, ready to flash
+type parsedTable struct {
+	name   string
+	format string
+	path   string
+	size   int64
+	images []partitionImage
+}
+
+// parsePartitionTable loads and validates one uploaded partition JSON and
+// resolves every image it references to an uploaded file, so a missing one
+// fails before anything is flashed. The JSON's image paths flatten to the same
+// names the uploads were stored under.
+func (s *Service) parsePartitionTable(file string) (*parsedTable, []string, error) {
+	path, name, err := s.resolveUploadedFile(file)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	contents, err := os.ReadFile(path)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	var table partitionTable
+	if err := json.Unmarshal(contents, &table); err != nil {
+		return nil, nil, err
+	}
+
+	if table.Format == "" {
+		return nil, nil, ErrNoFormatPartition
+	}
+
+	parsed := &parsedTable{
+		name:   name,
+		format: table.Format,
+		path:   path,
+		size:   int64(len(contents)),
+	}
+
+	missing := []string{}
+	for _, partition := range table.Partitions {
+		// Entries without both a name and an image are placeholders, not
+		// something to flash
+		if partition.Name == "" || partition.Image == "" {
+			continue
+		}
+
+		imagePath, imageName, err := s.resolveUploadedFile(partition.Image)
+		if err != nil {
+			if errors.Is(err, ErrFileNotFound) {
+				missing = append(missing, imageName)
+
+				continue
+			}
+
+			return nil, nil, err
+		}
+
+		gzipLevel, err := parseCompress(partition.Compress)
+		if err != nil {
+			return nil, nil, err
+		}
+
+		info, err := os.Stat(imagePath)
+		if err != nil {
+			return nil, nil, err
+		}
+
+		parsed.images = append(parsed.images, partitionImage{
+			partition: partition.Name,
+			name:      imageName,
+			path:      imagePath,
+			gzipLevel: gzipLevel,
+			size:      info.Size(),
+		})
+	}
+
+	return parsed, missing, nil
+}
+
+func (s *Service) MultiFlash(ctx context.Context, req *mcp.CallToolRequest, input MultiFlashInput) (*mcp.CallToolResult, *MultiFlashOutput, error) {
+	if len(input.Files) == 0 {
+		return nil, nil, ErrNoPartitionJSONs
+	}
+
+	// Parse every JSON and resolve every referenced image before touching the
+	// device, so a missing one fails before anything is flashed
+	tables := []*parsedTable{}
+	missing := []string{}
+	for _, file := range input.Files {
+		parsed, missingImages, err := s.parsePartitionTable(file)
+		if err != nil {
+			return nil, nil, err
+		}
+
+		tables = append(tables, parsed)
+		missing = append(missing, missingImages...)
+	}
+
+	if len(missing) > 0 {
+		return nil, nil, fmt.Errorf("%w: %s", ErrImagesNotUploaded, strings.Join(missing, ", "))
+	}
+
+	portPath, err := usb.ParsePortPath(input.Port)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	// Progress is reported across the whole flash: the JSONs plus every image
+	var totalBytes int64
+	names := []string{}
+	for _, table := range tables {
+		names = append(names, table.name)
+
+		totalBytes += table.size
+		for _, image := range table.images {
+			totalBytes += image.size
+		}
+	}
+
+	run := func(ctx context.Context, progress func(label string, sent, total int64)) (*MultiFlashOutput, error) {
+		var sentBase int64
+		progressFor := func(label string) fastboot.ProgressCallback {
+			return func(sent, total int64) {
+				progress(label, sentBase+sent, totalBytes)
+			}
+		}
+
+		flasher, err := fastboot.OpenFlasher(ctx, portPath)
+		if err != nil {
+			return nil, err
+		}
+		defer flasher.Close()
+
+		start := time.Now()
+
+		formatPartitions := []string{}
+		flashed := []FlashedPartition{}
+		for _, table := range tables {
+			// The table is created by flashing the JSON itself to the "format"
+			// partition, exactly as flashserver's multi_flash does; the file is
+			// tiny
+			if err := flasher.FlashFile(ctx, table.format, table.path, nil, progressFor(table.format)); err != nil {
+				return nil, err
+			}
+			sentBase += table.size
+
+			formatPartitions = append(formatPartitions, table.format)
+
+			for _, image := range table.images {
+				partitionStart := time.Now()
+
+				if err := flasher.FlashFile(ctx, image.partition, image.path, image.gzipLevel, progressFor(image.partition)); err != nil {
+					return nil, err
+				}
+				sentBase += image.size
+
+				flashed = append(flashed, FlashedPartition{
+					Partition:  image.partition,
+					File:       image.name,
+					DurationMs: time.Since(partitionStart).Milliseconds(),
+				})
+			}
+		}
+
+		if input.Reboot {
+			if err := flasher.Reboot(ctx); err != nil {
+				return nil, err
+			}
+		}
+
+		return &MultiFlashOutput{
+			Files:            names,
+			FormatPartitions: formatPartitions,
+			Flashed:          flashed,
+			Rebooted:         input.Reboot,
+			DurationMs:       time.Since(start).Milliseconds(),
+		}, nil
+	}
+
+	if input.Background {
+		return nil, &MultiFlashOutput{
+			JobID: s.startFlashJob("flash.multiFlash", strings.Join(names, ", "), func(ctx context.Context, progress func(label string, sent, total int64)) (any, error) {
+				return run(ctx, progress)
+			}),
+		}, nil
+	}
+
+	if err := s.lockFlash(ctx); err != nil {
+		return nil, nil, err
+	}
+	defer s.flashLock.Unlock()
+
+	output, err := run(ctx, notifyProgress(ctx, req, totalBytes))
+	if err != nil {
+		return nil, nil, err
+	}
+
+	return nil, output, nil
+}
