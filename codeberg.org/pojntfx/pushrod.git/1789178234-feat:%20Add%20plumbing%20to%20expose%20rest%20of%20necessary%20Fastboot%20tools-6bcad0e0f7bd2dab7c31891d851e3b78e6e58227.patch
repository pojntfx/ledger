diff --git a/pkg/svc/flash_continue.go b/pkg/svc/flash_continue.go
new file mode 100644
index 0000000000000000000000000000000000000000..0b1636a8f7d60b8b22a7b6c14bcf1f1e57774760
--- /dev/null
+++ b/pkg/svc/flash_continue.go
@@ -0,0 +1,47 @@
+package svc
+
+import (
+	"context"
+
+	"codeberg.org/pojntfx/pushrod/pkg/fastboot"
+	"codeberg.org/pojntfx/pushrod/pkg/fastboot/usb"
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+var (
+	ContinueTool = &mcp.Tool{
+		Name:        "flash.continue",
+		Title:       "Continue",
+		Description: "Leave fastboot mode so the device boots the image last staged into its memory (flash.stage); after the board re-enumerates, list devices again to pick up its new port",
+		Annotations: &mcp.ToolAnnotations{DestructiveHint: &[]bool{false}[0]},
+	}
+)
+
+type ContinueInput struct {
+	Port string `json:"port" jsonschema:"port of the device to continue, in BUS-PORT form (e.g. 1-2-3) from flash.getDevices"`
+}
+
+type ContinueOutput struct {
+	Response string `json:"response" jsonschema:"text the device returned, if any"`
+}
+
+func (s *Service) Continue(ctx context.Context, req *mcp.CallToolRequest, input ContinueInput) (*mcp.CallToolResult, *ContinueOutput, error) {
+	portPath, err := usb.ParsePortPath(input.Port)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	if err := s.lockFlash(ctx); err != nil {
+		return nil, nil, err
+	}
+	defer s.flashLock.Unlock()
+
+	response, err := fastboot.Continue(ctx, portPath)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	return nil, &ContinueOutput{
+		Response: response,
+	}, nil
+}
