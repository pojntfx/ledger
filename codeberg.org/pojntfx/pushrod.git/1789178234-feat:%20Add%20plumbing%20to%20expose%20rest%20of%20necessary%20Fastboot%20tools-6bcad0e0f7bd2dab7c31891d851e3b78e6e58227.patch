+	Compress  string `json:"compress,omitempty" jsonschema:"compression to use for the transfer, in gzip-N form (e.g. gzip-5) as declared by the partition table; empty flashes raw, which is slower for large files"`
+	// Large flashes can outlive the client's request timeout even compressed,
+	// since the device-side erase and write are slow
+	Background bool `json:"background,omitempty" jsonschema:"return a job ID immediately instead of waiting for the flash, then poll flash.getJobs for progress and the result; recommended for large images like rootfs"`
+}
+
+// parseCompress turns the partition JSON's compress syntax (gzip-N) into a gzip
+// level; empty means no compression
+func parseCompress(compress string) (*int, error) {
+	if compress == "" {
+		return nil, nil
+	}
+
+	parts := strings.Split(compress, "-")
+	if len(parts) != 2 || parts[0] != "gzip" {
+		return nil, ErrCompressNotValid
+	}
+
+	level, err := strconv.Atoi(parts[1])
+	if err != nil || level < 0 || level > 9 {
+		return nil, ErrCompressNotValid
+	}
+
+	return &level, nil
 }
 
