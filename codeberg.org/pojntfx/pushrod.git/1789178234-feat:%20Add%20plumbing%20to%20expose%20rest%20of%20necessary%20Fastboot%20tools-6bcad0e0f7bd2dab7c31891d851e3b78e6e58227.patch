diff --git a/pkg/svc/flash_get_var.go b/pkg/svc/flash_get_var.go
new file mode 100644
index 0000000000000000000000000000000000000000..f5ef57e5ad52d58ddea768c9f944c3e0c04fa406
--- /dev/null
+++ b/pkg/svc/flash_get_var.go
@@ -0,0 +1,50 @@
+package svc
+
+import (
+	"context"
+
+	"codeberg.org/pojntfx/pushrod/pkg/fastboot"
+	"codeberg.org/pojntfx/pushrod/pkg/fastboot/usb"
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+var (
+	GetVarTool = &mcp.Tool{
+		Name:        "flash.getVar",
+		Title:       "Get fastboot variable",
+		Description: "Read a fastboot variable from a device, like mtd-size or blk-size, to work out which partition table applies before flashing",
+		Annotations: &mcp.ToolAnnotations{ReadOnlyHint: true},
+	}
+)
+
+type GetVarInput struct {
+	Variable string `json:"variable" jsonschema:"the fastboot variable to read, like mtd-size, blk-size or max-download-size"`
+	Port     string `json:"port" jsonschema:"port of the device to read from, in BUS-PORT form (e.g. 1-2-3) from flash.getDevices"`
+}
+
+type GetVarOutput struct {
+	Variable string `json:"variable" jsonschema:"the variable that was read"`
+	Value    string `json:"value" jsonschema:"the value the device reported for the variable"`
+}
+
+func (s *Service) GetVar(ctx context.Context, req *mcp.CallToolRequest, input GetVarInput) (*mcp.CallToolResult, *GetVarOutput, error) {
+	portPath, err := usb.ParsePortPath(input.Port)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	if err := s.lockFlash(ctx); err != nil {
+		return nil, nil, err
+	}
+	defer s.flashLock.Unlock()
+
+	value, err := fastboot.GetVar(ctx, portPath, input.Variable)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	return nil, &GetVarOutput{
+		Variable: input.Variable,
+		Value:    value,
+	}, nil
+}
diff --git a/pkg/svc/flash_jobs.go b/pkg/svc/flash_jobs.go
