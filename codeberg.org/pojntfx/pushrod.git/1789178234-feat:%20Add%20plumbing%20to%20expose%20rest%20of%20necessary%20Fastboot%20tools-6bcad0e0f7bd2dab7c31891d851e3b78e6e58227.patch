+package svc
+
+import (
+	"context"
+	"fmt"
+
+	"codeberg.org/pojntfx/pushrod/pkg/fastboot"
+	"codeberg.org/pojntfx/pushrod/pkg/fastboot/usb"
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+var (
+	StageTool = &mcp.Tool{
+		Name:        "flash.stage",
+		Title:       "Stage file",
+		Description: "Download an uploaded file into a device's memory without flashing it, to bootstrap a board that is still in ROM/FDL mode up into u-boot fastboot mode; stage the FSBL and u-boot images, running flash.continue after each. Pass a progress token to stream progress while it runs",
+		Annotations: &mcp.ToolAnnotations{DestructiveHint: &[]bool{false}[0]},
+	}
+)
+
+type StageInput struct {
+	File string `json:"file" jsonschema:"name of the uploaded file to stage, like FSBL.bin from files.getFiles"`
+	Port string `json:"port" jsonschema:"port of the device to stage to, in BUS-PORT form (e.g. 1-2-3) from flash.getDevices"`
+}
+
+type StageOutput struct {
+	File string `json:"file" jsonschema:"name of the file that was staged"`
+}
+
+func (s *Service) Stage(ctx context.Context, req *mcp.CallToolRequest, input StageInput) (*mcp.CallToolResult, *StageOutput, error) {
+	path, name, err := s.resolveUploadedFile(input.File)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	portPath, err := usb.ParsePortPath(input.Port)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	if err := s.lockFlash(ctx); err != nil {
+		return nil, nil, err
+	}
+	defer s.flashLock.Unlock()
+
+	progressToken := req.Params.GetProgressToken()
+	lastPercent := -1
+	progress := func(sent, total int64) {
+		if progressToken == nil || total <= 0 || ctx.Err() != nil {
+			return
+		}
+
+		percent := int(sent * 100 / total)
+		if percent == lastPercent {
+			return
+		}
+		lastPercent = percent
+
+		notifyCtx, cancel := context.WithTimeout(ctx, notifyProgressTimeout)
+
+		_ = req.Session.NotifyProgress(notifyCtx, &mcp.ProgressNotificationParams{
+			ProgressToken: progressToken,
+			Progress:      float64(sent),
+			Total:         float64(total),
+			Message:       fmt.Sprintf("%d%%", percent),
+		})
+
+		cancel()
+	}
+
+	if err := fastboot.Stage(ctx, portPath, path, progress); err != nil {
+		return nil, nil, err
+	}
+
+	return nil, &StageOutput{
+		File: name,
+	}, nil
+}
diff --git a/pkg/svc/root.go b/pkg/svc/root.go
index 0be83d52c422aa134e0707c869e57e9fa6c9962b..8a483d5efe90a46ecb87a038fba4f73ca3a687f7 100644
--- a/pkg/svc/root.go
+++ b/pkg/svc/root.go
@@ -3,6 +3,7 @@
 import (
 	"context"
 	"errors"
+	"fmt"
 	"slices"
 	"sync"
 	"time"
@@ -26,6 +27,32 @@ 	KVM_VIDEO_VENDOR_ID  = "345f"
 	KVM_VIDEO_PRODUCT_ID = "2131"
 )
 
+// ctxLock is a mutex whose Lock honors the caller's context, so a request
+// whose client has already gone away fails instead of queueing behind a
+// running operation and executing after nobody is listening anymore
+type ctxLock chan struct{}
+
+func newCtxLock() ctxLock {
+	l := make(ctxLock, 1)
+	l <- struct{}{}
+	return l
+}
+
+func (l ctxLock) Lock(ctx context.Context) error {
+	select {
+	case <-l:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+func (l ctxLock) Unlock() { l <- struct{}{} }
+
+// ErrFlashBusy is returned when a flash operation could not start because
+// another one was still running when the caller's context was cancelled
+var ErrFlashBusy = errors.New("another flash operation is still running")
