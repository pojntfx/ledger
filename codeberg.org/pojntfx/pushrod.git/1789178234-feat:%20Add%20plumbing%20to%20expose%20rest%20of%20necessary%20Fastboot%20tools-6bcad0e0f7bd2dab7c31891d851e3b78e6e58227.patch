diff --git a/pkg/fastboot/gzip.go b/pkg/fastboot/gzip.go
new file mode 100644
index 0000000000000000000000000000000000000000..66c77ab945c16917aff71e1fc7f9454538f7e912
--- /dev/null
+++ b/pkg/fastboot/gzip.go
@@ -0,0 +1,97 @@
+// This file ports the gzip flashing path from the SpacemiT flashserver Go
+// reimplementation. The image is read in blocks of the device's
+// max-download-size, each block is gzip-compressed on its own and flashed with
+// the plain download/flash commands; the device decompresses each block as it
+// receives it and appends it to the partition.
+package fastboot
+
+import (
+	"bytes"
+	"compress/gzip"
+	"context"
+	"io"
+	"os"
+)
+
+// compressBlock gzip-compresses data at the given level
+func compressBlock(data []byte, level int) ([]byte, error) {
+	var buf bytes.Buffer
+	w, err := gzip.NewWriterLevel(&buf, level)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := w.Write(data); err != nil {
+		return nil, err
+	}
+	if err := w.Close(); err != nil {
+		return nil, err
+	}
+	return buf.Bytes(), nil
+}
+
+// gzipBlocks reads sourceFile in blocks of blockSize bytes, calling yield with
+// each block's gzipped bytes and the number of original image bytes the block
+// represents. A level of 0 yields the block raw, as flashserver does. The
+// context is checked before compressing each block, since compressing a large
+// block is the one long stretch with no USB traffic to notice a cancellation
+func gzipBlocks(ctx context.Context, sourceFile string, blockSize int64, level int, yield func(data []byte, size int64) error) error {
+	f, err := os.Open(sourceFile)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+
+		block := make([]byte, blockSize)
+		n, rerr := io.ReadFull(f, block)
+		if n > 0 {
+			block = block[:n]
+			if level > 0 {
+				compressed, err := compressBlock(block, level)
+				if err != nil {
+					return err
+				}
+				block = compressed
+			}
+			if err := yield(block, int64(n)); err != nil {
+				return err
+			}
+		}
+		if rerr == io.EOF || rerr == io.ErrUnexpectedEOF {
+			return nil
+		}
+		if rerr != nil {
+			return rerr
+		}
+	}
+}
+
+// flashGzip gzips sourceFile in blocks that each fit under the device's
+// download limit and flashes them to partition, reporting progress in
+// original-image bytes after each block
+func flashGzip(ctx context.Context, p *protocol, partition, sourceFile string, size, limit int64, level int, progress ProgressCallback) error {
+	var flashed int64
+	return gzipBlocks(ctx, sourceFile, limit, level, func(data []byte, blockSize int64) error {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+
+		if err := p.downloadAndFlash(ctx, partition, bytes.NewReader(data), int64(len(data)), nil); err != nil {
+			return err
+		}
+
+		flashed += blockSize
+		if progress != nil {
+			if flashed > size {
+				flashed = size
+			}
+			progress(flashed, size)
+		}
+
+		return nil
+	})
+}
