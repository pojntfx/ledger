diff --git a/buildroot/scripts/3-demo-update.py b/buildroot/scripts/3-demo-update.py
new file mode 100755
index 0000000000000000000000000000000000000000..584f348a8312c761ffeb2bdd3d0f2bafd8be2503
--- /dev/null
+++ b/buildroot/scripts/3-demo-update.py
@@ -0,0 +1,83 @@
+#!/usr/bin/env python3
+import functools
+import http.server
+from pathlib import Path
+import socket
+import subprocess
+import sys
+import threading
+import time
+
+sys.path.insert(0, str(Path(__file__).parent))
+
+import demo_lib
+
+TUNNEL_PORT = 8000
+
+
+class IPv6HTTPServer(http.server.ThreadingHTTPServer):
+    address_family = socket.AF_INET6
+
+
+def main():
+    demo = demo_lib.Demo(
+        "Demo 3: the workstation push",
+        "The laptop serves the next image, updatectl stages it, and the board boots it",
+    )
+    demo.banner()
+    demo.cue("Watch the registry requests, then watch the board reboot into the new image")
+
+    registry = Path(__file__).parent.parent / "output/k3-uefi/registry"
+    handler = functools.partial(http.server.SimpleHTTPRequestHandler, directory=str(registry))
+    server = IPv6HTTPServer(("::", 8000), handler)
+    threading.Thread(target=server.serve_forever, daemon=True).start()
+    demo.result(f"the registry serves {len(list(registry.glob('*')))} artifacts on port 8000")
+
+    tunnel = subprocess.Popen(
+        ["ssh", "-6", "-N", "-o", "ExitOnForwardFailure=yes", "-o", "IdentitiesOnly=yes", "-o", "StrictHostKeyChecking=no",
+         "-i", demo_lib.K3_KEY, "-R", f"[::1]:{TUNNEL_PORT}:[::1]:8000", f"root@{demo_lib.K3_HOST}"],
+        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+    )
+    try:
+        ready = False
+        for _ in range(20):
+            probe = demo.k3.run(f"wget -q -O- http://[::1]:{TUNNEL_PORT}/SHA256SUMS", check=False)
+            if probe.returncode == 0:
+                ready = True
+                break
+            time.sleep(0.5)
+        if not ready:
+            raise demo_lib.DemoError("the registry tunnel did not come up")
+        demo.result("the board sees the laptop registry on its loopback")
+
+        demo.step("Read the version that runs now")
+        demo.run_command("updatectl list --no-pager", 120, lines=4)
+        demo.run_command("grep IMAGE_VERSION /usr/lib/os-release", 60, lines=2)
+
+        demo.step("Stage the next image from the laptop")
+        demo.run_command("updatectl update host", 1200, lines=20)
+
+        demo.step("Read the staged version")
+        demo.run_command("updatectl list --no-pager", 120, lines=4)
+
+        demo.step("Boot the new image")
+        demo.run_command("newest=$(ls /boot/EFI/Linux/rva23_*.efi | sort -V | tail -n1); echo $newest; bootctl set-default $(basename $newest)", 120, lines=2)
+        demo.step("Reboot into the new image")
+        demo.k3.run("systemctl reboot", check=False)
+        time.sleep(5)
+        demo.k3.wait(300)
+        demo.result("the board is back")
+        demo.run_command("grep IMAGE_VERSION /usr/lib/os-release", 60, lines=2)
+        demo.run_command("updatectl list --no-pager", 120, lines=4)
+
+        demo.payoff("The image came from the laptop registry, and the board now runs the new version")
+    finally:
+        tunnel.terminate()
+        tunnel.wait(timeout=15)
+        server.shutdown()
+
+    return demo.finish()
+
+
+if __name__ == "__main__":
+    demo_lib.run(main)
diff --git a/buildroot/scripts/demo-preflight.py b/buildroot/scripts/demo-preflight.py
new file mode 100755
index 0000000000000000000000000000000000000000..e0f67ee5c5b854ad3eef7993d59271f71e618018
--- /dev/null
+++ b/buildroot/scripts/demo-preflight.py
@@ -0,0 +1,68 @@
+#!/usr/bin/env python3
+from pathlib import Path
+import sys
+import time
+import urllib.request
+
+sys.path.insert(0, str(Path(__file__).parent))
+
+import demo_lib
+
+
+def check(demo, name, function):
+    try:
+        detail = function()
+        demo.result(f"{name}: {detail}")
+        return True
+    except Exception as error:
+        demo.note(f"{name}: FAIL ({error})")
+        return False
+
+
+def http_ok(url):
+    with urllib.request.urlopen(url, timeout=5) as response:
+        return response.status
+
+
+def main():
+    demo = demo_lib.Demo("Demo preflight", "Check the board, the verifier services, and the demo hardware")
+    demo.banner()
+    ok = True
+    def board():
+        deadline = time.monotonic() + 90
+        last = None
+        while time.monotonic() < deadline:
+            try:
+                return demo.k3.run("hostname").stdout.strip()
+            except Exception as error:
+                last = error
+                time.sleep(3)
+        raise demo_lib.DemoError(f"the board did not answer: {last}")
+
+    ok &= check(demo, "board SSH", board)
+    ok &= check(demo, "weston", lambda: demo.k3.run("systemctl is-active weston.service").stdout.strip())
+    ok &= check(demo, "extensions", lambda: demo.k3.run("ls /var/lib/extensions").stdout.split())
+    ok &= check(demo, "event view", lambda: http_ok("http://[::1]:8086/"))
+    ok &= check(demo, "report receiver", lambda: http_ok("http://[::1]:8080/"))
+    ok &= check(demo, "wallet", lambda: http_ok("http://[::1]:8081/"))
+    ok &= check(demo, "migration server", lambda: http_ok("http://[::1]:8083/"))
+    archives = demo.k3.run("test -f /tmp/valkey-local.tar && test -f /tmp/pause-image.tar", check=False)
+    if archives.returncode == 0:
+        demo.result("valkey archives: present")
+    else:
+        demo.note("valkey archives: missing, run `make k3-verify-valkey` before demo 7")
+    for tool, label in (("relay.getBoards", "relay"), ("kvm.getVideoCaptureDevices", "KVM capture"), ("kvm.getInputDevices", "KVM input"), ("serial.getConsoles", "serial")):
+        try:
+            data = demo_lib.mcp_call(tool, {})
+            present = bool(next(iter(data.values()), []))
+            demo.result(f"{label}: {'present' if present else 'missing'}")
+        except Exception as error:
+            demo.note(f"{label}: missing ({error})")
+    if not ok:
+        raise demo_lib.DemoError("the preflight found a blocking problem; if the board is down, unplug its USB-C power for five seconds and plug it back in")
+    demo.payoff("The board and the verifier services are ready")
+    return demo.finish()
+
+
+if __name__ == "__main__":
+    demo_lib.run(main)
