+		if err := p.downloadAndFlash(ctx, partition, bytes.NewReader(data), int64(len(data)), nil); err != nil {
 			return err
 		}
-	}
 
-	return nil
+		flashed += chunkSize
+		if progress != nil {
+			if flashed > size {
+				flashed = size
+			}
+			progress(flashed, size)
+		}
+
+		return nil
+	})
