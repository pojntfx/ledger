+// flashSparse splits sourceFile into sparse chunks that each fit under the
+// device's download limit and flashes them to partition, reporting progress in
+// original-image bytes after each chunk
+func flashSparse(ctx context.Context, p *protocol, partition, sourceFile string, size, limit int64, progress ProgressCallback) error {
+	// Keep each sparse chunk a little under the limit, as flashserver does, so
+	// the sparse header and chunk overhead still fit
+	splitMB := limit >> 20
+	if splitMB > 2 {
+		splitMB--
 	}
 
-	if reboot {
-		if err := p.sendCommand("reboot", "", commandTimeoutMs); err != nil {
+	var flashed int64
