diff --git a/pkg/fastboot/sparse.go b/pkg/fastboot/sparse.go
new file mode 100644
index 0000000000000000000000000000000000000000..8fd7fd0ab0cbafaeb03ad6d62e5a5fd5e170468d
--- /dev/null
+++ b/pkg/fastboot/sparse.go
@@ -0,0 +1,333 @@
+// This file ports the Android sparse-image writer from the SpacemiT flashserver
+// Go reimplementation. It splits an image that is larger than the device's
+// max-download-size into sparse chunks small enough to download one at a time;
+// the device reassembles them into the partition.
+package fastboot
+
+import (
+	"bytes"
+	"encoding/binary"
+	"fmt"
+	"io"
+	"os"
+)
+
+const (
+	sparseMagic     = 0xed26ff3a
+	chunkTypeRaw    = 0xCAC1
+	chunkTypeFill   = 0xCAC2
+	chunkTypeDontCa = 0xCAC3
+
+	sparseBlockSize      = 4096
+	sparseFileHeaderSize = 28
+	sparseChunkHdrSize   = 12
+)
+
+type seekBuffer struct {
+	data []byte
+	pos  int64
+}
+
+func (b *seekBuffer) Write(p []byte) (int, error) {
+	end := b.pos + int64(len(p))
+	if end > int64(len(b.data)) {
+		grown := make([]byte, end)
+		copy(grown, b.data)
+		b.data = grown
+	}
+	copy(b.data[b.pos:end], p)
+	b.pos = end
+	return len(p), nil
+}
+
+func (b *seekBuffer) Seek(offset int64, whence int) (int64, error) {
+	var abs int64
+	switch whence {
+	case io.SeekStart:
+		abs = offset
+	case io.SeekCurrent:
+		abs = b.pos + offset
+	case io.SeekEnd:
+		abs = int64(len(b.data)) + offset
+	}
+	if abs < 0 {
+		return 0, fmt.Errorf("negative seek position")
+	}
+	b.pos = abs
+	return abs, nil
+}
+
+func (b *seekBuffer) Tell() int64 { return b.pos }
+
+func (b *seekBuffer) End() int64 { return int64(len(b.data)) }
+
+type simgWriter struct {
+	out            *seekBuffer
+	startBlockOff  int64
+	endBlockOff    int64
+	hasEndBlockOff bool
+	blocksize      int64
+	nchunks        int64
+	nblocks        int64
+	ctype          uint16
+	cval           []byte
+	csize          int64
+	buf            []byte
+}
+
+func newSimgWriter(out *seekBuffer, startBlockOffset, endBlockOffset int64, hasEnd bool, blocksize int64) (*simgWriter, error) {
+	if blocksize <= 0 || blocksize%4 != 0 {
+		return nil, fmt.Errorf("blocksize must be a positive multiple of 4")
+	}
+	w := &simgWriter{
+		out:            out,
+		startBlockOff:  startBlockOffset,
+		endBlockOff:    endBlockOffset,
+		hasEndBlockOff: hasEnd,
+		blocksize:      blocksize,
+	}
+	if _, err := w.out.Write(make([]byte, sparseFileHeaderSize)); err != nil {
+		return nil, err
+	}
+	if err := w.addPadBlocks(w.startBlockOff); err != nil {
+		return nil, err
+	}
+	return w, nil
+}
+
+func (w *simgWriter) tell() int64 { return w.out.Tell() }
+
+func (w *simgWriter) flush() error { return w.closeChunk() }
+
+func (w *simgWriter) close() error {
+	if len(w.buf) > 0 {
+		return fmt.Errorf("%d leftover bytes (data written must be a multiple of blocksize %d)", len(w.buf), w.blocksize)
+	}
+	if err := w.closeChunk(); err != nil {
+		return err
+	}
+	if w.hasEndBlockOff {
+		if err := w.addPadBlocks(w.endBlockOff - w.nblocks); err != nil {
+			return err
+		}
+		if err := w.closeChunk(); err != nil {
+			return err
+		}
+	}
+	if _, err := w.out.Seek(0, io.SeekStart); err != nil {
+		return err
+	}
+	hdr := make([]byte, sparseFileHeaderSize)
+	binary.LittleEndian.PutUint32(hdr[0:], sparseMagic)
+	binary.LittleEndian.PutUint16(hdr[4:], 1)
+	binary.LittleEndian.PutUint16(hdr[6:], 0)
+	binary.LittleEndian.PutUint16(hdr[8:], sparseFileHeaderSize)
+	binary.LittleEndian.PutUint16(hdr[10:], sparseChunkHdrSize)
+	binary.LittleEndian.PutUint32(hdr[12:], uint32(w.blocksize))
+	binary.LittleEndian.PutUint32(hdr[16:], uint32(w.nblocks))
+	binary.LittleEndian.PutUint32(hdr[20:], uint32(w.nchunks))
+	binary.LittleEndian.PutUint32(hdr[24:], 0)
+	if _, err := w.out.Write(hdr); err != nil {
+		return err
+	}
+	_, err := w.out.Seek(0, io.SeekStart)
+	return err
+}
+
+func (w *simgWriter) closeChunk() error {
+	if w.csize == 0 {
+		return nil
+	}
+	var databytes int64
+	switch w.ctype {
+	case chunkTypeRaw:
+		databytes = w.csize * w.blocksize
+		if _, err := w.out.Seek(-databytes-sparseChunkHdrSize, io.SeekCurrent); err != nil {
+			return err
+		}
+	case chunkTypeDontCa:
+		databytes = 0
+	default:
+		databytes = int64(len(w.cval))
+	}
+	hdr := make([]byte, sparseChunkHdrSize)
+	binary.LittleEndian.PutUint16(hdr[0:], w.ctype)
+	binary.LittleEndian.PutUint16(hdr[2:], 0)
+	binary.LittleEndian.PutUint32(hdr[4:], uint32(w.csize))
+	binary.LittleEndian.PutUint32(hdr[8:], uint32(sparseChunkHdrSize+databytes))
+	if _, err := w.out.Write(hdr); err != nil {
+		return err
+	}
+	switch w.ctype {
+	case chunkTypeRaw:
+		if _, err := w.out.Seek(0, io.SeekEnd); err != nil {
+			return err
+		}
+	case chunkTypeDontCa:
+	default:
+		if _, err := w.out.Write(w.cval); err != nil {
+			return err
+		}
+	}
+	w.csize = 0
+	w.nchunks++
+	return nil
+}
+
+func (w *simgWriter) addPadBlocks(n int64) error {
+	if len(w.buf) > 0 {
+		return fmt.Errorf("%d leftover bytes (data written must be a multiple of blocksize %d)", len(w.buf), w.blocksize)
+	}
+	if n <= 0 {
+		return nil
+	}
+	if w.ctype != chunkTypeDontCa {
+		if err := w.closeChunk(); err != nil {
+			return err
+		}
+	}
+	w.ctype = chunkTypeDontCa
+	w.cval = nil
+	w.csize += n
+	w.nblocks += n
+	return nil
+}
+
+func (w *simgWriter) addDataBlock() error {
+	block := w.buf
+	w.buf = nil
+	cval := block[:4]
+	repeated := bytes.Repeat(cval, int(w.blocksize)/4)
+	ctype := uint16(chunkTypeRaw)
+	var val []byte
+	if bytes.Equal(block, repeated) {
+		ctype = chunkTypeFill
+		val = cval
+	}
+	if w.ctype != ctype || !bytes.Equal(w.cval, val) {
+		if err := w.closeChunk(); err != nil {
+			return err
+		}
+	}
+	if ctype == chunkTypeRaw {
+		if ctype != w.ctype {
+			if _, err := w.out.Write(make([]byte, sparseChunkHdrSize)); err != nil {
+				return err
+			}
+		}
+		if _, err := w.out.Write(block); err != nil {
+			return err
+		}
+	}
+	w.ctype = ctype
+	w.cval = val
+	w.csize++
+	w.nblocks++
+	return nil
+}
+
+func (w *simgWriter) write(data []byte) (int64, error) {
+	var nblocks int64
+	pos := 0
+	if len(w.buf) > 0 {
+		need := int(w.blocksize) - len(w.buf)
+		take := min(need, len(data))
+		w.buf = append(w.buf, data[:take]...)
+		pos = take
+		if int64(len(w.buf)) == w.blocksize {
+			if err := w.addDataBlock(); err != nil {
+				return nblocks, err
+			}
+			nblocks++
+		}
+	}
+	for ; pos < len(data); pos += int(w.blocksize) {
+		end := pos + int(w.blocksize)
+		if end > len(data) {
+			end = len(data)
+		}
+		w.buf = append(w.buf[:0], data[pos:end]...)
+		if int64(len(w.buf)) == w.blocksize {
+			if err := w.addDataBlock(); err != nil {
+				return nblocks, err
+			}
+			nblocks++
+		}
+	}
+	return nblocks, nil
+}
+
+// sparseImageChunks splits sourceImg into sparse chunks no larger than splitMB
+// megabytes, calling yield with each chunk's bytes and the number of original
+// image bytes it represents
+func sparseImageChunks(sourceImg string, splitMB int64, yield func(data []byte, size int64) error) error {
+	st, err := os.Stat(sourceImg)
+	if err != nil {
+		return err
+	}
+	var imgTotalBlocks int64
+	hasTotal := false
+	if st.Mode().IsRegular() {
+		imgTotalBlocks = st.Size() / sparseBlockSize
+		hasTotal = true
+	}
+	fh, err := os.Open(sourceImg)
+	if err != nil {
+		return err
+	}
+	defer fh.Close()
+
+	var startBlock int64
+	done := false
+	for !done {
+		if startBlock > 0 {
+			startBlock++
+		}
+		out := &seekBuffer{}
+		wr, err := newSimgWriter(out, startBlock, imgTotalBlocks, hasTotal, sparseBlockSize)
+		if err != nil {
+			return err
+		}
+		var nb int64 = -1
+		broke := false
+		for {
+			block := make([]byte, sparseBlockSize)
+			n, rerr := io.ReadFull(fh, block)
+			if n > 0 {
+				nb++
+				if _, err := wr.write(block[:n]); err != nil {
+					return err
+				}
+				if splitMB > 0 && (wr.tell()+sparseBlockSize)>>20 >= splitMB {
+					broke = true
+				}
+			}
+			if rerr == io.EOF || rerr == io.ErrUnexpectedEOF {
+				if !broke {
+					done = true
+				}
+				break
+			}
+			if rerr != nil {
+				return rerr
+			}
+			if broke {
+				break
+			}
+		}
+		if nb < 0 {
+			return fmt.Errorf("image %s yielded no blocks", sourceImg)
+		}
+		if err := wr.flush(); err != nil {
+			return err
+		}
+		startBlock += nb
+		if err := wr.close(); err != nil {
+			return err
+		}
+		if err := yield(out.data, (nb+1)*sparseBlockSize); err != nil {
+			return err
+		}
+	}
+	return nil
+}
