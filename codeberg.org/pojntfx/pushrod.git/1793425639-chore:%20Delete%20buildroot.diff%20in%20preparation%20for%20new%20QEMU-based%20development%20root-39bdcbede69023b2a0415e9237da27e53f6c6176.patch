-diff --git a/buildroot-ext/board/spacemit/k3/target_overlay/lib/firmware/powervr/FETCH-FIRMWARE.md b/buildroot-ext/board/spacemit/k3/target_overlay/lib/firmware/powervr/FETCH-FIRMWARE.md
-new file mode 100644
-index 0000000..5ae5aab
---- /dev/null
-+++ b/buildroot-ext/board/spacemit/k3/target_overlay/lib/firmware/powervr/FETCH-FIRMWARE.md
-@@ -0,0 +1,16 @@
-+# GPU firmware placeholder
-+
-+Place `rogue_36.56.104.183_v1.fw` in this directory before the build.
-+Do not commit the file. The licence is proprietary: SpaceMiT marks its DDK `Strictly Confidential` and non-redistributable.
-+
-+Obtain the file from one of these sources:
-+
-+- SpaceMiT K3 images, at https://archive.spacemit.com/image/k3/ . Extract `/lib/firmware/powervr/rogue_36.56.104.183_v1.fw` from an image.
-+- The K3 buildroot SDK, at `package-src/img-gpu-powervr/target/lib/firmware/rgx.fw.36.56.104.183`. That copy is a different build of the same microcode.
-+
-+Make sure that the file has these properties:
-+
-+- size 131072 bytes
-+- sha256 `1db1c399c17401d1f79d46c880db81c724d748c784d4639433b076aba2f9c0d2`
-+
-+The kernel driver `DRM_POWERVR` loads the file at boot. Without the file, the GPU stack fails.
-diff --git a/buildroot-ext/board/spacemit/k3/target_overlay/root/run_weston.sh b/buildroot-ext/board/spacemit/k3/target_overlay/root/run_weston.sh
-index 22ca456..7816b68 100755
---- a/buildroot-ext/board/spacemit/k3/target_overlay/root/run_weston.sh
-+++ b/buildroot-ext/board/spacemit/k3/target_overlay/root/run_weston.sh
-@@ -1,12 +1,39 @@
--export MESA_LOADER_DRIVER_OVERRIDE=pvr
-+export MESA_LOADER_DRIVER_OVERRIDE=zink
- export XDG_RUNTIME_DIR=/root
- export QT_QPA_PLATFORM_PLUGIN_PATH=/usr/lib/qt/plugins/platforms
- export QT_QPA_PLATFORM=wayland
- 
--XDG_RUNTIME_DIR=/root weston --drm-device=card1 --idle-time=0 --log=/var/log/weston.1 &
--WESTON_PID1=$!
-+# The open Mesa "imagination" Vulkan driver only reports itself as conformant
-+# for BVNC 36.53.104.796. The K3's GPU is 36.56.104.183, so the driver refuses
-+# to expose the physical device (vkEnumeratePhysicalDevices ->
-+# VK_ERROR_INITIALIZATION_FAILED, "not a conformant Vulkan implementation")
-+# unless this override is set. zink then has a Vulkan device to render on.
-+export PVR_I_WANT_A_BROKEN_VULKAN_DRIVER=1
- 
--XDG_RUNTIME_DIR=/root weston --drm-device=card2 --idle-time=0 --log=/var/log/weston.2 &
--WESTON_PID2=$!
-+# Auto-detect the DRM card that actually has a connected output (DP/HDMI/eDP)
-+# instead of hard-coding card1/card2. On this board the edp0 CRTC often has no
-+# panel ("Cannot find any crtc or sizes"), and a second card2 may not exist at
-+# all, which made the old hard-coded launch fail. Pick the first card that has
-+# a connected connector, falling back to card1.
-+DRM_DEVICE="card1"
-+for status in /sys/class/drm/card*-*/status; do
-+    [ -e "$status" ] || continue
-+    if [ "$(cat "$status" 2>/dev/null)" = "connected" ]; then
-+        conn=$(basename "$(dirname "$status")")
-+        DRM_DEVICE=$(echo "$conn" | grep -o 'card[0-9]*')
-+        break
-+    fi
-+done
- 
--wait $WESTON_PID1 $WESTON_PID2
-+echo "run_weston: using DRM device $DRM_DEVICE"
-+
-+# Prefer Weston's native Vulkan renderer (weston 15+), which drives the open
-+# imagination Vulkan driver directly. Fall back to the GL renderer (zink over
-+# Vulkan) if the Vulkan renderer isn't available/fails.
-+if weston --help 2>&1 | grep -q -- '--renderer'; then
-+    echo "run_weston: trying native Vulkan renderer"
-+    XDG_RUNTIME_DIR=/root weston --drm-device="$DRM_DEVICE" --renderer=vulkan \
-+        --idle-time=0 --log=/var/log/weston.log && exit 0
-+    echo "run_weston: Vulkan renderer failed, falling back to GL (zink)"
-+fi
-+XDG_RUNTIME_DIR=/root weston --drm-device="$DRM_DEVICE" --idle-time=0 --log=/var/log/weston.log
