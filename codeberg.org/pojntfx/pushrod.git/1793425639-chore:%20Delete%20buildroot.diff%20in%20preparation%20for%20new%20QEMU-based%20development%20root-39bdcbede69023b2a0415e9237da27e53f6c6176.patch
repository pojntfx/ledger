-index b38ef2e..e2d4ac5 100755
---- a/buildroot-ext/board/spacemit/k3/post-build.sh
-+++ b/buildroot-ext/board/spacemit/k3/post-build.sh
-@@ -1,3 +1,20 @@
- #!/bin/bash -e
- DATE=$(date +%Y%m%d%H%M%S)
--echo "$DATE" | tee "${TARGET_DIR}/etc/bianbu_version"
-\ No newline at end of file
-+echo "$DATE" | tee "${TARGET_DIR}/etc/bianbu_version"
-+
-+# --- SSH: allow key-based root login for the pre-seeded authorized_keys ---
-+# sshd is strict about permissions: /root/.ssh must be 0700 and
-+# authorized_keys 0600. Root ownership (uid 0) is applied later by Buildroot's
-+# fakeroot pass via the permission table in the .mk, so only fix modes here
-+# (a real chown would fail in a non-root build).
-+if [ -f "${TARGET_DIR}/root/.ssh/authorized_keys" ]; then
-+	chmod 0700 "${TARGET_DIR}/root/.ssh"
-+	chmod 0600 "${TARGET_DIR}/root/.ssh/authorized_keys"
-+fi
-+
-+# Ensure pubkey auth is explicitly enabled (default is on, but make it explicit).
-+SSHD_CONFIG="${TARGET_DIR}/etc/ssh/sshd_config"
-+if [ -f "${SSHD_CONFIG}" ]; then
-+	sed -i 's/^#\?PubkeyAuthentication .*/PubkeyAuthentication yes/' "${SSHD_CONFIG}"
-+	sed -i 's/^#\?PermitRootLogin .*/PermitRootLogin yes/' "${SSHD_CONFIG}"
-+fi
-\ No newline at end of file
-diff --git a/buildroot-ext/board/spacemit/k3/target_overlay/etc/inittab b/buildroot-ext/board/spacemit/k3/target_overlay/etc/inittab
-new file mode 100644
-index 0000000..9498f11
---- /dev/null
-+++ b/buildroot-ext/board/spacemit/k3/target_overlay/etc/inittab
-@@ -0,0 +1,44 @@
-+# /etc/inittab
-+#
-+# Copyright (C) 2001 Erik Andersen <andersen@codepoet.org>
-+#
-+# Note: BusyBox init doesn't support runlevels.  The runlevels field is
-+# completely ignored by BusyBox init. If you want runlevels, use
-+# sysvinit.
-+#
-+# Format for each entry: <id>:<runlevels>:<action>:<process>
-+#
-+# id        == tty to run on, or empty for /dev/console
-+# runlevels == ignored
-+# action    == one of sysinit, respawn, askfirst, wait, and once
-+# process   == program to run
-+
-+# Startup the system
-+::sysinit:/bin/mount -t proc proc /proc
-+::sysinit:/bin/mount -o remount,rw /
-+::sysinit:/bin/mkdir -p /dev/pts /dev/shm
-+::sysinit:/bin/mount -a
-+::sysinit:/bin/mkdir -p /run/lock/subsys
-+::sysinit:/sbin/swapon -a
-+null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
-+null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
-+null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
-+null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
-+::sysinit:/bin/hostname -F /etc/hostname
-+# now run any rc scripts
-+::sysinit:/etc/init.d/rcS
-+
-+# Login prompt on the HDMI/framebuffer console (/dev/console -> tty1)
-+console::respawn:/sbin/getty -L  console 0 vt100
-+# Additional login prompt on the serial debug UART (ttyS0 @ 115200) so a login
-+# shell is always reachable over the serial console (minicom), independent of
-+# which device the kernel picked as /dev/console.
-+ttyS0::respawn:/sbin/getty -L ttyS0 115200 vt100
-+
-+# Stuff to do for the 3-finger salute
-+::ctrlaltdel:/sbin/reboot
-+
-+# Stuff to do before rebooting
-+::shutdown:/etc/init.d/rcK
-+::shutdown:/sbin/swapoff -a
-+::shutdown:/bin/umount -a -r
-diff --git a/buildroot-ext/board/spacemit/k3/target_overlay/etc/profile.d/powervr-vulkan.sh b/buildroot-ext/board/spacemit/k3/target_overlay/etc/profile.d/powervr-vulkan.sh
-new file mode 100644
-index 0000000..69f662b
---- /dev/null
-+++ b/buildroot-ext/board/spacemit/k3/target_overlay/etc/profile.d/powervr-vulkan.sh
-@@ -0,0 +1,5 @@
-+# The open Mesa "imagination" Vulkan driver gates itself behind a conformance
-+# check that only passes for BVNC 36.53.104.796. The SpacemiT K3 GPU is
-+# 36.56.104.183, so without this override vkEnumeratePhysicalDevices fails with
-+# VK_ERROR_INITIALIZATION_FAILED and no Vulkan/zink/GL is available.
-+export PVR_I_WANT_A_BROKEN_VULKAN_DRIVER=1
