- // Common parameter
--console=ttyS0,115200
-+// console: HDMI (tty1) AND the serial debug UART (ttyS0). Serial is listed LAST
-+// so it becomes the primary /dev/console (kernel log + init land on serial),
-+// while HDMI (tty1) still shows output too. Login gettys run on both (inittab).
-+console=tty1 console=ttyS0,115200
- init=/init
- bootdelay=0
- knl_name=Image
