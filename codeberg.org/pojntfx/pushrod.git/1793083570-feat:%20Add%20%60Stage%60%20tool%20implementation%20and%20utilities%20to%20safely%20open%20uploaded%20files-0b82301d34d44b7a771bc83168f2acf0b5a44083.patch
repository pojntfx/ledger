diff --git a/pkg/svc/flash.go b/pkg/svc/flash.go
new file mode 100644
index 0000000000000000000000000000000000000000..a1765bf93cbf3a2fe0c1403678a35ec11359971b
--- /dev/null
+++ b/pkg/svc/flash.go
@@ -0,0 +1,42 @@
+package svc
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+const progressNotificationTimeout = 5 * time.Second // So that we don't hang forever if the remote disconnects
+
+func notifyProgress(ctx context.Context, req *mcp.CallToolRequest, total int64) func(int64) {
+	progressToken := req.Params.GetProgressToken()
+	if progressToken == nil || total <= 0 {
+		return nil
+	}
+
+	lastPercent := -1
+
+	return func(sent int64) {
+		if ctx.Err() != nil {
+			return
+		}
+
+		percent := int(sent * 100 / total)
+		if percent == lastPercent {
+			return
+		}
+		lastPercent = percent
+
+		notifyCtx, cancel := context.WithTimeout(ctx, progressNotificationTimeout)
+		defer cancel()
+
+		_ = req.Session.NotifyProgress(notifyCtx, &mcp.ProgressNotificationParams{
+			ProgressToken: progressToken,
+			Progress:      float64(sent),
+			Total:         float64(total),
+			Message:       fmt.Sprintf("%d%%", percent),
+		})
+	}
+}
diff --git a/pkg/svc/flash_stage.go b/pkg/svc/flash_stage.go
new file mode 100644
index 0000000000000000000000000000000000000000..0beefc2a53ca615301ee447f6691df7c50a5e9f7
--- /dev/null
+++ b/pkg/svc/flash_stage.go
@@ -0,0 +1,59 @@
+package svc
+
+import (
+	"context"
+
+	"codeberg.org/pojntfx/pushrod/pkg/fastboot"
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+var (
+	StageTool = &mcp.Tool{
+		Name:        "flash.stage",
+		Title:       "Stage file",
+		Description: "Download an uploaded file into a device's memory without flashing it",
+		Annotations: &mcp.ToolAnnotations{DestructiveHint: new(false)},
+	}
+)
+
+type StageInput struct {
+	Path string `json:"path" jsonschema:"path that uniquely identifies the fastboot device until it gets unplugged, in BUS-PORT form like 1-2-3"`
+	File string `json:"file" jsonschema:"name of the file to stage"`
+}
+
+type StageOutput struct {
+	File string `json:"file" jsonschema:"name of the file that was staged"`
+}
+
+func (s *Service) Stage(ctx context.Context, req *mcp.CallToolRequest, input StageInput) (*mcp.CallToolResult, *StageOutput, error) {
+	// Validation happens inside of openUploadedFile
+	file, err := s.openUploadedFile(input.File)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer file.Close()
+
+	info, err := file.Stat()
+	if err != nil {
+		return nil, nil, err
+	}
+
+	if err := s.flashLock.Acquire(ctx, 1); err != nil {
+		return nil, nil, err
+	}
+	defer s.flashLock.Release(1)
+
+	session, err := fastboot.OpenSession(input.Path)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer session.Close()
+
+	if err := session.Download(ctx, file, info.Size(), notifyProgress(ctx, req, info.Size())); err != nil {
+		return nil, nil, err
+	}
+
+	return nil, &StageOutput{
+		File: input.File,
+	}, nil
+}

