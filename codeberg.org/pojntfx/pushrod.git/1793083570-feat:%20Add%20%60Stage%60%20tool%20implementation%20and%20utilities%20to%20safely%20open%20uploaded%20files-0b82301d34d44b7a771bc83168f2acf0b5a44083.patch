+
+func (s *Service) openUploadedFile(name string) (*os.File, error) {
+	if err := validateFileName(name); err != nil {
+		return nil, err
+	}
+
+	root, err := os.OpenRoot(s.filesDir)
+	if err != nil {
+		return nil, err
+	}
+	defer root.Close()
+
+	file, err := root.Open(name)
+	if err != nil {
+		return nil, err
+	}
+
+	info, err := file.Stat()
+	if err != nil {
+		file.Close()
+
+		return nil, err
+	}
+
+	if !info.Mode().IsRegular() {
+		file.Close()
+
+		return nil, ErrNotRegularFile
+	}
+
+	return file, nil
 }
 
