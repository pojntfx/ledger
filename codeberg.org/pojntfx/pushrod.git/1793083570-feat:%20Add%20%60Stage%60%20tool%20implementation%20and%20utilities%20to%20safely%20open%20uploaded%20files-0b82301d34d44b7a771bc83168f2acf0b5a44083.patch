--- a/pkg/fastboot/commands.go
+++ b/pkg/fastboot/commands.go
@@ -2,10 +2,17 @@ package fastboot
 
 import (
 	"context"
+	"io"
+	"math"
 	"time"
 )
 
-const commandTimeout = 10 * time.Second
+const (
+	commandTimeout  = 10 * time.Second
+	downloadTimeout = time.Minute
+)
+
+type ProgressCallback func(sent int64)
 
 func (s *Session) GetVar(ctx context.Context, variable string) (string, error) {
 	if s.protocol == nil {
@@ -15,13 +22,13 @@
 	ctx, cancel := context.WithTimeout(ctx, commandTimeout)
 	defer cancel()
 
-	if err := s.protocol.writeCommand(ctx, "getvar:"+variable); err != nil {
+	if err := s.protocol.writeCommand(ctx, "getvar:"+variable, commandTimeout); err != nil {
 		return "", err
 	}
 
 	value := ""
 	for {
-		r, err := s.protocol.readResponse(ctx)
+		r, err := s.protocol.readResponse(ctx, commandTimeout)
 		if err != nil {
 			return "", err
 		}
@@ -47,3 +54,15 @@ 			return "", errUnexpectedResponse
 		}
 	}
 }
+
+func (s *Session) Download(ctx context.Context, source io.Reader, size int64, progress ProgressCallback) error {
+	if s.protocol == nil {
+		return ErrSessionClosed
+	}
+
+	if size < 0 || size > math.MaxUint32 {
+		return ErrInvalidDownloadSize
+	}
+
+	return s.protocol.download(ctx, source, size, downloadTimeout, progress)
+}
