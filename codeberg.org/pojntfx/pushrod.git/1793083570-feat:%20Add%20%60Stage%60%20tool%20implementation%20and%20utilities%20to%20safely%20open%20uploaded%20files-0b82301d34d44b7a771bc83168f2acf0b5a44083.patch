diff --git a/pkg/fastboot/protocol.go b/pkg/fastboot/protocol.go
index 71ece2bd3c0a6fb28be5dfa0cd2282d18b03fe6c..451c3c26e025a2c39138b80577dcd65c23fc0dfb 100644
--- a/pkg/fastboot/protocol.go
+++ b/pkg/fastboot/protocol.go
@@ -3,8 +3,11 @@
 import (
 	"context"
 	"errors"
+	"fmt"
 	"io"
+	"strconv"
 	"strings"
+	"time"
 )
 
 const (
@@ -13,12 +16,19 @@ 	responsePacketSize = 64
 
 	// See https://android.googlesource.com/platform/system/core/+/refs/heads/main/fastboot/README.md#transport-and-framing
 	responseStatusSize = 4
+
+	// See https://android.googlesource.com/platform/system/core/+/refs/heads/main/fastboot/README.md#transport-and-framing
+	downloadSizeLength = 8
+
+	// SpacemiT's `flashserver` uses this too
+	downloadChunkSize = 1 << 20
 )
 
 var (
-	errInvalidResponse    = errors.New("invalid fastboot response")
-	errUnexpectedResponse = errors.New("unexpected fastboot response")
-	errCommandFailed      = errors.New("fastboot command failed")
+	errInvalidResponse      = errors.New("invalid fastboot response")
+	errUnexpectedResponse   = errors.New("unexpected fastboot response")
+	errCommandFailed        = errors.New("fastboot command failed")
+	errDownloadSizeMismatch = errors.New("fastboot download size mismatch")
 )
 
 type responseStatus string
@@ -45,16 +55,22 @@ type protocol struct {
 	transport transport
 }
 
-func (p *protocol) command(ctx context.Context, command string, expected responseStatus) (response, error) {
-	if err := p.writeCommand(ctx, command); err != nil {
+func (p *protocol) command(ctx context.Context, command string, expected responseStatus, timeout time.Duration) (response, error) {
+	if err := p.writeCommand(ctx, command, timeout); err != nil {
 		return response{}, err
 	}
 
-	return p.accept(ctx, expected)
+	return p.accept(ctx, expected, timeout)
 }
 
-func (p *protocol) writeCommand(ctx context.Context, command string) error {
-	data := []byte(command)
+func (p *protocol) writeCommand(ctx context.Context, command string, timeout time.Duration) error {
+	return p.write(ctx, []byte(command), timeout)
+}
+
+func (p *protocol) write(ctx context.Context, data []byte, timeout time.Duration) error {
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+
 	n, err := p.transport.WriteContext(ctx, data)
 	if err != nil {
 		return err
@@ -67,9 +83,9 @@
 	return nil
 }
 
-func (p *protocol) accept(ctx context.Context, expected responseStatus) (response, error) {
+func (p *protocol) accept(ctx context.Context, expected responseStatus, timeout time.Duration) (response, error) {
 	for {
-		r, err := p.readResponse(ctx)
+		r, err := p.readResponse(ctx, timeout)
 		if err != nil {
 			return response{}, err
 		}
@@ -90,7 +106,10 @@ 		}
 	}
 }
 
-func (p *protocol) readResponse(ctx context.Context) (response, error) {
+func (p *protocol) readResponse(ctx context.Context, timeout time.Duration) (response, error) {
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+
 	data := make([]byte, responsePacketSize)
 	n, err := p.transport.ReadContext(ctx, data)
 	if err != nil {
@@ -113,3 +132,54 @@ 		status:  status,
 		payload: strings.TrimRight(string(data[responseStatusSize:n]), "\x00"),
 	}, nil
 }
+
+func (p *protocol) download(ctx context.Context, source io.Reader, size int64, timeout time.Duration, progress ProgressCallback) error {
+	r, err := p.command(ctx, fmt.Sprintf("download:%08x", size), statusData, commandTimeout)
+	if err != nil {
+		return err
+	}
+
+	// See https://android.googlesource.com/platform/system/core/+/refs/heads/main/fastboot/README.md#transport-and-framing
+	acceptedSize, err := strconv.ParseUint(r.payload, 16, 32)
+	if len(r.payload) != downloadSizeLength || err != nil {
+		return errInvalidResponse
+	}
+
+	if int64(acceptedSize) != size {
+		return errDownloadSizeMismatch
+	}
+
+	if err := p.writeData(ctx, source, size, timeout, progress); err != nil {
+		return err
+	}
+
+	_, err = p.accept(ctx, statusOKAY, commandTimeout)
+
+	return err
+}
+
+func (p *protocol) writeData(ctx context.Context, source io.Reader, size int64, timeout time.Duration, progress ProgressCallback) error {
+	buffer := make([]byte, downloadChunkSize)
+
+	for sent := int64(0); sent < size; {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+
+		chunkSize := min(int64(len(buffer)), size-sent)
+		if _, err := io.ReadFull(source, buffer[:chunkSize]); err != nil {
+			return err
+		}
+
+		if err := p.write(ctx, buffer[:chunkSize], timeout); err != nil {
+			return err
+		}
+
+		sent += chunkSize
+		if progress != nil {
+			progress(sent)
+		}
+	}
+
+	return nil
+}
