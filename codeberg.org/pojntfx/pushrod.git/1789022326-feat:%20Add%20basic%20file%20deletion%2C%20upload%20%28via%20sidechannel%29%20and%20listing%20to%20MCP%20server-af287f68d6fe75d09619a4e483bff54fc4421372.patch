diff --git a/pkg/svc/files.go b/pkg/svc/files.go
new file mode 100644
index 0000000000000000000000000000000000000000..b263121ff2ab1e065f5bc1946d95e7612a264e8b
--- /dev/null
+++ b/pkg/svc/files.go
@@ -0,0 +1,148 @@
+package svc
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/kennygrant/sanitize"
+)
+
+const (
+	// Uploads are streamed into a temporary file in the files directory and
+	// renamed once they have completed, so that a partial upload never shows up
+	// as a file that could be flashed
+	filesUploadPattern = ".upload-"
+
+	// The path that the upload endpoint is served on; the file's name is
+	// appended to it
+	FilesUploadPath = "/files/"
+)
+
+var (
+	ErrInvalidFileName = errors.New(`file name must be usable as a bare file name like "image.img", without any directories and without a leading dash`)
+)
+
+// sanitizeFileName normalizes a name into one that is safe to store in the
+// files directory and to later pass to a flashing tool as an argument. It is
+// idempotent, so the harness can keep referring to a file by the name that it
+// got back
+func sanitizeFileName(name string) (string, error) {
+	// Strips any directories, whitespace and shell metacharacters
+	sanitized := sanitize.Name(name)
+
+	// Sanitizing leaves these as-is, but none of them name a file, and a leading
+	// dash would look like a flag to the tools that consume the file
+	if sanitized == "" || sanitized == "." || sanitized == ".." ||
+		strings.HasPrefix(sanitized, "-") ||
+		sanitized != filepath.Base(sanitized) {
+		return "", ErrInvalidFileName
+	}
+
+	return sanitized, nil
+}
+
+// filePath resolves a name to a path in the files directory, and returns the
+// sanitized name that the file is actually stored under
+func (s *Service) filePath(name string) (string, string, error) {
+	sanitized, err := sanitizeFileName(name)
+	if err != nil {
+		return "", "", err
+	}
+
+	return filepath.Join(s.filesDir, sanitized), sanitized, nil
+}
+
+func (s *Service) getFiles() ([]string, error) {
+	entries, err := os.ReadDir(s.filesDir)
+	if err != nil {
+		return nil, err
+	}
+
+	files := []string{}
+	for _, entry := range entries {
+		// Uploads that are still in flight aren't files yet
+		if entry.IsDir() || strings.HasPrefix(entry.Name(), filesUploadPattern) {
+			continue
+		}
+
+		files = append(files, entry.Name())
+	}
+
+	return files, nil
+}
+
+type uploadResponse struct {
+	Name      string `json:"name"`
+	SizeBytes int64  `json:"sizeBytes"`
+	SHA256    string `json:"sha256"`
+}
+
+// HandleUpload streams an uploaded file to the files directory; it is served
+// next to the MCP endpoint on the same listener so that reaching the MCP server
+// is enough to be able to upload
+func (s *Service) HandleUpload(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodPut && r.Method != http.MethodPost {
+		w.Header().Set("Allow", http.MethodPut)
+
+		http.Error(w, `upload a file with "curl --fail --upload-file <local path> <this URL>"`, http.StatusMethodNotAllowed)
+
+		return
+	}
+
+	path, name, err := s.filePath(r.PathValue("name"))
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+
+		return
+	}
+
+	file, err := os.CreateTemp(s.filesDir, filesUploadPattern)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+
+		return
+	}
+	defer func() {
+		file.Close()
+
+		// After the rename this removes nothing, before it it removes the partial
+		// upload
+		os.Remove(file.Name())
+	}()
+
+	hash := sha256.New()
+
+	size, err := io.Copy(io.MultiWriter(file, hash), r.Body)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+
+		return
+	}
+
+	if err := file.Close(); err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+
+		return
+	}
+
+	if err := os.Rename(file.Name(), path); err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+
+		return
+	}
+
+	w.Header().Set("Content-Type", "application/json")
+
+	json.NewEncoder(w).Encode(uploadResponse{
+		Name:      name,
+		SizeBytes: size,
+		SHA256:    hex.EncodeToString(hash.Sum(nil)),
+	})
+}
diff --git a/pkg/svc/files_delete_file.go b/pkg/svc/files_delete_file.go
new file mode 100644
index 0000000000000000000000000000000000000000..6ee1ffa8b8e3e0286a9ea6eb2e8df51fb05b8746
--- /dev/null
+++ b/pkg/svc/files_delete_file.go
@@ -0,0 +1,49 @@
+package svc
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+var (
+	DeleteFileTool = &mcp.Tool{
+		Name:        "files.deleteFile",
+		Title:       "Delete file",
+		Description: "Delete an uploaded file from the server to free up disk space; only files that have been uploaded can be deleted",
+	}
+
+	ErrFileNotFound = errors.New("file not found")
+)
+
+type DeleteFileInput struct {
+	Name string `json:"name" jsonschema:"name of the file to delete, like image.img from files.getFiles"`
+}
+
+func (s *Service) DeleteFile(ctx context.Context, req *mcp.CallToolRequest, input DeleteFileInput) (*mcp.CallToolResult, *GetFilesOutput, error) {
+	path, name, err := s.filePath(input.Name)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	if err := os.Remove(path); err != nil {
+		if os.IsNotExist(err) {
+			// The server's paths are not the harness' business
+			return nil, nil, fmt.Errorf("%w: %v", ErrFileNotFound, name)
+		}
+
+		return nil, nil, err
+	}
+
+	files, err := s.getFiles()
+	if err != nil {
+		return nil, nil, err
+	}
+
+	return nil, &GetFilesOutput{
+		Files: files,
+	}, nil
+}
diff --git a/pkg/svc/files_get_files.go b/pkg/svc/files_get_files.go
new file mode 100644
index 0000000000000000000000000000000000000000..caaf16a7ce4d8dcce838acb57289089ac31ba638
--- /dev/null
+++ b/pkg/svc/files_get_files.go
@@ -0,0 +1,37 @@
+package svc
+
+import (
+	"context"
+
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+var (
+	// Files are uploaded with a shell command instead of a tool call so that
+	// images don't have to pass through the conversation
+	GetFilesTool = &mcp.Tool{
+		Name:  "files.getFiles",
+		Title: "Get files",
+		Description: `Get the files that have been uploaded to the server, which other tools can reference by name. ` +
+			`To upload a file, run "curl --fail --upload-file LOCAL_PATH SERVER` + FilesUploadPath + `NAME" on the machine that holds it, ` +
+			`where SERVER is the scheme, host and port that this MCP server is reachable on ` +
+			`and NAME is the name that the file should have on the server, like image.img; ` +
+			`the command prints the name that the file was actually stored under, which is a sanitized version of NAME, ` +
+			`and uploading a name that already exists replaces it`,
+	}
+)
+
+type GetFilesOutput struct {
+	Files []string `json:"files" jsonschema:"names of the files that are currently on the server"`
+}
+
+func (s *Service) GetFiles(ctx context.Context, req *mcp.CallToolRequest, input struct{}) (*mcp.CallToolResult, *GetFilesOutput, error) {
+	files, err := s.getFiles()
+	if err != nil {
+		return nil, nil, err
+	}
+
+	return nil, &GetFilesOutput{
+		Files: files,
+	}, nil
+}
