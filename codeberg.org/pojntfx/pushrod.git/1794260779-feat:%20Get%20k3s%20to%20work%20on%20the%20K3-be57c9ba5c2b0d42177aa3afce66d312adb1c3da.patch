From be57c9ba5c2b0d42177aa3afce66d312adb1c3da Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Mon, 09 Nov 2026 14:46:19 -0700
Subject: [PATCH] feat: Get k3s to work on the K3
---
diff --git a/buildroot/board/spacemit/k3-uefi/linux.fragment b/buildroot/board/spacemit/k3-uefi/linux.fragment
index 17e38117aec42774fa76fe92a76de96ba9e08d6f..3adc743df5d6c5ebe35067266c7684dc507cbf23 100644
--- a/buildroot/board/spacemit/k3-uefi/linux.fragment
+++ b/buildroot/board/spacemit/k3-uefi/linux.fragment
@@ -54,3 +54,17 @@ CONFIG_SECONDARY_TRUSTED_KEYRING=y
 CONFIG_ASYMMETRIC_KEY_TYPE=y
 CONFIG_X509_CERTIFICATE_PARSER=y
 CONFIG_PKCS7_MESSAGE_PARSER=y
+CONFIG_VXLAN=m
+CONFIG_IP_NF_NAT=m
+CONFIG_IP_NF_FILTER=m
+CONFIG_IP_NF_MANGLE=m
+CONFIG_NETFILTER_XT_TARGET_REJECT=m
+CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
+CONFIG_NETFILTER_XT_TARGET_LOG=m
+CONFIG_NETFILTER_XT_MATCH_COMMENT=m
+CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
+CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
+CONFIG_NETFILTER_XT_MATCH_LIMIT=m
+CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
+CONFIG_NETFILTER_XT_MATCH_STATISTIC=m
+CONFIG_NETFILTER_XTABLES_COMPAT=y
diff --git a/buildroot/board/spacemit/k3-uefi/rootfs-overlay/etc/fstab b/buildroot/board/spacemit/k3-uefi/rootfs-overlay/etc/fstab
index 63cbd266baa3d005652f2ce2842bf457fcf09fbb..f48ca8765402cf82b6dbed87d8ffe7eedec2f3f9 100644
--- a/buildroot/board/spacemit/k3-uefi/rootfs-overlay/etc/fstab
+++ b/buildroot/board/spacemit/k3-uefi/rootfs-overlay/etc/fstab
@@ -1 +1,2 @@
 /dev/sda1 /boot vfat defaults 0 0
+/dev/sda6 / ext4 rw,x-systemd.growfs 0 1
diff --git a/buildroot/configs/k3_uefi_defconfig b/buildroot/configs/k3_uefi_defconfig
index 09adac4673c372da16fb48fc10dab065c30119ca..5a289778e27b2449129564bbb5918a97dd454a94 100644
--- a/buildroot/configs/k3_uefi_defconfig
+++ b/buildroot/configs/k3_uefi_defconfig
@@ -147,3 +147,5 @@ BR2_TARGET_ROOTFS_EXT2=y
 BR2_TARGET_ROOTFS_EXT2_4=y
 BR2_TARGET_ROOTFS_EXT2_SIZE="2G"
 BR2_TARGET_ROOTFS_EXT2_NONE=y
+BR2_PACKAGE_E2FSPROGS=y
+BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y

