 	github.com/modelcontextprotocol/go-sdk v1.7.0
 	go.bug.st/serial v1.8.0
 	golang.org/x/mobile v0.0.0-20260821190718-4776eadac327
@@ -12,7 +13,6 @@ )
 
 require (
 	github.com/ebitengine/purego v0.9.1 // indirect
