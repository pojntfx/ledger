+++ b/main.go
@@ -45,6 +45,7 @@ 	mcp.AddTool(handler, svc.GetVideoCaptureDevicesTool, service.GetVideoCaptureDevices)
 	mcp.AddTool(handler, svc.TakeScreenshotTool, service.TakeScreenshot)
 	mcp.AddTool(handler, svc.GetInputDevicesTool, service.GetInputDevices)
