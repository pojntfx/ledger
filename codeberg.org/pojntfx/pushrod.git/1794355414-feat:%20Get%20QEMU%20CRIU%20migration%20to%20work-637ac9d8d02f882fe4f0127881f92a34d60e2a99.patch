@@ -0,0 +1,110 @@
+#!/usr/bin/env python3
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+sys.path.insert(0, str(Path(__file__).parent))
+
+import demo_lib
+import demo_qemu_warm as warm
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+migration = load("migration_test", Path(__file__).with_name("verify-migration.py"))
+wallet = load("wallet_test", Path(__file__).with_name("verify-wallet.py"))
+OUTPUT = Path(__file__).parent.parent / "output/rva23"
+STATE = OUTPUT / "migration" / "warm-state.json"
+
+
+def enrolled(name):
+    return (OUTPUT / "migration" / f"{name}-ak-public.pem").exists()
+
+
+def enroll(guest, name):
+    print(f"enroll {name}", flush=True)
+    warm.run(None, guest, "systemctl is-active --quiet --wait graphical.target", lines=0)
+    warm.run(None, guest, "systemctl start systemd-pcrlock.socket", lines=0)
+    warm.run(None, guest, "systemctl restart systemd-report-sign-tpm2.socket", lines=0)
+    warm.run(None, guest, "attested-client", 300, lines=2)
+    warm.run(None, guest, "tpm2_readpublic -c /var/lib/systemd/report.sign.tpm2/ak.ctx -f pem -o /tmp/ak-public.pem", 60, lines=0)
+    migration.copy_guest_file(guest, "/tmp/ak-public.pem", OUTPUT / "migration" / f"{name}-ak-public.pem")
+    warm.run(None, guest, "criu check", 300, lines=2)
+    print(f"{name} enrolled", flush=True)
+
+
+def stop_clients(guest):
+    warm.run(None, guest, "kill $(ps | awk '/[m]igration-client serve/ {print $1}') 2>/dev/null || true", 30, lines=0, check=False)
+    for _ in range(20):
+        probe = warm.run(None, guest, "wget -q -O- http://[::1]:18084/api/state", 5, lines=0, check=False)
+        if "{" not in probe:
+            return
+        time.sleep(1)
+
+
+def start_client(guest):
+    stop_clients(guest)
+    warm.run(None, guest, "rm -f /var/lib/rva23-migration/state.json", lines=0, check=False)
+    output = warm.run(None, guest, "RVA23_MIGRATION_CLIENT_UI_LISTEN='[::]:18084' migration-client serve </dev/null >/dev/null 2>&1 & printf '%s\\n' $!", 60, lines=0)
+    for _ in range(30):
+        probe = warm.run(None, guest, "wget -q -O- http://[::1]:18084/api/state", 5, lines=0, check=False)
+        if "{" in probe:
+            return
+        time.sleep(1)
+    raise demo_lib.DemoError("the migration client did not start")
+
+
+def main():
+    subprocess.run(["pkill", "-f", r"output/(demo|rva23/host-attestation|rva23/migration)/(report-receiver|wallet-server|migration-server|event-explorer)"], check=False)
+    time.sleep(2)
+    source, _ = warm.ensure("src")
+    destination, _ = warm.ensure("dst")
+    if not enrolled("src"):
+        enroll(source, "src")
+    if not enrolled("dst"):
+        enroll(destination, "dst")
+    stop_clients(source)
+    stop_clients(destination)
+
+    receiver = migration.start_receiver(OUTPUT)
+    production_pcr11 = wallet.predict_profile(OUTPUT, "rva23-debug_1.efi")
