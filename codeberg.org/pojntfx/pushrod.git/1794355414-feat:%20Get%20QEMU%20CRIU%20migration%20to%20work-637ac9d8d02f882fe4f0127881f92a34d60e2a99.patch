index 0000000000000000000000000000000000000000..e801ac180b6ef608418d29e118cc53d1a33a48e2
--- /dev/null
+++ b/buildroot/scripts/7-demo-migrate-qemu.py
@@ -0,0 +1,79 @@
+#!/usr/bin/env python3
+import base64
+import json
+from pathlib import Path
+import socket
+import sys
+import urllib.request
+import time
+
+sys.path.insert(0, str(Path(__file__).parent))
+
+import demo_lib
+import demo_qemu_warm as warm
+
+OUTPUT = Path(__file__).parent.parent / "output/rva23"
+STATE = OUTPUT / "migration" / "warm-state.json"
+
+
+def port_open(port):
+    with socket.socket(socket.AF_INET6, socket.SOCK_STREAM) as connection:
+        connection.settimeout(2)
+        return connection.connect_ex(("::1", port)) == 0
+
+
+def guest_state(guest, port):
+    output = warm.run(None, guest, f"wget -q -O- http://[::1]:{port}/api/state", 60, lines=0)
+    body = output[output.find("{"):output.rfind("}") + 1]
+    return json.loads(body)
+
+
+def main():
+    demo = demo_lib.Demo(
+        "Demo 7: move a live process on QEMU",
+        "CRIU freezes a process, the checkpoint is signed and uploaded, and a second guest restores it",
+    )
+    demo.banner()
+    demo.cue("The checkpoint is already uploaded and the first guest attested")
+    demo.ui("migration server", demo_lib.MIGRATION_UI)
+    demo.ui("event view", demo_lib.EVENT_UI)
+
+    if not STATE.exists():
+        raise demo_lib.DemoError("the migration is not staged; run make demo-migrate-warm first")
+    staged = json.loads(STATE.read_text())
+    demo.step("Check the staged migration")
+    for port in (8080, 8083):
+        if not port_open(port):
+            raise demo_lib.DemoError(f"the staged service on port {port} is not running; run make demo-migrate-warm again")
+    demo.result(f"pid {staged['pid']} is staged, instance {staged['instanceId'][:12]}")
+
+    destination, _ = warm.ensure("dst")
+    demo.step("Restore the process on the second guest")
+    demo.note("The destination never saw the source; it gets the checkpoint and the state")
+    encoded = base64.b64encode(json.dumps(staged["destinationState"]).encode()).decode()
+    warm.run(demo, destination, f"mkdir -p /var/lib/rva23-migration; printf '%s' '{encoded}' | base64 -d > /var/lib/rva23-migration/state.json", 60, lines=0)
+    warm.run(demo, destination, "rm -f /tmp/migration.tar.gz; migration-client download -output /tmp/migration.tar.gz 2>&1", 300, lines=4)
+    warm.run(demo, destination, "rm -rf /tmp/criu-restore; migration-client extract -archive /tmp/migration.tar.gz -destination /tmp/criu-restore 2>&1", 300, lines=3)
+    warm.run(demo, destination, "criu restore -D /tmp/criu-restore --shell-job --tcp-close -d 2>&1", 300, lines=3)
+    demo.result("the process is back on the second guest")
+
+    demo.step("Attest the restored process")
+    warm.run(demo, destination, "migration-client attest -phase after 2>&1", 300, lines=3)
+    warm.run(demo, destination, "RVA23_MIGRATION_CLIENT_UI_LISTEN='[::]:18085' migration-client serve </dev/null >/dev/null 2>&1 & true", 60, lines=0)
+    time.sleep(2)
+    restored = guest_state(destination, 18085)
+    if restored["pid"] != staged["pid"] or restored["instanceId"] != staged["instanceId"]:
+        raise demo_lib.DemoError(f"the restored process has pid {restored['pid']}, expected {staged['pid']}")
+    demo.result(f"restored pid {restored['pid']}, same instance id")
+
+    demo.step("Read the receipts in the unified view")
+    with urllib.request.urlopen("http://[::1]:8083/api/state", timeout=10) as response:
+        history = json.load(response)
+    accepted = [item for item in history["history"] if item["operation"] == "attestation" and item.get("response", {}).get("status") == "accepted"]
+    demo.result(f"{len(accepted)} accepted attestations, users {[item['response']['userId'] for item in accepted]}")
+    demo.payoff("The process kept its PID and instance ID across the move, and both guests attested")
+    return demo.finish()
+
+
+if __name__ == "__main__":
+    demo_lib.run(main)
