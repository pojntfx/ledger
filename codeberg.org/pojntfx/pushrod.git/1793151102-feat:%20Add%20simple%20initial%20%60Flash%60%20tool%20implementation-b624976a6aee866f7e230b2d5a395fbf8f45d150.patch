+	maxDownloadSize *int64
 }
 
 func OpenSession(path string) (*Session, error) {
@@ -120,6 +122,7 @@ 		s.usbContext = nil
 	}
 
 	s.protocol = nil
+	s.maxDownloadSize = nil
 
 	return errors.Join(errs...)
 }
diff --git a/pkg/svc/flash_flash_file.go b/pkg/svc/flash_flash_file.go
new file mode 100644
index 0000000000000000000000000000000000000000..8efb7a01d08711840a49697959446a460f853ab2
--- /dev/null
+++ b/pkg/svc/flash_flash_file.go
@@ -0,0 +1,74 @@
+package svc
+
+import (
+	"context"
+	"time"
+
+	"codeberg.org/pojntfx/pushrod/pkg/fastboot"
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+var (
+	FlashFileTool = &mcp.Tool{
+		Name:        "flash.flashFile",
+		Title:       "Flash file",
+		Description: "Flash an uploaded file to a partition on a device in fastboot mode",
+		Annotations: &mcp.ToolAnnotations{DestructiveHint: new(true)},
+	}
+)
+
+type FlashFileInput struct {
+	Path      string `json:"path" jsonschema:"path that uniquely identifies the fastboot device until it gets unplugged, in BUS-PORT form like 1-2-3"`
+	File      string `json:"file" jsonschema:"name of the file to flash"`
+	Partition string `json:"partition" jsonschema:"partition to flash the file to, like boot or rootfs"`
+	Reboot    bool   `json:"reboot" jsonschema:"whether to reboot the device after flashing"`
+}
+
+type FlashFileOutput struct {
+	File       string `json:"file" jsonschema:"name of the file that was flashed"`
+	Partition  string `json:"partition" jsonschema:"partition the file was flashed to"`
+	Rebooted   bool   `json:"rebooted" jsonschema:"whether the device was rebooted afterwards"`
+	DurationMs int64  `json:"durationMs" jsonschema:"how long the flash took, in milliseconds"`
+}
+
+func (s *Service) FlashFile(ctx context.Context, req *mcp.CallToolRequest, input FlashFileInput) (*mcp.CallToolResult, *FlashFileOutput, error) {
+	file, err := s.openUploadedFile(input.File)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer file.Close()
+
+	info, err := file.Stat()
+	if err != nil {
+		return nil, nil, err
+	}
+
+	if err := s.flashLock.Acquire(ctx, 1); err != nil {
+		return nil, nil, err
+	}
+	defer s.flashLock.Release(1)
+
+	session, err := fastboot.OpenSession(input.Path)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer session.Close()
+
+	start := time.Now()
+	if err := session.Flash(ctx, input.Partition, file, info.Size(), notifyProgress(ctx, req, info.Size())); err != nil {
+		return nil, nil, err
+	}
+
+	if input.Reboot {
+		if _, err := session.Reboot(ctx); err != nil {
+			return nil, nil, err
+		}
+	}
+
+	return nil, &FlashFileOutput{
+		File:       input.File,
+		Partition:  input.Partition,
+		Rebooted:   input.Reboot,
+		DurationMs: time.Since(start).Milliseconds(),
+	}, nil
+}

