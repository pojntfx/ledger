diff --git a/pkg/fastboot/commands.go b/pkg/fastboot/commands.go
index 8806d9a18c72d62175887f4a10423e20a95cc15e..3997737bc81ab59b1daccab184f66713c10ff29e 100644
--- a/pkg/fastboot/commands.go
+++ b/pkg/fastboot/commands.go
@@ -4,17 +4,20 @@ import (
 	"context"
 	"io"
 	"math"
+	"strconv"
 	"strings"
 	"time"
 )
 
 const (
 	// Regular commands finish quickly
-	commandTimeout = 10 * time.Second
+	timeoutRegularCommand = 10 * time.Second
 	// OEM commands (e.g. flash) can take quite long
-	oemTimeout = 10 * time.Minute
+	timeoutOEM = 10 * time.Minute
 	// Downloads can also take a bit longer
-	downloadTimeout = time.Minute
+	timeoutDownload = time.Minute
+	// Device-side writes can also take quite long
+	timeoutWrite = 10 * time.Minute
 )
 
 type ProgressCallback func(sent int64)
@@ -40,7 +43,7 @@ 	return strings.Join(responses, "\n"), nil
 }
 
 func (s *Session) GetVar(ctx context.Context, variable string) (string, error) {
-	responses, err := s.command(ctx, "getvar:"+variable, commandTimeout)
+	responses, err := s.command(ctx, "getvar:"+variable, timeoutRegularCommand)
 	if err != nil {
 		return "", err
 	}
@@ -52,16 +55,41 @@
 	return responses[len(responses)-1], nil
 }
 
+func (s *Session) MaxDownloadSize(ctx context.Context) (int64, error) {
+	if s.protocol == nil {
+		return 0, ErrSessionClosed
+	}
+
+	// If we've already read and cached the max download size, don't read it again
+	if s.maxDownloadSize != nil {
+		return *s.maxDownloadSize, nil
+	}
+
+	value, err := s.GetVar(ctx, "max-download-size")
+	if err != nil {
+		return 0, err
+	}
+
+	size, err := strconv.ParseInt(strings.TrimPrefix(strings.TrimSpace(value), "0x"), 16, 63)
+	if err != nil || size <= 0 {
+		return 0, errInvalidResponse
+	}
+
+	s.maxDownloadSize = new(size)
+
+	return size, nil
+}
+
 func (s *Session) Continue(ctx context.Context) (string, error) {
-	return s.commandText(ctx, "continue", commandTimeout)
+	return s.commandText(ctx, "continue", timeoutRegularCommand)
 }
 
 func (s *Session) Reboot(ctx context.Context) (string, error) {
-	return s.commandText(ctx, "reboot", commandTimeout)
+	return s.commandText(ctx, "reboot", timeoutRegularCommand)
 }
 
 func (s *Session) OEM(ctx context.Context, command string) (string, error) {
-	return s.commandText(ctx, "oem "+command, oemTimeout)
+	return s.commandText(ctx, "oem "+command, timeoutOEM)
 }
 
 func (s *Session) Download(ctx context.Context, source io.Reader, size int64, progress ProgressCallback) error {
@@ -73,5 +101,24 @@ 	if size < 0 || size > math.MaxUint32 {
 		return ErrInvalidDownloadSize
 	}
 
-	return s.protocol.download(ctx, source, size, downloadTimeout, progress)
+	return s.protocol.download(ctx, source, size, timeoutDownload, progress)
+}
+
+func (s *Session) Flash(ctx context.Context, partition string, source io.Reader, size int64, progress ProgressCallback) error {
+	limit, err := s.MaxDownloadSize(ctx)
+	if err != nil {
+		return err
+	}
+
+	if size > limit {
+		return ErrDownloadTooLarge
+	}
+
+	if err := s.Download(ctx, source, size, progress); err != nil {
+		return err
+	}
+
+	_, err = s.protocol.command(ctx, "flash:"+partition, statusOKAY, timeoutWrite)
+
+	return err
 }
diff --git a/pkg/fastboot/protocol.go b/pkg/fastboot/protocol.go
index def8b47cbba148f64404ecce9ec88bdc0579d912..ca9ca44c83a774d8c430c58b8595392d4c0262ec 100644
--- a/pkg/fastboot/protocol.go
+++ b/pkg/fastboot/protocol.go
@@ -168,7 +168,7 @@ 	}, nil
 }
 
 func (p *protocol) download(ctx context.Context, source io.Reader, size int64, timeout time.Duration, progress ProgressCallback) error {
-	r, err := p.command(ctx, fmt.Sprintf("download:%08x", size), statusData, commandTimeout)
+	r, err := p.command(ctx, fmt.Sprintf("download:%08x", size), statusData, timeoutRegularCommand)
 	if err != nil {
 		return err
 	}
@@ -187,7 +187,7 @@ 	if err := p.writeData(ctx, source, size, timeout, progress); err != nil {
 		return err
 	}
 
-	_, err = p.accept(ctx, statusOKAY, commandTimeout)
+	_, err = p.accept(ctx, statusOKAY, timeoutRegularCommand)
 
 	return err
 }
