+func (fixture *mutualTestFixture) openSession(t *testing.T) string {
+	t.Helper()
+	status, body := fixture.doJSON(t, http.MethodPost, "/v1/mutual/sessions", migration.MutualSessionRequest{InstanceID: fixture.instanceID, PID: 4242})
+	requireMutualStatus(t, status, http.StatusCreated, body)
+	var response migration.MutualSessionResponse
+	if err := json.Unmarshal(body, &response); err != nil {
+		t.Fatal(err)
