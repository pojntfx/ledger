index 0000000000000000000000000000000000000000..e018232d6aa8d3c3d1afe6a24481491432592ba4
--- /dev/null
+++ b/buildroot/k3/board/spacemit/k3-uefi/post-build.sh
@@ -0,0 +1,20 @@
+#!/bin/sh
+set -eu
+TARGET_DIR="$1"
+BOARD_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
+KEY_DIR="$BUILD_DIR/k3-keys"
+FIRMWARE_DIR="${K3_LINUX_FIRMWARE_DIR:-$BOARD_DIR/../../../../src/linux-firmware/powervr}"
+mkdir -p "$KEY_DIR"
+if [ ! -f "$KEY_DIR/root_ed25519" ]; then
+	ssh-keygen -q -t ed25519 -N '' -C 'k3-root' -f "$KEY_DIR/root_ed25519"
+fi
+install -d -m 0700 "$TARGET_DIR/root/.ssh"
+install -m 0600 "$KEY_DIR/root_ed25519.pub" "$TARGET_DIR/root/.ssh/authorized_keys"
+install -d -m 0755 "$TARGET_DIR/lib/firmware/powervr"
+install -m 0644 "$FIRMWARE_DIR"/rogue_*.fw "$TARGET_DIR/lib/firmware/powervr/"
+rm -f "$TARGET_DIR/lib/firmware/rgx.fw.36.56.104.183"
+rm -f "$TARGET_DIR/lib/firmware/rgx.sh.36.56.104.183"
+rm -f "$TARGET_DIR/lib/firmware/powervr/rgx.fw.36.56.104.183"
+rm -f "$TARGET_DIR/etc/systemd/system/k3-validation.service"
+rm -f "$TARGET_DIR/etc/systemd/system/basic.target.wants/k3-validation.service"
+K3_CLIENTS_ONLY=1 RVA23_BOARD=k3-uefi BINARIES_DIR="$BUILD_DIR/../images" TARGET_DIR="$TARGET_DIR" HOST_DIR="$BUILD_DIR/../host" "$BUILD_DIR/../host/bin/python3" "$BOARD_DIR/../../../scripts/build-os-images.py"
diff --git a/buildroot/k3/board/spacemit/k3-uefi/post-image.sh b/buildroot/k3/board/spacemit/k3-uefi/post-image.sh
