index 0000000000000000000000000000000000000000..78c85274cb580ec418b86932d7b79440d6fd640b
--- /dev/null
+++ b/buildroot/k3/board/spacemit/k3-uefi/post-image.sh
@@ -0,0 +1,30 @@
+#!/bin/sh
+set -eu
+: "${BUILD_DIR:?}"
+: "${HOST_DIR:?}"
+BINARIES_DIR="$1"
+BOARD_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
+RVA23_BOARD=k3-uefi "${HOST_DIR}/bin/fakeroot" -- "${BOARD_DIR}/../../../scripts/build-os-images.py"
+install -m 0644 "${BOARD_DIR}/startup.nsh" "${BINARIES_DIR}/efi-part/startup.nsh"
+rm -f "${BINARIES_DIR}/bootfs.img"
+truncate -s 256M "${BINARIES_DIR}/bootfs.img"
+"${HOST_DIR}/sbin/mkfs.vfat" -F 16 -S 4096 -n ESP "${BINARIES_DIR}/bootfs.img"
+"${HOST_DIR}/bin/mcopy" -s -i "${BINARIES_DIR}/bootfs.img" "${BINARIES_DIR}/efi-part/EFI" "${BINARIES_DIR}/efi-part/loader" "${BINARIES_DIR}/efi-part/startup.nsh" "${BINARIES_DIR}/efi-part/k3-pico-itx.dtb" ::
+cd "${BINARIES_DIR}"
+install -m 0644 "${BUILD_DIR}/edk2-spacemit-custom/fitimage/MUSE-Pico/MUSE-Pico.itb" "${BINARIES_DIR}/edk2.itb"
+install -m 0644 "${BOARD_DIR}/fw_dynamic.its" fw_dynamic.its
+"${HOST_DIR}/bin/mkimage" -f fw_dynamic.its fw_dynamic.itb
+install -m 0644 "${BOARD_DIR}/env.bin" env.bin
+install -m 0644 "${BOARD_DIR}/esos.itb" esos.itb
+install -m 0644 "${BOARD_DIR}/flasher-u-boot.itb" u-boot.itb
+install -d -m 0755 factory
+install -m 0644 "${BOARD_DIR}/factory/FSBL.bin" factory/FSBL.bin
+install -m 0644 "${BOARD_DIR}/factory/bootinfo_block.bin" factory/bootinfo_block.bin
+install -m 0644 "${BOARD_DIR}/factory/bootinfo_spinor.bin" factory/bootinfo_spinor.bin
+install -m 0644 "${BOARD_DIR}/factory/bootinfo_spinand.bin" factory/bootinfo_spinand.bin
+install -m 0644 "${BOARD_DIR}/partition_universal.json" partition_universal.json
+install -m 0644 "${BOARD_DIR}/partition_4M.json" partition_4M.json
+install -m 0644 "${BOARD_DIR}/partition_8M.json" partition_8M.json
+install -m 0644 "${BOARD_DIR}/partition_64M.json" partition_64M.json
+rm -f k3-uefi-pushrod.zip
+python3 -m zipfile -c k3-uefi-pushrod.zip partition_universal.json partition_4M.json partition_8M.json partition_64M.json env.bin factory/FSBL.bin factory/bootinfo_block.bin factory/bootinfo_spinor.bin factory/bootinfo_spinand.bin esos.itb fw_dynamic.itb edk2.itb u-boot.itb bootfs.img rootfs.ext4
