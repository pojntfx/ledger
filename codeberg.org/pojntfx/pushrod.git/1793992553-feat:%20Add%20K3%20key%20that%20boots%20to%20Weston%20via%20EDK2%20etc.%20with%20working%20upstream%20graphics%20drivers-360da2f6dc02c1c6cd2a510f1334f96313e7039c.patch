new file mode 100644
index 0000000000000000000000000000000000000000..2fef574290b721e6a6a13eb10646f32110f17e40
--- /dev/null
+++ b/buildroot/k3/scripts/migration/checkpoint.go
@@ -0,0 +1,263 @@
+package migration
+
+import (
+	"archive/tar"
+	"compress/gzip"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+const (
+	DefaultMaxCheckpointBytes = 64 * 1024 * 1024
+	DefaultMaxCheckpointFiles = 4096
+)
+
+type ArchiveDigest struct {
+	SHA256 string `json:"sha256"`
+	Size   int64  `json:"size"`
+}
+
+type limitedWriter struct {
+	writer io.Writer
+	remain int64
+}
+
+func (writer *limitedWriter) Write(data []byte) (int, error) {
+	if writer.remain <= 0 {
+		return 0, io.ErrShortWrite
+	}
+	if int64(len(data)) > writer.remain {
+		data = data[:writer.remain]
+	}
+	written, err := writer.writer.Write(data)
+	writer.remain -= int64(written)
+	return written, err
+}
+
+func safeArchivePath(name string) (string, error) {
+	if name == "" || strings.ContainsRune(name, '\x00') || strings.Contains(name, "\\") {
+		return "", errors.New("invalid checkpoint path")
+	}
+	clean := filepath.Clean(filepath.FromSlash(name))
+	if filepath.IsAbs(clean) || clean == "." || clean == ".." || strings.HasPrefix(clean, ".."+string(filepath.Separator)) {
+		return "", errors.New("invalid checkpoint path")
+	}
+	return clean, nil
+}
+
+func ArchiveCheckpoint(source, destination string, maxBytes int64) (ArchiveDigest, error) {
+	var digest ArchiveDigest
+	info, err := os.Stat(source)
+	if err != nil {
+		return digest, err
+	}
+	if !info.IsDir() {
+		return digest, errors.New("checkpoint source must be a directory")
+	}
+	output, err := os.OpenFile(destination, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+	if err != nil {
+		return digest, err
+	}
+	completed := false
+	defer func() {
+		output.Close()
+		if !completed {
+			os.Remove(destination)
+		}
+	}()
+	hash := sha256.New()
+	limited := &limitedWriter{writer: io.MultiWriter(output, hash), remain: maxBytes + 1}
+	gzipWriter := gzip.NewWriter(limited)
+	tarWriter := tar.NewWriter(gzipWriter)
+	files := 0
+	err = filepath.WalkDir(source, func(path string, entry os.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if path == source {
+			return nil
+		}
+		files++
+		if files > DefaultMaxCheckpointFiles {
+			return errors.New("too many checkpoint files")
+		}
+		info, err := entry.Info()
+		if err != nil {
+			return err
+		}
+		if !info.Mode().IsRegular() && !info.IsDir() {
+			return fmt.Errorf("unsupported checkpoint file type at %s", path)
+		}
+		relative, err := filepath.Rel(source, path)
+		if err != nil {
+			return err
+		}
+		name := filepath.ToSlash(relative)
+		if info.IsDir() {
+			name += "/"
+		}
+		header, err := tar.FileInfoHeader(info, "")
+		if err != nil {
+			return err
+		}
+		header.Name = name
+		header.Uid = 0
+		header.Gid = 0
+		header.Uname = ""
+		header.Gname = ""
+		if err := tarWriter.WriteHeader(header); err != nil {
+			return err
+		}
+		if info.Mode().IsRegular() {
+			input, err := os.Open(path)
+			if err != nil {
+				return err
+			}
+			_, copyErr := io.Copy(tarWriter, input)
+			closeErr := input.Close()
+			if copyErr != nil {
+				return copyErr
+			}
+			if closeErr != nil {
+				return closeErr
+			}
+		}
+		return nil
+	})
+	if err == nil {
+		err = tarWriter.Close()
+	} else {
+		tarWriter.Close()
+	}
+	if err == nil {
+		err = gzipWriter.Close()
+	} else {
+		gzipWriter.Close()
+	}
+	if err != nil {
+		return digest, err
+	}
+	if limited.remain <= 0 {
+		return digest, errors.New("checkpoint archive exceeds the size limit")
+	}
+	if err := output.Sync(); err != nil {
+		return digest, err
+	}
+	info, err = output.Stat()
+	if err != nil {
+		return digest, err
+	}
+	if err := output.Close(); err != nil {
+		return digest, err
+	}
+	digest.Size = info.Size()
+	digest.SHA256 = hex.EncodeToString(hash.Sum(nil))
+	completed = true
+	return digest, nil
+}
+
+func ExtractCheckpoint(archive, destination string, maxBytes int64) error {
+	input, err := os.Open(archive)
+	if err != nil {
+		return err
+	}
+	defer input.Close()
+	if err := os.Mkdir(destination, 0o700); err != nil {
+		return err
+	}
+	completed := false
+	defer func() {
+		if !completed {
+			os.RemoveAll(destination)
+		}
+	}()
+	gzipReader, err := gzip.NewReader(input)
+	if err != nil {
+		return err
+	}
+	defer gzipReader.Close()
+	tarReader := tar.NewReader(gzipReader)
+	var total int64
+	files := 0
+	for {
+		header, err := tarReader.Next()
+		if errors.Is(err, io.EOF) {
+			break
+		}
+		if err != nil {
+			return err
+		}
+		files++
+		if files > DefaultMaxCheckpointFiles {
+			return errors.New("too many checkpoint files")
+		}
+		relative, err := safeArchivePath(header.Name)
+		if err != nil {
+			return err
+		}
+		target := filepath.Join(destination, relative)
+		if target != destination && !strings.HasPrefix(target, destination+string(filepath.Separator)) {
+			return errors.New("checkpoint path escapes the destination")
+		}
+		switch header.Typeflag {
+		case tar.TypeDir:
+			if err := os.MkdirAll(target, 0o700); err != nil {
+				return err
+			}
+		case tar.TypeReg, tar.TypeRegA:
+			if header.Size < 0 || header.Size > maxBytes || total > maxBytes-header.Size {
+				return errors.New("checkpoint contents exceed the size limit")
+			}
+			total += header.Size
+			if err := os.MkdirAll(filepath.Dir(target), 0o700); err != nil {
+				return err
+			}
+			output, err := os.OpenFile(target, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+			if err != nil {
+				return err
+			}
+			_, copyErr := io.CopyN(output, tarReader, header.Size)
+			closeErr := output.Close()
+			if copyErr != nil {
+				return copyErr
+			}
+			if closeErr != nil {
+				return closeErr
+			}
+		default:
+			return fmt.Errorf("unsupported checkpoint entry type at %s", header.Name)
+		}
+	}
+	if err := os.Chtimes(destination, time.Now(), time.Now()); err != nil {
+		return err
+	}
+	completed = true
+	return nil
+}
+
+func DigestFile(path string, maxBytes int64) (ArchiveDigest, error) {
+	var result ArchiveDigest
+	input, err := os.Open(path)
+	if err != nil {
+		return result, err
+	}
+	defer input.Close()
+	hash := sha256.New()
+	written, err := io.Copy(hash, io.LimitReader(input, maxBytes+1))
+	if err != nil {
+		return result, err
+	}
+	if written > maxBytes {
+		return result, errors.New("checkpoint archive exceeds the size limit")
+	}
+	result.Size = written
+	result.SHA256 = hex.EncodeToString(hash.Sum(nil))
+	return result, nil
+}
diff --git a/buildroot/k3/scripts/migration/checkpoint_test.go b/buildroot/k3/scripts/migration/checkpoint_test.go
new file mode 100644
