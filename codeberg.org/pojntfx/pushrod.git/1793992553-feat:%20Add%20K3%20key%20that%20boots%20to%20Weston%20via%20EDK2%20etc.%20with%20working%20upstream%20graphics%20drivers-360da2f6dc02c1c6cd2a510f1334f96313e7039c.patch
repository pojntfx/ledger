+package migration
+
+import (
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+)
+
+var randRead = rand.Read
+
+const (
+	MutualProtocolVersion   = "rva23-mutual-migration/v1"
+	RoleSource              = "source"
+	RoleDestination         = "destination"
+	OperationSourceAttest   = "source-attestation"
+	OperationUpload         = "checkpoint-upload"
+	OperationDestAttest     = "destination-attestation"
+	OperationDownload       = "checkpoint-download"
+	OperationComplete       = "migration-completion"
+	MutualChallengeLifetime = 2 * time.Minute
+)
+
+type MutualSessionRequest struct {
+	InstanceID string `json:"instanceId"`
+	PID        int    `json:"pid"`
+}
+
+type MutualSessionResponse struct {
+	SessionID string `json:"sessionId"`
+}
+
+type OperationBinding struct {
+	SessionID        string `json:"sessionId"`
+	Role             string `json:"role"`
+	Operation        string `json:"operation"`
+	InstanceID       string `json:"instanceId"`
+	PID              int    `json:"pid"`
+	Counter          uint64 `json:"counter"`
+	CheckpointSHA256 string `json:"checkpointSha256,omitempty"`
+	CheckpointSize   int64  `json:"checkpointSize,omitempty"`
+}
+
+type MutualChallengeRequest struct {
+	Binding OperationBinding `json:"binding"`
+}
+
+type MutualChallengeResponse struct {
+	Binding         OperationBinding `json:"binding"`
+	ServerNonce     string           `json:"serverNonce"`
+	ClientNonce     string           `json:"clientNonce"`
+	ExpiresAt       time.Time        `json:"expiresAt"`
+	ServerEvidence  Evidence         `json:"serverEvidence"`
+	ServerSignature string           `json:"serverSignature"`
+}
+
+type MutualOperationRequest struct {
+	Binding      OperationBinding `json:"binding"`
+	ServerNonce  string           `json:"serverNonce"`
+	ClientNonce  string           `json:"clientNonce"`
+	ConsentProof string           `json:"consentProof"`
+	Signature    string           `json:"signature"`
+}
+
+type MutualGrant struct {
+	GrantID   string           `json:"grantId,omitempty"`
+	Status    string           `json:"status"`
+	Binding   OperationBinding `json:"binding"`
+	ExpiresAt time.Time        `json:"expiresAt,omitempty"`
+}
+
+type mutualServerSigningMessage struct {
+	Protocol             string           `json:"protocol"`
+	Binding              OperationBinding `json:"binding"`
+	ServerNonce          string           `json:"serverNonce"`
+	ClientNonce          string           `json:"clientNonce"`
+	ReportSHA256         string           `json:"reportSha256"`
+	AttestationToken     string           `json:"attestationToken"`
+	PCR11                string           `json:"pcr11"`
+	PCR11QuoteSHA256     string           `json:"pcr11QuoteSha256"`
+	PCR11SignatureSHA256 string           `json:"pcr11SignatureSha256"`
+}
+
+type mutualClientSigningMessage struct {
+	Protocol     string           `json:"protocol"`
+	Binding      OperationBinding `json:"binding"`
+	ServerNonce  string           `json:"serverNonce"`
+	ClientNonce  string           `json:"clientNonce"`
+	ConsentProof string           `json:"consentProof"`
+}
+
+func ValidateSessionID(value string) error {
+	decoded, err := hex.DecodeString(value)
+	if err != nil || len(decoded) != 16 || strings.ToLower(value) != value {
+		return errors.New("session ID must contain 32 lowercase hexadecimal characters")
+	}
+	return nil
+}
+
+func ExpectedOperation(role string, counter uint64) (string, error) {
+	if counter == 0 || counter > 5 {
+		return "", errors.New("mutual migration counter must be between 1 and 5")
+	}
+	operations := []string{OperationSourceAttest, OperationUpload, OperationDestAttest, OperationDownload, OperationComplete}
+	operation := operations[counter-1]
+	expectedRole := RoleSource
+	if counter >= 3 {
+		expectedRole = RoleDestination
+	}
+	if role != expectedRole {
+		return "", fmt.Errorf("operation %d requires the %s role", counter, expectedRole)
+	}
+	return operation, nil
+}
+
+func RequiresCheckpoint(operation string) bool {
+	return operation != OperationSourceAttest
+}
+
+func ValidateBinding(input OperationBinding) error {
+	if err := ValidateSessionID(input.SessionID); err != nil {
+		return err
+	}
+	if err := ValidateInstanceID(input.InstanceID); err != nil {
+		return err
+	}
+	if input.PID <= 0 || input.Counter == 0 {
+		return errors.New("PID and counter must be positive")
+	}
+	operation, err := ExpectedOperation(input.Role, input.Counter)
+	if err != nil {
+		return err
+	}
+	if input.Operation != operation {
+		return fmt.Errorf("operation %q does not match counter %d", input.Operation, input.Counter)
+	}
+	if RequiresCheckpoint(input.Operation) {
+		if !ValidSHA256(input.CheckpointSHA256) || input.CheckpointSize <= 0 || input.CheckpointSize > DefaultMaxCheckpointBytes {
+			return errors.New("a valid checkpoint digest and size are required")
+		}
+	} else if input.CheckpointSHA256 != "" || input.CheckpointSize != 0 {
+		return errors.New("source attestation must not contain checkpoint metadata")
+	}
+	return nil
+}
+
+func ValidSHA256(value string) bool {
+	decoded, err := hex.DecodeString(value)
+	return err == nil && len(decoded) == sha256.Size && strings.ToLower(value) == value
+}
+
+func MutualApplication(sessionID string) ([]byte, error) {
+	if err := ValidateSessionID(sessionID); err != nil {
+		return nil, err
+	}
+	digest := sha256.Sum256([]byte(MutualProtocolVersion + "\x00application\x00" + sessionID))
+	return digest[:], nil
+}
+
+func MutualServerMessage(input MutualChallengeResponse) ([]byte, error) {
+	if err := ValidateBinding(input.Binding); err != nil {
+		return nil, err
+	}
+	report, err := base64.RawURLEncoding.DecodeString(input.ServerEvidence.Report)
+	if err != nil || len(report) == 0 {
+		return nil, errors.New("invalid server OS report encoding")
+	}
+	quote, err := base64.RawURLEncoding.DecodeString(input.ServerEvidence.PCR11Quote)
+	if err != nil || len(quote) == 0 {
+		return nil, errors.New("invalid server PCR 11 quote encoding")
+	}
+	quoteSignature, err := base64.RawURLEncoding.DecodeString(input.ServerEvidence.PCR11Signature)
+	if err != nil || len(quoteSignature) == 0 {
+		return nil, errors.New("invalid server PCR 11 signature encoding")
+	}
+	reportDigest := sha256.Sum256(report)
+	quoteDigest := sha256.Sum256(quote)
+	quoteSignatureDigest := sha256.Sum256(quoteSignature)
+	return json.Marshal(mutualServerSigningMessage{
+		Protocol: MutualProtocolVersion, Binding: input.Binding,
+		ServerNonce: input.ServerNonce, ClientNonce: input.ClientNonce,
+		ReportSHA256: hex.EncodeToString(reportDigest[:]), AttestationToken: input.ServerEvidence.Token,
+		PCR11: strings.ToLower(input.ServerEvidence.PCR11), PCR11QuoteSHA256: hex.EncodeToString(quoteDigest[:]),
+		PCR11SignatureSHA256: hex.EncodeToString(quoteSignatureDigest[:]),
+	})
+}
+
+func MutualClientMessage(input MutualOperationRequest) ([]byte, error) {
+	if err := ValidateBinding(input.Binding); err != nil {
+		return nil, err
+	}
+	if input.ConsentProof == "" {
+		return nil, errors.New("FIDO2 consent is required")
+	}
+	return json.Marshal(mutualClientSigningMessage{
+		Protocol: MutualProtocolVersion, Binding: input.Binding,
+		ServerNonce: input.ServerNonce, ClientNonce: input.ClientNonce, ConsentProof: input.ConsentProof,
+	})
+}
+
+func MutualConsentMessage(input MutualOperationRequest) ([]byte, error) {
+	if err := ValidateBinding(input.Binding); err != nil {
+		return nil, err
+	}
+	return json.Marshal(mutualClientSigningMessage{
+		Protocol: MutualProtocolVersion, Binding: input.Binding,
+		ServerNonce: input.ServerNonce, ClientNonce: input.ClientNonce,
+	})
+}
+
+func MutualConsentChallenge(message []byte) []byte {
+	digest := sha256.Sum256(message)
+	return digest[:]
+}
+
+func RandomID() (string, error) {
+	value := make([]byte, 16)
+	if _, err := randRead(value); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(value), nil
+}
+
+func RandomNonce() (string, error) {
+	value := make([]byte, 32)
+	if _, err := randRead(value); err != nil {
+		return "", err
+	}
+	return base64.RawURLEncoding.EncodeToString(value), nil
+}
diff --git a/buildroot/k3/scripts/migration/mutual_protocol_test.go b/buildroot/k3/scripts/migration/mutual_protocol_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..48de376c964fa0d1975cea3e50412df3f2a6cc73
--- /dev/null
+++ b/buildroot/k3/scripts/migration/mutual_protocol_test.go
@@ -0,0 +1,73 @@
+package migration
+
+import (
+	"strings"
+	"testing"
+)
+
+func mutualTestBinding(counter uint64) OperationBinding {
+	role := RoleSource
+	if counter >= 3 {
+		role = RoleDestination
+	}
+	operation, _ := ExpectedOperation(role, counter)
+	binding := OperationBinding{SessionID: strings.Repeat("a", 32), Role: role, Operation: operation, InstanceID: strings.Repeat("b", 32), PID: 4242, Counter: counter}
+	if RequiresCheckpoint(operation) {
+		binding.CheckpointSHA256 = strings.Repeat("c", 64)
+		binding.CheckpointSize = 128
+	}
+	return binding
+}
+
+func TestMutualOperationSequence(t *testing.T) {
+	for counter := uint64(1); counter <= 5; counter++ {
+		if err := ValidateBinding(mutualTestBinding(counter)); err != nil {
+			t.Fatalf("counter %d: %v", counter, err)
+		}
+	}
+}
+
+func TestMutualBindingRejectsCrossSessionAndCheckpointChanges(t *testing.T) {
+	binding := mutualTestBinding(2)
+	binding.SessionID = strings.Repeat("d", 32)
+	if err := ValidateBinding(binding); err != nil {
+		t.Fatal(err)
+	}
+	binding.CheckpointSHA256 = strings.Repeat("e", 64)
+	if err := ValidateBinding(binding); err != nil {
+		t.Fatal(err)
+	}
+	binding.Operation = OperationDownload
+	if err := ValidateBinding(binding); err == nil {
+		t.Fatal("operation substitution passed validation")
+	}
+	binding = mutualTestBinding(3)
+	binding.Role = RoleSource
+	if err := ValidateBinding(binding); err == nil {
+		t.Fatal("role substitution passed validation")
+	}
+	binding = mutualTestBinding(1)
+	binding.CheckpointSHA256 = strings.Repeat("c", 64)
+	if err := ValidateBinding(binding); err == nil {
+		t.Fatal("unexpected checkpoint metadata passed validation")
+	}
+}
+
+func TestMutualConsentMessageBindsBothChallenges(t *testing.T) {
+	input := MutualOperationRequest{Binding: mutualTestBinding(1), ServerNonce: "server", ClientNonce: "client"}
+	first, err := MutualConsentMessage(input)
+	if err != nil {
+		t.Fatal(err)
+	}
+	input.ClientNonce = "other"
+	second, err := MutualConsentMessage(input)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(first) == string(second) {
+		t.Fatal("client challenge is not bound to FIDO2 consent")
+	}
+	if !strings.Contains(string(first), `"serverNonce":"server"`) || !strings.Contains(string(first), `"clientNonce":"client"`) {
+		t.Fatal("separate nonces are missing from the consent message")
+	}
+}
diff --git a/buildroot/k3/scripts/migration/mutual_tpm.go b/buildroot/k3/scripts/migration/mutual_tpm.go
new file mode 100644
index 0000000000000000000000000000000000000000..d8913d2d27ebdbae7dbce823ced4fb4a79edeb34
--- /dev/null
+++ b/buildroot/k3/scripts/migration/mutual_tpm.go
@@ -0,0 +1,215 @@
+package migration
+
+import (
+	"bytes"
+	"crypto"
+	"crypto/rsa"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"encoding/pem"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+)
+
+const defaultAKHandleFile = "/var/lib/systemd/report.sign.tpm2/default.key"
+
+func VerifyAKSignature(key *rsa.PublicKey, message []byte, encoded string) error {
+	if key == nil {
+		return errors.New("no enrolled AK for this identity")
+	}
+	signature, err := DecodeSignature(encoded)
+	if err != nil || len(signature) != key.Size() {
+		return errors.New("invalid AK signature encoding or length")
+	}
+	digest := sha256.Sum256(message)
+	if err := rsa.VerifyPKCS1v15(key, crypto.SHA256, digest[:], signature); err != nil {
+		return errors.New("AK signature does not match the enrolled identity")
+	}
+	return nil
+}
+
+func LoadAKPublicKey(path string) (*rsa.PublicKey, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	block, rest := pem.Decode(data)
+	if block == nil || block.Type != "PUBLIC KEY" || len(rest) != 0 {
+		return nil, errors.New("invalid AK public key PEM")
+	}
+	parsed, err := x509.ParsePKIXPublicKey(block.Bytes)
+	if err != nil {
+		return nil, err
+	}
+	key, ok := parsed.(*rsa.PublicKey)
+	if !ok || key.N.BitLen() < 2048 {
+		return nil, errors.New("AK public key must be RSA with at least 2048 bits")
+	}
+	return key, nil
+}
+
+func persistentAKHandle() (string, error) {
+	if _, err := os.Stat(defaultAKHandleFile); errors.Is(err, os.ErrNotExist) {
+		if result, provisionErr := exec.Command("/usr/libexec/rva23-report-provision").CombinedOutput(); provisionErr != nil {
+			return "", fmt.Errorf("provision TPM AK: %s", result)
+		}
+	}
+	handle, err := os.ReadFile(defaultAKHandleFile)
+	if err != nil {
+		return "", err
+	}
+	var keyData struct {
+		Handle string `json:"handle"`
+	}
+	if err := json.Unmarshal(handle, &keyData); err != nil {
+		return "", err
+	}
+	serialized, err := base64.StdEncoding.DecodeString(keyData.Handle)
+	if err != nil || len(serialized) < 4 {
+		return "", errors.New("invalid persistent AK handle")
+	}
+	return fmt.Sprintf("0x%08x", binary.BigEndian.Uint32(serialized[:4])), nil
+}
+
+func SignWithTPMAK(message []byte) (string, error) {
+	directory, err := os.MkdirTemp("", "rva23-mutual-sign-")
+	if err != nil {
+		return "", err
+	}
+	defer os.RemoveAll(directory)
+	messagePath := filepath.Join(directory, "message.bin")
+	signaturePath := filepath.Join(directory, "signature.bin")
+	if err := os.WriteFile(messagePath, message, 0o600); err != nil {
+		return "", err
+	}
+	handle, err := persistentAKHandle()
+	if err != nil {
+		return "", err
+	}
+	if result, err := exec.Command("tpm2_sign", "-c", handle, "-g", "sha256", "-s", "rsassa", "-o", signaturePath, messagePath).CombinedOutput(); err != nil {
+		return "", fmt.Errorf("tpm2_sign: %s", result)
+	}
+	signature, err := os.ReadFile(signaturePath)
+	if err != nil {
+		return "", err
+	}
+	if len(signature) < 256 {
+		return "", errors.New("TPM AK signature is too short")
+	}
+	return base64.RawURLEncoding.EncodeToString(signature[len(signature)-256:]), nil
+}
+
+func GenerateServerEvidence(nonce string) (Evidence, error) {
+	var evidence Evidence
+	nonceBytes, err := base64.RawURLEncoding.DecodeString(nonce)
+	if err != nil || len(nonceBytes) != 32 {
+		return evidence, errors.New("invalid server challenge nonce")
+	}
+	if result, err := exec.Command("systemctl", "start", "systemd-pcrlock.socket").CombinedOutput(); err != nil {
+		return evidence, fmt.Errorf("systemd-pcrlock.socket: %s", result)
+	}
+	if result, err := exec.Command("systemctl", "restart", "systemd-report-sign-tpm2.socket").CombinedOutput(); err != nil {
+		return evidence, fmt.Errorf("systemd-report-sign-tpm2.socket: %s", result)
+	}
+	command := exec.Command("attested-client")
+	command.Env = append(os.Environ(), "RVA23_ATTESTATION_CAPTURE=1", "RVA23_ATTESTATION_NONCE="+nonce)
+	if result, err := command.CombinedOutput(); err != nil {
+		return evidence, fmt.Errorf("attested-client: %s", result)
+	}
+	report, err := os.ReadFile("/tmp/rva23-attested-body")
+	if err != nil {
+		return evidence, err
+	}
+	token, err := os.ReadFile("/tmp/rva23-attested-token")
+	if err != nil {
+		return evidence, err
+	}
+	directory, err := os.MkdirTemp("", "rva23-mutual-quote-")
+	if err != nil {
+		return evidence, err
+	}
+	defer os.RemoveAll(directory)
+	pcrPath := filepath.Join(directory, "pcr11.bin")
+	if result, err := exec.Command("tpm2_pcrread", "sha256:11", "-o", pcrPath).CombinedOutput(); err != nil {
+		return evidence, fmt.Errorf("tpm2_pcrread: %s", result)
+	}
+	pcr11, err := os.ReadFile(pcrPath)
+	if err != nil || len(pcr11) != sha256.Size {
+		return evidence, errors.New("TPM PCR 11 must contain one SHA-256 value")
+	}
+	handle, err := persistentAKHandle()
+	if err != nil {
+		return evidence, err
+	}
+	quotePath := filepath.Join(directory, "quote.msg")
+	signaturePath := filepath.Join(directory, "quote.sig")
+	selectionsPath := filepath.Join(directory, "quote.pcrs")
+	if result, err := exec.Command("tpm2_quote", "-c", handle, "-l", "sha256:11", "-q", hex.EncodeToString(nonceBytes), "-m", quotePath, "-s", signaturePath, "-o", selectionsPath, "-g", "sha256").CombinedOutput(); err != nil {
+		return evidence, fmt.Errorf("tpm2_quote: %s", result)
+	}
+	quote, err := os.ReadFile(quotePath)
+	if err != nil {
+		return evidence, err
+	}
+	signature, err := os.ReadFile(signaturePath)
+	if err != nil {
+		return evidence, err
+	}
+	selections, err := os.ReadFile(selectionsPath)
+	if err != nil {
+		return evidence, err
+	}
+	return Evidence{
+		Report: base64.RawURLEncoding.EncodeToString(report), Nonce: nonce, Token: strings.TrimSpace(string(token)),
+		PCR11: hex.EncodeToString(pcr11), PCR11Quote: base64.RawURLEncoding.EncodeToString(quote),
+		PCR11Signature: base64.RawURLEncoding.EncodeToString(signature), PCR11Selections: base64.RawURLEncoding.EncodeToString(selections),
+	}, nil
+}
+
+func VerifyPCR11Quote(keyFile, nonce string, evidence Evidence) error {
+	quote, err := base64.RawURLEncoding.DecodeString(evidence.PCR11Quote)
+	if err != nil || len(quote) == 0 {
+		return errors.New("invalid PCR 11 quote")
+	}
+	signature, err := base64.RawURLEncoding.DecodeString(evidence.PCR11Signature)
+	if err != nil || len(signature) == 0 {
+		return errors.New("invalid PCR 11 quote signature")
+	}
+	selections, err := base64.RawURLEncoding.DecodeString(evidence.PCR11Selections)
+	if err != nil || len(selections) < 10 || !bytes.Equal(selections[:10], []byte{0x01, 0x00, 0x00, 0x00, 0x0b, 0x00, 0x03, 0x00, 0x08, 0x00}) {
+		return errors.New("PCR 11 selections must contain only sha256:11")
+	}
+	pcr11, err := hex.DecodeString(evidence.PCR11)
+	if err != nil || len(pcr11) != sha256.Size {
+		return errors.New("PCR 11 must contain one SHA-256 value")
+	}
+	nonceBytes, err := base64.RawURLEncoding.DecodeString(nonce)
+	if err != nil || len(nonceBytes) != 32 {
+		return errors.New("invalid PCR 11 quote nonce")
+	}
+	directory, err := os.MkdirTemp("", "rva23-mutual-checkquote-")
+	if err != nil {
+		return err
+	}
+	defer os.RemoveAll(directory)
+	quotePath := filepath.Join(directory, "quote.msg")
+	signaturePath := filepath.Join(directory, "quote.sig")
+	pcrValuesPath := filepath.Join(directory, "quote.pcrs")
+	for path, data := range map[string][]byte{quotePath: quote, signaturePath: signature, pcrValuesPath: pcr11} {
+		if err := os.WriteFile(path, data, 0o600); err != nil {
+			return err
+		}
+	}
+	if result, err := exec.Command("tpm2_checkquote", "-u", keyFile, "-m", quotePath, "-s", signaturePath, "-f", pcrValuesPath, "-l", "sha256:11", "-q", hex.EncodeToString(nonceBytes)).CombinedOutput(); err != nil {
+		return fmt.Errorf("PCR 11 quote validation failed: %s", result)
+	}
+	return nil
+}
diff --git a/buildroot/k3/scripts/migration/protocol.go b/buildroot/k3/scripts/migration/protocol.go
new file mode 100644
index 0000000000000000000000000000000000000000..91eb688beedf0150bff0099ce5c82bf83b46fc3e
--- /dev/null
+++ b/buildroot/k3/scripts/migration/protocol.go
@@ -0,0 +1,180 @@
+package migration
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"strings"
+	"time"
+)
+
+const (
+	ProtocolVersion = "rva23-migration/v1"
+	PhaseBefore     = "before"
+	PhaseAfter      = "after"
+	ActionUpload    = "checkpoint-upload"
+	ActionDownload  = "checkpoint-download"
+)
+
+type ChallengeRequest struct {
+	InstanceID string `json:"instanceId"`
+	Phase      string `json:"phase"`
+}
+
+type ChallengeResponse struct {
+	Nonce     string    `json:"nonce"`
+	ExpiresAt time.Time `json:"expiresAt"`
+}
+
+type Evidence struct {
+	Report          string `json:"report"`
+	Nonce           string `json:"nonce"`
+	Token           string `json:"token"`
+	PCR11           string `json:"pcr11"`
+	PCR11Quote      string `json:"pcr11Quote"`
+	PCR11Signature  string `json:"pcr11Signature"`
+	PCR11Selections string `json:"pcr11Selections"`
+}
+
+type AttestationRequest struct {
+	InstanceID string   `json:"instanceId"`
+	PID        int      `json:"pid"`
+	Counter    uint64   `json:"counter"`
+	Phase      string   `json:"phase"`
+	Nonce      string   `json:"nonce"`
+	Evidence   Evidence `json:"evidence"`
+	Signature  string   `json:"signature"`
+}
+
+type AttestationResponse struct {
+	Status     string `json:"status"`
+	UserID     int    `json:"userId"`
+	InstanceID string `json:"instanceId"`
+	PID        int    `json:"pid"`
+	Counter    uint64 `json:"counter"`
+	Phase      string `json:"phase"`
+}
+
+type CheckpointAuthorization struct {
+	Action           string `json:"action"`
+	InstanceID       string `json:"instanceId"`
+	PID              int    `json:"pid"`
+	Counter          uint64 `json:"counter"`
+	Phase            string `json:"phase"`
+	Nonce            string `json:"nonce"`
+	CheckpointSHA256 string `json:"checkpointSha256"`
+	CheckpointSize   int64  `json:"checkpointSize"`
+}
+
+type CheckpointMetadata struct {
+	InstanceID string    `json:"instanceId"`
+	SHA256     string    `json:"sha256"`
+	Size       int64     `json:"size"`
+	UploadedAt time.Time `json:"uploadedAt"`
+}
+
+type attestationMessage struct {
+	Protocol         string `json:"protocol"`
+	InstanceID       string `json:"instanceId"`
+	PID              int    `json:"pid"`
+	Counter          uint64 `json:"counter"`
+	Phase            string `json:"phase"`
+	Nonce            string `json:"nonce"`
+	AttestationNonce string `json:"attestationNonce"`
+	AttestationToken string `json:"attestationToken"`
+	ReportSHA256     string `json:"reportSha256"`
+	PCR11            string `json:"pcr11"`
+}
+
+type checkpointMessage struct {
+	Protocol         string `json:"protocol"`
+	Action           string `json:"action"`
+	InstanceID       string `json:"instanceId"`
+	PID              int    `json:"pid"`
+	Counter          uint64 `json:"counter"`
+	Phase            string `json:"phase"`
+	Nonce            string `json:"nonce"`
+	CheckpointSHA256 string `json:"checkpointSha256"`
+	CheckpointSize   int64  `json:"checkpointSize"`
+}
+
+func ValidatePhase(phase string) error {
+	if phase != PhaseBefore && phase != PhaseAfter {
+		return errors.New("phase must be before or after")
+	}
+	return nil
+}
+
+func ValidateInstanceID(instanceID string) error {
+	decoded, err := hex.DecodeString(instanceID)
+	if err != nil || len(decoded) != 16 || strings.ToLower(instanceID) != instanceID {
+		return errors.New("instance ID must contain 32 lowercase hexadecimal characters")
+	}
+	return nil
+}
+
+func ExpectedUserID(phase string) (int, error) {
+	switch phase {
+	case PhaseBefore:
+		return 1, nil
+	case PhaseAfter:
+		return 2, nil
+	default:
+		return 0, errors.New("phase must be before or after")
+	}
+}
+
+func ExpectedCheckpointPhase(action string) (string, error) {
+	switch action {
+	case ActionUpload:
+		return PhaseBefore, nil
+	case ActionDownload:
+		return PhaseAfter, nil
+	default:
+		return "", errors.New("unknown checkpoint action")
+	}
+}
+
+func AttestationMessage(input AttestationRequest) ([]byte, error) {
+	report, err := base64.RawURLEncoding.DecodeString(input.Evidence.Report)
+	if err != nil || len(report) == 0 {
+		return nil, errors.New("invalid OS report encoding")
+	}
+	digest := sha256.Sum256(report)
+	return json.Marshal(attestationMessage{
+		Protocol:         ProtocolVersion,
+		InstanceID:       input.InstanceID,
+		PID:              input.PID,
+		Counter:          input.Counter,
+		Phase:            input.Phase,
+		Nonce:            input.Nonce,
+		AttestationNonce: input.Evidence.Nonce,
+		AttestationToken: input.Evidence.Token,
+		ReportSHA256:     hex.EncodeToString(digest[:]),
+		PCR11:            strings.ToLower(input.Evidence.PCR11),
+	})
+}
+
+func CheckpointMessage(input CheckpointAuthorization) ([]byte, error) {
+	return json.Marshal(checkpointMessage{
+		Protocol:         ProtocolVersion,
+		Action:           input.Action,
+		InstanceID:       input.InstanceID,
+		PID:              input.PID,
+		Counter:          input.Counter,
+		Phase:            input.Phase,
+		Nonce:            input.Nonce,
+		CheckpointSHA256: input.CheckpointSHA256,
+		CheckpointSize:   input.CheckpointSize,
+	})
+}
+
+func DecodeSignature(encoded string) ([]byte, error) {
+	signature, err := base64.RawURLEncoding.DecodeString(encoded)
+	if err != nil || len(signature) == 0 {
+		return nil, errors.New("invalid AK signature encoding")
+	}
+	return signature, nil
+}
diff --git a/buildroot/k3/scripts/smartcard-sign.c b/buildroot/k3/scripts/smartcard-sign.c
new file mode 100644
index 0000000000000000000000000000000000000000..b7cd39af9e85b463cdb67f91b7ce70fd7c322534
--- /dev/null
+++ b/buildroot/k3/scripts/smartcard-sign.c
@@ -0,0 +1,170 @@
+#include <errno.h>
+#include <openssl/sha.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <winscard.h>
+
+static void print_hex(const unsigned char *data, size_t size)
+{
+    size_t i;
+    for (i = 0; i < size; i++)
+        printf("%02x", data[i]);
+    printf("\n");
+}
+
+static int transmit(SCARDHANDLE card, const unsigned char *command, size_t command_size,
+                    unsigned char *response, size_t *response_size)
+{
+    SCARD_IO_REQUEST protocol = {SCARD_PROTOCOL_T0, 0};
+    print_hex(command, command_size);
+    LONG result = SCardTransmit(card, &protocol, command, command_size, NULL,
+                                response, response_size);
+    if (result != SCARD_S_SUCCESS) {
+        fprintf(stderr, "SCardTransmit failed: 0x%08lx\n", result);
+        return -1;
+    }
+    if (*response_size >= 2 && response[*response_size - 2] == 0x61) {
+        unsigned char get_response[] = {0x00, 0xc0, 0x00, 0x00, response[*response_size - 1]};
+        *response_size = 1024;
+        result = SCardTransmit(card, &protocol, get_response, sizeof(get_response), NULL,
+                                response, response_size);
+        if (result != SCARD_S_SUCCESS) {
+            fprintf(stderr, "SCardTransmit GET RESPONSE failed: 0x%08lx\n", result);
+            return -1;
+        }
+    }
+    if (*response_size < 2 || response[*response_size - 2] != 0x90 || response[*response_size - 1] != 0x00) {
+        fprintf(stderr, "Card rejected APDU: ");
+        print_hex(response, *response_size);
+        return -1;
+    }
+    return 0;
+}
+
+static int read_file(const char *path, unsigned char **data, size_t *size)
+{
+    FILE *file = fopen(path, "rb");
+    long length;
+    if (!file) {
+        perror(path);
+        return -1;
+    }
+    if (fseek(file, 0, SEEK_END) != 0 || (length = ftell(file)) < 0 || fseek(file, 0, SEEK_SET) != 0) {
+        fclose(file);
+        return -1;
+    }
+    *data = malloc(length ? (size_t)length : 1);
+    if (!*data) {
+        fclose(file);
+        return -1;
+    }
+    *size = fread(*data, 1, (size_t)length, file);
+    fclose(file);
+    if (*size != (size_t)length) {
+        free(*data);
+        return -1;
+    }
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    SCARDCONTEXT context;
+    SCARDHANDLE card = 0;
+    LONG result;
+    char readers[4096];
+    DWORD readers_size = sizeof(readers);
+    DWORD protocol = SCARD_PROTOCOL_T0;
+    unsigned char *message = NULL;
+    size_t message_size = 0;
+    unsigned char digest[SHA256_DIGEST_LENGTH];
+    unsigned char padded[256];
+    unsigned char sign_command[263];
+    unsigned char response[1024];
+    size_t response_size;
+    static const unsigned char select_pki[] = {0x00, 0xa4, 0x04, 0x00, 0x07, 0xa0, 0x00, 0x00, 0x00, 0x79, 0x01, 0x02};
+    static const unsigned char verify_pin[] = {0x00, 0x20, 0x00, 0x00, 0x00};
+    static const unsigned char sign_prefix[] = {0x00, 0x42, 0x00, 0x00};
+    static const unsigned char digest_info[] = {
+        0x30, 0x31, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01,
+        0x65, 0x03, 0x04, 0x02, 0x01, 0x05, 0x00, 0x04, 0x20
+    };
+    FILE *output;
+
+    if (argc != 3) {
+        fprintf(stderr, "usage: smartcard-sign MESSAGE SIGNATURE\n");
+        return 2;
+    }
+    if (read_file(argv[1], &message, &message_size) != 0)
+        return 1;
+    SHA256(message, message_size, digest);
+    if (message_size > 256) {
+        fprintf(stderr, "message is too long\n");
+        return 1;
+    }
+    memset(padded, 0, sizeof(padded));
+    padded[0] = 0x00;
+    padded[1] = 0x01;
+    memset(padded + 2, 0xff, sizeof(padded) - 3 - sizeof(digest_info) - SHA256_DIGEST_LENGTH);
+    padded[sizeof(padded) - sizeof(digest_info) - SHA256_DIGEST_LENGTH - 1] = 0x00;
+    memcpy(padded + sizeof(padded) - sizeof(digest_info) - SHA256_DIGEST_LENGTH, digest_info, sizeof(digest_info));
+    memcpy(padded + sizeof(padded) - SHA256_DIGEST_LENGTH, digest, SHA256_DIGEST_LENGTH);
+    free(message);
+    result = SCardEstablishContext(SCARD_SCOPE_SYSTEM, NULL, NULL, &context);
+    if (result != SCARD_S_SUCCESS) {
+        fprintf(stderr, "SCardEstablishContext failed: 0x%08lx\n", result);
+        return 1;
+    }
+    result = SCardListReaders(context, NULL, readers, &readers_size);
+    if (result != SCARD_S_SUCCESS || readers_size < 2) {
+        fprintf(stderr, "SCardListReaders failed: 0x%08lx\n", result);
+        SCardReleaseContext(context);
+        return 1;
+    }
+    result = SCardConnect(context, readers, SCARD_SHARE_SHARED, SCARD_PROTOCOL_T0, &card, &protocol);
+    if (result != SCARD_S_SUCCESS) {
+        fprintf(stderr, "SCardConnect failed: 0x%08lx\n", result);
+        SCardReleaseContext(context);
+        return 1;
+    }
+    if (SCardBeginTransaction(card) != SCARD_S_SUCCESS) {
+        SCardDisconnect(card, SCARD_LEAVE_CARD);
+        SCardReleaseContext(context);
+        return 1;
+    }
+    response_size = sizeof(response);
+    if (transmit(card, select_pki, sizeof(select_pki), response, &response_size) != 0)
+        goto fail;
+    memcpy(sign_command, sign_prefix, sizeof(sign_prefix));
+    sign_command[sizeof(sign_prefix)] = 0x00;
+    sign_command[sizeof(sign_prefix) + 1] = 0x01;
+    sign_command[sizeof(sign_prefix) + 2] = 0x00;
+    memcpy(sign_command + sizeof(sign_prefix) + 3, padded, sizeof(padded));
+    response_size = sizeof(response);
+    if (transmit(card, sign_command, sizeof(sign_command), response, &response_size) != 0)
+        goto fail;
+    if (SCardEndTransaction(card, SCARD_LEAVE_CARD) != SCARD_S_SUCCESS)
+        goto disconnect;
+    output = fopen(argv[2], "wb");
+    if (!output) {
+        perror(argv[2]);
+        goto disconnect;
+    }
+    if (fwrite(response, 1, response_size - 2, output) != response_size - 2) {
+        fclose(output);
+        goto disconnect;
+    }
+    fclose(output);
+    print_hex(response, response_size - 2);
+    SCardDisconnect(card, SCARD_LEAVE_CARD);
+    SCardReleaseContext(context);
+    return 0;
+
+fail:
+    SCardEndTransaction(card, SCARD_LEAVE_CARD);
+disconnect:
+    SCardDisconnect(card, SCARD_LEAVE_CARD);
+    SCardReleaseContext(context);
+    return 1;
+}
diff --git a/buildroot/k3/scripts/u2f.go b/buildroot/k3/scripts/u2f.go
new file mode 100644
index 0000000000000000000000000000000000000000..a2a892f7c792dd89f26fbcd9802eaad48c669081
--- /dev/null
+++ b/buildroot/k3/scripts/u2f.go
@@ -0,0 +1,556 @@
+package main
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/x509"
+	"encoding/asn1"
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"encoding/pem"
+	"errors"
+	"fmt"
+	"io"
+	"math/big"
+	"os"
+	"path/filepath"
+	"sync"
+	"syscall"
+	"time"
+)
+
+const (
+	u2fHIDMSG         = 0x83
+	u2fHIDINIT        = 0x86
+	u2fHIDKEEPALIVE   = 0xbb
+	u2fHIDERROR       = 0xbf
+	u2fBroadcastCID   = 0xffffffff
+	u2fFrameSize      = 64
+	u2fInitialPayload = 57
+	u2fNextPayload    = 59
+	u2fCachePath      = "/var/lib/rva23-wallet/fido2.json"
+)
+
+type U2FConsent struct {
+	PublicKey             string `json:"publicKey"`
+	Certificate           string `json:"certificate"`
+	KeyHandle             string `json:"keyHandle"`
+	RegistrationChallenge string `json:"registrationChallenge"`
+	RegistrationSignature string `json:"registrationSignature"`
+	Signature             string `json:"signature"`
+	Counter               uint32 `json:"counter"`
+}
+
+type u2fRegistration struct {
+	KeyHandle             string `json:"keyHandle"`
+	PublicKey             string `json:"publicKey"`
+	Certificate           string `json:"certificate"`
+	RegistrationChallenge string `json:"registrationChallenge"`
+	RegistrationSignature string `json:"registrationSignature"`
+}
+
+type u2fDevice struct {
+	file *os.File
+	cid  uint32
+}
+
+var u2fConsentMutex sync.Mutex
+
+func Fido2Consent(challenge, application []byte) (U2FConsent, error) {
+	u2fConsentMutex.Lock()
+	defer u2fConsentMutex.Unlock()
+	if len(challenge) != 32 {
+		return U2FConsent{}, fmt.Errorf("U2F challenge must contain 32 bytes, got %d", len(challenge))
+	}
+	if len(application) != 32 {
+		return U2FConsent{}, fmt.Errorf("U2F application parameter must contain 32 bytes, got %d", len(application))
+	}
+	registration, err := u2fReadRegistration(application)
+	if err != nil {
+		return U2FConsent{}, err
+	}
+	device, err := u2fOpen()
+	if err != nil {
+		return U2FConsent{}, err
+	}
+	defer device.file.Close()
+	if registration == nil {
+		registration, err = u2fRegister(device, challenge, application)
+		if err != nil {
+			return U2FConsent{}, err
+		}
+		if err := u2fWriteRegistration(application, registration); err != nil {
+			return U2FConsent{}, err
+		}
+	}
+	keyHandle, err := base64.RawURLEncoding.DecodeString(registration.KeyHandle)
+	if err != nil {
+		return U2FConsent{}, fmt.Errorf("decode cached U2F key handle: %w", err)
+	}
+	signature, counter, err := u2fAuthenticate(device, challenge, application, keyHandle)
+	if err != nil {
+		return U2FConsent{}, err
+	}
+	return U2FConsent{
+		PublicKey:             registration.PublicKey,
+		Certificate:           registration.Certificate,
+		KeyHandle:             registration.KeyHandle,
+		RegistrationChallenge: registration.RegistrationChallenge,
+		RegistrationSignature: registration.RegistrationSignature,
+		Signature:             base64.RawURLEncoding.EncodeToString(signature),
+		Counter:               counter,
+	}, nil
+}
+
+func u2fOpen() (*u2fDevice, error) {
+	paths, err := filepath.Glob("/dev/hidraw*")
+	if err != nil {
+		return nil, err
+	}
+	var failures []error
+	for _, path := range paths {
+		file, err := os.OpenFile(path, os.O_RDWR, 0)
+		if err != nil {
+			failures = append(failures, fmt.Errorf("open %s: %w", path, err))
+			continue
+		}
+		device := &u2fDevice{file: file, cid: u2fBroadcastCID}
+		nonce := make([]byte, 8)
+		if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+			file.Close()
+			return nil, fmt.Errorf("create U2F HID nonce: %w", err)
+		}
+		response, err := device.transact(u2fHIDINIT, nonce, 3*time.Second)
+		if err != nil {
+			file.Close()
+			failures = append(failures, fmt.Errorf("initialize %s: %w", path, err))
+			continue
+		}
+		if len(response) < 12 || !equalU2FBytes(response[:8], nonce) {
+			file.Close()
+			failures = append(failures, fmt.Errorf("initialize %s: invalid U2F HID INIT response", path))
+			continue
+		}
+		device.cid = binary.BigEndian.Uint32(response[8:12])
+		if device.cid == 0 || device.cid == u2fBroadcastCID {
+			file.Close()
+			failures = append(failures, fmt.Errorf("initialize %s: invalid allocated channel 0x%08x", path, device.cid))
+			continue
+		}
+		return device, nil
+	}
+	if len(failures) > 0 {
+		return nil, fmt.Errorf("no usable U2F HID device: %w", errors.Join(failures...))
+	}
+	return nil, errors.New("no U2F HID device found")
+}
+
+func equalU2FBytes(left, right []byte) bool {
+	if len(left) != len(right) {
+		return false
+	}
+	var difference byte
+	for index := range left {
+		difference |= left[index] ^ right[index]
+	}
+	return difference == 0
+}
+
+func (device *u2fDevice) transact(command byte, payload []byte, timeout time.Duration) ([]byte, error) {
+	deadline := time.Now().Add(timeout)
+	if err := device.writeMessage(command, payload, deadline); err != nil {
+		return nil, err
+	}
+	for {
+		responseCommand, response, err := device.readMessage(deadline)
+		if err != nil {
+			return nil, err
+		}
+		switch responseCommand {
+		case command:
+			return response, nil
+		case u2fHIDKEEPALIVE:
+			if len(response) != 1 {
+				return nil, fmt.Errorf("invalid U2F HID KEEPALIVE payload length %d", len(response))
+			}
+		case u2fHIDERROR:
+			if len(response) == 1 {
+				return nil, fmt.Errorf("U2F HID error 0x%02x", response[0])
+			}
+			return nil, errors.New("invalid U2F HID ERROR response")
+		default:
+			return nil, fmt.Errorf("unexpected U2F HID command 0x%02x", responseCommand)
+		}
+	}
+}
+
+func (device *u2fDevice) writeMessage(command byte, payload []byte, deadline time.Time) error {
+	if len(payload) > 0xffff {
+		return fmt.Errorf("U2F HID payload is too large: %d", len(payload))
+	}
+	var frame [u2fFrameSize]byte
+	binary.BigEndian.PutUint32(frame[0:4], device.cid)
+	frame[4] = command
+	binary.BigEndian.PutUint16(frame[5:7], uint16(len(payload)))
+	firstLength := len(payload)
+	if firstLength > u2fInitialPayload {
+		firstLength = u2fInitialPayload
+	}
+	copy(frame[7:], payload[:firstLength])
+	if err := device.writeFrame(frame, deadline); err != nil {
+		return err
+	}
+	offset := firstLength
+	for sequence := byte(0); offset < len(payload); sequence++ {
+		clear(frame[:])
+		binary.BigEndian.PutUint32(frame[0:4], device.cid)
+		frame[4] = sequence
+		length := len(payload) - offset
+		if length > u2fNextPayload {
+			length = u2fNextPayload
+		}
+		copy(frame[5:], payload[offset:offset+length])
+		if err := device.writeFrame(frame, deadline); err != nil {
+			return err
+		}
+		offset += length
+		if sequence == 0x7f && offset < len(payload) {
+			return errors.New("U2F HID continuation sequence exhausted")
+		}
+	}
+	return nil
+}
+
+func (device *u2fDevice) readMessage(deadline time.Time) (byte, []byte, error) {
+	for {
+		frame, err := device.readFrame(deadline)
+		if err != nil {
+			return 0, nil, err
+		}
+		if binary.BigEndian.Uint32(frame[0:4]) != device.cid {
+			continue
+		}
+		command := frame[4]
+		if command&0x80 == 0 {
+			return 0, nil, fmt.Errorf("unexpected U2F HID continuation frame %d", command)
+		}
+		length := int(binary.BigEndian.Uint16(frame[5:7]))
+		payload := make([]byte, length)
+		firstLength := length
+		if firstLength > u2fInitialPayload {
+			firstLength = u2fInitialPayload
+		}
+		copy(payload, frame[7:7+firstLength])
+		offset := firstLength
+		for sequence := byte(0); offset < length; sequence++ {
+			frame, err = device.readFrame(deadline)
+			if err != nil {
+				return 0, nil, err
+			}
+			if binary.BigEndian.Uint32(frame[0:4]) != device.cid {
+				return 0, nil, errors.New("U2F HID continuation channel mismatch")
+			}
+			if frame[4] != sequence {
+				return 0, nil, fmt.Errorf("U2F HID continuation sequence %d does not match expected %d", frame[4], sequence)
+			}
+			count := length - offset
+			if count > u2fNextPayload {
+				count = u2fNextPayload
+			}
+			copy(payload[offset:], frame[5:5+count])
+			offset += count
+			if sequence == 0x7f && offset < length {
+				return 0, nil, errors.New("U2F HID response continuation sequence exhausted")
+			}
+		}
+		return command, payload, nil
+	}
+}
+
+func (device *u2fDevice) writeFrame(frame [u2fFrameSize]byte, deadline time.Time) error {
+	if err := u2fWait(device.file, true, deadline); err != nil {
+		return err
+	}
+	written, err := device.file.Write(frame[:])
+	if err != nil {
+		return fmt.Errorf("write U2F HID frame: %w", err)
+	}
+	if written != u2fFrameSize {
+		return fmt.Errorf("write U2F HID frame: %w", io.ErrShortWrite)
+	}
+	return nil
+}
+
+func (device *u2fDevice) readFrame(deadline time.Time) ([u2fFrameSize]byte, error) {
+	var frame [u2fFrameSize]byte
+	if err := u2fWait(device.file, false, deadline); err != nil {
+		return frame, err
+	}
+	read, err := device.file.Read(frame[:])
+	if err != nil {
+		return frame, fmt.Errorf("read U2F HID frame: %w", err)
+	}
+	if read != u2fFrameSize {
+		return frame, fmt.Errorf("read U2F HID frame of %d bytes, expected %d", read, u2fFrameSize)
+	}
+	return frame, nil
+}
+
+func u2fWait(file *os.File, write bool, deadline time.Time) error {
+	fd := int(file.Fd())
+	if fd < 0 || fd >= 1024 {
+		return fmt.Errorf("U2F HID file descriptor %d is outside select range", fd)
+	}
+	for {
+		remaining := time.Until(deadline)
+		if remaining <= 0 {
+			return os.ErrDeadlineExceeded
+		}
+		var readSet, writeSet syscall.FdSet
+		set := &readSet
+		if write {
+			set = &writeSet
+		}
+		set.Bits[fd/64] |= 1 << uint(fd%64)
+		timeout := syscall.NsecToTimeval(remaining.Nanoseconds())
+		ready, err := syscall.Select(fd+1, &readSet, &writeSet, nil, &timeout)
+		if errors.Is(err, syscall.EINTR) {
+			continue
+		}
+		if err != nil {
+			return fmt.Errorf("select U2F HID device: %w", err)
+		}
+		if ready == 0 {
+			return os.ErrDeadlineExceeded
+		}
+		return nil
+	}
+}
+
+func u2fRegister(device *u2fDevice, challenge, application []byte) (*u2fRegistration, error) {
+	data := make([]byte, 0, 64)
+	data = append(data, challenge...)
+	data = append(data, application...)
+	payload, err := device.transact(u2fHIDMSG, u2fAPDU(0x01, 0x00, data), 2*time.Minute)
+	if err != nil {
+		return nil, fmt.Errorf("U2F_REGISTER: %w", err)
+	}
+	response, err := u2fAPDUResponse(payload)
+	if err != nil {
+		return nil, fmt.Errorf("U2F_REGISTER: %w", err)
+	}
+	if len(response) < 67 || response[0] != 0x05 {
+		return nil, errors.New("U2F_REGISTER returned an invalid response header")
+	}
+	publicKeyBytes := response[1:66]
+	if len(publicKeyBytes) != 65 || publicKeyBytes[0] != 0x04 {
+		return nil, errors.New("U2F_REGISTER returned an invalid SEC1 public key")
+	}
+	keyHandleLength := int(response[66])
+	if keyHandleLength == 0 || len(response) < 67+keyHandleLength {
+		return nil, errors.New("U2F_REGISTER returned an invalid key handle length")
+	}
+	keyHandle := response[67 : 67+keyHandleLength]
+	certificateAndSignature := response[67+keyHandleLength:]
+	var certificateValue asn1.RawValue
+	signature, err := asn1.Unmarshal(certificateAndSignature, &certificateValue)
+	if err != nil || len(certificateValue.FullBytes) == 0 {
+		return nil, errors.New("U2F_REGISTER returned an invalid DER certificate")
+	}
+	certificate := certificateValue.FullBytes
+	if _, err := x509.ParseCertificate(certificate); err != nil {
+		return nil, fmt.Errorf("parse U2F_REGISTER DER certificate: %w", err)
+	}
+	if err := u2fValidateSignature(signature); err != nil {
+		return nil, fmt.Errorf("U2F_REGISTER returned an invalid DER signature: %w", err)
+	}
+	x, y := elliptic.Unmarshal(elliptic.P256(), publicKeyBytes)
+	if x == nil {
+		return nil, errors.New("U2F_REGISTER public key is not on P-256")
+	}
+	publicKeyDER, err := x509.MarshalPKIXPublicKey(&ecdsa.PublicKey{Curve: elliptic.P256(), X: x, Y: y})
+	if err != nil {
+		return nil, fmt.Errorf("marshal U2F public key: %w", err)
+	}
+	publicKeyPEM := pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: publicKeyDER})
+	if len(publicKeyPEM) == 0 {
+		return nil, errors.New("encode U2F public key PEM")
+	}
+	return &u2fRegistration{
+		KeyHandle:             base64.RawURLEncoding.EncodeToString(keyHandle),
+		PublicKey:             string(publicKeyPEM),
+		Certificate:           base64.RawURLEncoding.EncodeToString(certificate),
+		RegistrationChallenge: base64.RawURLEncoding.EncodeToString(challenge),
+		RegistrationSignature: base64.RawURLEncoding.EncodeToString(signature),
+	}, nil
+}
+
+func u2fAuthenticate(device *u2fDevice, challenge, application, keyHandle []byte) ([]byte, uint32, error) {
+	if len(keyHandle) == 0 || len(keyHandle) > 255 {
+		return nil, 0, fmt.Errorf("U2F key handle length %d is invalid", len(keyHandle))
+	}
+	data := make([]byte, 0, 65+len(keyHandle))
+	data = append(data, challenge...)
+	data = append(data, application...)
+	data = append(data, byte(len(keyHandle)))
+	data = append(data, keyHandle...)
+	payload, err := device.transact(u2fHIDMSG, u2fAPDU(0x02, 0x03, data), 2*time.Minute)
+	if err != nil {
+		return nil, 0, fmt.Errorf("U2F_AUTHENTICATE: %w", err)
+	}
+	response, err := u2fAPDUResponse(payload)
+	if err != nil {
+		return nil, 0, fmt.Errorf("U2F_AUTHENTICATE: %w", err)
+	}
+	if len(response) < 7 {
+		return nil, 0, errors.New("U2F_AUTHENTICATE returned a short response")
+	}
+	if response[0]&0x01 == 0 {
+		return nil, 0, errors.New("U2F_AUTHENTICATE did not confirm user presence")
+	}
+	if err := u2fValidateSignature(response[5:]); err != nil {
+		return nil, 0, fmt.Errorf("U2F_AUTHENTICATE returned an invalid DER signature: %w", err)
+	}
+	return response[5:], binary.BigEndian.Uint32(response[1:5]), nil
+}
+
+func u2fAPDU(instruction, control byte, data []byte) []byte {
+	if len(data) > 0xffff {
+		return nil
+	}
+	request := make([]byte, 7, 9+len(data))
+	request[1] = instruction
+	request[2] = control
+	binary.BigEndian.PutUint16(request[5:7], uint16(len(data)))
+	request = append(request, data...)
+	request = append(request, 0, 0)
+	return request
+}
+
+func u2fAPDUResponse(response []byte) ([]byte, error) {
+	if len(response) < 2 {
+		return nil, errors.New("short APDU response")
+	}
+	status := binary.BigEndian.Uint16(response[len(response)-2:])
+	if status != 0x9000 {
+		return nil, fmt.Errorf("APDU status 0x%04x", status)
+	}
+	return response[:len(response)-2], nil
+}
+
+func u2fValidateSignature(encoded []byte) error {
+	var signature struct {
+		R *big.Int
+		S *big.Int
+	}
+	rest, err := asn1.Unmarshal(encoded, &signature)
+	if err != nil {
+		return err
+	}
+	if len(rest) != 0 || signature.R == nil || signature.S == nil || signature.R.Sign() <= 0 || signature.S.Sign() <= 0 {
+		return errors.New("invalid ECDSA signature")
+	}
+	return nil
+}
+
+func u2fReadCache() (map[string]u2fRegistration, error) {
+	cache := make(map[string]u2fRegistration)
+	encoded, err := os.ReadFile(u2fCachePath)
+	if errors.Is(err, os.ErrNotExist) {
+		return cache, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("read U2F registration cache: %w", err)
+	}
+	if err := json.Unmarshal(encoded, &cache); err != nil {
+		return make(map[string]u2fRegistration), nil
+	}
+	return cache, nil
+}
+
+func u2fReadRegistration(application []byte) (*u2fRegistration, error) {
+	cache, err := u2fReadCache()
+	if err != nil {
+		return nil, err
+	}
+	registration, ok := cache[hex.EncodeToString(application)]
+	if !ok {
+		return nil, nil
+	}
+	keyHandle, err := base64.RawURLEncoding.DecodeString(registration.KeyHandle)
+	if err != nil || len(keyHandle) == 0 || len(keyHandle) > 255 {
+		return nil, errors.New("U2F registration cache contains an invalid key handle")
+	}
+	registrationChallenge, err := base64.RawURLEncoding.DecodeString(registration.RegistrationChallenge)
+	if err != nil || len(registrationChallenge) != 32 {
+		return nil, errors.New("U2F registration cache contains an invalid registration challenge")
+	}
+	registrationSignature, err := base64.RawURLEncoding.DecodeString(registration.RegistrationSignature)
+	if err != nil || u2fValidateSignature(registrationSignature) != nil {
+		return nil, errors.New("U2F registration cache contains an invalid registration signature")
+	}
+	certificate, err := base64.RawURLEncoding.DecodeString(registration.Certificate)
+	if err != nil {
+		return nil, errors.New("U2F registration cache contains an invalid certificate encoding")
+	}
+	if _, err := x509.ParseCertificate(certificate); err != nil {
+		return nil, fmt.Errorf("U2F registration cache contains an invalid certificate: %w", err)
+	}
+	block, rest := pem.Decode([]byte(registration.PublicKey))
+	if block == nil || block.Type != "PUBLIC KEY" || len(rest) != 0 {
+		return nil, errors.New("U2F registration cache contains an invalid public key PEM")
+	}
+	publicKey, err := x509.ParsePKIXPublicKey(block.Bytes)
+	if err != nil {
+		return nil, fmt.Errorf("U2F registration cache contains an invalid public key: %w", err)
+	}
+	ecdsaKey, ok := publicKey.(*ecdsa.PublicKey)
+	if !ok || ecdsaKey.Curve != elliptic.P256() {
+		return nil, errors.New("U2F registration cache public key is not P-256")
+	}
+	return &registration, nil
+}
+
+func u2fWriteRegistration(application []byte, registration *u2fRegistration) error {
+	cache, err := u2fReadCache()
+	if err != nil {
+		return err
+	}
+	cache[hex.EncodeToString(application)] = *registration
+	encoded, err := json.Marshal(cache)
+	if err != nil {
+		return fmt.Errorf("encode U2F registration cache: %w", err)
+	}
+	directory := filepath.Dir(u2fCachePath)
+	if err := os.MkdirAll(directory, 0o750); err != nil {
+		return fmt.Errorf("create U2F registration directory: %w", err)
+	}
+	file, err := os.CreateTemp(directory, ".fido2-")
+	if err != nil {
+		return fmt.Errorf("create U2F registration cache: %w", err)
+	}
+	path := file.Name()
+	defer os.Remove(path)
+	if err := file.Chmod(0o600); err != nil {
+		file.Close()
+		return fmt.Errorf("set U2F registration cache permissions: %w", err)
+	}
+	if _, err := file.Write(encoded); err != nil {
+		file.Close()
+		return fmt.Errorf("write U2F registration cache: %w", err)
+	}
+	if err := file.Sync(); err != nil {
+		file.Close()
+		return fmt.Errorf("sync U2F registration cache: %w", err)
+	}
+	if err := file.Close(); err != nil {
+		return fmt.Errorf("close U2F registration cache: %w", err)
+	}
+	if err := os.Rename(path, u2fCachePath); err != nil {
+		return fmt.Errorf("install U2F registration cache: %w", err)
+	}
+	return nil
+}
diff --git a/buildroot/k3/scripts/wallet-client.go b/buildroot/k3/scripts/wallet-client.go
new file mode 100644
index 0000000000000000000000000000000000000000..4fc54fd1a07188dabf29b2382949dc50fc1930cc
--- /dev/null
+++ b/buildroot/k3/scripts/wallet-client.go
@@ -0,0 +1,403 @@
+package main
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/exec"
+	"strings"
+	"time"
+)
+
+type contract struct {
+	ID              string `json:"id"`
+	Tier            int    `json:"tier"`
+	Title           string `json:"title"`
+	Body            string `json:"body"`
+	AmountCents     int64  `json:"amountCents"`
+	DailyLimitCents int64  `json:"dailyLimitCents"`
+}
+
+type challenge struct {
+	Nonce     string    `json:"nonce"`
+	ExpiresAt time.Time `json:"expiresAt"`
+}
+
+type evidence struct {
+	Report string `json:"report"`
+	Nonce  string `json:"nonce"`
+	Token  string `json:"token"`
+	PCR11  string `json:"pcr11"`
+}
+
+type signRequest struct {
+	ContractID   string    `json:"contractId"`
+	Consent      string    `json:"consent"`
+	Approved     bool      `json:"approved"`
+	Nonce        string    `json:"nonce"`
+	ConsentProof string    `json:"consentProof"`
+	Signature    string    `json:"signature"`
+	Evidence     *evidence `json:"evidence,omitempty"`
+	Device       string    `json:"device"`
+}
+
+type consentMessage struct {
+	Nonce          string `json:"nonce"`
+	ContractID     string `json:"contractId"`
+	ContractSHA256 string `json:"contractSha256"`
+	Method         string `json:"method"`
+}
+
+type signatureMessage struct {
+	Nonce            string `json:"nonce"`
+	ContractID       string `json:"contractId"`
+	ContractSHA256   string `json:"contractSha256"`
+	ConsentMethod    string `json:"consentMethod"`
+	ConsentProof     string `json:"consentProof"`
+	AttestationNonce string `json:"attestationNonce"`
+	AttestationToken string `json:"attestationToken"`
+	ReportSHA256     string `json:"reportSha256"`
+	PCR11            string `json:"pcr11"`
+}
+
+func postJSON(client *http.Client, url string, input any) ([]byte, int, error) {
+	body, err := json.Marshal(input)
+	if err != nil {
+		return nil, 0, err
+	}
+	request, err := http.NewRequest(http.MethodPost, url, bytes.NewReader(body))
+	if err != nil {
+		return nil, 0, err
+	}
+	request.Header.Set("Content-Type", "application/json")
+	response, err := client.Do(request)
+	if err != nil {
+		return nil, 0, err
+	}
+	defer response.Body.Close()
+	result, err := io.ReadAll(response.Body)
+	return result, response.StatusCode, err
+}
+
+func getJSON(client *http.Client, url string, output any) error {
+	response, err := client.Get(url)
+	if err != nil {
+		return err
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		return fmt.Errorf("request failed with %s", response.Status)
+	}
+	return json.NewDecoder(response.Body).Decode(output)
+}
+
+func signTPM(message []byte) (string, error) {
+	input, err := os.CreateTemp("", "wallet-message-")
+	if err != nil {
+		return "", err
+	}
+	path := input.Name()
+	defer os.Remove(path)
+	if _, err := input.Write(message); err != nil {
+		input.Close()
+		return "", err
+	}
+	if err := input.Close(); err != nil {
+		return "", err
+	}
+	handle, err := os.ReadFile("/var/lib/systemd/report.sign.tpm2/default.key")
+	if err != nil || len(handle) == 0 {
+		if result, provisionErr := exec.Command("/usr/libexec/rva23-report-provision").CombinedOutput(); provisionErr != nil {
+			return "", fmt.Errorf("provision TPM AK: %s", result)
+		}
+		handle, err = os.ReadFile("/var/lib/systemd/report.sign.tpm2/default.key")
+	}
+	if err != nil {
+		return "", err
+	}
+	var keyData struct {
+		Handle string `json:"handle"`
+	}
+	if err := json.Unmarshal(handle, &keyData); err != nil {
+		return "", err
+	}
+	serialized, err := base64.StdEncoding.DecodeString(keyData.Handle)
+	if err != nil || len(serialized) < 4 {
+		return "", errors.New("invalid persistent AK handle")
+	}
+	handleID := fmt.Sprintf("0x%08x", binary.BigEndian.Uint32(serialized[:4]))
+	output, err := os.CreateTemp("", "wallet-signature-")
+	if err != nil {
+		return "", err
+	}
+	signaturePath := output.Name()
+	output.Close()
+	defer os.Remove(signaturePath)
+	command := exec.Command("tpm2_sign", "-c", handleID, "-g", "sha256", "-s", "rsassa", "-o", signaturePath, path)
+	if result, err := command.CombinedOutput(); err != nil {
+		return "", fmt.Errorf("tpm2_sign: %s", result)
+	}
+	signature, err := os.ReadFile(signaturePath)
+	if err != nil {
+		return "", err
+	}
+	if len(signature) < 256 {
+		return "", errors.New("short TPM signature")
+	}
+	return base64.RawURLEncoding.EncodeToString(signature[len(signature)-256:]), nil
+}
+
+func signSmartcard(message []byte) (string, error) {
+	input, err := os.CreateTemp("", "smartcard-message-")
+	if err != nil {
+		return "", err
+	}
+	path := input.Name()
+	defer os.Remove(path)
+	if _, err := input.Write(message); err != nil {
+		input.Close()
+		return "", err
+	}
+	if err := input.Close(); err != nil {
+		return "", err
+	}
+	output, err := os.CreateTemp("", "smartcard-signature-")
+	if err != nil {
+		return "", err
+	}
+	signaturePath := output.Name()
+	output.Close()
+	defer os.Remove(signaturePath)
+	if result, err := exec.Command("systemctl", "restart", "pcscd").CombinedOutput(); err != nil {
+		return "", fmt.Errorf("start pcscd: %s", result)
+	}
+	command := exec.Command("smartcard-sign", path, signaturePath)
+	if result, err := command.CombinedOutput(); err != nil {
+		return "", fmt.Errorf("smartcard-sign: %s", result)
+	}
+	signature, err := os.ReadFile(signaturePath)
+	if err != nil {
+		return "", err
+	}
+	return base64.RawURLEncoding.EncodeToString(signature), nil
+}
+
+func attest() (*evidence, error) {
+	if result, err := exec.Command("systemctl", "start", "systemd-pcrlock.socket").CombinedOutput(); err != nil {
+		return nil, fmt.Errorf("systemd-pcrlock.socket: %s", result)
+	}
+	if result, err := exec.Command("systemctl", "restart", "systemd-report-sign-tpm2.socket").CombinedOutput(); err != nil {
+		return nil, fmt.Errorf("systemd-report-sign-tpm2.socket: %s", result)
+	}
+	command := exec.Command("attested-client")
+	command.Env = append(os.Environ(), "RVA23_ATTESTATION_CAPTURE=1")
+	if result, err := command.CombinedOutput(); err != nil {
+		return nil, fmt.Errorf("attested-client: %s", result)
+	}
+	report, err := os.ReadFile("/tmp/rva23-attested-body")
+	if err != nil {
+		return nil, err
+	}
+	nonce, err := os.ReadFile("/tmp/rva23-attested-nonce")
+	if err != nil {
+		return nil, err
+	}
+	token, err := os.ReadFile("/tmp/rva23-attested-token")
+	if err != nil {
+		return nil, err
+	}
+	if result, err := exec.Command("tpm2_pcrread", "sha256:11", "-o", "/tmp/rva23-pcr11.bin").CombinedOutput(); err != nil {
+		return nil, fmt.Errorf("tpm2_pcrread: %s", result)
+	}
+	pcr11, err := os.ReadFile("/tmp/rva23-pcr11.bin")
+	if err != nil {
+		return nil, err
+	}
+	return &evidence{
+		Report: base64.RawURLEncoding.EncodeToString(report),
+		Nonce:  strings.TrimSpace(string(nonce)),
+		Token:  strings.TrimSpace(string(token)),
+		PCR11:  hex.EncodeToString(pcr11),
+	}, nil
+}
+
+func run() error {
+	baseURL := os.Getenv("RVA23_WALLET_URL")
+	if baseURL == "" {
+		baseURL = "http://10.0.2.2:8081"
+	}
+	client := &http.Client{Timeout: 120 * time.Second}
+	if len(os.Args) > 1 && os.Args[1] == "--replay" {
+		body, err := os.ReadFile("/tmp/rva23-wallet-request.json")
+		if err != nil {
+			return err
+		}
+		request, err := http.NewRequest(http.MethodPost, baseURL+"/v1/sign", bytes.NewReader(body))
+		if err != nil {
+			return err
+		}
+		request.Header.Set("Content-Type", "application/json")
+		response, err := client.Do(request)
+		if err != nil {
+			return err
+		}
+		defer response.Body.Close()
+		result, err := io.ReadAll(response.Body)
+		if err != nil {
+			return err
+		}
+		fmt.Println(string(result))
+		if response.StatusCode < 200 || response.StatusCode >= 300 {
+			return fmt.Errorf("wallet signing failed with %s", response.Status)
+		}
+		return nil
+	}
+	var contractID, consent string
+	approved := false
+	for _, argument := range os.Args[1:] {
+		switch {
+		case strings.HasPrefix(argument, "--contract="):
+			contractID = strings.TrimPrefix(argument, "--contract=")
+		case strings.HasPrefix(argument, "--consent="):
+			consent = strings.TrimPrefix(argument, "--consent=")
+		case argument == "--approve":
+			approved = true
+		}
+	}
+	if contractID == "" || consent == "" || !approved {
+		return errors.New("use --contract=ID --consent=host|smartcard|fido2 --approve")
+	}
+	var contracts []contract
+	if err := getJSON(client, baseURL+"/v1/contracts", &contracts); err != nil {
+		return fmt.Errorf("contracts: %w", err)
+	}
+	var selected *contract
+	for index := range contracts {
+		if contracts[index].ID == contractID {
+			selected = &contracts[index]
+			break
+		}
+	}
+	if selected == nil {
+		return errors.New("unknown contract")
+	}
+	var currentChallenge challenge
+	if err := getJSON(client, baseURL+"/v1/challenge", &currentChallenge); err != nil {
+		return fmt.Errorf("challenge: %w", err)
+	}
+	contractBytes, err := json.Marshal(selected)
+	if err != nil {
+		return err
+	}
+	contractDigest := fmt.Sprintf("%x", sha256Sum(contractBytes))
+	consentProof := ""
+	if consent == "fido2" {
+		nonceBytes, err := base64.RawURLEncoding.DecodeString(currentChallenge.Nonce)
+		if err != nil {
+			return err
+		}
+		application, err := hex.DecodeString(contractDigest)
+		if err != nil {
+			return err
+		}
+		proof, err := Fido2Consent(nonceBytes, application)
+		if err != nil {
+			return fmt.Errorf("fido2 consent: %w", err)
+		}
+		encoded, err := json.Marshal(proof)
+		if err != nil {
+			return err
+		}
+		consentProof = base64.RawURLEncoding.EncodeToString(encoded)
+	} else if consent == "smartcard" {
+		message := consentMessage{Nonce: currentChallenge.Nonce, ContractID: selected.ID, ContractSHA256: contractDigest, Method: consent}
+		encoded, err := json.Marshal(message)
+		if err != nil {
+			return err
+		}
+		consentProof, err = signSmartcard(encoded)
+		if err != nil {
+			return err
+		}
+	}
+	var currentEvidence *evidence
+	if selected.Tier == 1 || (selected.Tier == 2 && consent == "host") {
+		currentEvidence, err = attest()
+		if err != nil {
+			return fmt.Errorf("attestation: %w", err)
+		}
+	}
+	reportDigest := ""
+	attestationNonce := ""
+	attestationToken := ""
+	pcr11Value := ""
+	if currentEvidence != nil {
+		reportBytes, err := base64.RawURLEncoding.DecodeString(currentEvidence.Report)
+		if err != nil {
+			return err
+		}
+		reportDigest = fmt.Sprintf("%x", sha256Sum(reportBytes))
+		attestationNonce = currentEvidence.Nonce
+		attestationToken = currentEvidence.Token
+		pcr11Value = currentEvidence.PCR11
+	}
+	message := signatureMessage{
+		Nonce: currentChallenge.Nonce, ContractID: selected.ID, ContractSHA256: contractDigest,
+		ConsentMethod: consent, ConsentProof: consentProof,
+		AttestationNonce: attestationNonce, AttestationToken: attestationToken, ReportSHA256: reportDigest,
+		PCR11: pcr11Value,
+	}
+	messageBytes, err := json.Marshal(message)
+	if err != nil {
+		return err
+	}
+	signature, err := signTPM(messageBytes)
+	if err != nil {
+		return fmt.Errorf("TPM signature: %w", err)
+	}
+	device := map[string]string{"host": "trusted-host-os", "smartcard": "qemu-ccid-card-emulated", "fido2": "qemu-u2f-emulated"}[consent]
+	if selected.Tier == 0 {
+		device = "tpm-resident-ak"
+	}
+	requestBody := signRequest{
+		ContractID: selected.ID, Consent: consent, Approved: approved, Nonce: currentChallenge.Nonce,
+		ConsentProof: consentProof, Signature: signature, Evidence: currentEvidence,
+		Device: device,
+	}
+	encodedRequest, err := json.Marshal(requestBody)
+	if err != nil {
+		return err
+	}
+	if err := os.WriteFile("/tmp/rva23-wallet-request.json", encodedRequest, 0o600); err != nil {
+		return err
+	}
+	var request any = requestBody
+	result, status, err := postJSON(client, baseURL+"/v1/sign", &request)
+	if err != nil {
+		return fmt.Errorf("sign request: %w", err)
+	}
+	fmt.Println(string(result))
+	if status < 200 || status >= 300 {
+		return fmt.Errorf("wallet signing failed with %d", status)
+	}
+	return nil
+}
+
+func sha256Sum(data []byte) [32]byte {
+	return sha256.Sum256(data)
+}
+
+func main() {
+	if err := run(); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
