diff --git a/buildroot/k3/package/edk2-spacemit/edk2-spacemit.mk b/buildroot/k3/package/edk2-spacemit/edk2-spacemit.mk
new file mode 100644
index 0000000000000000000000000000000000000000..06679c675cfcd90b5080d391e0ebfe809c4b2c2f
--- /dev/null
+++ b/buildroot/k3/package/edk2-spacemit/edk2-spacemit.mk
@@ -0,0 +1,45 @@
+EDK2_SPACEMIT_VERSION = c3ce74162ebeb2c3dbcaf2f430f4b9a00626d271
+EDK2_SPACEMIT_SITE = https://github.com/vhaudiquet/deb-edk2-spacemit.git
+EDK2_SPACEMIT_SITE_METHOD = git
+EDK2_SPACEMIT_LICENSE = BSD-2-Clause-Patent
+EDK2_SPACEMIT_LICENSE_FILES = edk2/License.txt edk2-platforms/License.txt
+EDK2_SPACEMIT_DEPENDENCIES = host-python3 host-uboot-tools host-dtc host-util-linux
+EDK2_SPACEMIT_INSTALL_TARGET = NO
+EDK2_SPACEMIT_INSTALL_IMAGES = YES
+
+define EDK2_SPACEMIT_APPLY_PATCHES
+	@for f in $(BR2_EXTERNAL_K3_PATH)/package/edk2-spacemit/*.patch; do \
+		[ -f "$$f" ] || continue; \
+		if patch -p1 -N --dry-run -d $(@D) < "$$f" >/dev/null 2>&1; then \
+			patch -p1 -N -d $(@D) < "$$f" || exit 1; \
+		fi; \
+	done
+endef
+EDK2_SPACEMIT_POST_RSYNC_HOOKS += EDK2_SPACEMIT_APPLY_PATCHES
+
+EDK2_SPACEMIT_BUILD_ENV = \
+	MAKEFLAGS= \
+	WORKSPACE=$(@D) \
+	PACKAGES_PATH=$(@D)/edk2:$(@D)/edk2-platforms \
+	PYTHON_COMMAND=$(HOST_DIR)/bin/python3 \
+	PATH=$(HOST_DIR)/bin:$(HOST_DIR)/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin \
+	GCC5_RISCV64_PREFIX=$(HOST_DIR)/bin/riscv64-buildroot-linux-gnu-
+
+EDK2_SPACEMIT_BASETOOLS_OPTS = \
+	EXTRA_OPTFLAGS="-I$(HOST_DIR)/include -Wno-error" \
+	EXTRA_LDFLAGS="-L$(HOST_DIR)/lib -Wl,-rpath,$(HOST_DIR)/lib"
+
+define EDK2_SPACEMIT_BUILD_CMDS
+	export $(EDK2_SPACEMIT_BUILD_ENV) && \
+	unset ARCH && \
+	source $(@D)/edk2/edksetup.sh && \
+	$(MAKE1) -C $(@D)/edk2/BaseTools -j$(PARALLEL_JOBS) $(EDK2_SPACEMIT_BASETOOLS_OPTS) && \
+	build -a RISCV64 -p Platform/Spacemit/K3/MUSE-Pico/MUSE-Pico.dsc \
+		-t GCC5 -b RELEASE -n 4
+endef
+
+define EDK2_SPACEMIT_INSTALL_IMAGES_CMDS
+	$(INSTALL) -D -m 0644 $(@D)/fitimage/MUSE-Pico/MUSE-Pico.itb $(BINARIES_DIR)/edk2.itb
+endef
+
+$(eval $(generic-package))
