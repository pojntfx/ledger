+func (fixture *mutualTestFixture) binding(t *testing.T, sessionID string, counter uint64) migration.OperationBinding {
+	t.Helper()
+	role := migration.RoleSource
+	if counter >= 3 {
+		role = migration.RoleDestination
+	}
+	operation, err := migration.ExpectedOperation(role, counter)
+	if err != nil {
+		t.Fatal(err)
+	}
+	binding := migration.OperationBinding{
+		SessionID:  sessionID,
+		Role:       role,
+		Operation:  operation,
+		InstanceID: fixture.instanceID,
+		PID:        4242,
+		Counter:    counter,
+	}
+	if migration.RequiresCheckpoint(operation) {
+		binding.CheckpointSHA256 = fixture.digest
+		binding.CheckpointSize = int64(len(fixture.archive))
+	}
+	return binding
+}
+
+func (fixture *mutualTestFixture) issueChallenge(t *testing.T, binding migration.OperationBinding) migration.MutualChallengeResponse {
+	t.Helper()
+	status, body := fixture.doJSON(t, http.MethodPost, "/v1/mutual/challenges", migration.MutualChallengeRequest{Binding: binding})
+	requireMutualStatus(t, status, http.StatusOK, body)
+	var response migration.MutualChallengeResponse
+	if err := json.Unmarshal(body, &response); err != nil {
+		t.Fatal(err)
+	}
+	if response.Binding != binding {
+		t.Fatalf("challenge binding %+v differs from request %+v", response.Binding, binding)
+	}
+	if response.ServerNonce == "" || response.ClientNonce == "" || response.ServerNonce == response.ClientNonce {
+		t.Fatal("challenge did not contain distinct server and client nonces")
+	}
+	if response.ServerEvidence.Nonce != response.ServerNonce || response.ServerEvidence.PCR11 != fixture.server.productionPCR11 {
+		t.Fatal("challenge returned unexpected deterministic evidence")
+	}
+	if !response.ExpiresAt.Equal(fixture.now.Add(migration.MutualChallengeLifetime)) {
+		t.Fatalf("challenge expires at %s", response.ExpiresAt)
+	}
+	message, err := migration.MutualServerMessage(response)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := migration.VerifyAKSignature(&fixture.serverAK.private.PublicKey, message, response.ServerSignature); err != nil {
+		t.Fatalf("server challenge signature is invalid: %v", err)
+	}
+	return response
+}
