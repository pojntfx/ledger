diff --git a/buildroot/k3/board/spacemit/k3-uefi/patches/linux/0002-Remove-EFI-stub-debug-sections.patch b/buildroot/k3/board/spacemit/k3-uefi/patches/linux/0002-Remove-EFI-stub-debug-sections.patch
