index 0000000000000000000000000000000000000000..142fd916ea7074148d6abb9d35bc022d72db103e
--- /dev/null
+++ b/buildroot/k3/board/spacemit/k3-uefi/patches/linux/0002-Remove-EFI-stub-debug-sections.patch
@@ -0,0 +1,11 @@
+--- a/drivers/firmware/efi/libstub/Makefile
++++ b/drivers/firmware/efi/libstub/Makefile
+@@ -164,7 +164,7 @@ $(obj)/%.stub.o: $(obj)/%.o FORCE
+ #
+ quiet_cmd_stubcopy = STUBCPY $@
+       cmd_stubcopy =							\
+-	$(STRIP) --strip-debug -o $@ $<;				\
++	$(OBJCOPY) --remove-section=.debug\* $< $@;			\
+ 	if $(OBJDUMP) -r $@ | grep $(STUBCOPY_RELOC-y); then		\
+ 		echo "$@: absolute symbol references not allowed in the EFI stub" >&2; \
+ 		/bin/false;						\
