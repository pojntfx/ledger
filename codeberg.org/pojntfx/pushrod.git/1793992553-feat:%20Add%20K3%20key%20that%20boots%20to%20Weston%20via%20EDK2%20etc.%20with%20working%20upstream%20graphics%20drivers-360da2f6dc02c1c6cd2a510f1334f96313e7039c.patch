+type mutualTestAK struct {
+	private *rsa.PrivateKey
+}
+
+func newMutualTestAK(t *testing.T) *mutualTestAK {
+	t.Helper()
+	private, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &mutualTestAK{private: private}
+}
+
+func (key *mutualTestAK) sign(message []byte) (string, error) {
+	digest := sha256.Sum256(message)
+	signature, err := rsa.SignPKCS1v15(rand.Reader, key.private, crypto.SHA256, digest[:])
+	if err != nil {
+		return "", err
+	}
+	return base64.RawURLEncoding.EncodeToString(signature), nil
+}
+
+func (key *mutualTestAK) signForTest(t *testing.T, message []byte) string {
+	t.Helper()
+	signature, err := key.sign(message)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return signature
+}
