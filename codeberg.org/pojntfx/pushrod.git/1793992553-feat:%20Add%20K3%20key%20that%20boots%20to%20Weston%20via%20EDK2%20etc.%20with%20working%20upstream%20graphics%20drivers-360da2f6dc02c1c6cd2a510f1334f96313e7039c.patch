-+static void skip_oneline_comment(char **input)
-+{
-+    *input += static_strlen("//");
-+
-+    for (; (*input)[0] != '\0'; ++(*input))
-+    {
-+        if ((*input)[0] == '\n') {
-+            *input += static_strlen("\n");
-+            return;
-+        }
-+    }
-+}
-+
-+static void skip_multiline_comment(char **input)
-+{
-+    *input += static_strlen("/*");
-+
-+    for (; (*input)[0] != '\0'; ++(*input))
-+    {
-+        if (((*input)[0] == '*') && ((*input)[1] == '/'))
-+        {
-+            *input += static_strlen("*/");
-+            return;
-+        }
-+    }
-+}
-+
-+static void minify_string(char **input, char **output) {
-+    (*output)[0] = (*input)[0];
-+    *input += static_strlen("\"");
-+    *output += static_strlen("\"");
-+
-+
-+    for (; (*input)[0] != '\0'; (void)++(*input), ++(*output)) {
-+        (*output)[0] = (*input)[0];
-+
-+        if ((*input)[0] == '\"') {
-+            (*output)[0] = '\"';
-+            *input += static_strlen("\"");
-+            *output += static_strlen("\"");
-+            return;
-+        } else if (((*input)[0] == '\\') && ((*input)[1] == '\"')) {
-+            (*output)[1] = (*input)[1];
-+            *input += static_strlen("\"");
-+            *output += static_strlen("\"");
-+        }
-+    }
-+}
