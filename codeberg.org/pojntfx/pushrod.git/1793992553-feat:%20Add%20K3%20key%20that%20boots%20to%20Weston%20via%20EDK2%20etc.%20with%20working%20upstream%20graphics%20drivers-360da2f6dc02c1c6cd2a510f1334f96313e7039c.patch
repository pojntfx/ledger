+package main
+
+import (
+	"path/filepath"
+	"testing"
+)
+
+func TestStatePreservesIdentityAcrossRestore(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "state.json")
+	state, err := loadClientState(path, 4242)
+	if err != nil {
+		t.Fatal(err)
+	}
+	client := &migrationClient{statePath: path, state: state}
+	counter, err := client.nextCounter()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if counter != 1 {
+		t.Fatalf("first counter was %d", counter)
+	}
+	restored, err := loadClientState(path, 4242)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if restored.InstanceID != state.InstanceID || restored.PID != state.PID || restored.Counter != 1 {
+		t.Fatalf("restored state %+v differs from saved state %+v", restored, state)
+	}
+	helper, err := loadClientState(path, 4243)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if helper.PID != state.PID || helper.InstanceID != state.InstanceID || helper.Counter != 1 {
+		t.Fatal("helper process changed the saved workload identity")
+	}
+}
diff --git a/buildroot/k3/scripts/migration/cmd/migration-server/migration-server.go b/buildroot/k3/scripts/migration/cmd/migration-server/migration-server.go
new file mode 100644
index 0000000000000000000000000000000000000000..b550771602d76ebe087bab30482429b0aa07ec44
--- /dev/null
+++ b/buildroot/k3/scripts/migration/cmd/migration-server/migration-server.go
@@ -0,0 +1,741 @@
+package main
+
+import (
+	"bytes"
+	"crypto"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"encoding/pem"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	migration "rva23/scripts/migration"
+)
+
+const (
+	maxAttestationBody = 12 * 1024 * 1024
+	maxReportBytes     = 8 * 1024 * 1024
+	maxResponseBytes   = 64 * 1024
+	maxCheckpoints     = 16
+	maxNonces          = 1024
+	nonceLifetime      = time.Minute
+)
+
+type challengeRecord struct {
+	InstanceID string
+	Phase      string
+	ExpiresAt  time.Time
+}
+
+type requestRecord struct {
+	At            time.Time                          `json:"at"`
+	Operation     string                             `json:"operation"`
+	BodyBase64    string                             `json:"bodyBase64,omitempty"`
+	Attestation   *migration.AttestationRequest      `json:"attestation,omitempty"`
+	Authorization *migration.CheckpointAuthorization `json:"authorization,omitempty"`
+	Validation    map[string]string                  `json:"validation"`
+	Checkpoint    *migration.CheckpointMetadata      `json:"checkpoint,omitempty"`
+	Response      any                                `json:"response,omitempty"`
+	Error         string                             `json:"error,omitempty"`
+}
+
+type stateResponse struct {
+	Latest  *requestRecord  `json:"latest"`
+	History []requestRecord `json:"history"`
+}
+
+type migrationServer struct {
+	keys            map[int]*rsa.PublicKey
+	keyFiles        map[int]string
+	quoteVerifier   func(userID int, nonce string, evidence migration.Evidence) error
+	productionPCR11 string
+	attestationURL  string
+	checkpointDir   string
+	client          *http.Client
+	maxCheckpoint   int64
+	now             func() time.Time
+	mutex           sync.Mutex
+	nonces          map[string]challengeRecord
+	counters        map[string]uint64
+	checkpoints     map[string]migration.CheckpointMetadata
+	stateMutex      sync.RWMutex
+	latest          *requestRecord
+	history         []requestRecord
+}
+
+func environment(name, fallback string) string {
+	if value := os.Getenv(name); value != "" {
+		return value
+	}
+	return fallback
+}
+
+func loadPublicKey(path string) (*rsa.PublicKey, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	block, rest := pem.Decode(data)
+	if block == nil || block.Type != "PUBLIC KEY" || len(rest) != 0 {
+		return nil, errors.New("invalid AK public key PEM")
+	}
+	parsed, err := x509.ParsePKIXPublicKey(block.Bytes)
+	if err != nil {
+		return nil, err
+	}
+	key, ok := parsed.(*rsa.PublicKey)
+	if !ok || key.N.BitLen() < 2048 {
+		return nil, errors.New("AK public key must be RSA with at least 2048 bits")
+	}
+	return key, nil
+}
+
+func writeJSON(writer http.ResponseWriter, status int, value any) {
+	writer.Header().Set("Content-Type", "application/json")
+	writer.WriteHeader(status)
+	_ = json.NewEncoder(writer).Encode(value)
+}
+
+func methodNotAllowed(writer http.ResponseWriter, method string) {
+	writer.Header().Set("Allow", method)
+	writeJSON(writer, http.StatusMethodNotAllowed, map[string]string{"error": "method not allowed"})
+}
+
+func decodeJSON(data []byte, output any) error {
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(output); err != nil {
+		return err
+	}
+	var extra any
+	if err := decoder.Decode(&extra); !errors.Is(err, io.EOF) {
+		return errors.New("request must contain one JSON value")
+	}
+	return nil
+}
+
+func (server *migrationServer) record(record requestRecord) {
+	server.stateMutex.Lock()
+	defer server.stateMutex.Unlock()
+	latest := record
+	server.latest = &latest
+	server.history = append([]requestRecord{record}, server.history...)
+	if len(server.history) > 32 {
+		server.history = server.history[:32]
+	}
+}
+
+func (server *migrationServer) reject(writer http.ResponseWriter, record requestRecord, status int, err error) {
+	record.Error = err.Error()
+	server.record(record)
+	writeJSON(writer, status, map[string]string{"error": err.Error()})
+}
+
+func (server *migrationServer) validNonce(nonce, instanceID, phase string) bool {
+	server.mutex.Lock()
+	defer server.mutex.Unlock()
+	challenge, ok := server.nonces[nonce]
+	return ok && challenge.InstanceID == instanceID && challenge.Phase == phase && server.now().Before(challenge.ExpiresAt)
+}
+
+func (server *migrationServer) consumeNonce(nonce, instanceID, phase string, counter uint64) error {
+	server.mutex.Lock()
+	defer server.mutex.Unlock()
+	challenge, ok := server.nonces[nonce]
+	if !ok || challenge.InstanceID != instanceID || challenge.Phase != phase || !server.now().Before(challenge.ExpiresAt) {
+		return errors.New("challenge nonce is expired, unknown, or already used")
+	}
+	if counter == 0 || counter <= server.counters[instanceID] {
+		return errors.New("migration counter must increase for the instance")
+	}
+	delete(server.nonces, nonce)
+	server.counters[instanceID] = counter
+	return nil
+}
+
+func (server *migrationServer) challengeHandler(writer http.ResponseWriter, request *http.Request) {
+	if request.Method != http.MethodPost {
+		methodNotAllowed(writer, http.MethodPost)
+		return
+	}
+	raw, err := io.ReadAll(http.MaxBytesReader(writer, request.Body, 4096))
+	if err != nil {
+		writeJSON(writer, http.StatusBadRequest, map[string]string{"error": "invalid challenge body"})
+		return
+	}
+	var input migration.ChallengeRequest
+	if err := decodeJSON(raw, &input); err != nil {
+		writeJSON(writer, http.StatusBadRequest, map[string]string{"error": "invalid challenge JSON"})
+		return
+	}
+	if err := migration.ValidateInstanceID(input.InstanceID); err != nil {
+		writeJSON(writer, http.StatusBadRequest, map[string]string{"error": err.Error()})
+		return
+	}
+	if err := migration.ValidatePhase(input.Phase); err != nil {
+		writeJSON(writer, http.StatusBadRequest, map[string]string{"error": err.Error()})
+		return
+	}
+	nonce := make([]byte, 32)
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		writeJSON(writer, http.StatusInternalServerError, map[string]string{"error": err.Error()})
+		return
+	}
+	now := server.now().UTC()
+	response := migration.ChallengeResponse{
+		Nonce:     base64.RawURLEncoding.EncodeToString(nonce),
+		ExpiresAt: now.Add(nonceLifetime),
+	}
+	server.mutex.Lock()
+	for value, challenge := range server.nonces {
+		if !now.Before(challenge.ExpiresAt) {
+			delete(server.nonces, value)
+		}
+	}
+	if len(server.nonces) >= maxNonces {
+		server.mutex.Unlock()
+		writeJSON(writer, http.StatusServiceUnavailable, map[string]string{"error": "too many outstanding challenges"})
+		return
+	}
+	server.nonces[response.Nonce] = challengeRecord{InstanceID: input.InstanceID, Phase: input.Phase, ExpiresAt: response.ExpiresAt}
+	server.mutex.Unlock()
+	writeJSON(writer, http.StatusOK, response)
+}
+
+func (server *migrationServer) verifyAK(userID int, message []byte, encodedSignature string) error {
+	signature, err := migration.DecodeSignature(encodedSignature)
+	if err != nil {
+		return err
+	}
+	key := server.keys[userID]
+	if key == nil || len(signature) != key.Size() {
+		return errors.New("invalid AK signature length")
+	}
+	digest := sha256.Sum256(message)
+	if err := rsa.VerifyPKCS1v15(key, crypto.SHA256, digest[:], signature); err != nil {
+		return errors.New("AK signature does not match the enrolled identity")
+	}
+	return nil
+}
+
+func (server *migrationServer) verifyPCR11Quote(userID int, nonce string, evidence migration.Evidence) error {
+	keyFile := server.keyFiles[userID]
+	if keyFile == "" {
+		return errors.New("no enrolled AK file for this identity")
+	}
+	quote, err := base64.RawURLEncoding.DecodeString(evidence.PCR11Quote)
+	if err != nil || len(quote) == 0 {
+		return errors.New("invalid PCR 11 quote")
+	}
+	signature, err := base64.RawURLEncoding.DecodeString(evidence.PCR11Signature)
+	if err != nil || len(signature) == 0 {
+		return errors.New("invalid PCR 11 quote signature")
+	}
+	pcr11, err := hex.DecodeString(evidence.PCR11)
+	if err != nil || len(pcr11) != sha256.Size {
+		return errors.New("PCR 11 must contain one SHA-256 value")
+	}
+	nonceBytes, err := base64.RawURLEncoding.DecodeString(nonce)
+	if err != nil || len(nonceBytes) != 32 {
+		return errors.New("invalid PCR 11 quote nonce")
+	}
+	directory, err := os.MkdirTemp("", "rva23-migration-quote-")
+	if err != nil {
+		return err
+	}
+	defer os.RemoveAll(directory)
+	quotePath := filepath.Join(directory, "quote.msg")
+	signaturePath := filepath.Join(directory, "quote.sig")
+	selectionsPath := filepath.Join(directory, "quote.pcrs")
+	for path, data := range map[string][]byte{quotePath: quote, signaturePath: signature, selectionsPath: pcr11} {
+		if err := os.WriteFile(path, data, 0o600); err != nil {
+			return err
+		}
+	}
+	command := exec.Command("tpm2_checkquote", "-u", keyFile, "-m", quotePath, "-s", signaturePath, "-f", selectionsPath, "-l", "sha256:11", "-q", hex.EncodeToString(nonceBytes))
+	if result, err := command.CombinedOutput(); err != nil {
+		return fmt.Errorf("PCR 11 quote validation failed: %s", result)
+	}
+	return nil
+}
+
+func validateAttestationFields(input migration.AttestationRequest) (int, error) {
+	if err := migration.ValidateInstanceID(input.InstanceID); err != nil {
+		return 0, err
+	}
+	if input.PID <= 0 || input.Counter == 0 {
+		return 0, errors.New("PID and counter must be positive")
+	}
+	userID, err := migration.ExpectedUserID(input.Phase)
+	if err != nil {
+		return 0, err
+	}
+	if input.Evidence.Nonce == "" || input.Evidence.Token == "" || input.Evidence.Report == "" || input.Evidence.PCR11 == "" || input.Evidence.PCR11Quote == "" || input.Evidence.PCR11Signature == "" || input.Evidence.PCR11Selections == "" {
+		return 0, errors.New("full OS evidence and a PCR 11 quote are required")
+	}
+	return userID, nil
+}
+
+func (server *migrationServer) forwardReport(report []byte, evidence migration.Evidence) error {
+	request, err := http.NewRequest(http.MethodPost, server.attestationURL, bytes.NewReader(report))
+	if err != nil {
+		return err
+	}
+	request.Header.Set("Content-Type", "application/json")
+	request.Header.Set("X-Attestation-Nonce", evidence.Nonce)
+	request.Header.Set("X-Attestation-Token", evidence.Token)
+	response, err := server.client.Do(request)
+	if err != nil {
+		return fmt.Errorf("attestation request failed: %w", err)
+	}
+	defer response.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(response.Body, maxResponseBytes))
+	if err != nil {
+		return fmt.Errorf("attestation response failed: %w", err)
+	}
+	if response.StatusCode < 200 || response.StatusCode >= 300 {
+		return fmt.Errorf("attestation service returned %s: %s", response.Status, strings.TrimSpace(string(body)))
+	}
+	return nil
+}
+
+func (server *migrationServer) attestHandler(writer http.ResponseWriter, request *http.Request) {
+	if request.Method != http.MethodPost {
+		methodNotAllowed(writer, http.MethodPost)
+		return
+	}
+	raw, readErr := io.ReadAll(http.MaxBytesReader(writer, request.Body, maxAttestationBody))
+	record := requestRecord{At: server.now().UTC(), Operation: "attestation", BodyBase64: base64.StdEncoding.EncodeToString(raw)}
+	if readErr != nil {
+		server.reject(writer, record, http.StatusBadRequest, errors.New("invalid attestation body"))
+		return
+	}
+	var input migration.AttestationRequest
+	if err := decodeJSON(raw, &input); err != nil {
+		server.reject(writer, record, http.StatusBadRequest, fmt.Errorf("invalid attestation JSON: %w", err))
+		return
+	}
+	record.Attestation = &input
+	record.Validation = map[string]string{
+		"identityBinding": "pending",
+		"freshNonce":      "pending",
+		"singleUseNonce":  "pending",
+		"counter":         "pending",
+		"hostOsReport":    "pending",
+		"pcr11Profile":    "pending",
+		"pcr11Quote":      "pending",
+	}
+	userID, err := validateAttestationFields(input)
+	if err != nil {
+		server.reject(writer, record, http.StatusBadRequest, err)
+		return
+	}
+	if !server.validNonce(input.Nonce, input.InstanceID, input.Phase) {
+		record.Validation["freshNonce"] = "rejected"
+		server.reject(writer, record, http.StatusForbidden, errors.New("challenge nonce is expired, unknown, or bound to another request"))
+		return
+	}
+	record.Validation["freshNonce"] = "accepted"
+	message, err := migration.AttestationMessage(input)
+	if err != nil {
+		server.reject(writer, record, http.StatusBadRequest, err)
+		return
+	}
+	if err := server.verifyAK(userID, message, input.Signature); err != nil {
+		server.reject(writer, record, http.StatusForbidden, err)
+		return
+	}
+	record.Validation["identityBinding"] = fmt.Sprintf("accepted for user %d", userID)
+	report, err := base64.RawURLEncoding.DecodeString(input.Evidence.Report)
+	if err != nil || len(report) == 0 || len(report) > maxReportBytes {
+		server.reject(writer, record, http.StatusBadRequest, errors.New("invalid OS report size or encoding"))
+		return
+	}
+	pcr11, err := hex.DecodeString(input.Evidence.PCR11)
+	if err != nil || len(pcr11) != sha256.Size {
+		server.reject(writer, record, http.StatusBadRequest, errors.New("PCR 11 must contain one SHA-256 value"))
+		return
+	}
+	if err := server.forwardReport(report, input.Evidence); err != nil {
+		server.reject(writer, record, http.StatusForbidden, err)
+		return
+	}
+	record.Validation["hostOsReport"] = "accepted"
+	if !strings.EqualFold(input.Evidence.PCR11, server.productionPCR11) {
+		server.reject(writer, record, http.StatusForbidden, errors.New("OS report PCR 11 does not match the required profile"))
+		return
+	}
+	record.Validation["pcr11Profile"] = "accepted"
+	if err := server.quoteVerifier(userID, input.Nonce, input.Evidence); err != nil {
+		server.reject(writer, record, http.StatusForbidden, err)
+		return
+	}
+	record.Validation["pcr11Quote"] = "accepted"
+	if err := server.consumeNonce(input.Nonce, input.InstanceID, input.Phase, input.Counter); err != nil {
+		server.reject(writer, record, http.StatusForbidden, err)
+		return
+	}
+	record.Validation["singleUseNonce"] = "consumed"
+	record.Validation["counter"] = "accepted"
+	response := migration.AttestationResponse{
+		Status: "accepted", UserID: userID, InstanceID: input.InstanceID,
+		PID: input.PID, Counter: input.Counter, Phase: input.Phase,
+	}
+	record.Response = response
+	server.record(record)
+	writeJSON(writer, http.StatusOK, response)
+}
+
+func checkpointInstanceID(path string) (string, string, error) {
+	remainder := strings.TrimPrefix(path, "/v1/checkpoints/")
+	if remainder == path {
+		return "", "", errors.New("invalid checkpoint path")
+	}
+	parts := strings.Split(remainder, "/")
+	if len(parts) == 1 {
+		return parts[0], migration.ActionUpload, nil
+	}
+	if len(parts) == 2 && parts[1] == "download" {
+		return parts[0], migration.ActionDownload, nil
+	}
+	return "", "", errors.New("invalid checkpoint path")
+}
+
+func checkpointAuthorization(request *http.Request, instanceID, action string) (migration.CheckpointAuthorization, error) {
+	var input migration.CheckpointAuthorization
+	pid, err := strconv.Atoi(request.Header.Get("X-Migration-PID"))
+	if err != nil {
+		return input, errors.New("invalid migration PID")
+	}
+	counter, err := strconv.ParseUint(request.Header.Get("X-Migration-Counter"), 10, 64)
+	if err != nil {
+		return input, errors.New("invalid migration counter")
+	}
+	size := int64(0)
+	if value := request.Header.Get("X-Migration-Checkpoint-Size"); value != "" {
+		size, err = strconv.ParseInt(value, 10, 64)
+		if err != nil {
+			return input, errors.New("invalid checkpoint size")
+		}
+	}
+	input = migration.CheckpointAuthorization{
+		Action: action, InstanceID: instanceID, PID: pid, Counter: counter,
+		Phase: request.Header.Get("X-Migration-Phase"), Nonce: request.Header.Get("X-Migration-Nonce"),
+		CheckpointSHA256: request.Header.Get("X-Migration-Checkpoint-SHA256"), CheckpointSize: size,
+	}
+	if request.Header.Get("X-Migration-Instance-ID") != instanceID || request.Header.Get("X-Migration-Action") != action {
+		return input, errors.New("checkpoint headers do not match the path")
+	}
+	return input, nil
+}
+
+func (server *migrationServer) verifyCheckpointAuthorization(input migration.CheckpointAuthorization, encodedSignature string) (int, error) {
+	if err := migration.ValidateInstanceID(input.InstanceID); err != nil {
+		return 0, err
+	}
+	if input.PID <= 0 || input.Counter == 0 {
+		return 0, errors.New("PID and counter must be positive")
+	}
+	expectedPhase, err := migration.ExpectedCheckpointPhase(input.Action)
+	if err != nil {
+		return 0, err
+	}
+	if input.Phase != expectedPhase {
+		return 0, errors.New("checkpoint action uses the wrong migration phase")
+	}
+	userID, err := migration.ExpectedUserID(input.Phase)
+	if err != nil {
+		return 0, err
+	}
+	message, err := migration.CheckpointMessage(input)
+	if err != nil {
+		return 0, err
+	}
+	if err := server.verifyAK(userID, message, encodedSignature); err != nil {
+		return 0, err
+	}
+	return userID, nil
+}
+
+func validDigest(value string) bool {
+	decoded, err := hex.DecodeString(value)
+	return err == nil && len(decoded) == sha256.Size && strings.ToLower(value) == value
+}
+
+func (server *migrationServer) checkpointHandler(writer http.ResponseWriter, request *http.Request) {
+	instanceID, action, err := checkpointInstanceID(request.URL.Path)
+	if err != nil {
+		writeJSON(writer, http.StatusBadRequest, map[string]string{"error": err.Error()})
+		return
+	}
+	switch action {
+	case migration.ActionUpload:
+		if request.Method != http.MethodPut {
+			methodNotAllowed(writer, http.MethodPut)
+			return
+		}
+		server.uploadHandler(writer, request, instanceID)
+	case migration.ActionDownload:
+		if request.Method != http.MethodPost {
+			methodNotAllowed(writer, http.MethodPost)
+			return
+		}
+		server.downloadHandler(writer, request, instanceID)
+	}
+}
+
+func (server *migrationServer) uploadHandler(writer http.ResponseWriter, request *http.Request, instanceID string) {
+	input, err := checkpointAuthorization(request, instanceID, migration.ActionUpload)
+	record := requestRecord{At: server.now().UTC(), Operation: migration.ActionUpload, Authorization: &input, Validation: map[string]string{"identityBinding": "pending", "freshNonce": "pending", "singleUseNonce": "pending", "counter": "pending", "checkpointDigest": "pending", "checkpointLimit": "pending"}}
+	if err != nil {
+		server.reject(writer, record, http.StatusBadRequest, err)
+		return
+	}
+	if !validDigest(input.CheckpointSHA256) || input.CheckpointSize <= 0 || input.CheckpointSize > server.maxCheckpoint {
+		server.reject(writer, record, http.StatusBadRequest, errors.New("invalid checkpoint digest or size"))
+		return
+	}
+	if !server.validNonce(input.Nonce, input.InstanceID, input.Phase) {
+		server.reject(writer, record, http.StatusForbidden, errors.New("challenge nonce is expired, unknown, or bound to another request"))
+		return
+	}
+	record.Validation["freshNonce"] = "accepted"
+	userID, err := server.verifyCheckpointAuthorization(input, request.Header.Get("X-Migration-Signature"))
+	if err != nil {
+		server.reject(writer, record, http.StatusForbidden, err)
+		return
+	}
+	record.Validation["identityBinding"] = fmt.Sprintf("accepted for user %d", userID)
+	if err := os.MkdirAll(server.checkpointDir, 0o700); err != nil {
+		server.reject(writer, record, http.StatusInternalServerError, err)
+		return
+	}
+	server.mutex.Lock()
+	_, replacing := server.checkpoints[instanceID]
+	count := len(server.checkpoints)
+	server.mutex.Unlock()
+	if !replacing && count >= maxCheckpoints {
+		server.reject(writer, record, http.StatusConflict, errors.New("checkpoint storage limit reached"))
+		return
+	}
+	temporary, err := os.CreateTemp(server.checkpointDir, ".upload-*")
+	if err != nil {
+		server.reject(writer, record, http.StatusInternalServerError, err)
+		return
+	}
+	temporaryPath := temporary.Name()
+	completed := false
+	defer func() {
+		temporary.Close()
+		if !completed {
+			os.Remove(temporaryPath)
+		}
+	}()
+	hash := sha256.New()
+	written, err := io.Copy(io.MultiWriter(temporary, hash), io.LimitReader(request.Body, server.maxCheckpoint+1))
+	if err != nil {
+		server.reject(writer, record, http.StatusBadRequest, err)
+		return
+	}
+	if written > server.maxCheckpoint || written != input.CheckpointSize {
+		server.reject(writer, record, http.StatusBadRequest, errors.New("checkpoint body size does not match the signed size or limit"))
+		return
+	}
+	record.Validation["checkpointLimit"] = "accepted"
+	digest := hex.EncodeToString(hash.Sum(nil))
+	if digest != input.CheckpointSHA256 {
+		server.reject(writer, record, http.StatusBadRequest, errors.New("checkpoint body digest does not match the signed digest"))
+		return
+	}
+	record.Validation["checkpointDigest"] = "accepted"
+	if err := temporary.Sync(); err != nil {
+		server.reject(writer, record, http.StatusInternalServerError, err)
+		return
+	}
+	if err := temporary.Close(); err != nil {
+		server.reject(writer, record, http.StatusInternalServerError, err)
+		return
+	}
+	if err := server.consumeNonce(input.Nonce, input.InstanceID, input.Phase, input.Counter); err != nil {
+		server.reject(writer, record, http.StatusForbidden, err)
+		return
+	}
+	finalPath := filepath.Join(server.checkpointDir, instanceID+".tar.gz")
+	if err := os.Rename(temporaryPath, finalPath); err != nil {
+		server.reject(writer, record, http.StatusInternalServerError, err)
+		return
+	}
+	completed = true
+	metadata := migration.CheckpointMetadata{InstanceID: instanceID, SHA256: digest, Size: written, UploadedAt: server.now().UTC()}
+	server.mutex.Lock()
+	server.checkpoints[instanceID] = metadata
+	server.mutex.Unlock()
+	record.Validation["singleUseNonce"] = "consumed"
+	record.Validation["counter"] = "accepted"
+	record.Checkpoint = &metadata
+	record.Response = map[string]string{"status": "uploaded"}
+	server.record(record)
+	writeJSON(writer, http.StatusCreated, record.Response)
+}
+
+func (server *migrationServer) downloadHandler(writer http.ResponseWriter, request *http.Request, instanceID string) {
+	input, err := checkpointAuthorization(request, instanceID, migration.ActionDownload)
+	record := requestRecord{At: server.now().UTC(), Operation: migration.ActionDownload, Authorization: &input, Validation: map[string]string{"identityBinding": "pending", "freshNonce": "pending", "singleUseNonce": "pending", "counter": "pending", "checkpointLimit": "pending"}}
+	if err != nil {
+		server.reject(writer, record, http.StatusBadRequest, err)
+		return
+	}
+	if input.CheckpointSHA256 != "" || input.CheckpointSize != 0 {
+		server.reject(writer, record, http.StatusBadRequest, errors.New("download authorization must not contain an upload digest or size"))
+		return
+	}
+	if !server.validNonce(input.Nonce, input.InstanceID, input.Phase) {
+		server.reject(writer, record, http.StatusForbidden, errors.New("challenge nonce is expired, unknown, or bound to another request"))
+		return
+	}
+	record.Validation["freshNonce"] = "accepted"
+	userID, err := server.verifyCheckpointAuthorization(input, request.Header.Get("X-Migration-Signature"))
+	if err != nil {
+		server.reject(writer, record, http.StatusForbidden, err)
+		return
+	}
+	record.Validation["identityBinding"] = fmt.Sprintf("accepted for user %d", userID)
+	server.mutex.Lock()
+	metadata, ok := server.checkpoints[instanceID]
+	server.mutex.Unlock()
+	if !ok {
+		server.reject(writer, record, http.StatusNotFound, errors.New("checkpoint not found"))
+		return
+	}
+	path := filepath.Join(server.checkpointDir, instanceID+".tar.gz")
+	archive, err := os.Open(path)
+	if err != nil {
+		server.reject(writer, record, http.StatusInternalServerError, err)
+		return
+	}
+	defer archive.Close()
+	info, err := archive.Stat()
+	if err != nil || info.Size() != metadata.Size || info.Size() > server.maxCheckpoint {
+		server.reject(writer, record, http.StatusInternalServerError, errors.New("stored checkpoint failed its size check"))
+		return
+	}
+	record.Validation["checkpointLimit"] = "accepted"
+	if err := server.consumeNonce(input.Nonce, input.InstanceID, input.Phase, input.Counter); err != nil {
+		server.reject(writer, record, http.StatusForbidden, err)
+		return
+	}
+	record.Validation["singleUseNonce"] = "consumed"
+	record.Validation["counter"] = "accepted"
+	record.Checkpoint = &metadata
+	record.Response = map[string]string{"status": "downloaded"}
+	server.record(record)
+	writer.Header().Set("Content-Type", "application/gzip")
+	writer.Header().Set("Content-Length", strconv.FormatInt(metadata.Size, 10))
+	writer.Header().Set("X-Checkpoint-SHA256", metadata.SHA256)
+	writer.Header().Set("Content-Disposition", "attachment; filename=checkpoint.tar.gz")
+	writer.WriteHeader(http.StatusOK)
+	_, _ = io.CopyN(writer, archive, metadata.Size)
+}
+
+func (server *migrationServer) stateHandler(writer http.ResponseWriter, request *http.Request) {
+	if request.Method != http.MethodGet {
+		methodNotAllowed(writer, http.MethodGet)
+		return
+	}
+	server.stateMutex.RLock()
+	response := stateResponse{History: append([]requestRecord(nil), server.history...)}
+	if server.latest != nil {
+		latest := *server.latest
+		response.Latest = &latest
+	}
+	server.stateMutex.RUnlock()
+	if response.History == nil {
+		response.History = []requestRecord{}
+	}
+	writeJSON(writer, http.StatusOK, response)
+}
+
+func uiHandler(writer http.ResponseWriter, request *http.Request) {
+	if request.URL.Path != "/" {
+		http.NotFound(writer, request)
+		return
+	}
+	if request.Method != http.MethodGet {
+		methodNotAllowed(writer, http.MethodGet)
+		return
+	}
+	writer.Header().Set("Content-Type", "text/html; charset=utf-8")
+	_, _ = io.WriteString(writer, `<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CRIU migration attestations</title></head>
+<body><h1>CRIU migration attestations</h1><p><button id="refresh" type="button">Refresh</button> <span id="status">Loading</span></p>
+<details open><summary>Latest request</summary><div id="latest">Loading</div></details>
+<details open><summary>Previous requests</summary><div id="history">Loading</div></details>
+<script>
+function label(key){const names={at:'Time',bodyBase64:'Request body base64',instanceId:'Instance ID',pid:'PID',pcr11:'PCR 11',hostOsReport:'Host OS report',identityBinding:'Identity binding',freshNonce:'Fresh nonce',singleUseNonce:'Single-use nonce',checkpointSha256:'Checkpoint SHA-256'};if(names[key])return names[key];const text=key.replace(/([a-z0-9])([A-Z])/g,'$1 $2').replace(/_/g,' ');return text.charAt(0).toUpperCase()+text.slice(1)}
+function scalar(value){if(value===null||value===undefined)return 'None';if(typeof value==='boolean')return value?'Yes':'No';if(value==='')return 'None';return String(value)}
+function render(name,value,expand){if(value===null||typeof value!=='object'){const content=scalar(value);if(content.length>160){const details=document.createElement('details');const summary=document.createElement('summary');summary.textContent=name+' ('+content.length+' characters)';const pre=document.createElement('pre');pre.textContent=content;details.append(summary,pre);return details}return document.createTextNode(content)}const array=Array.isArray(value);const entries=array?value.map((entry,index)=>[String(index+1),entry]):Object.entries(value);if(!entries.length)return document.createTextNode('None');const details=document.createElement('details');details.open=Boolean(expand);const summary=document.createElement('summary');summary.textContent=name+' ('+entries.length+(array?' items':' fields')+')';const table=document.createElement('table');const body=document.createElement('tbody');for(const [key,entry] of entries){const row=document.createElement('tr');const heading=document.createElement('th');heading.scope='row';heading.textContent=array?'Item '+key:label(key);const cell=document.createElement('td');cell.append(render(array?'Item '+key:label(key),entry,false));row.append(heading,cell);body.append(row)}table.append(body);details.append(summary,table);return details}
+function fields(item){const table=document.createElement('table');const body=document.createElement('tbody');for(const [key,value] of Object.entries(item||{})){const row=document.createElement('tr');const heading=document.createElement('th');heading.scope='row';heading.textContent=label(key);const cell=document.createElement('td');cell.append(render(label(key),value,true));row.append(heading,cell);body.append(row)}table.append(body);return table}
+function raw(item){const details=document.createElement('details');const summary=document.createElement('summary');summary.textContent='Raw JSON';const pre=document.createElement('pre');pre.textContent=JSON.stringify(item,null,2);details.append(summary,pre);return details}
+function summary(item){return (item.at||'Unknown time')+' | '+(item.operation||'Unknown operation')+' | '+((item.attestation&&item.attestation.phase)||(item.authorization&&item.authorization.phase)||'Unknown phase')+' | '+((item.response&&item.response.status)||item.error||'rejected')}
+function entry(item){const details=document.createElement('details');const heading=document.createElement('summary');heading.textContent=summary(item);details.append(heading,fields(item),raw(item));return details}
+async function refresh(){const status=document.getElementById('status');status.textContent='Loading';try{const response=await fetch('/api/state');if(!response.ok)throw new Error(response.statusText);const data=await response.json();const latest=document.getElementById('latest');if(data.latest){latest.replaceChildren(fields(data.latest),raw(data.latest))}else{latest.textContent='No requests'}const history=data.history||[];const previous=data.latest?history.slice(1):history;const container=document.getElementById('history');if(previous.length){container.replaceChildren(...previous.map(entry))}else{container.textContent='No previous requests'}status.textContent=data.latest?'Updated '+data.latest.at:'No requests'}catch(error){status.textContent='Refresh failed: '+error.message}}
+document.getElementById('refresh').onclick=refresh;refresh()
+</script></body></html>`)
+}
+
+func newHTTPHandler(server *migrationServer) http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("/v1/challenge", server.challengeHandler)
+	mux.HandleFunc("/v1/attestations", server.attestHandler)
+	mux.HandleFunc("/v1/checkpoints/", server.checkpointHandler)
+	mux.HandleFunc("/api/state", server.stateHandler)
+	mux.HandleFunc("/", uiHandler)
+	return mux
+}
+
+func main() {
+	vm1KeyFile := environment("RVA23_MIGRATION_VM1_KEY_FILE", "output/rva23/migration/vm1-ak-public.pem")
+	vm2KeyFile := environment("RVA23_MIGRATION_VM2_KEY_FILE", "output/rva23/migration/vm2-ak-public.pem")
+	vm1Key, err := loadPublicKey(vm1KeyFile)
+	if err != nil {
+		panic(err)
+	}
+	vm2Key, err := loadPublicKey(vm2KeyFile)
+	if err != nil {
+		panic(err)
+	}
+	productionPCR11 := strings.ToLower(os.Getenv("RVA23_MIGRATION_PRODUCTION_PCR11"))
+	if !validDigest(productionPCR11) {
+		panic("RVA23_MIGRATION_PRODUCTION_PCR11 must contain one SHA-256 value")
+	}
+	server := &migrationServer{
+		keys: map[int]*rsa.PublicKey{1: vm1Key, 2: vm2Key}, keyFiles: map[int]string{1: vm1KeyFile, 2: vm2KeyFile}, productionPCR11: productionPCR11,
+		attestationURL: environment("RVA23_MIGRATION_ATTESTATION_URL", "http://127.0.0.1:8080/v1/attest"),
+		checkpointDir:  environment("RVA23_MIGRATION_CHECKPOINT_DIR", "output/rva23/migration/checkpoints"),
+		client:         &http.Client{Timeout: 60 * time.Second}, maxCheckpoint: migration.DefaultMaxCheckpointBytes,
+		now: func() time.Time { return time.Now().UTC() }, nonces: make(map[string]challengeRecord),
+		counters: make(map[string]uint64), checkpoints: make(map[string]migration.CheckpointMetadata), history: make([]requestRecord, 0),
+	}
+	server.quoteVerifier = server.verifyPCR11Quote
+	httpServer := &http.Server{
+		Addr: "127.0.0.1:8083", Handler: newHTTPHandler(server), ReadHeaderTimeout: 5 * time.Second,
+		ReadTimeout: 120 * time.Second, WriteTimeout: 120 * time.Second, IdleTimeout: 60 * time.Second, MaxHeaderBytes: 64 * 1024,
+	}
+	if err := httpServer.ListenAndServe(); err != nil {
+		panic(err)
+	}
+}
diff --git a/buildroot/k3/scripts/migration/cmd/migration-server/migration-server_test.go b/buildroot/k3/scripts/migration/cmd/migration-server/migration-server_test.go
