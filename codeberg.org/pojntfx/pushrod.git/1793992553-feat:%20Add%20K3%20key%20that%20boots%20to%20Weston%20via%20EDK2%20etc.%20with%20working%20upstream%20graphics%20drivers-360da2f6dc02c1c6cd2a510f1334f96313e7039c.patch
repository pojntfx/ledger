diff --git a/buildroot/k3/Makefile b/buildroot/k3/Makefile
new file mode 100644
index 0000000000000000000000000000000000000000..4206ac0c2e21302bc6627374d844f7cbe3e8600b
--- /dev/null
+++ b/buildroot/k3/Makefile
@@ -0,0 +1,27 @@
+.SUFFIXES:
+
+THIS_EXTERNAL_PATH := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
+-include $(THIS_EXTERNAL_PATH)/local.mk
+BUILDROOT_DIR ?= $(abspath $(THIS_EXTERNAL_PATH)/../buildroot)
+OUTPUT_DIR ?= $(THIS_EXTERNAL_PATH)/output/k3-uefi
+BR2_DL_DIR ?= $(abspath $(THIS_EXTERNAL_PATH)/../dl)
+BR2_CCACHE_DIR ?= $(abspath $(THIS_EXTERNAL_PATH)/../ccache)
+K3_SOURCE_DIR ?= $(abspath $(THIS_EXTERNAL_PATH)/../src)
+K3_LINUX_FIRMWARE_DIR ?= $(K3_SOURCE_DIR)/linux-firmware/powervr
+
+MAKE_BUILDROOT = $(MAKE) -C $(BUILDROOT_DIR) O=$(OUTPUT_DIR) BR2_EXTERNAL=$(THIS_EXTERNAL_PATH) BR2_DL_DIR=$(BR2_DL_DIR) BR2_CCACHE_DIR=$(BR2_CCACHE_DIR) LINUX_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/linux OPENSBI_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/opensbi-vendor EDK2_SPACEMIT_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/edk2-spacemit BINUTILS_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/binutils HOST_BINUTILS_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/binutils HOST_GCC_INITIAL_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/gcc HOST_GCC_FINAL_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/gcc GCC_FINAL_OVERRIDE_SRCDIR=$(K3_SOURCE_DIR)/gcc K3_LINUX_FIRMWARE_DIR=$(K3_LINUX_FIRMWARE_DIR)
+BUILDROOT_PATCHES = $(sort $(wildcard $(THIS_EXTERNAL_PATH)/patches/buildroot/*.patch))
+
+.PHONY: all configure build clean
+
+all: build
+
+configure:
+	for patch in $(BUILDROOT_PATCHES); do git -C $(BUILDROOT_DIR) apply --reverse --check "$$patch" || exit 1; done
+	$(MAKE_BUILDROOT) k3_uefi_defconfig
+
+build: configure
+	$(MAKE_BUILDROOT) -j14
+
+clean:
+	$(MAKE_BUILDROOT) clean
