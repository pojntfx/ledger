+type mutualTestFIDO2 struct {
+	attestationKey        *ecdsa.PrivateKey
+	consentKey            *ecdsa.PrivateKey
+	certificateDER        []byte
+	keyHandle             []byte
+	registrationChallenge [32]byte
+}
+
+func newMutualTestFIDO2(t *testing.T, serial int64) *mutualTestFIDO2 {
+	t.Helper()
+	attestationKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	consentKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := &x509.Certificate{
+		SerialNumber: big.NewInt(serial),
+		Subject:      pkix.Name{CommonName: "Mutual migration test U2F"},
+		NotBefore:    time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC),
+		NotAfter:     time.Date(2027, 1, 1, 0, 0, 0, 0, time.UTC),
+	}
+	certificateDER, err := x509.CreateCertificate(rand.Reader, template, template, &attestationKey.PublicKey, attestationKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	device := &mutualTestFIDO2{
+		attestationKey: attestationKey,
+		consentKey:     consentKey,
+		certificateDER: certificateDER,
+		keyHandle:      []byte{byte(serial), 2, 3, 4, 5},
+	}
+	for index := range device.registrationChallenge {
+		device.registrationChallenge[index] = byte(index + int(serial))
+	}
+	return device
+}
+
+func (device *mutualTestFIDO2) proof(t *testing.T, input migration.MutualOperationRequest) string {
+	t.Helper()
+	application, err := migration.MutualApplication(input.Binding.SessionID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	consentMessage, err := migration.MutualConsentMessage(input)
+	if err != nil {
+		t.Fatal(err)
+	}
+	operationChallenge := migration.MutualConsentChallenge(consentMessage)
+	consentPublicKeyDER, err := x509.MarshalPKIXPublicKey(&device.consentKey.PublicKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	publicKeyBytes := make([]byte, 65)
+	publicKeyBytes[0] = 4
+	device.consentKey.X.FillBytes(publicKeyBytes[1:33])
+	device.consentKey.Y.FillBytes(publicKeyBytes[33:65])
+	registrationMessage := []byte{0}
+	registrationMessage = append(registrationMessage, application...)
+	registrationMessage = append(registrationMessage, device.registrationChallenge[:]...)
+	registrationMessage = append(registrationMessage, device.keyHandle...)
+	registrationMessage = append(registrationMessage, publicKeyBytes...)
+	registrationDigest := sha256.Sum256(registrationMessage)
+	registrationSignature, err := ecdsa.SignASN1(rand.Reader, device.attestationKey, registrationDigest[:])
+	if err != nil {
+		t.Fatal(err)
+	}
+	counterValue := uint32(input.Binding.Counter + 10)
+	counter := make([]byte, 4)
+	binary.BigEndian.PutUint32(counter, counterValue)
+	consentBytes := append([]byte{}, application...)
+	consentBytes = append(consentBytes, 1)
+	consentBytes = append(consentBytes, counter...)
+	consentBytes = append(consentBytes, operationChallenge...)
+	consentDigest := sha256.Sum256(consentBytes)
+	consentSignature, err := ecdsa.SignASN1(rand.Reader, device.consentKey, consentDigest[:])
+	if err != nil {
+		t.Fatal(err)
+	}
+	proof := fido2.U2FConsent{
+		PublicKey:             string(pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: consentPublicKeyDER})),
+		Certificate:           base64.RawURLEncoding.EncodeToString(device.certificateDER),
+		KeyHandle:             base64.RawURLEncoding.EncodeToString(device.keyHandle),
+		RegistrationChallenge: base64.RawURLEncoding.EncodeToString(device.registrationChallenge[:]),
+		RegistrationSignature: base64.RawURLEncoding.EncodeToString(registrationSignature),
+		Signature:             base64.RawURLEncoding.EncodeToString(consentSignature),
+		Counter:               counterValue,
+	}
+	encoded, err := json.Marshal(proof)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result := base64.RawURLEncoding.EncodeToString(encoded)
+	decoded, err := decodeConsentProof(result, input.Binding.Role)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var applicationDigest [32]byte
+	var challengeDigest [32]byte
+	copy(applicationDigest[:], application)
+	copy(challengeDigest[:], operationChallenge)
+	verification := attestation.VerificationInput{
+		AllowlistedCertificates: map[string][]byte{input.Binding.Role: device.certificateDER},
+		ApplicationDigest:       applicationDigest,
+		OperationChallenge:      challengeDigest,
+	}
+	if err := attestation.VerifyProof(decoded, verification); err != nil {
+		t.Fatalf("generated proof failed verification: %v", err)
+	}
+	return result
+}
