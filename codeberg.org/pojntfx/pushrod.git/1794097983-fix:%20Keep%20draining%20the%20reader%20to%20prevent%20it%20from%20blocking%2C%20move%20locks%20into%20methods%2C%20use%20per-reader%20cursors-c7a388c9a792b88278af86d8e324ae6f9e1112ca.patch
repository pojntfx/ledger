From c7a388c9a792b88278af86d8e324ae6f9e1112ca Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Sat, 07 Nov 2026 17:33:03 -0700
Subject: [PATCH] fix: Keep draining the reader to prevent it from blocking, move locks into methods, use per-reader cursors

Signed-off-by: Felicitas Pojtinger <felicitas@pojtinger.com>
---
diff --git a/pkg/svc/root.go b/pkg/svc/root.go
index f0b317b7ea5cc492e8688fe4e5e05b90cd02da5d..0ad0d872c5bc05e35d071407a264a967dd5faed4 100644
--- a/pkg/svc/root.go
+++ b/pkg/svc/root.go
@@ -149,15 +149,7 @@ 		s.consolesLock.Lock()
 		defer s.consolesLock.Unlock()
 
 		for _, console := range s.consoles {
-			func() {
-				console.lock.Lock()
-				defer console.lock.Unlock()
-
-				if console.port != nil {
-					console.port.Close()
-					console.port = nil
-				}
-			}()
+			console.close()
 		}
 	})
 
diff --git a/pkg/svc/serial.go b/pkg/svc/serial.go
index 24e620b78b61f4b5722896cfb743dbeb528f2047..25bc232fc173857db91643069cce6260d2a77b3a 100644
--- a/pkg/svc/serial.go
+++ b/pkg/svc/serial.go
@@ -19,40 +19,94 @@ type serialConsole struct {
 	path     string
 	identity USBIdentity
 
-	port serial.Port
+	portLock *sync.Mutex
+	port     serial.Port
 
-	buffer []byte
-
-	lock *sync.Mutex
+	bufferLock *sync.Mutex
+	buffer     []byte
+	cursor     int
 }
 
 func newSerialConsole(port *enumerator.PortDetails) *serialConsole {
 	return &serialConsole{
-		path:     port.Name,
-		identity: usbIdentityFromPort(port),
-		lock:     &sync.Mutex{},
+		path:       port.Name,
+		identity:   usbIdentityFromPort(port),
+		portLock:   &sync.Mutex{},
+		bufferLock: &sync.Mutex{},
 	}
 }
 
 func (c *serialConsole) Write(data []byte) (int, error) {
-	c.lock.Lock()
-	defer c.lock.Unlock()
+	c.bufferLock.Lock()
+	defer c.bufferLock.Unlock()
 
 	c.buffer = append(c.buffer, data...)
 
 	if len(c.buffer) > maxConsoleBuffer {
-		c.buffer = slices.Clone(c.buffer[len(c.buffer)-maxConsoleBuffer/2:])
+		overflow := len(c.buffer) - maxConsoleBuffer/2
+
+		c.buffer = slices.Clone(c.buffer[overflow:])
+		c.cursor = max(0, c.cursor-overflow)
 	}
 
 	return len(data), nil
 }
 
 func (c *serialConsole) state() Console {
+	c.portLock.Lock()
+	isBuffering := c.port != nil
+	c.portLock.Unlock()
+
 	return Console{
 		Path:          c.path,
 		USBIdentity:   c.identity,
-		IsBuffering:   c.port != nil,
-		BufferedBytes: len(c.buffer),
+		IsBuffering:   isBuffering,
+		BufferedBytes: c.bufferedBytes(),
+	}
+}
+
+func (c *serialConsole) bufferedBytes() int {
+	c.bufferLock.Lock()
+	defer c.bufferLock.Unlock()
+
+	return len(c.buffer)
+}
+
+func (c *serialConsole) output() string {
+	c.bufferLock.Lock()
+	defer c.bufferLock.Unlock()
+
+	c.cursor = len(c.buffer)
+
+	return string(c.buffer)
+}
+
+func (c *serialConsole) takeOutput() string {
+	c.bufferLock.Lock()
+	defer c.bufferLock.Unlock()
+
+	output := string(c.buffer[c.cursor:])
+
+	c.cursor = len(c.buffer)
+
+	return output
+}
+
+func (c *serialConsole) clearBuffer() {
+	c.bufferLock.Lock()
+	defer c.bufferLock.Unlock()
+
+	c.buffer = nil
+	c.cursor = 0
+}
+
+func (c *serialConsole) close() {
+	c.portLock.Lock()
+	defer c.portLock.Unlock()
+
+	if c.port != nil {
+		c.port.Close()
+		c.port = nil
 	}
 }
 
@@ -69,6 +123,13 @@
 	return console
 }
 
+func (s *Service) openConsole(console *serialConsole) error {
+	console.portLock.Lock()
+	defer console.portLock.Unlock()
+
+	return s.openConsoleLocked(console)
+}
+
 func (s *Service) openConsoleLocked(console *serialConsole) error {
 	if console.port != nil {
 		return nil
@@ -88,20 +149,33 @@
 	return nil
 }
 
+func (s *Service) writeConsole(console *serialConsole, data []byte) error {
+	console.portLock.Lock()
+	defer console.portLock.Unlock()
+
+	if err := s.openConsoleLocked(console); err != nil {
+		return err
+	}
+
+	_, err := console.port.Write(data)
+
+	return err
+}
+
 func (s *Service) readLoop(console *serialConsole, port serial.Port) {
 	defer port.Close()
 
 	_, err := io.Copy(console, port)
 
-	console.lock.Lock()
+	console.portLock.Lock()
 	if console.port != port {
-		console.lock.Unlock()
+		console.portLock.Unlock()
 
 		return
 	}
 
 	console.port = nil
-	console.lock.Unlock()
+	console.portLock.Unlock()
 
 	s.log.Error("Could not read from serial console, stopping buffering", "path", console.path, "err", err)
 }
diff --git a/pkg/svc/serial_clear_buffer.go b/pkg/svc/serial_clear_buffer.go
index 4cb2562c60c441d6d8f05ced6dec1bb93efa15f5..a8a6e1119c9d0257f90b9e446772e0bb80cb40e0 100644
