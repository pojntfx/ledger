@@ -25,10 +25,7 @@ 	if err != nil {
 		return nil, nil, err
 	}
 
-	console.lock.Lock()
-	defer console.lock.Unlock()
-
-	console.buffer = nil
+	console.clearBuffer()
 
 	return nil, &GetConsolesOutput{
 		Consoles: []Console{console.state()},
diff --git a/pkg/svc/serial_get_consoles.go b/pkg/svc/serial_get_consoles.go
index 5352055ac3a1af63a8b89a63575986110c190059..a65ec64d41186d7915fceaa426b6a2740fd16d83 100644
