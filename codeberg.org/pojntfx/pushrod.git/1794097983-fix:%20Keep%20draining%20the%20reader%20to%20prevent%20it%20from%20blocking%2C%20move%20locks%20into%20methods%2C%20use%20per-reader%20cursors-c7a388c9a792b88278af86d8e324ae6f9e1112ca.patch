 	s.pruneConsoles(enumerated)
@@ -68,9 +64,9 @@ 		if enumerated[path] {
 			continue
 		}
 
-		console.lock.Lock()
+		console.portLock.Lock()
 		stopped := console.port == nil
-		console.lock.Unlock()
+		console.portLock.Unlock()
 
 		if stopped {
 			delete(s.consoles, path)
diff --git a/pkg/svc/serial_read_from.go b/pkg/svc/serial_read_from.go
index 349efc6215d1f0e83289d0ad567388d7195a59df..58a79ee2ff78de2603259f92a8cd27f49c3ff7ca 100644
--- a/pkg/svc/serial_read_from.go
+++ b/pkg/svc/serial_read_from.go
@@ -10,7 +10,7 @@ var (
 	ReadFromTool = &mcp.Tool{
 		Name:        "serial.readFrom",
 		Title:       "Read from serial console",
-		Description: "Read the captured output of a serial console",
+		Description: "Read the captured output of a serial console. A later writeTo call does not repeat output that this tool already returned",
 		Annotations: &mcp.ToolAnnotations{DestructiveHint: new(false)},
 	}
 )
@@ -29,11 +29,8 @@ 	if err != nil {
 		return nil, nil, err
 	}
 
-	console.lock.Lock()
-	defer console.lock.Unlock()
-
-	if err := s.openConsoleLocked(console); err != nil {
-		if len(console.buffer) == 0 {
+	if err := s.openConsole(console); err != nil {
+		if console.bufferedBytes() == 0 {
 			// Without history we return the error since we can't fall back to returning the captured history
 			return nil, nil, err
 		}
@@ -42,6 +39,6 @@ 		s.log.Warn("Could not open serial console, returning the captured history", "path", console.path, "err", err)
 	}
 
 	return nil, &ReadFromOutput{
-		Output: string(console.buffer),
+		Output: console.output(),
 	}, nil
 }
diff --git a/pkg/svc/serial_start_buffering.go b/pkg/svc/serial_start_buffering.go
index 033c76e693ca6171abcb6207e8e161d91f1d6e3d..b0b8b9b4e1fb1a5767bb8d17dbb47dc282334fbc 100644
