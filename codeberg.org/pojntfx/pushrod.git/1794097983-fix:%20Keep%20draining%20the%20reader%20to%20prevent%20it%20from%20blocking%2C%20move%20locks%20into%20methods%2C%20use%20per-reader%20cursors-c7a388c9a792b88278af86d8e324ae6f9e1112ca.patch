diff --git a/pkg/svc/serial_write_to.go b/pkg/svc/serial_write_to.go
index 99f225f4baf33630f8bb6208c099ed1901e7143c..312a7547c56629f292e47755bf691655fcbed12d 100644
--- a/pkg/svc/serial_write_to.go
+++ b/pkg/svc/serial_write_to.go
@@ -11,7 +11,7 @@ var (
 	WriteToTool = &mcp.Tool{
 		Name:        "serial.writeTo",
 		Title:       "Write to serial console",
-		Description: "Write to a serial console and read back the output that follows",
+		Description: "Write to a serial console and read back the output that follows, including output that no earlier call has returned",
 		Annotations: &mcp.ToolAnnotations{DestructiveHint: new(true)},
 	}
 )
@@ -23,7 +23,7 @@ 	WaitMs int    `json:"waitMs,omitempty" jsonschema:"how long to wait before reading back the output in milliseconds, so that the target has time to react to the write"`
 }
 
 type WriteToOutput struct {
-	Output string `json:"output" jsonschema:"output that has arrived since the write"`
+	Output string `json:"output" jsonschema:"output that no earlier call has returned"`
 }
 
 func (s *Service) WriteTo(ctx context.Context, req *mcp.CallToolRequest, input WriteToInput) (*mcp.CallToolResult, *WriteToOutput, error) {
@@ -32,28 +32,13 @@ 	if err != nil {
 		return nil, nil, err
 	}
 
-	console.lock.Lock()
-	if err := s.openConsoleLocked(console); err != nil {
-		console.lock.Unlock()
-
-		return nil, nil, err
-	}
-
-	mark := len(console.buffer)
-
-	// Write to the console, then release the lock so that the reader can keep capturing
-	_, err = console.port.Write([]byte(input.Data))
-	console.lock.Unlock()
-	if err != nil {
+	if err := s.writeConsole(console, []byte(input.Data)); err != nil {
 		return nil, nil, err
 	}
 
 	time.Sleep(time.Duration(input.WaitMs) * time.Millisecond)
 
-	console.lock.Lock()
-	defer console.lock.Unlock()
-
 	return nil, &WriteToOutput{
-		Output: string(console.buffer[min(mark, len(console.buffer)):]),
+		Output: console.takeOutput(),
 	}, nil
 }

