@@ -98,6 +102,42 @@ 		}
 	}()
 
 	return s
+}
+
+func (s *Service) openBoard(path string) (*usbhid.Device, error) {
+	device, err := usbhid.Get(func(d *usbhid.Device) bool {
+		return isBoardRelay(d) && d.Path() == path
+	}, true, false)
+	if err != nil {
+		return nil, errors.Join(ErrCouldNotFindBoard, err)
+	}
+
+	return device, nil
+}
+
+func (s *Service) lockRelays(relays ...uint) (func(), error) {
+	seen := [4]bool{} // The board's relays are indexed from 1
+	for _, relay := range relays {
+		if relay < 1 || relay > 4 {
+			return nil, ErrInvalidRelay
+		}
+
+		if seen[relay-1] {
+			return nil, ErrInvalidRelay // Locking the same relay's lock twice would deadlock
+		}
+		seen[relay-1] = true
+	}
+
+	ordered := slices.Sorted(slices.Values(relays))
+	for _, relay := range ordered {
+		s.relayCycles[relay-1].lock.Lock()
+	}
+
+	return func() {
+		for _, relay := range slices.Backward(ordered) {
+			s.relayCycles[relay-1].lock.Unlock()
+		}
+	}, nil
 }
 
 func (s *Service) ShutdownContext() context.Context {
