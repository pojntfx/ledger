From fc3f4eefdcd39c66854e164ffc259c808130c97f Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Sun, 08 Nov 2026 21:40:58 -0700
Subject: [PATCH] fix: Stage `systemd-boot` EFI binaries
---
diff --git a/buildroot/scripts/build-os-images.py b/buildroot/scripts/build-os-images.py
index bf839d7a27b2f897871816e2868a17fcf656c4b6..68b78730f19160398371eab810e60a909c0b01db 100755
--- a/buildroot/scripts/build-os-images.py
+++ b/buildroot/scripts/build-os-images.py
@@ -189,6 +189,9 @@         sign_pe(host, key_dir, linux / name)
     bootloader = binaries / "efi-part/EFI/BOOT/bootriscv64.efi"
     if bootloader.exists():
         sign_pe(host, key_dir, bootloader)
+        systemd_bootloader = binaries / "efi-part/EFI/systemd/systemd-bootriscv64.efi"
+        systemd_bootloader.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copy2(bootloader, systemd_bootloader)
     loader = binaries / "efi-part/loader"
     loader.mkdir(parents=True, exist_ok=True)
     sidecars = loader / "extensions"

