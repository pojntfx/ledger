diff --git a/buildroot/qemu/Makefile b/buildroot/qemu/Makefile
deleted file mode 100644
index 7650d7264880b25a88a874a8767a79f6aac88e32..0000000000000000000000000000000000000000
--- a/buildroot/qemu/Makefile
+++ /dev/null
@@ -1,52 +0,0 @@
-.SUFFIXES:
-
-THIS_EXTERNAL_PATH := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
--include $(THIS_EXTERNAL_PATH)/local.mk
-BUILDROOT_DIR ?= $(abspath $(THIS_EXTERNAL_PATH)/../buildroot)
-OUTPUT_DIR ?= $(THIS_EXTERNAL_PATH)/output/rva23
-BR2_DL_DIR ?= $(abspath $(THIS_EXTERNAL_PATH)/../dl)
-BR2_CCACHE_DIR ?= $(abspath $(THIS_EXTERNAL_PATH)/../ccache)
-IMAGES_DIR := $(abspath $(OUTPUT_DIR)/images)
-QEMU ?= $(abspath $(OUTPUT_DIR)/host/bin/qemu-system-riscv64)
-
-MAKE_BUILDROOT = $(MAKE) -C $(BUILDROOT_DIR) O=$(OUTPUT_DIR) BR2_EXTERNAL=$(THIS_EXTERNAL_PATH) BR2_DL_DIR=$(BR2_DL_DIR) BR2_CCACHE_DIR=$(BR2_CCACHE_DIR)
-BUILDROOT_PATCHES = $(sort $(wildcard $(THIS_EXTERNAL_PATH)/patches/buildroot/*.patch))
-
-.PHONY: all configure build clean boot boot-display
-
-all: build
-
-configure:
-	@for patch in $(BUILDROOT_PATCHES); do \
-		if ! git -C $(BUILDROOT_DIR) apply --reverse --check "$$patch" 2>/dev/null; then \
-			git -C $(BUILDROOT_DIR) apply "$$patch"; \
-		fi; \
-	done
-	$(MAKE_BUILDROOT) rva23_defconfig
-
-build: configure
-	$(MAKE_BUILDROOT)
-
-clean:
-	$(MAKE_BUILDROOT) clean
-
-boot: QEMU_DISPLAY := $(if $(filter 1,$(QEMU_VNC)),-vnc 127.0.0.1:0,-display none)
-boot-display: QEMU_DISPLAY := -vnc 127.0.0.1:0
-
-boot boot-display: build
-	$(QEMU) \
-		-M virt,pflash0=pflash0,pflash1=pflash1,acpi=off \
-		-accel tcg \
-		-cpu rva23s64 \
-		-smp 4 \
-		-m 2048 \
-		-bios "$(IMAGES_DIR)/fw_dynamic.bin" \
-		-blockdev node-name=pflash0,driver=file,read-only=on,filename="$(IMAGES_DIR)/RISCV_VIRT_CODE.fd" \
-		-blockdev node-name=pflash1,driver=file,filename="$(IMAGES_DIR)/RISCV_VIRT_VARS.fd" \
-		-drive file="$(IMAGES_DIR)/disk.img",format=raw,if=virtio \
-		-device virtio-gpu-pci \
-		-device qemu-xhci \
-		-device usb-kbd \
-		-device usb-tablet \
-		$(QEMU_DISPLAY) \
-		-serial stdio
