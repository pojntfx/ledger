diff --git a/pkg/svc/files_delete_file.go b/pkg/svc/files_delete_file.go
index 6ee1ffa8b8e3e0286a9ea6eb2e8df51fb05b8746..f5a107fb4de41d895bf37c24f3d065c0ceafae71 100644
--- a/pkg/svc/files_delete_file.go
+++ b/pkg/svc/files_delete_file.go
@@ -14,6 +14,7 @@ 	DeleteFileTool = &mcp.Tool{
 		Name:        "files.deleteFile",
 		Title:       "Delete file",
 		Description: "Delete an uploaded file from the server to free up disk space; only files that have been uploaded can be deleted",
+		Annotations: &mcp.ToolAnnotations{DestructiveHint: &[]bool{true}[0]},
 	}
 
 	ErrFileNotFound = errors.New("file not found")
diff --git a/pkg/svc/files_get_files.go b/pkg/svc/files_get_files.go
index caaf16a7ce4d8dcce838acb57289089ac31ba638..2bd6ff5222c92f64f75423efac850d7c6b7373fe 100644
--- a/pkg/svc/files_get_files.go
+++ b/pkg/svc/files_get_files.go
@@ -18,6 +18,7 @@ 			`where SERVER is the scheme, host and port that this MCP server is reachable on ` +
 			`and NAME is the name that the file should have on the server, like image.img; ` +
 			`the command prints the name that the file was actually stored under, which is a sanitized version of NAME, ` +
 			`and uploading a name that already exists replaces it`,
+		Annotations: &mcp.ToolAnnotations{ReadOnlyHint: true},
 	}
 )
 
