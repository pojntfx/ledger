 }
 
-func (s *Service) GetInputDevices(ctx context.Context, req *mcp.CallToolRequest, input struct{}) (*mcp.CallToolResult, *GetInputDevicesOutput, error) {
+func listInputDevices() ([]InputDevice, error) {
 	ports, err := enumerator.GetDetailedPortsList()
 	if err != nil {
-		return nil, nil, err
+		return nil, err
 	}
 
 	inputDevices := []InputDevice{}
@@ -46,6 +49,30 @@ 		inputDevices = append(inputDevices, InputDevice{
 			Path:        port.Name,
 			USBIdentity: usbIdentityFromPort(port),
 		})
+	}
+
+	return inputDevices, nil
+}
+
+func findInputDevice(path string) (*InputDevice, error) {
+	inputDevices, err := listInputDevices()
+	if err != nil {
+		return nil, err
+	}
+
+	for _, inputDevice := range inputDevices {
+		if inputDevice.Path == path {
+			return &inputDevice, nil
+		}
+	}
+
+	return nil, ErrCouldNotFindInputDevice
+}
+
+func (s *Service) GetInputDevices(ctx context.Context, req *mcp.CallToolRequest, input struct{}) (*mcp.CallToolResult, *GetInputDevicesOutput, error) {
+	inputDevices, err := listInputDevices()
+	if err != nil {
