-func (s *Service) GetVideoCaptureDevices(ctx context.Context, req *mcp.CallToolRequest, input struct{}) (*mcp.CallToolResult, *GetVideoCaptureDevicesOutput, error) {
+func videoCaptureDeviceAt(path string) (VideoCaptureDevice, bool, error) {
+	identity, err := videoUSBIdentity(path)
+	if err != nil {
+		return VideoCaptureDevice{}, false, err
+	}
+
+	// Skip regular webcams and other video devices
+	if !isKVMVideo(identity.VendorID, identity.ProductID) {
+		return VideoCaptureDevice{}, false, nil
+	}
+
+	name, supportsMJPEG, err := videoCaptureDevice(path)
+	if err != nil {
+		return VideoCaptureDevice{}, false, err
+	}
+
+	// Skip nodes that cannot capture MJPEG, such as metadata nodes
+	if !supportsMJPEG {
+		return VideoCaptureDevice{}, false, nil
+	}
+
+	return VideoCaptureDevice{
+		Path:        path,
+		Name:        name,
+		USBIdentity: identity,
+	}, true, nil
+}
+
+func listVideoCaptureDevices() ([]VideoCaptureDevice, error) {
 	paths, err := filepath.Glob(videoDeviceGlob)
 	if err != nil {
-		return nil, nil, err
+		return nil, err
 	}
 
 	videoCaptureDevices := []VideoCaptureDevice{}
 	for _, path := range paths {
-		identity, err := videoUSBIdentity(path)
+		videoCaptureDevice, ok, err := videoCaptureDeviceAt(path)
 		if err != nil {
-			slog.Error("Could not resolve USB identity of video capture device, skipping", "path", path, "err", err)
+			slog.Error("Could not get video capture device, skipping", "path", path, "err", err)
 
 			continue
 		}
 
-		// Skip regular webcams and other video devices
-		if !isKVMVideo(identity.VendorID, identity.ProductID) {
+		if !ok {
 			continue
 		}
 
-		name, supportsMJPEG, err := videoCaptureDevice(path)
-		if err != nil {
-			slog.Error("Could not get name of video capture device, skipping", "path", path, "err", err)
+		videoCaptureDevices = append(videoCaptureDevices, videoCaptureDevice)
+	}
 
-			continue
-		}
+	return videoCaptureDevices, nil
+}
 
-		// Skip any metadata nodes; we only need the videos nodes
-		if !supportsMJPEG {
-			continue
-		}
+func findVideoCaptureDevice(path string) (*VideoCaptureDevice, error) {
+	videoCaptureDevice, ok, err := videoCaptureDeviceAt(path)
+	if err != nil {
+		return nil, err
+	}
+
+	if !ok {
+		return nil, ErrCouldNotFindVideoCaptureDevice
+	}
+
+	return &videoCaptureDevice, nil
+}
 
-		videoCaptureDevices = append(videoCaptureDevices, VideoCaptureDevice{
-			Path:        path,
-			Name:        name,
-			USBIdentity: identity,
-		})
+func (s *Service) GetVideoCaptureDevices(ctx context.Context, req *mcp.CallToolRequest, input struct{}) (*mcp.CallToolResult, *GetVideoCaptureDevicesOutput, error) {
+	videoCaptureDevices, err := listVideoCaptureDevices()
+	if err != nil {
+		return nil, nil, err
 	}
 
 	return nil, &GetVideoCaptureDevicesOutput{
