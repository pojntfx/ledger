diff --git a/pkg/svc/kvm_get_input_devices.go b/pkg/svc/kvm_get_input_devices.go
new file mode 100644
index 0000000000000000000000000000000000000000..bbe87d33afa5ec884d801c65502707947b7be8f5
--- /dev/null
+++ b/pkg/svc/kvm_get_input_devices.go
@@ -0,0 +1,50 @@
+package svc
+
+import (
+	"context"
+	"strings"
+
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+	"go.bug.st/serial/enumerator"
+)
+
+var (
+	GetInputDevicesTool = &mcp.Tool{
+		Name:        "kvm.getInputDevices",
+		Title:       "Get input devices",
+		Description: "Get all currently connected KVM devices that can emulate keyboard and mouse input on a target",
+	}
+)
+
+type InputDevice struct {
+	Path string `json:"path" jsonschema:"path that uniquely identifies the input device until it gets unplugged"`
+}
+
+type GetInputDevicesOutput struct {
+	InputDevices []InputDevice `json:"inputDevices" jsonschema:"connected input devices"`
+}
+
+func (s *Service) GetInputDevices(ctx context.Context, req *mcp.CallToolRequest, input struct{}) (*mcp.CallToolResult, *GetInputDevicesOutput, error) {
+	ports, err := enumerator.GetDetailedPortsList()
+	if err != nil {
+		return nil, nil, err
+	}
+
+	inputDevices := []InputDevice{}
+	for _, port := range ports {
+		if !port.IsUSB ||
+			!strings.EqualFold(port.VID, KVM_INPUT_VENDOR_ID) ||
+			!strings.EqualFold(port.PID, KVM_INPUT_PRODUCT_ID) {
+
+			continue
+		}
+
+		inputDevices = append(inputDevices, InputDevice{
+			Path: port.Name,
+		})
+	}
+
+	return nil, &GetInputDevicesOutput{
+		InputDevices: inputDevices,
+	}, nil
+}
