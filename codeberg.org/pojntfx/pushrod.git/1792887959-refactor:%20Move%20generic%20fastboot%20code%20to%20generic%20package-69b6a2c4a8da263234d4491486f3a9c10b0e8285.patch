-	"codeberg.org/pojntfx/pushrod/pkg/titanflasher"
+	"codeberg.org/pojntfx/pushrod/pkg/fastboot"
 	"github.com/modelcontextprotocol/go-sdk/mcp"
 )
 
@@ -27,7 +27,7 @@ 	FlashDevices []FlashDevice `json:"flashDevices" jsonschema:"connected devices in fastboot mode"`
 }
 
 func (s *Service) GetFlashDevices(ctx context.Context, req *mcp.CallToolRequest, input struct{}) (*mcp.CallToolResult, *GetFlashDevicesOutput, error) {
-	devices, err := titanflasher.GetDevices()
+	devices, err := fastboot.GetDevices()
 	if err != nil {
 		return nil, nil, err
 	}
