diff --git a/buildroot/qemu/package/k3s/Config.in b/buildroot/qemu/package/k3s/Config.in
new file mode 100644
index 0000000000000000000000000000000000000000..e594b973723a12912195df6202a3f9e33b3a1c1b
--- /dev/null
+++ b/buildroot/qemu/package/k3s/Config.in
@@ -0,0 +1,11 @@
+config BR2_PACKAGE_K3S
+	bool "k3s"
+	depends on BR2_USE_MMU
+	depends on BR2_PACKAGE_HOST_GO_TARGET_ARCH_SUPPORTS
+	depends on BR2_TOOLCHAIN_HAS_THREADS
+	select BR2_PACKAGE_HOST_GO
+	select BR2_PACKAGE_HOST_ZSTD
+	select BR2_PACKAGE_SQLITE
+	select BR2_PACKAGE_LIBSECCOMP
+	help
+	  Run k3s, a lightweight Kubernetes distribution.
diff --git a/buildroot/qemu/package/k3s/k3s.hash b/buildroot/qemu/package/k3s/k3s.hash
new file mode 100644
index 0000000000000000000000000000000000000000..0d966182771ce29efc0c44d2db39c5ebf6754b7c
--- /dev/null
+++ b/buildroot/qemu/package/k3s/k3s.hash
@@ -0,0 +1,2 @@
+sha256  624ed22beb7cdd9a31f50a65cc2b107a790dbb71fd896d8f0bda41429dd6c08f  k3s-v1.37.1+k3s1-git4.tar.gz
+sha256  0d542e0c8804e39aa7f37eb00da5a762149dc682d7829451287e11b938e94594  LICENSE
diff --git a/buildroot/qemu/package/k3s/k3s.mk b/buildroot/qemu/package/k3s/k3s.mk
new file mode 100644
index 0000000000000000000000000000000000000000..3e4fb58aa19083f5f14b16b803131a341b7edad1
--- /dev/null
+++ b/buildroot/qemu/package/k3s/k3s.mk
@@ -0,0 +1,31 @@
+K3S_VERSION = v1.37.1+k3s1
+K3S_SITE = https://github.com/k3s-io/k3s
+K3S_SITE_METHOD = git
+K3S_LICENSE = Apache-2.0
+K3S_LICENSE_FILES = LICENSE
+K3S_DEPENDENCIES = host-go host-zstd sqlite libseccomp
+
+K3S_BUILD_ENV = \
+	$(HOST_GO_TARGET_ENV) \
+	GOOS=linux GOARCH=riscv64 ARCH=riscv64 OS=linux \
+	GOPROXY=https://proxy.golang.org GOSUMDB=off GOFLAGS=-mod=mod \
+	STATIC_BUILD=false SELINUX=false
+
+define K3S_CONFIGURE_CMDS
+	$(HOST_GO_COMMON_ENV) GOPROXY=https://proxy.golang.org GOSUMDB=off GOFLAGS=-mod=mod GOBIN=$(HOST_DIR)/bin $(HOST_DIR)/bin/go install github.com/mikefarah/yq/v4@v4.54.1
+	cd $(@D) && $(K3S_BUILD_ENV) ./scripts/download
+endef
+
+define K3S_BUILD_CMDS
+	cd $(@D) && $(K3S_BUILD_ENV) ./scripts/build
+	cd $(@D) && $(K3S_BUILD_ENV) ./scripts/package-cli
+endef
+
+define K3S_INSTALL_TARGET_CMDS
+	$(INSTALL) -D -m 0755 $(@D)/dist/artifacts/k3s-riscv64 $(TARGET_DIR)/usr/bin/k3s
+	$(Q)for name in kubectl crictl ctr containerd runc cni check-config; do \
+		ln -sf k3s $(TARGET_DIR)/usr/bin/$$name; \
+	done
+endef
+
+$(eval $(generic-package))
diff --git a/buildroot/qemu/package/sbsigntools/Config.in.host b/buildroot/qemu/package/sbsigntools/Config.in.host
new file mode 100644
index 0000000000000000000000000000000000000000..2e459587851f5313d0fa753330b80a27e6b71403
--- /dev/null
+++ b/buildroot/qemu/package/sbsigntools/Config.in.host
@@ -0,0 +1,7 @@
+config BR2_PACKAGE_HOST_SBSIGNTOOLS
+	bool "host sbsigntools"
+	select BR2_PACKAGE_HOST_OPENSSL
+	help
+	  Build tools that sign and inspect UEFI PE binaries.
+
+	  https://git.kernel.org/pub/scm/linux/kernel/git/jejb/sbsigntools.git
diff --git a/buildroot/qemu/package/sbsigntools/sbsigntools.mk b/buildroot/qemu/package/sbsigntools/sbsigntools.mk
new file mode 100644
index 0000000000000000000000000000000000000000..e0ba700f02b541611fce25f58ea35e65bee16720
--- /dev/null
+++ b/buildroot/qemu/package/sbsigntools/sbsigntools.mk
@@ -0,0 +1,24 @@
+SBSIGNTOOLS_VERSION = v0.9.5
+SBSIGNTOOLS_SITE = https://git.kernel.org/pub/scm/linux/kernel/git/jejb/sbsigntools.git
+SBSIGNTOOLS_SITE_METHOD = git
+SBSIGNTOOLS_GIT_SUBMODULES = YES
+SBSIGNTOOLS_LICENSE = GPL-3.0+
+SBSIGNTOOLS_LICENSE_FILES = COPYING LICENSE.GPLv3
+HOST_SBSIGNTOOLS_DEPENDENCIES = host-openssl host-pkgconf host-autoconf host-automake host-binutils
+HOST_SBSIGNTOOLS_CONF_OPTS = --disable-static
+define HOST_SBSIGNTOOLS_INSTALL_LIBBFD
+	$(HOST_MAKE_ENV) $(MAKE) -C $(BUILD_DIR)/host-binutils-$(BINUTILS_VERSION)/bfd bfdincludedir=$(HOST_DIR)/include bfdlibdir=$(HOST_DIR)/lib install
+	$(HOST_MAKE_ENV) $(MAKE) -C $(BUILD_DIR)/host-binutils-$(BINUTILS_VERSION)/opcodes bfdincludedir=$(HOST_DIR)/include bfdlibdir=$(HOST_DIR)/lib install
+	$(HOST_MAKE_ENV) $(MAKE) -C $(BUILD_DIR)/host-binutils-$(BINUTILS_VERSION)/libiberty install
+	$(HOST_MAKE_ENV) $(MAKE) -C $(BUILD_DIR)/host-binutils-$(BINUTILS_VERSION)/libsframe install
+	cp -a $(BUILD_DIR)/host-binutils-$(BINUTILS_VERSION)/include/. $(HOST_DIR)/include/
+	cp -a $(BUILD_DIR)/host-binutils-$(BINUTILS_VERSION)/bfd/bfd.h $(HOST_DIR)/include/
+	cp -a $(BUILD_DIR)/host-binutils-$(BINUTILS_VERSION)/bfd/.libs/libbfd.a $(HOST_DIR)/lib/
+	cp -a $(BUILD_DIR)/host-binutils-$(BINUTILS_VERSION)/opcodes/.libs/libopcodes.a $(HOST_DIR)/lib/
+	cp -a $(BUILD_DIR)/host-binutils-$(BINUTILS_VERSION)/libsframe/.libs/libsframe.a $(HOST_DIR)/lib/
+endef
+define HOST_SBSIGNTOOLS_RUN_AUTOGEN
+	cd $(@D) && ./autogen.sh
+endef
+HOST_SBSIGNTOOLS_PRE_CONFIGURE_HOOKS = HOST_SBSIGNTOOLS_INSTALL_LIBBFD HOST_SBSIGNTOOLS_RUN_AUTOGEN
+$(eval $(host-autotools-package))
