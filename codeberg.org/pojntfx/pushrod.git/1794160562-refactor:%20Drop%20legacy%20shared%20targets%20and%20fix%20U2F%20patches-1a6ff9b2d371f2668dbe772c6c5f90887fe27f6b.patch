diff --git a/buildroot/scripts/fix-host-rpaths.py b/buildroot/scripts/fix-host-rpaths.py
deleted file mode 100644
index 706dd95f626a37d790f3ede3ae0fe0c16d3fb091..0000000000000000000000000000000000000000
--- a/buildroot/scripts/fix-host-rpaths.py
+++ /dev/null
@@ -1,88 +0,0 @@
-#!/usr/bin/env python3
-import os
-from pathlib import Path
-import shutil
-import subprocess
-import sys
-import tempfile
-import time
-
-
-ROOTS = ("bin", "sbin", "lib", "libexec")
-
-
-def elf(path):
-    try:
-        with path.open("rb") as file:
-            return file.read(4) == b"\x7fELF"
-    except OSError:
-        return False
-
-
-def relative(host, directory, tail):
-    rel = os.path.relpath(host / tail, directory)
-    return "$ORIGIN" if rel == "." else "$ORIGIN/" + rel
-
-
-def set_rpath(patchelf, path, rpath):
-    for _ in range(5):
-        result = subprocess.run([patchelf, "--set-rpath", rpath, str(path)], capture_output=True, text=True)
-        if result.returncode == 0:
-            return
-        if "Text file busy" not in result.stderr:
-            raise RuntimeError(f"patchelf failed for {path}: {result.stderr}")
-        time.sleep(0.5)
-    raise RuntimeError(f"patchelf cannot write {path}: file is busy")
-
-
-def main():
-    host = Path(sys.argv[1] if len(sys.argv) > 1 else Path(__file__).resolve().parent.parent / "output/host").resolve()
-    temporary = Path(tempfile.mkdtemp(prefix="rva23-patchelf-")) / "patchelf"
-    shutil.copy2(host / "bin/patchelf", temporary)
-    patchelf = str(temporary)
-    marker = f"{host.parent.name}/{host.name}/"
-    repaired = 0
-    broken = []
-    for root in ROOTS:
-        for directory, _, names in os.walk(host / root):
-            for name in names:
-                link = Path(directory) / name
-                if not elf(link):
-                    continue
-                path = Path(os.path.realpath(link))
-                directory = str(path.parent)
-                result = subprocess.run([patchelf, "--print-rpath", str(path)], capture_output=True, text=True)
-                if result.returncode != 0 or not result.stdout.strip():
-                    continue
-                entries = result.stdout.strip().split(":")
-                updated = []
-                for entry in entries:
-                    tail = entry.split("/" + marker, 1)[1] if "/" + marker in entry else None
-                    updated.append(relative(host, directory, tail) if tail is not None else entry)
-                if updated != entries:
-                    set_rpath(patchelf, path, ":".join(updated))
-                    repaired += 1
-                for entry in updated:
-                    resolved = os.path.normpath(entry.replace("$ORIGIN", directory, 1)) if entry.startswith("$ORIGIN") else entry
-                    if not (resolved == str(host) or resolved.startswith(str(host) + os.sep)):
-                        broken.append(f"{path}: {entry}")
-    for name in ("libsoftokn3.so", "libfreebl3.so"):
-        path = host / "lib" / name
-        if not path.exists():
-            continue
-        result = subprocess.run([patchelf, "--print-rpath", str(path)], capture_output=True, text=True)
-        entries = result.stdout.strip().split(":") if result.stdout.strip() else []
-        if "$ORIGIN" not in entries:
-            set_rpath(patchelf, path, ":".join(["$ORIGIN"] + [entry for entry in entries if entry]))
-            repaired += 1
-    shutil.rmtree(temporary.parent, ignore_errors=True)
-    print(f"repaired {repaired} host rpaths", flush=True)
-    if broken:
-        for line in broken[:20]:
-            print(line, file=sys.stderr)
-        print(f"{len(broken)} host rpaths need manual repair", file=sys.stderr)
-        raise SystemExit(1)
-
-
-if __name__ == "__main__":
-    main()
