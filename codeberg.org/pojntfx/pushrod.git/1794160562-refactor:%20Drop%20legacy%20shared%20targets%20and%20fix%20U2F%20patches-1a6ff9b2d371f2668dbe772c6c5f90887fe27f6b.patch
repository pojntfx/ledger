@@ -1,61 +0,0 @@
-#!/usr/bin/env python3
-from pathlib import Path
-import os
-import shutil
-import subprocess
-import sys
-
-
-def main():
-    source_output = Path(sys.argv[1]).resolve()
-    destination_output = Path(sys.argv[2]).resolve()
-    replace = "--replace" in sys.argv[3:]
-    excluded = set(arg for arg in sys.argv[3:] if arg != "--replace")
-    source_build = source_output / "build"
-    source_packages = source_output / "per-package"
-    destination_build = destination_output / "build"
-    destination_packages = destination_output / "per-package"
-    destination_build.mkdir(parents=True, exist_ok=True)
-    destination_packages.mkdir(parents=True, exist_ok=True)
-    for source_package in sorted(source_packages.glob("host-*")):
-        if source_package.name in excluded or not source_package.is_dir():
-            continue
-        destination_package = destination_packages / source_package.name
-        if replace and destination_package.exists() and not destination_package.is_symlink():
-            shutil.rmtree(destination_package)
-        if not destination_package.exists() and not destination_package.is_symlink():
-            destination_package.symlink_to(source_package, target_is_directory=True)
-            print(f"linked {source_package} -> {destination_package}")
-        for source_build_package in source_build.glob(f"{source_package.name}-*"):
-            if not source_build_package.is_dir():
-                continue
-            destination_build_package = destination_build / source_build_package.name
-            if replace and destination_build_package.exists() and not destination_build_package.is_symlink():
-                shutil.rmtree(destination_build_package)
-            if not destination_build_package.exists() and not destination_build_package.is_symlink():
-                destination_build_package.symlink_to(source_build_package, target_is_directory=True)
-                print(f"linked {source_build_package} -> {destination_build_package}")
-    sanitize_rpaths(destination_output)
-
-
-def sanitize_rpaths(destination_output):
-    patchelf = destination_output.parent / "host/bin/patchelf"
-    for directory, _, files in os.walk(destination_output / "per-package"):
-        for name in files:
-            path = os.path.join(directory, name)
-            try:
-                with open(path, "rb") as stream:
-                    if stream.read(4) != b"\x7fELF":
-                        continue
-            except OSError:
-                continue
-            result = subprocess.run([patchelf, "--print-rpath", path], capture_output=True, text=True, check=False)
-            if result.returncode != 0:
-                continue
-            rpath = result.stdout.strip()
-            if "/output/k3-uefi/" in rpath or "/output/rva23/" in rpath:
-                subprocess.run([patchelf, "--set-rpath", "$ORIGIN/../lib:$ORIGIN/../lib/systemd:$ORIGIN/../lib/swtpm", path], check=True)
-
-
-if __name__ == "__main__":
-    main()
