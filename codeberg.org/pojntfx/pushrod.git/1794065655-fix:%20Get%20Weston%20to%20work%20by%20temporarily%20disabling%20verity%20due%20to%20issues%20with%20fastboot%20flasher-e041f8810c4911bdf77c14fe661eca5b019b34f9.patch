From e041f8810c4911bdf77c14fe661eca5b019b34f9 Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Sat, 07 Nov 2026 08:34:15 -0700
Subject: [PATCH] fix: Get Weston to work by temporarily disabling verity due to issues with fastboot flasher

Signed-off-by: Felicitas Pojtinger <felicitas@pojtinger.com>
---
diff --git a/buildroot/board/rva23-qemu/dracut/99rva23/module-setup.sh b/buildroot/board/rva23-qemu/dracut/99rva23/module-setup.sh
index 6cbfe3a2e9c2bf58f2f2b96475571ef33f6b5e60..659e4c6f8a7717c273958e6dcd387b5bca6c3472 100755
--- a/buildroot/board/rva23-qemu/dracut/99rva23/module-setup.sh
+++ b/buildroot/board/rva23-qemu/dracut/99rva23/module-setup.sh
@@ -8,7 +8,10 @@     echo systemd-repart
     return 0
 }
 install() {
-    inst_multiple mkswap bootctl
+    inst_multiple mkswap bootctl sfdisk
+    inst_script "$moddir/rva23-fix-gpt.sh" /usr/bin/rva23-fix-gpt
+    inst_simple "$moddir/rva23-fix-gpt.service" "$systemdsystemunitdir/rva23-fix-gpt.service"
+    $SYSTEMCTL -q --root "$initdir" add-wants initrd-root-fs.target rva23-fix-gpt.service
     mkdir -p "${initdir}/etc"
     printf 'root::::::::\n' > "${initdir}/etc/shadow"
     ln_r /usr/bin/busybox /usr/bin/stat
diff --git a/buildroot/board/rva23-qemu/dracut/99rva23/rva23-fix-gpt.service b/buildroot/board/rva23-qemu/dracut/99rva23/rva23-fix-gpt.service
new file mode 100644
index 0000000000000000000000000000000000000000..a65c2e3d9971d0e3835a271f07912664190e6758
--- /dev/null
+++ b/buildroot/board/rva23-qemu/dracut/99rva23/rva23-fix-gpt.service
@@ -0,0 +1,13 @@
+[Unit]
+Description=Align K3 GPT metadata with the verity root hash
+DefaultDependencies=no
+Before=systemd-veritysetup.service systemd-repart.service initrd-root-fs.target
+ConditionKernelCommandLine=usrhash
+
+[Service]
+Type=oneshot
+ExecStart=/bin/bash /usr/bin/rva23-fix-gpt
+RemainAfterExit=yes
+
+[Install]
+RequiredBy=initrd-root-fs.target
diff --git a/buildroot/board/rva23-qemu/dracut/99rva23/rva23-fix-gpt.sh b/buildroot/board/rva23-qemu/dracut/99rva23/rva23-fix-gpt.sh
new file mode 100644
index 0000000000000000000000000000000000000000..65a4b4ec2f6de738dede9c02887cc423a0e1c8fc
--- /dev/null
+++ b/buildroot/board/rva23-qemu/dracut/99rva23/rva23-fix-gpt.sh
@@ -0,0 +1,56 @@
+#!/bin/bash
+set -eu
+hash="$(sed -n 's/.*usrhash=\([0-9a-f]*\).*/\1/p' /proc/cmdline)"
+[ -n "$hash" ] || exit 0
+fsuuid="${hash:0:8}-${hash:8:4}-${hash:12:4}-${hash:16:4}-${hash:20:12}"
+vuuid="${hash:32:8}-${hash:40:4}-${hash:44:4}-${hash:48:4}-${hash:52:12}"
+disk=""
+for candidate in /dev/sda /dev/vda; do
+    [ -b "$candidate" ] || continue
+    if sfdisk -d "$candidate" | grep -Eq 'usr-(riscv64|a)'; then
+        disk="$candidate"
+        break
+    fi
+done
+[ -n "$disk" ] || exit 0
+partition_by_name() {
+    sfdisk -d "$disk" | sed -n "s|/dev/[^0-9]*\([0-9][0-9]*\).*name=\"$1\".*|\1|p"
+}
+set_partition() {
+    local number="$1" label="$2" type="$3" uuid="${4:-}"
+    [ -n "$number" ] || return 0
+    sfdisk --part-label "$disk" "$number" "$label"
+    sfdisk --part-type "$disk" "$number" "$type"
+    if [ -n "$uuid" ]; then
+        sfdisk --part-uuid "$disk" "$number" "$uuid"
+    fi
+    sfdisk --part-attrs "$disk" "$number" 60
+}
+set_partition "$(partition_by_name usr-a)" usr-riscv64 beaec34b-8442-439b-a40b-984381ed097d "$fsuuid"
+set_partition "$(partition_by_name usr-riscv64)" usr-riscv64 beaec34b-8442-439b-a40b-984381ed097d "$fsuuid"
+set_partition "$(partition_by_name usr-b)" usr-secondary beaec34b-8442-439b-a40b-984381ed097d "$fsuuid"
+set_partition "$(partition_by_name usr-secondary)" usr-secondary beaec34b-8442-439b-a40b-984381ed097d "$fsuuid"
+set_partition "$(partition_by_name usr-a-verity)" usr-riscv64-verity 8f1056be-9b05-47c4-81d6-be53128e5b54 "$vuuid"
+set_partition "$(partition_by_name usr-riscv64-verity)" usr-riscv64-verity 8f1056be-9b05-47c4-81d6-be53128e5b54 "$vuuid"
+set_partition "$(partition_by_name usr-a-verity-sig)" usr-riscv64-verity-sig d2f9000a-7a18-453f-b5cd-4d32f77a7b32
+set_partition "$(partition_by_name usr-riscv64-verity-sig)" usr-riscv64-verity-sig d2f9000a-7a18-453f-b5cd-4d32f77a7b32
+root_number="$(partition_by_name rootfs)"
+[ -n "$root_number" ] || root_number="$(partition_by_name root)"
+if [ -n "$root_number" ]; then
+    sfdisk --part-label "$disk" "$root_number" root
+    sfdisk --part-type "$disk" "$root_number" 72ec70a6-cf74-40e6-bd49-4bda08e8f224
+fi
+boot_number="$(partition_by_name bootfs)"
+if [ -n "$boot_number" ]; then
+    sfdisk --part-type "$disk" "$boot_number" c12a7328-f81f-11d2-ba4b-00a0c93ec93b
+fi
+if ! sfdisk -d "$disk" | grep -q 'usr-secondary-verity"'; then
+    sfdisk --no-reread --sector-size 4096 --append "$disk" <<EOF
+start=412672, size=16384, type=8f1056be-9b05-47c4-81d6-be53128e5b54, name="usr-secondary-verity"
+start=429312, size=4, type=d2f9000a-7a18-453f-b5cd-4d32f77a7b32, name="usr-secondary-verity-sig"
+EOF
+fi
+set_partition "$(partition_by_name usr-secondary-verity)" usr-secondary-verity 8f1056be-9b05-47c4-81d6-be53128e5b54 "$vuuid"
+set_partition "$(partition_by_name usr-secondary-verity-sig)" usr-secondary-verity-sig d2f9000a-7a18-453f-b5cd-4d32f77a7b32
+udevadm trigger "$disk"
+udevadm settle
