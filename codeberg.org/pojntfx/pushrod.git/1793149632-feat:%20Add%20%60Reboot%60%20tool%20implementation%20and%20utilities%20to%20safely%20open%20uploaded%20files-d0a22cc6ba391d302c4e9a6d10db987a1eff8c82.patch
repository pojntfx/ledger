diff --git a/pkg/svc/flash_reboot.go b/pkg/svc/flash_reboot.go
new file mode 100644
index 0000000000000000000000000000000000000000..e924c6f696da9490ffa282a8a749f16f93897b87
--- /dev/null
+++ b/pkg/svc/flash_reboot.go
@@ -0,0 +1,47 @@
+package svc
+
+import (
+	"context"
+
+	"codeberg.org/pojntfx/pushrod/pkg/fastboot"
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+var (
+	RebootTool = &mcp.Tool{
+		Name:        "flash.reboot",
+		Title:       "Reboot",
+		Description: "Reboot a device out of fastboot mode",
+		Annotations: &mcp.ToolAnnotations{DestructiveHint: new(false)},
+	}
+)
+
+type RebootInput struct {
+	Path string `json:"path" jsonschema:"path that uniquely identifies the fastboot device until it gets unplugged, in BUS-PORT form like 1-2-3"`
+}
+
+type RebootOutput struct {
+	Response string `json:"response" jsonschema:"text that the device returned, if any"`
+}
+
+func (s *Service) Reboot(ctx context.Context, req *mcp.CallToolRequest, input RebootInput) (*mcp.CallToolResult, *RebootOutput, error) {
+	if err := s.flashLock.Acquire(ctx, 1); err != nil {
+		return nil, nil, err
+	}
+	defer s.flashLock.Release(1)
+
+	session, err := fastboot.OpenSession(input.Path)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer session.Close()
+
+	response, err := session.Reboot(ctx)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	return nil, &RebootOutput{
+		Response: response,
+	}, nil
+}

