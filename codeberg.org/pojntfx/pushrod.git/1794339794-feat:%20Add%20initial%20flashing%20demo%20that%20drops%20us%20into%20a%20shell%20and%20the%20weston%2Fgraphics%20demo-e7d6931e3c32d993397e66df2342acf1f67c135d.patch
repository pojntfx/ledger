diff --git a/buildroot/scripts/1-demo-flash.py b/buildroot/scripts/1-demo-flash.py
new file mode 100755
index 0000000000000000000000000000000000000000..2b797b555795a16ffc55894e0ae83ba2bde9714c
--- /dev/null
+++ b/buildroot/scripts/1-demo-flash.py
@@ -0,0 +1,177 @@
+#!/usr/bin/env python3
+import json
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+sys.path.insert(0, str(Path(__file__).parent))
+
+import demo_lib
+
+
+def images():
+    return Path(__file__).parent.parent / "output/k3-uefi/images"
+
+
+def upload(demo, local, name):
+    result = subprocess.run(["curl", "-s", "--max-time", "600", "--upload-file", str(local), f"http://127.0.0.1:1337/files/{name}", "-w", "%{http_code}"], capture_output=True, text=True)
+    if result.stdout.strip() != "204":
+        raise demo_lib.DemoError(f"upload failed for {name}: {result.stdout} {result.stderr}")
+
+
+def ensure_uploads(demo):
+    manifest_path = images().parent / ".demo-uploads.json"
+    manifest = json.loads(manifest_path.read_text()) if manifest_path.exists() else {}
+    files = demo_lib.mcp_call("files.getFiles", {}).get("files", [])
+    for name in ("FSBL.bin", "u-boot.itb", "bootfs.img", "usr-a.erofs", "usr-b.erofs", "usr-a.verity", "usr-a.verity-sig", "rootfs.ext4", "env.bin", "bootinfo_block.bin", "esos.itb", "fw_dynamic.itb", "edk2.itb"):
+        local = images() / name
+        if name == "FSBL.bin":
+            local = images() / "factory/FSBL.bin"
+        if name == "bootinfo_block.bin":
+            local = images() / "factory/bootinfo_block.bin"
+        stamp = f"{local.stat().st_size}:{int(local.stat().st_mtime)}"
+        if name not in files or manifest.get(name) != stamp:
+            demo.step(f"Upload {name}")
+            upload(demo, local, name)
+            manifest[name] = stamp
+    manifest_path.write_text(json.dumps(manifest, indent=1) + "\n")
+
+
+def retry(function, attempts=6, delay=2):
+    last = None
+    for _ in range(attempts):
+        try:
+            return function()
+        except demo_lib.DemoError as error:
+            last = error
+            time.sleep(delay)
+    raise last
+
+
+def wait_device(demo, manufacturer):
+    deadline = time.monotonic() + 120
+    while time.monotonic() < deadline:
+        try:
+            devices = retry(lambda: demo_lib.mcp_call("flash.getDevices", {})).get("flashDevices", [])
+        except demo_lib.DemoError:
+            time.sleep(2)
+            continue
+        for device in devices:
+            if device.get("manufacturer") == manufacturer:
+                demo.result(f"{manufacturer} device at {device['path']}")
+                return device["path"]
+        time.sleep(2)
+    raise demo_lib.DemoError(f"no {manufacturer} device appeared")
+
+
+def main():
+    demo = demo_lib.Demo(
+        "Demo 1: from a blank board to a shell",
+        "The agent presses the buttons, stages the boot chain, and writes the disk over USB",
+    )
+    demo.banner()
+    demo.cue("Watch the screen: the board shows EDK2, then a flashing cursor, then a login")
+    demo.step("Read the devices and put the board into download mode")
+    try:
+        demo_lib.mcp_call("serial.startBuffering", {"path": "/dev/ttyUSB0"})
+        demo_lib.mcp_call("serial.clearBuffer", {"path": "/dev/ttyUSB0"})
+    except demo_lib.DemoError:
+        pass
+    ensure_uploads(demo)
+    relay = demo_lib.mcp_call("relay.getBoards", {}).get("boards", [])
+    if not relay:
+        raise demo_lib.DemoError("no relay board is connected")
+    relay_path = relay[0]["path"]
+    demo.result(f"relay board at {relay_path}")
+
+    devices = demo_lib.mcp_call("flash.getDevices", {}).get("flashDevices", [])
+    if not any(device.get("manufacturer") == "DFU" for device in devices):
+        retry(lambda: demo_lib.mcp_call("target.reset", {"path": relay_path}))
+        demo.pause(1)
+        retry(lambda: demo_lib.mcp_call("target.enterFDL", {"path": relay_path}))
+        demo.result("reset and FDL relays pulsed")
+        demo.pause(2)
+    path = wait_device(demo, "DFU")
+    demo.note("DFU means BROM: it answers OKAY and writes nothing, so stage the first stage")
+
+    demo.step("Stage the first-stage loader")
+    retry(lambda: demo_lib.mcp_call("flash.stage", {"path": path, "file": "FSBL.bin"}))
+    retry(lambda: demo_lib.mcp_call("flash.continue", {"path": path}))
+    demo.pause(3)
+    path = wait_device(demo, "U-Boot")
+
+    demo.step("Stage U-Boot and enter fastboot")
+    retry(lambda: demo_lib.mcp_call("flash.stage", {"path": path, "file": "u-boot.itb"}))
+    retry(lambda: demo_lib.mcp_call("flash.continue", {"path": path}))
+    demo.pause(4)
+    path = wait_device(demo, "U-Boot")
+
+    demo.step("Build the partition tables from offset and size")
+    tables = []
+    mtd_size = demo_lib.mcp_call("flash.getVar", {"path": path, "variable": "mtd-size"}).get("value")
+    mtd_file = images() / f"partition_{mtd_size}.json" if mtd_size else None
+    if mtd_file is not None and mtd_file.exists():
+        tables.append(json.loads(mtd_file.read_text()))
+        demo.note(f"mtd table: {mtd_file.name}")
+    universal = json.loads((images() / "partition_universal.json").read_text())
+    tables.append(universal)
+    for table in tables:
+        entries = []
+        for partition in table["partitions"]:
+            entry = {"name": partition["name"], "offset": partition["offset"], "size": partition["size"], "image": partition["image"].split("/")[-1]}
+            for key in ("hidden", "compress", "type"):
+                if key in partition:
+                    entry[key] = partition[key]
+            entries.append(entry)
+        table["partitions"] = entries
+    demo.result(f"{[len(table['partitions']) for table in tables]} partitions, one write call")
+    demo.step("Write every partition and reboot")
+    job = demo_lib.mcp_call("flash.multiFlash", {"path": path, "reboot": True, "background": True, "partitionTables": tables})
+    job_id = job["jobId"]
+    deadline = time.monotonic() + 900
+    while time.monotonic() < deadline:
+        jobs = demo_lib.mcp_call("flash.getJobs", {}).get("jobs", [])
+        current = next((item for item in jobs if item["id"] == job_id), None)
+        if current:
+            sent, total = current.get("sentBytes", 0), current.get("totalBytes", 1)
+            demo.note(f"{current.get('partition')}: {sent / total * 100:.0f}% ({sent // (1024 * 1024)} MiB of {total // (1024 * 1024)} MiB)")
+            if current["status"] == "succeeded":
+                demo.result("the flash finished")
+                break
+            if current["status"] == "failed":
+                raise demo_lib.DemoError(current.get("error", "flash failed"))
+        time.sleep(2)
+    else:
+        raise demo_lib.DemoError("the flash did not finish in time")
+
+    demo.step("Reset the board and wait for the shell")
+    for attempt in range(2):
+        retry(lambda: demo_lib.mcp_call("target.reset", {"path": relay_path}))
+        demo.pause(5)
+        try:
+            demo.k3.wait(300)
+            break
+        except demo_lib.DemoError:
+            demo.note(f"no shell after reset {attempt + 1}, resetting again")
+    else:
+        raise demo_lib.DemoError("the board did not come back after two resets; unplug the board and plug it back in")
+    banner = demo.k3.run("hostname; cat /proc/sys/kernel/hostname; uname -m").stdout.strip()
+    demo.result(banner.replace("\n", ", "))
+
+    demo.step("Show the last lines of the serial boot log")
+    try:
+        serial_output = demo_lib.mcp_call("serial.readFrom", {"path": "/dev/ttyUSB0"}).get("output", "")
+        lines = [line.strip() for line in serial_output.replace("\r", "\n").split("\n") if line.strip()]
+        for line in lines[-6:]:
+            demo.note(line)
+    except demo_lib.DemoError:
+        demo.note("the serial console returned no output")
+
+    demo.payoff("A blank board now boots a signed UKI into a read-only system tree")
+    demo.ui("the board", "serial console / webcam")
+    return demo.finish()
+
+
+if __name__ == "__main__":
+    demo_lib.run(main)
diff --git a/buildroot/scripts/2-demo-weston.py b/buildroot/scripts/2-demo-weston.py
new file mode 100755
index 0000000000000000000000000000000000000000..f839b9a19a630f3c332b13a3f21f0f93964c8bee
--- /dev/null
+++ b/buildroot/scripts/2-demo-weston.py
@@ -0,0 +1,88 @@
+#!/usr/bin/env python3
+from pathlib import Path
+import subprocess
+import time
+import sys
+
+sys.path.insert(0, str(Path(__file__).parent))
+
+import demo_lib
+
+SCREENSHOTS = Path(__file__).parent.parent / "output/demo/screenshots"
+SCREENSHOT_FILE = Path("/tmp/demo-weston-screenshot.txt")
+
+
+def screenshot(demo, name):
+    path = demo_lib.screenshot(SCREENSHOTS / name)
+    demo.result(f"screenshot: {path}")
+    return path
+
+
+def weston_state(demo):
+    return demo.k3.run("systemctl is-active weston.service", check=False).stdout.strip()
+
+
+def main():
+    demo = demo_lib.Demo(
+        "Demo 2: the agent fixes the blank screen",
+        "The image ships Weston off, one enable file turns it on, and the desktop appears",
+    )
+    demo.banner()
+    demo.cue("Watch the screen: it shows a console, then the desktop appears")
+
+    demo.step("Show the screen before the fix")
+    demo.k3.run("systemctl stop weston.service 2>/dev/null || true", check=False)
+    demo.k3.run("rm -rf /var/lib/weston")
+    deadline = time.monotonic() + 10
+    while time.monotonic() < deadline and weston_state(demo) == "active":
+        time.sleep(1)
+    if weston_state(demo) == "active":
+        raise demo_lib.DemoError("weston is still running")
+    demo.result("no desktop, the board shows the console")
+    screenshot(demo, "weston-black.jpg")
+
+    demo.step("Enable Weston with one file")
+    demo.k3.run("mkdir -p /var/lib/weston")
+    demo.k3.run("touch /var/lib/weston/enabled")
+    demo.note("the image watches /var/lib/weston/enabled with a path unit")
+    deadline = time.monotonic() + 20
+    while time.monotonic() < deadline and weston_state(demo) != "active":
+        demo.k3.run("systemctl start weston.service 2>/dev/null || true", check=False)
+        time.sleep(1)
+    if weston_state(demo) != "active":
+        raise demo_lib.DemoError("weston did not start")
+    demo.result("weston is active, the desktop is up")
+    screenshot(demo, "weston-desktop.jpg")
+
+    demo.step("Start the terminal that the extension carries")
+    demo.k3.run("pkill -f weston-terminal 2>/dev/null || true")
+    demo.k3.run("XDG_RUNTIME_DIR=/run/weston WAYLAND_DISPLAY=wayland-1 weston-terminal >/tmp/demo-terminal.log 2>&1 &")
+    if demo.k3.run("command -v weston-terminal", check=False).returncode != 0:
+        raise demo_lib.DemoError("weston-terminal is missing from the merged extension")
+    demo.result("weston-terminal runs from the merged extension")
+
+    demo.step("Start the EGL gears that the extension carries")
+    demo.k3.run("pkill -f es2gears_wayland 2>/dev/null || true")
+    demo.k3.run("PVR_I_WANT_A_BROKEN_VULKAN_DRIVER=1 MESA_LOG_LEVEL=debug XDG_RUNTIME_DIR=/run/weston WAYLAND_DISPLAY=wayland-1 es2gears_wayland >/tmp/demo-gears.log 2>&1 &")
+    alive = "0"
+    for _ in range(10):
+        alive = demo.k3.run("ps | grep -c '[e]s2gears'", check=False).stdout.strip()
+        if alive not in ("", "0"):
+            break
+        time.sleep(1)
+    if alive in ("", "0"):
+        raise demo_lib.DemoError("es2gears_wayland did not stay up")
+    demo.result("es2gears_wayland renders on the merged extension")
+    final = screenshot(demo, "weston-terminal.jpg")
+
+    demo.step("Write the screenshot path and open it")
+    SCREENSHOT_FILE.write_text(str(final) + "\n")
+    demo.result(f"path: {SCREENSHOT_FILE} -> {final}")
+    subprocess.Popen(["xdg-open", str(final)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
+    demo.payoff("The agent watched the screen, enabled the unit with one file, and the desktop appeared")
+    return demo.finish()
+
+
+if __name__ == "__main__":
+    demo_lib.run(main)
