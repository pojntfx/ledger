@@ -0,0 +1,418 @@
+#!/usr/bin/env python3
+import base64
+import json
+import os
+import re
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import time
+import urllib.error
+import urllib.request
+
+
+RESET = "\033[0m"
+BOLD = "\033[1m"
+DIM = "\033[2m"
+GREEN = "\033[32m"
+CYAN = "\033[36m"
+YELLOW = "\033[33m"
+RED = "\033[31m"
+
+K3_HOST = os.environ.get("K3_SSH", "fe80::b28c:b3ff:fe9a:79a8%wlp0s20f3")
+K3_KEY = os.environ.get("K3_SSH_KEY", str(Path(__file__).parent.parent / "output/k3-uefi/build/k3-keys/root_ed25519"))
+MCP_URL = os.environ.get("PUSHROD_MCP_URL", "http://127.0.0.1:1337/")
+EVENT_UI = os.environ.get("RVA23_EVENT_URL", "http://[::1]:8086")
+REPORT_UI = os.environ.get("RVA23_REPORT_URL", "http://[::1]:8080")
+WALLET_UI = os.environ.get("RVA23_WALLET_URL", "http://[::1]:8081")
+MIGRATION_UI = os.environ.get("RVA23_MIGRATION_URL", "http://[::1]:8083")
+
+
+class DemoError(RuntimeError):
+    pass
+
+
+def mcp_result(tool, arguments):
+    body = json.dumps({"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": tool, "arguments": arguments}}).encode()
+    request = urllib.request.Request(MCP_URL, data=body, headers={"Content-Type": "application/json", "Accept": "application/json, text/event-stream"})
+    with urllib.request.urlopen(request, timeout=600) as response:
+        raw = response.read().decode()
+    payload = None
+    for line in raw.splitlines():
+        if line.startswith("data: "):
+            payload = json.loads(line[6:])
+    if payload is None:
+        raise DemoError(f"no MCP response for {tool}")
+    if "error" in payload:
+        raise DemoError(payload["error"])
+    result = payload["result"]
+    if result.get("isError"):
+        raise DemoError(result["content"][0]["text"])
+    return result
+
+
+def mcp_call(tool, arguments):
+    return mcp_result(tool, arguments).get("structuredContent", {})
+
+
+def upload_report(k3, retries=3):
+    url = board_url(8080) + "/reports"
+    last = ""
+    for _ in range(retries):
+        result = k3.run(f"/usr/lib/systemd/systemd-report upload --url={url} --sign=require-one", 300, check=False)
+        output = result.stdout + result.stderr
+        match = re.search(r"finished successfully with code (\d+): (\{.*\})", output)
+        if match:
+            return url, int(match.group(1)), json.loads(match.group(2))
+        last = output
+        k3.run("systemctl restart systemd-report-sign-tpm2.socket")
+        k3.run("systemctl restart swtpm.service")
+        time.sleep(3)
+        k3.run("TPM2TOOLS_TCTI=swtpm:host=::1,port=2321 tpm2_flushcontext -t 2>/dev/null || true")
+    raise DemoError(f"the report upload failed: {last}")
+
+
+def restart_demo_servers(target="K3"):
+    subprocess.run(["pkill", "-f", "^/home/pojntfx/Projets/pushrod/buildroot/output/demo/(report-receiver|wallet-server|migration-server|event-explorer)"])
+    time.sleep(2)
+    root = Path(__file__).parent.parent / "output/demo"
+    environment = os.environ.copy()
+    environment["RVA23_EVENT_TARGET"] = target
+    environment["RVA23_MIGRATION_VM1_KEY_FILE"] = str(root / "attestation/public-key.pem")
+    environment["RVA23_MIGRATION_VM2_KEY_FILE"] = str(root / "attestation/public-key.pem")
+    environment["RVA23_WALLET_CONSENT_DIR"] = str(root / "wallet")
+    log = (root / "demo-servers.log").open("a")
+    subprocess.Popen(["python3", str(Path(__file__).parent / "run-demo-servers.py")], env=environment, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
+    deadline = time.monotonic() + 120
+    while time.monotonic() < deadline:
+        listeners = subprocess.run(["ss", "-ltn"], capture_output=True, text=True).stdout
+        if all(f":{port} " in listeners for port in (8080, 8081, 8083, 8086)):
+            return
+        time.sleep(2)
+    raise DemoError("the demo servers did not start")
+
+
+def ensure_wallet_client(k3):
+    if k3.run("test -x /var/tmp/wallet-client", check=False).returncode == 0:
+        return "/var/tmp/wallet-client"
+    source = Path(__file__).parent
+    binary = Path("/tmp/wallet-client-rva23")
+    environment = os.environ.copy()
+    environment.update({"GOWORK": "off", "GOOS": "linux", "GOARCH": "riscv64", "CGO_ENABLED": "0"})
+    subprocess.run(["go", "build", "-o", str(binary), "wallet-client.go", "u2f.go"], cwd=source, env=environment, check=True)
+    host = k3.host.removeprefix("root@")
+    destination = f"root@[{host}]:/var/tmp/wallet-client" if ":" in host else k3.host
+    family = ["-6"] if ":" in host else []
+    subprocess.run(["scp", *family, "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes", "-o", "StrictHostKeyChecking=no", "-i", k3.key, str(binary), destination], check=True)
+    k3.run("chmod +x /var/tmp/wallet-client")
+    return "/var/tmp/wallet-client"
+
+
+def provision_fido2(k3, directory, host_directory=None):
+    k3.run(f"mkdir -p {directory}")
+    with tempfile.TemporaryDirectory() as temporary:
+        temporary = Path(temporary)
+        subprocess.run(["openssl", "ecparam", "-name", "prime256v1", "-genkey", "-noout", "-out", temporary / "private-key.pem"], check=True)
+        subprocess.run(["openssl", "req", "-batch", "-new", "-x509", "-key", temporary / "private-key.pem", "-out", temporary / "certificate.pem", "-days", "3650", "-subj", "/CN=RVA23 software FIDO2/"], check=True)
+        (temporary / "counter").write_bytes(b"\0\0\0\0")
+        for name in ("private-key.pem", "certificate.pem", "counter"):
+            k3.put(temporary / name, f"{directory}/{name}")
+        if host_directory:
+            host_directory = Path(host_directory)
+            host_directory.mkdir(parents=True, exist_ok=True)
+            (host_directory / "certificate.pem").write_bytes((temporary / "certificate.pem").read_bytes())
+
+
+def resp_ping(host, port, zone, timeout=6):
+    import socket
+    sock = socket.socket(socket.AF_INET6, socket.SOCK_STREAM)
+    sock.settimeout(timeout)
+    sock.connect((host, port, 0, socket.if_nametoindex(zone)))
+    try:
+        sock.sendall(b"PING\r\n")
+        if b"+PONG" not in sock.recv(100):
+            raise DemoError(f"no PONG from {port}")
+    finally:
+        sock.close()
+
+
+def screenshot(destination, device=os.environ.get("DEMO_KVM_DEVICE", "/dev/video4")):
+    result = mcp_result("kvm.takeScreenshot", {"path": device})
+    for item in result.get("content", []):
+        if item.get("type") == "image":
+            destination = Path(destination)
+            destination.parent.mkdir(parents=True, exist_ok=True)
+            destination.write_bytes(base64.b64decode(item["data"]))
+            return destination
+    raise DemoError("the KVM returned no image")
+
+
+def host_ip():
+    if os.environ.get("DEMO_HOST_IP"):
+        return os.environ["DEMO_HOST_IP"]
+    result = subprocess.run(["ip", "-4", "route", "get", "1.1.1.1"], capture_output=True, text=True)
+    for token in result.stdout.split():
+        if token.startswith("src"):
+            continue
+    fields = result.stdout.split()
+    return fields[fields.index("src") + 1]
+
+
+def interface():
+    return os.environ.get("DEMO_BOARD_INTERFACE", "wlP4p1s0")
+
+
+def host_interface():
+    return os.environ.get("DEMO_HOST_INTERFACE", "wlp0s20f3")
+
+
+def host_link_local():
+    if os.environ.get("DEMO_HOST_LL"):
+        return os.environ["DEMO_HOST_LL"]
+    result = subprocess.run(["ip", "-6", "addr", "show", os.environ.get("DEMO_HOST_INTERFACE", "wlp0s20f3")], capture_output=True, text=True)
+    for line in result.stdout.splitlines():
+        fields = line.split()
+        if len(fields) > 1 and fields[0] == "inet6" and fields[1].startswith("fe80:"):
+            return fields[1].split("/")[0]
+    raise DemoError("no IPv6 link-local address on the host interface")
+
+
+def board_link_local():
+    if os.environ.get("DEMO_BOARD_LL"):
+        return os.environ["DEMO_BOARD_LL"]
+    return K3_HOST.split("%")[0].removeprefix("root@")
+
+
+def board_url(port):
+    return f"http://[{host_link_local()}%25{interface()}]:{port}"
+
+
+def http_json(url, timeout=30):
+    with urllib.request.urlopen(url, timeout=timeout) as response:
+        return json.loads(response.read().decode())
+
+
+def event_state():
+    return http_json(EVENT_UI + "/api/state")
+
+
+def wait_http(url, timeout=60):
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        try:
+            http_json(url, timeout=5)
+            return
+        except (urllib.error.URLError, OSError, ValueError):
+            time.sleep(1)
+    raise DemoError(f"service did not answer in time: {url}")
+
+
+
+
+def serial_console():
+    consoles = mcp_call("serial.getConsoles", {}).get("consoles", [])
+    for console in consoles:
+        if console.get("isBuffering") or console.get("bufferedBytes") is not None:
+            return console["path"]
+    return consoles[0]["path"] if consoles else None
+
+
+class SerialShell:
+    def __init__(self, path):
+        self.path = path
+        mcp_call("serial.startBuffering", {"path": path})
+
+    def read(self):
+        return mcp_call("serial.readFrom", {"path": self.path}).get("output", "")
+
+    def send(self, data, wait=1.0):
+        mcp_call("serial.writeTo", {"path": self.path, "data": data, "waitMs": int(wait * 1000)})
+        return self.read()
+
+    def command(self, command, timeout=12):
+        marker = f"__SER_{time.monotonic_ns()}__"
+        mcp_call("serial.writeTo", {"path": self.path, "data": f"{command}; printf '\n{marker}:%s\n' \"$?\"", "waitMs": 0})
+        deadline = time.monotonic() + timeout
+        buffer = ""
+        while time.monotonic() < deadline:
+            buffer += self.read()
+            if marker in buffer:
+                return buffer.split(marker)[0]
+            time.sleep(0.3)
+        return buffer
+
+    def ensure_shell(self, timeout=30):
+        mcp_call("serial.clearBuffer", {"path": self.path})
+        output = self.send("\n", 1.0)
+        if "login:" in output:
+            output = self.send("root\n", 2.0)
+        deadline = time.monotonic() + timeout
+        while "# " not in output and time.monotonic() < deadline:
+            output += self.send("\n", 1.0)
+        if "# " not in output:
+            raise DemoError("the serial console did not answer with a shell")
+
+
+def serial_network():
+    path = serial_console()
+    if path is None:
+        return None
+    shell = SerialShell(path)
+    try:
+        shell.ensure_shell()
+    except DemoError:
+        return None
+    interface = ""
+    match = re.search(r"Interface (\S+)", shell.command("iw dev 2>/dev/null"))
+    if match:
+        interface = match.group(1)
+    if not interface:
+        match = re.search(r"\b(\w+): <BROADCAST", shell.command("ip link show 2>/dev/null"))
+        interface = match.group(1) if match else ""
+    addresses = shell.command(f"ip -6 addr show dev {interface} scope link 2>/dev/null" if interface else "ip -6 addr show scope link 2>/dev/null")
+    match = re.search(r"inet6 (fe80:[0-9a-f:]+)", addresses)
+    if match:
+        return match.group(1), interface
+    shell.command("systemctl restart k3-wifi.service 2>/dev/null || systemctl restart wifi.service 2>/dev/null || true")
+    time.sleep(8)
+    interface = ""
+    match = re.search(r"Interface (\S+)", shell.command("iw dev 2>/dev/null"))
+    if match:
+        interface = match.group(1)
+    addresses = shell.command(f"ip -6 addr show dev {interface} scope link 2>/dev/null" if interface else "ip -6 addr show scope link 2>/dev/null")
+    match = re.search(r"inet6 (fe80:[0-9a-f:]+)", addresses)
+    return (match.group(1), interface) if match else None
+
+
+def is_connection_error(text):
+    markers = ("Connection timed out", "Connection refused", "No route to host", "Network is unreachable", "Cannot assign requested address", "Connection closed", "kex_exchange_identification")
+    return any(marker in text for marker in markers)
+
+
+class K3:
+    def __init__(self, host=K3_HOST, key=K3_KEY):
+        self.host = host if host.startswith("root@") else f"root@{host}"
+        self.key = key
+        self.recovered = False
+
+    def ssh(self, command, timeout):
+        family = ["-6"] if ":" in self.host else []
+        return subprocess.run(
+            ["ssh", *family, "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes", "-o", "StrictHostKeyChecking=no",
+             "-o", "ConnectTimeout=10", "-i", self.key, self.host, command],
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+
+    def recover(self):
+        network = serial_network()
+        if network is None:
+            return False
+        address, interface = network
+        self.host = f"root@{address}%{interface}" if interface else f"root@{address}"
+        self.recovered = True
+        return True
+
+    def run(self, command, timeout=120, check=True):
+        try:
+            result = self.ssh(command, timeout)
+        except subprocess.TimeoutExpired:
+            if self.recovered or not self.recover():
+                raise
+            result = self.ssh(command, timeout)
+        if result.returncode != 0 and is_connection_error(result.stderr) and not self.recovered and self.recover():
+            result = self.ssh(command, timeout)
+        if check and result.returncode != 0:
+            raise DemoError(f"board command failed: {command}\n{result.stderr[-2000:]}")
+        return result
+
+    def put(self, source, destination):
+        data = base64.b64encode(Path(source).read_bytes()).decode()
+        self.run(f"printf %s {data} | base64 -d > {destination}")
+
+    def wait(self, timeout=600):
+        deadline = time.monotonic() + timeout
+        while time.monotonic() < deadline:
+            try:
+                if self.run("true", timeout=15, check=False).returncode == 0:
+                    return
+            except (subprocess.TimeoutExpired, OSError):
+                pass
+            time.sleep(3)
+        raise DemoError("the board did not come back")
+
+
+class Demo:
+    def __init__(self, title, subtitle=None, speed=None):
+        self.title = title
+        self.subtitle = subtitle
+        self.speed = float(speed or os.environ.get("DEMO_SPEED", "1"))
+        self.started = time.monotonic()
+        self.steps = []
+        self.cues = []
+        self.payoff_text = None
+        self.k3 = K3()
+
+    def _sleep(self, seconds):
+        if seconds > 0:
+            time.sleep(seconds * self.speed)
+
+    def banner(self):
+        line = "=" * 72
+        print(f"\n{BOLD}{CYAN}{line}{RESET}")
+        print(f"{BOLD}{CYAN} {self.title}{RESET}")
+        if self.subtitle:
+            print(f"{DIM} {self.subtitle}{RESET}")
+        print(f"{BOLD}{CYAN}{line}{RESET}\n", flush=True)
+
+    def cue(self, text):
+        self.cues.append(text)
+        print(f"{CYAN}  CUE     {RESET}{text}", flush=True)
+
+    def step(self, text):
+        number = len(self.steps) + 1
+        self.steps.append((number, text))
+        print(f"{BOLD}{GREEN}  [{number:02d}]     {RESET}{text}", flush=True)
+        return number
+
+    def note(self, text):
+        print(f"{DIM}           {text}{RESET}", flush=True)
+
+    def result(self, text):
+        print(f"{GREEN}    OK   {RESET}{text}", flush=True)
+
+    def payoff(self, text):
+        self.payoff_text = text
+        print(f"\n{BOLD}{GREEN}  PAYOFF  {RESET}{BOLD}{text}{RESET}\n", flush=True)
+
+    def ui(self, label, url):
+        print(f"{YELLOW}  UI      {RESET}{label}: {url}", flush=True)
+
+    def pause(self, seconds):
+        self._sleep(seconds)
+
+    def shell(self, command, timeout=300, check=True):
+        result = subprocess.run(command, shell=True, capture_output=True, text=True, timeout=timeout)
+        if check and result.returncode != 0:
+            raise DemoError(f"command failed: {command}\n{result.stderr[-2000:]}")
+        return result
+
+    def finish(self):
+        elapsed = time.monotonic() - self.started
+        print(f"{BOLD}{GREEN}  DEMO COMPLETE{RESET} {self.title} in {elapsed:.1f}s", flush=True)
+        if self.payoff_text:
+            print(f"{BOLD}  {self.payoff_text}{RESET}\n", flush=True)
+        return 0
+
+
+def run(main_function):
+    try:
+        sys.exit(main_function())
+    except KeyboardInterrupt:
+        print(f"\n{RED}  INTERRUPTED{RESET}", flush=True)
+        sys.exit(130)
+    except DemoError as error:
+        print(f"\n{RED}  DEMO FAILED: {error}{RESET}", flush=True)
+        sys.exit(1)
