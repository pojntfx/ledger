From 3b88e5a7d59d65a39476a555fdf4be711c113698 Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Fri, 30 Oct 2026 22:35:36 -0700
Subject: [PATCH] docs: Add warning regarding `superSpeed` surviving target resets

Signed-off-by: Felicitas Pojtinger <felicitas@pojtinger.com>
---
diff --git a/pkg/svc/flash_oem.go b/pkg/svc/flash_oem.go
index 35baae9ef5198ff96ce1c33b67a4da51ede07dd9..a5591ca6afbc6c9507af42e4ec5253b9a9eb8e13 100644
--- a/pkg/svc/flash_oem.go
+++ b/pkg/svc/flash_oem.go
@@ -11,7 +11,7 @@ var (
 	OEMTool = &mcp.Tool{
 		Name:        "flash.oem",
 		Title:       "Run OEM command",
-		Description: "Run an OEM command on a device in fastboot mode",
+		Description: "Run an OEM command on a fastboot device. speed:super-speed sets a SoC register that survives target.reset and can break enumeration on a USB 2 link. Undo it with speed:high-speed",
 		Annotations: &mcp.ToolAnnotations{DestructiveHint: new(true)},
 	}
 )

