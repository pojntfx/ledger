+	"encoding/json"
+	"encoding/pem"
+	"math/big"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestVerifyFido2ConsentRegistrationAttestation(t *testing.T) {
+	attestationKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	consentKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now()
+	template := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "U2F test"}, NotBefore: now.Add(-time.Hour), NotAfter: now.Add(time.Hour)}
+	certificateDER, err := x509.CreateCertificate(rand.Reader, template, template, &attestationKey.PublicKey, attestationKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	directory := t.TempDir()
+	if err := os.Mkdir(filepath.Join(directory, "u2f"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	certificatePEM := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: certificateDER})
+	if err := os.WriteFile(filepath.Join(directory, "u2f", "certificate.pem"), certificatePEM, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	application := make([]byte, 32)
+	if _, err := rand.Read(application); err != nil {
+		t.Fatal(err)
+	}
+	registrationChallenge := make([]byte, 32)
+	if _, err := rand.Read(registrationChallenge); err != nil {
+		t.Fatal(err)
+	}
+	keyHandle := make([]byte, 48)
+	if _, err := rand.Read(keyHandle); err != nil {
+		t.Fatal(err)
+	}
+	publicDER, err := x509.MarshalPKIXPublicKey(&consentKey.PublicKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	publicPEM := pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: publicDER})
+	publicBytes := make([]byte, 65)
+	publicBytes[0] = 4
+	consentKey.X.FillBytes(publicBytes[1:33])
+	consentKey.Y.FillBytes(publicBytes[33:65])
+	registrationMessage := []byte{0}
+	registrationMessage = append(registrationMessage, application...)
+	registrationMessage = append(registrationMessage, registrationChallenge...)
+	registrationMessage = append(registrationMessage, keyHandle...)
+	registrationMessage = append(registrationMessage, publicBytes...)
+	registrationDigest := sha256.Sum256(registrationMessage)
+	registrationSignature, err := ecdsa.SignASN1(rand.Reader, attestationKey, registrationDigest[:])
+	if err != nil {
+		t.Fatal(err)
+	}
+	nonce := make([]byte, 32)
+	if _, err := rand.Read(nonce); err != nil {
+		t.Fatal(err)
+	}
+	counter := make([]byte, 4)
+	binary.BigEndian.PutUint32(counter, 7)
+	consentMessage := append([]byte{}, application...)
+	consentMessage = append(consentMessage, 1)
+	consentMessage = append(consentMessage, counter...)
+	consentMessage = append(consentMessage, nonce...)
+	consentDigest := sha256.Sum256(consentMessage)
+	consentSignature, err := ecdsa.SignASN1(rand.Reader, consentKey, consentDigest[:])
+	if err != nil {
+		t.Fatal(err)
+	}
+	proof := u2fConsent{
+		PublicKey:             string(publicPEM),
+		Certificate:           base64.RawURLEncoding.EncodeToString(certificateDER),
+		KeyHandle:             base64.RawURLEncoding.EncodeToString(keyHandle),
+		RegistrationChallenge: base64.RawURLEncoding.EncodeToString(registrationChallenge),
+		RegistrationSignature: base64.RawURLEncoding.EncodeToString(registrationSignature),
+		Signature:             base64.RawURLEncoding.EncodeToString(consentSignature),
+		Counter:               7,
+	}
+	encoded, err := json.Marshal(proof)
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := &walletServer{consentDir: directory}
+	input := signRequest{Nonce: base64.RawURLEncoding.EncodeToString(nonce), ConsentProof: base64.RawURLEncoding.EncodeToString(encoded)}
+	contractDigest := hex.EncodeToString(application)
+	if err := server.verifyFido2Consent(input, contractDigest); err != nil {
+		t.Fatal(err)
+	}
+	registrationSignature[len(registrationSignature)-1] ^= 1
+	proof.RegistrationSignature = base64.RawURLEncoding.EncodeToString(registrationSignature)
+	encoded, err = json.Marshal(proof)
+	if err != nil {
+		t.Fatal(err)
+	}
+	input.ConsentProof = base64.RawURLEncoding.EncodeToString(encoded)
+	if err := server.verifyFido2Consent(input, contractDigest); err == nil {
+		t.Fatal("forged registration attestation signature passed")
+	}
+	proof.RegistrationSignature = base64.RawURLEncoding.EncodeToString(registrationSignature)
+	registrationSignature[len(registrationSignature)-1] ^= 1
+	proof.RegistrationSignature = base64.RawURLEncoding.EncodeToString(registrationSignature)
+	consentSignature[len(consentSignature)-1] ^= 1
+	proof.Signature = base64.RawURLEncoding.EncodeToString(consentSignature)
+	encoded, err = json.Marshal(proof)
+	if err != nil {
+		t.Fatal(err)
+	}
+	input.ConsentProof = base64.RawURLEncoding.EncodeToString(encoded)
+	if err := server.verifyFido2Consent(input, contractDigest); err == nil {
+		t.Fatal("forged consent signature passed")
+	}
+}

