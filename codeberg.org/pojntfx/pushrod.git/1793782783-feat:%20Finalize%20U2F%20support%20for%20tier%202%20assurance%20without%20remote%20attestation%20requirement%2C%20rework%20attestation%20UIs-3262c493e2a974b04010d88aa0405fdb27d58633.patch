diff --git a/buildroot/qemu/board/rva23-qemu/rootfs-overlay/usr/libexec/rva23-report-provision b/buildroot/qemu/board/rva23-qemu/rootfs-overlay/usr/libexec/rva23-report-provision
index 405380cb4491c0584105d48e92fa3c9718e41ecd..842beaee563528be3f0774c72a1074231ed83497 100755
--- a/buildroot/qemu/board/rva23-qemu/rootfs-overlay/usr/libexec/rva23-report-provision
+++ b/buildroot/qemu/board/rva23-qemu/rootfs-overlay/usr/libexec/rva23-report-provision
@@ -7,5 +7,6 @@         tpm2_createek -c "$key_dir/ek.ctx" -G rsa -u "$key_dir/ek.pub"
         tpm2_createak -C "$key_dir/ek.ctx" -G rsa -g sha256 -s rsassa -c "$key_dir/ak.ctx" -u "$key_dir/ak.pub" -r "$key_dir/ak.priv"
         handle=$(printf '0x%08x\n' $((0x81000000 + $(date +%s) % 0x10000)))
         tpm2_evictcontrol -c "$key_dir/ak.ctx" -o "$key_dir/ak.handle" "$handle"
+        tpm2_readpublic -c "$handle" -t "$key_dir/ak.handle"
 fi
 echo '{"type":"persistent","handle":"'$(base64 -w 0 "$key_dir/ak.handle")'"}' > "$key_dir/default.key"
