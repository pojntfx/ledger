+<script>
+function label(key){const names={at:'Time',bodyBase64:'Request body base64',pcr11:'PCR 11',publicKeyPEM:'Public key PEM',signaturePEM:'Signature PEM',qualifiedSigner:'Qualified signer',firmwareVersion:'Firmware version',eventType:'Event type',eventData:'Event data',hashAlg:'Hash algorithm',keyBits:'Key bits',contentType:'Content type'};if(names[key])return names[key];const text=key.replace(/([a-z0-9])([A-Z])/g,'$1 $2').replace(/_/g,' ');return text.charAt(0).toUpperCase()+text.slice(1)}
+function scalar(value){if(value===null||value===undefined)return 'None';if(typeof value==='boolean')return value?'Yes':'No';if(value==='')return 'None';return String(value)}
+function render(name,value,expand){if(value===null||typeof value!=='object'){const content=scalar(value);if(content.length>160){const details=document.createElement('details');const summary=document.createElement('summary');summary.textContent=name+' ('+content.length+' characters)';const pre=document.createElement('pre');pre.textContent=content;details.append(summary,pre);return details}return document.createTextNode(content)}const array=Array.isArray(value);const entries=array?value.map((entry,index)=>[String(index+1),entry]):Object.entries(value);if(!entries.length)return document.createTextNode('None');const details=document.createElement('details');details.open=Boolean(expand);const summary=document.createElement('summary');summary.textContent=name+' ('+entries.length+(array?' items':' fields')+')';const table=document.createElement('table');const body=document.createElement('tbody');for(const [key,entry] of entries){const row=document.createElement('tr');const heading=document.createElement('th');heading.scope='row';heading.textContent=array?'Item '+key:label(key);const cell=document.createElement('td');cell.append(render(array?'Item '+key:label(key),entry,false));row.append(heading,cell);body.append(row)}table.append(body);details.append(summary,table);return details}
+function fields(item){const table=document.createElement('table');const body=document.createElement('tbody');for(const [key,value] of Object.entries(item||{})){const row=document.createElement('tr');const heading=document.createElement('th');heading.scope='row';heading.textContent=label(key);const cell=document.createElement('td');cell.append(render(label(key),value,true));row.append(heading,cell);body.append(row)}table.append(body);return table}
+function raw(item){const details=document.createElement('details');const summary=document.createElement('summary');summary.textContent='Raw JSON';const pre=document.createElement('pre');pre.textContent=JSON.stringify(item,null,2);details.append(summary,pre);return details}
+function summary(item){return (item.at||'Unknown time')+' | '+(item.path||'Unknown path')+' | '+((item.response&&item.response.status)||item.error||'pending')}
+function entry(item){const details=document.createElement('details');const heading=document.createElement('summary');heading.textContent=summary(item);details.append(heading,fields(item),raw(item));return details}
+async function refresh(){const status=document.getElementById('status');status.textContent='Loading';try{const response=await fetch('/api/state');if(!response.ok)throw new Error(response.statusText);const data=await response.json();const latest=document.getElementById('latest');if(data.latest){latest.replaceChildren(fields(data.latest),raw(data.latest))}else{latest.textContent='No requests'}const history=data.history||[];const previous=data.latest?history.slice(1):history;const container=document.getElementById('history');if(previous.length){container.replaceChildren(...previous.map(entry))}else{container.textContent='No previous requests'}status.textContent=data.latest?'Updated '+data.latest.at:'No requests'}catch(error){status.textContent='Refresh failed: '+error.message}}
+document.getElementById('refresh').onclick=refresh;refresh()
+</script></body></html>`)
