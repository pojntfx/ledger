 def enroll(console, output, name, production=False):
@@ -128,6 +127,36 @@         login(console)
         console.command("criu check", 300)
 
 
+def hotplug_bridge(directory, name, server):
+    path = directory / f"{name}-monitor.sock"
+    def command(text):
+        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        sock.settimeout(3)
+        sock.connect(str(path))
+        try:
+            sock.recv(4096)
+            sock.sendall((text + "\n").encode())
+            time.sleep(0.2)
+            try:
+                sock.recv(4096)
+            except socket.timeout:
+                pass
+        finally:
+            sock.close()
+    if server:
+        command("netdev_add bridge,id=mutual,br=br-mutual-src")
+        command("device_add virtio-net-pci,netdev=mutual,mac=52:54:00:00:00:11,id=netmutual")
+        command("netdev_add bridge,id=mutual-destination,br=br-mutual-dst")
+        command("device_add virtio-net-pci,netdev=mutual-destination,mac=52:54:00:00:00:12,id=netmutualdst")
+    elif name == "source":
+        command("netdev_add bridge,id=mutual,br=br-mutual-src")
+        command("device_add virtio-net-pci,netdev=mutual,mac=52:54:00:00:00:20,id=netmutual")
+    else:
+        command("netdev_add bridge,id=mutual,br=br-mutual-dst")
+        command("device_add virtio-net-pci,netdev=mutual,mac=52:54:00:00:00:30,id=netmutual")
+    time.sleep(1)
+
