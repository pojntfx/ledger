From c54f8651bff38ad572dcaa809de012e87c8ecfa7 Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Mon, 24 Aug 2026 22:25:40 -0700
Subject: [PATCH] build: Add `workflow_dispatch` trigger for Hugo CI too

Signed-off-by: Felicitas Pojtinger <felicitas@pojtinger.com>
---
diff --git a/.forgejo/workflows/hugo.yaml b/.forgejo/workflows/hugo.yaml
index bdeac2c456376c295bc0a72b5f14be1d4834edc4..c9ac08c578a581b8cc0b9e0e5cf008c8b191db36 100644
--- a/.forgejo/workflows/hugo.yaml
+++ b/.forgejo/workflows/hugo.yaml
@@ -9,6 +9,8 @@ on:
   push:
     branches:
       - main
+  # We allow manually triggering the workflow, e.g. to quickly patch a known CVE not tracked in code (e.g. in Debian's repos) or to run actions after an initial mirror
+  workflow_dispatch:
 
 jobs:
   build:
diff --git a/.forgejo/workflows/oci.yaml b/.forgejo/workflows/oci.yaml
index fbe2abbf9f99bea7b22cf9cab631b366f611a11a..40fba855ea82eff4c7d8701345cfc9b4663a9e3a 100644
--- a/.forgejo/workflows/oci.yaml
+++ b/.forgejo/workflows/oci.yaml
@@ -6,7 +6,7 @@ on:
   push:
     branches:
       - main
-  # We allow manually triggering the workflow, e.g. to quickly patch a known CVE not tracked in code (e.g. in Debian's repos)
+  # We allow manually triggering the workflow, e.g. to quickly patch a known CVE not tracked in code (e.g. in Debian's repos) or to run actions after an initial mirror
   workflow_dispatch:
   schedule:
     - cron: "0 6 * * 1" # Every Monday at 06:00 UTC

