From 2446f8bb9995f69d9ed67d2f64a3694d4e60b8e5 Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Mon, 17 Aug 2026 22:50:11 -0700
Subject: [PATCH] build: Try using `cache-from` and `cache-to` for OCI image caching in builds

Signed-off-by: Felicitas Pojtinger <felicitas@pojtinger.com>
---
diff --git a/.forgejo/workflows/oci.yaml b/.forgejo/workflows/oci.yaml
index a8c99b94f2d82ba3b7115daeb3a2bafacb8674b6..79f3c335a51b210343acd83e8f2b979cc8a0f5c3 100644
--- a/.forgejo/workflows/oci.yaml
+++ b/.forgejo/workflows/oci.yaml
@@ -46,3 +46,6 @@           # Both provenance and SBOM generation are very flaky, and since we're the only users of this image they are disabled
           # provenance: true
           # sbom: true
           file: Containerfile
+          # See https://sumguy.com/forgejo-actions-runners-self-hosted/#persistent-cache-and-build-optimization
+          cache-from: type=registry,ref=git.vanlug.p8.lu/${{ vars.DOCKER_USERNAME }}/vanlug-api:buildcache
+          cache-to: type=registry,ref=git.vanlug.p8.lu/${{ vars.DOCKER_USERNAME }}/vanlug-api:buildcache,mode=max

