From ed2c0f876e1945ea2bb13087e4a0cbe289a297af Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Thu, 20 Aug 2026 00:20:55 -0700
Subject: [PATCH] feat: Allow disabling the external icon link in banner

Signed-off-by: Felicitas Pojtinger <felicitas@pojtinger.com>
---
diff --git a/data/banner.yaml b/data/banner.yaml
index adc6ccb0ad650031d1498474bba6a41b783edb1d..fc99c3705dd5cf3a6bcde53c619ddd262cd133c9 100644
--- a/data/banner.yaml
+++ b/data/banner.yaml
@@ -5,3 +5,4 @@ icon: fa-info-circle # fa-info-circle (info), fa-exclamation-triangle (warning), fa-exclamation-circle (danger), fa-check-circle (success), fa-bell (custom)
 message: "We have updated our Terms of Service and Privacy Policy."
 link_text: "Read the new terms" # Optional
 link_url: "/terms/" # Optional
+link_external: false # Optional; adds an external-link icon after link_text
diff --git a/layouts/_partials/banner.html b/layouts/_partials/banner.html
index 11cf082b339fc14862f90b6d977c2264fd0c49a6..d41c2d581587873104b26b9b8a82c6872db5db97 100644
--- a/layouts/_partials/banner.html
+++ b/layouts/_partials/banner.html
@@ -5,7 +5,7 @@       <span class="pf-v6-screen-reader">{{ .screen_reader_text }}</span>
       <i class="fas {{ with .icon }}{{ . }}{{ else }}fa-info-circle{{ end }} pf-v6-u-mr-sm" aria-hidden="true"></i>
       {{- .message -}}
       {{ if and .link_text .link_url }}
-        <a href="{{ .link_url }}">{{ .link_text }}{{ partial "icon" "external" }}</a>
+        <a href="{{ .link_url }}">{{ .link_text }}{{ if .link_external }}{{ partial "icon" "external" }}{{ end }}</a>
       {{ end }}
     </div>
   {{ end }}

