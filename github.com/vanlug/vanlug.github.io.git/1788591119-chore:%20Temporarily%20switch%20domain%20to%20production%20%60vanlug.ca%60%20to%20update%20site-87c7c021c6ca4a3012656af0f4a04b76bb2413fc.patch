diff --git a/.forgejo/workflows/hugo.yaml b/.forgejo/workflows/hugo.yaml
index c9ac08c578a581b8cc0b9e0e5cf008c8b191db36..79fc7e6c2f28f298ea27efa7044d91a252d6ad6f 100644
--- a/.forgejo/workflows/hugo.yaml
+++ b/.forgejo/workflows/hugo.yaml
@@ -50,8 +50,8 @@         run: |
           hugo build \
             --gc \
             --minify \
-            --baseURL "https://vanlug.p8.lu/"
-      - name: Deploy to Forgejo Pages at vanlug.p8.lu
+            --baseURL "https://vanlug.ca/"
+      - name: Deploy to Forgejo Pages at vanlug.ca
         # When using `uses` with `runs.using: docker` directly, the Forgejo runner tries to use `--network=container:$jobcontainer`,
         # which gVisor doesn't support (see https://github.com/google/gvisor/issues/13337 and
         # https://github.com/google/gvisor/issues/12132), leading to no network device appearing in the container.
@@ -61,22 +61,22 @@         uses: docker://data.forgejo.org/git-pages/git-pages-cli:1.10.0
         with:
           # See https://code.forgejo.org/actions/git-pages/src/tag/v2.2.0/action.yml#L31
           args: >-
-            https://vanlug.p8.lu/
+            https://vanlug.ca/
             --path=
             --parents
-            --server=git.vanlug.p8.lu
+            --server=git.vanlug.ca
             --password=
             --token=${{ forge.token }}
             --upload-dir=public/
       # See https://docs.codeberg.org/codeberg-pages/using-custom-domain/#deploying-to-versions-of-your-domain-both-with-and-without-www.
-      - name: Deploy to Forgejo Pages at www.vanlug.p8.lu
+      - name: Deploy to Forgejo Pages at www.vanlug.ca
         uses: docker://data.forgejo.org/git-pages/git-pages-cli:1.10.0
         with:
           args: >-
-            https://www.vanlug.p8.lu/
+            https://www.vanlug.ca/
             --path=
             --parents
-            --server=git.vanlug.p8.lu
+            --server=git.vanlug.ca
             --password=
             --token=${{ forge.token }}
             --upload-dir=public/
diff --git a/.forgejo/workflows/oci.yaml b/.forgejo/workflows/oci.yaml
index 40fba855ea82eff4c7d8701345cfc9b4663a9e3a..f83a828898f0c668a6fda98f27722aef00e6bf56 100644
--- a/.forgejo/workflows/oci.yaml
+++ b/.forgejo/workflows/oci.yaml
@@ -20,17 +20,17 @@         uses: https://code.forgejo.org/actions/checkout@v7
         with:
           fetch-depth: 0
       - name: Setup Docker
-        uses: https://git.vanlug.p8.lu/pojntfx/forgejo-runner-meta/setup-docker@main
+        uses: https://git.vanlug.ca/pojntfx/forgejo-runner-meta/setup-docker@main
       # See https://docs.docker.com/guides/gha/#conclusion
       - name: Extract Docker image metadata
         id: meta
         uses: https://github.com/docker/metadata-action@v6
         with:
-          images: git.vanlug.p8.lu/${{ vars.DOCKER_USERNAME }}/vanlug-api
+          images: git.vanlug.ca/${{ vars.DOCKER_USERNAME }}/vanlug-api
       - name: Log in to Docker Hub
         uses: https://github.com/docker/login-action@v4
         with:
-          registry: git.vanlug.p8.lu
+          registry: git.vanlug.ca
           username: ${{ vars.DOCKER_USERNAME }}
           password: ${{ secrets.DOCKER_PASSWORD }}
       - name: Set up Docker Buildx
@@ -48,5 +48,5 @@           # sbom: true
           file: Containerfile
           # This is disabled because caching makes this workflow very flaky
           # # See https://sumguy.com/forgejo-actions-runners-self-hosted/#persistent-cache-and-build-optimization
-          # cache-from: type=registry,ref=git.vanlug.p8.lu/${{ vars.DOCKER_USERNAME }}/vanlug-api:buildcache
-          # cache-to: type=registry,ref=git.vanlug.p8.lu/${{ vars.DOCKER_USERNAME }}/vanlug-api:buildcache,mode=max
+          # cache-from: type=registry,ref=git.vanlug.ca/${{ vars.DOCKER_USERNAME }}/vanlug-api:buildcache
+          # cache-to: type=registry,ref=git.vanlug.ca/${{ vars.DOCKER_USERNAME }}/vanlug-api:buildcache,mode=max
