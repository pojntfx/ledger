From 04db08ee7ef51e089450c60c0635d69ec25f1ef1 Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Mon, 17 Aug 2026 22:34:19 -0700
Subject: [PATCH] build: Explicitly reference context in `build-push-action`

Signed-off-by: Felicitas Pojtinger <felicitas@pojtinger.com>
---
diff --git a/.forgejo/workflows/oci.yaml b/.forgejo/workflows/oci.yaml
index b24c80596af7def31db063660376ae9a14b469f1..a8c99b94f2d82ba3b7115daeb3a2bafacb8674b6 100644
--- a/.forgejo/workflows/oci.yaml
+++ b/.forgejo/workflows/oci.yaml
@@ -38,6 +38,7 @@         uses: https://github.com/docker/setup-buildx-action@v4
       - name: Build and push Docker image
         uses: https://github.com/docker/build-push-action@v7
         with:
+          context: .
           push: ${{ github.event_name != 'pull_request' }}
           tags: ${{ steps.meta.outputs.tags }}
           annotations: ${{ steps.meta.outputs.annotations }}

