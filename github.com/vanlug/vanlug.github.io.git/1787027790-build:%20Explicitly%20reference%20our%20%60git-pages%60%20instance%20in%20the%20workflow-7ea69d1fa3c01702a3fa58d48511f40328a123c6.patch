From 7ea69d1fa3c01702a3fa58d48511f40328a123c6 Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Mon, 17 Aug 2026 21:36:30 -0700
Subject: [PATCH] build: Explicitly reference our `git-pages` instance in the workflow

Signed-off-by: Felicitas Pojtinger <felicitas@pojtinger.com>
---
diff --git a/.forgejo/workflows/hugo.yaml b/.forgejo/workflows/hugo.yaml
index fd62957a72474e10e996b0ed286a642fbef61807..6b0a424e22807e7dfdf75206fdb9f6bde1cf8b65 100644
--- a/.forgejo/workflows/hugo.yaml
+++ b/.forgejo/workflows/hugo.yaml
@@ -51,7 +51,7 @@       - name: Deploy to Forgejo Pages at vanlug.p8.lu
         uses: https://code.forgejo.org/actions/git-pages@v2
         with:
           site: https://vanlug.p8.lu/
-          server: codeberg.page
+          server: git.vanlug.p8.lu
           token: ${{ forge.token }}
           source: public/
       # See https://docs.codeberg.org/codeberg-pages/using-custom-domain/#deploying-to-versions-of-your-domain-both-with-and-without-www.
@@ -59,5 +59,6 @@       - name: Deploy to Forgejo Pages at www.vanlug.p8.lu
         uses: https://code.forgejo.org/actions/git-pages@v2
         with:
           site: https://www.vanlug.p8.lu/
+          server: git.vanlug.p8.lu
           token: ${{ forge.token }}
           source: public/

