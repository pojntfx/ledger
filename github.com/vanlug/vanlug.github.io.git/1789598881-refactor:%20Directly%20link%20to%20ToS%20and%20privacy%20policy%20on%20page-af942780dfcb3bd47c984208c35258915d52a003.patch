From af942780dfcb3bd47c984208c35258915d52a003 Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Wed, 16 Sep 2026 15:48:01 -0700
Subject: [PATCH] refactor: Directly link to ToS and privacy policy on page

Signed-off-by: Felicitas Pojtinger <felicitas@pojtinger.com>
---
diff --git a/data/banner.yaml b/data/banner.yaml
index fc99c3705dd5cf3a6bcde53c619ddd262cd133c9..31fed2bc203e1cc115362e03c7543de8c42f13ee 100644
--- a/data/banner.yaml
+++ b/data/banner.yaml
@@ -2,7 +2,4 @@ enabled: true
 color: info # info, warning, danger, success, custom
 screen_reader_text: "Info:"
 icon: fa-info-circle # fa-info-circle (info), fa-exclamation-triangle (warning), fa-exclamation-circle (danger), fa-check-circle (success), fa-bell (custom)
-message: "We have updated our Terms of Service and Privacy Policy."
-link_text: "Read the new terms" # Optional
-link_url: "/terms/" # Optional
-link_external: false # Optional; adds an external-link icon after link_text
+message: 'We have updated our <a href="/terms/">terms of service</a> and <a href="/privacy/">privacy policy</a>.'
diff --git a/layouts/_partials/banner.html b/layouts/_partials/banner.html
index d41c2d581587873104b26b9b8a82c6872db5db97..0ec415e4fa0c477ee06c66c95e575f27366bf6a4 100644
--- a/layouts/_partials/banner.html
+++ b/layouts/_partials/banner.html
@@ -3,10 +3,7 @@   {{ if .enabled }}
     <div class="pf-v6-c-banner pf-m-sticky{{ with .color }} pf-m-{{ . }}{{ end }} pf-v6-u-text-align-center" role="status" style="white-space: normal;">
       <span class="pf-v6-screen-reader">{{ .screen_reader_text }}</span>
       <i class="fas {{ with .icon }}{{ . }}{{ else }}fa-info-circle{{ end }} pf-v6-u-mr-sm" aria-hidden="true"></i>
-      {{- .message -}}
-      {{ if and .link_text .link_url }}
-        <a href="{{ .link_url }}">{{ .link_text }}{{ if .link_external }}{{ partial "icon" "external" }}{{ end }}</a>
-      {{ end }}
+      {{- .message | safeHTML -}}
     </div>
   {{ end }}
 {{ end }}
diff --git a/layouts/_partials/footer.html b/layouts/_partials/footer.html
index 022f9d164f1753402ff1a645026d1d02799d5bd8..82cdc6463cc394734a46fb32b8467141a83f8ec2 100644
--- a/layouts/_partials/footer.html
+++ b/layouts/_partials/footer.html
@@ -47,7 +47,7 @@             <small>&copy; {{ now.Year }} Vancouver Linux Users Group</small>
           </p>
           <p>
             <small
-              >Our <a href="{{ "/conduct/" | relURL }}">Code of Conduct</a> applies in
+              >Our <a href="{{ "/conduct/" | relURL }}">code of conduct</a> applies in
               all VanLUG spaces. Find the website
               <a
                 href="{{ hugo.Data.site.source }}"

