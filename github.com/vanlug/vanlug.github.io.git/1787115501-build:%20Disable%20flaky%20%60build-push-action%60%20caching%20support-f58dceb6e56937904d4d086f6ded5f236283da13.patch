From f58dceb6e56937904d4d086f6ded5f236283da13 Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Tue, 18 Aug 2026 21:58:21 -0700
Subject: [PATCH] build: Disable flaky `build-push-action` caching support

Signed-off-by: Felicitas Pojtinger <felicitas@pojtinger.com>
---
diff --git a/.forgejo/workflows/oci.yaml b/.forgejo/workflows/oci.yaml
index 79f3c335a51b210343acd83e8f2b979cc8a0f5c3..fbe2abbf9f99bea7b22cf9cab631b366f611a11a 100644
--- a/.forgejo/workflows/oci.yaml
+++ b/.forgejo/workflows/oci.yaml
@@ -46,6 +46,7 @@           # Both provenance and SBOM generation are very flaky, and since we're the only users of this image they are disabled
           # provenance: true
           # sbom: true
           file: Containerfile
-          # See https://sumguy.com/forgejo-actions-runners-self-hosted/#persistent-cache-and-build-optimization
-          cache-from: type=registry,ref=git.vanlug.p8.lu/${{ vars.DOCKER_USERNAME }}/vanlug-api:buildcache
-          cache-to: type=registry,ref=git.vanlug.p8.lu/${{ vars.DOCKER_USERNAME }}/vanlug-api:buildcache,mode=max
+          # This is disabled because caching makes this workflow very flaky
+          # # See https://sumguy.com/forgejo-actions-runners-self-hosted/#persistent-cache-and-build-optimization
+          # cache-from: type=registry,ref=git.vanlug.p8.lu/${{ vars.DOCKER_USERNAME }}/vanlug-api:buildcache
+          # cache-to: type=registry,ref=git.vanlug.p8.lu/${{ vars.DOCKER_USERNAME }}/vanlug-api:buildcache,mode=max

