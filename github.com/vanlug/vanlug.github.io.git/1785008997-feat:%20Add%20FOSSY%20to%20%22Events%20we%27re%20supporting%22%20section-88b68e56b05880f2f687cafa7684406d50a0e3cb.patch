From 88b68e56b05880f2f687cafa7684406d50a0e3cb Mon Sep 17 00:00:00 2001
From: Felicitas Pojtinger <felicitas@pojtinger.com>
Date: Sat, 25 Jul 2026 12:49:57 -0700
Subject: [PATCH] feat: Add FOSSY to "Events we're supporting" section

Signed-off-by: Felicitas Pojtinger <felicitas@pojtinger.com>
---
diff --git a/data/content.yaml b/data/content.yaml
index 2397383e515f37bde4f8502c4fec933530861610..7f41308f440a3ce1d196a8c2fa358cabbc7b507c 100644
--- a/data/content.yaml
+++ b/data/content.yaml
@@ -32,7 +32,11 @@   supporters:
     title: Events we're supporting
     placeholder: "More to come!"
     empty: "Nothing right now. Check back soon!"
-    events: []
+    events:
+      - title: FOSSY 2026
+        date: August 6-9, 2026
+        url: https://2026.fossy.us/
+        image: img/fossy-2026.jpg
 
 events:
   event_types:
diff --git a/data/resources.yaml b/data/resources.yaml
index 60d8a3efa87a962ad4c213e7de8f202552e604d7..7ab691576736e33ad1564e0bc446abdf6bef3d8a 100644
--- a/data/resources.yaml
+++ b/data/resources.yaml
@@ -226,3 +226,10 @@       photo:
         credit: "Albert Stoynov"
         url: https://unsplash.com/photos/PRfzwn6colA
         source: design/albert-stoynov-PRfzwn6colA-unsplash.jpg
+    - name: fossy-2026
+      file: img/fossy-2026.jpg
+      description: "Card for FOSSY 2026 (UBC clock tower, CC BY-SA 4.0)"
+      photo:
+        credit: "Dllu"
+        url: https://commons.wikimedia.org/wiki/User:Dllu
+        source: img/fossy-2026.jpg
diff --git a/layouts/_partials/section-resources.html b/layouts/_partials/section-resources.html
index 7c3171e3d74f939dce288d784a816bbfadc08358..cd2b5426a56282d4a2e3a62f1040040bc4519fde 100644
--- a/layouts/_partials/section-resources.html
+++ b/layouts/_partials/section-resources.html
@@ -516,7 +516,8 @@         <tbody class="pf-v6-c-table__tbody">
           {{ range hugo.Data.resources.design.assets }}
             <tr class="pf-v6-c-table__tr" role="row">
               <td class="pf-v6-c-table__td" role="cell">
-                <a href="{{ printf "design/%s.svg" .name | relURL }}" target="_blank">{{ .name }}.svg</a> / <a href="{{ printf "design/%s.png" .name | relURL }}" target="_blank">{{ .name }}.png</a>
+                {{ $file := .file | default (printf "design/%s.png" .name) }}
+                <a href="{{ $file | relURL }}" target="_blank">{{ $file | relURL }}</a>
               </td>
               <td class="pf-v6-c-table__td" role="cell">
                 {{ .description }}
diff --git a/static/img/fossy-2026.jpg b/static/img/fossy-2026.jpg
new file mode 100644
index 0000000000000000000000000000000000000000..f3de90ed9df14e0bd6555eab708f324b32ddf041
Binary files /dev/null and b/static/img/fossy-2026.jpg differ

